mission.FOREGROUND_SERVICE"}, {"name": "com.atharok.screentime.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.chiller3.basicsync": {"metadata": {"added": 1795648308000, "categories": ["System"], "issueTracker": "https://github.com/chenxiaolong/BasicSync/issues", "lastUpdated": 1795648308000, "license": "GPL-3.0-only", "sourceCode": "https://github.com/chenxiaolong/BasicSync", "authorName": "Andrew Gunnerson", "name": {"en-US": "BasicSync"}, "summary": {"en-US": "Run Syncthing on Android"}, "description": {"en-US": "A simple app for running Syncthing on Android.\n\nThe app is intentionally kept very basic so that the project is easy to\nmaintain and keep updated. BasicSync only controls when Syncthing runs. The\nactual configuration is done through Syncthing's own web UI.\n\nThis patchwork build adds a navigation sidebar with the common pages (syncing,\nconflict management, settings, network conditions and the sync schedule) and a\nconflict management page where sync conflicts can be resolved manually by\nkeeping the original file or by replacing it with the conflict version.\n"}, "icon": {"en-US": {"name": "/com.chiller3.basicsync/en-US/icon_GyEtqbADRySeI1-XBq2tVaJl-oyCUvyeUB66uTQy9Kg=.png", "sha256": "1b212da9b00347249e235f9706adad55a265fa8c8252fc9e501ebab93432f4a8", "size": 13850}}, "preferredSigner": "d33488794065c92e370d24a10e614e1e64e319b75e6f8bb7c4aad67f3a5b5e01"}, "versions": {"ac863cc7d6d4efe1e17da65feb0939e2b8690120db68e8cc9edb961b92c2964c": {"added": 1795648308000, "file": {"name": "/BasicSync-3.30-patchwork.apk", "sha256": "ac863cc7d6d4efe1e17da65feb0939e2b8690120db68e8cc9edb961b92c2964c", "size": 38593462}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "3.30-patchwork", "versionCode": 25807204, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 37}, "signer": {"sha256": ["d33488794065c92e370d24a10e614e1e64e319b75e6f8bb7c4aad67f3a5b5e01"]}, "usesPermission": [{"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_LOCAL_NETWORK"}, {"name": "android.permission.CHANGE_WIFI_MULTICAST_STATE"}, {"name": "android.permission.INTERACT_ACROSS_USERS"}, {"name": "android.permission.MANAGE_EXTERNAL_STORAGE"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "android.permission.READ_SYNC_SETTINGS"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.ACCESS_WIFI_STATE"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.ACCESS_BACKGROUND_LOCATION"}, {"name": "android.permission.FOREGROUND_SERVICE_LOCATION"}, {"name": "android.permission.SCHEDULE_EXACT_ALARM"}, {"name": "android.permission.CAMERA"}, {"name": "com.chiller3.basicsync.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.pengstem.baidunetgo": {"metadata": {"added": 1795582409000, "categories": ["Internet"], "issueTracker": "https://github.com/pengstem/baidunetgo/issues", "lastUpdated": 1795582409000, "license": "GPL-3.0-only", "sourceCode": "https://github.com/pengstem/baidunetgo", "authorName": "pengstem", "name": {"en-US": "百度网盘 Go"}, "summary": {"en-US": "Community patchwork build of the Baidu Netdisk client, with automatic encrypted backup."}, "description": {"en-US": "The BaiduNetGo Android client of the community patchwork build of pengstem's\nBaidu Netdisk (百度网盘 Go) — a Material 3 Expressive app that pairs with the\npure-Go desktop client published on the same repository.\n\nFeatures:\n\n- Sign in by scanning a QR code (or paste Cookie / BDUSS+STOKEN).\n- Browse the netdisk with list/grid views, sorting, search and file details.\n- Folder backup: pick local folders (SAF) and mirror them into a netdisk\n  folder incrementally on a schedule (manual / 15 min / 1 h / 6 h / 24 h) in\n  the background with WorkManager, or immediately with live progress.\n- Album backup: pick MediaStore albums and back their photos and videos up.\n- Encrypted backup: OpenPGP symmetric encryption turns every uploaded file\n  into a .gpg that `gpg -d` opens on any computer — the same format the\n  desktop client writes, so files from both devices restore alike.\n- Transfers with progress, speed and cancel.\n- Account and quota info, upload concurrency, Wi-Fi-only mode and themes.\n\nBuilt from upstream plus the patch queue in this repository; the desktop\nhalf is released separately (it is not an F-Droid package).\n"}, "icon": {"en-US": {"name": "/com.pengstem.baidunetgo/en-US/icon_sD26zDSgaobZAjUq7iTQmjIU91DtRp887Z0vGN1RJAY=.png", "sha256": "b03dbacc34a06a86d902352aee24d09a3214f750ed469f3ced9d2f18dd512406", "size": 45376}}, "preferredSigner": "d33488794065c92e370d24a10e614e1e64e319b75e6f8bb7c4aad67f3a5b5e01"}, "versions": {"07eca896601b11d0f37a2501d4295d2fd5a20fd3a409a9a5ec98bfbe2e0ac98d": {"added": 1795582409000, "file": {"name": "/BaiduNetGo-0.8.3-patchwork.apk", "sha256": "07eca896601b11d0f37a2501d4295d2fd5a20fd3a409a9a5ec98bfbe2e0ac98d", "size": 18541296}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.8.3-patchwork", "versionCode": 80348, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 37}, "signer": {"sha256": ["d33488794065c92e370d24a10e614e1e64e319b75e6f8bb7c4aad67f3a5b5e01"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 32}, {"name": "android.permission.READ_MEDIA_IMAGES"}, {"name": "android.permission.READ_MEDIA_VIDEO"}, {"name": "android.permission.RE