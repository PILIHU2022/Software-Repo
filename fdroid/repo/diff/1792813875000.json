me": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "de.dbauer.expensetracker.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "nodomain.freeyourgadget.gadgetbridge": {"metadata": {"added": 1795572204000, "categories": ["Health & Fitness"], "issueTracker": "https://codeberg.org/Freeyourgadget/Gadgetbridge/issues", "lastUpdated": 1795572204000, "license": "AGPL-3.0-only", "sourceCode": "https://codeberg.org/Freeyourgadget/Gadgetbridge", "translation": "https://hosted.weblate.org/projects/freeyourgadget/gadgetbridge", "webSite": "https://gadgetbridge.org", "authorName": "Gadgetbridge contributors", "name": {"en-US": "Gadgetbridge"}, "summary": {"en-US": "Use your Bluetooth gadgets without the vendor's app, with a Compose UI"}, "description": {"en-US": "Gadgetbridge lets you use Bluetooth wearables and other gadgets without the\nvendor's closed-source application, without an account and without sending\nyour data anywhere.\n\nThis patchwork build starts from upstream and adds:\n- a Jetpack Compose + Material 3 Expressive user interface: the settings tree,\nthe first-run guide, the About page and the sleep score sheet are Compose,\nand the remaining screens inherit the larger Expressive shapes;\n- an age-based sleep score estimated from the recorded sleep stages when the\ndevice does not report one, with a breakdown sheet behind the score ring;\n- a backup that runs every time the app is opened, with its own settings page,\na retention period and a folder the user can change;\n- a database export that writes to a temporary file, validates it and only\nthen replaces the target, so a failed run cannot truncate the previous backup;\n- a single, complete music snapshot for Xiaomi devices, so the watch no longer\nshows a new title with an old playback state;\n- a time re-sync after every (re)connection.\n\nNote: the package name matches the official app but the signing key differs,\nso the official version must be uninstalled before installing this build,\nwhich also means the recorded data does not carry over.\n\nGadgetbridge is free software under the AGPL-3.0; the corresponding source is\nthe upstream repository plus the patch queue in this repository.\n"}, "icon": {"en-US": {"name": "/nodomain.freeyourgadget.gadgetbridge/en-US/icon_X8EVBNWmEaTA1EERH5xgBoSpAan8BNTrrDa4Osj-Da8=.png", "sha256": "5fc11504d5a611a4c0d441111f9c600684a901a9fc04d4ebac36b83ac8fe0daf", "size": 27948}}, "preferredSigner": "d33488794065c92e370d24a10e614e1e64e319b75e6f8bb7c4aad67f3a5b5e01"}, "versions": {"682357f46264885e4f38d35dc3d0a85c6b7378ed8cc8f0aa2dfe45cbe71b4e68": {"added": 1795572204000, "file": {"name": "/Gadgetbridge-2026.11.1-patchwork.apk", "sha256": "682357f46264885e4f38d35dc3d0a85c6b7378ed8cc8f0aa2dfe45cbe71b4e68", "size": 25802195}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "2026.11.1-patchwork", "versionCode": 25708, "features": [{"name": "android.hardware.bluetooth"}], "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 35}, "signer": {"sha256": ["d33488794065c92e370d24a10e614e1e64e319b75e6f8bb7c4aad67f3a5b5e01"]}, "usesPermission": [{"name": "android.permission.BLUETOOTH"}, {"name": "android.permission.BLUETOOTH_ADMIN", "maxSdkVersion": 30}, {"name": "android.permission.BLUETOOTH_SCAN"}, {"name": "android.permission.BLUETOOTH_CONNECT"}, {"name": "android.permission.ACCESS_COARSE_LOCATION"}, {"name": "android.permission.ACCESS_FINE_LOCATION"}, {"name": "android.permission.ACCESS_BACKGROUND_LOCATION"}, {"name": "android.permission.READ_CALL_LOG"}, {"name": "android.permission.READ_PHONE_STATE"}, {"name": "android.permission.PROCESS_OUTGOING_CALLS"}, {"name": "android.permission.ACCESS_NOTIFICATION_POLICY"}, {"name": "android.permission.CALL_PHONE"}, {"name": "android.permission.ANSWER_PHONE_CALLS"}, {"name": "android.permission.RECEIVE_SMS"}, {"name": "android.permission.SEND_SMS"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "andro