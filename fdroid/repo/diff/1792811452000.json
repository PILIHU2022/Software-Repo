onfiguration file manager and UTF-8 editor;\n- cleanup of stale .temp.userdb files at startup, avoiding LOCK conflicts\nduring sync;\n- a horizontal back arrow in the file manager.\n\nNote: the package name matches the official app but the signing key differs,\nso the official version must be uninstalled before installing this build.\n\nFcitx5 for Android is free software under the LGPL-2.1; the corresponding\nsource is the upstream repository plus the patch queue in this repository.\n"}, "icon": {"en-US": {"name": "/org.fcitx.fcitx5.android/en-US/icon_WuokZWcozD_zniTGCYiYwnEluGujAgQSNJ1Opdww7HY=.png", "sha256": "5aea24656728cc3ff39e24c6098898c27125b86ba3020412349d4ea5dc30ec76", "size": 48154}}, "preferredSigner": "d33488794065c92e370d24a10e614e1e64e319b75e6f8bb7c4aad67f3a5b5e01"}, "versions": {"4171d1231aa8ff623b9fe64cb2f6c54e3a5017675a0d630e75704df37553f455": {"added": 1792917968000, "file": {"name": "/Fcitx5ForAndroid-0.1.3-patchwork-arm64-v8a.apk", "sha256": "4171d1231aa8ff623b9fe64cb2f6c54e3a5017675a0d630e75704df37553f455", "size": 56008421}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.1.3-patchwork", "versionCode": 11207, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["d33488794065c92e370d24a10e614e1e64e319b75e6f8bb7c4aad67f3a5b5e01"]}, "usesPermission": [{"name": "android.permission.VIBRATE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.MANAGE_EXTERNAL_STORAGE"}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 29}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 32}, {"name": "org.fcitx.fcitx5.android.permission.PLUGIN"}]}}}}}}