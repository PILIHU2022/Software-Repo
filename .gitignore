# Local build caches and outputs (never commit these)
.cache/
dist/
.gradle/

# Generated F-Droid signing key (copied from signing/ by publish-fdroid.sh)
fdroid/keystore.jks

# fdroidserver transient state (contains local absolute paths, changes on
# every run, and is not needed by F-Droid clients)
fdroid/tmp/
fdroid/repo/status/
# index diffs and the pre-signing jar are regenerated by every fdroid update
fdroid/repo/diff/
fdroid/repo/index_unsigned.jar

# Editor / OS noise
.DS_Store
*.log

# Local authoring clones living inside the repo tree (never commit these:
# a nested .git would turn the directory into a broken gitlink and hide
# the patch queues from CI)
/apps/ScreenTime/
/apps/RecurringExpenseTracker/
/apps/fcitx5-android/
/apps/DataArk/
/desktop/baidunetgo-clone/

# Local workspace items outside the repository proper
/gadgetbridge/
/gadgetbridge-*-patch/
/data-backup-ref/
/evidence/
/toolchain/
/.android-home/
/.cache-fcitx5/
/.fontprofile/
/.gocache/
/.gomodcache/
/.gopath/
/.gradle-home/
/.hlsp-test
/.research/
/.scratch/
/.toolchain/
/.dsh-tmp/
/.watch-state.json
/GADGETBRIDGE-FIXES-*.md
/HANDOFF*.md
/pref.txt

# Local authoring clone for BasicSync (see /apps/basicsync/)
/apps/BasicSync/
