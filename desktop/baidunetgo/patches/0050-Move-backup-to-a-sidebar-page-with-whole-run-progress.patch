+// backupPercent is the whole run's progress, capped at 100. RunTotal is 0
+// while the scan is still counting, and callers say so instead.
+func backupPercent(p backup.Progress) int {
+	if p.RunTotal <= 0 {
+		return 0
+	}
+	pct := int(float64(p.RunDone) * 100 / float64(p.RunTotal))
+	return min(pct, 100)
+}
+
+// sampleBackupSpeed measures the bytes RunDone grew since the last sample.
+// It runs on the UI thread, where the reporter stores progress, so the
+// fields it reads and writes need no lock. A fresh scan resets the sample;
+// slow reports keep the last measured speed between samples.
+func (a *App) sampleBackupSpeed(p backup.Progress, now time.Time) {
+	b := &a.backup
+	if p.RunTotal <= 0 || p.RunDone < b.speedDone || b.speedAt.IsZero() {
+		b.speedDone, b.speedAt, b.speed = p.RunDone, now, 0
+		return
+	}
+	if d := now.Sub(b.speedAt); d >= 300*time.Millisecond {
+		b.speed = int64(float64(p.RunDone-b.speedDone) / d.Seconds())
+		b.speedDone, b.speedAt = p.RunDone, now
+	}
+}
+
