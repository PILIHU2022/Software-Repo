diff --git a/app/blankclear_test.go b/app/blankclear_test.go
new file mode 100644
index 0000000..ab26403
--- /dev/null
+++ b/app/blankclear_test.go
@@ -0,0 +1,185 @@
+package app
+
+import (
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+
+	"github.com/pengstem/baidunetgo/internal/fakepan"
+)
+
+// marqueeLastRows drags a box from the list's blank space below the rows up
+// across the last n rows, leaving them chosen, and returns the blank point
+// the drag began at, which is blank space to click.
+func marqueeLastRows(t *testing.T, tt *ui.Tester, l *listing, n int) ui.Point {
+	t.Helper()
+	area := l.dragArea
+	x0, x1 := area.X+20, area.X+64
+	y0 := area.Y + area.H - 12
+	first := l.rowRects[l.files[len(l.files)-n].FsID]
+	top := first.Y + 2
+	tt.Press(x0, y0)
+	tt.Frame()
+	for i := 1; i <= 20; i++ {
+		f := float32(i) / 20
+		tt.Move(x0+(x1-x0)*f, y0+(top-y0)*f)
+		tt.Frame()
+	}
+	tt.Release(x1, top)
+	tt.Frame()
+	return ui.Point{X: x0, Y: y0}
+}
+
+// TestBlankClickClearsListSelection selects the last three rows with a
+// marquee, then clicks the blank space the box began in: the choice goes,
+// and the status bar stops counting it. The release of the marquee itself
+// keeps the choice, opening only a blank click clears it.
+func TestBlankClickClearsListSelection(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	if len(l.files) < 4 {
+		t.Fatalf("need a few rows, have %d", len(l.files))
+	}
+	blank := marqueeLastRows(t, tt, l, 3)
+	if l.sel.Len() != 3 {
+		t.Fatalf("blank drag chose %d, want three rows", l.sel.Len())
+	}
+	// The marquee's release must keep the choice, not clear it.
+	if !tt.HasText("已选 3 项") {
+		t.Errorf("release of the marquee kept %d but the status did not count them; texts %q", l.sel.Len(), tt.Texts())
+	}
+	// A plain left click on the blank space clears it.
+	tt.Advance(time.Second)
+	tt.ClickAt(blank.X, blank.Y)
+	tt.Advance(400 * time.Millisecond)
+	if l.sel.Len() != 0 {
+		t.Errorf("blank click left %d chosen", l.sel.Len())
+	}
+	if l.selected != -1 {
+		t.Errorf("blank click left selected=%d, want -1", l.selected)
+	}
+	if l.dragOn || l.dragRect != (ui.Rect{}) {
+		t.Errorf("blank click left a marquee: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+	if tt.HasText("已选") {
+		t.Errorf("status still says a choice after a blank click; texts %q", tt.Texts())
+	}
+	if !tt.HasText("项") {
+		t.Errorf("the item count went with the choice; texts %q", tt.Texts())
+	}
+}
+
+// TestBlankClickCmdKeepsSelection holds Cmd as it clicks the blank space: the
+// choice stays, as Cmd adds rather than starting over.
+func TestBlankClickCmdKeepsSelection(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	if len(l.files) < 4 {
+		t.Fatalf("need a few rows, have %d", len(l.files))
+	}
+	blank := marqueeLastRows(t, tt, l, 3)
+	if l.sel.Len() != 3 {
+		t.Fatalf("blank drag chose %d, want three rows", l.sel.Len())
+	}
+	tt.Advance(time.Second)
+	tt.ClickAtWith(ui.Cmd, blank.X, blank.Y)
+	tt.Advance(400 * time.Millisecond)
+	if l.sel.Len() != 3 {
+		t.Errorf("a Cmd click on the blank space left %d chosen, want the three kept", l.sel.Len())
+	}
+}
+
+// TestBlankClickRowReselects says a click on a row with a choice already made
+// chooses that row alone; it is no blank click, so nothing is cleared without
+// choosing.
+func TestBlankClickRowReselects(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	if len(l.files) < 4 {
+		t.Fatalf("need a few rows, have %d", len(l.files))
+	}
+	marqueeLastRows(t, tt, l, 3)
+	if l.sel.Len() != 3 {
+		t.Fatalf("blank drag chose %d, want three rows", l.sel.Len())
+	}
+	tt.Advance(time.Second)
+	r := l.rowRects[l.files[0].FsID]
+	tt.ClickAt(r.X+20, r.Y+r.H/2)
+	tt.Frame()
+	if l.sel.Len() != 1 || !l.sel.Has(l.files[0].FsID) {
+		t.Errorf("a row click chose %d, want just the row", l.sel.Len())
+	}
+}
+
+// TestBlankClickClearsGridSelection selects tiles with a blank-drag box, then
+// clicks the grid's blank space: the tile choice goes.
+func TestBlankClickClearsGridSelection(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	for i := 1; i <= 3; i++ {
+		srv.Add(fakepan.Node{Path: fmt.Sprintf("/剧集/E%02d.mkv", i), Category: 1, Size: 1 << 30})
+	}
+	a.gridView = true
+	a.router.Push(filesRoute("/剧集"))
+	waitFor(t, tt, "E01.mkv")
+	tt.Advance(time.Second)
+	l := a.listingFor("/剧集")
+	area := l.dragArea
+	if area.W <= 0 || area.H <= 0 {
+		t.Fatalf("no grid viewport: %v", area)
+	}
+	// Press below the single row of tiles, in blank space, and drag up over
+	// them.
+	x0 := area.X + 40
+	y0 := area.Y + area.H - 24
+	x1, y1 := x0+120, area.Y+24
+	tt.Press(x0, y0)
+	tt.Frame()
+	for i := 1; i <= 16; i++ {
+		f := float32(i) / 16
+		tt.Move(x0+(x1-x0)*f, y0+(y1-y0)*f)
+		tt.Frame()
+	}
+	tt.Release(x1, y1)
+	tt.Frame()
+	if l.sel.Len() == 0 {
+		t.Fatalf("the box over the tiles chose none")
+	}
+	// A plain click on the blank space clears the tiles' choice.
+	tt.Advance(time.Second)
+	tt.ClickAt(x0, y0)
+	tt.Advance(400 * time.Millisecond)
+	if l.sel.Len() != 0 {
+		t.Errorf("blank click left %d tiles chosen", l.sel.Len())
+	}
+	if l.selected != -1 {
+		t.Errorf("blank click left selected=%d, want -1", l.selected)
+	}
+	if l.dragOn || l.dragRect != (ui.Rect{}) {
+		t.Errorf("blank click left a marquee: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+}
+
+// TestMarqueeReleaseKeepsChoice says letting go of a marquee after dragging
+// it keeps what it chose: only a blank click, without a drag, clears.
+func TestMarqueeReleaseKeepsChoice(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	if len(l.files) < 3 {
+		t.Fatalf("need a few rows, have %d", len(l.files))
+	}
+	marqueeLastRows(t, tt, l, 2)
+	if l.sel.Len() != 2 {
+		t.Fatalf("the marquee chose %d, want two rows kept after its release", l.sel.Len())
+	}
+	// A moment later, with no further click, the choice is still there.
+	tt.Advance(time.Second)
+	if l.sel.Len() != 2 {
+		t.Errorf("the choice went after the marquee, %d left", l.sel.Len())
+	}
+}
diff --git a/app/browser.go b/app/browser.go
index bb6fac0..99d32c7 100644
--- a/app/browser.go
+++ b/app/browser.go
@@ -48,6 +48,7 @@ func (a *App) filesPage(c *ui.Context, t *ui.Theme, p *palette, dir string) {
 	// A new frame's views say where a rubber band clips; a press the last
 	// frame saw is looked at below.
