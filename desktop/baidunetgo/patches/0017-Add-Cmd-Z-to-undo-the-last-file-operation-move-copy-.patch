+package app
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+
+	"github.com/pengstem/baidunetgo/internal/fakepan"
+)
+
+// recycleNames lists what the fake netdisk's recycle bin holds.
+func recycleNames(t *testing.T, a *App) []string {
+	t.Helper()
+	items, err := a.sess.client.RecycleList(context.Background())
+	if err != nil {
+		t.Fatalf("recycle list: %v", err)
+	}
+	out := make([]string, len(items))
+	for i, it := range items {
+		out[i] = it.Name
+	}
+	return out
+}
+
+func hasName(names []string, name string) bool {
+	for _, n := range names {
+		if n == name {
+			return true
+		}
+	}
+	return false
+}
+
+// TestUndoCmdZCutPaste: cut, paste elsewhere (a move), then Cmd+Z puts the
+// file back, the target folder loses it, the netdisk change is counted,
+// the stack empties, and a second Cmd+Z finds nothing to undo.
+func TestUndoCmdZCutPaste(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	chooseFiles(t, a, "/", "安装包.dmg")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyX)
+	tt.Advance(100 * time.Millisecond)
+	a.router.Push(filesRoute("/代码"))
+	waitFor(t, tt, "main.go")
+	tt.Key(ui.Cmd, ui.KeyV)
+	waitUntil(t, tt, "the move", func() bool {
+		return !srv.Exists("/安装包.dmg") && srv.Exists("/代码/安装包.dmg")
+	})
+	settle(tt)
+	if len(a.undoStack) != 1 {
+		t.Fatalf("undo stack holds %d, want 1", len(a.undoStack))
+	}
+	if got, want := a.undoStack[0].label, "移动「安装包.dmg」到「代码」"; got != want {
+		t.Errorf("label %q, want %q", got, want)
+	}
+	gen := a.netdiskGen
+
+	tt.Key(ui.Cmd, ui.KeyZ)
+	waitUntil(t, tt, "the undo", func() bool {
+		return srv.Exists("/安装包.dmg") && !srv.Exists("/代码/安装包.dmg")
+	})
+	settle(tt)
+	if a.netdiskGen != gen+1 {
+		t.Errorf("netdiskGen %d after undo, want %d", a.netdiskGen, gen+1)
+	}
+	if len(a.undoStack) != 0 {
+		t.Errorf("stack holds %d after undo, want 0", len(a.undoStack))
+	}
+	if !tt.HasText("已撤销") {
+		t.Errorf("no undo toast: %q", tt.Texts())
+	}
+
+	tt.Key(ui.Cmd, ui.KeyZ)
+	settle(tt)
+	if !tt.HasText("没有可撤销的操作") {
+		t.Errorf("no empty-stack toast: %q", tt.Texts())
+	}
+}
+
+// TestUndoRename: renaming a file in place is undone by renaming it back.
+func TestUndoRename(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	l := a.listings["/"]
+	f := fileNamed(t, a, "/", "README.md")
+	l.sel.Clear()
+	l.sel.Add(f.FsID)
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(0, ui.KeyF2)
+	tt.Advance(300 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyA)
+	tt.Type("说明.md")
+	tt.Key(0, ui.KeyEnter)
+	waitUntil(t, tt, "the rename", func() bool {
+		return srv.Exists("/说明.md") && !srv.Exists("/README.md")
+	})
+	settle(tt)
+	if len(a.undoStack) != 1 {
+		t.Fatalf("undo stack holds %d, want 1", len(a.undoStack))
+	}
+
+	tt.Key(ui.Cmd, ui.KeyZ)
+	waitUntil(t, tt, "the undo", func() bool {
+		return srv.Exists("/README.md") && !srv.Exists("/说明.md")
+	})
+	settle(tt)
+	if len(a.undoStack) != 0 {
+		t.Errorf("stack holds %d after undo", len(a.undoStack))
+	}
+	if !tt.HasText("已撤销") {
+		t.Errorf("no undo toast: %q", tt.Texts())
+	}
+}
+
+// TestUndoNewFolder: a new folder is undone by moving it to the recycle
+// bin, not by deleting it for good.
+func TestUndoNewFolder(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	tt.Advance(time.Second)
+	tt.Key(ui.Cmd|ui.Shift, ui.KeyN)
+	tt.Advance(300 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyA)
+	tt.Type("相册")
+	tt.Key(0, ui.KeyEnter)
+	waitUntil(t, tt, "the folder", func() bool { return srv.Exists("/相册") })
+	settle(tt)
+	if len(a.undoStack) != 1 {
+		t.Fatalf("undo stack holds %d, want 1", len(a.undoStack))
+	}
+
+	tt.Key(ui.Cmd, ui.KeyZ)
+	waitUntil(t, tt, "the undo", func() bool { return !srv.Exists("/相册") })
+	settle(tt)
+	if !hasName(recycleNames(t, a), "相册") {
+		t.Error("the undone folder is not in the recycle bin")
+	}
+	if len(a.undoStack) != 0 {
+		t.Errorf("stack holds %d after undo", len(a.undoStack))
+	}
+	if !tt.HasText("已撤销") {
+		t.Errorf("no undo toast: %q", tt.Texts())
+	}
+}
+
+// TestUndoDelete: deleting to the recycle bin is undone by restoring.
+func TestUndoDelete(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	chooseFiles(t, a, "/", "README.md")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(0, ui.KeyDelete)
+	waitUntil(t, tt, "the delete", func() bool { return !srv.Exists("/README.md") })
+	settle(tt)
+	if len(a.undoStack) != 1 {
+		t.Fatalf("undo stack holds %d, want 1", len(a.undoStack))
+	}
+	gen := a.netdiskGen
+
+	tt.Key(ui.Cmd, ui.KeyZ)
+	waitUntil(t, tt, "the undo", func() bool { return srv.Exists("/README.md") })
+	settle(tt)
+	if a.netdiskGen != gen+1 {
+		t.Errorf("netdiskGen %d after undo, want %d", a.netdiskGen, gen+1)
+	}
+	if len(a.undoStack) != 0 {
+		t.Errorf("stack holds %d after undo", len(a.undoStack))
+	}
+	if !tt.HasText("已撤销") {
+		t.Errorf("no undo toast: %q", tt.Texts())
+	}
+}
+
+// TestUndoCopy: undoing a copy deletes only the copy it made, and leaves
+// the original where it was.
+func TestUndoCopy(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	chooseFiles(t, a, "/", "安装包.dmg")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyC)
+	tt.Advance(100 * time.Millisecond)
+	a.router.Push(filesRoute("/代码"))
+	waitFor(t, tt, "main.go")
+	tt.Key(ui.Cmd, ui.KeyV)
+	waitUntil(t, tt, "the copy", func() bool { return srv.Exists("/代码/安装包.dmg") })
+	settle(tt)
+	if len(a.undoStack) != 1 {
+		t.Fatalf("undo stack holds %d, want 1", len(a.undoStack))
+	}
+
+	tt.Key(ui.Cmd, ui.KeyZ)
+	waitUntil(t, tt, "the undo", func() bool { return !srv.Exists("/代码/安装包.dmg") })
+	settle(tt)
+	if !srv.Exists("/安装包.dmg") {
+		t.Error("undoing the copy removed the original")
+	}
+	if !hasName(recycleNames(t, a), "安装包.dmg") {
+		t.Error("the undone copy is not in the recycle bin")
+	}
+	if len(a.undoStack) != 0 {
+		t.Errorf("stack holds %d after undo", len(a.undoStack))
+	}
+	if !tt.HasText("已撤销") {
+		t.Errorf("no undo toast: %q", tt.Texts())
+	}
+}
+
+// TestUndoEmptyStack: Cmd+Z with nothing to undo says so.
+func TestUndoEmptyStack(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(200 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyZ)
+	settle(tt)
+	if !tt.HasText("没有可撤销的操作") {
+		t.Errorf("no empty-stack toast: %q", tt.Texts())
+	}
+	if len(a.undoStack) != 0 {
+		t.Errorf("stack holds %d", len(a.undoStack))
+	}
+}
+
+// TestUndoConflictKeepsEntry: when the folder a move came from holds the
+// name again, undoing the move fails, the entry stays to retry, and it
+// works once the newcomer is gone. The app never deletes the newcomer to
+// force the move.
+func TestUndoConflictKeepsEntry(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	chooseFiles(t, a, "/", "安装包.dmg")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyX)
+	tt.Advance(100 * time.Millisecond)
+	a.router.Push(filesRoute("/代码"))
+	waitFor(t, tt, "main.go")
+	tt.Key(ui.Cmd, ui.KeyV)
+	waitUntil(t, tt, "the move", func() bool { return srv.Exists("/代码/安装包.dmg") })
+	settle(tt)
+
+	// A newcomer with the same name appears where the file came from.
+	srv.Add(fakepan.Node{Path: "/安装包.dmg", Data: []byte("新的")})
+	tt.Key(ui.Cmd, ui.KeyZ)
+	waitUntil(t, tt, "the failed undo", func() bool { return tt.HasText("无法撤销") })
+	settle(tt)
+	if len(a.undoStack) != 1 {
+		t.Errorf("a failed undo dropped its entry; stack %d", len(a.undoStack))
+	}
+	if a.undoBusy {
+		t.Error("undoBusy stayed set after a failed undo")
+	}
+	if !srv.Exists("/代码/安装包.dmg") {
+		t.Error("the file left the target though the undo failed")
+	}
+	if string(srv.Data("/安装包.dmg")) != "新的" {
+		t.Error("the undo overwrote the newcomer")
+	}
+
+	// Clear the newcomer (to the recycle bin) and retry.
+	if err := a.sess.client.Delete(context.Background(), []string{"/安装包.dmg"}); err != nil {
+		t.Fatal(err)
+	}
+	tt.Key(ui.Cmd, ui.KeyZ)
+	waitUntil(t, tt, "the retried undo", func() bool {
+		return srv.Exists("/安装包.dmg") && !srv.Exists("/代码/安装包.dmg")
+	})
+	settle(tt)
+	if len(a.undoStack) != 0 {
+		t.Errorf("stack holds %d after the retried undo", len(a.undoStack))
+	}
+	if !tt.HasText("已撤销") {
+		t.Errorf("no undo toast: %q", tt.Texts())
+	}
+}
+
+// TestUndoChain: undoing two steps goes back in order, and an undo never
+// records a step of its own: the second Cmd+Z undoes the earlier move.
+func TestUndoChain(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	// Step one: move README.md into /代码.
+	chooseFiles(t, a, "/", "README.md")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyX)
+	tt.Advance(100 * time.Millisecond)
+	a.router.Push(filesRoute("/代码"))
+	waitFor(t, tt, "main.go")
+	tt.Key(ui.Cmd, ui.KeyV)
+	waitUntil(t, tt, "the move", func() bool { return srv.Exists("/代码/README.md") })
+	settle(tt)
+	// Step two: rename main.go in place.
+	l := a.listings["/代码"]
+	f := fileNamed(t, a, "/代码", "main.go")
+	l.sel.Clear()
+	l.sel.Add(f.FsID)
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(0, ui.KeyF2)
+	tt.Advance(300 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyA)
+	tt.Type("app.go")
+	tt.Key(0, ui.KeyEnter)
+	waitUntil(t, tt, "the rename", func() bool { return srv.Exists("/代码/app.go") })
+	settle(tt)
+	if len(a.undoStack) != 2 {
+		t.Fatalf("undo stack holds %d, want 2", len(a.undoStack))
+	}
+
+	// Undo the rename first.
+	tt.Key(ui.Cmd, ui.KeyZ)
+	waitUntil(t, tt, "the rename undone", func() bool {
+		return srv.Exists("/代码/main.go") && !srv.Exists("/代码/app.go")
+	})
+	settle(tt)
+	if len(a.undoStack) != 1 {
+		t.Fatalf("stack holds %d after one undo, want 1", len(a.undoStack))
+	}
+	if !srv.Exists("/代码/README.md") {
+		t.Error("undoing the rename disturbed the earlier move")
+	}
+
+	// Then undo the move.
+	tt.Key(ui.Cmd, ui.KeyZ)
+	waitUntil(t, tt, "the move undone", func() bool {
+		return srv.Exists("/README.md") && !srv.Exists("/代码/README.md")
+	})
+	settle(tt)
+	if len(a.undoStack) != 0 {
+		t.Errorf("stack holds %d after the chain, want 0", len(a.undoStack))
+	}
+}
