diff --git a/app/undo.go b/app/undo.go
new file mode 100644
index 0000000..3f3aad2
--- /dev/null
+++ b/app/undo.go
@@ -0,0 +1,187 @@
+package app
+
+import (
+	"context"
+	"path"
+
+	"github.com/pengstem/baidunetgo/internal/baidu"
+)
+
+// undoEntry is one step the app can undo: what it did, said in words
+// ("移动 3 项到「照片」"), the reverse operation to run, the folders to
+// read again once that succeeded, and an optional callback on the UI
+// thread for the rest (clearing the choice, refreshing the recycle bin).
+//
+// Entries live in App.undoStack, in memory only, for as long as the
+// session lasts: a netdisk path means nothing to a later run, so the
+// stack is not kept on disk. An entry is pushed only once the operation
+// it describes has succeeded, and undone entries leave the stack; an
+// entry whose reverse fails stays, so the user can try again.
+type undoEntry struct {
+	label string
+	run   func(ctx context.Context, c *baidu.Client) error
+	dirs  []string
+	after func()
+}
+
+// undoLimit is how many steps the stack keeps; the oldest falls off when
+// it overflows.
+const undoLimit = 50
+
+// pushUndo adds e to the undo stack, unless an undo itself is running,
+// whose reverse must not become another step. It runs on the UI thread.
+func (a *App) pushUndo(e *undoEntry) {
+	if a.undoing || e == nil {
+		return
+	}
+	a.undoStack = append(a.undoStack, e)
+	if len(a.undoStack) > undoLimit {
+		a.undoStack = a.undoStack[len(a.undoStack)-undoLimit:]
+	}
+}
+
+// dropUndo removes e from the stack, reporting whether it was there. It is
+// how a toast's own undo takes its step off the stack, so a later Cmd+Z
+// undoes the step before it, and so a step is never undone twice.
+func (a *App) dropUndo(e *undoEntry) bool {
+	for i, u := range a.undoStack {
+		if u == e {
+			a.undoStack = append(a.undoStack[:i:i], a.undoStack[i+1:]...)
+			return true
+		}
+	}
+	return false
+}
+
+// undoLast undoes the last step: it runs the reverse operation on a
+// goroutine and, on the UI thread, pops the entry, counts the change,
+// reads the folders again, runs after and says so. A failed reverse keeps
+// the entry and says why, so the user can try again once the cause (a
+// name taken meanwhile, say) is gone. It yields while another undo, a
+// dialog or a transfer is running.
+func (a *App) undoLast() {
+	if a.undoBusy || a.dlg.open || a.dlg.busy || a.pv != nil || a.renaming != nil || a.creating != nil {
+		return
+	}
+	n := len(a.undoStack)
+	if n == 0 {
+		a.toast("没有可撤销的操作", "")
+		return
+	}
+	s := a.sess
+	if s == nil {
+		return
+	}
+	e := a.undoStack[n-1]
+	a.undoBusy, a.undoing = true, true
+	go func() {
+		err := e.run(context.Background(), s.client)
+		a.update(func() {
+			a.undoBusy, a.undoing = false, false
+			if a.sess != s {
+				return
+			}
+			if err != nil {
+				a.toast("无法撤销「"+e.label+"」："+err.Error(), "error")
+				return
+			}
+			// Pop it, unless a toast's undo or another path already did.
+			a.dropUndo(e)
+			a.netdiskChanged()
+			for _, d := range e.dirs {
+				a.reload(d)
+			}
+			// Undoing usually adds to or takes from the recycle bin: the
+			// page reads it again when next shown.
+			a.recycleDirty = true
+			if e.after != nil {
+				e.after()
+			}
+			a.toast("已撤销："+e.label, "success")
+		})
+	}()
+}
+
+// clearSel is an undo entry's after: it clears the choice in dirs, which
+// a reload has just repopulated with files whose fs_ids may differ.
+func (a *App) clearSel(dirs ...string) func() {
+	ds := append([]string(nil), dirs...)
+	return func() {
+		for _, d := range ds {
+			if l := a.listings[d]; l != nil {
+				l.sel.Clear()
+			}
+		}
+	}
+}
+
+// movedItem is one file a move or a copy put somewhere, as undoing it
+// needs it: the name it has there now and the name it had, in fromDir.
+type movedItem struct {
+	destName string // the name at destDir, which a conflict may have changed
+	name     string // the name it had in fromDir
+}
+
+// moveBack moves the items an operation put in to back into from, under
+// the names they had, then restores the copies it replaced there. A name
+// taken in from meanwhile makes MoveAs fail, which keeps the undo entry:
+// the app never deletes the newcomer to force the move.
+func moveBack(items []movedItem, from, to string, replaced []int64) func(ctx context.Context, c *baidu.Client) error {
+	srcs := make([]string, len(items))
+	names := make([]string, len(items))
+	for i, m := range items {
+		srcs[i] = path.Join(to, m.destName)
+		names[i] = m.name
+	}
+	return func(ctx context.Context, c *baidu.Client) error {
+		if len(srcs) > 0 {
+			if err := c.MoveAs(ctx, srcs, names, from); err != nil {
+				return err
+			}
+		}
+		if len(replaced) > 0 {
+			return c.Restore(ctx, replaced)
+		}
+		return nil
+	}
+}
+
+// copyBack deletes the copies an operation put in to (into the recycle
+// bin) and restores whatever the copy replaced there. Only the copies the
+// operation recorded are touched, never another file of the user's.
+func copyBack(items []movedItem, to string, replaced []int64) func(ctx context.Context, c *baidu.Client) error {
+	srcs := make([]string, len(items))
+	for i, m := range items {
+		srcs[i] = path.Join(to, m.destName)
+	}
+	return func(ctx context.Context, c *baidu.Client) error {
+		if err := c.Delete(ctx, srcs); err != nil {
+			return err
+		}
+		if len(replaced) > 0 {
+			return c.Restore(ctx, replaced)
+		}
+		return nil
+	}
+}
+
+// undoLabel says what a step did, as its undo toast shows it.
+func undoLabel(verb string, items []movedItem, to string) string {
+	if len(items) == 1 {
+		return verb + "「" + items[0].name + "」到「" + dirLabel(to) + "」"
+	}
+	return verb + " " + itoa(len(items)) + " 项到「" + dirLabel(to) + "」"
+}
+
+// replacedIDs are the fs_ids of the copies an operation replaced, which
+// its undo restores.
+func replacedIDs(files []baidu.File) []int64 {
+	if len(files) == 0 {
+		return nil
+	}
+	ids := make([]int64, len(files))
+	for i, f := range files {
+		ids[i] = f.FsID
+	}
+	return ids
+}
