+/**
+ * The membership badge beside the account name: a gold pill for SVIP, a tonal
+ * one for VIP, nothing for a normal account.
+ */
+@Composable
+private fun VipBadge(vipType: Int, label: String) {
+    val gold = Color(0xFFF5C542)
+    Surface(
+        shape = RoundedCornerShape(999.dp),
+        color = if (vipType == 2) gold else MaterialTheme.colorScheme.primaryContainer,
+        contentColor = if (vipType == 2) Color(0xFF4A3200) else MaterialTheme.colorScheme.onPrimaryContainer,
+        modifier = Modifier.padding(vertical = 1.dp),
+    ) {
+        Text(
+            text = label,
+            style = MaterialTheme.typography.labelSmall,
+            fontWeight = FontWeight.SemiBold,
+            modifier = Modifier.padding(horizontal = 7.dp, vertical = 2.dp),
+        )
+    }
+}
