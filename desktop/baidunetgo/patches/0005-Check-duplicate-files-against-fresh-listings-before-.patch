+// dedupStillThere reads the folders of the groups that have chosen files
+// and returns those the netdisk still holds with the same fs_id, size and
+// MD5. A group whose kept copy is gone or changed loses all its chosen
+// copies too, so no group is left without one; changed counts everything
+// left out.
+func dedupStillThere(ctx context.Context, c *baidu.Client, groups []dedup.Group, chosen map[string]bool) (safe []baidu.File, changed int) {
+	dirs := map[string]bool{}
+	for _, g := range groups {
+		any := false
+		for _, f := range g.Files {
+			if chosen[f.Path] {
+				any = true
+				break
+			}
+		}
+		if !any {
+			continue
+		}
+		for _, f := range g.Files {
+			dirs[path.Dir(f.Path)] = true
+		}
+	}
+	have := map[string]baidu.File{}
+	for dir := range dirs {
+		files, err := c.List(ctx, dir, baidu.Order{By: "name"})
+		if err != nil {
+			continue
+		}
+		for _, f := range files {
+			have[f.Path] = f
+		}
+	}
+	same := func(f baidu.File) bool {
+		h, ok := have[f.Path]
+		return ok && h.Size == f.Size && h.MD5 == f.MD5 && (f.FsID == 0 || h.FsID == f.FsID)
+	}
+	for _, g := range groups {
+		any := false
+		for _, f := range g.Files {
+			if chosen[f.Path] {
+				any = true
+				break
+			}
+		}
+		if !any {
+			continue
+		}
+		keep := false
+		for _, f := range g.Files {
+			if !chosen[f.Path] && same(f) {
+				keep = true
+				break
+			}
+		}
+		for _, f := range g.Files {
+			if !chosen[f.Path] {
+				continue
+			}
+			if !keep || !same(f) {
+				changed++
+				continue
+			}
+			safe = append(safe, f)
+		}
+	}
+	return safe, changed
+}
