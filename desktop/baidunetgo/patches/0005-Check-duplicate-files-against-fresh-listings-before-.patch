+// TestDedupSkipsChangedFiles checks the scan's results against the folders
+// again before deleting: a copy that changed since it was found, or a group
+// whose kept copy is gone, is left alone.
+func TestDedupSkipsChangedFiles(t *testing.T) {
+	oldWorkers, oldReport := dedupWorkers, dedupReport
+	dedupWorkers, dedupReport = 2, 0
+	t.Cleanup(func() { dedupWorkers, dedupReport = oldWorkers, oldReport })
+
+	a, tt, srv := signedIn(t)
+	a.router.Replace("/dedup")
+	waitUntil(t, tt, "the dedup scan", func() bool { return a.dedup.loaded })
+
+	d := &a.dedup
+	if len(d.groups) == 0 {
+		t.Fatal("no duplicates found")
+	}
+	g := d.groups[0]
+	if len(g.Files) < 2 {
+		t.Fatalf("group has %d files", len(g.Files))
+	}
+	kept, extra := g.Files[0], g.Files[1]
+	d.clearSelection()
+	d.chosen[extra.Path] = true
+	d.recount()
+	tt.Advance(100 * time.Millisecond)
+
+	// The kept copy changed after the scan: the chosen copy is not deleted,
+	// as that would leave the group without the file it was scanned as.
+	srv.Add(fakepan.Node{Path: kept.Path, Data: []byte("changed after the scan"), Mtime: time.Now().Unix()})
+	if err := tt.Click("移入回收站"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if err := tt.Click("确认移入"); err != nil {
+		t.Fatal(err)
+	}
+	waitUntil(t, tt, "the checked delete", func() bool { return !d.busy })
+	if !srv.Exists(extra.Path) {
+		t.Errorf("deleted %q although its group's kept copy had changed", extra.Path)
+	}
+	if !tt.HasText("已变化") {
+		t.Errorf("no word of the change: %q", tt.Texts())
+	}
+}
+
+// TestDedupSignOutClears drops a scan and its results when the account
+// signs out, so another account never sees or deletes the first one's
+// files.
+func TestDedupSignOutClears(t *testing.T) {
+	oldWorkers, oldReport := dedupWorkers, dedupReport
+	dedupWorkers, dedupReport = 2, 0
+	t.Cleanup(func() { dedupWorkers, dedupReport = oldWorkers, oldReport })
+
+	a, tt, _ := signedIn(t)
+	a.router.Replace("/dedup")
+	waitUntil(t, tt, "the dedup scan", func() bool { return a.dedup.loaded })
+
+	a.signOut()
+	tt.Advance(300 * time.Millisecond)
+	d := &a.dedup
+	if d.started || d.scanning || d.loaded || d.groups != nil || d.files != nil || d.chosen != nil {
+		t.Errorf("signing out left the dedup page with %+v", d)
+	}
+}
