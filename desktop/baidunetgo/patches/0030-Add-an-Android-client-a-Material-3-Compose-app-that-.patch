@@ -0,0 +1,156 @@
+package com.pengstem.baidunetgo.data
+
+import com.pengstem.baidunetgo.core.net.Credentials
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.add
+import kotlinx.serialization.json.addJsonObject
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonArray
+
+/** Theme choice; the system default follows the OS dark mode setting. */
+enum class ThemeMode { System, Light, Dark }
+
+/** A persisted SAF tree the user authorised for folder backup. */
+data class FolderEntry(val uri: String, val name: String)
+
+/**
+ * Immutable app settings, persisted as an encrypted JSON document.
+ *
+ * Note: `intervalMinutes == 0` means "manual only" — auto switches then only
+ * control the visibility of the feature, not a periodic job.
+ */
+data class AppSettings(
+    val dest: String = DEFAULT_DEST,
+    val autoFolder: Boolean = false,
+    val autoAlbum: Boolean = true,
+    val intervalMinutes: Int = 0,
+    val folderEncrypt: Boolean = false,
+    val albumEncrypt: Boolean = false,
+    val folders: List<FolderEntry> = emptyList(),
+    val wifiOnly: Boolean = true,
+    val concurrency: Int = 2,
+    val theme: ThemeMode = ThemeMode.System,
+    /** Albums the user unchecked; new albums default to selected. */
+    val deselectedAlbums: Set<Long> = emptySet(),
+    val notificationAsked: Boolean = false,
+) {
+    companion object {
+        const val DEFAULT_DEST = "/备份"
+    }
+}
+
+/** Encodes settings / credentials / passphrase documents without a codegen plugin. */
+internal object SecureJson {
+
+    private val json = Json { ignoreUnknownKeys = true }
+
+    // ---- settings --------------------------------------------------------
+
+    fun encodeSettings(settings: AppSettings): String = buildJsonObject {
+        put("version", 1)
+        put("dest", settings.dest)
+        put("autoFolder", settings.autoFolder)
+        put("autoAlbum", settings.autoAlbum)
+        put("intervalMinutes", settings.intervalMinutes)
+        put("folderEncrypt", settings.folderEncrypt)
+        put("albumEncrypt", settings.albumEncrypt)
+        put("wifiOnly", settings.wifiOnly)
+        put("concurrency", settings.concurrency)
+        put("theme", settings.theme.name)
+        put("notificationAsked", settings.notificationAsked)
+        putJsonArray("folders") {
+            settings.folders.forEach { folder ->
+                addJsonObject {
+                    put("uri", folder.uri)
+                    put("name", folder.name)
+                }
+            }
+        }
+        putJsonArray("deselectedAlbums") {
+            settings.deselectedAlbums.sorted().forEach { add(it) }
+        }
+    }.toString()
+
+    fun decodeSettings(text: String?): AppSettings {
+        if (text.isNullOrBlank()) return AppSettings()
+        return runCatching {
+            val obj = json.parseToJsonElement(text).jsonObject
+            val folders = obj["folders"]?.jsonArray?.mapNotNull { element ->
+                val item = element.jsonObject
+                val uri = item["uri"]?.jsonPrimitive?.contentOrNullSafe() ?: return@mapNotNull null
+                FolderEntry(uri = uri, name = item["name"]?.jsonPrimitive?.contentOrNullSafe() ?: "文件夹")
+            }.orEmpty()
+            val deselected = obj["deselectedAlbums"]?.jsonArray
+                ?.mapNotNull { it.jsonPrimitive.contentOrNullSafe()?.toLongOrNull() }
+                ?.toSet().orEmpty()
+            AppSettings(
+                dest = obj["dest"]?.jsonPrimitive?.contentOrNullSafe() ?: AppSettings.DEFAULT_DEST,
+                autoFolder = obj["autoFolder"]?.jsonPrimitive?.contentOrNullSafe()?.toBooleanStrictOrNull() ?: false,
+                autoAlbum = obj["autoAlbum"]?.jsonPrimitive?.contentOrNullSafe()?.toBooleanStrictOrNull() ?: true,
+                intervalMinutes = obj["intervalMinutes"]?.jsonPrimitive?.contentOrNullSafe()?.toIntOrNull() ?: 0,
+                folderEncrypt = obj["folderEncrypt"]?.jsonPrimitive?.contentOrNullSafe()?.toBooleanStrictOrNull() ?: false,
+                albumEncrypt = obj["albumEncrypt"]?.jsonPrimitive?.contentOrNullSafe()?.toBooleanStrictOrNull() ?: false,
+                folders = folders,
+                wifiOnly = obj["wifiOnly"]?.jsonPrimitive?.contentOrNullSafe()?.toBooleanStrictOrNull() ?: true,
+                concurrency = (obj["concurrency"]?.jsonPrimitive?.contentOrNullSafe()?.toIntOrNull() ?: 2).coerceIn(1, 4),
+                theme = obj["theme"]?.jsonPrimitive?.contentOrNullSafe()
+                    ?.let { name -> ThemeMode.entries.firstOrNull { it.name == name } } ?: ThemeMode.System,
+                deselectedAlbums = deselected,
+                notificationAsked = obj["notificationAsked"]?.jsonPrimitive?.contentOrNullSafe()?.toBooleanStrictOrNull() ?: false,
+            )
+        }.getOrElse { AppSettings() }
+    }
+
+    // ---- credentials -----------------------------------------------------
+
+    fun encodeCredentials(credentials: Credentials): String = buildJsonObject {
+        put("cookies", credentials.cookies)
+        put("bduss", credentials.bduss)
+        put("stoken", credentials.stoken)
+        credentials.uid?.let { put("uid", it) }
+        credentials.name?.let { put("name", it) }
+    }.toString()
+
+    fun decodeCredentials(text: String?): Credentials? {
+        if (text.isNullOrBlank()) return null
+        return runCatching {
+            val obj = json.parseToJsonElement(text).jsonObject
+            val bduss = obj["bduss"]?.jsonPrimitive?.contentOrNullSafe() ?: return null
+            val stoken = obj["stoken"]?.jsonPrimitive?.contentOrNullSafe() ?: return null
+            if (bduss.isBlank() || stoken.isBlank()) return null
+            Credentials(
+                cookies = obj["cookies"]?.jsonPrimitive?.contentOrNullSafe() ?: "",
+                bduss = bduss,
+                stoken = stoken,
+                uid = obj["uid"]?.jsonPrimitive?.contentOrNullSafe()?.toLongOrNull(),
+                name = obj["name"]?.jsonPrimitive?.contentOrNullSafe(),
+            )
+        }.getOrNull()
+    }
+
+    // ---- passphrase ------------------------------------------------------
+
+    fun encodePassphrase(passphrase: CharArray): String = buildJsonObject {
+        put("passphrase", String(passphrase))
+    }.toString()
+
+    fun decodePassphrase(text: String?): CharArray? {
+        if (text.isNullOrBlank()) return null
+        return runCatching {
+            val value = json.parseToJsonElement(text).jsonObject["passphrase"]
+                ?.jsonPrimitive?.contentOrNullSafe()
+            if (value.isNullOrEmpty()) null else value.toCharArray()
+        }.getOrNull()
+    }
+}
+
+/**
+ * `contentOrNull` in kotlinx-serialization is an experimental extension; using
+ * [kotlinx.serialization.json.JsonPrimitive] directly keeps this file warning
+ * free across compiler versions.
+ */
+private fun kotlinx.serialization.json.JsonPrimitive.contentOrNullSafe(): String? = content
