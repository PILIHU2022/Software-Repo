+package com.pengstem.baidunetgo.core.net
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonNull
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.JsonPrimitive
+import okhttp3.Call
+import okhttp3.Callback
+import okhttp3.Cookie
+import okhttp3.CookieJar
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.Response
+import java.io.IOException
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+
+/** JSON reader used for every netdisk answer: tolerant of new fields. */
+internal val ApiJson: Json = Json {
+    ignoreUnknownKeys = true
+    isLenient = true
+}
+
+// ---------------------------------------------------------------------------
+// JSON helpers: the netdisk sends numbers as numbers *or* as strings.
+// ---------------------------------------------------------------------------
+
+internal fun JsonObject.stringOrEmpty(key: String): String =
+    (this[key] as? JsonPrimitive)?.contentOrNull ?: ""
+
+internal fun JsonObject.longOrZero(key: String): Long =
+    (this[key] as? JsonPrimitive)?.contentOrNull?.trim()?.toLongOrNull() ?: 0L
+
+internal fun JsonObject.intOrZero(key: String): Int =
+    (this[key] as? JsonPrimitive)?.contentOrNull?.trim()?.toIntOrNull() ?: 0
+
+internal fun JsonObject.boolOrFalse(key: String): Boolean =
+    (this[key] as? JsonPrimitive)?.contentOrNull?.trim() == "1" ||
+        (this[key] as? JsonPrimitive)?.contentOrNull?.trim()?.equals("true", true) == true
+
+internal fun JsonObject.objectOrNull(key: String): JsonObject? = this[key] as? JsonObject
+
+internal fun JsonObject.arrayOrNull(key: String): JsonArray? = this[key] as? JsonArray
+
+internal fun JsonElement?.asLongOrZero(): Long = when (this) {
+    is JsonPrimitive -> contentOrNull?.trim()?.toLongOrNull() ?: 0L
+    else -> 0L
+}
+
+internal fun JsonElement?.asStringOrEmpty(): String = when (this) {
+    is JsonPrimitive -> contentOrNull ?: ""
+    else -> ""
+}
+
+// ---------------------------------------------------------------------------
+// Cookie jar
+// ---------------------------------------------------------------------------
+
+/**
+ * The session's cookies, in one place per client/QR-login, so that `BDUSS` and
+ * `STOKEN` obtained while signing in travel with every later call — the web API,
+ * the PCS upload host and passport alike.
+ *
+ * Cookies are kept by name (not by domain), which is what the desktop app does
+ * when it stores one cookie header: the same session serves `pan.baidu.com`,
+ * `c.pcs.baidu.com` and `passport.baidu.com`. They are handed out for the
+ * `.baidu.com` domain so OkHttp's own machinery treats them as a normal session.
+ */
+internal class SessionCookieJar : CookieJar {
+
+    private val cookies = LinkedHashMap<String, String>()
+    private val lock = Any()
+
+    override fun saveFromResponse(url: HttpUrl, cookies: List<Cookie>) {
+        synchronized(lock) {
+            for (cookie in cookies) putLocked(cookie.name, cookie.value)
+        }
+    }
+
+    override fun loadForRequest(url: HttpUrl): List<Cookie> {
+        val snapshot = synchronized(lock) {
+            cookies.entries.map { it.key to it.value }
+        }
+        return snapshot.mapNotNull { (name, value) ->
+            try {
+                Cookie.Builder().name(name).value(value).domain("baidu.com").path("/").build()
+            } catch (e: IllegalArgumentException) {
+                null
+            }
+        }
+    }
+
+    /** Sets one cookie, replacing an earlier value of the same name. */
+    fun put(name: String, value: String) {
+        synchronized(lock) { putLocked(name, value) }
+    }
+
+    private fun putLocked(name: String, value: String) {
+        if (name.isEmpty()) return
+        cookies.remove(name)
+        cookies[name] = value
+    }
+
+    fun get(name: String): String? = synchronized(lock) { cookies[name] }
+
+    /** Forgets every cookie (sign-out). */
+    fun clear() {
+        synchronized(lock) { cookies.clear() }
+    }
+
+    /** Loads every cookie of a stored cookie header, plus the BDUSS/STOKEN pair. */
+    fun seed(credentials: Credentials) {
+        for ((name, value) in parseCookieHeader(credentials.cookies)) put(name, value)
+        if (credentials.bduss.isNotEmpty()) put("BDUSS", credentials.bduss)
+        if (credentials.stoken.isNotEmpty()) put("STOKEN", credentials.stoken)
+    }
+
+    /** Copies cookies from another jar (a caller-supplied OkHttp client may have one). */
+    fun seedFrom(jar: CookieJar) {
+        val panUrl = "https://pan.baidu.com/".toHttpUrl()
+        for (cookie in jar.loadForRequest(panUrl)) put(cookie.name, cookie.value)
+    }
+
+    /** `Name=Value; …`, BDUSS and STOKEN first — the form the desktop app stores. */
+    fun header(): String {
+        val snapshot = synchronized(lock) {
+            val ordered = ArrayList<Pair<String, String>>(cookies.size)
+            cookies["BDUSS"]?.let { ordered += "BDUSS" to it }
+            cookies["STOKEN"]?.let { ordered += "STOKEN" to it }
+            for ((name, value) in cookies) {
+                if (name != "BDUSS" && name != "STOKEN") ordered += name to value
+            }
+            ordered
+        }
+        return snapshot.joinToString("; ") { (name, value) -> "$name=$value" }
+    }
+
+    /** Parses a `Name=Value; Name=Value` header, keeping `=` inside values. */
+    companion object {
+        fun parseCookieHeader(header: String): List<Pair<String, String>> {
+            if (header.isBlank()) return emptyList()
+            val out = ArrayList<Pair<String, String>>()
+            for (part in header.split(';')) {
+                val text = part.trim()
+                if (text.isEmpty()) continue
+                val eq = text.indexOf('=')
+                if (eq <= 0) continue
+                out += text.substring(0, eq).trim() to text.substring(eq + 1).trim()
+            }
+            return out
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// OkHttp <-> coroutines
+// ---------------------------------------------------------------------------
+
+/**
+ * Runs [request] on OkHttp's dispatcher and resumes with `transform(response)`.
+ * Cancelling the coroutine cancels the call (which aborts the request body write
+ * too); a cancelled call never surfaces as a netdisk error.
+ */
+internal suspend fun <T> OkHttpClient.awaitResponse(request: Request, transform: (Response) -> T): T =
+    suspendCancellableCoroutine { cont ->
+        val call = newCall(request)
+        cont.invokeOnCancellation { call.cancel() }
+        call.enqueue(object : Callback {
+            override fun onFailure(call: Call, e: IOException) {
+                if (cont.isCancelled) return
+                if (call.isCanceled()) {
+                    cont.resumeWithException(CancellationException("请求已取消"))
+                } else {
+                    cont.resumeWithException(
+                        BaiduException("网络请求失败：${e.message ?: e.javaClass.simpleName}")
+                    )
+                }
+            }
+
+            override fun onResponse(call: Call, response: Response) {
+                try {
+                    if (cont.isCancelled) return
+                    cont.resume(transform(response))
+                } catch (t: Throwable) {
+                    if (cont.isActive) cont.resumeWithException(t)
+                } finally {
+                    response.close()
+                }
+            }
+        })
+    }
+
+// ---------------------------------------------------------------------------
+// Progress throttling
+// ---------------------------------------------------------------------------
+
+/**
+ * Throttles progress callbacks to at most four a second, so a 4 MiB part filling
+ * fast does not flood the UI with updates; the first report goes out at once and
+ * [finish] always reports the final state.
+ */
+internal class ThrottledProgress(
+    private val intervalMillis: Long = 250L,
+    private val callback: (done: Long, total: Long) -> Unit,
+) {
+    private val lock = Any()
+    private var lastAtNanos = 0L
+
+    fun report(done: Long, total: Long) {
+        val now = System.nanoTime()
+        val fire = synchronized(lock) {
+            if (lastAtNanos == 0L || now - lastAtNanos >= intervalMillis * 1_000_000L) {
+                lastAtNanos = now
+                true
+            } else {
+                false
+            }
+        }
+        if (fire) callback(done, total)
+    }
+
+    fun finish(done: Long, total: Long) {
+        synchronized(lock) { lastAtNanos = System.nanoTime() }
+        callback(done, total)
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Error envelope
+// ---------------------------------------------------------------------------
+
+/**
+ * Turns the netdisk's error envelope into a typed exception. An expired session
+ * calls [onSessionExpired] (the client drops its cached bdstoken there, so the
+ * next write fetches a fresh one lazily) and throws [NotLoggedInException].
+ */
+internal fun checkErrno(op: String, obj: JsonObject, onSessionExpired: () -> Unit = {}) {
+    var errno = obj.longOrZero("errno")
+    val errorCode = obj.longOrZero("error_code")
+    if (errno == 0L && errorCode != 0L) errno = errorCode
+    if (errno == 0L) return
+    if (errno == -6L || errno == -4L || errno == 111L) {
+        onSessionExpired()
+        throw NotLoggedInException("${op}失败：登录已失效，请重新登录", errno.toInt())
+    }
+    val message = obj.stringOrEmpty("show_msg")
+        .ifEmpty { obj.stringOrEmpty("errmsg") }
+        .ifEmpty { obj.stringOrEmpty("error_msg") }
+        .ifEmpty { errnoText(errno.toInt()) }
+    throw BaiduException("${op}失败：$message", errno.toInt())
+}
+
+/** What an errno means, in the words the desktop app uses. */
+internal fun errnoText(errno: Int): String = when (errno) {
+    -6, -4, 111 -> "登录已失效"
+    -7 -> "文件名不合法"
+    -8 -> "已存在同名文件"
+    -9 -> "文件不存在"
+    -10, -32 -> "网盘空间不足"
+    2 -> "参数错误"
+    12 -> "部分文件操作失败"
+    31066 -> "文件不存在"
+    105 -> "链接格式错误"
+    -21 -> "分享已失效"
+    132 -> "需要安全验证，请在百度网盘网页版或 App 中完成后重试"
+    -62, -70 -> "需要验证码，请稍后再试"
+    else -> "未知错误"
+}
