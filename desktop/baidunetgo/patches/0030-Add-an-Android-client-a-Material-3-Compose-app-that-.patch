+package com.pengstem.baidunetgo.ui
+
+import android.content.Context
+import com.pengstem.baidunetgo.R
+import com.pengstem.baidunetgo.core.ByteSize
+import java.time.Instant
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+import java.util.Locale
+
+/** Formatting helpers shared by every screen. Pure functions, no state. */
+object AppFormat {
+
+    private val dateTime: DateTimeFormatter = DateTimeFormatter.ofPattern("MM-dd HH:mm", Locale.ROOT)
+
+    /** "12.5 MB"; delegates to `:core`'s formatter so both halves agree. */
+    fun bytes(value: Long): String = ByteSize.format(value.coerceAtLeast(0L))
+
+    fun speed(bytesPerSecond: Long): String =
+        if (bytesPerSecond <= 0L) "—" else ByteSize.format(bytesPerSecond) + "/s"
+
+    /** Local "MM-dd HH:mm", or [fallback] for 0 / unknown timestamps. */
+    fun time(millis: Long, fallback: String = "—"): String {
+        if (millis <= 0L) return fallback
+        return runCatching {
+            dateTime.format(Instant.ofEpochMilli(millis).atZone(ZoneId.systemDefault()))
+        }.getOrDefault(fallback)
+    }
+
+    /** "2 分钟前" style label for recent timestamps, absolute time otherwise. */
+    fun relativeTime(
+        context: Context,
+        millis: Long,
+        nowMillis: Long = System.currentTimeMillis(),
+        fallback: String = "—",
+    ): String {
+        if (millis <= 0L) return fallback
+        val delta = nowMillis - millis
+        return when {
+            delta < 60_000L -> context.getString(R.string.time_just_now)
+            delta < 3_600_000L -> context.getString(R.string.time_minutes_ago, delta / 60_000L)
+            delta < 86_400_000L -> context.getString(R.string.time_hours_ago, delta / 3_600_000L)
+            else -> time(millis, fallback)
+        }
+    }
+
+    fun percent(value: Float): String = "${(value.coerceIn(0f, 1f) * 100).toInt()}%"
+
+    /** Netdisk path normalisation: leading slash, no trailing slash, never root-empty. */
+    fun normaliseDest(input: String): String {
+        val trimmed = input.trim().ifEmpty { "/备份" }
+        val withSlash = if (trimmed.startsWith("/")) trimmed else "/$trimmed"
+        val collapsed = withSlash.replace(Regex("/+"), "/")
+        return if (collapsed.length > 1 && collapsed.endsWith("/")) collapsed.dropLast(1) else collapsed
+    }
+
+    fun isValidDest(input: String): Boolean {
+        if (input.isBlank()) return false
+        val path = normaliseDest(input)
+        return path.length in 2..512 && path.startsWith("/") && !path.contains("//")
+    }
+}
