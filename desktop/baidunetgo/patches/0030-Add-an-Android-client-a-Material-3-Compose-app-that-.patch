+/** Live progress card for a running backup, with a cancel action. */
+@Composable
+fun RunProgressCard(
+    snapshot: RunSnapshot,
+    kindLabel: String,
+    modifier: Modifier = Modifier,
+    onCancel: () -> Unit,
+) {
+    Card(
+        modifier = modifier.fillMaxWidth(),
+        colors = CardDefaults.cardColors(
+            containerColor = MaterialTheme.colorScheme.surfaceContainerHigh,
+        ),
+    ) {
+        Column(
+            modifier = Modifier.padding(16.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Column(modifier = Modifier.weight(1f)) {
+                    Text(text = kindLabel, style = MaterialTheme.typography.titleMedium)
+                    if (snapshot.stepCount > 1) {
+                        Text(
+                            text = stringResource(
+                                if (snapshot.kind == RunKind.Folder) {
+                                    R.string.folder_progress_step
+                                } else {
+                                    R.string.album_progress_step
+                                },
+                                snapshot.stepIndex,
+                                snapshot.stepCount,
+                            ),
+                            style = MaterialTheme.typography.labelMedium,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                    }
+                }
+                AssistChip(
+                    onClick = onCancel,
+                    label = { Text(stringResource(R.string.action_cancel)) },
+                )
+            }
+            Text(
+                text = stringResource(
+                    R.string.backup_current_file,
+                    if (snapshot.file.isBlank()) stringResource(R.string.status_loading) else snapshot.file,
+                ),
+                style = MaterialTheme.typography.bodyMedium,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+            LinearProgressIndicator(
+                progress = { snapshot.percent },
+                modifier = Modifier.fillMaxWidth(),
+                // A backup is not a discrete task: the M3 stop dot would sit at
+                // the end of the track and read as a finished 100% mark.
+                drawStopIndicator = {},
+            )
+            Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+                Text(
+                    text = AppFormat.percent(snapshot.percent),
+                    style = MaterialTheme.typography.labelLarge,
+                    color = MaterialTheme.colorScheme.primary,
+                )
+                Text(
+                    text = stringResource(
+                        R.string.backup_progress_counts,
+                        snapshot.uploaded,
+                        snapshot.skipped,
+                        snapshot.failed,
+                    ),
+                    style = MaterialTheme.typography.labelMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+                Spacer(Modifier.weight(1f))
+                Text(
+                    text = if (snapshot.bytesPerSecond > 0L) {
+                        stringResource(R.string.transfer_speed, AppFormat.bytes(snapshot.bytesPerSecond))
+                    } else {
+                        "—"
+                    },
+                    style = MaterialTheme.typography.labelMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+        }
+    }
+}
