+                "web" to "1",
+            ),
+            "获取上传服务器",
+        )
+        val servers = obj.arrayOrNull("servers")
+        val first = servers?.firstOrNull()
+            ?: throw BaiduException("上传失败：没有拿到上传服务器")
+        val host = when (first) {
+            is JsonObject -> first.stringOrEmpty("server")
+            is JsonPrimitive -> first.contentOrNull.orEmpty()
+            else -> ""
+        }.trim()
+        if (host.isEmpty()) throw BaiduException("上传失败：没有拿到上传服务器")
+        return host
+    }
+
+    /** Sends one part, retrying twice on a transient failure; a refusal is final. */
+    private suspend fun uploadPartWithRetry(
+        pcsHost: String,
+        remote: String,
+        uploadId: String,
+        seq: Int,
+        open: () -> InputStream,
+        offset: Long,
+        length: Long,
+        onBytes: (Long) -> Unit,
+    ): String {
+        var lastError: Exception? = null
+        for (attempt in 1..PartAttempts) {
+            currentCoroutineContext().ensureActive()
+            try {
+                return sendPart(pcsHost, remote, uploadId, seq, open, offset, length, onBytes)
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: NotLoggedInException) {
+                throw e
+            } catch (e: PartRefusedException) {
+                throw e
+            } catch (e: Exception) {
+                lastError = e
+                if (attempt < PartAttempts) {
+                    delay(250L * attempt)
+                }
+            }
+        }
+        throw BaiduException(
+            "上传失败：第 ${seq + 1} 个分片上传失败" +
+                (lastError?.message?.let { "（$it）" } ?: "")
+        )
+    }
+
+    private suspend fun sendPart(
+        pcsHost: String,
+        remote: String,
+        uploadId: String,
+        seq: Int,
+        open: () -> InputStream,
+        offset: Long,
+        length: Long,
+        onBytes: (Long) -> Unit,
+    ): String {
+        val url = (pcsHost.trimEnd('/') + "/rest/2.0/pcs/superfile2").toHttpUrl().newBuilder()
+            .addQueryParameter("method", "upload")
+            .addQueryParameter("type", "tmpfile")
+            .addQueryParameter("path", remote)
+            .addQueryParameter("partseq", seq.toString())
+            .addQueryParameter("uploadid", uploadId)
+            .addQueryParameter("vip", "1")
+            .build()
+        val body = MultipartBody.Builder()
+            .setType(MultipartBody.FORM)
+            .addFormDataPart("file", "part", StreamingPartBody(open, offset, length, onBytes))
+            .build()
+        val request = Request.Builder()
+            .url(url)
+            .header("User-Agent", NetdiskUserAgent)
+            .header("Referer", PanHomeReferer)
+            .post(body)
+            .build()
+        val (code, text) = client.awaitResponse(request) { response -> response.code to response.body.string() }
+        when {
+            code == 400 || code == 401 || code == 403 || code == 404 || code == 413 ->
+                throw PartRefusedException("上传失败：网盘拒绝了第 ${seq + 1} 个分片（HTTP $code）")
+            code >= 400 -> throw IOException("HTTP $code")
+        }
+        val obj = try {
+            ApiJson.parseToJsonElement(text).jsonObject
+        } catch (e: Exception) {
+            throw IOException("分片响应无法解析")
+        }
+        checkErrno("上传分片", obj)
+        return obj.stringOrEmpty("md5")
+    }
+
+    // -----------------------------------------------------------------------
+    // HTTP plumbing
+    // -----------------------------------------------------------------------
+
+    /** The query every write carries: the session's bdstoken and the web client's ids. */
+    private suspend fun webQuery(extra: Map<String, String> = emptyMap()): Map<String, String> {
+        val query = LinkedHashMap<String, String>()
+        query["bdstoken"] = bdstoken()
+        query["clienttype"] = "0"
+        query["app_id"] = AppId
+        query["web"] = "1"
+        query.putAll(extra)
+        return query
+    }
+
+    private suspend fun bdstoken(): String {
+        token?.takeIf { it.isNotEmpty() }?.let { return it }
+        val status = loginStatus()
+        val fetched = status.bdstoken.ifEmpty { token.orEmpty() }
+        if (fetched.isEmpty()) {
+            throw NotLoggedInException("写入网盘失败：登录已失效，请重新登录")
+        }
+        token = fetched
+        return fetched
+    }
+
+    private suspend fun get(
+        path: String,
+        query: Map<String, String> = emptyMap(),
+        op: String,
+    ): JsonObject {
+        currentCoroutineContext().ensureActive()
+        val request = Request.Builder()
+            .url(buildUrl(path, query))
+            .header("User-Agent", NetdiskUserAgent)
+            .header("Referer", PanHomeReferer)
+            .get()
+            .build()
+        return readJson(op, request)
+    }
+
+    private suspend fun postForm(
+        path: String,
+        query: Map<String, String>,
+        form: Map<String, String>,
+        op: String,
+    ): JsonObject {
+        currentCoroutineContext().ensureActive()
+        val body = FormBody.Builder().apply {
+            for ((name, value) in form) add(name, value)
+        }.build()
+        val request = Request.Builder()
+            .url(buildUrl(path, query))
+            .header("User-Agent", NetdiskUserAgent)
+            .header("Referer", PanHomeReferer)
+            .post(body)
+            .build()
+        return readJson(op, request)
+    }
+
+    private fun buildUrl(path: String, query: Map<String, String>): okhttp3.HttpUrl {
+        val builder = (baseUrl + path).toHttpUrl().newBuilder()
+        for ((name, value) in query) builder.addQueryParameter(name, value)
+        return builder.build()
+    }
+
+    private suspend fun readJson(op: String, request: Request): JsonObject {
+        val (code, text) = client.awaitResponse(request) { response -> response.code to response.body.string() }
+        if (code >= 400) throw BaiduException("${op}失败：服务器返回 HTTP $code")
+        val obj = try {
+            ApiJson.parseToJsonElement(text).jsonObject
+        } catch (e: Exception) {
+            throw BaiduException("${op}失败：服务器返回了无法解析的数据")
+        }
+        checkErrno(op, obj) { token = null }
+        return obj
+    }
+
+    private fun parseRemoteFile(entry: JsonObject): RemoteFile {
+        var name = entry.stringOrEmpty("server_filename")
+        if (name.isEmpty()) name = entry.stringOrEmpty("path").substringAfterLast('/')
+        return RemoteFile(
+            name = name,
+            isDir = entry.intOrZero("isdir") == 1,
+            size = entry.longOrZero("size"),
+            fsId = entry.longOrZero("fs_id"),
+            md5 = decryptMd5(entry.stringOrEmpty("md5")),
+            modified = entry.longOrZero("server_mtime"),
+        )
+    }
+
+    private companion object {
+        const val AppId = "250528"
+        const val MaxListPages = 50
+        const val MaxUploadConnections = 8
+        const val PartAttempts = 3
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Constants and helpers shared by the client and its tests
+// ---------------------------------------------------------------------------
+
+/** BaiduPCS's `MinUploadBlockSize`: every uploaded part is 4 MiB. */
+internal const val PartSize: Long = 4L shl 20
+
+/** How much of a part is read into memory at a time (a part is never buffered whole). */
+internal const val PartChunk: Int = 256 shl 10
+
+/**
+ * A part of the content, streamed straight from a fresh source stream into the
+ * request body; nothing beyond one [PartChunk] buffer is ever held.
+ */
+private class StreamingPartBody(
+    private val open: () -> InputStream,
+    private val offset: Long,
+    private val length: Long,
+    private val onBytes: (Long) -> Unit,
+) : RequestBody() {
+
+    override fun contentType() = "application/octet-stream".toMediaType()
+
+    override fun contentLength(): Long = length
+
+    override fun writeTo(sink: BufferedSink) {
+        open().use { input ->
+            input.skipFully(offset)
+            val buffer = ByteArray(PartChunk)
+            var left = length
+            while (left > 0) {
+                val read = input.read(buffer, 0, minOf(buffer.size.toLong(), left).toInt())
+                if (read < 0) throw IOException("读取本地文件失败：文件在上传过程中被截短")
+                sink.write(buffer, 0, read)
+                left -= read
+                onBytes(read.toLong())
+            }
+        }
+    }
+}
+
+/** Skips [count] bytes, reading when [InputStream.skip] moves less than asked. */
+internal fun InputStream.skipFully(count: Long) {
+    var left = count
+    if (left <= 0) return
+    val scratch = ByteArray(64 shl 10)
+    while (left > 0) {
+        val skipped = skip(left)
+        if (skipped > 0) {
+            left -= skipped
+            continue
+        }
+        val read = read(scratch, 0, minOf(scratch.size.toLong(), left).toInt())
+        if (read < 0) throw IOException("读取本地文件失败：文件在上传过程中被截短")
+        left -= read
+    }
+}
+
+internal fun partLength(size: Long, index: Int): Long =
+    minOf(PartSize, size - index.toLong() * PartSize)
+
+internal fun List<String>.toJsonArrayString(): String =
+    JsonArray(map { JsonPrimitive(it) }).toString()
+
+/** A part the netdisk refused outright (HTTP 4xx); retrying it is pointless. */
+internal class PartRefusedException(message: String) : BaiduException(message)
+
+private val HexDigits = "0123456789abcdef".toCharArray()
+
+internal fun ByteArray.toHex(): String {
+    val out = CharArray(size * 2)
+    for (i in indices) {
+        val value = this[i].toInt() and 0xFF
+        out[i * 2] = HexDigits[value ushr 4]
+        out[i * 2 + 1] = HexDigits[value and 0x0F]
+    }
+    return String(out)
+}
+
+/**
+ * BaiduPCS-Go's `DecryptMD5`: `/api/list` hands out scambled MD5s, with the 10th
+ * hex digit shifted out of range and every digit XORed with its position. Ported
+ * exactly (including the `'g' + v` marker and the final block swap), so the hash
+ * matches what the desktop app shows.
+ */
+internal fun decryptMd5(raw: String): String {
+    if (raw.length != 32) return raw
+    val keyChar = raw[9]
+    if (keyChar in '0'..'9' || keyChar in 'a'..'f') return raw
+    val shifted = keyChar - 'g'
+    if (shifted !in 0..15) return raw
+    val swapped = raw.substring(0, 9) + HexDigits[shifted] + raw.substring(10)
+    val builder = StringBuilder(swapped.length)
+    for (index in swapped.indices) {
+        val char = swapped[index]
+        if (char == '-') {
+            builder.append(HexDigits[15 and index])
+            continue
+        }
+        val value = Character.digit(char, 16)
+        if (value < 0) return raw
+        builder.append(HexDigits[value xor (15 and index)])
+    }
+    if (builder.length != 32) return raw
+    val text = builder.toString()
+    return text.substring(8, 16) + text.substring(0, 8) +
+        text.substring(24, 32) + text.substring(16, 24)
+}
