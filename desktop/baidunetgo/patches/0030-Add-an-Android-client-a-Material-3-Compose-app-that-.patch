+package com.pengstem.baidunetgo.core.backup
+
+import com.pengstem.baidunetgo.core.crypto.Pgp
+import com.pengstem.baidunetgo.core.net.BaiduException
+import com.pengstem.baidunetgo.core.net.Netdisk
+import com.pengstem.baidunetgo.core.net.RemoteFile
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeoutOrNull
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.nio.file.Files
+import java.nio.file.attribute.PosixFilePermissions
+import java.util.Collections
+import java.util.Random
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * The incremental backup engine against an in-memory [Netdisk]: first run, skips,
+ * changed files, nested folders, exclusions, encryption (with decryption and no
+ * temporary files left), failures that do not stop the run, cancellation (state
+ * saved for finished files), and the state file's round trip and corruption
+ * tolerance.
+ */
+class BackupTest {
+
+    @get:Rule
+    val tmp = TemporaryFolder()
+
+    private val passphrase = "backup passphrase".toCharArray()
+
+    // -----------------------------------------------------------------------
+    // First run, skip, changed file
+    // -----------------------------------------------------------------------
+
+    @Test
+    fun firstRunUploadsEverythingAndCreatesFoldersOnce() = runBlocking {
+        val root = tmp.newFolder("相机")
+        writeFile(root, "a.txt", "hello".toByteArray())
+        writeFile(root, "2024/b.jpg", ByteArray(2048) { (it * 7).toByte() })
+        val fake = FakeNetdisk()
+        val store = store("state.json")
+        val config = BackupConfig(dest = "/备份", remoteName = "相册/相机")
+
+        val result = Backup.run(fake, FolderSource(root), config, store, null)
+
+        assertEquals(2, result.uploaded)
+        assertEquals(0, result.skipped)
+        assertEquals(0, result.failed)
+        assertEquals(5L + 2048L, result.bytes)
+        assertEquals(
+            setOf("/备份/相册/相机/a.txt", "/备份/相册/相机/2024/b.jpg"),
+            fake.files.keys.toSet(),
+        )
+        // Every missing folder was created exactly once, top-down.
+        assertEquals(
+            listOf("/备份", "/备份/相册", "/备份/相册/相机", "/备份/相册/相机/2024"),
+            fake.mkdirCalls.toList(),
+        )
+        assertEquals(2, store.load().entries.size)
+
+        val second = Backup.run(fake, FolderSource(root), config, store, null)
+        assertEquals("nothing changed, so nothing is uploaded", 0, second.uploaded)
+        assertEquals(2, second.skipped)
+        assertEquals(2, fake.uploads.size)
+    }
+
+    @Test
+    fun changedFileIsUploadedAgainAndOthersAreSkipped() = runBlocking {
+        val root = tmp.newFolder("文档")
+        val changed = writeFile(root, "a.txt", "first".toByteArray())
+        writeFile(root, "b.txt", "second".toByteArray())
+        val fake = FakeNetdisk()
+        val store = store("state.json")
+        val config = BackupConfig(dest = "/备份", remoteName = "文档")
+
+        assertEquals(2, Backup.run(fake, FolderSource(root), config, store, null).uploaded)
+
+        changed.writeText("first, but longer")
+        changed.setLastModified(System.currentTimeMillis() + 5_000)
+
+        val result = Backup.run(fake, FolderSource(root), config, store, null)
+        assertEquals(1, result.uploaded)
+        assertEquals(1, result.skipped)
+        assertEquals("first, but longer", String(fake.files["/备份/文档/a.txt"]!!))
+        assertEquals("b.txt is unchanged", "second", String(fake.files["/备份/文档/b.txt"]!!))
+    }
+
+    @Test
+    fun remotePathsAreNormalised() = runBlocking {
+        val root = tmp.newFolder("相册源")
+        writeFile(root, "IMG_0001.jpg", byteArrayOf(1, 2, 3))
+        val fake = FakeNetdisk()
+
+        val result = Backup.run(
+            fake,
+            FolderSource(root, label = "相册/相机"),
+            BackupConfig(dest = "/备份/", remoteName = "/相册/相机/"),
+            store("state.json"),
+            null,
+        )
+
+        assertEquals(1, result.uploaded)
+        assertEquals(setOf("/备份/相册/相机/IMG_0001.jpg"), fake.files.keys)
+    }
+
+    // -----------------------------------------------------------------------
+    // Exclusions and the folder source
+    // -----------------------------------------------------------------------
+
+    @Test
+    fun folderSourceExcludesSystemAndToolFiles() {
+        val root = tmp.newFolder("源")
+        writeFile(root, "keep.txt", byteArrayOf(1))
+        writeFile(root, ".git/config", byteArrayOf(2))
+        writeFile(root, "node_modules/pkg/index.js", byteArrayOf(3))
+        writeFile(root, ".cache/x.bin", byteArrayOf(4))
+        writeFile(root, ".Trash/old.bin", byteArrayOf(5))
+        writeFile(root, ".DS_Store", byteArrayOf(6))
+        writeFile(root, "Thumbs.db", byteArrayOf(7))
+        writeFile(root, "~\$草稿.docx", byteArrayOf(8))
+        writeFile(root, "sub/.gitignore", byteArrayOf(9))
+
+        val source = FolderSource(root)
+        assertEquals(root.name, source.label)
+        assertEquals(listOf("keep.txt", "sub/.gitignore"), source.files().map { it.relativePath })
+
+        assertTrue(defaultExcludes.containsAll(listOf(".git", "node_modules", ".cache", ".Trash", ".DS_Store", "Thumbs.db")))
+        assertFalse(isExcludedName("notes.txt", defaultExcludes))
+        assertTrue(isExcludedName("~\$报告.docx", defaultExcludes))
+    }
+
+    // -----------------------------------------------------------------------
+    // Encryption
+    // -----------------------------------------------------------------------
+
+    @Test
+    fun encryptedBackupUploadsGpgNamesAndLeavesNoTempFile() = runBlocking {
+        val root = tmp.newFolder("加密源")
+        val content = randomBytes(300_000)
+        writeFile(root, "secret.bin", content)
+        val fake = FakeNetdisk()
+        val store = store("state.json")
+        val tempDir = File(System.getProperty("java.io.tmpdir"))
+        val tempsBefore = tempFiles(tempDir, "baidunetgo-")
+
+        val result = Backup.run(
+            fake,
+            FolderSource(root),
+            BackupConfig(dest = "/备份", remoteName = "加密", encrypt = true, parallel = 2),
+            store,
+            passphrase,
+        )
+
+        assertEquals(1, result.uploaded)
+        val remote = fake.files.keys.single()
+        assertEquals("/备份/加密/secret.bin.gpg", remote)
+        val encrypted = File(tmp.root, "downloaded.gpg").apply { writeBytes(fake.files[remote]!!) }
+        val decrypted = File(tmp.root, "decrypted.bin")
+        Pgp.decryptFile(decrypted, encrypted, passphrase)
+        assertArrayEquals(content, decrypted.readBytes())
+        assertEquals(
+            "the encryption temp file must be gone",
+            tempsBefore,
+            tempFiles(tempDir, "baidunetgo-"),
+        )
+    }
+
+    @Test
+    fun emptyPassphraseWhileEncryptingIsAnError() = runBlocking {
+        val root = tmp.newFolder("空口令")
+        writeFile(root, "a.txt", byteArrayOf(1))
+        val fake = FakeNetdisk()
+        try {
+            Backup.run(
+                fake,
+                FolderSource(root),
+                BackupConfig(dest = "/备份", remoteName = "空口令", encrypt = true),
+                store("state.json"),
+                CharArray(0),
+            )
+            fail("encrypting without a passphrase must throw")
+        } catch (e: BackupException) {
+            assertTrue("message: ${e.message}", e.message!!.contains("口令"))
+        }
+        assertEquals(0, fake.uploads.size)
+    }
+
+    // -----------------------------------------------------------------------
+    // Failures and cancellation
+    // -----------------------------------------------------------------------
+
+    @Test
+    fun oneFailingFileDoesNotStopTheRun() = runBlocking {
+        val root = tmp.newFolder("失败源")
+        writeFile(root, "a.txt", "a".toByteArray())
+        writeFile(root, "b.txt", "b".toByteArray())
+        writeFile(root, "c.txt", "c".toByteArray())
+        val fake = FakeNetdisk().apply { failOn = { remote -> remote.endsWith("b.txt") } }
+
+        val result = Backup.run(fake, FolderSource(root), BackupConfig(dest = "/备份", remoteName = "失败"), store("state.json"), null)
+
+        assertEquals(2, result.uploaded)
+        assertEquals(1, result.failed)
+        assertEquals(1, result.errors.size)
+        assertTrue(result.errors.single(), result.errors.single().contains("b.txt"))
+        assertTrue(fake.files.keys.any { it.endsWith("a.txt") })
+        assertTrue(fake.files.keys.any { it.endsWith("c.txt") })
+        assertFalse(fake.files.keys.any { it.endsWith("b.txt") })
+    }
+
+    @Test
+    fun cancellationSavesStateForFinishedFiles() = runBlocking {
+        val root = tmp.newFolder("取消源")
+        writeFile(root, "a.txt", "a".toByteArray())
+        writeFile(root, "b.txt", "b".toByteArray())
+        val blocked = CompletableDeferred<Unit>()
+        val fake = FakeNetdisk().apply {
+            gate = { remote -> if (remote.endsWith("b.txt")) blocked.await() }
+        }
+        val store = store("state.json")
+        var thrown: Throwable? = null
+
+        val job = launch(Dispatchers.Default) {
+            try {
+                Backup.run(fake, FolderSource(root), BackupConfig(dest = "/备份", remoteName = "取消", parallel = 2), store, null)
+            } catch (e: Throwable) {
+                thrown = e
+                throw e
+            }
+        }
+        // Wait until a.txt has been uploaded and b.txt is being held.
+        val started = withTimeoutOrNull(10_000) {
+            while (fake.uploads.none { it.endsWith("a.txt") }) {
+                kotlinx.coroutines.delay(20)
+            }
+            true
+        }
+        assertTrue("a.txt should upload before the cancellation", started == true)
+        job.cancelAndJoin()
+
+        assertTrue("the run must end in CancellationException, was $thrown", thrown is kotlinx.coroutines.CancellationException)
+        val saved = store.load()
+        assertEquals(1, saved.entries.size)
+        assertTrue(saved.entries.keys.single().endsWith("a.txt"))
+    }
+
+    // -----------------------------------------------------------------------
+    // Progress and the state file
+    // -----------------------------------------------------------------------
+
+    @Test
+    fun progressIsThrottledAndReportsCumulativeCounters() = runBlocking {
+        val root = tmp.newFolder("进度源")
+        writeFile(root, "a.txt", "a".toByteArray())
+        writeFile(root, "b.txt", "b".toByteArray())
+        val fake = FakeNetdisk().apply { progressReports = 100 }
+        val events = Collections.synchronizedList(ArrayList<BackupProgress>())
+
+        val result = Backup.run(
+            fake,
+            FolderSource(root),
+            BackupConfig(dest = "/备份", remoteName = "进度"),
+            store("state.json"),
+            null,
+        ) { event -> events += event }
+
+        assertEquals(2, result.uploaded)
+        val last = events.last()
+        assertEquals("cumulative uploaded count", 2, last.uploaded)
+        assertEquals(0, last.skipped)
+        assertEquals(0, last.failed)
+        assertTrue("progress must be reported", events.isNotEmpty())
+        val perFile = events.groupingBy { it.file }.eachCount()
+        for ((file, count) in perFile) {
+            assertTrue("at most 4 progress callbacks a second per file ($file had $count)", count <= 6)
+        }
+        assertTrue(events.any { it.total > 0 && it.done == it.total })
+    }
+
+    @Test
+    fun stateFileRoundTripsAndToleratesGarbage() {
+        val path = File(tmp.root, "nested/backup-state.json")
+        val store = BackupStateStore(path.path)
+        assertEquals(BackupState(), store.load())
+
+        val state = BackupState(
+            entries = mapOf(
+                "相机|a.txt" to StateEntry(size = 5, lastModified = 1234, remote = "/备份/相机/a.txt"),
+            ),
+        )
+        store.save(state)
+        assertEquals(state, store.load())
+
+        // 0600 where the filesystem has POSIX permissions.
+        val permissions = try {
+            Files.getPosixFilePermissions(path.toPath())
+        } catch (e: UnsupportedOperationException) {
+            null
+        }
+        if (permissions != null) {
+            assertEquals(PosixFilePermissions.fromString("rw-------"), permissions)
+        }
+
+        path.writeText("{ this is not json")
+        assertEquals("corrupt state reads as empty", BackupState(), store.load())
+
+        path.writeText("")
+        assertEquals("empty state reads as empty", BackupState(), store.load())
+    }
+
+    @Test
+    fun unknownStateFieldsAreIgnored() {
+        val path = File(tmp.root, "state.json")
+        path.writeText("""{"version":1,"entries":{"l|a.txt":{"size":5,"lastModified":9,"remote":"/r","future":"x"}},"more":true}""")
+        val state = BackupStateStore(path.path).load()
+        assertEquals(1, state.entries.size)
+        assertEquals(StateEntry(5, 9, "/r"), state.entries["l|a.txt"])
+    }
+
+    // -----------------------------------------------------------------------
+    // Helpers
+    // -----------------------------------------------------------------------
+
+    private fun store(name: String): BackupStateStore = BackupStateStore(File(tmp.root, name).path)
+
+    private fun writeFile(root: File, relativePath: String, content: ByteArray): File {
+        val file = File(root, relativePath)
+        file.parentFile.mkdirs()
+        file.writeBytes(content)
+        return file
+    }
+
+    private fun randomBytes(size: Int): ByteArray {
+        val bytes = ByteArray(size)
+        Random(0x5EEDL xor size.toLong()).nextBytes(bytes)
+        return bytes
+    }
+
+    private fun tempFiles(dir: File, prefix: String): Set<String> =
+        (dir.listFiles() ?: emptyArray()).filter { it.name.startsWith(prefix) }.map { it.name }.toSet()
+
+    /** An in-memory netdisk: folders, files, a failure hook, a pause hook and a request log. */
+    private class FakeNetdisk : Netdisk {
+
+        val dirs: MutableSet<String> = ConcurrentHashMap.newKeySet<String>().apply { add("/") }
+        val files: MutableMap<String, ByteArray> = ConcurrentHashMap()
+        val mkdirCalls: MutableList<String> = Collections.synchronizedList(ArrayList())
+        val uploads: MutableList<String> = Collections.synchronizedList(ArrayList())
+
+        @Volatile
+        var failOn: (String) -> Boolean = { false }
+
+        @Volatile
+        var gate: (suspend (String) -> Unit)? = null
+
+        @Volatile
+        var progressReports: Int = 1
+
+        private val ids = AtomicLong(1000)
+
+        override suspend fun list(dir: String, page: Int, pageSize: Int): List<RemoteFile> {
+            if (dir !in dirs) throw BaiduException("读取目录失败：文件不存在", -9)
+            return files.entries
+                .filter { parentOf(it.key) == dir }
+                .map { (path, data) ->
+                    RemoteFile(
+                        name = path.substringAfterLast('/'),
+                        isDir = false,
+                        size = data.size.toLong(),
+                        fsId = ids.incrementAndGet(),
+                        md5 = "",
+                        modified = 0,
+                    )
+                }
+        }
+
+        override suspend fun mkdir(dir: String) {
+            mkdirCalls += dir
+            dirs += dir
+        }
+
+        override suspend fun upload(
+            local: File,
+            remote: String,
+            connections: Int,
+            onProgress: (done: Long, total: Long) -> Unit,
+        ) {
+            gate?.invoke(remote)
+            if (failOn(remote)) throw BaiduException("上传失败：模拟的失败", -9)
+            val data = local.readBytes()
+            val total = data.size.toLong()
+            repeat(progressReports) { step ->
+                onProgress(total * (step + 1) / progressReports, total)
+            }
+            files[remote] = data
+            uploads += remote
+        }
+
+        private fun parentOf(path: String): String {
+            val index = path.lastIndexOf('/')
+            return if (index <= 0) "/" else path.substring(0, index)
+        }
+    }
+}
