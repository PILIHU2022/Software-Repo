+package com.pengstem.baidunetgo.service
+
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.os.Build
+import android.os.IBinder
+import androidx.core.app.ServiceCompat
+import androidx.core.content.ContextCompat
+import com.pengstem.baidunetgo.BaiduNetGoApplication
+import com.pengstem.baidunetgo.R
+import com.pengstem.baidunetgo.data.AppContainer
+import com.pengstem.baidunetgo.data.BackupBus
+import com.pengstem.baidunetgo.data.RunFinished
+import com.pengstem.baidunetgo.data.RunKind
+import com.pengstem.baidunetgo.data.RunSnapshot
+import com.pengstem.baidunetgo.data.TransferRecord
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * Foreground service that runs user-initiated backups.
+ *
+ * Why a service: a folder/album backup can take many minutes, and the user is
+ * expected to leave the app while it continues. The service keeps a progress
+ * notification (with a cancel action) up for the whole run and publishes
+ * progress on [BackupBus] so the UI shows the same state when it comes back.
+ *
+ * Periodic runs do not use this service; WorkManager's own scheduling handles
+ * those (see [BackupWorker]).
+ */
+class BackupService : Service() {
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var runJob: Job? = null
+    private var lastNotifyNanos = 0L
+    private lateinit var container: AppContainer
+
+    override fun onCreate() {
+        super.onCreate()
+        container = (application as BaiduNetGoApplication).container
+        BackupNotifications.ensureChannel(this)
+    }
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        when (intent?.action) {
+            ACTION_START_FOLDER -> startRun(RunKind.Folder)
+            ACTION_START_ALBUM -> startRun(RunKind.Album)
+            ACTION_CANCEL -> cancelRun()
+            else -> stopSelf()
+        }
+        return START_NOT_STICKY
+    }
+
+    override fun onDestroy() {
+        scope.cancel()
+        super.onDestroy()
+    }
+
+    private fun startRun(kind: RunKind) {
+        // One run at a time: a second start while a run is active is ignored.
+        if (runJob?.isActive == true) return
+        goForeground(kind)
+        runJob = scope.launch {
+            var record: TransferRecord? = null
+            var failure: String? = null
+            try {
+                val settings = container.settingsStore.load()
+                record = when (kind) {
+                    RunKind.Folder -> container.runner.runFolder(settings) { onProgress(it) }
+                    RunKind.Album -> container.runner.runAlbum(settings) { onProgress(it) }
+                }
+                BackupBus.finish(RunFinished(kind, cancelled = false, record = record))
+            } catch (e: CancellationException) {
+                withContext(NonCancellable) {
+                    val cancelled = cancelledRecord(kind)
+                    container.transferStore.add(cancelled)
+                    BackupBus.finish(RunFinished(kind, cancelled = true, record = cancelled))
+                    BackupNotifications.notifyResult(
+                        this@BackupService,
+                        BackupNotifications.result(this@BackupService, kind, cancelled),
+                    )
+                }
+            } catch (e: Exception) {
+                failure = e.message ?: e.javaClass.simpleName
+                BackupBus.finish(RunFinished(kind, cancelled = false, record = null, error = failure))
+            } finally {
+                val errorMessage = failure
+                val resultRecord = record
+                withContext(NonCancellable) {
+                    if (errorMessage != null) {
+                        BackupNotifications.notifyResult(
+                            this@BackupService,
+                            BackupNotifications.failed(this@BackupService, kind, errorMessage),
+                        )
+                    } else if (resultRecord != null) {
+                        BackupNotifications.notifyResult(
+                            this@BackupService,
+                            BackupNotifications.result(this@BackupService, kind, resultRecord),
+                        )
+                    }
+                    ServiceCompat.stopForeground(
+                        this@BackupService,
+                        ServiceCompat.STOP_FOREGROUND_REMOVE,
+                    )
+                    stopSelf()
+                }
+            }
+        }
+    }
+
+    private fun onProgress(snapshot: RunSnapshot) {
+        BackupBus.update(snapshot)
+        val now = System.nanoTime()
+        if (now - lastNotifyNanos < NOTIFY_INTERVAL_NANOS) return
+        lastNotifyNanos = now
+        BackupNotifications.notifyProgress(this, snapshot)
+    }
+
+    private fun goForeground(kind: RunKind) {
+        val starting = RunSnapshot(
+            kind = kind,
+            label = getString(R.string.status_loading),
+            file = "",
+            percent = 0f,
+            done = 0,
+            total = 0,
+            uploaded = 0,
+            skipped = 0,
+            failed = 0,
+            bytesPerSecond = 0,
+            stepIndex = 1,
+            stepCount = 1,
+        )
+        val type = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC
+        } else {
+            0
+        }
+        ServiceCompat.startForeground(
+            this,
+            BackupNotifications.PROGRESS_NOTIFICATION_ID,
+            BackupNotifications.progress(this, starting),
+            type,
+        )
+    }
+
+    private fun cancelRun() {
+        val job = runJob
+        if (job == null || !job.isActive) {
+            stopSelf()
+            return
+        }
+        job.cancel()
+    }
+
+    private fun cancelledRecord(kind: RunKind) = TransferRecord(
+        id = java.util.UUID.randomUUID().toString(),
+        kind = if (kind == RunKind.Folder) "folder" else "album",
+        label = getString(if (kind == RunKind.Folder) R.string.notify_title_folder else R.string.notify_title_album),
+        finishedAt = System.currentTimeMillis(),
+        uploaded = 0,
+        skipped = 0,
+        failed = 0,
+        bytes = 0,
+        cancelled = true,
+    )
+
+    companion object {
+        const val ACTION_START_FOLDER = "com.pengstem.baidunetgo.action.START_FOLDER"
+        const val ACTION_START_ALBUM = "com.pengstem.baidunetgo.action.START_ALBUM"
+        const val ACTION_CANCEL = "com.pengstem.baidunetgo.action.CANCEL_BACKUP"
+        private const val NOTIFY_INTERVAL_NANOS = 700_000_000L
+
+        fun start(context: Context, kind: RunKind) {
+            val action = when (kind) {
+                RunKind.Folder -> ACTION_START_FOLDER
+                RunKind.Album -> ACTION_START_ALBUM
+            }
+            ContextCompat.startForegroundService(
+                context,
+                Intent(context, BackupService::class.java).setAction(action),
+            )
+        }
+
+        fun cancel(context: Context) {
+            runCatching {
+                context.startService(
+                    Intent(context, BackupService::class.java).setAction(ACTION_CANCEL),
+                )
+            }
+        }
+    }
+}
