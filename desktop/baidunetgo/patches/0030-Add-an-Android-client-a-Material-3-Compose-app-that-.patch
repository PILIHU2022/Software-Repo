+package com.pengstem.baidunetgo.data
+
+import android.content.Context
+import android.net.Uri
+import android.provider.DocumentsContract
+import androidx.documentfile.provider.DocumentFile
+import com.pengstem.baidunetgo.R
+import com.pengstem.baidunetgo.core.backup.BackupSource
+import com.pengstem.baidunetgo.core.backup.SourceFile
+import com.pengstem.baidunetgo.core.backup.defaultExcludes
+import java.io.IOException
+
+/**
+ * [BackupSource] over a SAF tree (`ACTION_OPEN_DOCUMENT_TREE`).
+ *
+ * The app only ever reads from the tree; it never creates, moves or deletes
+ * anything. Instead of [DocumentFile]'s per-property binder calls this walks
+ * `DocumentsContract` child cursors: one query per directory for all of its
+ * children (name, mime type, size, last-modified), which keeps a large tree
+ * from taking minutes. The walk is bounded by [MAX_FILES], and names from
+ * `:core`'s [defaultExcludes] (plus `~$` office temp files) are skipped.
+ */
+class DocumentSource(
+    private val context: Context,
+    private val treeUri: Uri,
+    override val label: String,
+) : BackupSource {
+
+    private val resolver = context.contentResolver
+    private val treeDocumentId: String? = runCatching {
+        DocumentsContract.getTreeDocumentId(treeUri)
+    }.getOrNull()
+
+    override fun files(): List<SourceFile> {
+        // The display name is resolved by the caller; fall back to DocumentFile
+        // only if the tree document id is unavailable.
+        val rootId = treeDocumentId ?: DocumentFile.fromTreeUri(context, treeUri)?.let { root ->
+            runCatching { DocumentsContract.getDocumentId(root.uri) }.getOrNull()
+        } ?: return emptyList()
+        val collected = ArrayList<SourceFile>(64)
+        walk(rootId, "", collected)
+        return collected
+    }
+
+    private fun walk(parentDocumentId: String, prefix: String, out: MutableList<SourceFile>) {
+        if (out.size >= MAX_FILES) return
+        val childrenUri = DocumentsContract.buildChildDocumentsUriUsingTree(treeUri, parentDocumentId)
+        val cursor = runCatching {
+            resolver.query(childrenUri, PROJECTION, null, null, null)
+        }.getOrNull() ?: return
+
+        // Read the whole directory first, then recurse: keeps only one cursor
+        // open at a time and lets the cursor be closed before nested queries.
+        val childDirectories = ArrayList<Pair<String, String>>(16)
+        cursor.use { c ->
+            while (out.size < MAX_FILES && c.moveToNext()) {
+                val documentId = c.getString(COLUMN_ID) ?: continue
+                val name = c.getString(COLUMN_NAME) ?: continue
+                if (isExcluded(name)) continue
+                if (c.getString(COLUMN_MIME) == DocumentsContract.Document.MIME_TYPE_DIR) {
+                    childDirectories += documentId to (prefix + name + "/")
+                } else {
+                    val relativePath = prefix + name
+                    val documentUri = DocumentsContract.buildDocumentUriUsingTree(treeUri, documentId)
+                    out += SourceFile(
+                        relativePath = relativePath,
+                        size = c.getLong(COLUMN_SIZE).coerceAtLeast(0L),
+                        lastModified = c.getLong(COLUMN_MODIFIED),
+                        open = {
+                            resolver.openInputStream(documentUri)
+                                ?: throw IOException(
+                                    context.getString(R.string.error_open_file, relativePath),
+                                )
+                        },
+                    )
+                }
+            }
+        }
+
+        for ((documentId, childPrefix) in childDirectories) {
+            if (out.size >= MAX_FILES) return
+            walk(documentId, childPrefix, out)
+        }
+    }
+
+    companion object {
+        /** Bounded walk: the engine treats a missing file as "try next run". */
+        const val MAX_FILES = 20_000
+
+        private val PROJECTION = arrayOf(
+            DocumentsContract.Document.COLUMN_DOCUMENT_ID,
+            DocumentsContract.Document.COLUMN_DISPLAY_NAME,
+            DocumentsContract.Document.COLUMN_MIME_TYPE,
+            DocumentsContract.Document.COLUMN_SIZE,
+            DocumentsContract.Document.COLUMN_LAST_MODIFIED,
+        )
+        private const val COLUMN_ID = 0
+        private const val COLUMN_NAME = 1
+        private const val COLUMN_MIME = 2
+        private const val COLUMN_SIZE = 3
+        private const val COLUMN_MODIFIED = 4
+
+        /** Extra names skipped by the SAF walker (Android-specific caches). */
+        private val extraExcludes = setOf(".thumbnails", "Android")
+
+        private fun isExcluded(name: String): Boolean =
+            name in defaultExcludes || name in extraExcludes || name.startsWith("~$")
+    }
+}
