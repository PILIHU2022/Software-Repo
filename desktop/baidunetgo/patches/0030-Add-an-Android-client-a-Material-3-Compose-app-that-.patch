+    private fun copy(src: InputStream, dst: OutputStream) {
+        val buffer = ByteArray(BufferSize)
+        while (true) {
+            val read = src.read(buffer)
+            if (read < 0) return
+            dst.write(buffer, 0, read)
+        }
+    }
