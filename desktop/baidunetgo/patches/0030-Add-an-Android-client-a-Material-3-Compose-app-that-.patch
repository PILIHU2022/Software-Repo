+                        .fillMaxWidth()
+                        .padding(20.dp),
+                    horizontalAlignment = Alignment.CenterHorizontally,
+                    verticalArrangement = Arrangement.spacedBy(14.dp),
+                ) {
+                    QrCodeArea(state = state, onRefreshQr = onRefreshQr)
+                    SignInStatus(state = state)
+                    state.error?.let { error ->
+                        Text(
+                            text = error,
