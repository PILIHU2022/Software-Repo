+package com.pengstem.baidunetgo.data
+
+import android.content.Context
+import androidx.work.BackoffPolicy
+import androidx.work.Constraints
+import androidx.work.ExistingPeriodicWorkPolicy
+import androidx.work.NetworkType
+import androidx.work.PeriodicWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.workDataOf
+import com.pengstem.baidunetgo.service.BackupWorker
+import java.util.concurrent.TimeUnit
+
+/**
+ * Keeps the two periodic backups in sync with [AppSettings].
+ *
+ * Both jobs share the interval from the 备份 screen and are minimum-15-minute
+ * periodic work, because that is the shortest interval WorkManager accepts.
+ * The passphrase and credentials are read by the worker itself, never put in
+ * [androidx.work.Data] (which is persisted unencrypted).
+ */
+object BackupScheduler {
+
+    const val FOLDER_WORK = "folder-auto-backup"
+    const val ALBUM_WORK = "album-auto-backup"
+    const val MIN_INTERVAL_MINUTES = 15L
+
+    fun apply(context: Context, settings: AppSettings) {
+        val interval = settings.intervalMinutes
+        val autoFolder = settings.autoFolder && interval >= MIN_INTERVAL_MINUTES.toInt()
+        val autoAlbum = settings.autoAlbum && interval >= MIN_INTERVAL_MINUTES.toInt()
+
+        schedule(
+            context = context,
+            uniqueName = FOLDER_WORK,
+            kind = BackupRunner.KIND_FOLDER,
+            enabled = autoFolder,
+            settings = settings,
+        )
+        schedule(
+            context = context,
+            uniqueName = ALBUM_WORK,
+            kind = BackupRunner.KIND_ALBUM,
+            enabled = autoAlbum,
+            settings = settings,
+        )
+    }
+
+    fun cancelAll(context: Context) {
+        WorkManager.getInstance(context).let { manager ->
+            manager.cancelUniqueWork(FOLDER_WORK)
+            manager.cancelUniqueWork(ALBUM_WORK)
+        }
+    }
+
+    private fun schedule(
+        context: Context,
+        uniqueName: String,
+        kind: String,
+        enabled: Boolean,
+        settings: AppSettings,
+    ) {
+        val manager = WorkManager.getInstance(context)
+        if (!enabled) {
+            manager.cancelUniqueWork(uniqueName)
+            return
+        }
+        val request = PeriodicWorkRequestBuilder<BackupWorker>(
+            settings.intervalMinutes.toLong().coerceAtLeast(MIN_INTERVAL_MINUTES),
+            TimeUnit.MINUTES,
+        )
+            .setConstraints(
+                Constraints.Builder()
+                    .setRequiredNetworkType(
+                        if (settings.wifiOnly) NetworkType.UNMETERED else NetworkType.CONNECTED,
+                    )
+                    .build(),
+            )
+            .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, 10, TimeUnit.MINUTES)
+            .setInputData(workDataOf(BackupWorker.KEY_KIND to kind))
+            .build()
+        manager.enqueueUniquePeriodicWork(
+            uniqueName,
+            ExistingPeriodicWorkPolicy.UPDATE,
+            request,
+        )
+    }
+}
