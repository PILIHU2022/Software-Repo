+++ b/android/core/src/test/kotlin/com/pengstem/baidunetgo/core/net/FakePand.kt
@@ -0,0 +1,190 @@
+package com.pengstem.baidunetgo.core.net
+
+import java.io.BufferedReader
+import java.io.File
+import java.io.InputStreamReader
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.TimeoutException
+
+/**
+ * Runs the Go fake netdisk (`cmd/fakepand`, built from the repository root) for a
+ * test, and reports the URL it printed plus the requests it logged to stderr.
+ *
+ * Either `FAKEPAN_URL` names an already-running fake netdisk (then no process is
+ * spawned and no request log exists), or the binary is built once with
+ * `go build -o … ./cmd/fakepand` and started per test; the `go` environment
+ * (`GOMODCACHE`, `GOPATH`, `GOCACHE`, `GOFLAGS`) is forwarded from the Gradle
+ * build. When there is no `go` on `PATH` and no `FAKEPAN_URL`, [startOrNull]
+ * returns `null` so tests can skip cleanly.
+ */
+class FakePand private constructor(
+    val url: String,
+    private val process: Process?,
+    private val logLines: MutableList<String>?,
+) : AutoCloseable {
+
+    /** Whether this instance has the fake's request log (i.e. it spawned the process). */
+    val hasRequestLog: Boolean get() = logLines != null
+
+    /** How many requests the fake served whose log line contains [fragment]. */
+    fun requestCount(fragment: String): Int {
+        val lines = logLines ?: return 0
+        synchronized(lines) {
+            return lines.count { it.contains(fragment) }
+        }
+    }
+
+    /** Every logged request line, for assertions about what the client sent. */
+    fun requests(): List<String> {
+        val lines = logLines ?: return emptyList()
+        synchronized(lines) {
+            return lines.toList()
+        }
+    }
+
+    override fun close() {
+        val running = process ?: return
+        running.destroy()
+        if (!running.waitFor(10, TimeUnit.SECONDS)) {
+            running.destroyForcibly()
+            running.waitFor(10, TimeUnit.SECONDS)
+        }
+    }
+
+    companion object {
+
+        private val buildLock = Any()
+        private var builtBinary: File? = null
+        private var buildFailure: String? = null
+
+        /** Starts a fake netdisk, or returns `null` when neither `go` nor `FAKEPAN_URL` is available. */
+        fun startOrNull(): FakePand? {
+            val fromEnvironment = System.getenv("FAKEPAN_URL")?.trim()
+            if (!fromEnvironment.isNullOrEmpty()) {
+                return FakePand(fromEnvironment.trimEnd('/'), null, null)
+            }
+            val binary = buildBinary() ?: return null
+            return spawn(binary)
+        }
+
+        /** Why the binary could not be built (for the skip message). */
+        fun unavailableReason(): String = buildFailure ?: "go is not available on PATH"
+
+        private fun buildBinary(): File? = synchronized(buildLock) {
+            builtBinary?.let { return it }
+            buildFailure?.let { return null }
+            val go = findGo()
+            if (go == null) {
+                buildFailure = "go is not available on PATH"
+                return null
+            }
+            val root = repoRoot()
+            val output = File(tmpDir(), "fakepand")
+            val builder = ProcessBuilder(go, "build", "-o", output.absolutePath, "./cmd/fakepand")
+                .directory(root)
+                .redirectErrorStream(true)
+            builder.environment()["GOFLAGS"] = System.getenv("GOFLAGS") ?: "-mod=mod"
+            builder.environment()["GOTOOLCHAIN"] = System.getenv("GOTOOLCHAIN") ?: "local"
+            val process = try {
+                builder.start()
+            } catch (e: Exception) {
+                buildFailure = "go build could not start: ${e.message}"
+                return null
+            }
+            val text = process.inputStream.readBytes().toString(Charsets.UTF_8)
+            val finished = process.waitFor(300, TimeUnit.SECONDS)
+            if (!finished) process.destroyForcibly()
+            if (!finished || process.exitValue() != 0) {
+                buildFailure = "go build ./cmd/fakepand failed:\n$text"
+                System.err.println(buildFailure)
+                return null
+            }
+            builtBinary = output
+            output
+        }
+
+        private fun spawn(binary: File): FakePand? {
+            val process = try {
+                ProcessBuilder(binary.absolutePath, "-addr", "127.0.0.1:0").start()
+            } catch (e: Exception) {
+                buildFailure = "fakepand could not start: ${e.message}"
+                return null
+            }
+            val lines = ArrayList<String>()
+            val firstLine = readFirstLine(process)
+            if (firstLine == null || !firstLine.startsWith("url=")) {
+                process.destroyForcibly()
+                buildFailure = "fakepand did not print a url= line"
+                return null
+            }
+            // Keep draining stderr (the fake's request log) in the background.
+            val drainer = Thread({
+                try {
+                    BufferedReader(InputStreamReader(process.errorStream)).use { reader ->
+                        while (true) {
+                            val line = reader.readLine() ?: break
+                            synchronized(lines) {
+                                if (lines.size < 20000) lines.add(line)
+                            }
+                        }
+                    }
+                } catch (ignored: Exception) {
+                    // The process went away; nothing to do.
+                }
+            }, "fakepand-log")
+            drainer.isDaemon = true
+            drainer.start()
+            return FakePand(firstLine.removePrefix("url=").trim().trimEnd('/'), process, lines)
+        }
+
+        private fun readFirstLine(process: Process): String? {
+            val pool = Executors.newSingleThreadExecutor { runnable ->
+                Thread(runnable, "fakepand-url").apply { isDaemon = true }
+            }
+            return try {
+                val reader = BufferedReader(InputStreamReader(process.inputStream))
+                pool.submit(java.util.concurrent.Callable { reader.readLine() }).get(30, TimeUnit.SECONDS)
+            } catch (e: TimeoutException) {
+                null
+            } catch (e: Exception) {
+                null
+            } finally {
+                pool.shutdownNow()
+            }
+        }
+
+        private fun tmpDir(): File {
+            val dir = File(System.getProperty("java.io.tmpdir"), "baidunetgo-tests")
+            dir.mkdirs()
+            return dir
+        }
+
+        private fun findGo(): String? {
+            val path = System.getenv("PATH") ?: return null
+            for (entry in path.split(File.pathSeparator)) {
+                if (entry.isBlank()) continue
+                val candidate = File(entry, "go")
+                if (candidate.isFile && candidate.canExecute()) return candidate.absolutePath
+            }
+            return null
+        }
+
+        /** The repository root: the module's Gradle build passes it in; otherwise search upward. */
+        private fun repoRoot(): File {
+            System.getProperty("baidunetgo.repoRoot")?.let { property ->
+                val dir = File(property).absoluteFile
+                if (File(dir, "cmd/fakepand").isDirectory) return dir
+            }
+            var dir = File(System.getProperty("user.dir")).absoluteFile
+            while (true) {
+                if (File(dir, "go.mod").isFile && File(dir, "cmd/fakepand").isDirectory) {
+                    return dir
+                }
+                dir = dir.parentFile ?: throw IllegalStateException(
+                    "cannot find the repository root (no go.mod + cmd/fakepand above ${System.getProperty("user.dir")})"
+                )
+            }
+        }
+    }
+}
