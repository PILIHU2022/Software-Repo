+// ---------------------------------------------------------------------------
+// Streams
+// ---------------------------------------------------------------------------
+
+/** Flushes through but never closes the stream it wraps (ciphertext sinks). */
+private class NonClosingOutputStream(private val delegate: OutputStream) : OutputStream() {
+    override fun write(b: Int) = delegate.write(b)
+    override fun write(b: ByteArray, off: Int, len: Int) = delegate.write(b, off, len)
+    override fun flush() = delegate.flush()
+    override fun close() {
+        delegate.flush()
+    }
+}
+
+/** Counts what was written and can be closed more than once. */
+private class CountingOutputStream(private val delegate: OutputStream) : OutputStream() {
+    var count: Long = 0
+        private set
+
+    override fun write(b: Int) {
+        delegate.write(b)
+        count++
+    }
+
+    override fun write(b: ByteArray, off: Int, len: Int) {
+        delegate.write(b, off, len)
+        count += len
+    }
+
+    override fun flush() = delegate.flush()
+
+    override fun close() = delegate.close()
+
+    /** Closes the delegate once; later calls do nothing. */
+    fun closeQuietly() {
+        try {
+            delegate.close()
+        } catch (e: Exception) {
+            // Nothing useful to do: the caller already has the real failure.
+        }
+    }
+}
