+package com.pengstem.baidunetgo.core.backup
+
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.io.IOException
+import java.nio.file.AtomicMoveNotSupportedException
+import java.nio.file.Files
+import java.nio.file.StandardCopyOption
+import java.nio.file.attribute.PosixFilePermissions
+
+/**
+ * The incremental state file: a small JSON document, written atomically (a
+ * temporary file beside it, then a rename) with `0600` where the filesystem has
+ * POSIX permissions.
+ *
+ * [load] is deliberately forgiving — a missing file, a truncated write after a
+ * crash, or hand-edited garbage all read as an empty [BackupState], so a run just
+ * uploads what it cannot prove is unchanged instead of failing.
+ */
+class BackupStateStore(val path: String) {
+
+    private val json = Json {
+        ignoreUnknownKeys = true
+        encodeDefaults = true
+    }
+
+    /** Reads the state; anything unreadable (missing, empty, corrupt) is a fresh state. */
+    fun load(): BackupState {
+        val file = File(path)
+        if (!file.isFile) return BackupState()
+        return try {
+            val text = file.readText(Charsets.UTF_8)
+            if (text.isBlank()) BackupState() else json.decodeFromString<BackupState>(text)
+        } catch (e: Exception) {
+            BackupState()
+        }
+    }
+
+    /**
+     * Writes the state atomically and privately: a temporary file in the same
+     * directory is written, chmodded to `0600`, and renamed over [path] (an
+     * atomic rename where the filesystem supports it, a replacing rename
+     * otherwise), so an interrupted write never leaves a half-written state.
+     */
+    fun save(state: BackupState) {
+        val target = File(path).absoluteFile
+        val parent = target.parentFile
+        try {
+            if (parent != null && !parent.isDirectory && !parent.mkdirs()) {
+                throw BackupException("保存备份状态失败：无法创建目录 ${parent.path}")
+            }
+            val tmp = File.createTempFile(target.name + ".", ".tmp", parent)
+            try {
+                tmp.writeText(json.encodeToString(BackupState.serializer(), state), Charsets.UTF_8)
+                makePrivate(tmp)
+                try {
+                    Files.move(
+                        tmp.toPath(),
+                        target.toPath(),
+                        StandardCopyOption.REPLACE_EXISTING,
+                        StandardCopyOption.ATOMIC_MOVE,
+                    )
+                } catch (e: AtomicMoveNotSupportedException) {
+                    Files.move(tmp.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING)
+                }
+                makePrivate(target)
+            } finally {
+                tmp.delete()
+            }
+        } catch (e: BackupException) {
+            throw e
+        } catch (e: IOException) {
+            throw BackupException("保存备份状态失败：${e.message}", e)
+        }
+    }
+
+    /** `0600` on POSIX filesystems; elsewhere the default permissions stand. */
+    private fun makePrivate(file: File) {
+        try {
+            val path = file.toPath()
+            if (path.fileSystem.supportedFileAttributeViews().contains("posix")) {
+                Files.setPosixFilePermissions(path, PosixFilePermissions.fromString("rw-------"))
+            }
+        } catch (e: Exception) {
+            // Not fatal: the state holds no secrets beyond file names and sizes.
+        }
+    }
+}
