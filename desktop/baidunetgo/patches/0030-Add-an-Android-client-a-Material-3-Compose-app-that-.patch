+package com.pengstem.baidunetgo.data
+
+import android.content.Context
+import com.pengstem.baidunetgo.core.net.Credentials
+import java.io.File
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.add
+import kotlinx.serialization.json.buildJsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+/**
+ * Settings repository: JSON, encrypted with the Keystore key, in `filesDir`.
+ *
+ * All methods are blocking and must be called from `Dispatchers.IO`.
+ */
+class SettingsStore(private val files: EncryptedFileStore) {
+
+    fun load(): AppSettings = SecureJson.decodeSettings(files.read(SETTINGS_FILE))
+
+    fun save(settings: AppSettings) {
+        files.write(SETTINGS_FILE, SecureJson.encodeSettings(settings))
+    }
+
+    companion object {
+        const val SETTINGS_FILE = "settings.json.enc"
+    }
+}
+
+/** Signed-in session, encrypted. Never logged. */
+class SessionStore(private val files: EncryptedFileStore) {
+
+    fun load(): Credentials? = SecureJson.decodeCredentials(files.read(SESSION_FILE))
+
+    fun save(credentials: Credentials) {
+        files.write(SESSION_FILE, SecureJson.encodeCredentials(credentials))
+    }
+
+    fun clear() = files.delete(SESSION_FILE)
+
+    companion object {
+        const val SESSION_FILE = "session.json.enc"
+    }
+}
+
+/** The OpenPGP backup passphrase, shared by folder and album backups. */
+class PassphraseStore(private val files: EncryptedFileStore) {
+
+    fun load(): CharArray? = SecureJson.decodePassphrase(files.read(PASSPHRASE_FILE))
+
+    fun save(passphrase: CharArray) {
+        val text = SecureJson.encodePassphrase(passphrase)
+        files.write(PASSPHRASE_FILE, text)
+    }
+
+    fun clear() = files.delete(PASSPHRASE_FILE)
+
+    companion object {
+        const val PASSPHRASE_FILE = "passphrase.json.enc"
+    }
+}
+
+/**
+ * Result of one folder-tree / album run, shown under the folder in the list.
+ * Timestamps are wall-clock milliseconds.
+ */
+data class BackupStatus(
+    val lastBackupAt: Long = 0,
+    val uploaded: Int = 0,
+    val skipped: Int = 0,
+    val failed: Int = 0,
+    val bytes: Long = 0,
+    val files: Int = 0,
+    val errors: List<String> = emptyList(),
+)
+
+/** Last finished run (either kind), shown as "上次结果". */
+data class LastResult(
+    val finishedAt: Long = 0,
+    val kind: String = "",
+    val uploaded: Int = 0,
+    val skipped: Int = 0,
+    val failed: Int = 0,
+    val bytes: Long = 0,
+    val errors: List<String> = emptyList(),
+    val cancelled: Boolean = false,
+)
+
+/**
+ * Per-folder and per-album statuses plus the last result, in one small JSON
+ * document. Not secret, but still app-private; writes are atomic.
+ */
+class BackupStatusStore(context: Context) {
+
+    private val file = JsonFile(File(context.filesDir, STATUS_FILE))
+
+    fun loadFolders(): Map<String, BackupStatus> = decode().folders
+
+    fun loadAlbums(): Map<Long, BackupStatus> = decode().albums
+
+    fun lastFolderResult(): LastResult? = decode().lastFolder
+
+    fun lastAlbumResult(): LastResult? = decode().lastAlbum
+
+    fun updateFolder(uri: String, status: BackupStatus) {
+        val current = decode()
+        file.write(encode(current.copy(folders = current.folders + (uri to status))))
+    }
+
+    fun updateAlbum(bucketId: Long, status: BackupStatus) {
+        val current = decode()
+        file.write(encode(current.copy(albums = current.albums + (bucketId to status))))
+    }
+
+    fun setLastResult(result: LastResult) {
+        val current = decode()
+        val updated = when (result.kind) {
+            KIND_FOLDER -> current.copy(lastFolder = result)
+            KIND_ALBUM -> current.copy(lastAlbum = result)
+            else -> current
+        }
+        file.write(encode(updated))
+    }
+
+    fun clear() = file.delete()
+
+    // ---- codec -----------------------------------------------------------
+
+    private data class Snapshot(
+        val folders: Map<String, BackupStatus> = emptyMap(),
+        val albums: Map<Long, BackupStatus> = emptyMap(),
+        val lastFolder: LastResult? = null,
+        val lastAlbum: LastResult? = null,
+    )
+
+    private fun decode(): Snapshot {
+        val text = file.read() ?: return Snapshot()
+        return runCatching {
+            val obj = Json.parseToJsonElement(text).jsonObject
+            val folders = obj["folders"]?.jsonObject?.mapNotNull { (key, value) ->
+                status(value.toString())?.let { key to it }
+            }?.toMap().orEmpty()
+            val albums = obj["albums"]?.jsonObject?.mapNotNull { (key, value) ->
+                key.toLongOrNull()?.let { id -> status(value.toString())?.let { id to it } }
+            }?.toMap().orEmpty()
+            Snapshot(
+                folders = folders,
+                albums = albums,
+                lastFolder = obj["lastFolder"]?.toString()?.let { lastResult(it) },
+                lastAlbum = obj["lastAlbum"]?.toString()?.let { lastResult(it) },
+            )
+        }.getOrElse { Snapshot() }
+    }
+
+    private fun status(text: String): BackupStatus? = runCatching {
+        val obj = Json.parseToJsonElement(text).jsonObject
+        BackupStatus(
+            lastBackupAt = obj.long("lastBackupAt"),
+            uploaded = obj.int("uploaded"),
+            skipped = obj.int("skipped"),
+            failed = obj.int("failed"),
+            bytes = obj.long("bytes"),
+            files = obj.int("files"),
+            errors = obj.stringList("errors"),
+        )
+    }.getOrNull()
+
+    private fun lastResult(text: String): LastResult? = runCatching {
+        val obj = Json.parseToJsonElement(text).jsonObject
+        LastResult(
+            finishedAt = obj.long("finishedAt"),
+            kind = obj.string("kind"),
+            uploaded = obj.int("uploaded"),
+            skipped = obj.int("skipped"),
+            failed = obj.int("failed"),
+            bytes = obj.long("bytes"),
+            errors = obj.stringList("errors"),
+            cancelled = obj.string("cancelled").toBoolean(),
+        )
+    }.getOrNull()
+
+    private fun encode(snapshot: Snapshot): String = buildJsonObject {
+        put(
+            "folders",
+            buildJsonObject {
+                snapshot.folders.forEach { (uri, status) -> put(uri, encodeStatus(status)) }
+            },
+        )
+        put(
+            "albums",
+            buildJsonObject {
+                snapshot.albums.forEach { (id, status) -> put(id.toString(), encodeStatus(status)) }
+            },
+        )
+        snapshot.lastFolder?.let { put("lastFolder", encodeResult(it)) }
+        snapshot.lastAlbum?.let { put("lastAlbum", encodeResult(it)) }
+    }.toString()
+
+    private fun encodeStatus(status: BackupStatus) = buildJsonObject {
+        put("lastBackupAt", status.lastBackupAt)
+        put("uploaded", status.uploaded)
+        put("skipped", status.skipped)
+        put("failed", status.failed)
+        put("bytes", status.bytes)
+        put("files", status.files)
+        put("errors", buildJsonArray { status.errors.take(20).forEach { add(it) } })
+    }
+
+    private fun encodeResult(result: LastResult) = buildJsonObject {
+        put("finishedAt", result.finishedAt)
+        put("kind", result.kind)
+        put("uploaded", result.uploaded)
+        put("skipped", result.skipped)
+        put("failed", result.failed)
+        put("bytes", result.bytes)
+        put("cancelled", result.cancelled)
+        put("errors", buildJsonArray { result.errors.take(20).forEach { add(it) } })
+    }
+
+    companion object {
+        const val STATUS_FILE = "backup-status.json"
+        const val KIND_FOLDER = "folder"
+        const val KIND_ALBUM = "album"
+    }
+}
+
+private fun kotlinx.serialization.json.JsonObject.string(key: String): String =
+    this[key]?.toString()?.trim('"') ?: ""
+
+private fun kotlinx.serialization.json.JsonObject.long(key: String): Long =
+    this[key]?.toString()?.trim('"')?.toLongOrNull() ?: 0L
+
+private fun kotlinx.serialization.json.JsonObject.int(key: String): Int =
+    this[key]?.toString()?.trim('"')?.toIntOrNull() ?: 0
+
+private fun kotlinx.serialization.json.JsonObject.stringList(key: String): List<String> =
+    this[key]?.let { element ->
+        runCatching {
+            element.jsonArray.mapNotNull { it.toString().trim('"').takeIf(String::isNotEmpty) }
+        }.getOrDefault(emptyList())
+    } ?: emptyList()
+
+private val kotlinx.serialization.json.JsonElement.jsonObject: kotlinx.serialization.json.JsonObject
+    get() = this as kotlinx.serialization.json.JsonObject
+private val kotlinx.serialization.json.JsonElement.jsonArray: kotlinx.serialization.json.JsonArray
+    get() = this as kotlinx.serialization.json.JsonArray
