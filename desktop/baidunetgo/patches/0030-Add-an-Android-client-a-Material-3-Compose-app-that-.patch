+// :core is a pure-JVM Kotlin module: no Android APIs, so the netdisk client,
+// backup engine and OpenPGP code (and their unit tests) can run on the JVM.
+plugins {
+    alias(libs.plugins.kotlin.jvm)
+    alias(libs.plugins.kotlin.serialization)
+}
+
+java {
+    sourceCompatibility = JavaVersion.VERSION_17
+    targetCompatibility = JavaVersion.VERSION_17
+}
+
+kotlin {
+    compilerOptions {
+        jvmTarget.set(org.jetbrains.kotlin.gradle.dsl.JvmTarget.JVM_17)
+    }
+}
+
+dependencies {
+    // Netdisk HTTP client (OkHttp: no HttpURLConnection, one CookieJar per client).
+    implementation(libs.okhttp)
+    // OpenPGP packets (bcpg) for the passphrase-encrypted backup format.
+    implementation(libs.bouncycastle.bcpg)
+    // Backup state file (JSON) and the netdisk API envelopes.
+    implementation(libs.kotlinx.serialization.json)
+    implementation(libs.kotlinx.serialization.core)
+    // suspend APIs and bounded-parallel backup uploads.
+    implementation(libs.kotlinx.coroutines.core)
+
+    testImplementation(libs.junit)
+    testImplementation(libs.kotlinx.coroutines.test)
+}
+
+val testTmpDir = layout.buildDirectory.dir("tmp/test")
+
+tasks.withType<Test>().configureEach {
+    useJUnit()
+    // A writable java.io.tmpdir inside the build directory: the sandbox HOME is
+    // read-only and this keeps spawned fake-netdisk/gpg work inside the project.
+    systemProperty("java.io.tmpdir", testTmpDir.get().asFile.absolutePath)
+    doFirst { testTmpDir.get().asFile.mkdirs() }
+    // The tests spawn `go build` for cmd/fakepand (the Go fake netdisk). The
+    // Gradle daemon may have been started without the toolchain environment this
+    // repository needs, so forward the variables the build itself was launched
+    // with to the test JVM, where the Go toolchain reads them.
+    listOf("GOMODCACHE", "GOPATH", "GOCACHE", "GOFLAGS", "GOTOOLCHAIN", "TMPDIR", "TEMP", "TMP")
+        .forEach { name ->
+            providers.environmentVariable(name).orNull?.let { environment(name, it) }
+        }
+    // The spawned fake netdisk and gpg need a writable temp dir; Java's own
+    // java.io.tmpdir default is used unless TMPDIR above says otherwise.
+    systemProperty("baidunetgo.repoRoot", rootProject.projectDir.parentFile.absolutePath)
+}
