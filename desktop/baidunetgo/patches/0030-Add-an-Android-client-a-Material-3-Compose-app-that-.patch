@@ -0,0 +1,178 @@
+package com.pengstem.baidunetgo.service
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Build
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import androidx.core.content.ContextCompat
+import com.pengstem.baidunetgo.MainActivity
+import com.pengstem.baidunetgo.R
+import com.pengstem.baidunetgo.data.RunKind
+import com.pengstem.baidunetgo.data.RunSnapshot
+import com.pengstem.baidunetgo.data.TransferRecord
+
+/**
+ * Progress and result notifications for the foreground backup service.
+ *
+ * The progress notification carries a 取消备份 action backed by a service
+ * intent, so a long upload can be stopped from the notification shade.
+ */
+object BackupNotifications {
+
+    const val CHANNEL_ID = "backup-progress"
+    const val PROGRESS_NOTIFICATION_ID = 1001
+    const val RESULT_NOTIFICATION_ID = 1002
+
+    fun ensureChannel(context: Context) {
+        val manager = context.getSystemService(NotificationManager::class.java) ?: return
+        val channel = NotificationChannel(
+            CHANNEL_ID,
+            context.getString(R.string.notify_channel_name),
+            NotificationManager.IMPORTANCE_LOW,
+        ).apply {
+            description = context.getString(R.string.notify_channel_desc)
+            setShowBadge(false)
+            enableVibration(false)
+        }
+        manager.createNotificationChannel(channel)
+    }
+
+    fun progress(context: Context, snapshot: RunSnapshot): Notification {
+        val title = context.getString(titleFor(snapshot.kind))
+        val percent = (snapshot.percent * 100).toInt().coerceIn(0, 100)
+        val text = context.getString(
+            R.string.notify_running,
+            percent,
+            snapshot.file.substringAfterLast('/').take(48),
+        )
+        val summary = context.getString(
+            R.string.transfer_summary,
+            snapshot.uploaded,
+            snapshot.skipped,
+            snapshot.failed,
+        )
+        return base(context, title, snapshot.label)
+            .setContentText(text)
+            .setSubText(summary)
+            .setProgress(100, percent, false)
+            .setOnlyAlertOnce(true)
+            .setOngoing(true)
+            .setSilent(true)
+            .addAction(
+                R.drawable.ic_stat_backup,
+                context.getString(R.string.notify_cancel),
+                cancelIntent(context),
+            )
+            .setContentIntent(openAppIntent(context))
+            .build()
+    }
+
+    fun result(context: Context, kind: RunKind, record: TransferRecord): Notification {
+        val title = context.getString(titleFor(kind))
+        val text = if (record.cancelled) {
+            context.getString(R.string.notify_cancelled)
+        } else if (record.failed > 0 || record.errors.isNotEmpty()) {
+            context.getString(
+                R.string.notify_failed,
+                record.errors.firstOrNull() ?: context.getString(R.string.transfer_failed),
+            )
+        } else {
+            context.getString(
+                R.string.notify_done,
+                record.uploaded,
+                record.skipped,
+                record.failed,
+            )
+        }
+        return base(context, title, record.label)
+            .setContentText(text)
+            .setStyle(NotificationCompat.BigTextStyle().bigText(text))
+            .setOngoing(false)
+            .setAutoCancel(true)
+            .setContentIntent(openAppIntent(context))
+            .build()
+    }
+
+    fun failed(context: Context, kind: RunKind, message: String): Notification {
+        val title = context.getString(titleFor(kind))
+        val text = context.getString(R.string.notify_failed, message)
+        return base(context, title, null)
+            .setContentText(text)
+            .setStyle(NotificationCompat.BigTextStyle().bigText(text))
+            .setOngoing(false)
+            .setAutoCancel(true)
+            .setContentIntent(openAppIntent(context))
+            .build()
+    }
+
+    /** Updates the ongoing progress notification (no-op without permission). */
+    @SuppressLint("MissingPermission")
+    fun notifyProgress(context: Context, snapshot: RunSnapshot) {
+        if (!canPostNotifications(context)) return
+        runCatching {
+            NotificationManagerCompat.from(context)
+                .notify(PROGRESS_NOTIFICATION_ID, progress(context, snapshot))
+        }
+    }
+
+    /** Posts the final result notification (no-op without permission). */
+    @SuppressLint("MissingPermission")
+    fun notifyResult(context: Context, notification: Notification) {
+        if (!canPostNotifications(context)) return
+        runCatching {
+            NotificationManagerCompat.from(context).notify(RESULT_NOTIFICATION_ID, notification)
+        }
+    }
+
+    /**
+     * Foreground-service notifications are allowed without the runtime grant
+     * (the system simply hides them), but regular posts are dropped, so check.
+     */
+    private fun canPostNotifications(context: Context): Boolean =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) ==
+                PackageManager.PERMISSION_GRANTED
+        } else {
+            NotificationManagerCompat.from(context).areNotificationsEnabled()
+        }
+
+    fun cancelIntent(context: Context): PendingIntent = PendingIntent.getService(
+        context,
+        REQUEST_CANCEL,
+        Intent(context, BackupService::class.java).setAction(BackupService.ACTION_CANCEL),
+        PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+    )
+
+    private fun openAppIntent(context: Context): PendingIntent = PendingIntent.getActivity(
+        context,
+        REQUEST_OPEN,
+        Intent(context, MainActivity::class.java).apply {
+            flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
+        },
+        PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+    )
+
+    private fun base(context: Context, title: String, subTitle: String?): NotificationCompat.Builder =
+        NotificationCompat.Builder(context, CHANNEL_ID)
+            .setSmallIcon(R.drawable.ic_stat_backup)
+            .setContentTitle(if (subTitle.isNullOrBlank()) title else "$title · $subTitle")
+            .setCategory(NotificationCompat.CATEGORY_PROGRESS)
+            .setPriority(NotificationCompat.PRIORITY_LOW)
+            .setForegroundServiceBehavior(NotificationCompat.FOREGROUND_SERVICE_IMMEDIATE)
+
+    private fun titleFor(kind: RunKind): Int = when (kind) {
+        RunKind.Folder -> R.string.notify_title_folder
+        RunKind.Album -> R.string.notify_title_album
+    }
+
+    private const val REQUEST_CANCEL = 10
+    private const val REQUEST_OPEN = 11
+}
