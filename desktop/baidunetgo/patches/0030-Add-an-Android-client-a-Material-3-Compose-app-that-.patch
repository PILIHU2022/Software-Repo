+
+/**
+ * 传输: running uploads (live from [com.pengstem.baidunetgo.data.BackupBus]) and
+ * the recent finished runs persisted in the ViewModel/store.
+ */
+@Composable
+fun TransferScreen(
+    state: AppUiState,
+    vm: AppViewModel,
+    modifier: Modifier = Modifier,
+) {
+    val running = buildList {
+        state.folderRun?.let { add(it to R.string.transfer_source_folder) }
+        state.albumRun?.let { add(it to R.string.transfer_source_album) }
+    }
+
+    LazyColumn(
+        modifier = modifier.fillMaxSize(),
+        contentPadding = PaddingValues(16.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        item(key = "running-header") {
+            Text(
+                text = stringResource(R.string.transfer_running),
+                style = MaterialTheme.typography.titleSmall,
+                color = MaterialTheme.colorScheme.primary,
+            )
+        }
+
+        if (running.isEmpty()) {
+            item(key = "running-empty") {
+                Card(
+                    colors = CardDefaults.cardColors(
+                        containerColor = MaterialTheme.colorScheme.surfaceContainerLow,
+                    ),
+                ) {
+                    EmptyState(
+                        icon = Icons.Filled.SwapVert,
+                        title = stringResource(R.string.transfer_empty),
+                        hint = stringResource(R.string.transfer_empty_hint),
+                    )
+                }
+            }
+        } else {
+            items(items = running, key = { it.first.kind.name }) { (snapshot, sourceRes) ->
+                RunningCard(snapshot = snapshot, sourceRes = sourceRes, vm = vm)
+            }
+        }
+
+        item(key = "history-header") {
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                Text(
+                    text = stringResource(R.string.transfer_history),
+                    style = MaterialTheme.typography.titleSmall,
+                    color = MaterialTheme.colorScheme.primary,
+                    modifier = Modifier.weight(1f),
+                )
+                if (state.history.isNotEmpty()) {
+                    TextButton(onClick = vm::clearHistory) {
+                        Text(stringResource(R.string.transfer_clear_done))
+                    }
+                }
+            }
+        }
+
+        if (state.history.isEmpty()) {
+            item(key = "history-empty") {
+                Card(
+                    colors = CardDefaults.cardColors(
+                        containerColor = MaterialTheme.colorScheme.surfaceContainerLow,
+                    ),
+                ) {
+                    EmptyState(
+                        icon = Icons.Filled.CheckCircle,
+                        title = stringResource(R.string.transfer_history),
+                        hint = stringResource(R.string.transfer_empty_hint),
+                    )
+                }
+            }
+        } else {
+            items(items = state.history, key = { it.id }) { record ->
+                HistoryCard(record = record)
+            }
+        }
+    }
+}
+
+@Composable
+private fun RunningCard(snapshot: RunSnapshot, sourceRes: Int, vm: AppViewModel) {
+    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            AssistChip(
+                onClick = {},
+                label = { Text(stringResource(sourceRes)) },
+            )
+        }
+        RunProgressCard(
+            snapshot = snapshot,
+            kindLabel = stringResource(
+                if (snapshot.kind == RunKind.Folder) R.string.backup_running
+                else R.string.album_running,
+            ),
+            onCancel = { vm.cancelRun(snapshot.kind) },
+        )
+    }
+}
+
+@Composable
+private fun HistoryCard(record: TransferRecord) {
+    val success = record.success
+    val cancelled = record.cancelled
+    val icon = when {
+        cancelled -> Icons.Filled.ErrorOutline
+        success -> Icons.Filled.CheckCircle
+        else -> Icons.Filled.ErrorOutline
+    }
+    val tint = when {
+        cancelled -> MaterialTheme.colorScheme.onSurfaceVariant
+        success -> MaterialTheme.colorScheme.primary
+        else -> MaterialTheme.colorScheme.error
+    }
+    Card(
+        colors = CardDefaults.cardColors(
+            containerColor = MaterialTheme.colorScheme.surfaceContainerLow,
+        ),
+    ) {
+        ListItem(
+            colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+            leadingContent = {
+                Icon(imageVector = icon, contentDescription = null, tint = tint)
+            },
+            headlineContent = {
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    Text(
+                        text = record.label,
+                        modifier = Modifier.weight(1f, fill = false),
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                    )
+                    Spacer(Modifier.width(8.dp))
+                    AssistChip(
+                        onClick = {},
+                        label = {
+                            Text(
+                                stringResource(
+                                    if (record.kind == "folder") R.string.transfer_source_folder
+                                    else R.string.transfer_source_album,
+                                ),
+                            )
+                        },
+                    )
+                }
+            },
+            supportingContent = {
+                Column {
+                    Text(
+                        text = when {
+                            cancelled -> stringResource(R.string.transfer_cancelled)
+                            !success && record.errors.isNotEmpty() -> record.errors.first()
+                            success -> stringResource(R.string.transfer_done)
+                            else -> stringResource(R.string.transfer_failed)
+                        },
+                        style = MaterialTheme.typography.bodySmall,
+                        color = if (!success && !cancelled) {
+                            MaterialTheme.colorScheme.error
+                        } else {
+                            MaterialTheme.colorScheme.onSurfaceVariant
+                        },
+                        maxLines = 2,
+                        overflow = TextOverflow.Ellipsis,
+                    )
+                    Text(
+                        text = stringResource(
+                            R.string.transfer_summary,
+                            record.uploaded,
+                            record.skipped,
+                            record.failed,
+                        ) + " · " + AppFormat.bytes(record.bytes),
+                        style = MaterialTheme.typography.labelSmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                }
+            },
+            trailingContent = {
+                Text(
+                    text = AppFormat.time(record.finishedAt),
+                    style = MaterialTheme.typography.labelSmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            },
+        )
+    }
+}
