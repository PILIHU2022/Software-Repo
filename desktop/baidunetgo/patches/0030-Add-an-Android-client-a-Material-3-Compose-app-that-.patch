+package com.pengstem.baidunetgo.core.backup
+
+import kotlinx.serialization.Serializable
+import java.io.File
+import java.io.IOException
+import java.io.InputStream
+
+/** A backup failure with a user-facing (Chinese) message. */
+open class BackupException(message: String, cause: Throwable? = null) : IOException(message, cause)
+
+/**
+ * Names never backed up. `.git`, `node_modules` and `.cache` are build/tool
+ * clutter, the rest are system files; the marker `~$` stands for the temporary
+ * files Office leaves beside open documents (matched as a prefix, see
+ * [isExcludedName]).
+ */
+val defaultExcludes: Set<String> = setOf(
+    ".git",
+    "node_modules",
+    ".cache",
+    ".Trash",
+    ".DS_Store",
+    "Thumbs.db",
+    "~$",
+)
+
+/** Whether [name] (one path segment) is excluded by [excludes]. */
+internal fun isExcludedName(name: String, excludes: Set<String>): Boolean {
+    if (name in excludes) return true
+    return name.startsWith("~$") && "~$" in excludes
+}
+
+/**
+ * One file a backup set contains.
+ *
+ * [relativePath] is `'/'`-separated with no leading slash, e.g. `2024/a.jpg`;
+ * [lastModified] is in milliseconds (what [File.lastModified] reports), which is
+ * what the state file remembers. [open] hands out a fresh stream each call and the
+ * caller closes it.
+ */
+data class SourceFile(
+    val relativePath: String,
+    val size: Long,
+    val lastModified: Long,
+    val open: () -> InputStream,
+)
+
+/** A set of files to mirror into one netdisk folder. */
+interface BackupSource {
+    val label: String
+    fun files(): List<SourceFile>
+}
+
+/**
+ * A backup set that is a plain local folder (the app's own private folders).
+ *
+ * Android SAF trees have no `File`, so `:app` implements [BackupSource] itself
+ * over `DocumentFile`; the engine only needs the relative paths and streams.
+ */
+class FolderSource(
+    val root: File,
+    val exclude: Set<String> = defaultExcludes,
+    override val label: String = root.name,
+) : BackupSource {
+
+    override fun files(): List<SourceFile> {
+        val out = ArrayList<SourceFile>()
+        if (!root.isDirectory) return out
+        collect(root, out)
+        out.sortBy { it.relativePath }
+        return out
+    }
+
+    private fun collect(dir: File, out: MutableList<SourceFile>) {
+        val children = try {
+            dir.listFiles()
+        } catch (e: SecurityException) {
+            null
+        } ?: return
+        for (child in children.sortedBy { it.name }) {
+            if (isExcludedName(child.name, exclude)) continue
+            if (child.isDirectory) {
+                collect(child, out)
+                continue
+            }
+            if (!child.isFile) continue
+            val path = child.relativeTo(root).invariantSeparatorsPath
+            out += SourceFile(
+                relativePath = path,
+                size = child.length(),
+                lastModified = child.lastModified(),
+                open = { child.inputStream() },
+            )
+        }
+    }
+}
+
+/**
+ * Where a backup set goes: [dest] is the netdisk folder (e.g. `/备份`), [remoteName]
+ * a sub-folder below it (e.g. `相册/相机`), so files land at
+ * `<dest>/<remoteName>/<relativePath>`. [parallel] uploads at once, clamped 1..4.
+ */
+data class BackupConfig(
+    val dest: String,
+    val encrypt: Boolean = false,
+    val parallel: Int = 2,
+    val remoteName: String,
+)
+
+/** How far the current file goes, plus cumulative counters for the whole run. */
+data class BackupProgress(
+    val label: String,
+    val file: String,
+    val remote: String,
+    val done: Long,
+    val total: Long,
+    val uploaded: Int,
+    val skipped: Int,
+    val failed: Int,
+)
+
+/** What a run did. [bytes] counts the bytes of the files that were uploaded. */
+data class BackupResult(
+    val uploaded: Int,
+    val skipped: Int,
+    val failed: Int,
+    val bytes: Long,
+    val errors: List<String>,
+)
+
+/**
+ * What the state file remembers of one uploaded file: its size and last-modified
+ * time, so an unchanged file is skipped next run, and the remote path it went to.
+ */
+@Serializable
+data class StateEntry(
+    val size: Long,
+    val lastModified: Long,
+    val remote: String = "",
+)
+
+/**
+ * The incremental state: entries keyed by `"<label>|<relativePath>"`.
+ *
+ * The version is written into the file so a future layout change can be detected;
+ * unknown fields are ignored when reading, and anything unreadable yields an
+ * empty state rather than an error.
+ */
+@Serializable
+data class BackupState(
+    val version: Int = Version,
+    val entries: Map<String, StateEntry> = emptyMap(),
+) {
+    companion object {
+        const val Version: Int = 1
+    }
+}
