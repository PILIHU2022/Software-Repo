+package com.pengstem.baidunetgo.core.backup
+
+import com.pengstem.baidunetgo.core.crypto.Pgp
+import com.pengstem.baidunetgo.core.net.BaiduException
+import com.pengstem.baidunetgo.core.net.Netdisk
+import com.pengstem.baidunetgo.core.net.NotLoggedInException
+import com.pengstem.baidunetgo.core.net.ThrottledProgress
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.joinAll
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.withContext
+import java.io.IOException
+import java.nio.file.Files
+import java.util.Collections
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * Mirrors a [BackupSource] into one netdisk folder, incrementally.
+ *
+ * - A file whose `"<label>|<relativePath>"` is in the state with the same size and
+ *   last-modified time is skipped; everything else is uploaded.
+ * - Remote folders are created only when a listing shows they are missing, and a
+ *   folder created once in a run is remembered for the rest of it.
+ * - [BackupConfig.parallel] files upload at once (`1..4`), each through
+ *   [Netdisk.upload]. Nothing is ever deleted, on either side.
+ * - With [BackupConfig.encrypt] each file is encrypted with [Pgp] into a unique
+ *   temporary file under `java.io.tmpdir` and uploaded as `<remote>.gpg`; the
+ *   temporary file is deleted in a `finally`, so at most `parallel` exist.
+ * - A failed file is recorded in [BackupResult.errors] and the run continues.
+ * - Cancelling the calling coroutine stops the run with a
+ *   [CancellationException], after the state of the files that finished has been
+ *   saved.
+ */
+object Backup {
+
+    /** Uploads at most this many parts of one file at once (the netdisk's default). */
+    private const val UploadConnections = 2
+
+    /** Runs a backup. See the class documentation for the exact rules. */
+    suspend fun run(
+        api: Netdisk,
+        source: BackupSource,
+        config: BackupConfig,
+        state: BackupStateStore,
+        passphrase: CharArray?,
+        onProgress: (BackupProgress) -> Unit = {},
+    ): BackupResult {
+        if (config.encrypt && (passphrase == null || passphrase.isEmpty())) {
+            throw BackupException("加密备份口令不能为空")
+        }
+
+        val parallel = config.parallel.coerceIn(1, MaxParallel)
+        val remoteRoot = joinPath(config.dest, config.remoteName)
+        val label = source.label
+        val previousState = state.load()
+        val entries = ConcurrentHashMap<String, StateEntry>(previousState.entries)
+        val uploaded = AtomicInteger()
+        val skipped = AtomicInteger()
+        val failed = AtomicInteger()
+        val bytes = AtomicLong()
+        val errors = Collections.synchronizedList(ArrayList<String>())
+        val directories = DirectoryCreator(api)
+        val files = try {
+            source.files()
+        } catch (e: Exception) {
+            throw BackupException("读取待备份文件失败：${e.message ?: e.javaClass.simpleName}", e)
+        }
+
+        fun emit(file: String, remote: String, done: Long, total: Long) {
+            onProgress(
+                BackupProgress(
+                    label = label,
+                    file = file,
+                    remote = remote,
+                    done = done,
+                    total = total,
+                    uploaded = uploaded.get(),
+                    skipped = skipped.get(),
+                    failed = failed.get(),
+                )
+            )
+        }
+
+        return coroutineScope {
+            val permits = Semaphore(parallel)
+            val jobs = ArrayList<Job>(files.size)
+            for (sourceFile in files) {
+                jobs += launch(Dispatchers.IO) {
+                    permits.withPermit {
+                        currentCoroutineContext().ensureActive()
+                        processFile(
+                            api = api,
+                            sourceFile = sourceFile,
+                            label = label,
+                            remoteRoot = remoteRoot,
+                            config = config,
+                            passphrase = passphrase,
+                            directories = directories,
+                            entries = entries,
+                            uploaded = uploaded,
+                            skipped = skipped,
+                            failed = failed,
+                            bytes = bytes,
+                            errors = errors,
+                            emit = { file, remote, done, total -> emit(file, remote, done, total) },
+                        )
+                    }
+                }
+            }
+            try {
+                jobs.joinAll()
+            } finally {
+                // Cancellation must still leave the finished files recorded, so the
+                // next run does not upload them again.
+                withContext(NonCancellable + Dispatchers.IO) {
+                    state.save(BackupState(version = previousState.version, entries = entries.toMap()))
+                }
+            }
+            BackupResult(
+                uploaded = uploaded.get(),
+                skipped = skipped.get(),
+                failed = failed.get(),
+                bytes = bytes.get(),
+                errors = errors.toList(),
+            )
+        }
+    }
+
+    private suspend fun processFile(
+        api: Netdisk,
+        sourceFile: SourceFile,
+        label: String,
+        remoteRoot: String,
+        config: BackupConfig,
+        passphrase: CharArray?,
+        directories: DirectoryCreator,
+        entries: MutableMap<String, StateEntry>,
+        uploaded: AtomicInteger,
+        skipped: AtomicInteger,
+        failed: AtomicInteger,
+        bytes: AtomicLong,
+        errors: MutableList<String>,
+        emit: (file: String, remote: String, done: Long, total: Long) -> Unit,
+    ) {
+        val key = "$label|${sourceFile.relativePath}"
+        val suffix = if (config.encrypt) Pgp.Suffix else ""
+        val remote = joinPath(remoteRoot, sourceFile.relativePath) + suffix
+        val previous = entries[key]
+        if (previous != null &&
+            previous.size == sourceFile.size &&
+            previous.lastModified == sourceFile.lastModified
+        ) {
+            skipped.incrementAndGet()
+            emit(sourceFile.relativePath, remote, sourceFile.size, sourceFile.size)
+            return
+        }
+
+        val throttle = ThrottledProgress { done, total ->
+            emit(sourceFile.relativePath, remote, done, total)
+        }
+        try {
+            val remoteDir = remoteDirOf(remote)
+            directories.ensure(remoteDir)
+
+            if (config.encrypt) {
+                val temporary = Files.createTempFile("baidunetgo-", Pgp.Suffix).toFile()
+                try {
+                    sourceFile.open().use { input ->
+                        temporary.outputStream().buffered().use { output ->
+                            Pgp.encrypt(output, input, passphrase!!)
+                        }
+                    }
+                    api.upload(
+                        local = temporary,
+                        remote = remote,
+                        connections = UploadConnections,
+                        onProgress = { done, total -> throttle.report(done, total) },
+                    )
+                } finally {
+                    temporary.delete()
+                }
+            } else {
+                api.upload(
+                    open = sourceFile.open,
+                    size = sourceFile.size,
+                    remote = remote,
+                    connections = UploadConnections,
+                    onProgress = { done, total -> throttle.report(done, total) },
+                )
+            }
+
+            entries[key] = StateEntry(
+                size = sourceFile.size,
+                lastModified = sourceFile.lastModified,
+                remote = remote,
+            )
+            uploaded.incrementAndGet()
+            bytes.addAndGet(sourceFile.size)
+            throttle.finish(sourceFile.size, sourceFile.size)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: IOException) {
+            failed.incrementAndGet()
+            errors += "${sourceFile.relativePath}：${e.message ?: e.javaClass.simpleName}"
+            emit(sourceFile.relativePath, remote, 0, sourceFile.size)
+        } catch (e: Exception) {
+            failed.incrementAndGet()
+            errors += "${sourceFile.relativePath}：${e.message ?: e.javaClass.simpleName}"
+            emit(sourceFile.relativePath, remote, 0, sourceFile.size)
+        }
+    }
+
+    private const val MaxParallel = 4
+
+    /** `/a/b/c` for any mix of slashed and unslashed parts. */
+    internal fun joinPath(vararg parts: String): String {
+        val segments = parts.flatMap { it.split('/') }.filter { it.isNotEmpty() }
+        return "/" + segments.joinToString("/")
+    }
+
+    /** `/a/b` for `/a/b/c.txt`; `/` when the file is directly at the root. */
+    private fun remoteDirOf(remote: String): String {
+        val index = remote.lastIndexOf('/')
+        return if (index <= 0) "/" else remote.substring(0, index)
+    }
+
+    /**
+     * Creates remote folders only when a listing shows they are missing, walking
+     * from the top so every level exists, and remembers what this run created.
+     */
+    private class DirectoryCreator(private val api: Netdisk) {
+
+        private val mutex = Mutex()
+        private val known = HashSet<String>()
+
+        suspend fun ensure(dir: String) {
+            for (path in ancestors(dir)) {
+                createIfMissing(path)
+            }
+        }
+
+        private suspend fun createIfMissing(dir: String) = mutex.withLock {
+            if (dir in known) return@withLock
+            if (!exists(dir)) api.mkdir(dir)
+            known += dir
+        }
+
+        private suspend fun exists(dir: String): Boolean = try {
+            api.list(dir, 1, 1)
+            true
+        } catch (e: NotLoggedInException) {
+            throw e
+        } catch (e: BaiduException) {
+            when (e.errno) {
+                2, -9, -33, 31066 -> false // the folder does not exist
+                else -> throw e
+            }
+        }
+    }
+
+    /** `/a`, `/a/b`, `/a/b/c` for `/a/b/c`. */
+    internal fun ancestors(dir: String): List<String> {
+        val trimmed = dir.trim('/')
+        if (trimmed.isEmpty()) return emptyList()
+        val out = ArrayList<String>()
+        var current = ""
+        for (segment in trimmed.split('/')) {
+            if (segment.isEmpty()) continue
+            current += "/$segment"
+            out += current
+        }
+        return out
+    }
+}
