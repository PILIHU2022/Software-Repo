+package com.pengstem.baidunetgo.data
+
+import android.content.Context
+import java.io.File
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.add
+import kotlinx.serialization.json.addJsonObject
+import kotlinx.serialization.json.buildJsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonArray
+
+/** One finished backup run, kept for the 传输 screen's history. */
+data class TransferRecord(
+    val id: String,
+    /** "folder" or "album". */
+    val kind: String,
+    val label: String,
+    val finishedAt: Long,
+    val uploaded: Int,
+    val skipped: Int,
+    val failed: Int,
+    val bytes: Long,
+    val cancelled: Boolean = false,
+    val errors: List<String> = emptyList(),
+) {
+    val success: Boolean get() = !cancelled && failed == 0 && errors.isEmpty()
+}
+
+/**
+ * Last [MAX] finished runs, persisted as plain JSON in `filesDir` (not secret:
+ * file names and counts only). Written atomically.
+ */
+class TransferHistoryStore(context: Context) {
+
+    private val file = JsonFile(File(context.filesDir, FILE))
+
+    fun load(): List<TransferRecord> {
+        val text = file.read() ?: return emptyList()
+        return runCatching {
+            Json.parseToJsonElement(text).jsonArray.mapNotNull { element -> decode(element.toString()) }
+        }.getOrDefault(emptyList())
+    }
+
+    fun add(record: TransferRecord) {
+        val updated = (listOf(record) + load()).take(MAX)
+        file.write(buildJsonArray { updated.forEach { add(encode(it)) } }.toString())
+    }
+
+    fun clear() = file.delete()
+
+    private fun decode(text: String): TransferRecord? = runCatching {
+        val obj = Json.parseToJsonElement(text).jsonObject
+        fun str(key: String) = obj[key]?.jsonPrimitive?.content ?: ""
+        fun num(key: String) = obj[key]?.jsonPrimitive?.content?.toLongOrNull() ?: 0L
+        TransferRecord(
+            id = str("id"),
+            kind = str("kind"),
+            label = str("label"),
+            finishedAt = num("finishedAt"),
+            uploaded = num("uploaded").toInt(),
+            skipped = num("skipped").toInt(),
+            failed = num("failed").toInt(),
+            bytes = num("bytes"),
+            cancelled = str("cancelled").toBoolean(),
+            errors = obj["errors"]?.jsonArray?.mapNotNull { it.jsonPrimitive.content }?.take(20).orEmpty(),
+        )
+    }.getOrNull()
+
+    private fun encode(record: TransferRecord) = buildJsonObject {
+        put("id", record.id)
+        put("kind", record.kind)
+        put("label", record.label)
+        put("finishedAt", record.finishedAt)
+        put("uploaded", record.uploaded)
+        put("skipped", record.skipped)
+        put("failed", record.failed)
+        put("bytes", record.bytes)
+        put("cancelled", record.cancelled)
+        putJsonArray("errors") { record.errors.take(20).forEach { add(it) } }
+    }
+
+    companion object {
+        const val FILE = "transfer-history.json"
+        const val MAX = 30
+    }
+}
