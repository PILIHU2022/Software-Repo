+package com.pengstem.baidunetgo.data
+
+import com.pengstem.baidunetgo.core.net.Credentials
+import com.pengstem.baidunetgo.ui.AppFormat
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * JVM tests for the pure logic in `:app`: the encrypted JSON documents and the
+ * netdisk path rules. They need no emulator (no Android APIs are called).
+ */
+class SecureJsonTest {
+
+    @Test
+    fun settingsRoundTrip() {
+        val settings = AppSettings(
+            dest = "/备份/手机",
+            autoFolder = true,
+            autoAlbum = false,
+            intervalMinutes = 60,
+            folderEncrypt = true,
+            albumEncrypt = true,
+            folders = listOf(
+                FolderEntry(uri = "content://tree/a", name = "相机"),
+                FolderEntry(uri = "content://tree/b", name = "文档"),
+            ),
+            wifiOnly = false,
+            concurrency = 4,
+            theme = ThemeMode.Dark,
+            deselectedAlbums = setOf(7L, 42L),
+            notificationAsked = true,
+        )
+        val encoded = SecureJson.encodeSettings(settings)
+        val decoded = SecureJson.decodeSettings(encoded)
+        assertEquals(settings, decoded)
+    }
+
+    @Test
+    fun settingsDefaultWhenMissingOrCorrupt() {
+        assertEquals(AppSettings(), SecureJson.decodeSettings(null))
+        assertEquals(AppSettings(), SecureJson.decodeSettings(""))
+        assertEquals(AppSettings(), SecureJson.decodeSettings("{not json"))
+        assertEquals(AppSettings(), SecureJson.decodeSettings("[]"))
+    }
+
+    @Test
+    fun settingsIgnoresUnknownFieldsAndClampsConcurrency() {
+        val decoded = SecureJson.decodeSettings(
+            """{"dest":"/d","concurrency":9,"theme":"Unknown","unknown":1}""",
+        )
+        assertEquals("/d", decoded.dest)
+        assertEquals(4, decoded.concurrency)
+        assertEquals(ThemeMode.System, decoded.theme)
+    }
+
+    @Test
+    fun credentialsRoundTrip() {
+        val credentials = Credentials(
+            cookies = "BDUSS=x; STOKEN=y",
+            bduss = "x",
+            stoken = "y",
+            uid = 1234L,
+            name = "昵称",
+        )
+        assertEquals(credentials, SecureJson.decodeCredentials(SecureJson.encodeCredentials(credentials)))
+    }
+
+    @Test
+    fun credentialsWithoutSecretsAreRejected() {
+        assertNull(SecureJson.decodeCredentials(null))
+        assertNull(SecureJson.decodeCredentials("""{"cookies":"a"}"""))
+        assertNull(SecureJson.decodeCredentials("""{"bduss":"","stoken":"y"}"""))
+    }
+
+    @Test
+    fun passphraseRoundTrip() {
+        val passphrase = "correct horse battery".toCharArray()
+        assertArrayEquals(
+            passphrase,
+            SecureJson.decodePassphrase(SecureJson.encodePassphrase(passphrase)),
+        )
+        assertNull(SecureJson.decodePassphrase(null))
+        assertNull(SecureJson.decodePassphrase("""{"passphrase":""}"""))
+    }
+
+    @Test
+    fun netdiskDestIsNormalisedAndValidated() {
+        assertEquals("/备份", AppFormat.normaliseDest(""))
+        assertEquals("/备份", AppFormat.normaliseDest("备份"))
+        assertEquals("/备份/相册", AppFormat.normaliseDest("/备份/相册/"))
+        assertEquals("/备份", AppFormat.normaliseDest("//备份//"))
+        assertTrue(AppFormat.isValidDest("/备份"))
+        assertTrue(AppFormat.isValidDest("备份"))
+        assertFalse(AppFormat.isValidDest(""))
+        assertFalse(AppFormat.isValidDest("/"))
+    }
+
+    @Test
+    fun byteFormattingDelegatesToCore() {
+        assertEquals("0 B", AppFormat.bytes(0))
+        assertEquals("1.5 MB", AppFormat.bytes(1_572_864))
+        assertEquals("—", AppFormat.speed(0))
+    }
+}
