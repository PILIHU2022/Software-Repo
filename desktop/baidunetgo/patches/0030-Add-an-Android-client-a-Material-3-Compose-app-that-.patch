+package com.pengstem.baidunetgo.core.crypto
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Assume.assumeTrue
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.IOException
+import java.util.Random
+import java.util.concurrent.TimeUnit
+
+/**
+ * Interoperability of [Pgp] with the real `gpg` 2.4, in both directions, plus the
+ * failure behaviour: a wrong passphrase throws and never leaves a partial
+ * plaintext file behind.
+ *
+ * `gpg` is required; the class skips itself cleanly when it is absent. Every test
+ * gets a throw-away `GNUPGHOME`, so nothing touches the machine's keyrings.
+ */
+class PgpTest {
+
+    @get:Rule
+    val tmp = TemporaryFolder()
+
+    private lateinit var gnupgHome: File
+    private val passphrase = "correct horse battery staple"
+
+    @Before
+    fun setUp() {
+        assumeTrue("gpg is required for the OpenPGP interop tests", gpgAvailable())
+        gnupgHome = tmp.newFolder("gnupg")
+        gnupgHome.setReadable(true, true)
+        gnupgHome.setWritable(true, true)
+        gnupgHome.setExecutable(true, true)
+    }
+
+    @Test
+    fun kotlinEncryptsAndGpgDecrypts() {
+        for (size in listOf(0, 4 shl 20)) {
+            val name = "plain-$size.bin"
+            val src = tmp.newFile(name).apply { writeBytes(randomBytes(size)) }
+            val encrypted = tmp.newFile("$name.gpg")
+            val decrypted = tmp.newFile("$name.out")
+            decrypted.delete()
+
+            Pgp.encryptFile(encrypted, src, passphrase.toCharArray())
+
+            val result = gpg(
+                "--batch", "--yes", "--no-tty",
+                "--pinentry-mode", "loopback",
+                "--passphrase", passphrase,
+                "--output", decrypted.absolutePath,
+                "--decrypt", encrypted.absolutePath,
+            )
+            assertEquals("gpg could not decrypt our output ($size bytes): ${result.output}", 0, result.exitCode)
+            assertArrayEquals("round trip through gpg differs ($size bytes)", src.readBytes(), decrypted.readBytes())
+        }
+    }
+
+    @Test
+    fun gpgEncryptsAndKotlinDecrypts() {
+        for (size in listOf(0, 4 shl 20)) {
+            val name = "gpg-$size.bin"
+            val src = tmp.newFile(name).apply { writeBytes(randomBytes(size)) }
+            val encrypted = tmp.newFile("$name.gpg")
+            encrypted.delete()
+            val decrypted = tmp.newFile("$name.out")
+            decrypted.delete()
+
+            val result = gpg(
+                "--batch", "--yes", "--no-tty",
+                "--pinentry-mode", "loopback",
+                "--passphrase", passphrase,
+                "--symmetric",
+                "--cipher-algo", "AES256",
+                "--s2k-digest-algo", "SHA256",
+                "--s2k-count", "4194304",
+                "--output", encrypted.absolutePath,
+                src.absolutePath,
+            )
+            assertEquals("gpg could not encrypt: ${result.output}", 0, result.exitCode)
+
+            Pgp.decryptFile(decrypted, encrypted, passphrase.toCharArray())
+            assertArrayEquals("round trip from gpg differs ($size bytes)", src.readBytes(), decrypted.readBytes())
+        }
+    }
+
+    @Test
+    fun outputIsBinaryAes256NoCompressionWithMdc() {
+        val src = tmp.newFile("packets.bin").apply { writeBytes(randomBytes(64 shl 10)) }
+        val encrypted = tmp.newFile("packets.bin.gpg")
+
+        Pgp.encryptFile(encrypted, src, passphrase.toCharArray())
+
+        val firstByte = encrypted.readBytes()[0].toInt() and 0xFF
+        assertTrue("output must be a binary OpenPGP message", (firstByte and 0x80) != 0)
+        assertFalse("output must not be ASCII armored", firstByte == '-'.code)
+
+        val packets = gpg(
+            "--batch", "--no-tty", "--list-packets", "--pinentry-mode", "loopback",
+            "--passphrase", passphrase, encrypted.absolutePath,
+        )
+        assertEquals("gpg --list-packets failed: ${packets.output}", 0, packets.exitCode)
+        val text = packets.output
+        assertTrue("AES-256 session cipher expected:\n$text", text.contains("cipher 9"))
+        assertTrue("SHA-256 iterated+salted S2K expected:\n$text", text.contains("s2k 3, hash 8"))
+        assertTrue("S2K count must equal 4194304:\n$text", text.contains("4194304"))
+        assertTrue("SEIPD (MDC) expected:\n$text", text.contains("mdc_method: 2"))
+        assertTrue("a literal data packet is expected:\n$text", text.contains("literal data packet"))
+        assertFalse("nothing may be compressed:\n$text", text.contains("compressed data packet"))
+        assertTrue("the file-name hint must be empty:\n$text", text.contains("name=\"\""))
+    }
+
+    @Test
+    fun streamApiRoundTripsWithoutFiles() {
+        val payload = randomBytes(32 shl 10)
+        val encrypted = ByteArrayOutputStream()
+        Pgp.encrypt(encrypted, payload.inputStream(), passphrase.toCharArray())
+
+        val plain = ByteArrayOutputStream()
+        Pgp.decrypt(plain, encrypted.toByteArray().inputStream(), passphrase.toCharArray())
+
+        assertArrayEquals(payload, plain.toByteArray())
+    }
+
+    @Test
+    fun wrongPassphraseThrowsAndWritesNoPlaintextFile() {
+        val src = tmp.newFile("secret.bin").apply { writeBytes(randomBytes(128 shl 10)) }
+        val encrypted = tmp.newFile("secret.bin.gpg")
+        Pgp.encryptFile(encrypted, src, passphrase.toCharArray())
+
+        val decrypted = File(tmp.root, "secret.bin.out")
+        try {
+            Pgp.decryptFile(decrypted, encrypted, "wrong passphrase".toCharArray())
+            fail("decrypting with the wrong passphrase must throw")
+        } catch (expected: PgpException) {
+            assertTrue("the message must be user facing: ${expected.message}", expected.message!!.contains("口令"))
+        }
+        assertFalse("no partial plaintext may be left behind", decrypted.exists())
+
+        try {
+            Pgp.decrypt(ByteArrayOutputStream(), encrypted.readBytes().inputStream(), "wrong passphrase".toCharArray())
+            fail("the streaming decrypt must throw too")
+        } catch (expected: PgpException) {
+            // expected
+        }
+    }
+
+    @Test
+    fun decryptRejectsNonPgpInput() {
+        val garbage = tmp.newFile("garbage.bin").apply { writeBytes(randomBytes(4096)) }
+        try {
+            Pgp.decryptFile(File(tmp.root, "garbage.out"), garbage, passphrase.toCharArray())
+            fail("decrypting random bytes must throw")
+        } catch (expected: PgpException) {
+            assertEquals(false, File(tmp.root, "garbage.out").exists())
+        }
+    }
+
+    @Test
+    fun suffixIsGpg() {
+        assertEquals(".gpg", Pgp.Suffix)
+    }
+
+    // -----------------------------------------------------------------------
+
+    private fun randomBytes(size: Int): ByteArray {
+        val bytes = ByteArray(size)
+        Random(size.toLong() xor 0x5EED).nextBytes(bytes)
+        return bytes
+    }
+
+    private class GpgResult(val exitCode: Int, val output: String)
+
+    private fun gpg(vararg args: String): GpgResult {
+        val command = ArrayList<String>(args.size + 1)
+        command += "gpg"
+        command += args
+        val process = ProcessBuilder(command)
+            .redirectErrorStream(true)
+            .apply { environment()["GNUPGHOME"] = gnupgHome.absolutePath }
+            .start()
+        val output = process.inputStream.readBytes().toString(Charsets.UTF_8)
+        if (!process.waitFor(120, TimeUnit.SECONDS)) {
+            process.destroyForcibly()
+            fail("gpg did not finish in time: $output")
+        }
+        return GpgResult(process.exitValue(), output)
+    }
+
+    private fun gpgAvailable(): Boolean = try {
+        val process = ProcessBuilder("gpg", "--version").redirectErrorStream(true).start()
+        process.inputStream.readBytes()
+        process.waitFor(15, TimeUnit.SECONDS) && process.exitValue() == 0
+    } catch (e: IOException) {
+        false
+    }
+}
