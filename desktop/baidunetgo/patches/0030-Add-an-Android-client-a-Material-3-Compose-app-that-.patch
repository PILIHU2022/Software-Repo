+package com.pengstem.baidunetgo.core.net
+
+import java.io.File
+import java.io.IOException
+import java.io.InputStream
+
+/**
+ * Credentials of a signed-in Baidu account, as the desktop app stores them.
+ *
+ * [cookies] is the whole cookie header ("BDUSS=…; STOKEN=…; …"); every cookie in
+ * it is loaded into the client's cookie jar, so netdisk calls made later carry
+ * everything the sign-in flow collected. [bduss] and [stoken] are seeded even
+ * when [cookies] is empty, which is what a cookie-pasted login gives.
+ */
+data class Credentials(
+    val cookies: String,
+    val bduss: String,
+    val stoken: String,
+    val uid: Long? = null,
+    val name: String? = null,
+)
+
+/** What `/api/loginStatus` says about the session. */
+data class LoginStatus(
+    val loggedIn: Boolean,
+    val bdstoken: String,
+    val vipType: Int,
+)
+
+/**
+ * One entry of a netdisk listing.
+ *
+ * [md5] is the content hash **unscrambled** (BaiduPCS-Go's `DecryptMD5`), or `""`
+ * when the netdisk did not give one. [modified] is in seconds, as the netdisk
+ * reports it ("server_mtime").
+ */
+data class RemoteFile(
+    val name: String,
+    val isDir: Boolean,
+    val size: Long,
+    val fsId: Long,
+    val md5: String,
+    val modified: Long,
+)
+
+/** The signed-in account: display name, membership level and netdisk usage. */
+data class UserInfo(
+    val name: String = "",
+    val vipType: Int = 0,
+    val used: Long = 0,
+    val total: Long = 0,
+)
+
+/** Netdisk space, in bytes. */
+data class Quota(
+    val used: Long = 0,
+    val total: Long = 0,
+)
+
+/**
+ * An error the netdisk answered with, or a local failure of a netdisk call.
+ *
+ * [message] is user facing (Chinese, as everywhere in the app); [errno] is the
+ * netdisk's error number, `0` when the failure was local (network, file).
+ */
+open class BaiduException(message: String, val errno: Int = 0) : IOException(message)
+
+/** The cookies no longer sign in: the user must sign in again. */
+class NotLoggedInException(
+    message: String = "登录已失效，请重新登录",
+    errno: Int = -6,
+) : BaiduException(message, errno)
+
+/**
+ * What the backup engine needs of a netdisk, so tests (and other callers) can
+ * stand in for [BaiduApi]. The real client implements it.
+ */
+interface Netdisk {
+
+    /** Lists a directory, reading as many pages as it takes. */
+    suspend fun list(dir: String, page: Int = 1, pageSize: Int = 1000): List<RemoteFile>
+
+    /** Creates a directory; parents may already exist. */
+    suspend fun mkdir(dir: String)
+
+    /** Uploads [local] to [remote], overwriting what is there, reporting bytes sent. */
+    suspend fun upload(
+        local: File,
+        remote: String,
+        connections: Int = 2,
+        onProgress: (done: Long, total: Long) -> Unit = { _, _ -> },
+    )
+
+    /**
+     * Uploads [size] bytes read from the stream [open] returns — a *fresh* stream
+     * on every call — to [remote], without materialising the whole content.
+     *
+     * [BaiduApi] overrides this to upload parts straight from the streams it
+     * opens, which is what lets a backup of a large file (and, on Android, a SAF
+     * document that has no `File` at all) stream from source to network. The
+     * default implementation spools to a temporary file and calls
+     * [upload] with it, for implementations that only know how to upload files;
+     * the temporary file is deleted afterwards.
+     */
+    suspend fun upload(
+        open: () -> InputStream,
+        size: Long,
+        remote: String,
+        connections: Int = 2,
+        onProgress: (done: Long, total: Long) -> Unit = { _, _ -> },
+    ) {
+        val tmp = java.nio.file.Files.createTempFile("netdisk-upload-", ".bin")
+        try {
+            val copied = open().use { src ->
+                tmp.toFile().outputStream().use { dst -> src.copyTo(dst, 1 shl 16) }
+            }
+            if (copied != size) {
+                throw BaiduException("上传失败：本地文件在上传过程中被修改（大小不再一致）")
+            }
+            upload(tmp.toFile(), remote, connections, onProgress)
+        } finally {
+            java.nio.file.Files.deleteIfExists(tmp)
+        }
+    }
+}
