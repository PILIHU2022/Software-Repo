+package com.pengstem.baidunetgo.data
+
+import android.Manifest
+import android.annotation.SuppressLint
+import android.content.ContentUris
+import android.content.Context
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import android.provider.MediaStore
+import androidx.core.content.ContextCompat
+import com.pengstem.baidunetgo.R
+import com.pengstem.baidunetgo.core.backup.BackupSource
+import com.pengstem.baidunetgo.core.backup.SourceFile
+import java.io.IOException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * One album as the 相册备份 UI shows it: aggregated from a single MediaStore
+ * query per media kind (images, videos), grouped by `bucket_id`.
+ *
+ * `bucket_id` is the album identity. Rows without a bucket id (rare, e.g. files
+ * copied in by other apps) are grouped under [OTHER_BUCKET].
+ */
+data class MediaAlbum(
+    val bucketId: Long,
+    val displayName: String,
+    val imageCount: Int,
+    val videoCount: Int,
+    val sizeBytes: Long,
+    val coverUri: Uri?,
+    val lastModified: Long,
+) {
+    val itemCount: Int get() = imageCount + videoCount
+}
+
+/**
+ * Media read permissions, split by API level.
+ *
+ * Lint's InlinedApi is suppressed: the READ_MEDIA_* constants are inlined
+ * strings that are only ever requested on API 33+, so older devices never see
+ * them.
+ */
+@SuppressLint("InlinedApi")
+object MediaPermissions {
+
+    fun required(): Array<String> = when {
+        // Android 14: ask for full access, with "selected photos" as a fallback
+        // the system may grant instead.
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE -> arrayOf(
+            Manifest.permission.READ_MEDIA_IMAGES,
+            Manifest.permission.READ_MEDIA_VIDEO,
+            Manifest.permission.READ_MEDIA_VISUAL_USER_SELECTED,
+        )
+
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU -> arrayOf(
+            Manifest.permission.READ_MEDIA_IMAGES,
+            Manifest.permission.READ_MEDIA_VIDEO,
+        )
+
+        else -> arrayOf(Manifest.permission.READ_EXTERNAL_STORAGE)
+    }
+
+    /** True when at least the photo half is readable (videos may be denied). */
+    fun canScanImages(context: Context): Boolean =
+        granted(context, mediaPermission(Manifest.permission.READ_MEDIA_IMAGES)) || partialAccessGranted(context)
+
+    fun canScanVideos(context: Context): Boolean =
+        granted(context, mediaPermission(Manifest.permission.READ_MEDIA_VIDEO)) || partialAccessGranted(context)
+
+    fun granted(context: Context): Boolean =
+        canScanImages(context) || canScanVideos(context)
+
+    /**
+     * Android 14's partial access ("selected photos") grants
+     * READ_MEDIA_VISUAL_USER_SELECTED instead of the media permissions; the
+     * MediaStore query then returns those selected items only.
+     */
+    private fun mediaPermission(fullPermission: String): String =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) fullPermission
+        else Manifest.permission.READ_EXTERNAL_STORAGE
+
+    private fun granted(context: Context, permission: String): Boolean =
+        ContextCompat.checkSelfPermission(context, permission) == PackageManager.PERMISSION_GRANTED
+
+    private fun partialAccessGranted(context: Context): Boolean =
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE &&
+            ContextCompat.checkSelfPermission(
+                context,
+                Manifest.permission.READ_MEDIA_VISUAL_USER_SELECTED,
+            ) == PackageManager.PERMISSION_GRANTED
+}
+
+/**
+ * Reads the device's albums from [MediaStore] on [Dispatchers.IO].
+ *
+ * Exactly one aggregate query per media kind: both queries select only id,
+ * bucket id, bucket name, size and last-modified, then the rows are folded into
+ * per-bucket counters here (no query per album, no MediaStore grouping quirks).
+ */
+class MediaStoreScanner(private val context: Context) {
+
+    suspend fun scan(): List<MediaAlbum> = withContext(Dispatchers.IO) { scanBlocking() }
+
+    fun scanBlocking(): List<MediaAlbum> {
+        val buckets = LinkedHashMap<Long, BucketAccumulator>()
+        if (MediaPermissions.canScanImages(context)) {
+            aggregate(
+                MediaStore.Images.Media.EXTERNAL_CONTENT_URI,
+                images = true,
+                buckets = buckets,
+            )
+        }
+        if (MediaPermissions.canScanVideos(context)) {
+            aggregate(
+                MediaStore.Video.Media.EXTERNAL_CONTENT_URI,
+                images = false,
+                buckets = buckets,
+            )
+        }
+        return buckets.values.map { it.toAlbum() }.sortedByDescending { it.lastModified }
+    }
+
+    /** Files of one album, for [MediaAlbumSource]. Runs on the calling thread. */
+    fun albumFiles(album: MediaAlbum): List<SourceFile> {
+        val resolver = context.contentResolver
+        val files = ArrayList<SourceFile>(album.itemCount.coerceAtLeast(4))
+        val usedNames = HashMap<String, Int>()
+
+        fun collect(baseUri: Uri) {
+            val projection = arrayOf(
+                MediaStore.MediaColumns._ID,
+                MediaStore.MediaColumns.DISPLAY_NAME,
+                MediaStore.MediaColumns.SIZE,
+                MediaStore.MediaColumns.DATE_MODIFIED,
+            )
+            val selection = if (album.bucketId == OTHER_BUCKET) {
+                "${MediaStore.MediaColumns.BUCKET_ID} IS NULL"
+            } else {
+                "${MediaStore.MediaColumns.BUCKET_ID} = ?"
+            }
+            val selectionArgs = if (album.bucketId == OTHER_BUCKET) null else arrayOf(album.bucketId.toString())
+            val cursor = runCatching {
+                resolver.query(
+                    baseUri,
+                    projection,
+                    selection,
+                    selectionArgs,
+                    "${MediaStore.MediaColumns.DISPLAY_NAME} ASC",
+                )
+            }.getOrNull() ?: return
+
+            cursor.use { c ->
+                val idColumn = c.getColumnIndexOrThrow(MediaStore.MediaColumns._ID)
+                val nameColumn = c.getColumnIndexOrThrow(MediaStore.MediaColumns.DISPLAY_NAME)
+                val sizeColumn = c.getColumnIndexOrThrow(MediaStore.MediaColumns.SIZE)
+                val modifiedColumn = c.getColumnIndexOrThrow(MediaStore.MediaColumns.DATE_MODIFIED)
+                while (c.moveToNext() && files.size < MAX_FILES_PER_ALBUM) {
+                    val id = c.getLong(idColumn)
+                    val displayName = c.getString(nameColumn)?.takeIf { it.isNotBlank() } ?: id.toString()
+                    val uri = ContentUris.withAppendedId(baseUri, id)
+                    val uniqueName = uniqueName(displayName, id, usedNames)
+                    files += SourceFile(
+                        relativePath = uniqueName,
+                        size = c.getLong(sizeColumn),
+                        lastModified = c.getLong(modifiedColumn) * 1000L,
+                        open = {
+                            resolver.openInputStream(uri)
+                                ?: throw IOException(
+                                context.getString(R.string.error_open_media_file, uniqueName),
+                            )
+                        },
+                    )
+                }
+            }
+        }
+
+        collect(MediaStore.Images.Media.EXTERNAL_CONTENT_URI)
+        collect(MediaStore.Video.Media.EXTERNAL_CONTENT_URI)
+        return files.sortedBy { it.relativePath }
+    }
+
+    private fun aggregate(baseUri: Uri, images: Boolean, buckets: MutableMap<Long, BucketAccumulator>) {
+        val projection = arrayOf(
+            MediaStore.MediaColumns._ID,
+            MediaStore.MediaColumns.BUCKET_ID,
+            MediaStore.MediaColumns.BUCKET_DISPLAY_NAME,
+            MediaStore.MediaColumns.SIZE,
+            MediaStore.MediaColumns.DATE_MODIFIED,
+        )
+        val cursor = runCatching {
+            context.contentResolver.query(
+                baseUri,
+                projection,
+                null,
+                null,
+                "${MediaStore.MediaColumns.DATE_MODIFIED} DESC",
+            )
+        }.getOrNull() ?: return
+
+        cursor.use { c ->
+            val idColumn = c.getColumnIndexOrThrow(MediaStore.MediaColumns._ID)
+            val bucketColumn = c.getColumnIndexOrThrow(MediaStore.MediaColumns.BUCKET_ID)
+            val nameColumn = c.getColumnIndexOrThrow(MediaStore.MediaColumns.BUCKET_DISPLAY_NAME)
+            val sizeColumn = c.getColumnIndexOrThrow(MediaStore.MediaColumns.SIZE)
+            val modifiedColumn = c.getColumnIndexOrThrow(MediaStore.MediaColumns.DATE_MODIFIED)
+            var rows = 0
+            while (rows < MAX_ROWS && c.moveToNext()) {
+                rows++
+                val bucketId = if (c.isNull(bucketColumn)) OTHER_BUCKET else c.getLong(bucketColumn)
+                val displayName = c.getString(nameColumn)?.takeIf { it.isNotBlank() }
+                    ?: if (bucketId == OTHER_BUCKET) OTHER_ALBUM_NAME else UNKNOWN_ALBUM_NAME
+                val size = c.getLong(sizeColumn).coerceAtLeast(0L)
+                val modified = c.getLong(modifiedColumn) * 1000L
+                val accumulator = buckets.getOrPut(bucketId) { BucketAccumulator(bucketId, displayName) }
+                accumulator.also {
+                    if (images) it.imageCount++ else it.videoCount++
+                    it.sizeBytes += size
+                    if (modified > it.lastModified) {
+                        it.lastModified = modified
+                        it.coverUri = ContentUris.withAppendedId(baseUri, c.getLong(idColumn))
+                    }
+                }
+            }
+        }
+    }
+
+    private class BucketAccumulator(val bucketId: Long, var displayName: String) {
+        var imageCount: Int = 0
+        var videoCount: Int = 0
+        var sizeBytes: Long = 0
+        var lastModified: Long = 0
+        var coverUri: Uri? = null
+
+        fun toAlbum(): MediaAlbum = MediaAlbum(
+            bucketId = bucketId,
+            displayName = displayName,
+            imageCount = imageCount,
+            videoCount = videoCount,
+            sizeBytes = sizeBytes,
+            coverUri = coverUri,
+            lastModified = lastModified,
+        )
+    }
+
+    companion object {
+        /** Sentinel bucket id for media rows without a bucket. */
+        const val OTHER_BUCKET = Long.MIN_VALUE
+        private const val OTHER_ALBUM_NAME = "其他"
+        private const val UNKNOWN_ALBUM_NAME = "未知相册"
+
+        /** Upper bounds keep a pathological media store from exhausting memory. */
+        private const val MAX_ROWS = 60_000
+        private const val MAX_FILES_PER_ALBUM = 20_000
+
+        /** Keeps two files with the same DISPLAY_NAME in one album distinct. */
+        private fun uniqueName(displayName: String, id: Long, used: MutableMap<String, Int>): String {
+            val seen = used.getOrPut(displayName) { 0 }
+            used[displayName] = seen + 1
+            if (seen == 0) return displayName
+            val dot = displayName.lastIndexOf('.')
+            return if (dot > 0) {
+                "${displayName.substring(0, dot)} (${id})${displayName.substring(dot)}"
+            } else {
+                "$displayName ($id)"
+            }
+        }
+    }
+}
+
+/** [BackupSource] over one album's photos and videos. */
+class MediaAlbumSource(
+    private val scanner: MediaStoreScanner,
+    private val album: MediaAlbum,
+) : BackupSource {
+    override val label: String = album.displayName
+
+    override fun files(): List<SourceFile> = scanner.albumFiles(album)
+}
