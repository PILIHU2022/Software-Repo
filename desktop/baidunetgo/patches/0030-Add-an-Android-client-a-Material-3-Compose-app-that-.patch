+@Composable
+private fun QrCodeArea(state: SignInUi, onRefreshQr: () -> Unit) {
+    Box(
+        modifier = Modifier
+            .size(248.dp)
+            .clip(RoundedCornerShape(20.dp))
+            .background(Color.White),
+        contentAlignment = Alignment.Center,
+    ) {
+        when {
+            state.qr != null -> Image(
+                bitmap = state.qr,
+                contentDescription = stringResource(R.string.signin_qr_desc),
+                contentScale = ContentScale.Fit,
+                modifier = Modifier
+                    .fillMaxSize()
+                    .padding(10.dp),
+            )
+
+            state.loading -> CircularProgressIndicator()
+            else -> Icon(
+                imageVector = Icons.Filled.QrCode2,
+                contentDescription = null,
+                tint = Color(0xFF8F9099),
+                modifier = Modifier.size(64.dp),
+            )
+        }
+        AnimatedVisibility(
+            visible = state.phase == QrPhase.Expired,
+            enter = fadeIn(tween(durationMillis = 160)),
+            exit = fadeOut(tween(durationMillis = 120)),
+        ) {
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .background(Color.Black.copy(alpha = 0.55f))
+                    .clickable(onClick = onRefreshQr),
+                contentAlignment = Alignment.Center,
+            ) {
+                Text(
+                    text = stringResource(R.string.signin_refresh),
+                    style = MaterialTheme.typography.titleMedium,
+                    color = Color.White,
+                )
+            }
+        }
+    }
+}
