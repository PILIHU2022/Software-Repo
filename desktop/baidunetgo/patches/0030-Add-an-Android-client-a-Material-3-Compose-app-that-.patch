+     * compression packets (gpg may compress) and draining everything so the
+     * integrity check sees the end of the encrypted data.
+     */
+    private fun copyLiteralData(clear: InputStream, dst: OutputStream) {
+        val outer = BcPGPObjectFactory(clear)
+        var wrote = false
+        while (true) {
+            val obj = outer.nextObject() ?: break
+            when (obj) {
+                is PGPCompressedData -> {
+                    val inner = BcPGPObjectFactory(obj.dataStream)
+                    while (true) {
+                        val nested = inner.nextObject() ?: break
+                        if (nested is PGPLiteralData) {
+                            copy(nested.inputStream, dst)
+                            wrote = true
+                        }
+                    }
+                }
+                is PGPLiteralData -> {
+                    copy(obj.inputStream, dst)
+                    wrote = true
+                }
+                else -> Unit // marker/signature packets carry no data
+            }
+        }
+        if (!wrote) throw PgpException("解密失败：文件里没有数据")
+    }
