+import java.util.Collections
+import java.util.Random
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * The netdisk client against the real Go fake netdisk (`cmd/fakepand`): sign-in
+ * status and bdstoken, listings with unscrambled MD5s, folder creation, a
+ * multi-part upload whose bytes are verified, deletion to the recycle bin, and
+ * the shapes of the errors.
+ *
+ * The class skips itself cleanly when neither `go` (to build `cmd/fakepand`) nor a
+ * running `FAKEPAN_URL` is available.
+ */
+class BaiduApiTest {
+
+    @get:Rule
+    val tmp = TemporaryFolder()
+
+    private lateinit var server: FakePand
+    private lateinit var api: BaiduApi
+    private val http = OkHttpClient()
+
+    @Before
+    fun setUp() {
+        val fake = FakePand.startOrNull()
+        assumeTrue(
+            "the fake netdisk needs `go` or FAKEPAN_URL: ${FakePand.unavailableReason()}",
+            fake != null,
+        )
+        server = fake!!
+        api = BaiduApi(base = server.url)
+    }
+
+    @After
+    fun tearDown() {
+        if (::server.isInitialized) server.close()
+    }
+
+    // -----------------------------------------------------------------------
+
+    @Test
+    fun loginStatusFetchesTokenAndProfile() = runBlocking {
+        val status = api.loginStatus()
+        assertTrue(status.loggedIn)
+        assertEquals("faketoken", status.bdstoken)
+        assertEquals(22, status.vipType)
+
+        val user = api.userInfo()
+        assertEquals("演示用户", user.name)
+        assertEquals(2, user.vipType)
+        assertEquals(2L shl 40, user.total)
+        assertEquals(734L shl 30, user.used)
+
+        val quota = api.quota()
+        assertEquals(2L shl 40, quota.total)
+        assertEquals(734L shl 30, quota.used)
+    }
+
+    @Test
+    fun listReturnsSeededTreeWithUnscrambledMd5() = runBlocking {
+        val root = api.list("/")
+        val names = root.map { it.name }.toSet()
+        assertTrue("root listing: $names", names.containsAll(
+            listOf("照片", "电影", "音乐", "文档", "代码", "空文件夹", "README.md", "安装包.dmg")
+        ))
+        assertTrue(root.first { it.name == "照片" }.isDir)
+        assertFalse(root.first { it.name == "README.md" }.isDir)
+
+        // MD5 comes unscrambled: it must equal the hash of the bytes the fake serves.
+        val readme = root.first { it.name == "README.md" }
+        assertEquals(32, readme.md5.length)
+        assertEquals(md5Hex(download("/README.md", readme.size)), readme.md5)
+
+        val docs = api.list("/文档")
+        assertEquals(4, docs.size)
+        assertTrue(docs.any { it.name == "年度报告.pdf" })
+
+        // A file whose hash the netdisk does not know has an empty MD5.
+        val mirrored = api.list("/代码/备份").first { it.name == "缺少哈希的镜像.iso" }
+        assertEquals("", mirrored.md5)
+        assertEquals(700_000_000L, mirrored.size)
+    }
+
+    @Test
+    fun mkdirCreatesFoldersAndIgnoresExistingOnes() = runBlocking {
+        api.mkdir("/新目录")
+        api.mkdir("/新目录") // errno -8 "already exists" is success
+        api.mkdir("/新目录/子目录")
+
+        val created = api.list("/").first { it.name == "新目录" }
+        assertTrue(created.isDir)
+        assertTrue(api.list("/新目录").any { it.name == "子目录" && it.isDir })
+    }
+
+    @Test
+    fun uploadSendsMultiPartFileAndLandsTheRightBytes() = runBlocking {
+        val size = 9L * 1024 * 1024 // three 4 MiB parts: 4 + 4 + 1
+        val local = tmp.newFile("big.bin").apply { writeRandomBytes(size) }
+        val progress = Collections.synchronizedList(ArrayList<Pair<Long, Long>>())
+
+        api.upload(local, "/照片/big.bin", connections = 3) { done, total ->
+            progress += done to total
+        }
+
+        val uploaded = api.list("/照片").first { it.name == "big.bin" }
+        assertEquals(size, uploaded.size)
+        assertEquals(md5Hex(local), uploaded.md5)
+
+        val served = download("/照片/big.bin", size)
+        assertEquals(size, served.size.toLong())
+        assertEquals(md5Hex(local), md5Hex(served))
+
+        if (server.hasRequestLog) {
+            assertEquals(
+                "9 MiB must go up as three 4 MiB parts",
+                3,
+                server.requestCount("/rest/2.0/pcs/superfile2"),
+            )
+            assertEquals(1, server.requestCount("/api/precreate"))
+            assertEquals(1, server.requestCount("/api/create"))
+        }
+
+        assertTrue("progress must be reported", progress.isNotEmpty())
+        assertEquals(size, progress.last().first)
+        assertEquals(size, progress.last().second)
+        assertTrue("progress must be throttled (was ${progress.size} callbacks)", progress.size <= 40)
+    }
+
+    @Test
+    fun uploadsEmptyFile() = runBlocking {
+        val local = tmp.newFile("empty.bin")
+        api.upload(local, "/照片/empty.bin")
+        val listed = api.list("/照片").first { it.name == "empty.bin" }
+        assertEquals(0L, listed.size)
+    }
+
+    @Test
+    fun deleteMovesFileToTheRecycleBin() = runBlocking {
+        val local = tmp.newFile("待删除.txt").apply { writeText("删掉我") }
+        api.upload(local, "/照片/待删除.txt")
+        assertTrue(api.list("/照片").any { it.name == "待删除.txt" })
+
+        api.delete(listOf("/照片/待删除.txt"))
+        assertFalse(api.list("/照片").any { it.name == "待删除.txt" })
+
+        val recycle = fetchJson("/api/recycle/list?num=100&page=1")
+        val paths = recycle["list"]!!.jsonArray.map { (it as JsonObject).stringOrEmpty("path") }
+        assertTrue("recycle bin: $paths", paths.contains("/照片/待删除.txt"))
+    }
+
+    @Test
+    fun failuresAreClearChineseErrors() = runBlocking {
+        try {
+            api.list("/不存在的目录")
+            fail("listing a missing folder must throw")
+        } catch (e: BaiduException) {
+            assertTrue("message: ${e.message}", e.message!!.contains("读取目录失败"))
+            assertEquals(-9, e.errno)
+        }
+
+        val local = tmp.newFile("x.txt").apply { writeText("x") }
+        try {
+            api.upload(local, "/")
+            fail("uploading onto the root folder must throw")
+        } catch (e: BaiduException) {
+            assertTrue("message: ${e.message}", e.message!!.startsWith("上传失败"))
+        }
+    }
+
+    @Test
+    fun cookiesHeaderCarriesStoredCookies() {
+        val client = BaiduApi()
+        client.credentials = Credentials(
+            cookies = "BDUSS=abc; STOKEN=def; BAIDUID=xyz",
+            bduss = "abc",
+            stoken = "def",
+        )
+        val header = client.cookiesHeader()
+        assertTrue(header, header.contains("BDUSS=abc"))
+        assertTrue(header, header.contains("STOKEN=def"))
+        assertTrue(header, header.contains("BAIDUID=xyz"))
+        assertTrue("BDUSS and STOKEN come first: $header", header.startsWith("BDUSS=abc; STOKEN=def"))
+    }
+
+    @Test
+    fun signingOutClearsTheCookieJar() {
+        val client = BaiduApi()
+        client.credentials = Credentials(cookies = "BDUSS=a; STOKEN=b", bduss = "a", stoken = "b")
+        assertTrue(client.cookiesHeader().contains("BDUSS=a"))
+        client.credentials = null
+        assertEquals("signing out must forget the session cookies", "", client.cookiesHeader())
+    }
+
+    /**
+     * An expired session (`errno` -6) throws [NotLoggedInException], and the cached
+     * bdstoken is dropped so the next write fetches a fresh one lazily.
+     */
+    @Test
+    fun expiredSessionThrowsNotLoggedInAndRefetchesTheToken() {
+        val loginStatusCalls = AtomicInteger()
+        val expires = java.util.concurrent.atomic.AtomicBoolean(true)
+        val fake = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        fake.createContext("/api/loginStatus") { exchange ->
+            loginStatusCalls.incrementAndGet()
+            respond(exchange, """{"errno":0,"login_info":{"bdstoken":"tok","uk":1,"username":"u"}}""")
+        }
+        fake.createContext("/api/create") { exchange ->
+            if (expires.get()) {
+                respond(exchange, """{"errno":-6}""")
+            } else {
+                respond(exchange, """{"errno":0}""")
+            }
+        }
+        fake.start()
+        try {
+            val client = BaiduApi(base = "http://127.0.0.1:${fake.address.port}")
+            try {
+                runBlocking { client.mkdir("/x") }
+                fail("an expired session must throw")
+            } catch (e: NotLoggedInException) {
+                assertTrue("message: ${e.message}", e.message!!.contains("登录已失效"))
+            }
+            assertEquals(1, loginStatusCalls.get())
+
+            expires.set(false)
+            runBlocking { client.mkdir("/x") }
+            assertEquals("the token is fetched again after a session expiry", 2, loginStatusCalls.get())
+        } finally {
+            fake.stop(0)
+        }
+    }
+
+    // -----------------------------------------------------------------------
+    // The fake netdisk's own endpoints, for assertions about what the client sent
+    // -----------------------------------------------------------------------
+
+    private fun fetchJson(path: String): JsonObject {
+        val request = Request.Builder().url(server.url + path).get().build()
+        http.newCall(request).execute().use { response ->
+            assertTrue("GET $path → HTTP ${response.code}", response.code == 200)
+            return Json.parseToJsonElement(response.body.string()).jsonObject
+        }
+    }
+
+    private fun download(path: String, size: Long): ByteArray {
+        assertTrue("a download needs a bounded range", size > 0)
+        val request = Request.Builder()
+            .url(server.url + "/file?path=" + java.net.URLEncoder.encode(path, "UTF-8"))
+            .header("Range", "bytes=0-${size - 1}")
+            .get()
+            .build()
+        http.newCall(request).execute().use { response ->
+            assertTrue("GET $path → HTTP ${response.code}", response.code == 200 || response.code == 206)
+            return response.body.bytes()
+        }
+    }
+
+    private fun respond(exchange: com.sun.net.httpserver.HttpExchange, body: String) {
+        val bytes = body.toByteArray(Charsets.UTF_8)
+        exchange.responseHeaders.add("Content-Type", "application/json; charset=utf-8")
+        exchange.sendResponseHeaders(200, bytes.size.toLong())
+        exchange.responseBody.use { it.write(bytes) }
+    }
+
+    private fun md5Hex(bytes: ByteArray): String {
+        val digest = MessageDigest.getInstance("MD5").digest(bytes)
+        val out = StringBuilder(digest.size * 2)
+        for (byte in digest) {
+            val value = byte.toInt() and 0xFF
+            out.append("0123456789abcdef"[value ushr 4]).append("0123456789abcdef"[value and 0x0F])
+        }
+        return out.toString()
+    }
+
+    private fun md5Hex(file: File): String = file.inputStream().use { input ->
+        val digest = MessageDigest.getInstance("MD5")
+        val buffer = ByteArray(1 shl 16)
+        while (true) {
+            val read = input.read(buffer)
+            if (read < 0) break
+            digest.update(buffer, 0, read)
+        }
+        val out = StringBuilder(32)
+        for (byte in digest.digest()) {
+            val value = byte.toInt() and 0xFF
+            out.append("0123456789abcdef"[value ushr 4]).append("0123456789abcdef"[value and 0x0F])
+        }
+        out.toString()
+    }
+
+    private fun File.writeRandomBytes(size: Long) {
+        val random = Random(size xor 0x5EED)
+        outputStream().buffered().use { output ->
+            val buffer = ByteArray(1 shl 16)
+            var written = 0L
+            while (written < size) {
+                random.nextBytes(buffer)
+                val chunk = minOf(buffer.size.toLong(), size - written).toInt()
+                output.write(buffer, 0, chunk)
+                written += chunk
+            }
+        }
+    }
+
+}
