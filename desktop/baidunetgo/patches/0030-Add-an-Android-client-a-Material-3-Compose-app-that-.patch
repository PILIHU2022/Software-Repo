+    packaging {
+        resources {
+            excludes += "/META-INF/{AL2.0,LGPL2.1}"
+            // BouncyCastle ships its license/notice files in every jar; only
+            // one copy may end up in the APK.
+            excludes += "/META-INF/LICENSE.md"
+            excludes += "/META-INF/NOTICE.md"
+            excludes += "/META-INF/LICENSE-notice.md"
+        }
+    }
+
+    dependenciesInfo {
+        // Keep dependency metadata out of the produced artifacts.
+        includeInApk = false
+        includeInBundle = false
+    }
+
+    testOptions {
+        unitTests {
+            // Robolectric needs the merged resources and manifest to inflate a
+            // real Compose activity in a JVM test.
+            isIncludeAndroidResources = true
+            isReturnDefaultValues = true
+        }
+    }
+}
+
+// Robolectric needs its Android runtime jar (~100 MB) in a local directory; its
+// own Maven fetcher would put it in ~/.m2, which is read-only on this machine.
+// Resolve the jar through Gradle's repositories instead and copy it where
+// Robolectric's LocalDependencyResolver looks (property below).
+//
+// The version is Robolectric's instrumented Android 13 (API 33) runtime, the
+// SDK the screenshot test renders with. Bump it together with `robolectric` in
+// gradle/libs.versions.toml when a newer runtime is needed.
+val robolectricAndroidAll = "org.robolectric:android-all-instrumented:13-robolectric-9030017-i7"
+val robolectricSdkRuntime by configurations.creating
+dependencies {
+    robolectricSdkRuntime(robolectricAndroidAll)
+}
+
+val fetchRobolectricSdkRuntime by tasks.registering(Copy::class) {
+    from(robolectricSdkRuntime)
+    into(layout.buildDirectory.dir("robolectric-sdk"))
+}
+
+// The screenshot test renders with native graphics (needs CPU Skia, no device)
+// and writes its PNGs into android/screenshots/.
+tasks.withType<Test>().configureEach {
+    dependsOn(fetchRobolectricSdkRuntime)
+    systemProperty("robolectric.dependency.dir", layout.buildDirectory.dir("robolectric-sdk").get().asFile.absolutePath)
+    systemProperty("screenshot.dir", rootProject.layout.projectDirectory.dir("screenshots").asFile.absolutePath)
+    maxHeapSize = "2g"
+}
+
+dependencies {
+    // Pure-JVM logic (netdisk client, backup engine, OpenPGP later).
+    implementation(project(":core"))
+
+    implementation(libs.androidx.core.ktx)
+    implementation(libs.androidx.activity.compose)
+
+    implementation(platform(libs.androidx.compose.bom))
+    implementation(libs.androidx.compose.ui)
+    implementation(libs.androidx.compose.ui.graphics)
+    implementation(libs.androidx.compose.ui.tooling.preview)
+    implementation(libs.androidx.compose.material3)
+    implementation(libs.androidx.compose.material.icons.core)
+    implementation(libs.androidx.compose.material.icons.extended)
+
+    // App state, scheduling, storage and media access for the Android half.
+    implementation(libs.androidx.lifecycle.runtime.compose)
+    implementation(libs.androidx.lifecycle.viewmodel.compose)
+    implementation(libs.androidx.work.runtime.ktx)
+    implementation(libs.androidx.documentfile)
+    implementation(libs.coil.compose)
+    implementation(libs.kotlinx.coroutines.android)
+    implementation(libs.kotlinx.serialization.json)
+
+    testImplementation(libs.junit)
+    // Robolectric + Compose UI test render the real screens on the JVM and
+    // capture them to PNG (no emulator on this machine).
+    testImplementation(libs.robolectric)
+    testImplementation(platform(libs.androidx.compose.bom))
+    testImplementation(libs.androidx.compose.ui.test.junit4)
+    testImplementation(libs.androidx.test.core)
+    testImplementation(libs.androidx.test.core.ktx)
+    testImplementation(libs.androidx.test.ext.junit)
+
+    debugImplementation(libs.androidx.compose.ui.tooling)
+    // Registers the empty ComponentActivity the Compose test rule launches.
+    debugImplementation(libs.androidx.compose.ui.test.manifest)
+}
