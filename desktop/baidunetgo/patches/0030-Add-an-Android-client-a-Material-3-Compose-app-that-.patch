+ *
+ * Polling lives in the ViewModel; this screen only says when it is visible via
+ * [onScreenVisible] / [onScreenHidden], so leaving the composable stops the
+ * network polling immediately.
+ */
+@Composable
+fun SignInScreen(
+    state: SignInUi,
+    onScreenVisible: () -> Unit,
