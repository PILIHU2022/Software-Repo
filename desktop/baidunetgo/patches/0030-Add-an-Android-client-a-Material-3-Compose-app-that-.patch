@@ -0,0 +1,627 @@
+package com.pengstem.baidunetgo.ui
+
+import android.annotation.SuppressLint
+import android.app.Application
+import android.graphics.BitmapFactory
+import android.net.Uri
+import androidx.annotation.StringRes
+import androidx.documentfile.provider.DocumentFile
+import androidx.lifecycle.AndroidViewModel
+import androidx.lifecycle.viewModelScope
+import androidx.compose.ui.graphics.ImageBitmap
+import androidx.compose.ui.graphics.asImageBitmap
+import com.pengstem.baidunetgo.BaiduNetGoApplication
+import com.pengstem.baidunetgo.R
+import com.pengstem.baidunetgo.core.net.Credentials
+import com.pengstem.baidunetgo.core.net.NotLoggedInException
+import com.pengstem.baidunetgo.core.net.QrState
+import com.pengstem.baidunetgo.data.AppContainer
+import com.pengstem.baidunetgo.data.AppSettings
+import com.pengstem.baidunetgo.data.BackupBus
+import com.pengstem.baidunetgo.data.BackupScheduler
+import com.pengstem.baidunetgo.data.BackupStatus
+import com.pengstem.baidunetgo.data.FolderEntry
+import com.pengstem.baidunetgo.data.LastResult
+import com.pengstem.baidunetgo.data.MediaPermissions
+import com.pengstem.baidunetgo.data.RunFinished
+import com.pengstem.baidunetgo.data.RunKind
+import com.pengstem.baidunetgo.data.ThemeMode
+import com.pengstem.baidunetgo.data.TransferRecord
+import com.pengstem.baidunetgo.service.BackupService
+import java.io.IOException
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharedFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asSharedFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * The app's only ViewModel: owns [AppUiState], all persistence and every
+ * long-running operation. IO always runs on [Dispatchers.IO]; QR decoding (CPU)
+ * runs on [Dispatchers.Default].
+ *
+ * Backups started from the UI are executed by [BackupService] (so they survive
+ * leaving the app); this ViewModel only starts/cancels them and observes
+ * [BackupBus].
+ */
+class AppViewModel(application: Application) : AndroidViewModel(application) {
+
+    private val container: AppContainer = (application as BaiduNetGoApplication).container
+
+    // Application context only (never an Activity): it outlives this ViewModel.
+    @SuppressLint("StaticFieldLeak")
+    private val context = application.applicationContext
+
+    private val _ui = MutableStateFlow(AppUiState())
+    val uiState: StateFlow<AppUiState> = _ui.asStateFlow()
+
+    /** One-shot snackbar messages; never secrets, never stack traces. */
+    private val _messages = MutableSharedFlow<String>(extraBufferCapacity = 8)
+    val messages: SharedFlow<String> = _messages.asSharedFlow()
+
+    private val settingsWrites = Channel<AppSettings>(Channel.CONFLATED)
+    private var qrJob: Job? = null
+    private var accountJob: Job? = null
+    private var folderStatuses: Map<String, BackupStatus> = emptyMap()
+    private var albumStatuses: Map<Long, BackupStatus> = emptyMap()
+
+    init {
+        viewModelScope.launch(Dispatchers.IO) {
+            for (settings in settingsWrites) {
+                runCatching { container.settingsStore.save(settings) }
+                runCatching { BackupScheduler.apply(context, settings) }
+            }
+        }
+        bootstrap()
+        observeBus()
+    }
+
+    // ---------------------------------------------------------------- boot
+
+    private fun bootstrap() {
+        viewModelScope.launch {
+            val settings = withContext(Dispatchers.IO) { container.settingsStore.load() }
+            val credentials = withContext(Dispatchers.IO) { container.sessionStore.load() }
+            val passphraseSet = withContext(Dispatchers.IO) { container.passphraseStore.load() != null }
+            val statuses = withContext(Dispatchers.IO) {
+                Triple(
+                    container.statusStore.loadFolders(),
+                    container.statusStore.loadAlbums(),
+                    container.statusStore.lastFolderResult() to container.statusStore.lastAlbumResult(),
+                )
+            }
+            val history = withContext(Dispatchers.IO) { container.transferStore.load() }
+            val albumPermission = MediaPermissions.granted(context)
+            folderStatuses = statuses.first
+            albumStatuses = statuses.second
+            val session = if (credentials == null) {
+                SessionState.SignedOut
+            } else {
+                container.api.credentials = credentials
+                SessionState.SignedIn(null)
+            }
+            _ui.update {
+                it.copy(
+                    booting = false,
+                    session = session,
+                    settings = settings,
+                    passphraseSet = passphraseSet,
+                    folders = deriveFolders(settings, folderStatuses),
+                    albumPermission = albumPermission,
+                    lastFolderResult = statuses.third.first,
+                    lastAlbumResult = statuses.third.second,
+                    history = history,
+                )
+            }
+            // Make sure periodic jobs exist after an app update / first launch.
+            withContext(Dispatchers.IO) { runCatching { BackupScheduler.apply(context, settings) } }
+            if (credentials != null) refreshAccount()
+            if (albumPermission) refreshAlbums()
+        }
+    }
+
+    private fun observeBus() {
+        viewModelScope.launch {
+            combine(BackupBus.folder, BackupBus.album) { folder, album -> folder to album }
+                .collect { (folder, album) ->
+                    _ui.update { it.copy(folderRun = folder, albumRun = album) }
+                }
+        }
+        viewModelScope.launch {
+            BackupBus.events.collect { event -> onRunFinished(event) }
+        }
+    }
+
+    private suspend fun onRunFinished(event: RunFinished) {
+        val snapshot = withContext(Dispatchers.IO) {
+            RunStoreSnapshot(
+                folders = container.statusStore.loadFolders(),
+                albums = container.statusStore.loadAlbums(),
+                lastFolder = container.statusStore.lastFolderResult(),
+                lastAlbum = container.statusStore.lastAlbumResult(),
+                history = container.transferStore.load(),
+            )
+        }
+        folderStatuses = snapshot.folders
+        albumStatuses = snapshot.albums
+        _ui.update { state ->
+            state.copy(
+                folders = deriveFolders(state.settings, snapshot.folders),
+                albums = state.albums.map { it.copy(status = snapshot.albums[it.album.bucketId]) },
+                lastFolderResult = snapshot.lastFolder,
+                lastAlbumResult = snapshot.lastAlbum,
+                history = snapshot.history,
+            )
+        }
+
+        val record = event.record
+        val message = when {
+            event.cancelled -> str(R.string.backup_cancelled)
+            record == null -> str(R.string.backup_failed, event.error ?: str(R.string.status_unknown))
+            record.failed > 0 || record.errors.isNotEmpty() ->
+                str(R.string.backup_failed, record.errors.firstOrNull() ?: str(R.string.transfer_failed))
+            event.kind == RunKind.Album ->
+                str(R.string.album_done, record.uploaded, record.skipped, record.failed)
+            else -> str(R.string.backup_done, record.uploaded, record.skipped, record.failed)
+        }
+        _messages.tryEmit(message)
+    }
+
+    private data class RunStoreSnapshot(
+        val folders: Map<String, BackupStatus>,
+        val albums: Map<Long, BackupStatus>,
+        val lastFolder: LastResult?,
+        val lastAlbum: LastResult?,
+        val history: List<TransferRecord>,
+    )
+
+    // ------------------------------------------------------------- sign-in
+
+    /** Starts (or refreshes) QR sign-in and polls it every two seconds. */
+    fun startQrLogin() {
+        if (qrJob?.isActive == true) return
+        qrJob = viewModelScope.launch {
+            _ui.update { it.copy(signIn = SignInUi(loading = true)) }
+            try {
+                val png = withContext(Dispatchers.IO) { container.qrLogin.start() }
+                val bitmap = withContext(Dispatchers.Default) { decodeBitmap(png) }
+                if (bitmap == null) {
+                    _ui.update {
+                        it.copy(signIn = SignInUi(phase = QrPhase.Error, error = str(R.string.signin_qr_error, "PNG")))
+                    }
+                    return@launch
+                }
+                _ui.update { it.copy(signIn = SignInUi(qr = bitmap, phase = QrPhase.Waiting)) }
+                while (isActive) {
+                    delay(POLL_INTERVAL_MS)
+                    val state = try {
+                        withContext(Dispatchers.IO) { container.qrLogin.poll() }
+                    } catch (e: CancellationException) {
+                        throw e
+                    } catch (e: Exception) {
+                        _ui.update {
+                            it.copy(signIn = it.signIn.copy(loading = false, error = e.displayMessage()))
+                        }
+                        return@launch
+                    }
+                    when (state) {
+                        QrState.Waiting -> _ui.update { it.copy(signIn = it.signIn.copy(phase = QrPhase.Waiting)) }
+                        QrState.Scanned -> _ui.update { it.copy(signIn = it.signIn.copy(phase = QrPhase.Scanned)) }
+                        QrState.Confirmed -> {
+                            _ui.update { it.copy(signIn = it.signIn.copy(phase = QrPhase.Confirmed)) }
+                            completeQrLogin()
+                            return@launch
+                        }
+                        QrState.Expired -> {
+                            _ui.update { it.copy(signIn = it.signIn.copy(phase = QrPhase.Expired)) }
+                            return@launch
+                        }
+                    }
+                }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                _ui.update {
+                    it.copy(signIn = it.signIn.copy(loading = false, phase = QrPhase.Error, error = e.displayMessage()))
+                }
+            }
+        }
+    }
+
+    /** Called when the sign-in screen leaves composition. */
+    fun stopQrLogin() {
+        qrJob?.cancel()
+        qrJob = null
+    }
+
+    private suspend fun completeQrLogin() {
+        try {
+            val credentials = withContext(Dispatchers.IO) { container.qrLogin.finish() }
+            persistSession(credentials)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            // Missing STOKEN is the common failure here: offer cookie sign-in.
+            _ui.update {
+                it.copy(
+                    signIn = it.signIn.copy(
+                        loading = false,
+                        phase = QrPhase.Error,
+                        error = e.displayMessage(),
+                    ),
+                )
+            }
+        }
+    }
+
+    /** Cookie fallback: BDUSS + STOKEN, verified with `/api/loginStatus`. */
+    fun loginWithCookies(bduss: String, stoken: String) {
+        qrJob?.cancel()
+        qrJob = null
+        viewModelScope.launch {
+            _ui.update { it.copy(signIn = it.signIn.copy(loading = true, error = null)) }
+            val credentials = Credentials(
+                cookies = "BDUSS=$bduss; STOKEN=$stoken",
+                bduss = bduss,
+                stoken = stoken,
+            )
+            try {
+                withContext(Dispatchers.IO) {
+                    container.sessionStore.save(credentials)
+                    container.api.credentials = credentials
+                    val status = container.api.loginStatus()
+                    if (!status.loggedIn) throw IOException(str(R.string.signin_cookie_missing))
+                }
+                persistSession(credentials, alreadyStored = true)
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                withContext(Dispatchers.IO) {
+                    container.sessionStore.clear()
+                    container.api.credentials = null
+                }
+                _ui.update {
+                    it.copy(
+                        session = SessionState.SignedOut,
+                        signIn = it.signIn.copy(loading = false, error = e.displayMessage()),
+                    )
+                }
+            }
+        }
+    }
+
+    private suspend fun persistSession(credentials: Credentials, alreadyStored: Boolean = false) {
+        if (!alreadyStored) {
+            withContext(Dispatchers.IO) {
+                container.sessionStore.save(credentials)
+                container.api.credentials = credentials
+            }
+        }
+        _ui.update { it.copy(session = SessionState.SignedIn(null), signIn = SignInUi()) }
+        refreshAccount()
+    }
+
+    /** Sign out from 设置: clears session, passphrase, backup data and history. */
+    fun signOut() {
+        qrJob?.cancel()
+        accountJob?.cancel()
+        BackupService.cancel(context)
+        BackupScheduler.cancelAll(context)
+        viewModelScope.launch {
+            withContext(Dispatchers.IO) {
+                container.sessionStore.clear()
+                container.passphraseStore.clear()
+                container.statusStore.clear()
+                container.transferStore.clear()
+                container.api.credentials = null
+                context.filesDir.listFiles()?.forEach { file ->
+                    if (file.name.startsWith("folder-backup-") || file.name.startsWith("album-backup-")) {
+                        runCatching { file.delete() }
+                    }
+                }
+            }
+            folderStatuses = emptyMap()
+            albumStatuses = emptyMap()
+            val fresh = AppSettings()
+            _ui.value = AppUiState(
+                booting = false,
+                session = SessionState.SignedOut,
+                settings = fresh,
+                albumPermission = MediaPermissions.granted(context),
+            )
+            settingsWrites.trySend(fresh)
+            _messages.tryEmit(str(R.string.settings_signed_out))
+        }
+    }
+
+    // ------------------------------------------------------------- account
+
+    fun refreshAccount() {
+        accountJob?.cancel()
+        accountJob = viewModelScope.launch {
+            _ui.update { it.copy(accountLoading = true) }
+            try {
+                val account = withContext(Dispatchers.IO) {
+                    val info = container.api.userInfo()
+                    val quota = container.api.quota()
+                    AccountUi(name = info.name, vipType = info.vipType, used = quota.used, total = quota.total)
+                }
+                _ui.update {
+                    it.copy(
+                        account = account,
+                        accountLoading = false,
+                        session = SessionState.SignedIn(account),
+                    )
+                }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: NotLoggedInException) {
+                withContext(Dispatchers.IO) { container.sessionStore.clear() }
+                _ui.update {
+                    it.copy(session = SessionState.SignedOut, account = null, accountLoading = false)
+                }
+                _messages.tryEmit(str(R.string.error_session_expired))
+            } catch (e: Exception) {
+                // Offline at launch is not a sign-out: keep the session, tell the user.
+                _ui.update { it.copy(accountLoading = false) }
+                _messages.tryEmit(str(R.string.error_generic, e.displayMessage()))
+            }
+        }
+    }
+
+    // -------------------------------------------------------------- albums
+
+    fun refreshAlbums() {
+        if (!MediaPermissions.granted(context)) {
+            _ui.update { it.copy(albumPermission = false, albumsLoading = false) }
+            return
+        }
+        viewModelScope.launch {
+            _ui.update { it.copy(albumsLoading = true, albumPermission = true) }
+            val albums = withContext(Dispatchers.IO) {
+                runCatching { container.mediaScanner.scanBlocking() }.getOrDefault(emptyList())
+            }
+            _ui.update { state ->
+                state.copy(
+                    albumsLoading = false,
+                    albumPermission = MediaPermissions.granted(context),
+                    albums = albums.map { album ->
+                        AlbumUi(
+                            album = album,
+                            selected = album.bucketId !in state.settings.deselectedAlbums,
+                            status = albumStatuses[album.bucketId],
+                        )
+                    },
+                )
+            }
+        }
+    }
+
+    /** Result of the runtime media permission request. */
+    fun onMediaPermissionResult(granted: Boolean) {
+        _ui.update { it.copy(albumPermission = granted) }
+        if (granted) refreshAlbums()
+    }
+
+    fun toggleAlbum(bucketId: Long) {
+        updateSettings { settings ->
+            val deselected = settings.deselectedAlbums.toMutableSet()
+            if (bucketId in deselected) deselected.remove(bucketId) else deselected.add(bucketId)
+            settings.copy(deselectedAlbums = deselected)
+        }
+        val settings = _ui.value.settings
+        _ui.update { state ->
+            state.copy(albums = state.albums.map { it.copy(selected = it.album.bucketId !in settings.deselectedAlbums) })
+        }
+    }
+
+    fun selectAllAlbums() {
+        updateSettings { it.copy(deselectedAlbums = emptySet()) }
+        _ui.update { state -> state.copy(albums = state.albums.map { it.copy(selected = true) }) }
+    }
+
+    fun selectNoAlbums() {
+        val all = _ui.value.albums.map { it.album.bucketId }.toSet()
+        updateSettings { it.copy(deselectedAlbums = all) }
+        _ui.update { state -> state.copy(albums = state.albums.map { it.copy(selected = false) }) }
+    }
+
+    // ------------------------------------------------------------- folders
+
+    fun addFolder(uri: Uri) {
+        viewModelScope.launch {
+            val rawName = withContext(Dispatchers.IO) {
+                runCatching { DocumentFile.fromTreeUri(context, uri)?.name }.getOrNull()
+            } ?: str(R.string.backup_folders)
+            val name = uniqueFolderName(rawName)
+            val entry = FolderEntry(uri = uri.toString(), name = name)
+            if (_ui.value.settings.folders.any { it.uri == entry.uri }) {
+                _messages.tryEmit(str(R.string.backup_folder_duplicate))
+                return@launch
+            }
+            updateSettings { it.copy(folders = it.folders + entry) }
+            _ui.update { state ->
+                state.copy(folders = state.folders + FolderUi(entry, null))
+            }
+            _messages.tryEmit(str(R.string.backup_folder_added))
+        }
+    }
+
+    fun removeFolder(entry: FolderEntry) {
+        updateSettings { settings -> settings.copy(folders = settings.folders.filterNot { it.uri == entry.uri }) }
+        _ui.update { state -> state.copy(folders = state.folders.filterNot { it.entry.uri == entry.uri }) }
+        folderStatuses = folderStatuses - entry.uri
+    }
+
+    fun refreshFolderStatuses() {
+        viewModelScope.launch {
+            _ui.update { it.copy(foldersRefreshing = true) }
+            val statuses = withContext(Dispatchers.IO) { container.statusStore.loadFolders() }
+            folderStatuses = statuses
+            _ui.update { state ->
+                state.copy(
+                    foldersRefreshing = false,
+                    folders = deriveFolders(state.settings, statuses),
+                )
+            }
+        }
+    }
+
+    // ------------------------------------------------------------ settings
+
+    fun setDest(dest: String) = updateSettings { it.copy(dest = dest) }
+
+    fun setFolderAuto(enabled: Boolean) = updateSettings { it.copy(autoFolder = enabled) }
+
+    fun setAlbumAuto(enabled: Boolean) = updateSettings { it.copy(autoAlbum = enabled) }
+
+    fun setInterval(minutes: Int) = updateSettings { it.copy(intervalMinutes = minutes) }
+
+    fun setFolderEncrypt(enabled: Boolean) = updateSettings { it.copy(folderEncrypt = enabled) }
+
+    fun setAlbumEncrypt(enabled: Boolean) = updateSettings { it.copy(albumEncrypt = enabled) }
+
+    fun setWifiOnly(enabled: Boolean) = updateSettings { it.copy(wifiOnly = enabled) }
+
+    fun setConcurrency(value: Int) = updateSettings { it.copy(concurrency = value.coerceIn(1, 4)) }
+
+    fun setTheme(mode: ThemeMode) = updateSettings { it.copy(theme = mode) }
+
+    fun markNotificationAsked() = updateSettings { it.copy(notificationAsked = true) }
+
+    fun setPassphrase(passphrase: CharArray) {
+        viewModelScope.launch {
+            val copy = passphrase.copyOf()
+            val saved = try {
+                withContext(Dispatchers.IO) { container.passphraseStore.save(copy) }
+                true
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                false
+            } finally {
+                copy.fill('\u0000')
+                passphrase.fill('\u0000')
+            }
+            if (saved) {
+                _ui.update { it.copy(passphraseSet = true) }
+                _messages.tryEmit(str(R.string.passphrase_saved))
+            } else {
+                _messages.tryEmit(str(R.string.error_storage))
+            }
+        }
+    }
+
+    private fun updateSettings(transform: (AppSettings) -> AppSettings) {
+        val updated = transform(_ui.value.settings)
+        _ui.update { it.copy(settings = updated) }
+        settingsWrites.trySend(updated)
+    }
+
+    // ----------------------------------------------------------------- runs
+
+    fun startFolderBackup() {
+        val state = _ui.value
+        val settings = state.settings
+        if (!state.hasSession) {
+            _messages.tryEmit(str(R.string.backup_need_login))
+            return
+        }
+        if (settings.folders.isEmpty()) {
+            _messages.tryEmit(str(R.string.backup_need_folders))
+            return
+        }
+        if (!settings.dest.startsWith("/")) {
+            _messages.tryEmit(str(R.string.backup_dest_invalid))
+            return
+        }
+        if (settings.folderEncrypt && !state.passphraseSet) {
+            _messages.tryEmit(str(R.string.backup_need_passphrase))
+            return
+        }
+        if (BackupBus.isRunning(RunKind.Folder)) return
+        BackupService.start(context, RunKind.Folder)
+        _messages.tryEmit(str(R.string.backup_started))
+    }
+
+    fun startAlbumBackup() {
+        val state = _ui.value
+        val settings = state.settings
+        if (!state.hasSession) {
+            _messages.tryEmit(str(R.string.backup_need_login))
+            return
+        }
+        if (!state.albumPermission) {
+            _messages.tryEmit(str(R.string.album_need_permission))
+            return
+        }
+        if (state.selectedAlbumCount == 0) {
+            _messages.tryEmit(str(R.string.album_need_selection))
+            return
+        }
+        if (settings.albumEncrypt && !state.passphraseSet) {
+            _messages.tryEmit(str(R.string.backup_need_passphrase))
+            return
+        }
+        if (BackupBus.isRunning(RunKind.Album)) return
+        BackupService.start(context, RunKind.Album)
+        _messages.tryEmit(str(R.string.album_run_started))
+    }
+
+    fun cancelRun(kind: RunKind) {
+        BackupService.cancel(context)
+        _messages.tryEmit(str(R.string.transfer_cancelled_toast))
+    }
+
+    fun clearHistory() {
+        viewModelScope.launch {
+            withContext(Dispatchers.IO) { container.transferStore.clear() }
+            _ui.update { it.copy(history = emptyList()) }
+            _messages.tryEmit(str(R.string.transfer_cleared))
+        }
+    }
+
+    // -------------------------------------------------------------- helpers
+
+    /** Two trees with the same display name would collide on the netdisk. */
+    private fun uniqueFolderName(base: String): String {
+        val used = _ui.value.settings.folders.map { it.name }.toSet()
+        if (base !in used) return base
+        var index = 2
+        while ("$base ($index)" in used) index++
+        return "$base ($index)"
+    }
+
+    private fun deriveFolders(settings: AppSettings, statuses: Map<String, BackupStatus>): List<FolderUi> =
+        settings.folders.map { entry -> FolderUi(entry, statuses[entry.uri]) }
+
+    private fun decodeBitmap(png: ByteArray): ImageBitmap? = runCatching {
+        BitmapFactory.decodeByteArray(png, 0, png.size)?.asImageBitmap()
+    }.getOrNull()
+
+    private fun Throwable.displayMessage(): String =
+        message?.takeIf { it.isNotBlank() } ?: javaClass.simpleName
+
+    private fun str(@StringRes id: Int, vararg args: Any): String = context.getString(id, *args)
+
+    /** Whether the user configured encryption for the given run kind. */
+    fun requiresPassphrase(kind: RunKind): Boolean = when (kind) {
+        RunKind.Folder -> _ui.value.settings.folderEncrypt
+        RunKind.Album -> _ui.value.settings.albumEncrypt
+    }
+
+    companion object {
+        private const val POLL_INTERVAL_MS = 2_000L
+    }
+}
