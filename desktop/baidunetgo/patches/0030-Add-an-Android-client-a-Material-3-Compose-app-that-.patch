@@ -0,0 +1,250 @@
+package com.pengstem.baidunetgo.core.net
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.jsonObject
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.security.SecureRandom
+import java.util.concurrent.TimeUnit
+
+/** Where a QR sign-in is. */
+enum class QrState {
+    /** The code is shown on screen; the phone has not scanned it yet. */
+    Waiting,
+
+    /** The phone scanned the code and the user has to confirm it there. */
+    Scanned,
+
+    /** Confirmed: call [QrLogin.finish] to obtain the session. */
+    Confirmed,
+
+    /** The code is stale or was cancelled on the phone: start a new one. */
+    Expired,
+}
+
+/**
+ * Signs in by scanning a QR code with the Baidu Netdisk app, mirroring the
+ * desktop app's `internal/baidu/qrlogin.go`.
+ *
+ * The sign-in endpoints live on `passport.baidu.com`, and their bodies are JSONP
+ * (`callback({…})`), which is unwrapped here. Everything uses a browser
+ * user-agent and `Referer: https://pan.baidu.com/`, which the endpoints expect.
+ * The session's cookies live in this object's own jar, so `finish()` hands back
+ * what the sign-in flow collected.
+ *
+ * @param passportBase Baidu's sign-in host; only tests change it.
+ */
+class QrLogin(
+    http: OkHttpClient = OkHttpClient(),
+    passportBase: String = "https://passport.baidu.com",
+) {
+
+    private val base: String = passportBase.trimEnd('/')
+    private val jar = SessionCookieJar()
+    private val client: OkHttpClient = http.newBuilder()
+        .cookieJar(jar)
+        .connectTimeout(20, TimeUnit.SECONDS)
+        .readTimeout(45, TimeUnit.SECONDS)
+        .build()
+
+    private var gid: String = newGid()
+    private var sign: String = ""
+    private var confirmedValue: String = ""
+    private var startedAtMillis: Long = 0L
+
+    /**
+     * Asks for a fresh QR code and returns its image, already a PNG (the netdisk
+     * renders the QR itself).
+     */
+    suspend fun start(): ByteArray {
+        startedAtMillis = System.currentTimeMillis()
+        confirmedValue = ""
+        sign = ""
+        gid = newGid()
+        val params = linkedMapOf(
+            "lp" to "pc",
+            "qrloginfrom" to "pc",
+            "gid" to gid,
+            "apiver" to "v3",
+            "tt" to millis(),
+            "tpl" to "netdisk",
+            "_" to millis(),
+        )
+        val obj = getJsonObject("获取二维码", base + "/v2/api/getqrcode", params)
+        sign = obj.stringOrEmpty("sign")
+        if (sign.isEmpty()) throw BaiduException("获取二维码失败：服务器没有返回 sign")
+        val rawImageUrl = obj.stringOrEmpty("imgurl")
+        if (rawImageUrl.isEmpty()) throw BaiduException("获取二维码失败：服务器没有返回图片地址")
+        val imageUrl =
+            if (rawImageUrl.startsWith("http")) rawImageUrl else "https://" + rawImageUrl.removePrefix("//")
+        return getBytes("获取二维码图片", imageUrl)
+    }
+
+    /**
+     * Polls the code's state once (the caller repeats this about every second).
+     * A network hiccup or an unreadable answer reads as [QrState.Waiting]; an
+     * expired or cancelled code reads as [QrState.Expired].
+     */
+    suspend fun poll(): QrState {
+        if (sign.isEmpty()) return QrState.Expired
+        if (System.currentTimeMillis() - startedAtMillis > QrExpiryMillis) return QrState.Expired
+        val params = mapOf(
+            "channel_id" to sign,
+            "gid" to gid,
+            "tpl" to "netdisk",
+            "apiver" to "v3",
+            "callback" to "",
+            "tt" to millis(),
+            "_" to millis(),
+        )
+        val body = try {
+            call("获取扫码状态", base + "/channel/unicast", params)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: BaiduException) {
+            return QrState.Waiting
+        }
+        val outer = decodeJsonp(body) ?: return QrState.Waiting
+        when (outer.longOrZero("errno")) {
+            0L -> Unit
+            1L -> return QrState.Waiting // nothing happened while polling
+            else -> return QrState.Expired
+        }
+        val inner = try {
+            ApiJson.parseToJsonElement(outer.stringOrEmpty("channel_v")).jsonObject
+        } catch (e: Exception) {
+            return QrState.Waiting
+        }
+        val status = inner.intOrZero("status")
+        val value = inner.stringOrEmpty("v")
+        return when {
+            status == 0 && value.isNotEmpty() -> {
+                confirmedValue = value
+                QrState.Confirmed
+            }
+            status == 1 -> QrState.Scanned
+            status == 2 -> QrState.Expired // cancelled on the phone
+            else -> QrState.Waiting
+        }
+    }
+
+    /**
+     * Signs in with a confirmed code and returns the session's credentials.
+     *
+     * The netdisk's `STOKEN` comes from passport's `auth` redirect. When only
+     * `BDUSS` arrives, no netdisk session can be made from a QR login, so this
+     * throws a clear error telling the user to sign in with cookies instead.
+     */
+    suspend fun finish(): Credentials {
+        if (confirmedValue.isEmpty()) throw BaiduException("二维码尚未确认")
+        val params = linkedMapOf(
+            "v" to millis(),
+            "bduss" to confirmedValue,
+            "u" to PanWebHome,
+            "loginVersion" to "v4",
+            "qrcode" to "1",
+            "tpl" to "netdisk",
+            "apiver" to "v3",
+            "tt" to millis(),
+            "traceid" to "",
+            "callback" to "",
+        )
+        val loginBody = call("登录", base + "/v3/login/main/qrbdusslogin", params)
+        decodeJsonp(loginBody)?.let { checkErrno("登录", it) }
+
+        val auth = mapOf("return_type" to "5", "tpl" to "netdisk", "u" to PanWebHome)
+        val authBody = call("获取 STOKEN", base + "/v3/login/api/auth/", auth)
+        decodeJsonp(authBody)?.let { checkErrno("获取 STOKEN", it) }
+
+        val bduss = jar.get("BDUSS").orEmpty()
+        if (bduss.isEmpty()) throw BaiduException("登录失败：没有拿到 BDUSS")
+        val stoken = jar.get("STOKEN").orEmpty()
+        if (stoken.isEmpty()) {
+            throw BaiduException("登录失败：没有拿到网盘的 STOKEN，请改用 Cookie 登录")
+        }
+        return Credentials(cookies = jar.header(), bduss = bduss, stoken = stoken)
+    }
+
+    // -----------------------------------------------------------------------
+    // HTTP plumbing
+    // -----------------------------------------------------------------------
+
+    private suspend fun getJsonObject(op: String, url: String, params: Map<String, String>): JsonObject {
+        val body = call(op, url, params)
+        val obj = decodeJsonp(body) ?: throw BaiduException("${op}失败：服务器返回了无法解析的数据")
+        checkErrno(op, obj)
+        return obj
+    }
+
+    private suspend fun call(op: String, url: String, params: Map<String, String>): String {
+        currentCoroutineContext().ensureActive()
+        val builder = url.toHttpUrl().newBuilder()
+        for ((name, value) in params) builder.addQueryParameter(name, value)
+        val request = Request.Builder()
+            .url(builder.build())
+            .header("User-Agent", BrowserUserAgent)
+            .header("Referer", "https://pan.baidu.com/")
+            .get()
+            .build()
+        val (code, text) = client.awaitResponse(request) { response -> response.code to response.body.string() }
+        if (code >= 400) throw BaiduException("${op}失败：服务器返回 HTTP $code")
+        return text
+    }
+
+    private suspend fun getBytes(op: String, url: String): ByteArray {
+        currentCoroutineContext().ensureActive()
+        val request = Request.Builder()
+            .url(url.toHttpUrl())
+            .header("User-Agent", BrowserUserAgent)
+            .header("Referer", "https://pan.baidu.com/")
+            .get()
+            .build()
+        val (code, bytes) = client.awaitResponse(request) { response -> response.code to response.body.bytes() }
+        if (code >= 400) throw BaiduException("${op}失败：服务器返回 HTTP $code")
+        return bytes
+    }
+
+    private companion object {
+        const val QrExpiryMillis = 3 * 60 * 1000L
+    }
+}
+
+/** The login page's user-agent, which the passport endpoints expect. */
+internal const val BrowserUserAgent = NetdiskUserAgent
+
+/** Where the netdisk's web page lives, used as the sign-in redirect target. */
+internal const val PanWebHome = "https://pan.baidu.com/disk/home"
+
+internal fun millis(): String = System.currentTimeMillis().toString()
+
+/** Unwraps `callback({…})`-style JSONP and bare parenthesized bodies. */
+internal fun decodeJsonp(body: String): JsonObject? {
+    val text = body.trim()
+    if (text.isEmpty()) return null
+    val candidate = if (text.startsWith("{")) {
+        text
+    } else {
+        val start = text.indexOf('{')
+        val end = text.lastIndexOf('}')
+        if (start < 0 || end < start) return null else text.substring(start, end + 1)
+    }
+    return try {
+        ApiJson.parseToJsonElement(candidate).jsonObject
+    } catch (e: Exception) {
+        null
+    }
+}
+
+/** The random id the sign-in page gives itself (mirrors the desktop app's `newGID`). */
+internal fun newGid(): String {
+    val bytes = ByteArray(16)
+    SecureRandom().nextBytes(bytes)
+    val hex = bytes.toHex().uppercase()
+    return hex.substring(0, 7) + "-" + hex.substring(7, 11) + "-4" + hex.substring(12, 15) +
+        "-" + hex.substring(15, 19) + "-" + hex.substring(19, 31)
+}
