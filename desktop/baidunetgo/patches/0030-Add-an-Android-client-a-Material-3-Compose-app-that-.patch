+package com.pengstem.baidunetgo.data
+
+import android.content.Context
+import com.pengstem.baidunetgo.core.net.BaiduApi
+import com.pengstem.baidunetgo.core.net.QrLogin
+
+/**
+ * Small manual dependency container owned by
+ * [com.pengstem.baidunetgo.BaiduNetGoApplication].
+ *
+ * One instance per process: the ViewModel, the foreground service and the
+ * WorkManager workers all share it, so they share the same netdisk client
+ * (cookies, HTTP connection pool) and the same on-disk stores.
+ */
+class AppContainer(context: Context) {
+
+    val appContext: Context = context.applicationContext
+
+    // Security: one Keystore key, AES/GCM, for session, passphrase and settings.
+    private val cipher = KeystoreCipher()
+    private val encryptedFiles = EncryptedFileStore(appContext, cipher)
+
+    val settingsStore = SettingsStore(encryptedFiles)
+    val sessionStore = SessionStore(encryptedFiles)
+    val passphraseStore = PassphraseStore(encryptedFiles)
+
+    val statusStore = BackupStatusStore(appContext)
+    val transferStore = TransferHistoryStore(appContext)
+    val mediaScanner = MediaStoreScanner(appContext)
+
+    val api = BaiduApi()
+    val qrLogin = QrLogin()
+
+    val runner = BackupRunner(appContext, this)
+}
