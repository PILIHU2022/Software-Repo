+package com.pengstem.baidunetgo.service
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.net.NetworkCapabilities
+import androidx.work.CoroutineWorker
+import androidx.work.WorkerParameters
+import com.pengstem.baidunetgo.BaiduNetGoApplication
+import com.pengstem.baidunetgo.data.BackupRunner
+import com.pengstem.baidunetgo.data.MediaPermissions
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * Periodic folder/album backup, scheduled by
+ * [com.pengstem.baidunetgo.data.BackupScheduler].
+ *
+ * The worker re-reads credentials, passphrase and settings from the encrypted
+ * stores (WorkManager's input [androidx.work.Data] is plain-text persisted, so
+ * secrets never travel through it) and runs the same [BackupRunner] the
+ * foreground service uses.
+ */
+class BackupWorker(
+    appContext: Context,
+    params: WorkerParameters,
+) : CoroutineWorker(appContext, params) {
+
+    override suspend fun doWork(): Result = withContext(Dispatchers.IO) {
+        val app = applicationContext as? BaiduNetGoApplication ?: return@withContext Result.failure()
+        val container = app.container
+        val settings = container.settingsStore.load()
+        val kind = inputData.getString(KEY_KIND) ?: return@withContext Result.failure()
+
+        if (container.sessionStore.load() == null) return@withContext Result.success()
+        if (settings.wifiOnly && !isUnmetered()) return@withContext Result.retry()
+
+        try {
+            when (kind) {
+                BackupRunner.KIND_FOLDER -> {
+                    if (!settings.autoFolder || settings.folders.isEmpty()) {
+                        return@withContext Result.success()
+                    }
+                    container.runner.runFolder(settings) { }
+                }
+
+                BackupRunner.KIND_ALBUM -> {
+                    if (!settings.autoAlbum) return@withContext Result.success()
+                    // Permission can be revoked between scheduling and running;
+                    // retrying would not help, so wait for the next interval.
+                    if (!MediaPermissions.granted(applicationContext)) {
+                        return@withContext Result.success()
+                    }
+                    container.runner.runAlbum(settings) { }
+                }
+
+                else -> return@withContext Result.failure()
+            }
+            Result.success()
+        } catch (e: CancellationException) {
+            // WorkManager cancelled us (constraints lost, user cancelled, ...).
+            Result.retry()
+        } catch (e: Exception) {
+            if (runAttemptCount < MAX_RETRIES) Result.retry() else Result.success()
+        }
+    }
+
+    private fun isUnmetered(): Boolean {
+        val manager = applicationContext.getSystemService(ConnectivityManager::class.java)
+            ?: return false
+        val network = manager.activeNetwork ?: return false
+        val capabilities = manager.getNetworkCapabilities(network) ?: return false
+        return capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) &&
+            capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_METERED)
+    }
+
+    companion object {
+        const val KEY_KIND = "kind"
+        private const val MAX_RETRIES = 3
+    }
+}
