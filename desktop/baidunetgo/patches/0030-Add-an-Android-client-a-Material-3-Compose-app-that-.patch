+package com.pengstem.baidunetgo.data
+
+import android.content.Context
+import androidx.core.net.toUri
+import com.pengstem.baidunetgo.R
+import com.pengstem.baidunetgo.core.backup.Backup
+import com.pengstem.baidunetgo.core.backup.BackupConfig
+import com.pengstem.baidunetgo.core.backup.BackupProgress
+import com.pengstem.baidunetgo.core.backup.BackupResult
+import com.pengstem.baidunetgo.core.backup.BackupStateStore
+import com.pengstem.baidunetgo.core.net.BaiduApi
+import java.io.File
+import java.io.IOException
+import java.security.MessageDigest
+import java.util.UUID
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * Runs folder and album backups through `:core`'s engine.
+ *
+ * Shared by the foreground service (user-initiated runs) and the WorkManager
+ * workers (periodic runs), so scheduling and UI runs always behave the same.
+ * All work happens on [Dispatchers.IO]; progress callbacks are throttled to
+ * at most four per second plus one per file change.
+ */
+class BackupRunner(
+    private val context: Context,
+    private val container: AppContainer,
+) {
+
+    /**
+     * Backs up every configured SAF tree, sequentially (so a cancel is quick and
+     * the netdisk sees one tree at a time). A failure in one tree is recorded
+     * and the next tree still runs.
+     */
+    suspend fun runFolder(
+        settings: AppSettings,
+        onProgress: (RunSnapshot) -> Unit,
+    ): TransferRecord = gated {
+        withContext(Dispatchers.IO) {
+        if (settings.folders.isEmpty()) throw IOException(context.getString(R.string.error_no_folders))
+        val api = requireApi()
+        val passphrase = passphraseFor(settings.folderEncrypt)
+        val throttle = ProgressThrottle(onProgress)
+        val meter = SpeedMeter()
+        var uploaded = 0
+        var skipped = 0
+        var failed = 0
+        var bytes = 0L
+        val errors = mutableListOf<String>()
+        val trees = settings.folders
+
+        try {
+            trees.forEachIndexed { index, tree ->
+                val source = DocumentSource(
+                    context = context,
+                    treeUri = tree.uri.toUri(),
+                    label = tree.name,
+                )
+                val stateStore = BackupStateStore(
+                    File(context.filesDir, "folder-backup-${digest(tree.uri)}.json").absolutePath,
+                )
+                val config = BackupConfig(
+                    dest = settings.dest,
+                    encrypt = settings.folderEncrypt,
+                    parallel = settings.concurrency.coerceIn(1, 4),
+                    remoteName = safeRemoteSegment(tree.name, "文件夹"),
+                )
+                val result = try {
+                    Backup.run(api, source, config, stateStore, passphrase) { progress ->
+                        val snapshot = progress.toSnapshot(
+                            kind = RunKind.Folder,
+                            label = tree.name,
+                            stepIndex = index + 1,
+                            stepCount = trees.size,
+                            meter = meter,
+                        )
+                        throttle.emit(snapshot)
+                    }
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Exception) {
+                    errors += "${tree.name}: ${e.displayMessage()}"
+                    null
+                }
+
+                if (result != null) {
+                    uploaded += result.uploaded
+                    skipped += result.skipped
+                    failed += result.failed
+                    bytes += result.bytes
+                    errors += result.errors.take(ERRORS_PER_TREE).map { "${tree.name}: $it" }
+                    container.statusStore.updateFolder(
+                        uri = tree.uri,
+                        status = BackupStatus(
+                            lastBackupAt = System.currentTimeMillis(),
+                            uploaded = result.uploaded,
+                            skipped = result.skipped,
+                            failed = result.failed,
+                            bytes = result.bytes,
+                            files = runCatching { stateStore.load().entries.size }.getOrDefault(0),
+                            errors = result.errors.take(ERRORS_PER_TREE),
+                        ),
+                    )
+                }
+            }
+        } finally {
+            passphrase?.fill('\u0000')
+        }
+
+        val record = TransferRecord(
+            id = UUID.randomUUID().toString(),
+            kind = KIND_FOLDER,
+            label = "文件夹备份",
+            finishedAt = System.currentTimeMillis(),
+            uploaded = uploaded,
+            skipped = skipped,
+            failed = failed,
+            bytes = bytes,
+            errors = errors.take(MAX_ERRORS),
+        )
+        finishRecord(record, BackupStatusStore.KIND_FOLDER)
+        record
+        }
+    }
+
+    /**
+     * Backs up the selected albums of both media kinds. The album list is
+     * scanned fresh here so a background run sees photos taken since the app
+     * last looked.
+     */
+    suspend fun runAlbum(
+        settings: AppSettings,
+        onProgress: (RunSnapshot) -> Unit,
+    ): TransferRecord = gated {
+        withContext(Dispatchers.IO) {
+        if (!MediaPermissions.granted(context)) throw IOException(context.getString(R.string.error_no_media_permission))
+        val albums = container.mediaScanner.scanBlocking()
+            .filter { it.bucketId !in settings.deselectedAlbums && it.itemCount > 0 }
+        if (albums.isEmpty()) throw IOException(context.getString(R.string.error_no_albums))
+
+        val api = requireApi()
+        val passphrase = passphraseFor(settings.albumEncrypt)
+        val throttle = ProgressThrottle(onProgress)
+        val meter = SpeedMeter()
+        var uploaded = 0
+        var skipped = 0
+        var failed = 0
+        var bytes = 0L
+        val errors = mutableListOf<String>()
+
+        try {
+            albums.forEachIndexed { index, album ->
+                val source = MediaAlbumSource(container.mediaScanner, album)
+                val stateStore = BackupStateStore(
+                    File(context.filesDir, "album-backup-${album.bucketId}.json").absolutePath,
+                )
+                val config = BackupConfig(
+                    dest = settings.dest,
+                    encrypt = settings.albumEncrypt,
+                    parallel = settings.concurrency.coerceIn(1, 4),
+                    remoteName = "相册/" + safeRemoteSegment(album.displayName, "未命名相册"),
+                )
+                val result = try {
+                    Backup.run(api, source, config, stateStore, passphrase) { progress ->
+                        val snapshot = progress.toSnapshot(
+                            kind = RunKind.Album,
+                            label = album.displayName,
+                            stepIndex = index + 1,
+                            stepCount = albums.size,
+                            meter = meter,
+                        )
+                        throttle.emit(snapshot)
+                    }
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Exception) {
+                    errors += "${album.displayName}: ${e.displayMessage()}"
+                    null
+                }
+
+                if (result != null) {
+                    uploaded += result.uploaded
+                    skipped += result.skipped
+                    failed += result.failed
+                    bytes += result.bytes
+                    errors += result.errors.take(ERRORS_PER_ALBUM).map { "${album.displayName}: $it" }
+                    container.statusStore.updateAlbum(
+                        bucketId = album.bucketId,
+                        status = BackupStatus(
+                            lastBackupAt = System.currentTimeMillis(),
+                            uploaded = result.uploaded,
+                            skipped = result.skipped,
+                            failed = result.failed,
+                            bytes = result.bytes,
+                            files = runCatching { stateStore.load().entries.size }.getOrDefault(0),
+                            errors = result.errors.take(ERRORS_PER_ALBUM),
+                        ),
+                    )
+                }
+            }
+        } finally {
+            passphrase?.fill('\u0000')
+        }
+
+        val record = TransferRecord(
+            id = UUID.randomUUID().toString(),
+            kind = KIND_ALBUM,
+            label = "相册备份",
+            finishedAt = System.currentTimeMillis(),
+            uploaded = uploaded,
+            skipped = skipped,
+            failed = failed,
+            bytes = bytes,
+            errors = errors.take(MAX_ERRORS),
+        )
+        finishRecord(record, BackupStatusStore.KIND_ALBUM)
+        record
+        }
+    }
+
+    /**
+     * Only one backup may touch the netdisk and the state files at a time: a
+     * periodic worker and a user-initiated service run can overlap otherwise.
+     */
+    private suspend fun <T> gated(block: suspend () -> T): T {
+        if (!runGate.tryAcquire()) throw IOException(context.getString(R.string.error_busy))
+        try {
+            return block()
+        } finally {
+            runGate.release()
+        }
+    }
+
+    private fun finishRecord(record: TransferRecord, kind: String) {
+        container.transferStore.add(record)
+        container.statusStore.setLastResult(
+            LastResult(
+                finishedAt = record.finishedAt,
+                kind = kind,
+                uploaded = record.uploaded,
+                skipped = record.skipped,
+                failed = record.failed,
+                bytes = record.bytes,
+                errors = record.errors,
+            ),
+        )
+    }
+
+    private fun requireApi(): BaiduApi {
+        val credentials = container.sessionStore.load()
+            ?: throw IOException(context.getString(R.string.error_session_expired))
+        container.api.credentials = credentials
+        return container.api
+    }
+
+    private fun passphraseFor(encrypt: Boolean): CharArray? {
+        if (!encrypt) return null
+        val passphrase = container.passphraseStore.load()
+        if (passphrase == null || passphrase.isEmpty()) {
+            throw IOException(context.getString(R.string.error_no_passphrase))
+        }
+        return passphrase
+    }
+
+    private fun BackupProgress.toSnapshot(
+        kind: RunKind,
+        label: String,
+        stepIndex: Int,
+        stepCount: Int,
+        meter: SpeedMeter,
+    ) = RunSnapshot(
+        kind = kind,
+        label = label,
+        file = file,
+        percent = if (total > 0) (done.toFloat() / total).coerceIn(0f, 1f) else 0f,
+        done = done,
+        total = total,
+        uploaded = uploaded,
+        skipped = skipped,
+        failed = failed,
+        bytesPerSecond = meter.update(file, done),
+        stepIndex = stepIndex,
+        stepCount = stepCount,
+    )
+
+    /** A single netdisk path segment: no separators, no blank names. */
+    private fun safeRemoteSegment(raw: String, fallback: String): String =
+        raw.trim().replace('/', '_').replace('\\', '_').ifBlank { fallback }
+
+    private fun Throwable.displayMessage(): String =
+        message?.takeIf { it.isNotBlank() } ?: javaClass.simpleName
+
+    /** Emits progress at most every 250 ms, plus immediately on file changes. */
+    private class ProgressThrottle(private val onProgress: (RunSnapshot) -> Unit) {
+        private var lastEmitNanos = 0L
+        private var lastFile = ""
+
+        fun emit(snapshot: RunSnapshot) {
+            val now = System.nanoTime()
+            val fileChanged = snapshot.file != lastFile
+            if (!fileChanged && now - lastEmitNanos < MIN_INTERVAL_NANOS) return
+            lastEmitNanos = now
+            lastFile = snapshot.file
+            onProgress(snapshot)
+        }
+    }
+
+    /** Bytes/s of the current file, averaged over ~1 s buckets. */
+    private class SpeedMeter {
+        private var file = ""
+        private var lastDone = 0L
+        private var lastNanos = 0L
+        private var speed = 0L
+
+        fun update(currentFile: String, done: Long): Long {
+            val now = System.nanoTime()
+            if (currentFile != file) {
+                file = currentFile
+                lastDone = done
+                lastNanos = now
+                speed = 0L
+                return 0L
+            }
+            val elapsed = now - lastNanos
+            if (elapsed >= BUCKET_NANOS) {
+                val delta = done - lastDone
+                if (delta >= 0) speed = delta * NANOS_PER_SECOND / elapsed
+                lastDone = done
+                lastNanos = now
+            }
+            return speed
+        }
+    }
+
+    private val runGate = java.util.concurrent.Semaphore(1)
+
+    companion object {
+        const val KIND_FOLDER = "folder"
+        const val KIND_ALBUM = "album"
+        private const val MIN_INTERVAL_NANOS = 250_000_000L
+        private const val BUCKET_NANOS = 500_000_000L
+        private const val NANOS_PER_SECOND = 1_000_000_000L
+        private const val ERRORS_PER_TREE = 5
+        private const val ERRORS_PER_ALBUM = 5
+        private const val MAX_ERRORS = 40
+
+        /** Stable, filesystem-safe key for per-tree/per-album state files. */
+        internal fun digest(value: String): String {
+            val bytes = MessageDigest.getInstance("SHA-256")
+                .digest(value.toByteArray(Charsets.UTF_8))
+            return bytes.take(12).joinToString("") { "%02x".format(it) }
+        }
+    }
+}
