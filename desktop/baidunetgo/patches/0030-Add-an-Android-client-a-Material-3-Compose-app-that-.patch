+/**
+ * App shell: Material 3 [Scaffold] with a large top app bar (per-screen
+ * actions), a bottom [NavigationBar] and a shared snackbar host.
+ *
+ * Navigation is plain Compose state (the selected destination), deliberately
+ * without navigation-compose.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun BaiduNetGoApp(
+    state: AppUiState,
+    vm: AppViewModel,
+    snackbarHostState: SnackbarHostState,
+    modifier: Modifier = Modifier,
+) {
+    var selectedDestination by rememberSaveable { mutableStateOf(BaiduNetGoDestination.Backup) }
+    var helpVisible by rememberSaveable { mutableStateOf(false) }
+    val scrollBehavior = TopAppBarDefaults.exitUntilCollapsedScrollBehavior(rememberTopAppBarState())
+
+    Scaffold(
+        modifier = modifier
+            .fillMaxSize()
+            .nestedScroll(scrollBehavior.nestedScrollConnection),
+        topBar = {
+            LargeTopAppBar(
+                title = { Text(stringResource(selectedDestination.labelRes)) },
+                scrollBehavior = scrollBehavior,
+                actions = {
+                    when (selectedDestination) {
+                        BaiduNetGoDestination.Backup -> RunAction(
+                            run = state.folderRun,
+                            onStart = vm::startFolderBackup,
+                            onCancel = { vm.cancelRun(RunKind.Folder) },
+                        )
+
+                        BaiduNetGoDestination.GalleryBackup -> RunAction(
+                            run = state.albumRun,
+                            onStart = vm::startAlbumBackup,
+                            onCancel = { vm.cancelRun(RunKind.Album) },
+                        )
+
+                        BaiduNetGoDestination.Transfer -> {
+                            if (state.history.isNotEmpty()) {
+                                IconButton(onClick = vm::clearHistory) {
+                                    Icon(
+                                        imageVector = Icons.Filled.DeleteSweep,
+                                        contentDescription = stringResource(R.string.transfer_clear_done),
+                                    )
+                                }
+                            }
+                        }
+
+                        BaiduNetGoDestination.Settings -> Unit
+                    }
+                    IconButton(onClick = { helpVisible = true }) {
+                        Icon(
+                            imageVector = Icons.AutoMirrored.Filled.HelpOutline,
+                            contentDescription = stringResource(R.string.action_help),
+                        )
+                    }
+                },
+            )
+        },
+        bottomBar = {
+            NavigationBar {
+                BaiduNetGoDestination.entries.forEach { destination ->
+                    NavigationBarItem(
+                        selected = selectedDestination == destination,
+                        onClick = { selectedDestination = destination },
+                        icon = {
+                            Icon(imageVector = destination.icon, contentDescription = null)
+                        },
+                        label = { Text(stringResource(destination.labelRes)) },
+                        colors = NavigationBarItemDefaults.colors(
+                            selectedIconColor = MaterialTheme.colorScheme.onPrimaryContainer,
+                            indicatorColor = MaterialTheme.colorScheme.primaryContainer,
+                        ),
+                    )
+                }
+            }
+        },
+        snackbarHost = { SnackbarHost(snackbarHostState) },
+    ) { innerPadding ->
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(innerPadding),
+        ) {
+            when (selectedDestination) {
+                BaiduNetGoDestination.Backup -> BackupScreen(state = state, vm = vm)
+                BaiduNetGoDestination.GalleryBackup -> GalleryBackupScreen(state = state, vm = vm)
+                BaiduNetGoDestination.Transfer -> TransferScreen(state = state, vm = vm)
+                BaiduNetGoDestination.Settings -> SettingsScreen(state = state, vm = vm)
+            }
+        }
+    }
+
+    if (helpVisible) {
+        HelpDialog(onDismiss = { helpVisible = false })
+    }
+}
+
+/** 立即备份 while idle, 取消 while a run of this kind is active. */
+@Composable
+private fun RunAction(
+    run: RunSnapshot?,
+    onStart: () -> Unit,
+    onCancel: () -> Unit,
+) {
+    IconButton(onClick = if (run != null) onCancel else onStart) {
+        Icon(
+            imageVector = if (run != null) Icons.Filled.StopCircle else Icons.Filled.CloudUpload,
+            contentDescription = stringResource(
+                if (run != null) R.string.backup_cancel else R.string.backup_run_now,
+            ),
+            tint = if (run != null) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.primary,
+        )
+    }
+}
+
+/** Collects one-shot messages into the shared snackbar. */
+@Composable
+fun SnackbarMessages(vm: AppViewModel, hostState: SnackbarHostState) {
+    LaunchedEffect(vm, hostState) {
+        vm.messages.collect { message -> hostState.showSnackbar(message) }
+    }
+}
