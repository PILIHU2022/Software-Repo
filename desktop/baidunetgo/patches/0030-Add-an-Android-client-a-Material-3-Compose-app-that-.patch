+            MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+
+        QrPhase.Scanned -> Triple(
+            Icons.Filled.CheckCircle,
+            stringResource(R.string.signin_state_scanned),
+            MaterialTheme.colorScheme.primary,
+        )
+
+        QrPhase.Confirmed -> Triple(
+            Icons.Filled.CheckCircle,
+            stringResource(R.string.signin_state_confirmed),
+            MaterialTheme.colorScheme.primary,
+        )
+
+        QrPhase.Expired -> Triple(
+            Icons.Filled.ErrorOutline,
+            stringResource(R.string.signin_state_expired),
+            MaterialTheme.colorScheme.error,
+        )
+
+        QrPhase.Error -> Triple(
+            Icons.Filled.ErrorOutline,
+            state.error ?: stringResource(R.string.error_offline),
+            MaterialTheme.colorScheme.error,
+        )
+
+        QrPhase.Idle -> Triple(
+            Icons.Filled.QrCode2,
+            stringResource(R.string.signin_loading),
+            MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+    }
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+        Icon(imageVector = icon, contentDescription = null, tint = tint, modifier = Modifier.size(18.dp))
+        Text(text = text, style = MaterialTheme.typography.bodyMedium, color = tint)
+    }
+}
+
+@Composable
+private fun CookieLoginDialog(
+    loading: Boolean,
+    error: String?,
+    onDismiss: () -> Unit,
+    onSubmit: (String, String) -> Unit,
+) {
+    var bduss by rememberSaveable { mutableStateOf("") }
+    var stoken by rememberSaveable { mutableStateOf("") }
+    val valid = bduss.isNotBlank() && stoken.isNotBlank()
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(R.string.signin_cookie_title)) },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                Text(
+                    text = stringResource(R.string.signin_cookie_desc),
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+                OutlinedTextField(
+                    value = bduss,
+                    onValueChange = { bduss = it },
+                    singleLine = true,
+                    label = { Text(stringResource(R.string.signin_bduss)) },
+                    visualTransformation = PasswordVisualTransformation(),
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Password),
+                )
+                OutlinedTextField(
+                    value = stoken,
+                    onValueChange = { stoken = it },
+                    singleLine = true,
+                    label = { Text(stringResource(R.string.signin_stoken)) },
+                    visualTransformation = PasswordVisualTransformation(),
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Password),
+                )
+                if (loading) {
+                    Row(
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(8.dp),
+                    ) {
+                        CircularProgressIndicator(modifier = Modifier.size(16.dp), strokeWidth = 2.dp)
+                        Text(stringResource(R.string.signin_logging_in), style = MaterialTheme.typography.bodySmall)
+                    }
+                }
+                if (error != null) {
+                    Text(
+                        text = error,
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.error,
+                    )
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(
+                enabled = valid && !loading,
+                onClick = {
+                    onSubmit(bduss.trim(), stoken.trim())
+                    onDismiss()
+                },
+            ) {
+                Text(stringResource(R.string.signin_cookie))
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) { Text(stringResource(R.string.action_cancel)) }
+        },
+    )
+}
