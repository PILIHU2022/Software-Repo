+package com.pengstem.baidunetgo.ui
+
+import androidx.compose.ui.graphics.ImageBitmap
+import com.pengstem.baidunetgo.data.AppSettings
+import com.pengstem.baidunetgo.data.BackupStatus
+import com.pengstem.baidunetgo.data.FolderEntry
+import com.pengstem.baidunetgo.data.LastResult
+import com.pengstem.baidunetgo.data.MediaAlbum
+import com.pengstem.baidunetgo.data.RunSnapshot
+import com.pengstem.baidunetgo.data.TransferRecord
+
+/** Sign-in state machine of the whole app. */
+sealed interface SessionState {
+    data object Loading : SessionState
+    data object SignedOut : SessionState
+    data class SignedIn(val account: AccountUi?) : SessionState
+}
+
+/** Account info from the netdisk (`/rest/2.0/xpan/nas` + quota). */
+data class AccountUi(
+    val name: String = "",
+    val vipType: Int = 0,
+    val used: Long = 0,
+    val total: Long = 0,
+) {
+    val isMember: Boolean get() = vipType > 0
+}
+
+/** One configured SAF folder plus its last run status. */
+data class FolderUi(
+    val entry: FolderEntry,
+    val status: BackupStatus?,
+)
+
+/** One MediaStore album plus selection and last-sync status. */
+data class AlbumUi(
+    val album: MediaAlbum,
+    val selected: Boolean,
+    val status: BackupStatus?,
+)
+
+/** QR / cookie sign-in UI state. */
+data class SignInUi(
+    val qr: ImageBitmap? = null,
+    val phase: QrPhase = QrPhase.Idle,
+    val loading: Boolean = false,
+    val error: String? = null,
+)
+
+enum class QrPhase { Idle, Waiting, Scanned, Confirmed, Expired, Error }
+
+/**
+ * The single immutable state of the app, exposed as `StateFlow<AppUiState>`.
+ * Every field is a data class, so Compose can skip unchanged subtrees.
+ */
+data class AppUiState(
+    val booting: Boolean = true,
+    val session: SessionState = SessionState.Loading,
+    val settings: AppSettings = AppSettings(),
+    val account: AccountUi? = null,
+    val accountLoading: Boolean = false,
+    val folders: List<FolderUi> = emptyList(),
+    val foldersRefreshing: Boolean = false,
+    val albums: List<AlbumUi> = emptyList(),
+    val albumsLoading: Boolean = false,
+    val albumPermission: Boolean = false,
+    val passphraseSet: Boolean = false,
+    val folderRun: RunSnapshot? = null,
+    val albumRun: RunSnapshot? = null,
+    val lastFolderResult: LastResult? = null,
+    val lastAlbumResult: LastResult? = null,
+    val history: List<TransferRecord> = emptyList(),
+    val signIn: SignInUi = SignInUi(),
+) {
+    val running: Boolean get() = folderRun != null || albumRun != null
+
+    val selectedAlbumCount: Int get() = albums.count { it.selected }
+
+    val hasSession: Boolean get() = session is SessionState.SignedIn
+}
+
+/** Preview/sample data so screens can be previewed without a ViewModel. */
+object AppUiSamples {
+
+    val folder = FolderEntry(uri = "content://tree/sample", name = "相机")
+    val album = MediaAlbum(
+        bucketId = 1L,
+        displayName = "相机",
+        imageCount = 128,
+        videoCount = 3,
+        sizeBytes = 1_500_000_000L,
+        coverUri = null,
+        lastModified = 0L,
+    )
+
+    val signedIn = AppUiState(
+        booting = false,
+        session = SessionState.SignedIn(AccountUi("测试账号", vipType = 1, used = 12_000_000_000, total = 2_000_000_000_000)),
+        settings = AppSettings(folders = listOf(folder)),
+        folders = listOf(FolderUi(folder, BackupStatus(lastBackupAt = 0))),
+        albums = listOf(AlbumUi(album, selected = true, status = null)),
+        albumPermission = true,
+        passphraseSet = true,
+        history = listOf(
+            TransferRecord(
+                id = "1",
+                kind = "folder",
+                label = "文件夹备份",
+                finishedAt = 0,
+                uploaded = 12,
+                skipped = 3,
+                failed = 0,
+                bytes = 30_000_000,
+            ),
+        ),
+    )
+
+    val signedOut = AppUiState(booting = false, session = SessionState.SignedOut)
+}
