+package com.pengstem.baidunetgo.core
+
+import java.util.Locale
+
+/**
+ * Placeholder core API so this module has something to compile and test.
+ *
+ * Later agents can replace/extend this with the Baidu Netdisk client, the
+ * backup engine and the OpenPGP helpers. Keep this module free of Android
+ * imports: everything here must run on a plain JVM.
+ */
+object ByteSize {
+
+    private val UNITS = arrayOf("B", "KB", "MB", "GB", "TB", "PB")
+
+    /** Formats [bytes] as a human readable size, e.g. `1.5 MB`. */
+    fun format(bytes: Long): String {
+        require(bytes >= 0) { "bytes must not be negative: $bytes" }
+        if (bytes < 1024) return "$bytes B"
+        var value = bytes.toDouble()
+        var unitIndex = 0
+        while (value >= 1024.0 && unitIndex < UNITS.lastIndex) {
+            value /= 1024.0
+            unitIndex++
+        }
+        return String.format(Locale.ROOT, "%.1f %s", value, UNITS[unitIndex])
+    }
+}
+
+/** Shared constants for the Android side of BaiduNetGo. */
+object CoreConstants {
+    /** Version of the desktop app this scaffold was split from. */
+    const val CORE_VERSION: String = "0.1.0"
+
+    /** Baidu Netdisk web API host used by the client layer later. */
+    const val BAIDU_PAN_HOST: String = "https://pan.baidu.com"
+}
