diff --git a/android/settings.gradle.kts b/android/settings.gradle.kts
new file mode 100644
index 0000000..bba358b
--- /dev/null
+++ b/android/settings.gradle.kts
@@ -0,0 +1,36 @@
+// Gradle settings for the BaiduNetGo Android side.
+// The desktop app in the repository root is a Go application; this directory is
+// the standalone Android project (Gradle needs its own settings file scope).
+
+// The shared toolchain Gradle home on this machine ships an init script that
+// forces `--offline` for another project. The Android scaffold needs repository
+// access for plugins/dependencies that are not cached yet, so opt back in here.
+// It is a no-op on machines without that init script.
+gradle.startParameter.isOffline = false
+
+pluginManagement {
+    repositories {
+        google {
+            content {
+                includeGroupByRegex("com\\.android.*")
+                includeGroupByRegex("com\\.google.*")
+                includeGroupByRegex("androidx.*")
+            }
+        }
+        mavenCentral()
+        gradlePluginPortal()
+    }
+}
+
+dependencyResolutionManagement {
+    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
+    repositories {
+        google()
+        mavenCentral()
+    }
+}
+
+rootProject.name = "BaiduNetGo"
+
+include(":app")
+include(":core")
\ No newline at end of file
diff --git a/docs/ANDROID.md b/docs/ANDROID.md
new file mode 100644
index 0000000..8000a6a
--- /dev/null
+++ b/docs/ANDROID.md
@@ -0,0 +1,58 @@
+# Android（APK）构建
+
+仓库里除了桌面的 Go/MyGo 应用，还带一个 Android 客户端，源码在 `android/`，用
+Gradle + Kotlin + Jetpack Compose（Material 3）构建，产出可安装的 APK。它和桌面端
+**不共享代码**（桌面是 Go，手机是 Kotlin），但共享同一套网盘协议、备份目录约定和
+`.gpg` 加密格式——两边备份到同一个网盘目录，文件用同一个 `gpg -d` 就能解开。
+
+- 功能、模块划分、协议细节：`android/README.md`
+- `:core`（网盘客户端 / OpenPGP / 备份引擎）与 `:app`（界面）之间的接口约定：`android/docs/CORE-API.md`
+- 备份语义、加密格式、状态文件：`docs/BACKUP.md`
+
+## 构建
+
+需要 **JDK 21**、Android SDK（platform 37 与 build-tools 36+）、可写的 Gradle 目录。
+`compileSdk 37`、`minSdk 26`、`targetSdk 37`、字节码目标 17。
+
+```bash
+export ANDROID_HOME=/path/to/android-sdk
+export ANDROID_SDK_ROOT=$ANDROID_HOME
+export JAVA_HOME=/path/to/jdk-21
+cd android
+./gradlew :app:assembleDebug          # 产出 app/build/outputs/apk/debug/app-debug.apk
+./gradlew :core:test :app:testDebugUnitTest :app:lint
+```
+
+装到手机：`adb install -r android/app/build/outputs/apk/debug/app-debug.apk`。
+
+版本号与桌面同源：`mygo.json` 的 `version`（当前 `0.8.3`）对应
+`android/app/build.gradle.kts` 的 `versionName`，`versionCode` 用「主版本×10000 +
+次版本×100 + 修订」（`0.8.3` → `803`）。发版前改这两处。
+
+## 测试边界
+
+`:core:test` 是真的协议测试：它拉起仓库里的 Go 假网盘 `cmd/fakepand`（`go build
+./cmd/fakepand` 后读它打印的 `url=…`，或用 `FAKEPAN_URL` 指向已运行的实例），用同一组
+接口验证列目录、建目录、分片上传（precreate → superfile2 → create）、删除；OpenPGP
+部分用本机的真 `gpg` 双向验证（参数、解密结果）。`:app` 的界面部分在没有模拟器的机器上
+只能做到编译 + lint + JVM 单元测试；`android/screenshots/` 里放的是 Robolectric 无头
+渲染出的界面图（能渲染时）。
+
+## 签名
+
+`android/keystore/dev.jks` 是**开发用**密钥（口令 `baidunetgo-dev`，仓库里公开），只为
+让任何人 `assembleDebug`；正式发布必须换成自己的 release keystore（CI secret 或环境变量），
+不要用它上架。
+
+## 后续可以接的工作
+
+- **GitHub Actions**：在现有的 release 流程（`.github/workflows/release.yml`）里加一个
+  Android job：`setup-java@v4`（JDK 21）+ `android-actions/setup-android`，`./gradlew
+  :app:assembleRelease` 并把 APK 作为 release 附件上传，签名密钥从仓库 secret 读取
+  （`keystore.properties` + `KEYSTORE_BASE64`/`KEY_ALIAS`/`KEY_PASSWORD` 注入）。
+- **更新通道**：桌面端的 `internal/updates` 目前按 `GOOS-GOARCH` 分发桌面安装包，不含
+  APK；Android 端适合直接走 Google Play 或 F-Droid 的自动更新，或在同一个 feed JSON 里
+  加一个 `"android"` 键指向 APK，由 App 内做一次「下载并交给系统安装器」的检查
+  （需要 `REQUEST_INSTALL_PACKAGES`），接口改动很小。
+- **v1 不含**：手机端浏览 / 下载 / 预览网盘文件、从云端恢复备份到手机（目前恢复用电脑上的
+  `gpg -d` 与网盘客户端下载）。
\ No newline at end of file
