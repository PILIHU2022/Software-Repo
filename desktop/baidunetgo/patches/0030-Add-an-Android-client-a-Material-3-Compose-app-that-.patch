+package com.pengstem.baidunetgo.core.crypto
+
+import org.bouncycastle.bcpg.HashAlgorithmTags
+import org.bouncycastle.bcpg.SymmetricKeyAlgorithmTags
+import org.bouncycastle.openpgp.bc.BcPGPObjectFactory
+import org.bouncycastle.openpgp.PGPCompressedData
+import org.bouncycastle.openpgp.PGPEncryptedDataGenerator
+import org.bouncycastle.openpgp.PGPEncryptedDataList
+import org.bouncycastle.openpgp.PGPLiteralData
+import org.bouncycastle.openpgp.PGPLiteralDataGenerator
+import org.bouncycastle.openpgp.PGPPBEEncryptedData
+import org.bouncycastle.openpgp.PGPUtil
+import org.bouncycastle.openpgp.operator.bc.BcPBEDataDecryptorFactory
+import org.bouncycastle.openpgp.operator.bc.BcPBEKeyEncryptionMethodGenerator
+import org.bouncycastle.openpgp.operator.bc.BcPGPDataEncryptorBuilder
+import org.bouncycastle.openpgp.operator.bc.BcPGPDigestCalculatorProvider
+import java.io.File
+import java.io.InputStream
+import java.io.OutputStream
+import java.security.SecureRandom
+
+/** A PGP failure with a user-facing (Chinese) message. */
+class PgpException(message: String, cause: Throwable? = null) : Exception(message, cause)
+
+/**
+ * OpenPGP symmetric (passphrase-only) encryption that matches the desktop app's
+ * Go `internal/pgp` and is readable by `gpg --decrypt`.
+ *
+ * The output is a binary (not armored) OpenPGP message: an iterated+salted
+ * SHA-256 S2K with 4 MiB of work, its key wrapping an AES-256 session, no
+ * compression, an integrity-protected SEIPD v1 (MDC) packet, and a binary
+ * literal-data packet whose file-name hint is empty. Both directions stream
+ * through one buffer, so a file is never held in memory, and the crypto code
+ * writes no temporary files.
+ */
+object Pgp {
+
+    /** Appended to the name of an encrypted file, e.g. `photo.jpg.gpg`. */
+    const val Suffix: String = ".gpg"
+
+    /**
+     * The S2K iteration count, equal to the Go side's `1 << 22`. It is the
+     * encoded count byte `0xC0`, which decodes to `16 << 18` = 4194304 octets —
+     * exactly what `gpg --s2k-count 4194304` emits.
+     */
+    private const val S2KEncodedCount: Int = 0xC0
+
+    private const val BufferSize: Int = 256 shl 10
+
+    private const val ErrWrongPassphrase = "解密失败：口令不正确或文件已损坏（完整性校验失败）"
+
+    /**
+     * Encrypts [src] into [dst] with [passphrase]. [dst] is flushed but not
+     * closed; [src] is not closed either.
+     */
+    fun encrypt(dst: OutputStream, src: InputStream, passphrase: CharArray) {
+        val digest = try {
+            BcPGPDigestCalculatorProvider().get(HashAlgorithmTags.SHA256)
+        } catch (e: Exception) {
+            throw PgpException("加密失败：无法初始化摘要算法", e)
+        }
+        val method = BcPBEKeyEncryptionMethodGenerator(passphrase, digest, S2KEncodedCount)
+            .setSecureRandom(SecureRandom())
+        val builder = BcPGPDataEncryptorBuilder(SymmetricKeyAlgorithmTags.AES_256)
+            .setWithIntegrityPacket(true)
+            .setSecureRandom(SecureRandom())
+        val generator = PGPEncryptedDataGenerator(builder)
+        // With a single passphrase method the netdisk-compatible (and gpg's own)
+        // form is a v4 SKESK that carries *no* encrypted session key: the S2K
