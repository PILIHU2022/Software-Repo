+package com.pengstem.baidunetgo.data
+
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharedFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asSharedFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Which kind of backup a run/inspection belongs to. */
+enum class RunKind { Folder, Album }
+
+/**
+ * Immutable progress snapshot of a running backup, safe to expose through
+ * [StateFlow] and render from Compose.
+ */
+data class RunSnapshot(
+    val kind: RunKind,
+    /** Folder tree name or album name currently being processed. */
+    val label: String,
+    /** The file currently being uploaded. */
+    val file: String,
+    /** Progress of the current file, 0..1. */
+    val percent: Float,
+    val done: Long,
+    val total: Long,
+    val uploaded: Int,
+    val skipped: Int,
+    val failed: Int,
+    /** Upload speed in bytes/s for the current file, 0 when unknown. */
+    val bytesPerSecond: Long,
+    /** 1-based index of the folder tree / album being processed. */
+    val stepIndex: Int,
+    val stepCount: Int,
+)
+
+/** Emitted once when a run ends (from the service or the ViewModel). */
+data class RunFinished(
+    val kind: RunKind,
+    val cancelled: Boolean,
+    val record: TransferRecord?,
+    /** User-facing failure message when the run could not start/finish. */
+    val error: String? = null,
+)
+
+/**
+ * Single in-process event bus between the foreground [com.pengstem.baidunetgo.service.BackupService]
+ * (which owns user-initiated runs) and the UI process' ViewModel.
+ *
+ * The ViewModel persists through configuration changes, so a run started from
+ * the UI keeps reporting progress after a rotation, and after the activity is
+ * recreated while the service still works.
+ */
+object BackupBus {
+
+    private val _folder = MutableStateFlow<RunSnapshot?>(null)
+    val folder: StateFlow<RunSnapshot?> = _folder.asStateFlow()
+
+    private val _album = MutableStateFlow<RunSnapshot?>(null)
+    val album: StateFlow<RunSnapshot?> = _album.asStateFlow()
+
+    private val _events = MutableSharedFlow<RunFinished>(extraBufferCapacity = 8)
+    val events: SharedFlow<RunFinished> = _events.asSharedFlow()
+
+    /** Publishes [snapshot] for its own kind. */
+    fun update(snapshot: RunSnapshot) {
+        when (snapshot.kind) {
+            RunKind.Folder -> _folder.value = snapshot
+            RunKind.Album -> _album.value = snapshot
+        }
+    }
+
+    fun clear(kind: RunKind) {
+        when (kind) {
+            RunKind.Folder -> _folder.value = null
+            RunKind.Album -> _album.value = null
+        }
+    }
+
+    fun finish(event: RunFinished) {
+        clear(event.kind)
+        _events.tryEmit(event)
+    }
+
+    fun isRunning(kind: RunKind): Boolean = active(kind) != null
+
+    fun active(kind: RunKind): RunSnapshot? = when (kind) {
+        RunKind.Folder -> _folder.value
+        RunKind.Album -> _album.value
+    }
+}
