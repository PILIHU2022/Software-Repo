+/**
+ * Passphrase dialog (≥ 8 characters, confirmation field, masked by default).
+ * The [CharArray] passed to [onSave] is the only copy the caller sees.
+ */
+@Composable
+fun PassphraseDialog(
+    title: String,
+    onSave: (CharArray) -> Unit,
+    onDismiss: () -> Unit,
+    warning: String? = null,
+) {
+    var password by rememberSaveable { mutableStateOf("") }
+    var confirmation by rememberSaveable { mutableStateOf("") }
+    var visible by rememberSaveable { mutableStateOf(false) }
+    val tooShort = password.isNotEmpty() && password.length < MIN_PASSPHRASE
+    val mismatch = confirmation.isNotEmpty() && password != confirmation
+    val valid = password.length >= MIN_PASSPHRASE && password == confirmation
+    val transformation = if (visible) {
+        VisualTransformation.None
+    } else {
+        PasswordVisualTransformation()
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(title) },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                Text(
+                    text = stringResource(R.string.passphrase_desc),
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+                OutlinedTextField(
+                    value = password,
+                    onValueChange = { password = it },
+                    singleLine = true,
+                    label = { Text(stringResource(R.string.passphrase_label)) },
+                    visualTransformation = transformation,
+                    isError = tooShort,
+                    supportingText = if (tooShort) {
+                        { Text(stringResource(R.string.passphrase_too_short)) }
+                    } else {
+                        null
+                    },
+                    trailingIcon = {
+                        IconButton(onClick = { visible = !visible }) {
+                            Icon(
+                                imageVector = if (visible) Icons.Filled.VisibilityOff else Icons.Filled.Visibility,
+                                contentDescription = stringResource(
+                                    if (visible) R.string.passphrase_hide else R.string.passphrase_show,
+                                ),
+                            )
+                        }
+                    },
+                )
+                OutlinedTextField(
+                    value = confirmation,
+                    onValueChange = { confirmation = it },
+                    singleLine = true,
+                    label = { Text(stringResource(R.string.passphrase_confirm)) },
+                    visualTransformation = transformation,
+                    isError = mismatch,
+                    supportingText = if (mismatch) {
+                        { Text(stringResource(R.string.passphrase_mismatch)) }
+                    } else {
+                        null
+                    },
+                )
+                if (warning != null) {
+                    Text(
+                        text = warning,
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.error,
+                    )
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(
+                enabled = valid,
+                onClick = {
+                    val chars = password.toCharArray()
+                    password = ""
+                    confirmation = ""
+                    onSave(chars)
+                    onDismiss()
+                },
+            ) {
+                Text(stringResource(R.string.action_save))
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) { Text(stringResource(R.string.action_cancel)) }
+        },
+    )
+}
