+        src.inputStream().buffered(BufferSize).use { input ->
+            decrypt(OutputStream.nullOutputStream(), input, passphrase)
+        }
+        // Pass 2: decrypt into the destination.
+        val counter = CountingOutputStream(dst.outputStream().buffered(BufferSize))
+        try {
+            src.inputStream().buffered(BufferSize).use { input ->
