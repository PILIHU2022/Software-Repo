From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DeepSeek Harness <noreply@deepseek.com>
Date: Sat, 14 Nov 2026 14:02:57 +0800
Subject: [PATCH] Trust the duplicate finder's cache only when the netdisk's
 generation was read for the account, and stop keeping results a changed
 delete could not verify

---
 app/app.go        | 15 +++++----
 app/dedup.go      | 82 +++++++++++++++++++++++++++++++++++------------
 app/dedup_test.go | 22 +++++++++++++
 3 files changed, 91 insertions(+), 28 deletions(-)

diff --git a/app/app.go b/app/app.go
index 9242559..ec8d4f5 100644
--- a/app/app.go
+++ b/app/app.go
@@ -79,13 +79,14 @@ type App struct {
 	// (dedup.go). It is kept with that cache, so a restart knows whether
 	// the results still describe the netdisk; netdiskGenUID is the account
 	// it counts for.
-	netdiskGen    uint64
-	netdiskGenUID uint64
-	frame         uint64 // counts views, to notice a page coming back to
-	copied        string // the toast after copying
-	query         string
-	copyText      string // to put on the clipboard in the next frame
-	copyPNG       []byte // the same, for a picture
+	netdiskGen      uint64
+	netdiskGenUID   uint64
+	netdiskGenKnown bool   // the count was read for netdiskGenUID
+	frame           uint64 // counts views, to notice a page coming back to
+	copied          string // the toast after copying
+	query           string
+	copyText        string // to put on the clipboard in the next frame
+	copyPNG         []byte // the same, for a picture
 	// clipRead reads the clipboard on an explicit command (Cmd-V or the
 	// toolbar's link button). Tests swap it to count the reads.
 	clipRead func(*ui.Context) string
diff --git a/app/dedup.go b/app/dedup.go
index c8b4f84..eeb4a04 100644
--- a/app/dedup.go
+++ b/app/dedup.go
@@ -152,11 +152,12 @@ func (a *App) startDedupScan(dir string) {
 				d.loaded, d.cached = true, false
 				d.scannedAt = time.Now()
 				d.groups, d.skipped = dedup.Groups(res.Files)
-				d.resultsGen = a.netdiskGen
 				// A change under the scan may have moved or deleted what
 				// it read: the results are kept but not trusted, and the
 				// cache keeps nothing, as it would say they are the
-				// netdisk's.
+				// netdisk's. resultsGen stays at the generation the scan
+				// began at, so coming back to the page scans again.
+				d.resultsGen = gen
 				d.stale = a.netdiskGen != gen
 				d.flatten()
 				d.chooseDefaults()
@@ -306,6 +307,9 @@ func readDedupCache(p string) (dedupCache, bool) {
 	if p == "" {
 		return dedupCache{}, false
 	}
+	if info, err := os.Stat(p); err != nil || info.Size() > dedupCacheMax {
+		return dedupCache{}, false
+	}
 	data, err := os.ReadFile(p)
 	if err != nil || len(data) > dedupCacheMax {
 		return dedupCache{}, false
@@ -320,8 +324,15 @@ func readDedupCache(p string) (dedupCache, bool) {
 // writeFileAtomic writes data to p so that a crash leaves either the old
 // file or the new one, never half of either.
 func writeFileAtomic(p string, data []byte) {
-	tmp := p + ".tmp"
-	if os.WriteFile(tmp, data, 0o600) != nil {
+	f, err := os.CreateTemp(filepath.Dir(p), filepath.Base(p)+".tmp-*")
+	if err != nil {
+		return
+	}
+	tmp := f.Name()
+	_, werr := f.Write(data)
+	cerr := f.Close()
+	if werr != nil || cerr != nil {
+		os.Remove(tmp)
 		return
 	}
 	if os.Rename(tmp, p) != nil {
@@ -338,6 +349,7 @@ func (a *App) saveDedupCache() {
 		return
 	}
 	c := a.dedupCacheNow(a.sess.user.UID)
+	a.writeNetdiskGen()
 	go func() {
 		data, err := json.Marshal(c)
 		if err != nil {
@@ -380,9 +392,12 @@ type dedupGen struct {
 	Gen     uint64 `json:"gen"`
 }
 
-// loadNetdiskGen restores the generation counted for the account uid.
+// loadNetdiskGen restores the generation counted for the account uid. A
+// generation that cannot be read is unknown, not zero: cached results of
+// this account at generation 0 must not pass for the netdisk's when a
+// count of another account, or none, was kept.
 func (a *App) loadNetdiskGen(uid uint64) {
-	a.netdiskGen, a.netdiskGenUID = 0, uid
+	a.netdiskGen, a.netdiskGenUID, a.netdiskGenKnown = 0, uid, false
 	p := a.dedupGenPath()
 	if p == "" {
 		return
@@ -393,17 +408,15 @@ func (a *App) loadNetdiskGen(uid uint64) {
 	}
 	var g dedupGen
 	if json.Unmarshal(data, &g) == nil && g.Version == dedupCacheVersion && g.UID == uid {
-		a.netdiskGen = g.Gen
+		a.netdiskGen, a.netdiskGenKnown = g.Gen, true
 	}
 }
 
-// netdiskChanged records that the user changed the netdisk (deleted,
-// moved, copied, renamed, made a folder, restored or emptied the recycle
-// bin, uploaded, or had an offline download finish), so the results of the
-// last scan no longer describe it. The count is written at once: a restart
-// must not trust the cache again. It runs on the UI thread.
-func (a *App) netdiskChanged() {
-	a.netdiskGen++
+// writeNetdiskGen keeps the count for the account, so that a restart knows
+// which generation its cache describes. It runs on the UI thread and writes
+// a few dozen bytes.
+func (a *App) writeNetdiskGen() {
+	a.netdiskGenKnown = true
 	p := a.dedupGenPath()
 	if p == "" {
 		return
@@ -415,12 +428,22 @@ func (a *App) netdiskChanged() {
 	writeFileAtomic(p, data)
 }
 
+// netdiskChanged records that the user changed the netdisk (deleted,
+// moved, copied, renamed, made a folder, restored or emptied the recycle
+// bin, uploaded, or had an offline download finish), so the results of the
+// last scan no longer describe it. The count is written at once: a restart
+// must not trust the cache again. It runs on the UI thread.
+func (a *App) netdiskChanged() {
+	a.netdiskGen++
+	a.writeNetdiskGen()
+}
+
 // dedupCacheFresh reports whether the cached results still describe the
 // netdisk: the cache is this app's layout, of the account signed in, of the
 // generation the netdisk is at, and not old enough for another client's
 // changes to be expected.
 func (a *App) dedupCacheFresh(c dedupCache, uid uint64) bool {
-	if a.sess == nil || c.UID != uid || c.Gen != a.netdiskGen || c.Version != dedupCacheVersion {
+	if a.sess == nil || !a.netdiskGenKnown || c.UID != uid || c.Gen != a.netdiskGen || c.Version != dedupCacheVersion {
 		return false
 	}
 	if c.ScannedAt.IsZero() {
@@ -457,7 +480,7 @@ func (a *App) enterDedup() {
 			}
 			// No results the netdisk still has: scan the folder this page
 			// scanned, else the one the cache scanned, else all of it.
-			if root == "" && ok {
+			if root == "" && ok && c.UID == uid {
 				root = c.Root
 			}
 			if root == "" {
@@ -639,7 +662,7 @@ func (a *App) deleteDedup() {
 	for path, on := range d.chosen {
 		chosen[path] = on
 	}
-	id := d.scanID
+	id, wasStale := d.scanID, d.stale
 	d.busy, d.actErr = true, ""
 	go func() {
 		safe, changed := dedupStillThere(context.Background(), s.client, groups, chosen)
@@ -657,11 +680,19 @@ func (a *App) deleteDedup() {
 					a.signOut()
 					return
 				}
+				// The call may have removed some of the files before it
+				// failed: the results are no longer known to hold.
+				a.netdiskChanged()
+				d.stale = true
 				d.actErr = err.Error()
 				a.toast(err.Error(), "error")
 				return
 			}
 			if len(safe) == 0 {
+				// Files changed under the scan, so the results do not
+				// describe the netdisk: read it again next time.
+				a.netdiskChanged()
+				d.stale = true
 				d.actErr = "文件已变化，请重新扫描"
 				a.toast("这些文件已变化，请重新扫描后再试", "error")
 				return
@@ -679,15 +710,24 @@ func (a *App) deleteDedup() {
 			// only files that left, and a group of what is left is what
 			// Groups would find in it again.
 			d.groups = dedup.Without(d.groups, gone)
+			d.scannedFiles = max(0, d.scannedFiles-len(safe))
 			d.flatten()
 			d.chooseDefaults()
 			d.scrollTop = true
 			a.recycleDirty = true
-			// What is left is the netdisk's: the page shows it at once
-			// when it comes back to, without scanning again.
 			a.netdiskChanged()
-			d.resultsGen = a.netdiskGen
-			a.saveDedupCache()
+			if changed == 0 && !wasStale {
+				// What is left is the netdisk's: the page shows it at once
+				// when it comes back to, without scanning again.
+				d.resultsGen = a.netdiskGen
+				d.stale = false
+				a.saveDedupCache()
+			} else {
+				// Some copies were left alone because they changed: the
+				// groups still name files the netdisk no longer holds as
+				// scanned, so they are not kept as its results.
+				d.stale = true
+			}
 			for dir := range dirs {
 				a.reload(dir)
 			}
diff --git a/app/dedup_test.go b/app/dedup_test.go
index 2f6b3cc..92c8e44 100644
--- a/app/dedup_test.go
+++ b/app/dedup_test.go
@@ -218,6 +218,9 @@ func TestDedupSkipsChangedFiles(t *testing.T) {
 	if !tt.HasText("已变化") {
 		t.Errorf("no word of the change: %q", tt.Texts())
 	}
+	if !d.stale {
+		t.Error("the changed results were left as the netdisk's")
+	}
 }
 
 // TestDedupSignOutClears drops a scan and its results when the account
@@ -629,3 +632,22 @@ func TestDedupRowMenu(t *testing.T) {
 		t.Errorf("showing the file went to %q, want %q", got, path.Dir(f.Path))
 	}
 }
+
+// TestDedupCacheNeedsKnownGen: results at generation 0 are not trusted
+// when the count for the account could not be read, as it could be another
+// account's count that was kept.
+func TestDedupCacheNeedsKnownGen(t *testing.T) {
+	a := &App{sess: &session{user: &baidu.User{UID: 1}}}
+	c := dedupCache{Version: dedupCacheVersion, UID: 1, Gen: 0, ScannedAt: time.Now()}
+	if a.dedupCacheFresh(c, 1) {
+		t.Fatal("results were trusted without a known generation")
+	}
+	a.netdiskGenKnown = true
+	if !a.dedupCacheFresh(c, 1) {
+		t.Fatal("results at the known generation were refused")
+	}
+	a.netdiskGen = 1
+	if a.dedupCacheFresh(c, 1) {
+		t.Fatal("results of another generation were trusted")
+	}
+}
