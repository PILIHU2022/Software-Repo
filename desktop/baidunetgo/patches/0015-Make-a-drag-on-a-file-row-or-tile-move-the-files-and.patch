+// TestDragMoveMulti drags one of two chosen files: both move.
+func TestDragMoveMulti(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	r1i, r2i, fi := l.indexNamed("README.md"), l.indexNamed("安装包.dmg"), l.indexNamed("空文件夹")
+	if r1i < 0 || r2i < 0 || fi < 0 {
+		t.Fatalf("rows missing: %d %d %d", r1i, r2i, fi)
+	}
+	r1, r2 := l.rowRects[l.files[r1i].FsID], l.rowRects[l.files[r2i].FsID]
+	fr := l.rowRects[l.files[fi].FsID]
+	tt.ClickAt(r1.X+20, r1.Y+r1.H/2)
+	tt.Frame()
+	tt.ClickAtWith(ui.Cmd, r2.X+20, r2.Y+r2.H/2)
+	tt.Frame()
+	if l.sel.Len() != 2 {
+		t.Fatalf("chose %d, want two files", l.sel.Len())
+	}
+	// Let the double-click counter forget the Cmd-click, so the drag's press
+	// is a drag and not a double click that opens the file.
+	tt.Advance(time.Second)
+	dragFromTo(tt, rowCenter(r2), rowCenter(fr), 14)
+	if !l.moveDrag || len(l.moveFiles) != 2 {
+		t.Fatalf("dragging one of two: moveDrag=%v, files=%d", l.moveDrag, len(l.moveFiles))
+	}
+	tt.Release(rowCenter(fr).X, rowCenter(fr).Y)
+	tt.Frame()
+	waitUntil(t, tt, "both moved", func() bool {
+		return srv.Exists("/空文件夹/README.md") && srv.Exists("/空文件夹/安装包.dmg")
+	})
+	if srv.Exists("/README.md") || srv.Exists("/安装包.dmg") {
+		t.Errorf("an old path still exists")
+	}
+}
+
+// TestDragMoveBlankCancels lets a dragged file go over blank space: nothing
+// moves and the choice stays.
+func TestDragMoveBlankCancels(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	ri := l.indexNamed("README.md")
+	from := l.rowRects[l.files[ri].FsID]
+	to := ui.Point{X: from.X + 20, Y: l.dragArea.Y - 12} // the list's header
+	dragFromTo(tt, rowCenter(from), to, 10)
+	if !l.moveDrag {
+		t.Fatalf("no move drag")
+	}
+	tt.Release(to.X, to.Y)
+	tt.Frame()
+	if l.moveDrag {
+		t.Errorf("moveDrag stayed after release")
+	}
+	if !srv.Exists("/README.md") {
