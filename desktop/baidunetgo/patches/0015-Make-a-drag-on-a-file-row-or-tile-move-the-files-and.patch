+// TestDragMoveCrumb drops a file on the "我的文件" breadcrumb: it moves to
+// the folder above.
+func TestDragMoveCrumb(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	a.router.Push(filesRoute("/照片"))
+	waitFor(t, tt, "IMG_2310.jpg")
+	tt.Advance(time.Second)
+	l := a.listingFor("/照片")
+	ri := l.indexNamed("IMG_2310.jpg")
+	if ri < 0 {
+		t.Fatalf("no IMG_2310.jpg row")
+	}
+	from := l.rowRects[l.files[ri].FsID]
+	var root ui.Rect
+	for _, cr := range l.crumbRects {
+		if cr.path == "/" {
+			root = cr.rect
+		}
+	}
+	if root.W <= 0 {
+		t.Fatalf("no root breadcrumb: %+v", l.crumbRects)
+	}
+	to := ui.Point{X: root.X + root.W/2, Y: root.Y + root.H/2}
