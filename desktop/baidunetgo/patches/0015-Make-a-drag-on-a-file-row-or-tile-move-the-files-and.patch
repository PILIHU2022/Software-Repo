+// TestDragMoveConflict drops a file where a same name is: the conflict
+// dialog opens, and keeping both gives the arriving one a free name.
+func TestDragMoveConflict(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	srv.Add(fakepan.Node{Path: "/目标/README.md", Category: 4, Data: []byte("旧说明")})
+	a.reload("/")
+	waitFor(t, tt, "目标")
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	ri, ti := l.indexNamed("README.md"), l.indexNamed("目标")
+	if ri < 0 || ti < 0 {
+		t.Fatalf("rows missing: README %d, 目标 %d", ri, ti)
+	}
+	from, to := l.rowRects[l.files[ri].FsID], l.rowRects[l.files[ti].FsID]
+	dragFromTo(tt, rowCenter(from), rowCenter(to), 14)
+	tt.Release(rowCenter(to).X, rowCenter(to).Y)
+	waitUntil(t, tt, "the conflict question", func() bool { return a.dlg.open && a.dlg.kind == dlgConflict })
+	tt.Advance(200 * time.Millisecond)
+	if err := tt.Click("保留两者"); err != nil {
+		t.Fatalf("keep both: %v", err)
+	}
+	waitUntil(t, tt, "the renamed copy", func() bool { return srv.Exists("/目标/README (1).md") })
+	if !srv.Exists("/目标/README.md") {
+		t.Errorf("the original in 目标 went away")
+	}
+	if srv.Exists("/README.md") {
+		t.Errorf("the moved file stayed at the root")
+	}
+}
