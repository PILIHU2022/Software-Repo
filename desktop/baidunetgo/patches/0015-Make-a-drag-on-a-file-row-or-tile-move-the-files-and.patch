+	}
+	fromSpot, ok1 := l.grid.spots[l.files[fi].FsID]
+	toSpot, ok2 := l.grid.spots[l.files[di].FsID]
+	if !ok1 || !ok2 || fromSpot.rect.W <= 0 || toSpot.rect.W <= 0 {
