+	waitUntil(t, tt, "the photo moved", func() bool { return srv.Exists("/照片/京都/IMG_2310.jpg") })
+	if srv.Exists("/照片/IMG_2310.jpg") {
+		t.Errorf("the photo stayed in 照片")
+	}
+}
