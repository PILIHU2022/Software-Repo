+// TestDragMoveRejects says a folder cannot be dropped on itself, nor into
+// its own subfolder, and neither moves anything.
+func TestDragMoveRejects(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	// Drag 空文件夹 onto its own row and let go: a toast, no move.
+	ri := l.indexNamed("空文件夹")
+	from := l.rowRects[l.files[ri].FsID]
+	dragFromTo(tt, rowCenter(from), ui.Point{X: from.X + 24, Y: from.Y + 4}, 8)
+	tt.Release(from.X+24, from.Y+4)
+	tt.Frame()
+	if !srv.Exists("/空文件夹") {
+		t.Fatalf("the folder vanished")
+	}
+	if srv.Exists("/空文件夹/空文件夹") {
+		t.Errorf("a folder was moved into itself")
+	}
+	if !shownToast(a, tt, "不能把") {
+		t.Errorf("no toast refusing the drop on itself; texts %q", tt.Texts())
+	}
+	// A subfolder target is refused directly.
+	ci := l.indexNamed("代码")
+	if ci < 0 {
+		t.Fatalf("no 代码 folder")
+	}
+	a.applyMove(l, []baidu.File{l.files[ci]}, "/代码/备份")
+	if !shownToast(a, tt, "不能把") {
+		t.Errorf("no toast refusing the drop into its subfolder")
+	}
+	if !srv.Exists("/代码/备份") {
+		t.Errorf("the subfolder vanished")
+	}
+}
