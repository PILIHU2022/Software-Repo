+	}
+	if l.moveTarget != "/空文件夹" {
+		t.Errorf("hovering 空文件夹: target %q", l.moveTarget)
+	}
+	save(t, tt, "drag-ghost")
+	tt.Release(rowCenter(to).X, rowCenter(to).Y)
+	tt.Frame()
+	if l.moveDrag {
+		t.Errorf("moveDrag stayed after release")
+	}
+	waitUntil(t, tt, "the file moved", func() bool { return srv.Exists("/空文件夹/README.md") })
+	if srv.Exists("/README.md") {
+		t.Errorf("the old path still exists")
+	}
+	waitUntil(t, tt, "the change counted", func() bool { return a.netdiskGen > gen })
+}
