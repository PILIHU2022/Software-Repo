+// dragFromTo presses at a, drags the pointer to b in steps, and leaves it
+// there, without releasing: the caller releases at b.
+func dragFromTo(tt *ui.Tester, a, b ui.Point, steps int) {
+	tt.Press(a.X, a.Y)
+	tt.Frame()
+	for i := 1; i <= steps; i++ {
+		f := float32(i) / float32(steps)
+		tt.Move(lerp(a.X, b.X, f), lerp(a.Y, b.Y, f))
+		tt.Frame()
+	}
+}
+
+// rowCenter is a point inside a row or tile rect, away from its edge.
+func rowCenter(r ui.Rect) ui.Point { return ui.Point{X: r.X + 20, Y: r.Y + r.H/2} }
+
+// shownToast reports whether a toast holding sub appeared.
+func shownToast(a *App, tt *ui.Tester, sub string) bool {
+	for _, t := range a.pendingToasts {
+		if strings.Contains(t.Title, sub) {
+			return true
+		}
+	}
+	return tt.HasText(sub)
+}
