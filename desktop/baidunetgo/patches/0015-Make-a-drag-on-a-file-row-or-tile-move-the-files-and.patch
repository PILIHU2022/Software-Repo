+// TestDragMoveGrid drags a photo tile onto a folder tile: it moves into the
+// folder.
+func TestDragMoveGrid(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	a.gridView = true
+	a.router.Push(filesRoute("/照片"))
+	waitFor(t, tt, "IMG_2310.jpg")
