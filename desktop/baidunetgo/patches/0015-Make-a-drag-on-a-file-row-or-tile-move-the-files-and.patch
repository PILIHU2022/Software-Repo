+	}
+	tt.Release(to.X, to.Y)
+	tt.Frame()
+	waitUntil(t, tt, "moved to the root", func() bool { return srv.Exists("/IMG_2310.jpg") })
+	if srv.Exists("/照片/IMG_2310.jpg") {
+		t.Errorf("the file stayed in 照片")
+	}
+}
