+
+/** Collects the rows of a [SegmentedGroup] (KernelSU's `SegmentedColumn` DSL). */
+class SegmentedGroupScope {
+    internal val items = mutableListOf<SegmentItem>()
+
+    fun item(key: Any? = null, content: @Composable () -> Unit) {
+        items += SegmentItem(key ?: items.size, content)
+    }
+}
+
+/**
+ * A group of settings rows drawn as a segmented list: each row is its own
+ * tonal card, 2 dp apart, with rounded outer corners and small inner ones —
+ * the visual signature of KernelSU's Material settings pages.
+ */
+@Composable
+fun SegmentedGroup(
+    modifier: Modifier = Modifier,
+    title: String? = null,
+    content: SegmentedGroupScope.() -> Unit,
+) {
+    val items = SegmentedGroupScope().apply(content).items
+    if (items.isEmpty()) return
+    Column(modifier = modifier.fillMaxWidth()) {
+        if (title != null) {
+            Text(
+                text = title,
+                style = MaterialTheme.typography.titleSmall,
+                color = MaterialTheme.colorScheme.primary,
+                modifier = Modifier.padding(start = 4.dp, bottom = 8.dp),
+            )
+        }
+        Column(verticalArrangement = Arrangement.spacedBy(2.dp)) {
+            items.forEachIndexed { index, item ->
+                TonalCard(shape = segmentShape(index, items.size)) {
+                    item.content()
+                }
+            }
         }
     }
 }
 
+/** Outer corners for the first/last row, small corners in between. */
+internal fun segmentShape(index: Int, count: Int): Shape {
+    if (count <= 1) return RoundedCornerShape(SegmentedSingleRadius)
+    val top = if (index == 0) SegmentedOuterRadius else SegmentedInnerRadius
+    val bottom = if (index == count - 1) SegmentedOuterRadius else SegmentedInnerRadius
+    return RoundedCornerShape(topStart = top, topEnd = top, bottomStart = bottom, bottomEnd = bottom)
+}
