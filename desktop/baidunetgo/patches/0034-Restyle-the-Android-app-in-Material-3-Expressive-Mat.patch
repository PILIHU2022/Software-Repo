+/** Tonal card: `surfaceBright` + `shapes.large` (KernelSU's `TonalCard`). */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun TonalCard(
+    modifier: Modifier = Modifier,
+    containerColor: Color = MaterialTheme.colorScheme.surfaceBright,
+    contentColor: Color = contentColorFor(containerColor),
+    shape: Shape = MaterialTheme.shapes.large,
+    onClick: (() -> Unit)? = null,
+    content: @Composable ColumnScope.() -> Unit,
+) {
+    val colors = CardDefaults.cardColors(containerColor = containerColor, contentColor = contentColor)
+    if (onClick != null) {
+        Card(onClick = onClick, modifier = modifier, shape = shape, colors = colors) {
+            Column(content = content)
+        }
+    } else {
+        Card(modifier = modifier, shape = shape, colors = colors) {
+            Column(content = content)
+        }
+    }
+}
