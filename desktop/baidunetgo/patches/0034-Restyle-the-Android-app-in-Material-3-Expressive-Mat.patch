+                    modifier = Modifier.clickable { onSelect(index) },
+                    colors = rowColors(),
+                    leadingContent = {
+                        RadioButton(selected = selected, onClick = null)
+                    },
+                    headlineContent = { Text(label) },
+                )
+            }
+        }
+    }
+}
