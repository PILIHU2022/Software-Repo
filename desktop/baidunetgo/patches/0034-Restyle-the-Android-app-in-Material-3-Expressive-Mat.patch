@@ -0,0 +1,27 @@
+package com.pengstem.baidunetgo.ui.theme
+
+import androidx.compose.animation.core.FiniteAnimationSpec
+import androidx.compose.animation.core.spring
+
+/**
+ * Expressive motion springs for the components this app builds by hand.
+ *
+ * These are the same spring values Material 3 Expressive uses
+ * (`MotionScheme.expressive()`): fast spatial 0.6/800, default spatial 0.8/380,
+ * slow spatial 0.8/200, default effects 1.0/1600, fast effects 1.0/3800.
+ * `MaterialExpressiveTheme` already installs an expressive `MotionScheme` for
+ * Material's own components; this object is for our segmented controls, the
+ * floating navigation bar and the result cards, which are custom.
+ */
+object ExpressiveMotion {
+
+    fun <T> fastSpatial(): FiniteAnimationSpec<T> = spring(dampingRatio = 0.6f, stiffness = 800f)
+
+    fun <T> defaultSpatial(): FiniteAnimationSpec<T> = spring(dampingRatio = 0.8f, stiffness = 380f)
+
+    fun <T> slowSpatial(): FiniteAnimationSpec<T> = spring(dampingRatio = 0.8f, stiffness = 200f)
+
+    fun <T> fastEffects(): FiniteAnimationSpec<T> = spring(dampingRatio = 1.0f, stiffness = 3800f)
+
+    fun <T> defaultEffects(): FiniteAnimationSpec<T> = spring(dampingRatio = 1.0f, stiffness = 1600f)
+}
