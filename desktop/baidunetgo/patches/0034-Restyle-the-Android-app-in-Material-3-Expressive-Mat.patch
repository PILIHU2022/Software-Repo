+/** KernelSU's snackbar host: swipe down to dismiss. */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ExpressiveSnackBarHost(
+    hostState: SnackbarHostState,
+    modifier: Modifier = Modifier,
+    snackBar: @Composable (SnackbarData) -> Unit = { Snackbar(it) },
+) {
+    val state = rememberSwipeToDismissBoxState()
+    SwipeToDismissBox(
+        state = state,
+        backgroundContent = {},
+        onDismiss = { hostState.currentSnackbarData?.dismiss() },
+    ) {
+        SnackbarHost(modifier = modifier, hostState = hostState, snackbar = snackBar)
+    }
+    LaunchedEffect(hostState.currentSnackbarData) {
+        if (hostState.currentSnackbarData == null) return@LaunchedEffect
+        state.snapTo(SwipeToDismissBoxValue.Settled)
+    }
+}
