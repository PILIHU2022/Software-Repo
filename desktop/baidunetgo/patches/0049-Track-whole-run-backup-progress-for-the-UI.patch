 	// Uploaded, Skipped and Failed count the files finished so far.
 	Files     int
@@ -218,6 +226,7 @@ func Run(ctx context.Context, cl Client, cfg Config, st *State, passphrase strin
 		listings: map[string]map[string]bool{},
