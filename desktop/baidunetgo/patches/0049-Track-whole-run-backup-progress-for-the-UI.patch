+// TestRunTotalProgress checks that a run reports its total bytes once it has
+// scanned every folder, that the done bytes never pass the total, and that the
+// last report of the run reaches it.
+func TestRunTotalProgress(t *testing.T) {
+	dir := t.TempDir()
+	write(t, dir, "a.txt", "hello")
+	write(t, dir, "sub/b.txt", "world!")
+	cl := newFake()
+	log := &reportLog{}
+	cfg := Config{Dest: "/备份", Folders: []Folder{{Local: dir, Remote: "照片"}}, Parallel: 2}
+	if _, err := Run(context.Background(), cl, cfg, NewState(), "", log.add); err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	total := int64(len("hello") + len("world!"))
+	var sawTotal, sawDone bool
+	for _, e := range log.all() {
+		if e.RunTotal != 0 && e.RunTotal != total {
+			t.Errorf("event %+v reports total %d, want 0 while scanning or %d", e, e.RunTotal, total)
+		}
+		if e.RunTotal > 0 && e.RunDone > e.RunTotal {
+			t.Errorf("event %+v counts more done than the run's total", e)
+		}
+		if e.RunTotal == total {
+			sawTotal = true
+			if e.RunDone == total {
+				sawDone = true
+			}
+		}
+	}
+	if !sawTotal {
+		t.Fatalf("no report carries the run's total %d: %+v", total, log.all())
+	}
+	if !sawDone {
+		t.Errorf("the run never reached its total: %+v", log.all())
+	}
+}
+
 // TestChangedFileReuploaded checks that a file changed with its size kept is
 // uploaded again, that a renamed file goes to a new, added remote path, and
 // that nothing old is deleted.
