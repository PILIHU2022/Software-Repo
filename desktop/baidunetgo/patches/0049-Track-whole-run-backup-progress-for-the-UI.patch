+			r.emit(Progress{Folder: local, File: rel, Remote: remote, Encrypted: r.cfg.Encrypt})
 			return nil
 		}
 		out = append(out, pd)
@@ -577,10 +627,19 @@ feed:
 	for _, p := range jobs {
 		// The start of a file is reported here, by the one goroutine that
 		// hands the files out, so that the reports come in sorted order
-		// however the workers happen to be scheduled.
+		// however the workers happen to be scheduled. Its slot in live starts
+		// at 0, so the run's done bytes count it as soon as it is handed out.
+		r.mu.Lock()
+		r.live[p.id] = 0
+		r.mu.Unlock()
 		r.emit(Progress{Folder: p.folder, File: p.rel, Remote: p.remote, Total: p.size, Encrypted: r.cfg.Encrypt})
 		select {
 		case <-ctx.Done():
+			// It was never handed to a worker: it leaves live again, so a
+			// canceled run does not count a file it never started.
+			r.mu.Lock()
+			delete(r.live, p.id)
+			r.mu.Unlock()
 			break feed
 		case ch <- p:
 		}
@@ -610,11 +669,36 @@ func (r *runner) upload(ctx context.Context, p pending) {
 		local = temp
 	}
 	err := r.cl.Upload(ctx, local, p.remote, func(done, total int64) {
+		// An encrypted file is sent as its slightly larger .gpg copy: cap its
+		// contribution at the local size the run counts, so RunDone stays
+		// monotonic and never passes RunTotal. A client that reports a count
+		// smaller than before is ignored for the same reason.
+		sent := done
+		if sent > p.size {
+			sent = p.size
+		}
+		r.mu.Lock()
+		if sent < r.live[p.id] {
+			// A client that reports a smaller count than before must not
+			// make the run's total step back.
+			sent = r.live[p.id]
+		}
+		r.live[p.id] = sent
+		r.mu.Unlock()
 		r.emit(Progress{Folder: p.folder, File: p.rel, Remote: p.remote, Done: done, Total: total, Encrypted: r.cfg.Encrypt})
 	})
 	if err != nil {
 		if ctx.Err() != nil {
-			// Canceled: not a failure of this file.
+			// Canceled: not a failure of this file. What it had sent is
+			// finished for the run's counters, so moving it to doneBytes
+			// keeps RunDone from stepping back as the other workers report
+			// before they stop.
+			r.mu.Lock()
+			if sent := r.live[p.id]; sent > 0 {
+				r.doneBytes += sent
+			}
+			delete(r.live, p.id)
+			r.mu.Unlock()
