 		}
 		r.fail(p, err)
@@ -624,8 +708,12 @@ func (r *runner) upload(ctx context.Context, p pending) {
 	r.st.Entries[p.local] = Entry{Size: p.size, ModNano: p.modNano, Remote: p.remote, At: time.Now()}
 	r.res.Uploaded++
 	r.res.Bytes += p.size
+	// The last report of a file counts all of it, even when the client sent
+	// no byte callback of its own.
+	r.live[p.id] = p.size
 	r.mu.Unlock()
 	r.emit(Progress{Folder: p.folder, File: p.rel, Remote: p.remote, Done: p.size, Total: p.size, Encrypted: r.cfg.Encrypt})
+	r.finishBytes(p)
 }
 
 // encrypted writes p's file encrypted into a new temporary file in os.TempDir
@@ -668,6 +756,19 @@ func (c checkedReader) Read(p []byte) (int, error) {
 	return c.r.Read(p)
 }
 
+// finishBytes moves a file's bytes from live to the run's finished total. It
+// runs after the file's last report, so that report still counts the file's
+// exact bytes in RunDone. A file that never started has no place in live and
+// no place in RunTotal either: it just leaves the run's counters alone.
+func (r *runner) finishBytes(p pending) {
+	r.mu.Lock()
+	if _, ok := r.live[p.id]; ok {
+		delete(r.live, p.id)
+		r.doneBytes += p.size
+	}
+	r.mu.Unlock()
+}
+
 // fail records a file that could not be uploaded.
 func (r *runner) fail(p pending, err error) {
 	r.addError(FileError{Local: p.local, Remote: p.remote, Err: err})
@@ -675,12 +776,21 @@ func (r *runner) fail(p pending, err error) {
 }
 
 // failedFile counts a file as failed and reports the end of it, without
-// recording another error (for the files under a failed directory).
+// recording another error (for the files under a failed directory). The
+// report still counts the file's bytes in live, as any last report does;
+// finishBytes then moves them to doneBytes, so the run's total keeps rising
+// to its end rather than stepping back on a failure.
 func (r *runner) failedFile(p pending) {
 	r.mu.Lock()
 	r.res.Failed++
+	// A failed file is finished too: its last report counts its bytes, then
+	// finishBytes moves them to the run's finished total.
+	if _, ok := r.live[p.id]; ok {
+		r.live[p.id] = p.size
+	}
 	r.mu.Unlock()
-	r.emit(Progress{Folder: p.folder, File: p.rel, Remote: p.remote, Total: p.size, Encrypted: r.cfg.Encrypt})
+	r.emit(Progress{Folder: p.folder, File: p.rel, Remote: p.remote, Done: p.size, Total: p.size, Encrypted: r.cfg.Encrypt})
+	r.finishBytes(p)
 }
 
 // addError collects an error of the run.
@@ -701,6 +811,21 @@ func (r *runner) emit(p Progress) {
 	}
 	r.mu.Lock()
 	p.Files, p.Uploaded, p.Skipped, p.Failed = r.files, r.res.Uploaded, r.res.Skipped, r.res.Failed
+	// RunDone sums the finished files and every file still in flight: a
+	// finished file's last report already carries its bytes, so moving them
+	// to doneBytes afterwards keeps the total steady rather than resetting it
+	// to the one file a worker happens to report.
+	done := r.doneBytes
+	for _, n := range r.live {
+		done += n
+	}
+	// An encrypted file is sent as its slightly larger .gpg copy, so the
+	// client's byte count can pass the local total; the run never reads over
+	// 100%.
+	if r.totalBytes > 0 && done > r.totalBytes {
+		done = r.totalBytes
+	}
+	p.RunDone, p.RunTotal = done, r.totalBytes
 	r.mu.Unlock()
 	r.report(p)
 }
