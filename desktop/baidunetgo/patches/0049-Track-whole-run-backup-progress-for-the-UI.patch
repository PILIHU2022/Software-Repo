@@ -133,6 +133,14 @@ type Progress struct {
 	// bytes as the client sends them, and its end with Done equal to Total.
 	Done  int64
 	Total int64
+	// RunDone and RunTotal are the bytes of the whole run: RunTotal is the
+	// size of every file the scan will upload, and RunDone counts those
+	// already finished plus the bytes of every file still in flight. RunTotal
+	// is 0 while the run is still scanning, and is set once before the
+	// uploads start, so a page can show one percentage for the run rather
+	// than one that restarts with every file.
+	RunDone  int64
+	RunTotal int64
