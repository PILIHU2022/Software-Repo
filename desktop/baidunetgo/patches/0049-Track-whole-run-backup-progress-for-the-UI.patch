+func (r *runner) planFolder(ctx context.Context, local, base string) ([]pending, error) {
 	files, err := r.walk(ctx, local, base)
 	if err != nil {
-		return err
+		return nil, err
 	}
 	if len(files) == 0 {
-		return nil
+		return nil, nil
