 			if ctx.Err() != nil {
-				return ctx.Err()
+				return nil, ctx.Err()
 			}
 			// One error for the directory; the files in it count as failed
 			// and are left out of the state, so the next run retries them.
@@ -366,10 +415,7 @@ func (r *runner) folder(ctx context.Context, local, base string) error {
 		}
 		todo = append(todo, p)
 	}
-	if len(todo) == 0 {
-		return nil
