-// run walks and uploads every configured folder.
+// run walks every configured folder first, so that it knows the run's total
+// bytes before the first upload starts, and then uploads all the files.
 func (r *runner) run(ctx context.Context) (Result, error) {
+	var jobs []pending
 	for _, f := range r.cfg.Folders {
 		if ctx.Err() != nil {
 			break
@@ -319,11 +343,34 @@ func (r *runner) run(ctx context.Context) (Result, error) {
 		r.mu.Lock()
 		r.res.Folders++
 		r.mu.Unlock()
-		if err := r.folder(ctx, abs, base); err != nil {
+		todo, err := r.planFolder(ctx, abs, base)
+		if err != nil {
 			// Only cancellation stops the run; file and folder failures were
 			// collected as they happened.
 			break
 		}
+		jobs = append(jobs, todo...)
+	}
+	if ctx.Err() == nil && len(jobs) > 0 {
+		var total int64
+		for i := range jobs {
+			jobs[i].id = int64(i + 1)
+		}
+		for _, p := range jobs {
+			total += p.size
+		}
+		r.mu.Lock()
+		r.totalBytes = total
+		r.mu.Unlock()
+		// The scan is done: the run's total is known from here on, and every
+		// later report can show one percentage for the whole run.
+		r.emit(Progress{})
+		if err := r.uploadAll(ctx, jobs); err != nil {
+			r.mu.Lock()
+			res := r.res
+			r.mu.Unlock()
+			return res, err
+		}
 	}
 	r.mu.Lock()
 	res := r.res
@@ -334,26 +381,28 @@ func (r *runner) run(ctx context.Context) (Result, error) {
 	return res, nil
 }
 
-// folder backs up one local directory into the netdisk directory base.
-func (r *runner) folder(ctx context.Context, local, base string) error {
+// planFolder collects what one local directory needs uploaded into the netdisk
