 // walk collects the files under local, in sorted order, reporting the ones
@@ -412,6 +458,8 @@ func (r *runner) walk(ctx context.Context, local, base string) ([]pending, error
 		if d.Type()&fs.ModeSymlink != 0 {
 			// Symbolic links are not followed: what they point at is not part
 			// of this tree, and their own size would never match the upload.
+			// Nothing is sent for it, so its bytes are not in RunTotal either,
+			// and its report carries no byte counts.
 			r.mu.Lock()
 			r.files++
 			r.res.Skipped++
@@ -439,7 +487,9 @@ func (r *runner) walk(ctx context.Context, local, base string) ([]pending, error
 			r.mu.Lock()
 			r.res.Skipped++
 			r.mu.Unlock()
-			r.emit(Progress{Folder: local, File: rel, Remote: remote, Done: pd.size, Total: pd.size, Encrypted: r.cfg.Encrypt})
+			// A skipped file is not part of the run's bytes: reporting its
