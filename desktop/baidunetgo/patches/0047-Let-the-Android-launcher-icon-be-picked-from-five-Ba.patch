index 0000000..a4c8ba2
--- /dev/null
+++ b/android/app/src/main/java/com/pengstem/baidunetgo/data/LauncherIcon.kt
@@ -0,0 +1,78 @@
+package com.pengstem.baidunetgo.data
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.pm.PackageManager
+import com.pengstem.baidunetgo.R
+
+/**
+ * The launcher-icon choices of the 启动图标 setting. Every choice is its own
+ * `<activity-alias>` in the manifest targeting [com.pengstem.baidunetgo.MainActivity]
+ * (`MainActivity` itself carries no launcher intent filter), so switching an
+ * icon is only ever a pair of component-enabled flips — enable the new alias
+ * first so at least one launcher component is alive at any moment.
+ *
+ * `Original` is the pre-existing generated vector adaptive icon; its alias
+ * points straight at `@mipmap/ic_launcher`, so it ships no PNGs of its own.
+ */
+enum class LauncherIcon(
+    val labelRes: Int,
+    /** Manifest alias class name, relative to the application id. */
+    val alias: String,
+) {
+    Classic(R.string.icon_classic, "com.pengstem.baidunetgo.LauncherClassic"),
+    International(R.string.icon_international, "com.pengstem.baidunetgo.LauncherIntl"),
+    Svip(R.string.icon_svip, "com.pengstem.baidunetgo.LauncherSvip"),
+    NewYear(R.string.icon_new_year, "com.pengstem.baidunetgo.LauncherOp"),
+    Original(R.string.icon_original, "com.pengstem.baidunetgo.LauncherOriginal"),
+}
+
+/**
+ * Flips the manifest's launcher aliases through
+ * [PackageManager.setComponentEnabledSetting]. Component work is cheap but
+ * still binder IO: call it from a worker thread (the ViewModel does).
+ */
+object LauncherIcons {
+
+    /**
+     * Enables [target]'s alias and disables the previously enabled one. The
+     * new component goes live **before** the old one is turned off, so the
+     * launcher never ends up with zero icons even if the second call fails.
+     * Returns the icon that is enabled after the call (=[target] normally,
+     * [LauncherIcon.Classic] only when the target alias could not be enabled).
+     */
+    fun apply(context: Context, target: LauncherIcon): LauncherIcon {
+        val pm = context.packageManager
+        val pkg = context.packageName
+        val current = LauncherIcon.entries.firstOrNull { effectivelyEnabled(pm, pkg, it) }
+        if (current == target) return target
+        pm.setComponentEnabledSetting(
+            ComponentName(pkg, target.alias),
+            PackageManager.COMPONENT_ENABLED_STATE_ENABLED,
+            PackageManager.DONT_KILL_APP,
+        )
+        if (effectivelyEnabled(pm, pkg, target)) {
+            current?.let {
+                pm.setComponentEnabledSetting(
+                    ComponentName(pkg, it.alias),
+                    PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+                    PackageManager.DONT_KILL_APP,
+                )
+            }
+        }
+        return target
+    }
+
+    private fun effectivelyEnabled(
+        pm: PackageManager,
+        pkg: String,
+        icon: LauncherIcon,
+    ): Boolean = when (pm.getComponentEnabledSetting(ComponentName(pkg, icon.alias))) {
+        PackageManager.COMPONENT_ENABLED_STATE_ENABLED -> true
+        PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+        PackageManager.COMPONENT_ENABLED_STATE_DISABLED_USER,
+        -> false
+        // Manifest default: only the classic alias is enabled="true".
+        else -> icon == LauncherIcon.Classic
+    }
+}
