+/**
+ * 启动图标 picker: one row per [LauncherIcon] with its art as a rounded
+ * thumbnail, the current one checked. Picking applies at once
+ * ([com.pengstem.baidunetgo.ui.AppViewModel.setLauncherIcon]) and closes.
+ *
+ * The thumbnails use the full-bleed foreground bitmaps (the original choice
+ * uses the existing vector foreground over its blue background), so they look
+ * like what the launcher masks the icons into.
+ */
+@Composable
+fun LauncherIconDialog(
+    current: LauncherIcon,
+    onSelect: (LauncherIcon) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    ExpressiveDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(R.string.launcher_icon_title)) },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(2.dp)) {
+                LauncherIcon.entries.forEach { icon ->
+                    val selected = icon == current
+                    TonalCard(
+                        shape = segmentShape(LauncherIcon.entries.indexOf(icon), LauncherIcon.entries.size),
+                        containerColor = if (selected) {
+                            MaterialTheme.colorScheme.secondaryContainer
+                        } else {
+                            MaterialTheme.colorScheme.surfaceBright
+                        },
+                        contentColor = if (selected) {
+                            MaterialTheme.colorScheme.onSecondaryContainer
+                        } else {
+                            MaterialTheme.colorScheme.onSurface
+                        },
+                    ) {
+                        ListItem(
+                            modifier = Modifier.clickable {
+                                onSelect(icon)
+                                onDismiss()
+                            },
+                            colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+                            leadingContent = { IconThumbnail(icon) },
+                            headlineContent = { Text(stringResource(icon.labelRes)) },
+                            trailingContent = { RadioButton(selected = selected, onClick = null) },
+                        )
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = onDismiss) { Text(stringResource(R.string.action_close)) }
+        },
+    )
+}
+
+/** 44 dp rounded thumbnail of a launcher choice. */
+@Composable
+private fun IconThumbnail(icon: LauncherIcon) {
+    Box(
+        modifier = Modifier
+            .size(44.dp)
+            .clip(RoundedCornerShape(11.dp))
+            .background(
+                if (icon == LauncherIcon.Original) {
+                    colorResource(R.color.ic_launcher_background)
+                } else {
+                    MaterialTheme.colorScheme.surface
+                },
+            ),
+        contentAlignment = Alignment.Center,
+    ) {
+        when (icon) {
+            LauncherIcon.Original -> Image(
+                painter = painterResource(R.drawable.ic_launcher_foreground),
+                contentDescription = null,
+                modifier = Modifier.size(44.dp),
+            )
+            else -> Image(
+                painter = painterResource(thumbRes(icon)),
+                contentDescription = null,
+                modifier = Modifier.size(44.dp),
+            )
+        }    }
+}
+
+private fun thumbRes(icon: LauncherIcon): Int = when (icon) {
+    LauncherIcon.Classic -> R.mipmap.ic_launcher_classic_fg
+    LauncherIcon.International -> R.mipmap.ic_launcher_intl_fg
+    LauncherIcon.Svip -> R.mipmap.ic_launcher_svip_fg
+    LauncherIcon.NewYear -> R.mipmap.ic_launcher_op_fg
+    LauncherIcon.Original -> R.drawable.ic_launcher_foreground
+}
