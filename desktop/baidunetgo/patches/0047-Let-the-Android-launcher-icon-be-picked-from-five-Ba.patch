+import com.pengstem.baidunetgo.ui.AppViewModel
+import com.pengstem.baidunetgo.ui.components.ExpressiveSegmentedRow
+
+/**
+ * 备份: the folder and album backups unified under one destination, switched by
+ * a segmented control at the top. Each half is the existing screen, unchanged;
+ * this hub only picks which one shows and keeps the choice in the app state.
+ */
+@Composable
+fun BackupHubScreen(
+    state: AppUiState,
+    vm: AppViewModel,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier = modifier.fillMaxSize()) {
+        ExpressiveSegmentedRow(
+            options = listOf(
+                stringResource(R.string.backup_tab_folders),
+                stringResource(R.string.backup_tab_albums),
+            ),
+            selectedIndex = state.backupTab,
+            onSelect = vm::setBackupTab,
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(start = 16.dp, end = 16.dp, top = 8.dp),
+        )
+        Spacer(Modifier.height(8.dp))
+        Box(
+            modifier = Modifier
+                .weight(1f)
+                .fillMaxWidth(),
+        ) {
+            if (state.backupTab == 1) {
+                GalleryBackupScreen(state = state, vm = vm)
+            } else {
+                BackupScreen(state = state, vm = vm)
+            }
+        }
+    }
+}
