diff --git a/android/tools/gen-launcher-icons.sh b/android/tools/gen-launcher-icons.sh
new file mode 100755
index 0000000..6928e1b
--- /dev/null
+++ b/android/tools/gen-launcher-icons.sh
@@ -0,0 +1,116 @@
+#!/usr/bin/env bash
+# Generates the launcher-icon mipmap PNGs for the 启动图标 setting.
+#
+# Five launcher choices ship as activity-aliases in the manifest:
+#   classic (default, composed from the official netdisk logo)
+#   intl    (国际版 element art)   svip (144 px element art, Mitchell upscale)
+#   op      (新年余朵 element art)  original (the existing vector adaptive icon,
+#           no PNGs — its alias points straight at @mipmap/ic_launcher)
+#
+# For every PNG variant we emit the legacy launcher sizes
+# (mipmap-{m,h,xh,xxh,xxxh}dpi/ic_launcher_<variant>.png = 48/72/96/144/192)
+# and the adaptive foreground bitmaps
+# (…/ic_launcher_<variant>_fg.png = 108/162/216/324/432), plus one
+# mipmap-anydpi-v26/ic_launcher_<variant>.xml pointing at the fg bitmap and a
+# background color that matches the art's edge.
+#
+# The adaptive foreground carries the square art at 66% of the layer — the
+# safe-zone diameter — centred on transparency. A full-bleed foreground makes
+# launchers crop to the mask and blow the art up (the 过度缩放 the picker used
+# to show); padded this way the art keeps its intended size and the background
+# colour, matching the art's edge, fills the ring out to the mask.
+#
+# Usage: gen-launcher-icons.sh <dir-with-source-pngs>
+# Sources (read-only, extracted from the installed Baidu Netdisk app):
+#   netdisk_logo.png (320x253, transparent cloud)
+#   ic_element_appicon_netdisk.png ic_element_appicon_svip.png ic_element_appicon_op.png
+set -euo pipefail
+
+SRC="${1:?usage: gen-launcher-icons.sh <source-dir-with-pngs>}"
+RES="$(cd "$(dirname "$0")/../app/src/main/res" && pwd)"
+MAGICK="${MAGICK:-magick}"
+
+LEGACY=(mdpi:48 hdpi:72 xhdpi:96 xxhdpi:144 xxxhdpi:192)
+FG=(mdpi:108 hdpi:162 xhdpi:216 xxhdpi:324 xxxhdpi:432)
+
+emit() { # emit <name> <kind:legacy|fg> <size> <file>
+    local name="$1" kind="$2" size="$3" file="$4"
+    local dir
+    if [[ $kind == legacy ]]; then
+        dir="$RES/mipmap-$name/ic_launcher_$variant.png"
+    else
+        dir="$RES/mipmap-$name/ic_launcher_${variant}_fg.png"
+    fi
+    mkdir -p "$(dirname "$dir")"
+    "$MAGICK" "$file" -resize "${size}x${size}!" -strip -depth 8 "PNG32:$dir"
+}
+
+pad_fg() { # pad_fg <full-bleed-art> <layer-size> <outfile>
+    # Shrinks the square art to the safe-zone diameter (66% of the layer) and
+    # centres it on a transparent canvas, so the launcher's mask crops only
+    # padding — never the art itself.
+    local art="$1" size="$2" out="$3"
+    local inner=$((size * 66 / 100))
+    "$MAGICK" "$art" -resize "${inner}x${inner}!" \
+        -background none -gravity center -extent "${size}x${size}" \
+        -strip -depth 8 "PNG32:$out"
+}
+
+compose_classic() { # compose_classic <size> <rounded:0|1> <outfile>
+    local size="$1" rounded="$2" out="$3"
+    local cloud=$((size * 246 / 432))
+    local lift=$((size * 8 / 432))
+    if [[ $rounded == 1 ]]; then
+        local r=$((size * 96 / 432))
+        "$MAGICK" -size "${size}x${size}" xc:none \
+            -fill white -draw "roundrectangle 0,0 $((size - 1)),$((size - 1)) $r,$r" \
+            \( "$SRC/netdisk_logo.png" -resize "${cloud}x" \) \
+            -gravity center -geometry "+0-${lift}" -compose over -composite \
+            -strip -depth 8 "PNG32:$out"
+    else
+        "$MAGICK" -size "${size}x${size}" xc:white \
+            \( "$SRC/netdisk_logo.png" -resize "${cloud}x" \) \
+            -gravity center -geometry "+0-${lift}" -compose over -composite \
+            -strip -depth 8 "PNG32:$out"
+    fi
+}
+
+for variant in classic intl svip op; do
+    tmp="$(mktemp -d)"
+    trap 'rm -rf "$tmp"' RETURN
+    case "$variant" in
+        classic)
+            compose_classic 432 0 "$tmp/fg.png"
+            compose_classic 432 1 "$tmp/legacy.png"
+            ;;
+        intl)
+            cp "$SRC/ic_element_appicon_netdisk.png" "$tmp/fg.png"
+            cp "$tmp/fg.png" "$tmp/legacy.png"   # art already has rounded corners
+            ;;
+        svip)
+            # 144 px source: Mitchell keeps the upscale smooth without ringing.
+            "$MAGICK" "$SRC/ic_element_appicon_svip.png" -filter Mitchell \
+                -resize 432x432! -strip -depth 8 "PNG32:$tmp/fg.png"
+            cp "$tmp/fg.png" "$tmp/legacy.png"
+            ;;
+        op)
+            "$MAGICK" "$SRC/ic_element_appicon_op.png" -strip -depth 8 "PNG32:$tmp/fg.png"
+            cp "$tmp/fg.png" "$tmp/legacy.png"
+            ;;
+    esac
+    pad_fg "$tmp/fg.png" 432 "$tmp/fg_padded.png"
+    for e in "${LEGACY[@]}"; do emit "${e%%:*}" legacy "${e##*:}" "$tmp/legacy.png"; done
+    for e in "${FG[@]}"; do emit "${e%%:*}" fg "${e##*:}" "$tmp/fg_padded.png"; done
+done
+
+for variant in classic intl svip op; do
+    cat > "$RES/mipmap-anydpi-v26/ic_launcher_$variant.xml" <<XML
+<?xml version="1.0" encoding="utf-8"?>
+<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
+    <background android:drawable="@color/ic_launcher_bg_$variant" />
+    <foreground android:drawable="@mipmap/ic_launcher_${variant}_fg" />
+</adaptive-icon>
+XML
+done
+
+echo "done: $RES/mipmap-*"
