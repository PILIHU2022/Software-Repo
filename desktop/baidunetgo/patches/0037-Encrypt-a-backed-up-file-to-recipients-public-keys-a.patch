+package pgp
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/ProtonMail/go-crypto/openpgp"
+)
+
+// Generated key pairs are expensive (a few seconds of RSA-3072 math each), so
+// the Go-side tests share two memoized pairs: Alice, passphrase-less, and
+// Bob, protected with a passphrase.
+var (
+	testKeysOnce  sync.Once
+	alicePubArm   string
+	alicePrivArm  string
+	bobPubArm     string
+	bobPrivArm    string
+	testKeysError error
+	aliceKey      Key
+	bobKey        Key
+)
+
+// testKeys returns the memoized key pairs. The returned private halves are
+// already parsed and unlocked.
+func testKeys(tb testing.TB) (alicePub, alicePriv, bobPub, bobPriv string) {
+	tb.Helper()
+	testKeysOnce.Do(func() {
+		alicePubArm, alicePrivArm, testKeysError = GenerateKeyPair("Alice Backups", "alice@example.com", "")
+		if testKeysError != nil {
+			return
+		}
+		bobPubArm, bobPrivArm, testKeysError = GenerateKeyPair("Bob Backups", "bob@example.com", "bob passphrase")
+		if testKeysError != nil {
+			return
+		}
+		aliceKey, testKeysError = ReadPrivateKey(strings.NewReader(alicePrivArm), "")
+		if testKeysError != nil {
+			return
+		}
+		bobKey, testKeysError = ReadPrivateKey(strings.NewReader(bobPrivArm), "bob passphrase")
+	})
+	if testKeysError != nil {
+		tb.Fatalf("generate test key pairs: %v", testKeysError)
+	}
+	return alicePubArm, alicePrivArm, bobPubArm, bobPrivArm
+}
