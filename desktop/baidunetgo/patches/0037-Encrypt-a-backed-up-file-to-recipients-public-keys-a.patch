+// TestKeysPassphraseAndRecipients encrypts with a passphrase AND to a
+// recipient, so the message carries both SKESK and PKESK packets, and checks
+// both ways in.
+func TestKeysPassphraseAndRecipients(t *testing.T) {
+	testKeys(t)
+	const passphrase = "both ways passphrase"
+	plain := randomBytes(t, 1<<20)
+	recipients := mustParsePublic(t, alicePubArm)
+
+	var cipher bytes.Buffer
+	if err := EncryptKeys(&cipher, bytes.NewReader(plain), passphrase, recipients, nil, ""); err != nil {
+		t.Fatalf("EncryptKeys: %v", err)
+	}
+
+	// Way in 1: the passphrase alone.
+	var got bytes.Buffer
+	if _, err := DecryptAny(&got, bytes.NewReader(cipher.Bytes()), passphrase, nil); err != nil {
+		t.Fatalf("DecryptAny with passphrase only: %v", err)
+	}
+	if !bytes.Equal(got.Bytes(), plain) {
+		t.Fatal("passphrase round trip mismatch")
+	}
+
+	// Way in 2: the recipient's private key alone.
+	got.Reset()
+	if _, err := DecryptAny(&got, bytes.NewReader(cipher.Bytes()), "", []Key{alice(t)}); err != nil {
+		t.Fatalf("DecryptAny with private key only: %v", err)
+	}
+	if !bytes.Equal(got.Bytes(), plain) {
+		t.Fatal("private key round trip mismatch")
+	}
+
+	// The passphrase does not open a recipient-only message, and the
+	// passphrase-less private half is not even needed for the symmetric path.
+	if err := EncryptKeys(&bytes.Buffer{}, bytes.NewReader(plain), passphrase, nil, nil, ""); err != nil {
+		t.Fatalf("EncryptKeys without recipients: %v", err)
+	}
+}
