+// TestGoDecryptsGPGKeysOutput lets gpg encrypt to its own key and DecryptAny
+// open the message with gpg's exported secret key.
+func TestGoDecryptsGPGKeysOutput(t *testing.T) {
+	gpg := newGPGEnv(t)
+	gpg.generateKey(t, "Test <t@x>", "encr")
+	dir := t.TempDir()
+
+	plain := randomBytes(t, 1<<20)
+	srcPath := writeInput(t, dir, "in.bin", plain)
+	encPath := filepath.Join(dir, "in.gpg")
+	gpg.encryptTo(t, srcPath, encPath, "Test <t@x>")
+
+	key, err := ReadPrivateKey(strings.NewReader(gpg.exportKey(t, "Test <t@x>", true)), "")
+	if err != nil {
+		t.Fatalf("ReadPrivateKey of gpg's secret key: %v", err)
+	}
+
+	var got bytes.Buffer
+	result, err := DecryptAny(&got, mustRead(t, encPath), "", []Key{key})
+	if err != nil {
+		t.Fatalf("DecryptAny of gpg output: %v", err)
+	}
+	if !result.Verified || result.SignedByKeyID != 0 {
+		t.Fatalf("unexpected VerifyResult %+v for an unsigned message", result)
+	}
+	if !bytes.Equal(got.Bytes(), plain) {
+		t.Fatalf("decrypted %d bytes, want %d equal bytes", got.Len(), len(plain))
+	}
+}
