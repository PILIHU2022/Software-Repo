+// TestKeysWrongSignerPassphrase checks that a protected signer key with a
+// wrong passphrase fails with ErrPassphrase before anything is written.
+func TestKeysWrongSignerPassphrase(t *testing.T) {
+	testKeys(t)
+	recipients := mustParsePublic(t, alicePubArm)
+	// Parse Bob's protected key without unlocking it.
+	locked, err := openpgp.ReadArmoredKeyRing(strings.NewReader(bobPrivArm))
+	if err != nil {
+		t.Fatalf("ReadArmoredKeyRing: %v", err)
+	}
+	var cipher bytes.Buffer
+	err = EncryptKeys(&cipher, strings.NewReader("x"), "", recipients, locked[0], "wrong passphrase")
+	if err == nil {
+		t.Fatal("EncryptKeys with a wrong signer passphrase returned nil error")
+	}
+	if !errors.Is(err, ErrPassphrase) {
+		t.Fatalf("error = %v, want ErrPassphrase", err)
+	}
+	if cipher.Len() != 0 {
+		t.Fatalf("EncryptKeys wrote %d bytes before failing", cipher.Len())
+	}
+}
