+// alice reads the memoized passphrase-less key pair, unlocked for signing and
+// decrypting.
+func alice(tb testing.TB) Key {
+	tb.Helper()
+	testKeys(tb)
+	return aliceKey
+}
+
+// bob reads the memoized passphrase-protected key pair, unlocked for
+// decrypting.
+func bob(tb testing.TB) Key {
+	tb.Helper()
+	testKeys(tb)
+	return bobKey
+}
