+// TestKeysSigning checks that a signed message verifies with the signer's
+// identity, and that a tampered message fails with ErrSignature.
+func TestKeysSigning(t *testing.T) {
+	testKeys(t)
+	plain := randomBytes(t, 64<<10)
+	recipients := mustParsePublic(t, alicePubArm)
+
+	var cipher bytes.Buffer
+	if err := EncryptKeys(&cipher, bytes.NewReader(plain), "", recipients, alice(t), ""); err != nil {
+		t.Fatalf("EncryptKeys with signer: %v", err)
+	}
+
+	var got bytes.Buffer
+	result, err := DecryptAny(&got, bytes.NewReader(cipher.Bytes()), "", []Key{alice(t)})
+	if err != nil {
+		t.Fatalf("DecryptAny: %v", err)
+	}
+	if !result.Verified {
+		t.Fatal("signature did not verify")
+	}
+	if result.SignedByKeyID != alice(t).PrimaryKey.KeyId {
+		t.Fatalf("SignedByKeyID = %X, want %X", result.SignedByKeyID, alice(t).PrimaryKey.KeyId)
+	}
+	if want := "Alice Backups <alice@example.com>"; result.SignedByName != want {
+		t.Fatalf("SignedByName = %q, want %q", result.SignedByName, want)
+	}
+	if !bytes.Equal(got.Bytes(), plain) {
+		t.Fatal("signed round trip mismatch")
+	}
+
+	// Tamper one byte inside the encrypted body: the signature must fail
+	// (whether the MDC catches it first or the signature check does).
+	tampered := append([]byte(nil), cipher.Bytes()...)
+	tampered[len(tampered)/2] ^= 0x01
+	got.Reset()
+	_, err = DecryptAny(&got, bytes.NewReader(tampered), "", []Key{alice(t)})
+	if err == nil {
+		t.Fatal("DecryptAny of a tampered message returned nil error")
+	}
+	if !errors.Is(err, ErrSignature) && !errors.Is(err, ErrPassphrase) {
+		t.Fatalf("tampered message error = %v, want ErrSignature or ErrPassphrase", err)
+	}
+	t.Logf("tampered message error: %v", err)
+}
+
+// TestKeysSignWithoutEncryption checks a message a given key can decrypt but
+// that was signed by a key that is not given: the signature cannot be checked,
+// which is an ErrSignature error with the signer's id still reported.
+func TestKeysSignWithoutEncryption(t *testing.T) {
+	testKeys(t)
+	// Encrypted to both, signed by Alice, opened with Bob's key alone: Bob can
+	// read the message but cannot check Alice's signature.
+	recipients := mustParsePublic(t, alicePubArm+"\n"+bobPubArm)
+	var cipher bytes.Buffer
+	if err := EncryptKeys(&cipher, strings.NewReader("signed by alice, read by bob"), "", recipients, alice(t), ""); err != nil {
+		t.Fatalf("EncryptKeys: %v", err)
+	}
+	var got bytes.Buffer
+	result, err := DecryptAny(&got, bytes.NewReader(cipher.Bytes()), "", []Key{bob(t)})
+	if err == nil {
+		t.Fatal("DecryptAny without the signer's key returned nil error")
+	}
+	if !errors.Is(err, ErrSignature) {
+		t.Fatalf("error = %v, want ErrSignature", err)
+	}
+	if result.Verified || result.SignedByKeyID != alice(t).PrimaryKey.KeyId {
+		t.Fatalf("unexpected VerifyResult %+v", result)
+	}
+}
