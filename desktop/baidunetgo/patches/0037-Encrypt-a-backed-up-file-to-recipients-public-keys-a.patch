+// TestKeysFileHelpers exercises EncryptKeysFile: reported byte count, 0600
+// destination mode, and no partial output after a failure.
+func TestKeysFileHelpers(t *testing.T) {
+	testKeys(t)
+	dir := t.TempDir()
+	plain := randomBytes(t, 1<<20)
+
+	srcPath := filepath.Join(dir, "photo.jpg")
+	if err := os.WriteFile(srcPath, plain, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	encPath := srcPath + Suffix
+	recipients := mustParsePublic(t, alicePubArm)
+
+	encN, err := EncryptKeysFile(encPath, srcPath, "", recipients, nil, "")
+	if err != nil {
+		t.Fatalf("EncryptKeysFile: %v", err)
+	}
+	fi, err := os.Stat(encPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if encN != fi.Size() {
+		t.Fatalf("EncryptKeysFile returned %d bytes, file has %d", encN, fi.Size())
+	}
+	if mode := fi.Mode().Perm(); mode != 0o600 {
+		t.Fatalf("encrypted file mode = %04o, want 0600", mode)
+	}
+
+	// The symmetric DecryptFile cannot open a key-encrypted file: it reports
+	// that no passphrase applies instead of decrypting garbage.
+	decPath := filepath.Join(dir, "restored.jpg")
+	if _, err := DecryptFile(decPath, encPath, ""); !errors.Is(err, ErrNotEncrypted) {
+		t.Fatalf("DecryptFile of a key-encrypted file error = %v, want ErrNotEncrypted", err)
+	}
+	if _, err := os.Stat(decPath); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("output %q exists after failed DecryptFile (stat error: %v)", decPath, err)
+	}
+
+	var restored bytes.Buffer
+	result, err := DecryptAny(&restored, mustRead(t, encPath), "", []Key{alice(t)})
+	if err != nil {
+		t.Fatalf("DecryptAny: %v", err)
+	}
+	if !bytes.Equal(restored.Bytes(), plain) || !result.Verified {
+		t.Fatal("file round trip mismatch")
+	}
+
+	// A failed encryption removes the partial destination.
+	failedDst := filepath.Join(dir, "failed.gpg")
+	if _, err := EncryptKeysFile(failedDst, filepath.Join(dir, "missing"), "", recipients, nil, ""); err == nil {
+		t.Fatal("EncryptKeysFile with a missing source returned nil error")
+	}
+	if _, err := os.Stat(failedDst); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("destination %q survives a failed EncryptKeysFile (stat error: %v)", failedDst, err)
+	}
+}
