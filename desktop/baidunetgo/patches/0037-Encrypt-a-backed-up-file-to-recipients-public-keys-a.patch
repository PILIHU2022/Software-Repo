+// TestKeysWrongSecret checks that neither an unrelated private key nor the
+// wrong passphrase opens a recipient-encrypted message, with clear errors.
+func TestKeysWrongSecret(t *testing.T) {
+	testKeys(t)
+	recipients := mustParsePublic(t, alicePubArm)
+	plain := randomBytes(t, 1<<15)
+
+	var cipher bytes.Buffer
+	if err := EncryptKeys(&cipher, bytes.NewReader(plain), "", recipients, nil, ""); err != nil {
+		t.Fatalf("EncryptKeys: %v", err)
+	}
+
+	// Only Bob's key, which is not a recipient: no secret fits the message.
+	var got bytes.Buffer
+	_, err := DecryptAny(&got, bytes.NewReader(cipher.Bytes()), "", []Key{bob(t)})
+	if err == nil {
+		t.Fatal("DecryptAny with an unrelated key returned nil error")
+	}
+	if !errors.Is(err, ErrNoKey) {
+		t.Fatalf("error = %v, want ErrNoKey", err)
+	}
+	if got.Len() != 0 {
+		t.Fatalf("DecryptAny wrote %d bytes despite having no secret", got.Len())
+	}
+
+	// No material at all.
+	got.Reset()
+	if _, err := DecryptAny(&got, bytes.NewReader(cipher.Bytes()), "", nil); !errors.Is(err, ErrNoKey) {
+		t.Fatalf("error = %v, want ErrNoKey", err)
+	}
+
+	// A passphrase does not open a key-only message either.
+	got.Reset()
+	if _, err := DecryptAny(&got, bytes.NewReader(cipher.Bytes()), "some passphrase", nil); !errors.Is(err, ErrNoKey) {
+		t.Fatalf("error = %v, want ErrNoKey", err)
+	}
+
+	// No recipients and no passphrase at encryption time is refused at once.
+	got.Reset()
+	if err := EncryptKeys(&got, bytes.NewReader(plain), "", nil, nil, ""); !errors.Is(err, ErrNoKey) {
+		t.Fatalf("EncryptKeys error = %v, want ErrNoKey", err)
+	}
+}
