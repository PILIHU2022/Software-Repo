+// TestGPGDecryptsGoKeysOutput encrypts with EncryptKeys to gpg's exported
+// public key and lets gpg decrypt it with the matching secret key: the
+// direction a `gpg -d` user on another machine takes.
+func TestGPGDecryptsGoKeysOutput(t *testing.T) {
+	gpg := newGPGEnv(t)
+	gpg.generateKey(t, "Test <t@x>", "encr")
+	dir := t.TempDir()
+
+	publicArm := gpg.exportKey(t, "Test <t@x>", false)
+	recipients := mustParsePublic(t, publicArm)
+
+	for _, size := range []int{0, 1 << 20} {
+		name := "1 MiB"
+		if size == 0 {
+			name = "empty"
+		}
+		t.Run(name, func(t *testing.T) {
+			plain := randomBytes(t, size)
+			srcPath := writeInput(t, dir, "in-"+name+".bin", plain)
+			encPath := srcPath + Suffix
+			if _, err := EncryptKeysFile(encPath, srcPath, "", recipients, nil, ""); err != nil {
+				t.Fatalf("EncryptKeysFile: %v", err)
+			}
+
+			got := gpg.decryptFile(t, encPath, "")
+			if !bytes.Equal(got, plain) {
+				t.Fatalf("gpg decrypted %d bytes, want %d equal bytes", len(got), len(plain))
+			}
+		})
+	}
+}
