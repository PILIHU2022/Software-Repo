+// mustParsePublic parses armored public keys, failing the test on error.
+func mustParsePublic(tb testing.TB, armor string) []Key {
+	tb.Helper()
+	keys, err := ReadPublicKeys(strings.NewReader(armor))
+	if err != nil {
+		tb.Fatalf("ReadPublicKeys: %v", err)
+	}
+	return keys
