+// TestGoVerifiesGPGSignature verifies gpg-signed output with DecryptAny, both
+// the signed-only message (gpg --sign) and the signed-and-encrypted one
+// (gpg --encrypt --sign), checking name and key id.
+func TestGoVerifiesGPGSignature(t *testing.T) {
+	gpg := newGPGEnv(t)
+	gpg.generateKey(t, "Test <t@x>", "sign")
+	dir := t.TempDir()
+
+	gpgPublic := mustParsePublic(t, gpg.exportKey(t, "Test <t@x>", false))
+	plain := randomBytes(t, 64<<10)
+
+	for _, tc := range []struct {
+		name  string
+		setup func(t *testing.T) (signerOrRecipient string, keys []Key)
+		enc   bool
+	}{
+		{"signed only", func(t *testing.T) (string, []Key) {
+			return "Test <t@x>", gpgPublic
+		}, false},
+		{"signed and encrypted", func(t *testing.T) (string, []Key) {
+			// A sign-only key cannot encrypt; give it an encryption subkey.
+			// Decrypting needs the secret half, which also carries the
+			// signing key for verification.
+			gpg.addEncryptionSubkey(t, "Test <t@x>")
+			key, err := ReadPrivateKey(strings.NewReader(gpg.exportKey(t, "Test <t@x>", true)), "")
+			if err != nil {
+				t.Fatalf("ReadPrivateKey of gpg's secret key: %v", err)
+			}
+			return "Test <t@x>", []Key{key}
+		}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			userid, keys := tc.setup(t)
+			srcPath := writeInput(t, dir, "in.bin", plain)
+			signedPath := filepath.Join(dir, "signed.gpg")
+			if tc.enc {
+				gpg.encryptTo(t, srcPath, signedPath, userid, "--sign", "--local-user", userid)
+			} else {
+				gpg.signFile(t, srcPath, signedPath, userid)
+			}
+
+			var got bytes.Buffer
+			result, err := DecryptAny(&got, mustRead(t, signedPath), "", keys)
+			if err != nil {
+				t.Fatalf("DecryptAny of gpg-signed output: %v", err)
+			}
+			if !result.Verified {
+				t.Fatal("gpg's signature did not verify")
+			}
+			if result.SignedByName != userid {
+				t.Fatalf("SignedByName = %q, want %q", result.SignedByName, userid)
+			}
+			if result.SignedByKeyID == 0 {
+				t.Fatal("SignedByKeyID = 0 for a signed message")
+			}
+			if !bytes.Equal(got.Bytes(), plain) {
+				t.Fatalf("decrypted %d bytes, want %d equal bytes", got.Len(), len(plain))
+			}
+		})
+	}
+}
