+// TestKeysRoundTrip encrypts to a generated recipient's public key and
+// decrypts with the private half, with and without key protection.
+func TestKeysRoundTrip(t *testing.T) {
+	_, alicePriv, _, bobPriv := testKeys(t)
+
+	for _, tc := range []struct {
+		name       string
+		publicArm  string
+		privArm    string
+		privPass   string
+		passphrase string
+	}{
+		{"passphrase-less key", alicePubArm, alicePriv, "", ""},
+		{"protected key", bobPubArm, bobPriv, "bob passphrase", ""},
+		{"protected key with message passphrase", bobPubArm, bobPriv, "bob passphrase", "message passphrase"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			plain := randomBytes(t, 1<<20)
+			recipients := mustParsePublic(t, tc.publicArm)
+
+			var cipher bytes.Buffer
+			if err := EncryptKeys(&cipher, bytes.NewReader(plain), tc.passphrase, recipients, nil, ""); err != nil {
+				t.Fatalf("EncryptKeys: %v", err)
+			}
+
+			key, err := ReadPrivateKey(strings.NewReader(tc.privArm), tc.privPass)
+			if err != nil {
+				t.Fatalf("ReadPrivateKey: %v", err)
+			}
+			var got bytes.Buffer
+			result, err := DecryptAny(&got, bytes.NewReader(cipher.Bytes()), "", []Key{key})
+			if err != nil {
+				t.Fatalf("DecryptAny: %v", err)
+			}
+			if !result.Verified || result.SignedByKeyID != 0 || result.SignedByName != "" {
+				t.Fatalf("unexpected VerifyResult %+v", result)
+			}
+			if !bytes.Equal(got.Bytes(), plain) {
+				t.Fatalf("round trip mismatch: got %d bytes, want %d", got.Len(), len(plain))
+			}
+		})
+	}
+}
