+// --- gpg interoperability --------------------------------------------------
+
+// generateKey creates a fresh RSA-3072 key with the given usage in the
+// throwaway GNUPGHOME. An empty passphrase keeps the tests simple: the keys
+// never leave the temporary home.
+func (e *gpgEnv) generateKey(t *testing.T, userid, usage string) {
+	t.Helper()
+	cmd := e.command(t,
+		"--batch", "--yes", "--no-tty",
+		"--pinentry-mode", "loopback",
+		"--passphrase", "",
+		"--quick-generate-key", userid, "rsa3072", usage,
+	)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		t.Fatalf("gpg --quick-generate-key %q: %v\n%s", userid, err, stderr.String())
+	}
+}
+
+// fingerprint returns the primary key fingerprint of userid, for
+// --quick-add-key.
+func (e *gpgEnv) fingerprint(t *testing.T, userid string) string {
+	t.Helper()
+	cmd := e.command(t, "--batch", "--list-keys", "--with-colons", "--with-fingerprint", userid)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		t.Fatalf("gpg --list-keys %q: %v\n%s", userid, err, stderr.String())
+	}
+	for _, line := range strings.Split(stdout.String(), "\n") {
+		if fields := strings.Split(strings.TrimSpace(line), ":"); len(fields) > 9 && fields[0] == "fpr" {
+			return fields[9]
+		}
+	}
+	t.Fatalf("gpg --list-keys %q returned no public key record", userid)
+	return ""
+}
+
+// addEncryptionSubkey gives a signing-capable key an RSA encryption subkey,
+// because --quick-generate-key with the sign usage creates none.
+func (e *gpgEnv) addEncryptionSubkey(t *testing.T, userid string) {
+	t.Helper()
+	cmd := e.command(t,
+		"--batch", "--yes", "--no-tty",
+		"--pinentry-mode", "loopback",
+		"--passphrase", "",
+		"--quick-add-key", e.fingerprint(t, userid), "rsa3072", "encr", "never",
+	)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		t.Fatalf("gpg --quick-add-key %q: %v\n%s", userid, err, stderr.String())
+	}
+}
+
+// exportKey runs gpg --armor --export (secret when secret is true) for userid
+// and returns the armored block(s).
+func (e *gpgEnv) exportKey(t *testing.T, userid string, secret bool) string {
+	t.Helper()
+	kind := "--export"
+	if secret {
+		kind = "--export-secret-keys"
+	}
+	cmd := e.command(t, "--batch", "--armor", kind, userid)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		t.Fatalf("gpg %s %q: %v\n%s", kind, userid, err, stderr.String())
+	}
+	return stdout.String()
+}
+
+// importKey feeds armored keys to gpg --import.
+func (e *gpgEnv) importKey(t *testing.T, armored string) {
+	t.Helper()
+	cmd := e.command(t, "--batch", "--yes", "--no-tty", "--import")
+	cmd.Stdin = strings.NewReader(armored)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		t.Fatalf("gpg --import: %v\n%s", err, stderr.String())
+	}
+}
+
+// encryptTo runs gpg --encrypt --recipient on inPath into outPath.
+func (e *gpgEnv) encryptTo(t *testing.T, inPath, outPath, recipient string, extra ...string) {
+	t.Helper()
+	args := []string{
+		"--batch", "--yes", "--no-tty",
+		"--pinentry-mode", "loopback",
+		"--passphrase", "",
+		"--trust-model", "always",
+		"--encrypt", "--recipient", recipient,
+		"--output", outPath,
+	}
+	args = append(args, extra...)
+	args = append(args, inPath)
+	cmd := e.command(t, args...)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		t.Fatalf("gpg --encrypt %s: %v\n%s", inPath, err, stderr.String())
+	}
+}
+
+// signFile runs gpg --sign on inPath into outPath with signer as local-user.
+func (e *gpgEnv) signFile(t *testing.T, inPath, outPath, signer string, extra ...string) {
+	t.Helper()
+	args := []string{
+		"--batch", "--yes", "--no-tty",
+		"--pinentry-mode", "loopback",
+		"--passphrase", "",
+		"--sign", "--local-user", signer,
+		"--output", outPath,
+	}
+	args = append(args, extra...)
+	args = append(args, inPath)
+	cmd := e.command(t, args...)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		t.Fatalf("gpg --sign %s: %v\n%s", inPath, err, stderr.String())
+	}
+}
+
+// writeInput writes plaintext bytes to a file in dir and returns its path.
+func writeInput(t *testing.T, dir, name string, plain []byte) string {
+	t.Helper()
+	path := filepath.Join(dir, name)
+	if err := os.WriteFile(path, plain, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
