+// TestGPGVerifiesGoSignature signs with a Go-generated key and lets gpg
+// verify and decrypt: import the private half (the owner's key on another
+// machine), then gpg -d.
+func TestGPGVerifiesGoSignature(t *testing.T) {
+	gpg := newGPGEnv(t)
+	testKeys(t)
+	gpg.importKey(t, alicePrivArm)
+	dir := t.TempDir()
+
+	plain := randomBytes(t, 1<<20)
+	srcPath := writeInput(t, dir, "in.bin", plain)
+	encPath := srcPath + Suffix
+	if _, err := EncryptKeysFile(encPath, srcPath, "", mustParsePublic(t, alicePubArm), alice(t), ""); err != nil {
+		t.Fatalf("EncryptKeysFile: %v", err)
+	}
+
+	got := gpg.decryptFile(t, encPath, "")
+	if !bytes.Equal(got, plain) {
+		t.Fatalf("gpg decrypted %d bytes, want %d equal bytes", len(got), len(plain))
+	}
+
+	// A tampered ciphertext must make gpg fail the verification.
+	tampered, err := os.ReadFile(encPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tampered[len(tampered)/2] ^= 0x01
+	tamperedPath := writeInput(t, dir, "tampered.gpg", tampered)
+	cmd := gpg.command(t,
+		"--batch", "--yes", "--no-tty",
+		"--pinentry-mode", "loopback",
+		"--passphrase", "",
+		"--decrypt", tamperedPath,
+	)
+	if err := cmd.Run(); err == nil {
+		t.Fatal("gpg accepted a tampered signed message")
+	} else {
+		t.Logf("gpg rejected the tampered message: %v", err)
+	}
+}
