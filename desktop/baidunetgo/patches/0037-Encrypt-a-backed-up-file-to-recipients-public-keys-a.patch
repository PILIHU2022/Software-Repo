+// TestGPGSeesKeysMessageParameters inspects EncryptKeys output from gpg's
+// point of view: RSA PKESK packets (algo 1), a classic SEIPD v1 (aead 0) with
+// AES-256 (cipher 9), and — in the combined case — an SKESK packet (s2k 3,
+// hash 8) alongside them, and no compression anywhere.
+func TestGPGSeesKeysMessageParameters(t *testing.T) {
+	gpg := newGPGEnv(t)
+	gpg.generateKey(t, "Test <t@x>", "encr")
+	dir := t.TempDir()
+	recipients := mustParsePublic(t, gpg.exportKey(t, "Test <t@x>", false))
+
+	srcPath := writeInput(t, dir, "in.bin", []byte("packet parameter check"))
+	for _, tc := range []struct {
+		name       string
+		passphrase string
+		want       []string
+	}{
+		// In the recipient-only dump the cipher and AEAD mode sit inside the
+		// encrypted PKESK payload, which gpg cannot open without the secret
+		// key, so only the outer packet shapes are checked.
+		{"recipient only", "", []string{"pubkey enc packet", "algo 1", "mdc_method: 2"}},
+		{"passphrase and recipient", "combined passphrase",
+			[]string{"pubkey enc packet", "symkey enc packet", "cipher 9", "aead 0", "s2k 3", "hash 8", "mdc_method: 2"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			encPath := filepath.Join(dir, tc.name+".gpg")
+			if _, err := EncryptKeysFile(encPath, srcPath, tc.passphrase, recipients, nil, ""); err != nil {
+				t.Fatalf("EncryptKeysFile: %v", err)
+			}
+			dump := gpg.listPackets(t, encPath, tc.passphrase)
+			t.Logf("gpg packet dump:\n%s", dump)
+			for _, want := range tc.want {
+				if !strings.Contains(dump, want) {
+					t.Errorf("gpg packet dump is missing %q", want)
+				}
+			}
+			if strings.Contains(dump, ":compressed packet:") {
+				t.Error("packet dump contains a compressed packet; encryption must be uncompressed")
+			}
+		})
+	}
+}
