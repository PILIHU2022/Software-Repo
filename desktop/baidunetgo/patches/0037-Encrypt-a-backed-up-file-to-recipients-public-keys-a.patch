+// TestKeysTwoRecipients encrypts to two recipients and checks that either
+// private key alone decrypts.
+func TestKeysTwoRecipients(t *testing.T) {
+	testKeys(t)
+	plain := randomBytes(t, 1<<20)
+	recipients := mustParsePublic(t, alicePubArm+"\n"+bobPubArm)
+
+	var cipher bytes.Buffer
+	if err := EncryptKeys(&cipher, bytes.NewReader(plain), "", recipients, nil, ""); err != nil {
+		t.Fatalf("EncryptKeys: %v", err)
+	}
+
+	for _, tc := range []struct {
+		name string
+		key  Key
+	}{
+		{"alice", alice(t)},
+		{"bob", bob(t)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var got bytes.Buffer
+			if _, err := DecryptAny(&got, bytes.NewReader(cipher.Bytes()), "", []Key{tc.key}); err != nil {
+				t.Fatalf("DecryptAny with %s: %v", tc.name, err)
+			}
+			if !bytes.Equal(got.Bytes(), plain) {
+				t.Fatalf("round trip mismatch with %s", tc.name)
+			}
+		})
+	}
+}
