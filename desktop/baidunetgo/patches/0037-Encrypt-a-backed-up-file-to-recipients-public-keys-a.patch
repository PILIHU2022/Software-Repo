+// TestGoRejectsTamperedGPGSignature feeds gpg a tampered signed message and
+// expects ErrSignature.
+func TestGoRejectsTamperedGPGSignature(t *testing.T) {
+	gpg := newGPGEnv(t)
+	gpg.generateKey(t, "Test <t@x>", "sign")
+	dir := t.TempDir()
+
+	gpgPublic := mustParsePublic(t, gpg.exportKey(t, "Test <t@x>", false))
+	srcPath := writeInput(t, dir, "in.bin", []byte("signed by gpg, then modified"))
+	signedPath := filepath.Join(dir, "signed.gpg")
+	gpg.signFile(t, srcPath, signedPath, "Test <t@x>")
+
+	signed, err := os.ReadFile(signedPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	signed[len(signed)/2] ^= 0x01
+
+	var got bytes.Buffer
+	result, err := DecryptAny(&got, bytes.NewReader(signed), "", gpgPublic)
+	if err == nil {
+		t.Fatal("DecryptAny accepted a tampered gpg signature")
+	}
+	if !errors.Is(err, ErrSignature) {
+		t.Fatalf("error = %v, want ErrSignature", err)
+	}
+	if result.Verified {
+		t.Fatal("VerifyResult.Verified is true for a tampered signature")
+	}
+	t.Logf("tampered gpg signature error: %v", err)
+}
