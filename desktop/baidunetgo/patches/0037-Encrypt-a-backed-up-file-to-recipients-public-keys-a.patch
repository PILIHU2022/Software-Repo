+package pgp
+
+import (
+	"bytes"
+	"crypto"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+
+	"github.com/ProtonMail/go-crypto/openpgp"
+	"github.com/ProtonMail/go-crypto/openpgp/armor"
+	pgperrors "github.com/ProtonMail/go-crypto/openpgp/errors"
+	"github.com/ProtonMail/go-crypto/openpgp/packet"
+)
+
+// Key is an OpenPGP key (entity): a recipient's public key, or the user's own
+// key pair for signing and decrypting. It is an *openpgp.Entity from
+// github.com/ProtonMail/go-crypto/openpgp.
+type Key = *openpgp.Entity
+
+// ErrSignature reports that a message carries a signature that could not be
+// verified: the signer's key was not among the keys given to DecryptAny, or
+// the signed data does not match the signature (tampering).
+var ErrSignature = errors.New("pgp: signature verification failed")
+
+// ErrNoKey reports that neither the private keys nor the passphrase given to
+// DecryptAny (or the EncryptKeys arguments) can produce a usable key.
+var ErrNoKey = errors.New("pgp: no usable private key or passphrase")
+
+// ErrNotPrivateKey reports that the armored data parsed fine but holds no
+// private key material (a public key, a signature, or something else).
+var ErrNotPrivateKey = errors.New("pgp: armored data contains no private key")
+
+// ErrNoKeys reports that the input holds no OpenPGP key material at all.
+var ErrNoKeys = errors.New("pgp: no OpenPGP keys found in input")
+
+// generatedRSABits is the size of RSA keys produced by GenerateKeyPair. 3072
+// bits gives ~128-bit security, generates in a few seconds, and both gpg and
+// BouncyCastle handle it comfortably.
+const generatedRSABits = 3072
+
+// VerifyResult describes who signed a decrypted message.
+//
+// Verified is true when the message carried no signature, or when the
+// signature matched one of the keys given to DecryptAny. When a message is
+// signed but Verified is false, DecryptAny also returns an error wrapping
+// ErrSignature; the result fields still say who the signer claimed to be.
+type VerifyResult struct {
+	Verified      bool   // false when signed and not verified
+	SignedByKeyID uint64 // 0 when unsigned
+	SignedByName  string // key's primary identity, "" when unknown
+}
+
+// ReadPublicKeys parses armored public keys: a single block or several
+// concatenated blocks, as `gpg --armor --export` produces. Binary keyrings
+// (gpg --export without --armor) are not supported.
+func ReadPublicKeys(r io.Reader) ([]Key, error) {
+	keys, err := readArmoredKeyRing(r)
+	if err != nil {
+		return nil, err
+	}
+	return keys, nil
+}
+
+// ReadPrivateKey parses an armored private key (surrounding signatures and
+// subkey packets are fine) and unlocks it with the passphrase. A
+// passphrase-less key takes "". The returned Key can sign and decrypt without
+// further unlocking: the primary key and every subkey are decrypted. A wrong
+// passphrase makes the error wrap ErrPassphrase; armor that holds no private
+// key material gives ErrNotPrivateKey.
+func ReadPrivateKey(r io.Reader, passphrase string) (Key, error) {
+	keys, err := readArmoredKeyRing(r)
+	if err != nil {
+		return nil, err
+	}
+	for _, key := range keys {
+		if key.PrivateKey != nil {
+			if err := unlockEntity(key, passphrase); err != nil {
+				return nil, err
+			}
+			return key, nil
+		}
+	}
+	return nil, ErrNotPrivateKey
+}
+
+// GenerateKeyPair makes a fresh RSA-3072 key pair (a primary signing key plus
+// an encryption subkey, SHA-256 self-signatures) for the given name and email,
+// protects the private half with the passphrase ("" leaves it passphrase-less),
+// and returns both halves ASCII-armored. The public half is a
+// "PGP PUBLIC KEY BLOCK", the private half a "PGP PRIVATE KEY BLOCK"; the
+// private half round-trips through ReadPrivateKey with the same passphrase.
+// Generation takes a few seconds.
+func GenerateKeyPair(name, email, passphrase string) (public string, private string, err error) {
+	entity, err := openpgp.NewEntity(name, "", email, &packet.Config{
+		RSABits:     generatedRSABits,
+		DefaultHash: crypto.SHA256,
+	})
+	if err != nil {
+		return "", "", fmt.Errorf("pgp: generate key pair: %w", err)
+	}
+
+	var publicBuf, privateBuf bytes.Buffer
+	if err := serializeArmored(&publicBuf, openpgp.PublicKeyType,
+		func(w io.Writer, _ *packet.Config) error { return entity.Serialize(w) }); err != nil {
+		return "", "", err
+	}
+
+	// Protect the primary key and every subkey before serializing the private
+	// half; SerializePrivateWithoutSigning emits the already-made
+	// self-signatures as they are, so the protected material needs no
+	// re-signing pass.
+	if passphrase != "" {
+		privateKeys := []*packet.PrivateKey{entity.PrivateKey}
+		for i := range entity.Subkeys {
+			privateKeys = append(privateKeys, entity.Subkeys[i].PrivateKey)
+		}
+		if err := packet.EncryptPrivateKeys(privateKeys, []byte(passphrase), keyConfig()); err != nil {
+			return "", "", fmt.Errorf("pgp: protect private key: %w", err)
+		}
+	}
+	if err := serializeArmored(&privateBuf, openpgp.PrivateKeyType,
+		entity.SerializePrivateWithoutSigning); err != nil {
+		return "", "", err
+	}
+	return publicBuf.String(), privateBuf.String(), nil
+}
+
+// EncryptKeys streams an OpenPGP message of src into dst encrypted to every
+// recipient's public key and — when passphrase != "" — also symmetrically to
+// the passphrase, so the message carries both PKESK and SKESK packets and any
+// one of the recipients' private keys or the passphrase alone can open it.
+// When signer != nil the message is signed with that private key, which is
+// unlocked with signerPass ("" for a passphrase-less key; a key that signerPass
+// cannot open makes the error wrap ErrPassphrase).
+//
+// At least one of passphrase and recipients must be given. Binary, no
+// compression, AES-256, SEIPD v1 with MDC, SHA-256 signatures; the output is
+// not armored. Both directions are fully streamed: no file is buffered whole.
+func EncryptKeys(dst io.Writer, src io.Reader, passphrase string, recipients []Key, signer Key, signerPass string) error {
+	if passphrase == "" && len(recipients) == 0 {
+		return fmt.Errorf("%w: give a passphrase, at least one recipient, or both", ErrNoKey)
+	}
+	cfg := config()
+
+	// The signing key must be usable before any packet is written, so a bad
+	// signerPassphrase fails without leaving a partial message behind.
+	var signKey *packet.PrivateKey
+	if signer != nil {
+		key, ok := signer.SigningKeyById(cfg.Now(), 0)
+		if !ok {
+			return fmt.Errorf("pgp: signer key has no valid signing key")
+		}
+		if key.PrivateKey == nil {
+			return errors.New("pgp: signer key has no private half")
+		}
+		signKey = key.PrivateKey
+		if err := decryptPrivateKey(signKey, signerPass); err != nil {
+			return err
+		}
+	}
+
+	// The SKESK packet (if any) must come first, then the PKESK packets, then
+	// the encrypted data. The passphrase KDF produces the session key
+	// directly (32 bytes, AES-256), so the same session key is shared by both
+	// packet kinds — exactly what gpg writes with -c and -r combined.
+	var sessionKey []byte
+	if passphrase != "" {
+		key, err := packet.SerializeSymmetricKeyEncrypted(dst, []byte(passphrase), cfg)
+		if err != nil {
+			return fmt.Errorf("pgp: start encryption: %w", err)
+		}
+		sessionKey = key
+	} else {
+		sessionKey = make([]byte, packet.CipherAES256.KeySize())
+		if _, err := io.ReadFull(cfg.Random(), sessionKey); err != nil {
+			return fmt.Errorf("pgp: start encryption: %w", err)
+		}
+	}
+	for _, recipient := range recipients {
+		encryptKey, ok := recipient.EncryptionKey(cfg.Now())
+		if !ok {
+			return fmt.Errorf("pgp: recipient key %08X has no valid encryption subkey", recipient.PrimaryKey.KeyId)
+		}
+		if err := packet.SerializeEncryptedKey(dst, encryptKey.PublicKey, packet.CipherAES256, sessionKey, cfg); err != nil {
+			return fmt.Errorf("pgp: start encryption: %w", err)
+		}
+	}
+	payload, err := packet.SerializeSymmetricallyEncrypted(dst, packet.CipherAES256, false,
+		packet.CipherSuite{Cipher: packet.CipherAES256}, sessionKey, cfg)
+	if err != nil {
+		return fmt.Errorf("pgp: start encryption: %w", err)
+	}
+
+	if signKey != nil {
+		ops := &packet.OnePassSignature{
+			Version:    3,
+			SigType:    packet.SigTypeBinary,
+			Hash:       crypto.SHA256,
+			PubKeyAlgo: signKey.PubKeyAlgo,
+			KeyId:      signKey.KeyId,
+			IsLast:     true,
+		}
+		if err := ops.Serialize(payload); err != nil {
+			return fmt.Errorf("pgp: sign: %w", err)
+		}
+		return writeSignedBody(payload, src, signKey, cfg)
+	}
+	return writeBody(payload, src)
+}
+
+// DecryptAny decrypts a message that is key-encrypted, passphrase-encrypted,
+// or both, into dst. Pass whichever secret material is available: passphrase
+// and/or unlocked private keys (a locked private key is also tried with the
+// passphrase). The result says who signed the message; VerifyResult.Verified
+// is true for an unsigned message and for a signature that checked out
+// against one of the keys given. A signed message whose signature fails to
+// verify — tampered data, or a signer whose key is not among the keys given —
+// makes the error wrap ErrSignature after the whole body has been consumed.
+// A wrong passphrase or failing integrity check wraps ErrPassphrase; input
+// that is neither encrypted nor signed OpenPGP data wraps ErrNotEncrypted.
+// An unencrypted but signed message (gpg --sign) is accepted too: it is just
+// copied through and verified.
+func DecryptAny(dst io.Writer, src io.Reader, passphrase string, keys []Key) (VerifyResult, error) {
+	result := VerifyResult{Verified: true}
+
+	// The OpenPGP reader asks for secret material again when the first
+	// attempt did not produce a usable session key. Answer at most once; a
+	// second request means nothing the caller gave us can decrypt the message.
+	prompted := false
+	prompt := func(candidates []openpgp.Key, symmetric bool) ([]byte, error) {
+		if prompted {
+			return nil, fmt.Errorf("%w: the passphrase and keys did not decrypt the message", ErrPassphrase)
+		}
+		prompted = true
+		// Try to unlock locked private keys with the passphrase first: a
+		// message encrypted only to public keys never asks for a passphrase.
+		if passphrase != "" && len(candidates) > 0 {
+			var locked []*packet.PrivateKey
+			for _, key := range candidates {
+				for _, priv := range entityPrivateKeys(key.Entity) {
+					if priv.Encrypted {
+						locked = append(locked, priv)
+					}
+				}
+			}
+			if err := packet.DecryptPrivateKeys(locked, []byte(passphrase)); err == nil {
+				return nil, nil // the keys are unlocked now; ReadMessage retries them
+			}
+		}
+		if symmetric {
+			return []byte(passphrase), nil
+		}
+		return nil, fmt.Errorf("%w: the passphrase does not unlock any given private key", ErrPassphrase)
+	}
+
+	md, err := openpgp.ReadMessage(src, openpgp.EntityList(keys), prompt, config())
+	if err != nil {
+		if errors.Is(err, ErrPassphrase) {
+			return result, err // our own prompt error, already descriptive
+		}
+		if errors.Is(err, pgperrors.ErrKeyIncorrect) {
+			// No SKESK packet to try the passphrase against, and no given key
+			// holds a secret for any PKESK packet.
+			return result, fmt.Errorf("%w: the message is not encrypted to any given key and no passphrase applies", ErrNoKey)
+		}
+		if prompted {
+			return result, fmt.Errorf("%w: %v", ErrPassphrase, err)
+		}
+		return result, fmt.Errorf("%w: %v", ErrNotEncrypted, err)
+	}
+	if !md.IsEncrypted && !md.IsSigned {
+		return result, ErrNotEncrypted
+	}
+
+	if err := copyStream(dst, md.UnverifiedBody); err != nil {
+		// A wrong passphrase or tampered ciphertext shows up as a failed MDC
+		// (integrity) check, a failed session-key decryption, or a key error
+		// once the body has been read.
+		var sessionKeyErr pgperrors.DecryptWithSessionKeyError
+		if errors.As(err, &sessionKeyErr) ||
+			errors.Is(err, pgperrors.ErrMDCHashMismatch) ||
+			errors.Is(err, pgperrors.ErrKeyIncorrect) {
+			return result, fmt.Errorf("%w: %v", ErrPassphrase, err)
+		}
+		return result, fmt.Errorf("pgp: decrypt: %w", err)
+	}
+
+	if md.IsSigned {
+		result.SignedByKeyID = md.SignedByKeyId
+		if md.SignedBy != nil {
+			result.SignedByName = signerName(md.SignedBy.Entity)
+			if md.SignatureError != nil {
+				result.Verified = false
+				return result, fmt.Errorf("%w: %v", ErrSignature, md.SignatureError)
+			}
+		} else {
+			// The message claims a signature by a key we were not given, so
+			// there is no way to trust it.
+			result.Verified = false
+			result.SignedByName = ""
+			return result, fmt.Errorf("%w: signed by unknown key %08X", ErrSignature, md.SignedByKeyId)
+		}
+	}
+	return result, nil
+}
+
+// EncryptKeysFile encrypts srcPath into dstPath with EncryptKeys: encrypted to
+// the given recipients' public keys and, when passphrase != "", also to the
+// passphrase, signed when signer != nil. The destination is created with mode
+// 0600 and is removed again if encryption fails, so no partial ciphertext is
+// ever left behind. It returns the number of bytes written to dstPath.
+func EncryptKeysFile(dstPath, srcPath, passphrase string, recipients []Key, signer Key, signerPass string) (int64, error) {
+	return transformFile(dstPath, srcPath, passphrase, func(dst io.Writer, src io.Reader, _ string) error {
+		return EncryptKeys(dst, src, passphrase, recipients, signer, signerPass)
+	})
+}
+
+// readArmoredKeyRing parses every armored block in r, as `gpg --armor
+// --export` writes them: concatenated, each block one or more keys.
+func readArmoredKeyRing(r io.Reader) ([]Key, error) {
+	var keys []Key
+	for {
+		block, err := armor.Decode(r)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			if len(keys) > 0 {
+				break // trailing junk after usable keys: ignore it
+			}
+			return nil, fmt.Errorf("%w: %v", ErrNoKeys, err)
+		}
+		if block.Type != openpgp.PublicKeyType && block.Type != openpgp.PrivateKeyType {
+			return nil, fmt.Errorf("%w: unexpected armor block type %q", ErrNoKeys, block.Type)
+		}
+		el, err := openpgp.ReadKeyRing(block.Body)
+		if err != nil && len(el) == 0 {
+			return nil, fmt.Errorf("pgp: parse keys: %w", err)
+		}
+		keys = append(keys, el...)
+	}
+	if len(keys) == 0 {
+		return nil, ErrNoKeys
+	}
+	return keys, nil
+}
+
+// unlockEntity decrypts the primary private key and every subkey of key with
+// the passphrase. A passphrase-less key or subkey is left alone.
+func unlockEntity(key Key, passphrase string) error {
+	for _, priv := range entityPrivateKeys(key) {
+		if err := decryptPrivateKey(priv, passphrase); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// entityPrivateKeys lists the primary private key and all subkey private
+// parts of an entity that exist.
+func entityPrivateKeys(entity *openpgp.Entity) []*packet.PrivateKey {
+	if entity == nil {
+		return nil
+	}
+	var keys []*packet.PrivateKey
+	if entity.PrivateKey != nil {
+		keys = append(keys, entity.PrivateKey)
+	}
+	for i := range entity.Subkeys {
+		if entity.Subkeys[i].PrivateKey != nil {
+			keys = append(keys, entity.Subkeys[i].PrivateKey)
+		}
+	}
+	return keys
+}
+
+// decryptPrivateKey unlocks one private key part. A wrong passphrase wraps
+// ErrPassphrase.
+func decryptPrivateKey(priv *packet.PrivateKey, passphrase string) error {
+	if !priv.Encrypted {
+		return nil
+	}
+	if err := priv.Decrypt([]byte(passphrase)); err != nil || priv.Encrypted {
+		return fmt.Errorf("%w: the passphrase does not unlock the private key", ErrPassphrase)
+	}
+	return nil
+}
+
+// keyConfig is the packet configuration used to protect generated private
+// keys: the same cipher and S2K as the message layer.
+func keyConfig() *packet.Config {
+	return config()
+}
+
+// signerName returns the primary identity of a signing key, "" when it has
+// none.
+func signerName(entity *openpgp.Entity) string {
+	if entity == nil {
+		return ""
+	}
+	if identity := entity.PrimaryIdentity(); identity != nil {
+		return identity.Name
+	}
+	return ""
+}
+
+// serializeArmored writes fn's packets into an armored block of the given
+// type.
+func serializeArmored(w io.Writer, blockType string, fn func(io.Writer, *packet.Config) error) error {
+	armored, err := armor.Encode(w, blockType, nil)
+	if err != nil {
+		return fmt.Errorf("pgp: armor: %w", err)
+	}
+	if err := fn(armored, config()); err != nil {
+		return fmt.Errorf("pgp: serialize key: %w", err)
+	}
+	if err := armored.Close(); err != nil {
+		return fmt.Errorf("pgp: armor: %w", err)
+	}
+	return nil
+}
+
+// writeBody streams src through the literal data packet that finishes the
+// message.
+func writeBody(payload io.WriteCloser, src io.Reader) error {
+	literal, err := packet.SerializeLiteral(payload, true, "", 0)
+	if err != nil {
+		return fmt.Errorf("pgp: encrypt: %w", err)
+	}
+	copyErr := copyStream(literal, src)
+	closeErr := literal.Close()
+	if copyErr != nil {
+		return fmt.Errorf("pgp: encrypt: %w", errors.Join(copyErr, closeErr))
+	}
+	if closeErr != nil {
+		return fmt.Errorf("pgp: finish encryption: %w", closeErr)
+	}
+	return nil
+}
+
+// signedBodyWriter hashes the data it streams into the literal data packet;
+// at Close it appends the signature packet and closes the encrypted payload.
+type signedBodyWriter struct {
+	payload io.WriteCloser // the SEIPD writer, closed only once, here
+	literal io.WriteCloser // the literal data writer over a no-op closer of payload
+	hash    hash.Hash      // SHA-256 of the message
+	signer  *packet.PrivateKey
+	cfg     *packet.Config
+}
+
+// writeSignedBody wraps src in a one-pass-signature signed literal data
+// packet over payload.
+func writeSignedBody(payload io.WriteCloser, src io.Reader, signer *packet.PrivateKey, cfg *packet.Config) error {
+	h := crypto.SHA256.New()
+	literal, err := packet.SerializeLiteral(noOpCloser{payload}, true, "", 0)
+	if err != nil {
+		return fmt.Errorf("pgp: sign: %w", err)
+	}
+	w := &signedBodyWriter{payload: payload, literal: literal, hash: h, signer: signer, cfg: cfg}
+
+	copyErr := copyStream(w, src)
+	closeErr := w.Close()
+	if copyErr != nil {
+		return fmt.Errorf("pgp: encrypt: %w", errors.Join(copyErr, closeErr))
+	}
+	if closeErr != nil {
+		return fmt.Errorf("pgp: finish encryption: %w", closeErr)
+	}
+	return nil
+}
+
+func (w *signedBodyWriter) Write(p []byte) (int, error) {
+	w.hash.Write(p)
+	return w.literal.Write(p)
+}
+
+// Close finishes the literal data, appends the signature packet, and closes
+// the encrypted payload. The signature is v4, binary, SHA-256, with the
+// issuer key id and fingerprint subpackets.
+func (w *signedBodyWriter) Close() error {
+	if err := w.literal.Close(); err != nil {
+		return errors.Join(err, w.payload.Close())
+	}
+	sig := &packet.Signature{
+		Version:           4,
+		SigType:           packet.SigTypeBinary,
+		PubKeyAlgo:        w.signer.PubKeyAlgo,
+		Hash:              crypto.SHA256,
+		CreationTime:      w.cfg.Now(),
+		IssuerKeyId:       &w.signer.KeyId,
+		IssuerKeyVersion:  uint8(w.signer.Version),
+		IssuerFingerprint: w.signer.Fingerprint,
+	}
+	if err := sig.Sign(w.hash, w.signer, w.cfg); err != nil {
+		return errors.Join(err, w.payload.Close())
+	}
+	if err := sig.Serialize(w.payload); err != nil {
+		return errors.Join(err, w.payload.Close())
+	}
+	return w.payload.Close()
+}
+
+// noOpCloser is an io.WriteCloser whose Close does nothing, so a writer we
+// still need to write to later (the signature packet) is not closed early.
+type noOpCloser struct {
+	io.Writer
+}
+
+func (noOpCloser) Close() error { return nil }
