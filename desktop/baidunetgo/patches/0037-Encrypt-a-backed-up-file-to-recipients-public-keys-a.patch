+// TestKeysStreamingSpeed encrypts and decrypts 8 MiB with one recipient and
+// logs the elapsed time as a sanity check that nothing buffers the whole file
+// (a strict gate would be flaky on loaded CI machines).
+func TestKeysStreamingSpeed(t *testing.T) {
+	testKeys(t)
+	plain := randomBytes(t, 8<<20)
+	recipients := mustParsePublic(t, alicePubArm)
+
+	start := time.Now()
+	var cipher bytes.Buffer
+	if err := EncryptKeys(&cipher, bytes.NewReader(plain), "", recipients, nil, ""); err != nil {
+		t.Fatalf("EncryptKeys: %v", err)
+	}
+	encryptTime := time.Since(start)
+
+	start = time.Now()
+	var got bytes.Buffer
+	if _, err := DecryptAny(&got, bytes.NewReader(cipher.Bytes()), "", []Key{alice(t)}); err != nil {
+		t.Fatalf("DecryptAny: %v", err)
+	}
+	decryptTime := time.Since(start)
+
+	if !bytes.Equal(got.Bytes(), plain) {
+		t.Fatal("8 MiB round trip mismatch")
+	}
+	t.Logf("8 MiB with one recipient: encrypt %v, decrypt %v", encryptTime, decryptTime)
+	if encryptTime > 30*time.Second || decryptTime > 30*time.Second {
+		t.Errorf("8 MiB took encrypt %v / decrypt %v; streaming looks broken", encryptTime, decryptTime)
+	}
+}
