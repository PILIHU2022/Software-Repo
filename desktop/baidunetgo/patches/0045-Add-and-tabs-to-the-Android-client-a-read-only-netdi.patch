+/**
+ * 文件: a read-only browser of the netdisk. Folders open in place, files open a
+ * details dialog; nothing is downloaded or changed here.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun FilesScreen(
+    state: AppUiState,
+    vm: AppViewModel,
+    modifier: Modifier = Modifier,
+) {
+    val files = state.files
+    var detail by remember { mutableStateOf<RemoteFile?>(null) }
+
+    // Load "/" the first time the tab is shown; after that the ViewModel keeps
+    // the listing until the user refreshes or opens another folder.
+    LaunchedEffect(Unit) {
+        if (!state.files.loaded) vm.filesEnter()
+    }
+    // The system back unwinds our own path stack before it leaves the app.
+    BackHandler(enabled = files.stack.isNotEmpty()) { vm.filesBack() }
+
+    PullToRefreshBox(
+        isRefreshing = files.refreshing,
+        onRefresh = vm::refreshFiles,
+        modifier = modifier.fillMaxSize(),
+    ) {
+        LazyColumn(
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = PaddingValues(vertical = 8.dp),
+        ) {
+            item(key = "files-header") {
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 8.dp, vertical = 4.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    if (files.stack.isNotEmpty()) {
+                        IconButton(onClick = vm::filesUp) {
+                            Icon(
+                                imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                                contentDescription = stringResource(R.string.files_up),
+                            )
+                        }
+                    }
+                    Text(
+                        text = files.path.ifBlank { "/" },
+                        style = MaterialTheme.typography.titleSmall,
+                        color = MaterialTheme.colorScheme.primary,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                        modifier = Modifier
+                            .weight(1f)
+                            .padding(horizontal = 8.dp),
+                    )
+                }
+            }
+
+            when {
+                files.loading || (!files.loaded && files.error == null) -> {
+                    item(key = "files-loading") {
+                        Box(
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .padding(vertical = 48.dp),
+                            contentAlignment = Alignment.Center,
+                        ) {
+                            CircularProgressIndicator()
+                        }
+                    }
+                }
+
+                files.error != null -> {
+                    item(key = "files-error") {
+                        EmptyState(
+                            icon = Icons.Filled.ErrorOutline,
+                            title = stringResource(R.string.files_load_failed),
+                            hint = files.error,
+                            actionLabel = stringResource(R.string.files_retry),
+                            onAction = vm::refreshFiles,
+                        )
+                    }
+                }
+
+                files.entries.isEmpty() -> {
+                    item(key = "files-empty") {
+                        EmptyState(
+                            icon = Icons.Filled.FolderOpen,
+                            title = stringResource(R.string.files_empty_title),
+                            hint = stringResource(R.string.files_empty_hint),
+                        )
+                    }
+                }
+
+                else -> {
+                    items(items = files.entries, key = { entry -> "${entry.fsId}:${entry.name}" }) { entry ->
+                        FilesRow(
+                            entry = entry,
+                            onOpenDir = { vm.openFilesDir(fullPath(files.path, entry.name)) },
+                            onDetails = { detail = entry },
+                        )
+                    }
+                }
+            }
+        }
+    }
+
+    detail?.let { entry ->
+        FileDetailsDialog(
+            path = fullPath(files.path, entry.name),
+            entry = entry,
+            onDismiss = { detail = null },
+        )
+    }
+}
