+/**
+ * 查重: finds files that hold the same content and moves spare copies to the
+ * recycle bin. Mirrors the desktop page: the whole netdisk (or a chosen folder)
+ * is scanned, the results show either by duplicate group or by folder, both
+ * foldable, and the chosen copies are rechecked against the netdisk before the
+ * delete.
+ */
+@Composable
+fun DedupScreen(
+    state: AppUiState,
+    vm: AppViewModel,
+    modifier: Modifier = Modifier,
+) {
+    val dedup = state.dedup
+
+    // Entering the tab starts the scan by itself, as the desktop page does; a
+    // scan in flight, a failed one or an existing result leaves it to the user.
+    LaunchedEffect(Unit) {
+        if (!dedup.loaded && !dedup.scanning && dedup.error == null) {
+            vm.startDedupScan(dedup.root)
+        }
+    }
+
+    Column(modifier = modifier.fillMaxSize()) {
+        LazyColumn(
+            modifier = Modifier
+                .weight(1f)
+                .fillMaxWidth(),
+            contentPadding = PaddingValues(16.dp),
+            verticalArrangement = Arrangement.spacedBy(10.dp),
+        ) {
+            item(key = "dedup-header") { DedupHeader(dedup = dedup, vm = vm) }
+
+            when {
+                dedup.error != null -> item(key = "dedup-error") {
+                    EmptyState(
+                        icon = Icons.Filled.ErrorOutline,
+                        title = stringResource(R.string.dedup_error_title),
+                        hint = dedup.error,
+                        actionLabel = stringResource(R.string.dedup_retry),
+                        onAction = { vm.startDedupScan(dedup.root) },
+                    )
+                }
+
+                dedup.scanning -> item(key = "dedup-scanning") { DedupProgress(dedup) }
+
+                // Idle before the first scan and after a cancelled one: offer
+                // to scan rather than showing a spinner that never ends.
+                !dedup.loaded -> item(key = "dedup-idle") {
+                    EmptyState(
+                        icon = Icons.Filled.ContentCopy,
+                        title = stringResource(R.string.dedup_idle_title),
+                        hint = stringResource(R.string.dedup_idle_hint),
+                        actionLabel = stringResource(R.string.dedup_start),
+                        onAction = { vm.startDedupScan(dedup.root) },
+                    )
+                }
+
+                dedup.groups.isEmpty() -> item(key = "dedup-empty") {
+                    EmptyState(
+                        icon = Icons.Filled.ContentCopy,
+                        title = stringResource(R.string.dedup_empty_title),
+                        hint = stringResource(R.string.dedup_empty_hint),
+                    )
+                }
+
+                else -> {
+                    val rows = if (dedup.view == 1) {
+                        DedupModel.folderRows(dedup.groups, dedup.root, dedup.foldersFolded)
+                    } else {
+                        DedupModel.groupRows(dedup.groups, dedup.groupsFolded)
+                    }
+                    val folders = if (dedup.view == 1) dedup.dirs else emptyList()
+                    items(items = rows, key = { row -> rowKey(row, dedup, folders) }) { row ->
+                        DedupRowView(row = row, dedup = dedup, folders = folders, vm = vm)
+                    }
+                }
+            }
+        }
+
+        if (dedup.loaded && dedup.groups.isNotEmpty()) {
+            DedupBar(dedup = dedup, vm = vm)
+        }
+    }
+
+    if (dedup.confirmDelete) {
+        ConfirmDialog(
+            title = stringResource(R.string.dedup_confirm_title),
+            message = stringResource(
+                R.string.dedup_confirm_message,
+                dedup.selCount,
+                AppFormat.bytes(dedup.selBytes),
+            ),
+            confirmLabel = stringResource(R.string.dedup_confirm_action),
