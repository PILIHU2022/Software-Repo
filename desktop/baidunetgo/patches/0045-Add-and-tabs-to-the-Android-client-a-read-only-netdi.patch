+    }
+
+    fun cancelDedupDelete() {
+        _ui.update { state -> state.copy(dedup = state.dedup.copy(confirmDelete = false)) }
+    }
+
+    /**
+     * Moves the chosen copies to the recycle bin, after re-reading every
+     * affected folder and keeping only the files that are still the ones
+     * scanned (same md5, size and fsId) and whose group keeps a copy.
+     */
+    fun confirmDedupDelete() {
+        val dedup = _ui.value.dedup
+        if (dedup.busy || dedup.scanning) return
+        if (dedup.chosen.isEmpty()) return
+        val full = dedup.groups.firstOrNull { g ->
+            g.files.isNotEmpty() && g.files.all { it.path in dedup.chosen }
+        }
+        if (full != null) {
+            _ui.update { state -> state.copy(dedup = state.dedup.copy(confirmDelete = false)) }
+            _messages.tryEmit(str(R.string.dedup_keep_one_required))
+            return
+        }
+        val groupsSnapshot = dedup.groups
+        val chosenSnapshot = dedup.chosen
+        _ui.update { state ->
+            state.copy(dedup = state.dedup.copy(confirmDelete = false, busy = true, actError = null))
+        }
+        dedupJob = viewModelScope.launch {
+            try {
+                val (safe, changed) = withContext(Dispatchers.IO) {
+                    dedupStillThere(container.api, groupsSnapshot, chosenSnapshot)
+                }
+                val deleted = if (safe.isEmpty()) {
+                    emptySet()
+                } else {
+                    val paths = safe.map { it.path }
+                    withContext(Dispatchers.IO) { container.api.delete(paths) }
+                    paths.toSet()
+                }
+                _ui.update { state ->
+                    val remaining = Dedup.without(state.dedup.groups, deleted)
+                    state.copy(
+                        dedup = state.dedup.copy(
+                            busy = false,
+                            groups = remaining,
+                            scannedFiles = (state.dedup.scannedFiles - deleted.size).coerceAtLeast(0),
+                            chosen = DedupModel.defaultSelection(remaining),
+                        ),
+                    )
+                }
+                val message = if (changed > 0) {
+                    str(R.string.dedup_deleted_changed, deleted.size, changed)
+                } else {
+                    str(R.string.dedup_deleted, deleted.size)
+                }
+                _messages.tryEmit(message)
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: NotLoggedInException) {
+                withContext(Dispatchers.IO) { container.sessionStore.clear() }
+                _ui.update {
+                    it.copy(
+                        session = SessionState.SignedOut,
+                        account = null,
+                        dedup = it.dedup.copy(busy = false),
+                    )
+                }
+                _messages.tryEmit(str(R.string.error_session_expired))
+            } catch (e: Exception) {
+                _ui.update {
+                    it.copy(dedup = it.dedup.copy(busy = false, actError = e.displayMessage()))
+                }
+                _messages.tryEmit(str(R.string.error_generic, e.displayMessage()))
+            }
+        }
+    }
+
+    /**
+     * Re-reads the folders of the groups that have chosen files and returns the
+     * copies the netdisk still holds unchanged. A group whose kept copy is gone
+     * or changed loses all its chosen copies, so no group is left without one;
+     * [changedCount] counts everything left out.
+     */
+    private suspend fun dedupStillThere(
+        api: BaiduApi,
+        groups: List<DedupGroup>,
+        chosen: Set<String>,
+    ): Pair<List<DedupFile>, Int> {
+        val dirs = HashSet<String>()
+        for (group in groups) {
+            if (group.files.none { it.path in chosen }) continue
+            for (file in group.files) dirs.add(DedupModel.parentDir(file.path))
+        }
+        val have = HashMap<String, RemoteFile>()
+        for (dir in dirs) {
+            val entries = runCatching { api.list(dir) }.getOrNull() ?: continue
+            for (entry in entries) {
+                val path = if (dir == "/") "/${entry.name}" else "$dir/${entry.name}"
+                have[path] = entry
+            }
+        }
+        fun same(file: DedupFile): Boolean {
+            val held = have[file.path] ?: return false
+            return held.size == file.size && held.md5 == file.md5 &&
+                (file.fsId == 0L || held.fsId == file.fsId)
+        }
+        val safe = ArrayList<DedupFile>()
+        var changed = 0
+        for (group in groups) {
+            if (group.files.none { it.path in chosen }) continue
+            val keep = group.files.any { it.path !in chosen && same(it) }
+            for (file in group.files) {
+                if (file.path !in chosen) continue
+                if (!keep || !same(file)) {
+                    changed++
+                } else {
+                    safe.add(file)
+                }
+            }
+        }
+        return safe to changed
+    }
