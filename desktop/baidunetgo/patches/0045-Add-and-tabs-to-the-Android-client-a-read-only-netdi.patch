+    }
+
+    /** Chooses every copy of group [gi] but its kept one. */
+    fun dedupKeepOne(gi: Int) {
+        _ui.update { state ->
+            val groups = state.dedup.groups
+            if (gi !in groups.indices) return@update state
+            val chosen = state.dedup.chosen.toMutableSet()
+            groups[gi].files.forEach { chosen.remove(it.path) }
+            groups[gi].files.forEachIndexed { i, file -> if (i > 0) chosen.add(file.path) }
