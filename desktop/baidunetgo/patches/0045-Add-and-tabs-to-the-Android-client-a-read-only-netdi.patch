+/**
+ * A stable key for a result row, so folds do not rebuild unrelated rows. The
+ * folder list is passed in rather than read from `dedup.dirs`, whose getter
+ * rebuilds every folder — that must not happen once per row.
+ */
+private fun rowKey(row: DedupModel.Row, dedup: DedupUi, folders: List<DedupModel.Folder>): Any =
+    when (row.kind) {
+        DedupModel.RowKind.GroupHeading -> {
+            val key = dedup.groups[row.group].key
+            "group:${key.size}:${key.md5}"
+        }
+
+        DedupModel.RowKind.FolderHeading -> "folder:${folders[row.dir].path}"
+
+        DedupModel.RowKind.File -> dedup.groups[row.group].files[row.file].path
+    }
