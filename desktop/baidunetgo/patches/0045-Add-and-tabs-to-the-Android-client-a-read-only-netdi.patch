+package com.pengstem.baidunetgo.ui.dedup
+
+import com.pengstem.baidunetgo.core.dedup.DedupGroup
+import com.pengstem.baidunetgo.core.dedup.DedupKey
+
+/**
+ * The pure part of the duplicate finder: turning the scan's groups into the
+ * lines of either view, and the default choice and totals over them.
+ *
+ * It holds no Android type, so it is unit-testable on the JVM without
+ * Robolectric. The two views are only an order of lines — the groups, the
+ * chosen paths and the scan lie under both — exactly as the desktop page's
+ * `flatten`/`flattenFolders` do.
+ */
+object DedupModel {
+
+    /** A copy as the folder view lists it: the group it is of and the file in it. */
+    data class FileRef(val group: Int, val file: Int)
+
+    /** One folder of the folder view: its path, its label under the root, its copies and what they free. */
+    data class Folder(
+        val path: String,
+        val label: String,
+        val files: List<FileRef>,
+        val reclaim: Long,
+    )
+
+    enum class RowKind { GroupHeading, FolderHeading, File }
+
+    /**
+     * One line of the results. [group]/[file] index into the groups for a group
+     * heading or a file; [dir] indexes the folder view's folders (or -1 in the
+     * group view); [folded] is set on a heading whose copies are hidden.
+     */
+    data class Row(
+        val kind: RowKind,
+        val group: Int = -1,
+        val file: Int = -1,
+        val dir: Int = -1,
+        val folded: Boolean = false,
+    )
+
+    /**
+     * The folders of the folder view: every folder that holds a copy of a
+     * repeating file, its label relative to [root], the copies it holds and
+     * what deleting its spare ones would free. Folders come by reclaim desc,
+     * their path breaking a tie.
+     */
+    fun folders(groups: List<DedupGroup>, root: String): List<Folder> {
+        val order = LinkedHashMap<String, MutableList<FileRef>>()
+        val reclaim = HashMap<String, Long>()
+        groups.forEachIndexed { gi, group ->
+            group.files.forEachIndexed { fi, file ->
+                val dir = parentDir(file.path)
+                order.getOrPut(dir) { ArrayList() }.add(FileRef(gi, fi))
+                // The group's kept copy is its first, so only the other copies
+                // here are what a delete in this folder alone would free.
+                if (fi > 0) reclaim[dir] = (reclaim[dir] ?: 0L) + file.size
+            }
+        }
+        return order.map { (dir, refs) ->
+            Folder(
+                path = dir,
+                label = dirLabel(root, dir),
+                files = refs.toList(),
+                reclaim = reclaim[dir] ?: 0L,
+            )
+        }.sortedWith(compareByDescending<Folder> { it.reclaim }.thenBy { it.path })
+    }
+
+    /** The group view's lines: a group's heading over its copies, copies hidden while the group is folded. */
+    fun groupRows(groups: List<DedupGroup>, groupsFolded: Set<DedupKey>): List<Row> {
+        val rows = ArrayList<Row>()
+        groups.forEachIndexed { gi, group ->
+            val folded = group.key in groupsFolded
+            rows.add(Row(RowKind.GroupHeading, group = gi, folded = folded))
+            if (folded) return@forEachIndexed
+            group.files.forEachIndexed { fi, _ ->
+                rows.add(Row(RowKind.File, group = gi, file = fi))
+            }
+        }
+        return rows
+    }
+
+    /** The folder view's lines: a folder's heading over the copies it holds, hidden while the folder is folded. */
+    fun folderRows(groups: List<DedupGroup>, root: String, foldersFolded: Set<String>): List<Row> {
+        val folders = folders(groups, root)
+        val rows = ArrayList<Row>()
+        folders.forEachIndexed { di, folder ->
+            val folded = folder.path in foldersFolded
+            rows.add(Row(RowKind.FolderHeading, dir = di, folded = folded))
+            if (folded) return@forEachIndexed
+            folder.files.forEach { ref ->
+                rows.add(Row(RowKind.File, group = ref.group, file = ref.file, dir = di))
+            }
+        }
+        return rows
+    }
+
+    /** Every copy but each group's kept one (its first, the earliest modified). */
+    fun defaultSelection(groups: List<DedupGroup>): Set<String> {
+        val chosen = HashSet<String>()
+        for (group in groups) {
+            for (i in 1 until group.files.size) chosen.add(group.files[i].path)
+        }
+        return chosen
+    }
+
+    /** What is chosen and what every group could free. */
+    data class Totals(val selCount: Int, val selBytes: Long, val totalReclaim: Long)
+
+    fun totals(groups: List<DedupGroup>, chosen: Set<String>): Totals {
+        var count = 0
+        var bytes = 0L
+        var reclaim = 0L
+        for (group in groups) {
+            reclaim += group.reclaim
+            for (file in group.files) {
+                if (file.path in chosen) {
+                    count++
+                    bytes += file.size
+                }
+            }
+        }
+        return Totals(count, bytes, reclaim)
+    }
+
+    /** A folder's path as the folder view heads it: under [root], which shows as 我的文件. */
+    fun dirLabel(root: String, dir: String): String {
+        val base = if (root.isBlank()) "/" else root
+        return when {
+            dir == base -> "我的文件"
+            base == "/" -> dir.removePrefix("/")
+            else -> dir.removePrefix(base).removePrefix("/")
+        }
+    }
+
+    /**
+     * The "另 N 处 · size" note for a folder-view copy whose group also lives in
+     * other folders, or null when the group keeps to this one.
+     */
+    fun groupNote(group: DedupGroup, dir: String): String? {
+        val others = LinkedHashSet<String>()
+        var here = 0
+        for (file in group.files) {
+            val d = parentDir(file.path)
+            if (d == dir) here++ else others.add(d)
+        }
+        if (others.isEmpty()) return null
+        val copies = group.files.size - here
+        return "另 ${others.size} 处 · ${com.pengstem.baidunetgo.core.ByteSize.format(group.size * copies)}"
+    }
+
+    /** The folder a netdisk path is in, "/" for a top-level entry. */
+    fun parentDir(path: String): String {
+        val slash = path.lastIndexOf('/')
+        return if (slash <= 0) "/" else path.substring(0, slash)
+    }
+}
