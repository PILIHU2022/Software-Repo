+++ b/android/app/src/test/java/com/pengstem/baidunetgo/ui/dedup/DedupModelTest.kt
@@ -0,0 +1,107 @@
+package com.pengstem.baidunetgo.ui.dedup
+
+import com.pengstem.baidunetgo.core.dedup.Dedup
+import com.pengstem.baidunetgo.core.dedup.DedupFile
+import com.pengstem.baidunetgo.core.dedup.DedupGroup
+import com.pengstem.baidunetgo.core.dedup.DedupKey
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The pure duplicate-finder model: default choice, the two views' folds, the
+ * folder view's ordering and regrouping after a delete. No Robolectric.
+ */
+class DedupModelTest {
+
+    private fun file(path: String, size: Long, md5: String = "m", modified: Long = 0, fsId: Long = 0): DedupFile =
+        DedupFile(
+            path = path,
+            name = path.substringAfterLast('/'),
+            size = size,
+            fsId = fsId,
+            md5 = md5,
+            modified = modified,
+        )
+
+    /** A group whose copies come earliest modified first, its path breaking a tie. */
+    private fun group(size: Long, md5: String, vararg paths: String): DedupGroup {
+        val files = paths.mapIndexed { i, p -> file(p, size, md5, modified = i.toLong()) }
+        return DedupGroup(key = DedupKey(size, md5), files = files)
+    }
+
+    @Test
+    fun defaultSelectionIsEveryCopyButTheKeptOne() {
+        val g = group(100, "a", "/a/x", "/a/y", "/b/z")
+        val chosen = DedupModel.defaultSelection(listOf(g))
+        assertEquals(setOf("/a/y", "/b/z"), chosen)
+        // files[0] is the earliest modified, the copy kept by default.
+        assertTrue("/a/x" !in chosen)
+    }
+
+    @Test
+    fun foldingAGroupHidesItsCopiesInTheGroupView() {
+        val g1 = group(100, "a", "/a/x", "/a/y")
+        val g2 = group(200, "b", "/c/p", "/c/q")
+        val rows = DedupModel.groupRows(listOf(g1, g2), setOf(g1.key))
+
+        // Two headings, and only the unfolded group's copies remain.
+        assertEquals(2, rows.count { it.kind == DedupModel.RowKind.GroupHeading })
+        assertEquals(2, rows.count { it.kind == DedupModel.RowKind.File })
+        val heading1 = rows.first { it.kind == DedupModel.RowKind.GroupHeading && it.group == 0 }
+        assertTrue(heading1.folded)
+        // No file row may point at the folded group.
+        assertTrue(rows.none { it.kind == DedupModel.RowKind.File && it.group == 0 })
+    }
+
+    @Test
+    fun foldingAFolderHidesItsCopiesInTheFolderView() {
+        // /a holds two copies, /b one: /a comes first (it frees the most).
+        val g = group(100, "a", "/a/x", "/a/y", "/b/z")
+        val rows = DedupModel.folderRows(listOf(g), "/", setOf("/a"))
+        val headings = rows.filter { it.kind == DedupModel.RowKind.FolderHeading }
+        assertEquals(listOf("/a", "/b"), headings.map { DedupModel.folders(listOf(g), "/")[it.dir].path })
+        // Only /b's one copy stays visible.
+        val fileRows = rows.filter { it.kind == DedupModel.RowKind.File }
+        assertEquals(1, fileRows.size)
+        assertEquals("/b/z", listOf(g)[fileRows[0].group].files[fileRows[0].file].path)
+    }
+
+    @Test
+    fun folderViewListsACopyOnceAndOrdersFoldersByReclaimDesc() {
+        // /a holds the kept copy and two spares (frees 200); /b holds one spare (frees 100).
+        val g = group(100, "a", "/a/x", "/a/y", "/a/w", "/b/z")
+        val folders = DedupModel.folders(listOf(g), "/")
+
+        assertEquals(listOf("/a", "/b"), folders.map { it.path })
+        assertEquals(200L, folders[0].reclaim)
+        assertEquals(100L, folders[1].reclaim)
+        // Each copy is listed under its own folder exactly once.
+        val allPaths = folders.flatMap { f -> f.files.map { g.files[it.file].path } }
+        assertEquals(listOf("/a/x", "/a/y", "/a/w", "/b/z"), allPaths)
+        assertEquals(4, allPaths.toSet().size)
+        // The folder label is relative to the root.
+        assertEquals("a", folders[0].label)
+    }
+
+    @Test
+    fun dirLabelShowsTheRootAsMyFiles() {
+        assertEquals("我的文件", DedupModel.dirLabel("/", "/"))
+        assertEquals("文档/发票", DedupModel.dirLabel("/", "/文档/发票"))
+        assertEquals("我的文件", DedupModel.dirLabel("/备份", "/备份"))
+        assertEquals("手机", DedupModel.dirLabel("/备份", "/备份/手机"))
+        assertNull(DedupModel.groupNote(group(100, "a", "/a/x", "/a/y"), "/a"))
+    }
+
+    @Test
+    fun withoutDeleteDropsAGroupBelowTwo() {
+        val g = group(100, "a", "/a/x", "/a/y", "/b/z")
+        val oneGone = Dedup.without(listOf(g), setOf("/b/z"))
+        assertEquals(1, oneGone.size)
+        assertEquals(2, oneGone[0].files.size)
+
+        val twoGone = Dedup.without(listOf(g), setOf("/b/z", "/a/y"))
+        assertTrue(twoGone.isEmpty())
+    }
+}
