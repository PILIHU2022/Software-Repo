+/** One listing row: a folder opens, a file opens its details. */
+@Composable
+private fun FilesRow(
+    entry: RemoteFile,
+    onOpenDir: () -> Unit,
+    onDetails: () -> Unit,
+) {
+    val subtitle = if (entry.isDir) {
+        null
+    } else {
+        stringResource(
+            R.string.files_row_subtitle,
+            AppFormat.bytes(entry.size),
+            AppFormat.time(entry.modified * 1000L),
+        )
+    }
+    ListItem(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clickable { if (entry.isDir) onOpenDir() else onDetails() },
+        colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+        leadingContent = {
+            Icon(
+                imageVector = if (entry.isDir) Icons.Filled.FolderOpen else fileIcon(entry.name),
+                contentDescription = null,
+                tint = if (entry.isDir) {
+                    MaterialTheme.colorScheme.primary
+                } else {
+                    MaterialTheme.colorScheme.onSurfaceVariant
+                },
+            )
+        },
+        headlineContent = {
+            Text(text = entry.name, maxLines = 1, overflow = TextOverflow.Ellipsis)
+        },
+        supportingContent = subtitle?.let { text -> { Text(text = text) } },
+        trailingContent = if (entry.isDir) {
+            {
+                Icon(
+                    imageVector = Icons.AutoMirrored.Filled.KeyboardArrowRight,
+                    contentDescription = stringResource(R.string.files_folder),
+                    tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+        } else {
+            null
+        },
+    )
+}
+
+/** Read-only details of a file: name, full path, size, modified time and MD5. */
+@Composable
+private fun FileDetailsDialog(
+    path: String,
+    entry: RemoteFile,
+    onDismiss: () -> Unit,
+) {
+    ExpressiveDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(R.string.files_detail_title)) },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                LabeledValue(label = stringResource(R.string.files_name), value = entry.name)
+                LabeledValue(label = stringResource(R.string.files_path), value = path)
+                LabeledValue(label = stringResource(R.string.files_size), value = AppFormat.bytes(entry.size))
+                LabeledValue(
+                    label = stringResource(R.string.files_modified),
+                    value = AppFormat.time(entry.modified * 1000L),
+                )
+                LabeledValue(
+                    label = stringResource(R.string.files_md5),
+                    value = entry.md5.ifBlank { "—" },
+                )
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = onDismiss) { Text(stringResource(R.string.action_close)) }
+        },
+    )
+}
+
+/** The netdisk path of an entry of [dir]. */
+private fun fullPath(dir: String, name: String): String =
+    if (dir.isBlank() || dir == "/") "/$name" else "$dir/$name"
+
+/** A file-type icon chosen from the extension (picture/movie/music/pdf/archive/generic). */
+private fun fileIcon(name: String): ImageVector {
+    val extension = name.substringAfterLast('.', "").lowercase()
+    return when (extension) {
+        "jpg", "jpeg", "png", "gif", "webp", "bmp", "heic", "heif", "svg", "tif", "tiff" ->
+            Icons.Filled.Image
+
+        "mp4", "mkv", "avi", "mov", "wmv", "flv", "webm", "m4v", "ts", "mpg", "mpeg", "3gp" ->
+            Icons.Filled.Movie
+
+        "mp3", "flac", "wav", "aac", "ogg", "m4a", "wma", "opus", "ape" ->
+            Icons.Filled.MusicNote
+
+        "pdf" -> Icons.Filled.PictureAsPdf
+
+        "zip", "rar", "7z", "tar", "gz", "bz2", "xz", "tgz" -> Icons.Filled.FolderZip
+
+        else -> Icons.AutoMirrored.Filled.InsertDriveFile
+    }
+}
