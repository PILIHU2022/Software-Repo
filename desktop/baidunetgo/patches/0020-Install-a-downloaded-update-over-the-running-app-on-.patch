+// installUpdate installs the downloaded package over the running app and
+// restarts it. The package holds the same binary the app runs, so it is
+// written in place, which keeps the user's install where it is; a package a
+// system package manager owns refuses that and says so (docs/UPDATES.md).
+// The install runs on a goroutine, and the restart waits for the update that
+// reports it, so the toast is queued before the window goes.
+func (a *App) installUpdate() {
+	st := &a.updates
+	if st.lastPath == "" || st.installing || st.installed || st.downloading || st.checking {
+		return
+	}
+	path := st.lastPath
+	ver := ""
+	if st.found != nil {
+		ver = st.found.Version
+	}
+	st.installing, st.installErr = true, ""
+	go func() {
+		_, err := updatesInstall(path)
+		a.update(func() {
+			st := &a.updates
+			st.installing = false
+			if err != nil {
+				// The package stays where it was downloaded, so the
+				// message's manual install is one step away.
+				st.installErr = err.Error()
+				a.toast("安装失败："+err.Error(), "error")
+				return
+			}
+			st.installed = true
+			msg := "已安装"
+			if ver != "" {
+				msg += " " + ver
+			}
+			a.toast(msg+"，正在重启…", "success")
+			a.update(func() { mygo.App.Relaunch() })
+		})
+	}()
+}
