diff --git a/internal/updates/install.go b/internal/updates/install.go
new file mode 100644
index 0000000..fd3d3ab
--- /dev/null
+++ b/internal/updates/install.go
@@ -0,0 +1,275 @@
+package updates
+
+import (
+	"archive/tar"
+	"archive/zip"
+	"compress/gzip"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+// CanInstall reports whether this build may put a downloaded package over
+// the running app: only Linux, where an app unpacked into the user's home is
+// a plain file the user can write over, and never Windows or macOS, where
+// the program or bundle is replaced by its installer, not underneath itself.
+func CanInstall() bool { return canInstallOn(runtime.GOOS) }
+
+// canInstallOn is CanInstall for any GOOS, so a test can ask about the
+// platforms the one it runs on is not.
+func canInstallOn(goos string) bool { return goos == "linux" }
+
+// Install replaces the running app with the package at archivePath and
+// reports the binary it wrote. os.Executable may name a launcher's symbolic
+// link (a command in ~/.local/bin beside the app's own folder), and a link
+// must not be overwritten with a binary, so the real file is found first.
+func Install(archivePath string) (string, error) {
+	if !CanInstall() {
+		return "", errors.New("这个系统不支持在应用内安装更新，请手动安装下载的包")
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		return "", fmt.Errorf("无法找到正在运行的程序：%v", err)
+	}
+	if real, err := filepath.EvalSymlinks(exe); err == nil {
+		exe = real
+	}
+	return installTo(archivePath, exe)
+}
+
+// installTo installs the package over exe and returns exe. It is apart from
+// Install so that a test can point it at a folder of its own instead of the
+// running program.
+func installTo(archivePath, exe string) (string, error) {
+	if runtime.GOOS == "windows" {
+		// Windows locks a running executable against being written or
+		// renamed over, so an app cannot replace itself while it runs.
+		return "", errors.New("正在运行的程序无法被替换：请退出应用后手动安装下载的包")
+	}
+	pkg, err := openPackage(archivePath)
+	if err != nil {
+		return "", err
+	}
+	defer pkg.close()
+	name, err := pickBinary(pkg.entries, filepath.Base(exe))
+	if err != nil {
+		return "", err
+	}
+
+	dir := filepath.Dir(exe)
+	// The package is written beside the running binary and then renamed over
+	// it, so a half-written file never stands for the app. Making that file is
+	// also the check that the folder is writable: a package installed by
+	// pacman lives in /opt, which only root may write.
+	tmp, err := os.CreateTemp(dir, "."+filepath.Base(exe)+".install-*")
+	if err != nil {
+		return "", fmt.Errorf("程序位于 %s，当前用户不能写入（可能由 pacman 或系统包管理器安装）：请用包管理器更新，或手动安装下载的包", dir)
+	}
+	installed := false
+	defer func() {
+		if installed {
+			return
+		}
+		tmp.Close()
+		os.Remove(tmp.Name()) // a failed install leaves nothing behind
+	}()
+	if err := pkg.read(name, tmp); err != nil {
+		return "", err
+	}
+	if err := tmp.Sync(); err != nil {
+		return "", fmt.Errorf("无法写入 %s：%v", exe, err)
+	}
+	if err := tmp.Close(); err != nil {
+		return "", fmt.Errorf("无法写入 %s：%v", exe, err)
+	}
+	if err := os.Chmod(tmp.Name(), 0o755); err != nil {
+		return "", fmt.Errorf("无法设置 %s 的权限：%v", exe, err)
+	}
+	// The file being replaced is kept beside it, so a package that turns out
+	// wrong can be undone by hand; failing to keep it does not stop the
+	// install, which is already the newer version either way.
+	copyOld(exe)
+	if err := os.Rename(tmp.Name(), exe); err != nil {
+		return "", fmt.Errorf("无法替换 %s：%v", exe, err)
+	}
+	installed = true
+	return exe, nil
+}
+
+// copyOld writes the binary at exe to exe.old, best effort.
+func copyOld(exe string) {
+	src, err := os.Open(exe)
+	if err != nil {
+		return
+	}
+	defer src.Close()
+	dst, err := os.OpenFile(exe+".old", os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o755)
+	if err != nil {
+		return
+	}
+	if _, err := io.Copy(dst, src); err != nil {
+		dst.Close()
+		os.Remove(exe + ".old")
+		return
+	}
+	dst.Close()
+}
+
+// packageEntry is one regular file of a package, looked up before anything is
+// extracted.
+type packageEntry struct {
+	name string
+	size int64
+}
+
+// packageReader is a package opened for reading: the regular files it holds,
+// and a way to read one of them out.
+type packageReader struct {
+	entries []packageEntry
+	read    func(name string, w io.Writer) error
+	close   func()
+}
+
+// openPackage opens a package by its extension: the Linux feed serves the
+// mygo build's .tar.gz, while a .zip (Windows' package) may reach this code
+// when the user downloaded it by hand on Linux.
+func openPackage(path string) (*packageReader, error) {
+	lower := strings.ToLower(path)
+	switch {
+	case strings.HasSuffix(lower, ".tar.gz"), strings.HasSuffix(lower, ".tgz"):
+		return openTarGz(path)
+	case strings.HasSuffix(lower, ".zip"):
+		return openZip(path)
+	}
+	return nil, fmt.Errorf("不支持的安装包 %s：这个包需要手动安装", filepath.Base(path))
+}
+
+// openTarGz opens a gzipped tar package. gzip cannot seek, so the archive is
+// read once to list its files and opened again to extract the chosen one,
+// which keeps a large package out of memory.
+func openTarGz(path string) (*packageReader, error) {
+	list, err := tarGzEntries(path)
+	if err != nil {
+		return nil, err
+	}
+	read := func(name string, w io.Writer) error {
+		f, err := os.Open(path)
+		if err != nil {
+			return fmt.Errorf("无法读取安装包：%v", err)
+		}
+		defer f.Close()
+		gz, err := gzip.NewReader(f)
+		if err != nil {
+			return fmt.Errorf("无法解压安装包：%v", err)
+		}
+		defer gz.Close()
+		tr := tar.NewReader(gz)
+		for {
+			hdr, err := tr.Next()
+			if errors.Is(err, io.EOF) {
+				break
+			}
+			if err != nil {
+				return fmt.Errorf("无法解压安装包：%v", err)
+			}
+			if hdr.Name != name || !hdr.FileInfo().Mode().IsRegular() {
+				continue
+			}
+			if _, err := io.Copy(w, tr); err != nil {
+				return fmt.Errorf("无法解压安装包：%v", err)
+			}
+			return nil
+		}
+		return fmt.Errorf("安装包里没有 %s", name)
+	}
+	return &packageReader{entries: list, read: read, close: func() {}}, nil
+}
+
+// tarGzEntries lists a gzipped tar package's regular files.
+func tarGzEntries(path string) ([]packageEntry, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, fmt.Errorf("无法读取安装包：%v", err)
+	}
+	defer f.Close()
+	gz, err := gzip.NewReader(f)
+	if err != nil {
+		return nil, fmt.Errorf("无法解压安装包：%v", err)
+	}
+	defer gz.Close()
+	tr := tar.NewReader(gz)
+	var out []packageEntry
+	for {
+		hdr, err := tr.Next()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			return nil, fmt.Errorf("无法解压安装包：%v", err)
+		}
+		if !hdr.FileInfo().Mode().IsRegular() {
+			continue
+		}
+		out = append(out, packageEntry{name: hdr.Name, size: hdr.Size})
+	}
+	return out, nil
+}
+
+// openZip opens a zip package, which stays open for the extraction: a zip's
+// index lets it seek to the file picked.
+func openZip(path string) (*packageReader, error) {
+	rc, err := zip.OpenReader(path)
+	if err != nil {
+		return nil, fmt.Errorf("无法解压安装包：%v", err)
+	}
+	var list []packageEntry
+	for _, f := range rc.File {
+		if !f.FileInfo().Mode().IsRegular() {
+			continue
+		}
+		list = append(list, packageEntry{name: f.Name, size: int64(f.UncompressedSize64)})
+	}
+	read := func(name string, w io.Writer) error {
+		for _, f := range rc.File {
+			if f.Name != name {
+				continue
+			}
+			r, err := f.Open()
+			if err != nil {
+				return fmt.Errorf("无法解压安装包：%v", err)
+			}
+			defer r.Close()
+			if _, err := io.Copy(w, r); err != nil {
+				return fmt.Errorf("无法解压安装包：%v", err)
+			}
+			return nil
+		}
+		return fmt.Errorf("安装包里没有 %s", name)
+	}
+	return &packageReader{entries: list, read: read, close: func() { rc.Close() }}, nil
+}
+
+// pickBinary finds the package's copy of the app's binary by its name within
+// the package, the shallowest when several match (a package may hold the
+// app's folder and a copy of it elsewhere), and skips empty files, which are
+// no binary at all.
+func pickBinary(entries []packageEntry, want string) (string, error) {
+	best, bestDepth := "", -1
+	for _, e := range entries {
+		if filepath.Base(e.name) != want || e.size == 0 {
+			continue
+		}
+		depth := strings.Count(strings.Trim(e.name, "/"), "/")
+		if bestDepth < 0 || depth < bestDepth {
+			best, bestDepth = e.name, depth
+		}
+	}
+	if best == "" {
+		return "", fmt.Errorf("下载的包里没有 %s：请手动安装这个包", want)
+	}
+	return best, nil
+}
diff --git a/internal/updates/install_test.go b/internal/updates/install_test.go
new file mode 100644
index 0000000..8ac943e
--- /dev/null
+++ b/internal/updates/install_test.go
@@ -0,0 +1,245 @@
+package updates
+
+import (
+	"archive/tar"
+	"archive/zip"
+	"bytes"
+	"compress/gzip"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// fakeBinary is what a package holds for the app: text, not a real binary,
+// as an install replaces the file's bytes without ever running them.
+const fakeBinary = "假装是新的二进制"
+
+// targetBinary is what the app's file holds before an install.
+const targetBinary = "旧的二进制"
+
+// writeTarGz writes a gzipped tar package holding files, keyed by their paths
+// in the package, at path.
+func writeTarGz(t *testing.T, path string, files map[string]string) {
+	t.Helper()
+	var buf bytes.Buffer
+	gz := gzip.NewWriter(&buf)
+	tw := tar.NewWriter(gz)
+	for name, body := range files {
+		hdr := &tar.Header{Name: name, Mode: 0o755, Size: int64(len(body)), Typeflag: tar.TypeReg}
+		if err := tw.WriteHeader(hdr); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := tw.Write([]byte(body)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := tw.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := gz.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, buf.Bytes(), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// writeZip writes a zip package holding files at path.
+func writeZip(t *testing.T, path string, files map[string]string) {
+	t.Helper()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for name, body := range files {
+		f, err := zw.Create(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := f.Write([]byte(body)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := zw.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, buf.Bytes(), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// installedApp makes a folder holding the app's binary as it runs now, and
+// returns the folder and the binary's path.
+func installedApp(t *testing.T) (dir, exe string) {
+	t.Helper()
+	dir = t.TempDir()
+	exe = filepath.Join(dir, "baidunetgo")
+	if err := os.WriteFile(exe, []byte(targetBinary), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	return dir, exe
+}
+
+// tempFiles lists dir's files whose name starts with start, to check that a
+// failed install left nothing behind.
+func tempFiles(t *testing.T, dir, start string) []string {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out []string
+	for _, e := range entries {
+		if strings.HasPrefix(e.Name(), start) {
+			out = append(out, e.Name())
+		}
+	}
+	return out
+}
+
+// checkInstalled checks the app's file now holds body at 0755, and that the
+// file it replaced is kept as .old.
+func checkInstalled(t *testing.T, dir, exe string) {
+	t.Helper()
+	data, err := os.ReadFile(exe)
+	if err != nil || string(data) != fakeBinary {
+		t.Errorf("binary %q, %v", data, err)
+	}
+	info, err := os.Stat(exe)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if perm := info.Mode().Perm(); perm != 0o755 {
+		t.Errorf("mode %v, want 0755", perm)
+	}
+	old, err := os.ReadFile(exe + ".old")
+	if err != nil || string(old) != targetBinary {
+		t.Errorf("old binary %q, %v", old, err)
+	}
+	if left := tempFiles(t, dir, ".baidunetgo.install-"); len(left) > 0 {
+		t.Errorf("temporary files left behind: %q", left)
+	}
+}
+
+// TestInstallToTarGz replaces the app with the binary from a tar.gz package
+// holding it in a folder, keeping the replaced file as .old.
+func TestInstallToTarGz(t *testing.T) {
+	dir, exe := installedApp(t)
+	// The app's folder in the package, plus a deeper copy of the same name,
+	// which the shallower one wins over.
+	archive := filepath.Join(t.TempDir(), "baidunetgo-9.9.9-linux-amd64.tar.gz")
+	writeTarGz(t, archive, map[string]string{
+		"baidunetgo/baidunetgo":       fakeBinary,
+		"baidunetgo/extra/baidunetgo": "不该被选中的二进制",
+		"baidunetgo/install.sh":       "#!/bin/sh\n",
+	})
+
+	got, err := installTo(archive, exe)
+	if err != nil {
+		t.Fatalf("installTo: %v", err)
+	}
+	if got != exe {
+		t.Errorf("installed to %q, want %q", got, exe)
+	}
+	checkInstalled(t, dir, exe)
+}
+
+// TestInstallToZip does the same with a zip package.
+func TestInstallToZip(t *testing.T) {
+	dir, exe := installedApp(t)
+	archive := filepath.Join(t.TempDir(), "BaiduNetGo-9.9.9-windows-amd64.zip")
+	writeZip(t, archive, map[string]string{
+		"BaiduNetGo/baidunetgo": fakeBinary,
+		"BaiduNetGo/readme.txt": "readme",
+	})
+
+	if _, err := installTo(archive, exe); err != nil {
+		t.Fatalf("installTo: %v", err)
+	}
+	checkInstalled(t, dir, exe)
+}
+
+// TestInstallToMissingBinary asks for a package that holds no file of the
+// app's name and expects an error saying which name it looked for.
+func TestInstallToMissingBinary(t *testing.T) {
+	dir, exe := installedApp(t)
+	archive := filepath.Join(t.TempDir(), "pkg.tar.gz")
+	writeTarGz(t, archive, map[string]string{"app/other": "不是它"})
+
+	_, err := installTo(archive, exe)
+	if err == nil {
+		t.Fatal("installTo succeeded without the app's binary")
+	}
+	if !strings.Contains(err.Error(), "baidunetgo") {
+		t.Errorf("error %q does not name the binary", err)
+	}
+	data, readErr := os.ReadFile(exe)
+	if readErr != nil || string(data) != targetBinary {
+		t.Errorf("the app was changed by a failed install: %q, %v", data, readErr)
+	}
+	if left := tempFiles(t, dir, ".baidunetgo.install-"); len(left) > 0 {
+		t.Errorf("temporary files left behind: %q", left)
+	}
+}
+
+// TestInstallToUnsupportedPackage refuses what this code cannot unpack, such
+// as a .dmg, and says it must be installed by hand.
+func TestInstallToUnsupportedPackage(t *testing.T) {
+	_, exe := installedApp(t)
+	archive := filepath.Join(t.TempDir(), "BaiduNetGo-9.9.9.dmg")
+	if err := os.WriteFile(archive, []byte("dmg"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	_, err := installTo(archive, exe)
+	if err == nil {
+		t.Fatal("installTo unpacked a dmg")
+	}
+	if !strings.Contains(err.Error(), "手动安装") {
+		t.Errorf("error %q does not send the user to a manual install", err)
+	}
+}
+
+// TestInstallToReadOnlyDir expects a folder the user cannot write, as a
+// package manager's install under /opt is, to be refused with a note about
+// the package manager rather than a partial write.
+func TestInstallToReadOnlyDir(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("root writes a read-only folder, so the check cannot fail")
+	}
+	dir, exe := installedApp(t)
+	archive := filepath.Join(t.TempDir(), "pkg.tar.gz")
+	writeTarGz(t, archive, map[string]string{"app/baidunetgo": fakeBinary})
+	if err := os.Chmod(dir, 0o500); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.Chmod(dir, 0o700) })
+
+	_, err := installTo(archive, exe)
+	if err == nil {
+		t.Fatal("installTo wrote into a folder it cannot write")
+	}
+	for _, want := range []string{"pacman", "包管理器"} {
+		if !strings.Contains(err.Error(), want) {
+			t.Errorf("error %q does not mention %q", err, want)
+		}
+	}
+	data, readErr := os.ReadFile(exe)
+	if readErr != nil || string(data) != targetBinary {
+		t.Errorf("the app was changed by a failed install: %q, %v", data, readErr)
+	}
+	if left := tempFiles(t, dir, ".baidunetgo.install-"); len(left) > 0 {
+		t.Errorf("temporary files left behind: %q", left)
+	}
+}
+
+// TestCanInstallOn checks which platforms may install in place.
+func TestCanInstallOn(t *testing.T) {
+	for goos, want := range map[string]bool{
+		"linux":   true,
+		"windows": false,
+		"darwin":  false,
+	} {
+		if got := canInstallOn(goos); got != want {
+			t.Errorf("canInstallOn(%q) = %v, want %v", goos, got, want)
+		}
+	}
+}
