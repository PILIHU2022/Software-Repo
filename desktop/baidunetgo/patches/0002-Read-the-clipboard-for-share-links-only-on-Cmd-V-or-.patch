+// TestClipboardOnlyWhenAsked tells that signing in and coming to the front
+// never read the clipboard or open the share link it holds: the read waits
+// for the toolbar's button or Cmd-V, as its owner can make it hang.
+func TestClipboardOnlyWhenAsked(t *testing.T) {
+	srv := fakepan.New()
+	t.Cleanup(srv.Close)
+	a := New()
+	a.fake = true
+	link := "链接: https://pan.baidu.com/s/1demo?pwd=abcd 提取码: abcd"
+	reads := 0
+	a.clipRead = func(*ui.Context) string {
+		reads++
+		return link
+	}
+	tt := ui.NewTester(a.View, 1180, 760)
+	tt.SetLocale("zh-Hans")
+	tt.SetClipboard(link)
+	go a.signInWith(baidu.OpenAt(baidu.Credentials{BDUSS: "fake", UID: 1}, srv.URL), false)
+	waitFor(t, tt, "照片")
+	tt.Advance(time.Second)
+	if reads != 0 || a.dlg.open {
+		t.Fatalf("signing in read the clipboard %d times, dialog %v", reads, a.dlg.open)
 	}
+
+	a.update(a.refocused)
+	tt.Advance(time.Second)
+	if reads != 0 || a.dlg.open {
+		t.Fatalf("coming to the front read the clipboard %d times, dialog %v", reads, a.dlg.open)
+	}
+
+	if err := tt.Click("从剪贴板打开分享链接"); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, tt, "旅行的猫 的分享")
+	if reads != 1 {
+		t.Errorf("the button read the clipboard %d times, want once", reads)
+	}
+	if !tt.HasText("来自剪贴板") {
+		t.Errorf("the share did not say it came from the clipboard: %q", tt.Texts())
+	}
+	tt.Click("取消")
+	settle(tt)
 }
 
 func TestOfflineFlow(t *testing.T) {
