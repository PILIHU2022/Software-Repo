@@ -0,0 +1,155 @@
+package com.pengstem.baidunetgo.core.dedup
+
+import com.pengstem.baidunetgo.core.net.BaiduApi
+import com.pengstem.baidunetgo.core.net.FakePand
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Assume.assumeTrue
+import org.junit.Before
+import org.junit.Test
+
+/**
+ * The duplicate engine against the real Go fake netdisk (`cmd/fakepand`) and, as
+ * pure functions, its grouping and regrouping rules.
+ *
+ * The class skips itself cleanly when neither `go` (to build `cmd/fakepand`) nor a
+ * running `FAKEPAN_URL` is available, exactly like `BaiduApiTest`.
+ */
+class DedupTest {
+
+    private lateinit var server: FakePand
+    private lateinit var api: BaiduApi
+
+    @Before
+    fun setUp() {
+        val fake = FakePand.startOrNull()
+        assumeTrue(
+            "the fake netdisk needs `go` or FAKEPAN_URL: ${FakePand.unavailableReason()}",
+            fake != null,
+        )
+        server = fake!!
+        api = BaiduApi(base = server.url)
+    }
+
+    @After
+    fun tearDown() {
+        if (::server.isInitialized) server.close()
+    }
+
+    // -----------------------------------------------------------------------
+
+    @Test
+    fun scanWalksTheTreeAndGroupFindsTheSeededPairs() = runBlocking {
+        val result = Dedup.scan(api, "/")
+        assertTrue("dirs: ${result.dirs}", result.dirs > 0)
+        assertTrue("files: ${result.files.size}", result.files.isNotEmpty())
+        assertFalse("the seeded tree is small, nothing should be truncated", result.truncated)
+        assertTrue("no folder should fail: ${result.failed}", result.failed.isEmpty())
+
+        val grouping = Dedup.group(result.files)
+        assertTrue("the fake seeds several duplicates: ${grouping.groups.size}", grouping.groups.size >= 2)
+
+        for (group in grouping.groups) {
+            assertTrue("a group holds at least two copies", group.files.size >= 2)
+            val size = group.files[0].size
+            val md5 = group.files[0].md5
+            assertTrue("group md5 must not be blank", md5.isNotBlank())
+            for (file in group.files) {
+                assertEquals("every copy shares the group's size", size, file.size)
+                assertEquals("every copy shares the group's md5", md5, file.md5)
+            }
+            // files[0] is the kept copy: modified ascending, then path breaking a tie.
+            for (i in 1 until group.files.size) {
+                val earlier = group.files[i - 1]
+                val later = group.files[i]
+                assertTrue(
+                    "copies are modified-ascending, path breaking a tie: ${earlier.path} vs ${later.path}",
+                    earlier.modified < later.modified ||
+                        (earlier.modified == later.modified && earlier.path <= later.path),
+                )
+            }
+        }
+
+        // Groups come by reclaim desc.
+        for (i in 1 until grouping.groups.size) {
+            assertTrue(
+                "groups are sorted by reclaim desc",
+                grouping.groups[i - 1].reclaim >= grouping.groups[i].reclaim,
+            )
+        }
+
+        // The fake has a file with no MD5: it must be counted as skipped.
+        assertTrue("a file with no MD5 must be skipped: ${grouping.skipped}", grouping.skipped >= 1)
+
+        val textGroup = grouping.groups.firstOrNull { g -> g.files.any { it.path == "/文档/读我.txt" } }
+        assertNotNull("the 读我.txt pair must be a group", textGroup)
+        assertTrue(
+            "the pair is /文档/读我.txt + /代码/备份/读我（副本）.txt",
+            textGroup!!.files.any { it.path == "/代码/备份/读我（副本）.txt" },
+        )
+        assertEquals(
+            "the earliest-modified (kept) copy is /文档/读我.txt",
+            "/文档/读我.txt",
+            textGroup.files[0].path,
+        )
+
+        assertTrue(
+            "a file with no MD5 is never in a group",
+            grouping.groups.none { g -> g.files.any { it.path == "/代码/备份/缺少哈希的镜像.iso" } },
+        )
+    }
+
+    @Test
+    fun withoutDropsDeletedFileAndGroupsThatFallBelowTwo() {
+        val a1 = DedupFile("/x/a1", "a1", 100, 1, "aaaa", 10)
+        val a2 = DedupFile("/x/a2", "a2", 100, 2, "aaaa", 20)
+        val b1 = DedupFile("/y/b1", "b1", 200, 3, "bbbb", 10)
+        val b2 = DedupFile("/y/b2", "b2", 200, 4, "bbbb", 20)
+        val c1 = DedupFile("/y/c1", "c1", 300, 5, "cccc", 10) // a singleton: never a group
+
+        val groups = Dedup.group(listOf(a1, a2, b1, b2, c1)).groups
+        assertEquals(2, groups.size)
+
+        val left = Dedup.without(groups, setOf("/x/a1"))
+        assertEquals("a group reduced to one copy is dropped", 1, left.size)
+        assertEquals(
+            "the untouched group keeps both its copies",
+            setOf("/y/b1", "/y/b2"),
+            left[0].files.map { it.path }.toSet(),
+        )
+
+        // Dropping one copy of a group of three leaves a valid group of two.
+        val d1 = DedupFile("/z/d1", "d1", 400, 6, "dddd", 10)
+        val d2 = DedupFile("/z/d2", "d2", 400, 7, "dddd", 20)
+        val d3 = DedupFile("/z/d3", "d3", 400, 8, "dddd", 30)
+        val three = Dedup.group(listOf(d1, d2, d3)).groups
+        val reduced = Dedup.without(three, setOf("/z/d2"))
+        assertEquals(1, reduced.size)
+        assertEquals(setOf("/z/d1", "/z/d3"), reduced[0].files.map { it.path }.toSet())
+        assertEquals("reclaim follows the reduced copy count", 400L, reduced[0].reclaim)
+    }
+
+    @Test
+    fun groupSkipsZeroByteAndBlankMd5Files() {
+        val first = DedupFile("/a.txt", "a.txt", 10, 1, "same", 100)
+        val second = DedupFile("/b.txt", "b.txt", 10, 2, "same", 200)
+        val zeroByte = DedupFile("/empty.txt", "empty.txt", 0, 3, "", 50)
+        val noHash = DedupFile("/noHash.iso", "noHash.iso", 700, 4, "", 10)
+
+        val grouping = Dedup.group(listOf(first, second, zeroByte, noHash))
+
+        assertEquals(1, grouping.groups.size)
+        assertEquals(listOf("/a.txt", "/b.txt"), grouping.groups[0].files.map { it.path })
+        // Only the non-zero-size file with a blank MD5 is skipped; the 0-byte one is
+        // left out before the MD5 check and is not counted.
+        assertEquals(1, grouping.skipped)
+        assertTrue(
+            "neither the 0-byte nor the no-hash file is in a group",
+            grouping.groups.none { g -> g.files.any { it.path == "/empty.txt" || it.path == "/noHash.iso" } },
+        )
+    }
+}
