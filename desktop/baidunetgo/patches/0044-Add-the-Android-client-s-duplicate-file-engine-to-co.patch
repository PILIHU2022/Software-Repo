+package com.pengstem.baidunetgo.core.dedup
+
+import com.pengstem.baidunetgo.core.net.Netdisk
+import com.pengstem.baidunetgo.core.net.RemoteFile
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+
+/**
+ * What makes two files the same content: their size and their (unscrambled) MD5.
+ *
+ * The netdisk's listings already carry every file's MD5, so the duplicate engine
+ * compares no bytes.
+ */
+data class DedupKey(val size: Long, val md5: String)
+
+/**
+ * One file a scan found.
+ *
+ * [path] is the full netdisk path, e.g. `/文档/读我.txt`; [modified] is in seconds,
+ * as the netdisk reports it ("server_mtime"), and decides which copy of a group is
+ * the one kept.
+ */
+data class DedupFile(
+    val path: String,      // full netdisk path, e.g. "/文档/读我.txt"
+    val name: String,
+    val size: Long,
+    val fsId: Long,
+    val md5: String,
+    val modified: Long,    // seconds, the netdisk's server_mtime
+)
+
+/**
+ * A set of files holding the same content.
+ *
+ * [files] comes earliest modified first, its path breaking a tie, so `files[0]` is
+ * the copy the interface keeps by default.
+ */
+data class DedupGroup(
+    val key: DedupKey,
+    val files: List<DedupFile>,   // earliest modified first, path breaking a tie (the kept copy is files[0])
+) {
+    /** The size of one copy. */
+    val size: Long get() = key.size
+
+    /** The size of every copy in the group. */
+    val total: Long get() = key.size * files.size
+
+    /** What deleting every copy but one would free. */
+    val reclaim: Long get() = key.size * (files.size - 1)
+}
+
+/** How far a scan has got: the folder just read, folders read, and files found. */
+data class DedupProgress(val dir: String, val dirs: Int, val files: Int)
+
+/**
+ * What a scan found.
+ *
+ * [files] are every non-folder entry once, those without an MD5 and 0-byte ones
+ * included (group() leaves them out). [failed] are folders that could not be read;
+ * [truncated] says the scan stopped at one of its limits.
+ */
+data class DedupScanResult(
+    val files: List<DedupFile>,
+    val dirs: Int,
+    val failed: List<String>,
+    val truncated: Boolean,
+)
+
+/** The result of grouping: the duplicate groups, and how many files were skipped for having no MD5. */
+data class DedupGrouping(val groups: List<DedupGroup>, val skipped: Int)
+
+/**
+ * Finds the files of the netdisk that hold the same content.
+ *
+ * Mirrors the desktop Go engine (`internal/dedup`): [scan] walks the folders under
+ * a root a few at a time and collects their files; [group] groups what it found by
+ * size and MD5; [without] regroups the results after copies were deleted.
+ */
+object Dedup {
+    const val DefaultConcurrency = 4
+    const val DefaultMaxFiles = 50_000
+    const val DefaultMaxDirs = 5_000
+
+    /** Groups come by reclaim desc, then size desc, then md5 asc — exactly the Go sortGroups. */
+    private val groupOrder: Comparator<DedupGroup> =
+        compareByDescending<DedupGroup> { it.reclaim }
+            .thenByDescending { it.size }
+            .thenBy { it.key.md5 }
+
+    /**
+     * Walks [root] and all its subfolders breadth-first, [concurrency] folders at a
+     * time, collecting every non-directory file once (repeated fsIds are deduped).
+     *
+     * A folder that cannot be read is recorded in [DedupScanResult.failed] and the
+     * scan goes on without it, unless it is the root: then its error is rethrown.
+     * The scan stops at [maxFiles] or [maxDirs], reporting
+     * [DedupScanResult.truncated]. Cancellation is cooperative
+     * (`currentCoroutineContext().ensureActive()`), so a `CancellationException`
+     * aborts promptly. [onProgress] is called after each folder.
+     *
+     * A blank [root] means `/`. Paths are built as clean paths:
+     * `parent.trimEnd('/') + "/" + name` (root `/` gives `/name`).
+     */
+    suspend fun scan(
+        netdisk: Netdisk,
+        root: String = "/",
+        concurrency: Int = DefaultConcurrency,
+        maxFiles: Int = DefaultMaxFiles,
+        maxDirs: Int = DefaultMaxDirs,
+        onProgress: (DedupProgress) -> Unit = {},
+    ): DedupScanResult {
+        val workers = if (concurrency <= 0) DefaultConcurrency else concurrency
+        val filesLimit = if (maxFiles <= 0) DefaultMaxFiles else maxFiles
+        val dirsLimit = if (maxDirs <= 0) DefaultMaxDirs else maxDirs
+
+        val start = cleanPath("/" + trimRoot(root))
+        val files = ArrayList<DedupFile>()
+        val failed = ArrayList<String>()
+        var dirs = 0
+        var truncated = false
+
+        val seenDirs = HashSet<String>()
+        seenDirs.add(start)
+        val seenFiles = HashSet<Long>()
+        var level: List<String> = listOf(start)
+
+        coroutineScope {
+            while (level.isNotEmpty() && !truncated) {
+                currentCoroutineContext().ensureActive()
+                val next = ArrayList<String>()
+                var index = 0
+                while (index < level.size) {
+                    currentCoroutineContext().ensureActive()
+                    val end = minOf(index + workers, level.size)
+                    val chunk = level.subList(index, end)
+                    val listings = chunk.map { dir ->
+                        async(Dispatchers.IO) { listFolder(netdisk, dir) }
+                    }.awaitAll()
+                    for (listing in listings) {
+                        val error = listing.error
+                        if (error != null) {
+                            currentCoroutineContext().ensureActive()
+                            if (listing.dir == start) throw error
+                            failed.add(listing.dir)
+                            continue
+                        }
+                        dirs++
+                        for (file in listing.files) {
+                            if (file.isDir) {
+                                val path = joinPath(listing.dir, file.name)
+                                if (path.isEmpty() || path == "/" || path in seenDirs) continue
+                                if (seenDirs.size >= dirsLimit) {
+                                    truncated = true
+                                    break
+                                }
+                                seenDirs.add(path)
+                                next.add(path)
+                                continue
+                            }
+                            if (file.fsId != 0L) {
+                                if (!seenFiles.add(file.fsId)) continue
+                            }
+                            if (files.size >= filesLimit) {
+                                truncated = true
+                                break
+                            }
+                            files.add(
+                                DedupFile(
+                                    path = joinPath(listing.dir, file.name),
+                                    name = file.name,
+                                    size = file.size,
+                                    fsId = file.fsId,
+                                    md5 = file.md5,
+                                    modified = file.modified,
+                                )
+                            )
+                        }
+                        onProgress(DedupProgress(listing.dir, dirs, files.size))
+                        if (truncated) break
+                    }
+                    if (truncated) break
+                    index = end
+                }
+                level = next
+            }
+        }
+
+        return DedupScanResult(files = files, dirs = dirs, failed = failed, truncated = truncated)
+    }
+
+    /**
+     * Groups [files] by (size, md5).
+     *
+     * 0-byte/negative-size files are left out (they free nothing), and files with a
+     * blank md5 — which cannot be compared — are counted in
+     * [DedupGrouping.skipped]. Files are deduped by fsId when it is non-zero.
+     * Within a group the copies are sorted by modified ascending then path, so the
+     * earliest modified is the copy to keep; only groups of two or more files are
+     * returned, sorted by reclaim desc, then size desc, then md5 asc.
+     */
+    fun group(files: List<DedupFile>): DedupGrouping {
+        val byKey = LinkedHashMap<DedupKey, MutableList<DedupFile>>()
+        val seen = HashSet<Long>()
+        var skipped = 0
+        for (file in files) {
+            if (file.size <= 0) continue
+            if (file.fsId != 0L) {
+                if (!seen.add(file.fsId)) continue
+            }
+            if (file.md5.isBlank()) {
+                skipped++
+                continue
+            }
+            byKey.getOrPut(DedupKey(file.size, file.md5)) { ArrayList() }.add(file)
+        }
+        val groups = ArrayList<DedupGroup>()
+        for ((key, copies) in byKey) {
+            if (copies.size < 2) continue
+            val sorted = copies.sortedWith(
+                compareBy<DedupFile> { it.modified }.thenBy { it.path }
+            )
+            groups.add(DedupGroup(key = key, files = sorted))
+        }
+        groups.sortWith(groupOrder)
+        return DedupGrouping(groups = groups, skipped = skipped)
+    }
+
+    /**
+     * Returns the groups left when the files at the paths in [gone] are removed: a
+     * group keeps its other copies as they came, a group that falls below two copies
+     * is dropped, and the result is re-sorted like [group].
+     */
+    fun without(groups: List<DedupGroup>, gone: Set<String>): List<DedupGroup> {
+        val out = ArrayList<DedupGroup>()
+        for (group in groups) {
+            val kept = group.files.filter { it.path !in gone }
+            if (kept.size < 2) continue
+            out.add(DedupGroup(key = group.key, files = kept))
+        }
+        out.sortWith(groupOrder)
+        return out
+    }
+
+    // -----------------------------------------------------------------------
+    // Internals
+    // -----------------------------------------------------------------------
+
+    /** One folder's listing or the error reading it (cancellation is rethrown, never captured). */
+    private class Listing(
+        val dir: String,
+        val files: List<RemoteFile>,
+        val error: Throwable?,
+    )
+
+    private suspend fun listFolder(netdisk: Netdisk, dir: String): Listing =
+        try {
+            Listing(dir, netdisk.list(dir), null)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Listing(dir, emptyList(), e)
+        }
+
+    /** Removes the leading slashes a root may carry, for [cleanPath] to put back. */
+    private fun trimRoot(root: String): String {
+        var value = root
+        while (value.isNotEmpty() && value[0] == '/') value = value.substring(1)
+        return value
+    }
+
+    private val duplicateSlashes = Regex("/{2,}")
+
+    /** `parent.trimEnd('/') + "/" + name`, with duplicate slashes collapsed; root `/` gives `/name`. */
+    private fun joinPath(parent: String, name: String): String {
+        val base = parent.trimEnd('/')
+        return duplicateSlashes.replace("$base/$name", "/")
+    }
+
+    /**
+     * Go's `path.Clean` for an absolute netdisk path: collapses duplicate slashes,
+     * drops `.` segments, resolves `..`, and drops a trailing slash. An empty
+     * result becomes `/`.
+     */
+    private fun cleanPath(path: String): String {
+        val absolute = path.startsWith('/')
+        val parts = ArrayList<String>()
+        for (segment in path.split('/')) {
+            when (segment) {
+                "", "." -> Unit
+                ".." -> if (parts.isNotEmpty() && parts.last() != "..") {
+                    parts.removeAt(parts.size - 1)
+                } else if (!absolute) {
+                    parts.add("..")
+                }
+                else -> parts.add(segment)
+            }
+        }
+        val body = parts.joinToString("/")
+        val result = if (absolute) "/$body" else body
+        return if (result.isEmpty()) if (absolute) "/" else "." else result
+    }
+}
diff --git a/android/core/src/test/kotlin/com/pengstem/baidunetgo/core/dedup/DedupTest.kt b/android/core/src/test/kotlin/com/pengstem/baidunetgo/core/dedup/DedupTest.kt
