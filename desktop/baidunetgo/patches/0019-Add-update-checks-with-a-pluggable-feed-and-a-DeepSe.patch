+func TestDownload(t *testing.T) {
+	content := []byte(strings.Repeat("baidunetgo", 10000))
+	var srv *httptest.Server
+	srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/pkg.tar.gz":
+			w.Header().Set("Content-Length", fmt.Sprint(len(content)))
+			w.Write(content)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer srv.Close()
+
+	dest := t.TempDir()
+	var calls int
+	var lastDone, lastTotal int64
+	info := &Info{Version: "1.0.0", URL: srv.URL + "/pkg.tar.gz"}
+	got, err := Download(context.Background(), info, dest, func(done, total int64) {
+		calls++
+		lastDone, lastTotal = done, total
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if filepath.Base(got) != "pkg.tar.gz" || got != filepath.Join(dest, "pkg.tar.gz") {
+		t.Errorf("path %q", got)
+	}
+	if data, err := os.ReadFile(got); err != nil || string(data) != string(content) {
+		t.Errorf("content %d bytes, err %v; want %d", len(data), err, len(content))
+	}
+	if calls == 0 || lastDone != int64(len(content)) || lastTotal != int64(len(content)) {
+		t.Errorf("progress %d calls, last %d/%d", calls, lastDone, lastTotal)
+	}
+	if _, err := os.Stat(got + ".part"); !os.IsNotExist(err) {
+		t.Errorf("a .part file survived: %v", err)
+	}
+}
