+package app
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+)
+
+// updateFeed serves a feed announcing version, with the package it names
+// on the same server.
+func updateFeed(t *testing.T, version string) *httptest.Server {
+	t.Helper()
+	var srv *httptest.Server
+	mux := http.NewServeMux()
+	mux.HandleFunc("/update.json", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.Write([]byte(`{"version":"` + version + `","notes":"测试更新","url":{"` +
+			runtime.GOOS + `-` + runtime.GOARCH + `":"` + srv.URL + `/pkg.bin"}}`))
+	})
+	mux.HandleFunc("/pkg.bin", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("假装是安装包"))
+	})
+	srv = httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+	return srv
+}
+
+func settingsView(t *testing.T, a *App, tt *ui.Tester) {
+	t.Helper()
+	a.router.Push("/settings")
+	waitFor(t, tt, "自动检查更新")
+	tt.Advance(time.Second)
+}
+
+// scrollToShow scrolls the settings page down until text shows whole, and
+// returns where it is.
+func scrollToShow(t *testing.T, tt *ui.Tester, text string) ui.Rect {
+	t.Helper()
+	const w, h = 1180, 760 // the tester's window
+	for i := 0; i < 40; i++ {
+		if r, ok := tt.Find(text); ok && r.H > 0 && r.W > 0 && r.Y >= 0 && r.Y+r.H <= h {
+			return r
+		}
+		tt.Wheel(w/2, h/2, 0, 240)
+		tt.Advance(80 * time.Millisecond)
+	}
+	t.Fatalf("%q never scrolled into view; texts %q", text, tt.Texts())
+	return ui.Rect{}
+}
+
+// TestSettingsUpdates checks the 更新 section's looks before any feed
+// exists: the switch on, the address 待配置, and the patch's declaration.
+func TestSettingsUpdates(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	settingsView(t, a, tt)
+	for _, want := range []string{
+		"更新地址未配置：等待发布通道就绪后填入",
+		"本版本为社区修复版",
+		"由 DeepSeek 与 GLM 协作修复与增强",
+	} {
+		if !tt.HasText(want) {
+			t.Errorf("%q missing; texts %q", want, tt.Texts())
+		}
+	}
+	if a.settings.AutoUpdate != nil || a.settings.UpdateURL != "" || a.settings.UpdateChannel != "" {
+		t.Errorf("update settings %+v, want the defaults", a.settings)
+	}
+}
+
+// TestSettingsAutoUpdateSwitch flips the switch and checks it is kept.
+func TestSettingsAutoUpdateSwitch(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	settingsView(t, a, tt)
+	toggle := func() bool {
+		t.Helper()
+		sw, ok := tt.AccessByRole(ui.RoleSwitch, "自动检查更新")
+		if !ok {
+			t.Fatalf("no switch; texts %q", tt.Texts())
+		}
+		scrollToShow(t, tt, "自动检查更新")
+		sw, ok = tt.AccessByRole(ui.RoleSwitch, "自动检查更新")
+		if !ok {
+			t.Fatal("the switch vanished while scrolling")
+		}
+		b := sw.Bounds
+		tt.ClickAt(b.X+b.W/2, b.Y+b.H/2)
+		tt.Advance(300 * time.Millisecond)
+		return a.settings.autoUpdate()
+	}
+	if toggle() {
+		t.Fatal("the switch was on after the first click, which turns it off")
+	}
+	if a.settings.AutoUpdate == nil || *a.settings.AutoUpdate {
+		t.Errorf("AutoUpdate %+v, want false", a.settings.AutoUpdate)
+	}
+	if !toggle() {
+		t.Fatal("turning it back on did not take")
+	}
+}
+
+// TestCheckUpdatesNotConfigured presses 立即检查 with no address and
+// expects a 待配置 note, not a panic nor a network call.
+func TestCheckUpdatesNotConfigured(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	settingsView(t, a, tt)
+	scrollToShow(t, tt, "立即检查")
+	if err := tt.Click("立即检查"); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, tt, "更新地址未配置")
+	if a.updates.checking || a.updates.err != "更新地址未配置：等待发布通道就绪后填入" {
+		t.Errorf("state %+v after the click", a.updates)
+	}
+}
+
+// TestCheckAndDownload finds a newer version on a local feed and downloads
+// its package into the download folder.
+func TestCheckAndDownload(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	srv := updateFeed(t, "9.9.9")
+	dest := t.TempDir()
+	a.settings.UpdateURL = srv.URL + "/update.json"
+	a.settings.DownloadDir = dest
+	settingsView(t, a, tt)
+	scrollToShow(t, tt, "立即检查")
+	if err := tt.Click("立即检查"); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, tt, "发现新版本 9.9.9")
+	if a.updates.found == nil || !a.updates.found.Newer || a.updates.found.URL != srv.URL+"/pkg.bin" {
+		t.Fatalf("found %+v", a.updates.found)
+	}
+	scrollToShow(t, tt, "下载")
+	if err := tt.Click("下载"); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, tt, "已下载：pkg.bin")
+	if a.updates.downloading || a.updates.lastPath == "" {
+		t.Fatalf("state after download: %+v", a.updates)
+	}
+	data, err := os.ReadFile(filepath.Join(dest, "pkg.bin"))
+	if err != nil || string(data) != "假装是安装包" {
+		t.Errorf("package not on disk as downloaded: %q, %v", data, err)
+	}
+	if _, err := os.Stat(filepath.Join(dest, "pkg.bin.part")); !os.IsNotExist(err) {
+		t.Errorf("a .part file survived: %v", err)
+	}
+	if !tt.HasText("已下载到 " + filepath.Join(dest, "pkg.bin")) {
+		t.Errorf("no toast with the path; texts %q", tt.Texts())
+	}
+}
+
+// TestAutoCheckQuiet runs the launch's automatic check: skipped with no
+// address, silent and working with one.
+func TestAutoCheckQuiet(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	a.maybeCheckUpdates()
+	// A skip says nothing: no check ran, no result appeared.
+	if !a.updates.autoDone || a.updates.checking || a.updates.err != "" ||
+		a.updates.found != nil || !a.updates.lastCheck.IsZero() {
+		t.Fatalf("state after the skipped check: %+v", a.updates)
+	}
+
+	// With an address, the automatic check runs and stays quiet.
+	srv := updateFeed(t, "9.9.9")
+	a.settings.UpdateURL = srv.URL + "/update.json"
+	a.updates.autoDone = false
+	a.maybeCheckUpdates()
+	if a.updates.checking != true {
+		t.Fatal("the automatic check did not start")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for a.updates.found == nil {
+		if time.Now().After(deadline) {
+			t.Fatalf("the automatic check never came back; state %+v", a.updates)
+		}
+		time.Sleep(10 * time.Millisecond)
+		tt.Advance(50 * time.Millisecond)
+	}
+	if a.updates.err != "" {
+		t.Errorf("the automatic check errored: %q", a.updates.err)
+	}
+}
+
+// TestUpdateURLDialog edits the address in the settings page's dialog.
+func TestUpdateURLDialog(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	settingsView(t, a, tt)
+	scrollToShow(t, tt, "编辑…")
+	if err := tt.Click("编辑…"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(300 * time.Millisecond)
+	if !a.updates.editing {
+		t.Fatal("the dialog did not open")
+	}
+	tt.Type("https://feeds.example.com/update.json")
+	tt.Key(0, ui.KeyEnter)
+	waitFor(t, tt, "feeds.example.com")
+	if a.updates.editing {
+		t.Error("the dialog stayed open")
+	}
+	if a.settings.UpdateURL != "https://feeds.example.com/update.json" {
+		t.Errorf("UpdateURL %q", a.settings.UpdateURL)
+	}
+	if p := settingsPath(); p != "" {
+		if _, err := os.Stat(p); err != nil {
+			t.Errorf("settings not saved: %v", err)
+		}
+	}
+}
