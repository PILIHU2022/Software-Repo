+func TestIsNewer(t *testing.T) {
+	cases := []struct {
+		current, candidate string
+		want               bool
+		wantErr            bool
+	}{
+		{"0.8.3", "0.9.0", true, false},
+		{"0.8.10", "0.8.9", false, false},
+		{"v0.8.3", "v1.0.0", true, false},
+		{"1.0.0", "1.0.0", false, false},
+		{"1.2.3", "1.2.2", false, false},
+		{"0.8.3", "0.8.3.1", true, false},
+		{"0.8.3.1", "0.8.3", false, false},
+		{"", "0.9.0", true, false},           // a development build takes the feed's word
+		{"0.8.3", "0.9.0-beta", true, false}, // a pre-release tag is ignored
+		{"0.8.3", "", false, true},
+		{"0.8.3", "最新", false, true},
+	}
+	for _, c := range cases {
+		got, err := isNewer(c.current, c.candidate)
+		if (err != nil) != c.wantErr {
+			t.Errorf("isNewer(%q, %q) err %v, wantErr %v", c.current, c.candidate, err, c.wantErr)
+			continue
+		}
+		if err == nil && got != c.want {
+			t.Errorf("isNewer(%q, %q) = %v, want %v", c.current, c.candidate, got, c.want)
+		}
+	}
+}
+
+// feedServing serves body at /update.json.
+func feedServing(t *testing.T, body string, code int) *httptest.Server {
+	t.Helper()
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/update.json" {
+			http.NotFound(w, r)
+			return
+		}
+		w.WriteHeader(code)
+		fmt.Fprint(w, body)
+	}))
+	t.Cleanup(s.Close)
+	return s
+}
+
+func TestCheckStandardFeed(t *testing.T) {
+	url := `{"linux-amd64": "https://example.com/baidunetgo-0.9.0-linux-amd64.tar.gz"}`
+	s := feedServing(t, `{"version": "0.9.0", "notes": "修复若干问题", "date": "2026-11-14", "url": `+url+`, "unknown": 42}`, 200)
+	info, err := Check(context.Background(), s.URL+"/update.json", "0.8.3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Version != "0.9.0" || info.Notes != "修复若干问题" {
+		t.Errorf("info %+v", info)
+	}
+	if !info.Newer {
+		t.Error("0.9.0 not reported newer than 0.8.3")
+	}
+	if info.URL != "https://example.com/baidunetgo-0.9.0-linux-amd64.tar.gz" {
+		t.Errorf("url %q", info.URL)
+	}
+}
+
+func TestCheckSimpleFeed(t *testing.T) {
