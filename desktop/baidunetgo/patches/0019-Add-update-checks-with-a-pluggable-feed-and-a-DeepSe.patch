+	defer srv.Close()
+	dest := t.TempDir()
+	got, err := Download(context.Background(), &Info{Version: "1.2.3", URL: srv.URL + "/"}, dest, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "baidunetgo-1.2.3-" + runtimeOSArch() + ".bin"
+	if filepath.Base(got) != want {
+		t.Errorf("name %q, want %q", filepath.Base(got), want)
+	}
+}
