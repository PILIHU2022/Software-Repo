+	info, err := Check(context.Background(), s.URL+"/update.json", "1.0.0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Newer {
+		t.Error("1.0.0 reported newer than 1.0.0")
+	}
+	if info.URL != "https://example.com/pkg.tar.gz" {
+		t.Errorf("url %q", info.URL)
+	}
+}
+
+func TestCheckMissingPlatform(t *testing.T) {
+	s := feedServing(t, `{"version":"1.0.0","url":{"windows-arm64":"https://example.com/p"}}`, 200)
+	_, err := Check(context.Background(), s.URL+"/update.json", "1.0.0")
+	if err == nil || !strings.Contains(err.Error(), "下载地址") {
+		t.Fatalf("err %v, want a missing-address note", err)
+	}
+}
+
+func TestCheckErrors(t *testing.T) {
+	if _, err := Check(context.Background(), "", "0.8.3"); !errors.Is(err, ErrNotConfigured) {
+		t.Fatalf("empty feed err %v, want ErrNotConfigured", err)
+	}
+	for _, c := range []struct {
+		name, body string
+		code       int
+		want       string
+	}{
+		{"bad json", "{", 200, "无法解析更新信息"},
+		{"no version", `{"url":"https://example.com/p"}`, 200, "版本号"},
+		{"bad version", `{"version":"最新","url":"https://example.com/p"}`, 200, "无法解析更新信息"},
+		{"no url", `{"version":"1.0.0"}`, 200, "下载地址"},
+		{"server error", "gone", 500, "更新地址返回"},
+	} {
+		s := feedServing(t, c.body, c.code)
+		if _, err := Check(context.Background(), s.URL+"/update.json", "0.8.3"); err == nil || !strings.Contains(err.Error(), c.want) {
+			t.Errorf("%s: err %v, want it to say %q", c.name, err, c.want)
+		}
+	}
+}
+
+func TestCheckTimeout(t *testing.T) {
+	old := checkTimeout
+	checkTimeout = 50 * time.Millisecond
+	t.Cleanup(func() { checkTimeout = old })
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		time.Sleep(300 * time.Millisecond)
+		fmt.Fprint(w, `{"version":"1.0.0","url":"https://example.com/p"}`)
+	}))
+	defer s.Close()
+	if _, err := Check(context.Background(), s.URL, "0.8.3"); err == nil || !strings.Contains(err.Error(), "无法连接更新地址") {
+		t.Fatalf("slow feed err %v, want a timeout note", err)
+	}
+}
