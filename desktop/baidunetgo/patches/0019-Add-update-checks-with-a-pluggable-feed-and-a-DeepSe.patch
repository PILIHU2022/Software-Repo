index 0000000..fe0ce8a
--- /dev/null
+++ b/internal/updates/updates.go
@@ -0,0 +1,279 @@
+// Package updates checks a feed for a newer BaiduNetGo build and
+// downloads its package for this platform. This build signs nothing and
+// installs nothing: a newer version is fetched to the download folder for
+// the user to install by hand, until a feed run by the release workflow
+// takes over and MyGo's own updater replaces this package.
+package updates
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/egoist/mygo/netproxy"
+)
+
+// defaultFeed is the feed checked when the settings name none, meant to
+// be linked in at build time with
+// -ldflags "-X github.com/pengstem/baidunetgo/internal/updates.defaultFeed=…".
+// Empty until the release workflow publishes one (docs/UPDATES.md).
+var defaultFeed string
+
+// DefaultFeed is the feed checked when the settings name none.
+func DefaultFeed() string { return defaultFeed }
+
+// checkTimeout bounds one feed request, downloadTimeout the whole
+// download. Variables so tests can shorten them.
+var (
+	checkTimeout    = 10 * time.Second
+	downloadTimeout = 10 * time.Minute
+)
+
+// ErrNotConfigured says no feed is set: the release channel is not up yet,
+// which is a state to show, not an error to crash on.
+var ErrNotConfigured = errors.New("更新地址未配置")
+
+// Info is what a feed offers for this platform.
+type Info struct {
+	Version string // the newest version, like 0.8.4
+	Notes   string // what it changes, shown as is
+	URL     string // where this platform's package is
+	Newer   bool   // whether it is newer than the running build
+}
+
+// feed is a feed document. URL holds one address for every platform,
+// keyed GOOS-GOARCH; a feed that publishes one package only may set it to
+// a plain string, which this accepts.
+type feed struct {
+	Version string          `json:"version"`
+	Notes   string          `json:"notes"`
+	URL     json.RawMessage `json:"url"`
+}
+
+// httpClient follows the system proxy, as the netdisk's calls do. The
+// download client has no timeout of its own: its request's context bounds
+// the whole download.
+var (
+	httpClient = &http.Client{
+		Transport: &http.Transport{Proxy: netproxy.Proxy, ForceAttemptHTTP2: true},
+		Timeout:   checkTimeout,
+	}
+	downloadClient = &http.Client{
+		Transport: &http.Transport{Proxy: netproxy.Proxy, ForceAttemptHTTP2: true},
+	}
+	// dlMu keeps downloads one at a time.
+	dlMu sync.Mutex
+)
+
+// Check asks feedURL what the newest version is and reports it, when it is
+// newer than current. An empty feedURL is ErrNotConfigured, current empty
+// (a development build) takes the feed's word.
+func Check(ctx context.Context, feedURL, current string) (*Info, error) {
+	if strings.TrimSpace(feedURL) == "" {
+		return nil, ErrNotConfigured
+	}
+	ctx, cancel := context.WithTimeout(ctx, checkTimeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, feedURL, nil)
+	if err != nil {
+		return nil, fmt.Errorf("更新地址无效：%v", err)
+	}
+	res, err := httpClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("无法连接更新地址：%v", err)
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("更新地址返回 %s", res.Status)
+	}
+	var f feed
+	if err := json.NewDecoder(io.LimitReader(res.Body, 1<<20)).Decode(&f); err != nil {
+		return nil, fmt.Errorf("无法解析更新信息：%v", err)
+	}
+	info := &Info{Version: strings.TrimSpace(f.Version), Notes: f.Notes}
+	if info.URL, err = downloadURL(f.URL); err != nil {
+		return nil, err
+	}
+	if info.Version == "" {
+		return nil, errors.New("更新信息缺少版本号")
+	}
+	if _, err := parseVersion(info.Version); err != nil {
+		return nil, fmt.Errorf("无法解析更新信息：%v", err)
+	}
+	info.Newer, _ = isNewer(current, info.Version)
+	return info, nil
+}
+
+// downloadURL picks this platform's address out of the feed's url field:
+// an object keyed GOOS-GOARCH, or one plain address for every platform.
+func downloadURL(raw json.RawMessage) (string, error) {
+	if len(raw) == 0 || string(raw) == "null" {
+		return "", errors.New("更新信息缺少下载地址")
+	}
+	var s string
+	if err := json.Unmarshal(raw, &s); err == nil {
+		if strings.TrimSpace(s) == "" {
+			return "", errors.New("更新信息缺少下载地址")
+		}
+		return s, nil
+	}
+	var m map[string]string
+	if err := json.Unmarshal(raw, &m); err != nil {
+		return "", errors.New("无法解析更新信息：下载地址既不是字符串也不是按平台的表")
+	}
+	if u := m[runtime.GOOS+"-"+runtime.GOARCH]; u != "" {
+		return u, nil
+	}
+	return "", fmt.Errorf("更新信息没有 %s-%s 的下载地址", runtime.GOOS, runtime.GOARCH)
+}
+
+// Download fetches info's package into destDir, writing to a .part file
+// first and renaming it, so a half download is never mistaken for a whole
+// one. progress, when given, hears the bytes done and the total known.
+// It returns where the package landed.
+func Download(ctx context.Context, info *Info, destDir string, progress func(done, total int64)) (string, error) {
+	if info == nil || strings.TrimSpace(info.URL) == "" {
+		return "", errors.New("没有可下载的更新")
+	}
+	dlMu.Lock()
+	defer dlMu.Unlock()
+	ctx, cancel := context.WithTimeout(ctx, downloadTimeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, info.URL, nil)
+	if err != nil {
+		return "", fmt.Errorf("下载地址无效：%v", err)
+	}
+	res, err := downloadClient.Do(req)
+	if err != nil {
+		return "", fmt.Errorf("下载失败：%v", err)
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("下载失败：服务器返回 %s", res.Status)
+	}
+
+	name := downloadName(info)
+	part := filepath.Join(destDir, name+".part")
+	final := filepath.Join(destDir, name)
+	if err := os.MkdirAll(destDir, 0o755); err != nil {
+		return "", fmt.Errorf("下载失败：无法创建下载目录：%v", err)
+	}
+	f, err := os.OpenFile(part, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o644)
+	if err != nil {
+		return "", fmt.Errorf("下载失败：无法写入临时文件：%v", err)
+	}
+	if _, err := io.Copy(f, &counting{r: res.Body, total: contentLength(res), fn: progress}); err != nil {
+		f.Close()
+		os.Remove(part) // a failed download leaves nothing behind
+		return "", fmt.Errorf("下载失败：%v", err)
+	}
+	if err := f.Close(); err != nil {
+		os.Remove(part)
+		return "", fmt.Errorf("下载失败：%v", err)
+	}
+	if err := os.Rename(part, final); err != nil {
+		os.Remove(part)
+		return "", fmt.Errorf("下载失败：无法保存文件：%v", err)
+	}
+	return final, nil
+}
+
+// downloadName takes the package's name from its address's path, falling
+// back to a name made of the version and this platform.
+func downloadName(info *Info) string {
+	if u, err := url.Parse(info.URL); err == nil {
+		if base := filepath.Base(u.Path); base != "" && base != "/" && base != "." {
+			return base
+		}
+	}
+	return "baidunetgo-" + info.Version + "-" + runtime.GOOS + "-" + runtime.GOARCH + ".bin"
+}
+
+func contentLength(res *http.Response) int64 {
+	if n, err := strconv.ParseInt(res.Header.Get("Content-Length"), 10, 64); err == nil && n > 0 {
+		return n
+	}
+	return 0
+}
+
+// counting hears a copy's progress.
+type counting struct {
+	r     io.Reader
+	total int64
+	done  int64
+	fn    func(done, total int64)
+}
+
+func (c *counting) Read(p []byte) (int, error) {
+	n, err := c.r.Read(p)
+	if n > 0 && c.fn != nil {
+		c.done += int64(n)
+		c.fn(c.done, c.total)
+	}
+	return n, err
+}
+
+// isNewer reports whether candidate is a newer release than current. Both
+// lose a leading v; the numbers are compared part by part, so 0.8.10 beats
+// 0.8.9. A current of none is a development build, which takes the feed's
+// word. A candidate that parses badly is never newer.
+func isNewer(current, candidate string) (bool, error) {
+	cur, err := parseVersion(current)
+	if err != nil {
+		// A development build, or a version nobody parses: any valid
+		// candidate is worth showing.
+		cur = nil
+	}
+	cand, err := parseVersion(candidate)
+	if err != nil {
+		return false, fmt.Errorf("无法比较版本号 %q：%v", candidate, err)
+	}
+	if cand == nil {
+		return false, fmt.Errorf("无法比较版本号 %q：不是版本号", candidate)
+	}
+	if cur == nil {
+		return true, nil
+	}
+	for i := range cand {
+		if i >= len(cur) {
+			return cand[i] > 0, nil // 0.8 is older than 0.8.1
+		}
+		if cand[i] != cur[i] {
+			return cand[i] > cur[i], nil
+		}
+	}
+	return false, nil // equal, or a longer current like 0.8.3.1
+}
+
+// parseVersion reads a version like 0.8.3 or v1.0.0 into its numbers,
+// ignoring what follows them (0.8.3-beta). Empty is a development build.
+func parseVersion(v string) ([]int, error) {
+	v = strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(v), "v"))
+	if v == "" {
+		return nil, nil // none, so nil slices apart from a real error
+	}
+	if i := strings.IndexAny(v, "-+"); i >= 0 {
+		v = v[:i]
+	}
+	parts := strings.Split(v, ".")
+	nums := make([]int, len(parts))
+	for i, p := range parts {
+		n, err := strconv.Atoi(p)
+		if err != nil || n < 0 {
+			return nil, fmt.Errorf("版本号 %q 不是数字版本", v)
+		}
+		nums[i] = n
+	}
+	return nums, nil
+}
