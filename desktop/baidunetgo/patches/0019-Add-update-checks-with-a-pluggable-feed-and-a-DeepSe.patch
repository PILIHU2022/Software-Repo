diff --git a/app/settings_page.go b/app/settings_page.go
index 4bce35d..0f9d25f 100644
--- a/app/settings_page.go
+++ b/app/settings_page.go
@@ -1,14 +1,44 @@
 package app
 
 import (
+	"context"
 	"math"
+	"net/url"
+	"path/filepath"
+	"strings"
+	"time"
 
 	"github.com/egoist/mygo"
 	"github.com/egoist/mygo/ui"
 
 	"github.com/pengstem/baidunetgo/internal/player"
+	"github.com/pengstem/baidunetgo/internal/updates"
 )
 
+// updatesNow and updatesDownload do the checking and the fetching; they
+// are variables so tests can stand in for them.
+var (
+	updatesNow      = updates.Check
+	updatesDownload = updates.Download
+)
+
+// updateState is what the settings page's 更新 section shows: whether a
+// check or a download runs now and what the last ones found. It survives
+// a sign-out, so a result found before it is not lost.
+type updateState struct {
+	checking    bool          // a check runs now
+	lastCheck   time.Time     // when the last check finished
+	lastResult  string        // what it said, as a short summary
+	found       *updates.Info // a newer version the last check brought
+	downloading bool          // the found version's package downloads now
+	progress    float32       // how far that download went, 0 to 1
+	lastPath    string        // where the last package landed
+	err         string        // why the last check or download failed
+	editing     bool          // the 更新地址 dialog is open
+	draft       string        // what that dialog edits
+	autoDone    bool          // this launch's automatic check ran
+}
+
 // version is the app's version, which mygo build links in from mygo.json.
 // Builds run with go run or mygo dev have none.
 func version() string {
@@ -44,6 +74,218 @@ func (a *App) useSettings() {
 	}
 }
 
+// checkUpdates asks the update feed whether a newer version is out, on a
+// goroutine, writing what it finds back through a.update. auto marks the
+// launch's own check, which stays quiet: no toast, so a failure waits in
+// the settings page instead of interrupting.
+func (a *App) checkUpdates(auto bool) {
+	st := &a.updates
+	if st.checking || st.downloading {
+		return
+	}
+	feed := a.settings.updateURL()
+	if feed == "" {
+		st.autoDone = true
+		st.lastCheck, st.found, st.lastResult = time.Now(), nil, ""
+		st.err = "更新地址未配置：等待发布通道就绪后填入"
+		return
+	}
+	cur := version()
+	st.checking, st.err, st.found, st.autoDone = true, "", nil, true
+	go func() {
+		info, err := updatesNow(context.Background(), feed, mygo.App.Version())
+		a.update(func() {
+			st := &a.updates
+			st.checking = false
+			st.lastCheck = time.Now()
+			if err != nil {
+				st.found, st.lastResult = nil, ""
+				st.err = err.Error()
+				return
+			}
+			st.err, st.lastPath = "", ""
+			st.found = info
+			if info.Newer {
+				st.lastResult = "发现新版本 " + info.Version
+				if !auto {
+					a.toast("发现新版本 "+info.Version, "success")
+				}
+			} else {
+				st.lastResult = "已是最新版本（" + cur + "）"
+			}
+		})
+	}()
+}
+
+// maybeCheckUpdates runs the launch's one automatic check, once the app
+// is signed in, when the user left it on and a feed is set. Called on the
+// UI thread; the request goes on checkUpdates's goroutine.
+func (a *App) maybeCheckUpdates() {
+	if a.updates.autoDone {
+		return
+	}
+	if !a.settings.autoUpdate() || a.settings.updateURL() == "" {
+		a.updates.autoDone = true
+		return
+	}
+	a.checkUpdates(true)
+}
+
+// downloadUpdate fetches the found version's package into the download
+// folder on a goroutine, reporting the progress into the settings page.
+// It does not install anything: this build carries no update signing key,
+// so the package waits for the user to install it (docs/UPDATES.md).
+func (a *App) downloadUpdate() {
+	st := &a.updates
+	if st.found == nil || st.downloading || st.checking {
+		return
+	}
+	info := *st.found
+	dest := a.settings.downloadDir()
+	st.downloading, st.progress, st.err = true, 0, ""
+	go func() {
+		p, err := updatesDownload(context.Background(), &info, dest, func(done, total int64) {
+			if total <= 0 {
+				return
+			}
+			frac := float32(done) / float32(total)
+			a.update(func() { a.updates.progress = frac })
+		})
+		a.update(func() {
+			st := &a.updates
+			st.downloading = false
+			if err != nil {
+				st.err = err.Error()
+				return
+			}
+			st.progress, st.lastPath = 1, p
+			st.lastResult = "已下载：" + filepath.Base(p)
+			a.toast("已下载到 "+p, "success")
+		})
+	}()
+}
+
+// saveUpdateURL keeps the 更新地址 dialog's address, forgetting the last
+// check's result, which answered the old address.
+func (a *App) saveUpdateURL() {
+	a.updates.editing = false
+	v := strings.TrimSpace(a.updates.draft)
+	if a.settings.UpdateURL == v {
+		return
+	}
+	a.settings.UpdateURL = v
+	a.updates.found, a.updates.lastResult, a.updates.err, a.updates.lastPath = nil, "", "", ""
+	a.updates.autoDone = false // a new address is worth a fresh check
+	a.applySettings()
+}
+
+// updateHost names a feed's host, for a detail line.
+func updateHost(feed string) string {
+	if u, err := url.Parse(feed); err == nil && u.Host != "" {
+		return u.Host
+	}
+	return feed
+}
+
+// updatesSection is the settings page's 更新 group: the switch, the check
+// itself and the feed's address.
+func (a *App) updatesSection(c *ui.Context, t *ui.Theme, p *palette) {
+	s := &a.settings
+	st := &a.updates
+	section(c, t, p, "更新", func() {
+		on := s.autoUpdate()
+		detail := ""
+		if feed := s.updateURL(); feed != "" {
+			detail = "检查 " + updateHost(feed) + " 的更新"
+			if !st.lastCheck.IsZero() {
+				detail += " · 上次检查 " + st.lastCheck.Format("15:04")
+			}
+			if st.lastResult != "" {
+				detail += "：" + st.lastResult
+			}
+		} else {
+			detail = "更新地址未配置：等待发布通道就绪后填入"
+		}
+		settingRow(c, t, p, "自动检查更新", "", detail, func() {
+			if ui.Switch(c, &on).Label("自动检查更新").Changed() {
+				v := on
+				s.AutoUpdate = &v
+				a.applySettings()
+			}
+		})
+		checkDetail := "检查是否有新版本"
+		switch {
+		case st.checking:
+			checkDetail = "正在检查更新…"
+		case st.downloading:
+			checkDetail = "正在下载 " + st.found.Version + "：" + itoa(int(math.Round(float64(st.progress)*100))) + "%"
+		case st.err != "":
+			checkDetail = st.err
+		case st.lastPath != "":
+			checkDetail = "已下载：" + st.lastPath
+		case st.found != nil && st.found.Newer:
+			checkDetail = "发现新版本 " + st.found.Version
+			if st.found.Notes != "" {
+				checkDetail += "：" + st.found.Notes
+			}
+		case st.lastResult != "":
+			checkDetail = st.lastResult
+		case s.updateURL() == "":
+			checkDetail = "更新地址未配置：等待发布通道就绪后填入"
+		}
+		settingRow(c, t, p, "检查更新", "", checkDetail, func() {
+			if st.downloading {
+				ui.Spinner(c).Label("下载中")
+				return
+			}
+			if pill(c, t, p, "refresh-cw", "立即检查", false).Disabled(st.checking).Clicked() {
+				a.checkUpdates(false)
+			}
+			if st.found != nil && st.found.Newer {
+				if pill(c, t, p, "download", "下载", true).Clicked() {
+					a.downloadUpdate()
+				}
+			}
+		})
+		shown := s.UpdateURL
+		if shown == "" {
+			shown = "未设置"
+		} else if u, err := url.Parse(shown); err == nil && u.Host != "" {
+			shown = u.Host + u.Path
+		}
+		settingRow(c, t, p, "更新地址", "", shown, func() {
+			if pill(c, t, p, "pencil", "编辑…", false).Clicked() {
+				st.draft = s.UpdateURL
+				st.editing = true
+			}
+		})
+	})
+}
+
+// updateDialog asks for the feed's address in a small dialog of the
+// settings page's own, like the dedup page's pickers.
+func (a *App) updateDialog(c *ui.Context, t *ui.Theme, p *palette) {
+	st := &a.updates
+	ui.Modal(c, &st.editing, func() {
+		dialogTitle(c, t, "更新地址", "发布通道的 feed 地址，留空表示未配置")
+		in := ui.TextInputBase(c.Key("update-url"), &st.draft).Label("更新地址").
+			Placeholder("https://example.com/update.json").Grow(1)
+		ui.Text(c, "留空时检查更新显示为待配置状态，不会请求网络；发布通道就绪后填入即可。").
