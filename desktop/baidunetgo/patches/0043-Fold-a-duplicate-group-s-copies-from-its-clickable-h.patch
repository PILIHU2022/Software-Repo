+// toggleGroupFold folds a group of the group view away, or shows it again,
+// keyed by the group's key so that it stays folded across a regroup. Like
+// toggleFold it reads nothing again and starts no scan.
+func (d *dedupState) toggleGroupFold(key dedup.Key) {
+	if d.groupFolded == nil {
+		d.groupFolded = map[dedup.Key]bool{}
+	}
+	if d.groupFolded[key] {
+		delete(d.groupFolded, key)
+	} else {
+		d.groupFolded[key] = true
+	}
+	d.flatten()
+}
