diff --git a/app/dedup_test.go b/app/dedup_test.go
index 92c8e44..7ec32aa 100644
--- a/app/dedup_test.go
+++ b/app/dedup_test.go
@@ -175,6 +175,165 @@ func TestDedup(t *testing.T) {
 	save(t, tt, "dedup-after-delete")
 }
 
+// TestDedupFold checks that both views fold: a group's heading hides its
+// copies in the group view, a folder's line hides its copies in the folder
+// view, each view keeps its folds across a switch, and the 保留一份 pill
+// folds nothing.
+func TestDedupFold(t *testing.T) {
+	oldWorkers, oldReport := dedupWorkers, dedupReport
+	dedupWorkers, dedupReport = 2, 0
+	t.Cleanup(func() { dedupWorkers, dedupReport = oldWorkers, oldReport })
+
+	a, tt, _ := signedIn(t)
+	a.router.Replace("/dedup")
+	waitUntil(t, tt, "the dedup scan", func() bool { return a.dedup.loaded })
+	tt.Advance(300 * time.Millisecond)
+
+	d := &a.dedup
+	if len(d.groups) < 2 {
+		t.Fatalf("only %d groups to fold", len(d.groups))
+	}
+	// The rows a group of either view shows in groupRows: its heading and
+	// its copies.
+	groupRows := func(gi int) (heading bool, copies int) {
+		for _, r := range d.rows {
+			if r.group != gi {
+				continue
+			}
+			if r.file < 0 {
+				heading = true
+			} else {
+				copies++
+			}
+		}
+		return
+	}
+	folderRows := func(di int) (heading bool, files int) {
+		for _, r := range d.rows {
+			if r.dir != di {
+				continue
+			}
+			if r.file < 0 {
+				heading = true
+			} else {
+				files++
+			}
+		}
+		return
+	}
+
+	gi, g := 0, d.groups[0]
+	if heading, copies := groupRows(gi); !heading || copies != len(g.Files) {
+		t.Fatalf("group %d shows heading %v with %d of %d copies", gi, heading, copies, len(g.Files))
+	}
+	total := len(d.rows)
+
+	// 保留一份 is the pill's own click: it keeps one copy and folds nothing.
+	if err := tt.Click("保留一份"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(100 * time.Millisecond)
+	if len(d.groupFolded) != 0 {
+		t.Errorf("保留一份 folded %d groups", len(d.groupFolded))
+	}
+	if len(d.rows) != total {
+		t.Errorf("保留一份 changed the rows from %d to %d", total, len(d.rows))
+	}
+	if d.chosen[g.Files[0].Path] {
+		t.Errorf("保留一份 of group %d kept no copy", gi)
+	}
+	for _, f := range g.Files[1:] {
+		if !d.chosen[f.Path] {
+			t.Errorf("保留一份 of group %d did not choose %q", gi, f.Path)
+		}
+	}
+
+	// Clicking the heading folds the group's copies away and keeps the
+	// heading; the other groups stay open.
+	head := "每个 " + humanSize(g.Size())
+	if err := tt.Click(head); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(100 * time.Millisecond)
+	if !d.groupFolded[g.Key] {
+		t.Fatalf("clicking the heading did not fold group %d", gi)
+	}
+	if heading, copies := groupRows(gi); !heading || copies != 0 {
+		t.Errorf("folded group %d shows heading %v with %d copies", gi, heading, copies)
+	}
+	if heading, copies := groupRows(1); !heading || copies != len(d.groups[1].Files) {
+		t.Errorf("folding group %d changed group 1: heading %v, %d copies", gi, heading, copies)
+	}
+
+	// The folder view folds too, and keeps its own fold state.
+	if err := tt.Click("按文件夹"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(200 * time.Millisecond)
+	if d.byFolder != 1 {
+		t.Fatalf("the view did not switch to folders: byFolder %d", d.byFolder)
+	}
+	if !d.groupFolded[g.Key] {
+		t.Error("switching views dropped the group's fold")
+	}
+	if len(d.dirs) == 0 {
+		t.Fatal("the folder view has no folders")
+	}
+	// The first folder, the one that could free the most, unless it is the
+	// root, whose label the sidebar shows too.
+	di := 0
+	if d.dirs[di].path == "/" && len(d.dirs) > 1 {
+		di = 1
+	}
+	f := d.dirs[di]
+	if heading, files := folderRows(di); !heading || files != len(f.files) {
+		t.Fatalf("folder %q shows heading %v with %d of %d files", f.label, heading, files, len(f.files))
+	}
+	clickDedupRow(t, tt, f.label)
+	tt.Advance(100 * time.Millisecond)
+	if !d.folded[f.path] {
+		t.Fatalf("clicking folder %q did not fold it", f.label)
+	}
+	if heading, files := folderRows(di); !heading || files != 0 {
+		t.Errorf("folded folder %q shows heading %v with %d files", f.label, heading, files)
+	}
+	// Unfolding shows its copies again.
+	clickDedupRow(t, tt, f.label)
+	tt.Advance(100 * time.Millisecond)
+	if d.folded[f.path] {
+		t.Fatal("the second click did not unfold the folder")
+	}
+	if _, files := folderRows(di); files != len(f.files) {
+		t.Errorf("unfolded folder %q shows %d of %d files", f.label, files, len(f.files))
+	}
+
+	// Back in the group view the group folded earlier is still folded, and
+	// unfolding it brings its copies back.
+	if err := tt.Click("按重复组"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(200 * time.Millisecond)
+	if d.byFolder != 0 {
+		t.Fatalf("the view did not switch back: byFolder %d", d.byFolder)
+	}
+	if !d.groupFolded[g.Key] {
+		t.Error("the group's fold did not survive the view switch")
+	}
+	if heading, copies := groupRows(gi); !heading || copies != 0 {
+		t.Errorf("the folded group %d shows heading %v with %d copies after switching back", gi, heading, copies)
+	}
+	if err := tt.Click(head); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(100 * time.Millisecond)
+	if d.groupFolded[g.Key] {
+		t.Fatal("the second click did not unfold the group")
+	}
+	if _, copies := groupRows(gi); copies != len(g.Files) {
+		t.Errorf("unfolded group %d shows %d of %d copies", gi, copies, len(g.Files))
+	}
+}
+
 // TestDedupSkipsChangedFiles checks the scan's results against the folders
 // again before deleting: a copy that changed since it was found, or a group
 // whose kept copy is gone, is left alone.
