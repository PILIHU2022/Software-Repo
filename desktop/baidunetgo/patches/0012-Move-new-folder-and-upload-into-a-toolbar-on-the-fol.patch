+// TestFolderToolbarFitsNarrow keeps the folder's toolbar whole in the
+// narrowest window: folded to icons, no tool off the window, and the new
+// folder and the upload still there to be clicked.
+func TestFolderToolbarFitsNarrow(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	save(t, tt, "toolbar-wide")
+	for _, sz := range [][2]int{{456, 760}, {420, 300}} {
+		tt.SetSize(sz[0], sz[1])
+		tt.Advance(500 * time.Millisecond)
+		if !a.sidebarCollapsed {
+			t.Errorf("%dx%d: the sidebar still shows", sz[0], sz[1])
+		}
+		if !a.compact {
+			t.Errorf("%dx%d: the toolbar did not fold", sz[0], sz[1])
+		}
+		for _, s := range []string{"新建文件夹", "排序方式", "上传"} {
+			r, ok := tt.Find(s)
+			if !ok {
+				t.Fatalf("%dx%d: no %q; texts %q", sz[0], sz[1], s, tt.Texts())
+			}
+			if r.W <= 0 || r.X < 0 || r.X+r.W > float32(sz[0]) || r.Y < 0 || r.Y+r.H > 60 {
+				t.Errorf("%dx%d: %q at %v is outside the title bar", sz[0], sz[1], s, r)
+			}
+		}
+		save(t, tt, "toolbar-"+itoa(sz[0])+"x"+itoa(sz[1]))
+	}
+}
