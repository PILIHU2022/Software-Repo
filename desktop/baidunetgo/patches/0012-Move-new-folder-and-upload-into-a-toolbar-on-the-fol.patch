+// TestFolderToolbarActions: the path bar's toolbar holds a new folder and
+// the upload, each acting: the new folder names one, the upload asks for
+// files through pickUpload.
+func TestFolderToolbarActions(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	if _, ok := tt.Find("新建文件夹"); !ok {
+		t.Fatalf("no new folder in the toolbar; texts %q", tt.Texts())
+	}
+	if _, ok := tt.Find("上传"); !ok {
+		t.Fatalf("no upload in the toolbar; texts %q", tt.Texts())
+	}
+	// The upload goes through pickUpload, which a test sees without the
+	// native dialog.
+	var got string
+	old := pickUploadHook
+	pickUploadHook = func(_ *App, dir string, _ ui.Rect) { got = dir }
+	defer func() { pickUploadHook = old }()
+	if err := tt.Click("上传"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if got != "/" {
+		t.Errorf("the upload asked for %q, want /", got)
+	}
+	if err := tt.Click("新建文件夹"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(300 * time.Millisecond)
+	if on, _ := tt.TextInputActive(); !on || a.creating == nil {
+		t.Fatal("the toolbar's new folder did not name one")
+	}
+	save(t, tt, "toolbar-new-folder")
+	tt.Key(0, ui.KeyEscape)
+	tt.Advance(100 * time.Millisecond)
+}
+
+// TestListBottomHasNoDuplicateButtons keeps the folder's actions in the
+// toolbar alone: a full list ends with its files, and the one new-folder
+// and one upload labels are those in the title bar.
+func TestListBottomHasNoDuplicateButtons(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	count := func(s string) (n int) {
+		for _, x := range tt.Texts() {
+			if x == s {
+				n++
+			}
+		}
+		return n
+	}
+	if n := count("新建文件夹"); n != 1 {
+		t.Errorf("新建文件夹 shows %d times; texts %q", n, tt.Texts())
+	}
+	if n := count("上传文件"); n != 0 {
+		t.Errorf("the old maker's 上传文件 is still there (%d); texts %q", n, tt.Texts())
+	}
+	// Nothing below the last file: the maker row takes no room when no
+	// files are dragged.
+	l := a.listings["/"]
+	last := l.files[len(l.files)-1]
+	if r, ok := tt.Find(last.Name); ok && r.Y > 0 {
+		if _, ok := tt.Find("上传文件"); ok {
+			t.Error("a maker button under the last row")
+		}
+	}
+	save(t, tt, "list-no-maker-row")
+}
+
+// TestEmptyFolderEntry: an empty folder says it is empty and offers an
+// upload of its own, named apart from the toolbar's, while a new folder
+// stays a click away in the title bar.
+func TestEmptyFolderEntry(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	a.router.Push(filesRoute("/空文件夹"))
+	waitFor(t, tt, "这里还空着")
+	r, ok := tt.Find("上传文件到此处")
+	if !ok || r.W <= 0 {
+		t.Fatalf("no empty-folder upload; texts %q", tt.Texts())
+	}
+	var got string
+	old := pickUploadHook
+	pickUploadHook = func(_ *App, dir string, _ ui.Rect) { got = dir }
+	defer func() { pickUploadHook = old }()
+	if err := tt.Click("上传文件到此处"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if got != "/空文件夹" {
+		t.Errorf("the empty upload asked for %q", got)
+	}
+	if err := tt.Click("新建文件夹"); err != nil {
+		t.Fatalf("no new folder in an empty folder: %v", err)
+	}
+	tt.Advance(300 * time.Millisecond)
+	if a.creating == nil {
+		t.Fatal("the toolbar's new folder did not name one in an empty folder")
+	}
+	save(t, tt, "empty-folder")
+}
