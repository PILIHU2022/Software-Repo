+// TestDedupCacheInvalidatedByChange checks that a change to the netdisk
+// counted by the app makes entering the page scan again.
+func TestDedupCacheInvalidatedByChange(t *testing.T) {
+	oldWorkers, oldReport := dedupWorkers, dedupReport
+	dedupWorkers, dedupReport = 2, 0
+	t.Cleanup(func() { dedupWorkers, dedupReport = oldWorkers, oldReport })
+
+	dir := dedupCacheIn(t)
+	a, tt, srv := signedIn(t)
