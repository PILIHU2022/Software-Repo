+// TestDedupCountsChanges checks that the changes the page cannot see made
+// by itself count up the netdisk's generation: a rename, a folder made, an
+// upload finished, and a dialog's operation.
+func TestDedupCountsChanges(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	gen := a.netdiskGen
+
+	l := a.listings["/"]
+	dir := l.files[0]
+	if !a.renameTo(l, dir.FsID, "改名后的文件夹") {
+		t.Fatal("the rename was refused")
+	}
+	waitUntil(t, tt, "the rename", func() bool { return a.netdiskGen == gen+1 })
+	if !srv.Exists("/改名后的文件夹") {
+		t.Error("the rename did not happen")
+	}
+
+	a.creating = &creating{dir: "/", first: "存档", draft: "存档", fresh: true}
+	a.makeFolder(l, true)
+	waitUntil(t, tt, "the folder", func() bool { return a.netdiskGen == gen+2 })
+	if !srv.Exists("/存档") {
+		t.Error("the folder was not made")
+	}
+
+	a.finished(transfer.Task{Kind: transfer.Upload, State: transfer.Done, Remote: "/照片/新.png"})
+	if a.netdiskGen != gen+3 {
+		t.Errorf("a finished upload counted %d changes, want %d", a.netdiskGen-gen, 3)
+	}
+
+	a.run(func(ctx context.Context, c *baidu.Client) error { return nil }, nil, "", nil)
+	waitUntil(t, tt, "the dialog's operation", func() bool { return a.netdiskGen == gen+4 })
+
+	// A download changes nothing on the netdisk.
+	a.finished(transfer.Task{Kind: transfer.Download, State: transfer.Done, Local: "/tmp/x"})
+	if a.netdiskGen != gen+4 {
+		t.Errorf("a finished download counted a change")
+	}
+}
