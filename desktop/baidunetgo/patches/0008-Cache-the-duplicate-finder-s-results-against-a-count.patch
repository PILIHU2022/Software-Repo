+	waitUntil(t, tt, "the dedup scan", func() bool { return a.dedup.loaded })
+	waitDedupCache(t, tt, filepath.Join(dir, "dedup.json"))
+	gen, scans := a.netdiskGen, a.dedup.scanID
+
+	// A deletion, as the files page does it.
+	a.router.Replace("/files")
+	tt.Advance(200 * time.Millisecond)
+	a.remove("/文档", []baidu.File{{Path: "/文档/读我.txt"}})
+	waitUntil(t, tt, "the delete", func() bool { return !srv.Exists("/文档/读我.txt") && a.netdiskGen == gen+1 })
+	if c := a.dedupCacheNow(1); c.Gen != a.netdiskGen {
+		t.Fatalf("the cache would be written at gen %d, not %d", c.Gen, a.netdiskGen)
+	}
+
+	a.router.Replace("/dedup")
+	waitUntil(t, tt, "the new scan", func() bool { return a.dedup.scanID > scans })
+	waitUntil(t, tt, "the new results", func() bool { return a.dedup.loaded })
+	if a.dedup.cached {
+		t.Error("the page shows the results of before the change")
+	}
+	for _, g := range a.dedup.groups {
+		for _, f := range g.Files {
+			if f.Path == "/文档/读我.txt" {
+				t.Error("the deleted file is in the new results")
