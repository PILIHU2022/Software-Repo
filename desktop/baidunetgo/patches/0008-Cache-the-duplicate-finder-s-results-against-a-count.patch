+// The scan's results are kept between runs, with a generation that counts
+// the changes the user made to the netdisk: the page shows them at once
+// while the netdisk still holds what they describe, and scans again when
+// anything changed. The generation lives beside the results, in a file of
+// its own, so that a change costs one small write and not the whole cache.
+const (
+	// dedupCacheVersion is the layout of both files; a file of another
+	// layout is no cache this app wrote, and the netdisk is scanned again.
+	dedupCacheVersion = 1
+	// dedupCacheMax is the largest cache file read: it holds the duplicate
+	// groups only, so anything bigger is no cache of ours.
+	dedupCacheMax = 64 << 20
+	// dedupCacheAge is how long results are trusted with the netdisk
+	// unchanged, so that changes made from another device or client, which
+	// are not counted here, cannot leave the page on old results forever.
+	dedupCacheAge = 7 * 24 * time.Hour
+)
+
+// dedupStoreDir is where the page keeps its cache and its generation;
+// tests point it at a temporary folder, which is the only thing written
+// from the fake netdisk, so that neither them nor it touch the user's data
+// directory.
+var dedupStoreDir string
+
+// dedupDir is where the page keeps what outlasts the app, "" for nowhere.
+func (a *App) dedupDir() string {
+	if dedupStoreDir != "" {
+		return dedupStoreDir
+	}
+	if a.fake {
+		return "" // the pretend netdisk keeps nothing on disk
+	}
+	dir, err := mygo.App.Path(mygo.PathUserData)
+	if err != nil {
+		return ""
+	}
+	return dir
+}
+
+func (a *App) dedupCachePath() string {
+	if dir := a.dedupDir(); dir != "" {
+		return filepath.Join(dir, "dedup.json")
+	}
+	return ""
+}
+
+func (a *App) dedupGenPath() string {
+	if dir := a.dedupDir(); dir != "" {
+		return filepath.Join(dir, "dedup-gen.json")
+	}
+	return ""
+}
+
+// dedupCache is what a scan found, as it is kept: the groups only, the
+// fields of each file the page and the delete's checks need, and the
+// folder and statistics it was found under. The groups are kept in the
+// order Groups makes them, so that showing them again reorders nothing.
+type dedupCache struct {
+	Version   int               `json:"version"`
+	UID       uint64            `json:"uid"` // the account the paths are of
+	Gen       uint64            `json:"gen"` // the netdisk it describes
+	Root      string            `json:"root"`
+	ScannedAt time.Time         `json:"scanned_at"`
+	Dirs      int               `json:"dirs"`
+	Files     int               `json:"files"`
+	Skipped   int               `json:"skipped,omitempty"`
+	Failed    int               `json:"failed,omitempty"`
+	Truncated bool              `json:"truncated,omitempty"`
+	Groups    []dedupCacheGroup `json:"groups"`
+}
+
+// dedupCacheGroup is a group of duplicates as the cache keeps it: what it
+// recycles, cut down to the file's fields.
+type dedupCacheGroup struct {
+	Size  int64            `json:"size"`
+	MD5   string           `json:"md5"`
+	Files []dedupCacheFile `json:"files"`
+}
+
+// dedupCacheFile is a file of a group as the cache keeps it. The page's
+// list and the delete's checks read nothing else.
+type dedupCacheFile struct {
+	FsID  int64  `json:"id"`
+	Path  string `json:"path"`
+	Name  string `json:"name"`
+	Size  int64  `json:"size"`
+	MD5   string `json:"md5"`
+	Mtime int64  `json:"mtime"`
+}
+
+// groups returns the cached groups as the page holds them, the most to
+// free first, each keeping its earliest modified copy first.
+func (c dedupCache) groups() []dedup.Group {
+	out := make([]dedup.Group, 0, len(c.Groups))
+	for _, cg := range c.Groups {
+		if cg.Size <= 0 || len(cg.Files) < 2 {
+			continue
+		}
+		g := dedup.Group{Key: dedup.Key{Size: cg.Size, MD5: cg.MD5}}
+		for _, cf := range cg.Files {
+			// A cache that disagrees with itself is no cache: only the
+			// files that are the group's are kept.
+			if cf.Path == "" || cf.Size != cg.Size || cf.MD5 != cg.MD5 {
+				continue
+			}
+			name := cf.Name
+			if name == "" {
+				name = path.Base(cf.Path)
+			}
+			g.Files = append(g.Files, baidu.File{
+				FsID: cf.FsID, Path: cf.Path, Name: name,
+				Size: cf.Size, MD5: cf.MD5, Mtime: cf.Mtime,
+			})
+		}
+		if len(g.Files) < 2 {
+			continue
+		}
+		g.Reclaim = g.Key.Size * int64(len(g.Files)-1)
+		out = append(out, g)
+	}
+	return out
+}
+
+// readDedupCache reads the results kept at p, reporting whether they are
+// there and of the layout this app writes. It runs off the UI thread, as
+// the file can hold thousands of groups.
+func readDedupCache(p string) (dedupCache, bool) {
+	if p == "" {
+		return dedupCache{}, false
+	}
+	data, err := os.ReadFile(p)
+	if err != nil || len(data) > dedupCacheMax {
+		return dedupCache{}, false
+	}
+	var c dedupCache
+	if json.Unmarshal(data, &c) != nil || c.Version != dedupCacheVersion {
+		return dedupCache{}, false
+	}
+	return c, true
+}
+
+// writeFileAtomic writes data to p so that a crash leaves either the old
+// file or the new one, never half of either.
+func writeFileAtomic(p string, data []byte) {
+	tmp := p + ".tmp"
+	if os.WriteFile(tmp, data, 0o600) != nil {
+		return
+	}
+	if os.Rename(tmp, p) != nil {
+		os.Remove(tmp)
+	}
+}
+
+// saveDedupCache keeps the results in hand with the netdisk's generation,
+// so that coming back to the page need not scan again. The file is
+// marshalled and written on a goroutine: it can hold thousands of groups.
+func (a *App) saveDedupCache() {
+	p := a.dedupCachePath()
+	if p == "" || a.sess == nil {
+		return
+	}
+	c := a.dedupCacheNow(a.sess.user.UID)
+	go func() {
+		data, err := json.Marshal(c)
+		if err != nil {
+			return
+		}
+		writeFileAtomic(p, data)
+	}()
+}
+
+// dedupCacheNow is the results in hand, as the cache keeps them. It copies
+// them, so that writing them on a goroutine reads nothing that the page
+// may change meanwhile.
+func (a *App) dedupCacheNow(uid uint64) dedupCache {
+	d := &a.dedup
+	c := dedupCache{
+		Version: dedupCacheVersion, UID: uid, Gen: a.netdiskGen,
+		Root: d.root, ScannedAt: d.scannedAt,
+		Dirs: d.scannedDirs, Files: d.scannedFiles,
+		Skipped: d.skipped, Failed: d.failed, Truncated: d.truncated,
+		Groups: make([]dedupCacheGroup, 0, len(d.groups)),
+	}
+	for _, g := range d.groups {
+		cg := dedupCacheGroup{Size: g.Key.Size, MD5: g.Key.MD5, Files: make([]dedupCacheFile, 0, len(g.Files))}
+		for _, f := range g.Files {
+			cg.Files = append(cg.Files, dedupCacheFile{
+				FsID: f.FsID, Path: f.Path, Name: f.Name,
+				Size: f.Size, MD5: f.MD5, Mtime: f.Mtime,
+			})
+		}
+		c.Groups = append(c.Groups, cg)
+	}
+	return c
+}
+
+// dedupGen is the netdisk's generation as it is kept: a change counts up,
+// so that a restart still knows the cache predates it.
+type dedupGen struct {
+	Version int    `json:"version"`
+	UID     uint64 `json:"uid"`
+	Gen     uint64 `json:"gen"`
+}
+
+// loadNetdiskGen restores the generation counted for the account uid.
+func (a *App) loadNetdiskGen(uid uint64) {
+	a.netdiskGen, a.netdiskGenUID = 0, uid
+	p := a.dedupGenPath()
+	if p == "" {
+		return
+	}
+	data, err := os.ReadFile(p)
+	if err != nil {
+		return
+	}
+	var g dedupGen
+	if json.Unmarshal(data, &g) == nil && g.Version == dedupCacheVersion && g.UID == uid {
+		a.netdiskGen = g.Gen
+	}
+}
+
+// netdiskChanged records that the user changed the netdisk (deleted,
+// moved, copied, renamed, made a folder, restored or emptied the recycle
+// bin, uploaded, or had an offline download finish), so the results of the
+// last scan no longer describe it. The count is written at once: a restart
+// must not trust the cache again. It runs on the UI thread.
+func (a *App) netdiskChanged() {
+	a.netdiskGen++
+	p := a.dedupGenPath()
+	if p == "" {
+		return
+	}
+	data, err := json.Marshal(dedupGen{Version: dedupCacheVersion, UID: a.netdiskGenUID, Gen: a.netdiskGen})
+	if err != nil {
+		return
+	}
+	writeFileAtomic(p, data)
+}
+
+// dedupCacheFresh reports whether the cached results still describe the
+// netdisk: the cache is this app's layout, of the account signed in, of the
+// generation the netdisk is at, and not old enough for another client's
+// changes to be expected.
+func (a *App) dedupCacheFresh(c dedupCache, uid uint64) bool {
+	if a.sess == nil || c.UID != uid || c.Gen != a.netdiskGen || c.Version != dedupCacheVersion {
+		return false
+	}
+	if c.ScannedAt.IsZero() {
+		return false
+	}
+	return time.Since(c.ScannedAt) <= dedupCacheAge
+}
+
+// enterDedup fills the page on its way in: the last scan's results when the
+// netdisk has not changed since, else a scan of the folder scanned last
+// time, "/" the first time. The cache is read and parsed on a goroutine,
+// as it can hold thousands of groups, and the page shows its skeleton until
+// it comes in.
+func (a *App) enterDedup() {
+	s := a.sess
+	d := &a.dedup
+	if s == nil || d.scanning || d.busy || d.loading {
+		return
+	}
+	d.loading = true
+	d.loadID++
+	id, root, uid := d.loadID, d.root, s.user.UID
+	cachePath := a.dedupCachePath()
+	go func() {
+		c, ok := readDedupCache(cachePath)
+		a.update(func() {
+			if a.sess != s || d.loadID != id {
+				return
+			}
+			d.loading = false
+			if ok && a.dedupCacheFresh(c, uid) {
+				a.applyDedupCache(c)
+				return
+			}
+			// No results the netdisk still has: scan the folder this page
+			// scanned, else the one the cache scanned, else all of it.
+			if root == "" && ok {
+				root = c.Root
+			}
+			if root == "" {
+				root = "/"
+			}
+			a.startDedupScan(root)
+		})
+	}()
+}
+
+// applyDedupCache shows the results a scan left, as they were.
+func (a *App) applyDedupCache(c dedupCache) {
+	d := &a.dedup
+	d.root = c.Root
+	if d.root == "" {
+		d.root = "/"
+	}
+	d.scannedDirs, d.scannedFiles = c.Dirs, c.Files
+	d.skipped, d.failed, d.truncated = c.Skipped, c.Failed, c.Truncated
+	d.groups = c.groups()
+	d.flatten()
+	d.chooseDefaults()
+	d.loaded, d.loading, d.scanning = true, false, false
+	d.started, d.canceled, d.err = true, false, ""
+	d.cached, d.stale = true, false
+	d.scannedAt = c.ScannedAt
+	d.resultsGen = a.netdiskGen
+	d.curDir = ""
+	d.scrollTop = true
+}
+
+// dedupEnter reads the page again when it comes back to and the netdisk
+// changed while it was away. A page built every frame keeps what it has, so
+// that a change under the user's eyes, an upload finishing while they read
+// the results, does not throw their choice away.
+func (a *App) dedupEnter() {
+	d := &a.dedup
+	entering := d.shown == 0 || d.shown != a.frame-1
+	d.shown = a.frame
+	if !entering || d.loading || d.scanning || d.busy {
+		return
+	}
+	if d.started && (!d.loaded || d.resultsGen == a.netdiskGen) {
+		return
+	}
+	a.enterDedup()
+}
