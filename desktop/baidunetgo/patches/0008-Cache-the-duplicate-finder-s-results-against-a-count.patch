+// TestDedupRowMenu checks the context menu of a result: opening the
+// preview of a picture with the group's other pictures for the arrows,
+// showing the file in its folder, and copying its path.
+func TestDedupRowMenu(t *testing.T) {
+	oldWorkers, oldReport := dedupWorkers, dedupReport
+	dedupWorkers, dedupReport = 2, 0
+	t.Cleanup(func() { dedupWorkers, dedupReport = oldWorkers, oldReport })
+
+	a, tt, _ := signedIn(t)
+	a.router.Replace("/dedup")
+	waitUntil(t, tt, "the dedup scan", func() bool { return a.dedup.loaded })
+	tt.Advance(300 * time.Millisecond)
+
+	var group dedup.Group
+	for _, g := range a.dedup.groups {
+		if len(g.Files) > 1 && kindOf(&g.Files[0]) == kindImage && kindOf(&g.Files[1]) == kindImage {
+			group = g
+			break
+		}
+	}
+	if len(group.Files) < 2 {
+		t.Fatal("the fake netdisk has no duplicate pictures")
+	}
+	f := group.Files[0]
+	// The page never reads the pictures' folder, so the preview has only
+	// the group to step through.
+	if a.listings[path.Dir(f.Path)] != nil {
+		t.Fatalf("the folder %q was read", path.Dir(f.Path))
+	}
+	chosen := len(a.dedup.chosen)
+	scans := a.dedup.scanID
+
+	rightClickRow(t, tt, f.Name)
+	tt.Advance(100 * time.Millisecond)
+	save(t, tt, "dedup-row-menu")
+	menu := strings.Join(tt.Menu(), "/")
+	for _, want := range []string{"打开预览", "在文件夹中显示", "复制路径"} {
+		if !strings.Contains(menu, want) {
+			t.Fatalf("menu %q lacks %q", menu, want)
+		}
+	}
+	if err := tt.ChooseMenuItem("打开预览"); err != nil {
+		t.Fatalf("%v; menu %q", err, tt.Menu())
+	}
+	tt.Advance(100 * time.Millisecond)
+	if a.pv == nil || a.pv.file.Path != f.Path {
+		t.Fatalf("preview of %+v", a.pv)
+	}
+	if len(a.pv.group) != len(group.Files) {
+		t.Fatalf("the preview steps through %d pictures, want the group's %d", len(a.pv.group), len(group.Files))
+	}
+	a.step(1)
+	if a.pv == nil || a.pv.file.Path == f.Path || a.pv.file.Path != group.Files[1].Path {
+		t.Errorf("the next picture is %+v", a.pv.file)
+	}
+	a.closePreview()
+	// The page kept everything it had: no scan, no choice lost.
+	if a.dedup.scanID != scans || len(a.dedup.chosen) != chosen || !a.dedup.loaded {
+		t.Errorf("the preview changed the page: %d scans, %d chosen", a.dedup.scanID, len(a.dedup.chosen))
+	}
+
+	// The path is copied.
+	tt.Advance(300 * time.Millisecond)
+	rightClickRow(t, tt, f.Name)
+	tt.Advance(100 * time.Millisecond)
+	if err := tt.ChooseMenuItem("复制路径"); err != nil {
+		t.Fatalf("%v; menu %q", err, tt.Menu())
+	}
+	tt.Advance(100 * time.Millisecond)
+	if got := tt.Clipboard(); got != f.Path {
+		t.Errorf("copied %q, want %q", got, f.Path)
+	}
+	if !tt.HasText("已复制路径") {
+		t.Errorf("no word of the copy: %q", tt.Texts())
+	}
+
+	// The file is shown in its folder.
+	rightClickRow(t, tt, f.Name)
+	tt.Advance(100 * time.Millisecond)
+	if err := tt.ChooseMenuItem("在文件夹中显示"); err != nil {
+		t.Fatalf("%v; menu %q", err, tt.Menu())
+	}
+	waitFor(t, tt, path.Base(f.Path))
+	if got := a.currentDir(); got != path.Dir(f.Path) {
+		t.Errorf("showing the file went to %q, want %q", got, path.Dir(f.Path))
+	}
+}
