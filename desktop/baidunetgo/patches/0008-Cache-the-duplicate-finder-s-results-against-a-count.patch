+// TestDedupCacheRejected checks that no cache this app did not write, or
+// one that is too old, or one of another account, keeps the page from
+// scanning: each falls back to a scan, none of them panics.
+func TestDedupCacheRejected(t *testing.T) {
+	oldWorkers, oldReport := dedupWorkers, dedupReport
+	dedupWorkers, dedupReport = 2, 0
+	t.Cleanup(func() { dedupWorkers, dedupReport = oldWorkers, oldReport })
+
+	group := func() []dedupCacheGroup {
+		return []dedupCacheGroup{{
+			Size: 5, MD5: "other",
+			Files: []dedupCacheFile{
+				{Path: "/没有这个文件.txt", Name: "没有这个文件.txt", Size: 5, MD5: "other"},
+				{Path: "/也没有这个.txt", Name: "也没有这个.txt", Size: 5, MD5: "other"},
+			},
+		}}
+	}
+	fresh := func(mut func(*dedupCache)) []byte {
+		c := dedupCache{Version: dedupCacheVersion, UID: 1, Root: "/", ScannedAt: time.Now(), Dirs: 3, Files: 9, Groups: group()}
+		mut(&c)
+		data, err := json.Marshal(c)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return data
+	}
+	for _, tc := range []struct {
+		name string
+		data []byte
+	}{
+		{"version", fresh(func(c *dedupCache) { c.Version = dedupCacheVersion + 1 })},
+		{"account", fresh(func(c *dedupCache) { c.UID = 99 })},
+		{"old", fresh(func(c *dedupCache) { c.ScannedAt = time.Now().Add(-dedupCacheAge - time.Hour) })},
+		{"corrupt", []byte(`{"version":1,"groups":[`)},
+		{"nothing", nil},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := dedupCacheIn(t)
+			if tc.data != nil {
+				if err := os.WriteFile(filepath.Join(dir, "dedup.json"), tc.data, 0o600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			a, tt, _ := signedIn(t)
+			a.router.Replace("/dedup")
+			waitUntil(t, tt, "the scan", func() bool { return a.dedup.scanID > 0 })
+			waitUntil(t, tt, "the results", func() bool { return a.dedup.loaded })
+			if a.dedup.cached || a.dedup.scanID != 1 {
+				t.Errorf("took the cache: cached %v, %d scans", a.dedup.cached, a.dedup.scanID)
+			}
+			for _, g := range a.dedup.groups {
+				for _, f := range g.Files {
+					if f.Path == "/没有这个文件.txt" {
+						t.Error("shows the cache's made-up group")
+					}
+				}
+			}
+		})
+	}
+}
