-	return groups, skipped
+}
+
+// Without returns the groups left when the files at the paths in gone are
+// gone: a group keeps its other copies as they came, and a group of fewer
+// than two copies is no group. The groups come as Groups returns them, the
+// most to free first, so that the results of a scan minus the copies it
+// deleted are exactly what Groups would find in what is left.
+func Without(groups []Group, gone map[string]bool) []Group {
+	out := make([]Group, 0, len(groups))
+	for _, g := range groups {
+		kept := make([]baidu.File, 0, len(g.Files))
+		for _, f := range g.Files {
+			if !gone[f.Path] {
+				kept = append(kept, f)
+			}
+		}
+		if len(kept) < 2 {
+			continue
+		}
+		out = append(out, Group{Key: g.Key, Files: kept, Reclaim: g.Key.Size * int64(len(kept)-1)})
+	}
+	sortGroups(out)
+	return out
