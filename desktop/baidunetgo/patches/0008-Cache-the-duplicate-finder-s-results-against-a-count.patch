+// TestWithout checks that the groups left after a delete are exactly what
+// Groups finds in the files left behind: the same groups, their copies in
+// the same order, the same reclaim, the most to free first.
+func TestWithout(t *testing.T) {
+	files := []baidu.File{
+		f("/a.txt", "same", 100, 200), f("/dir/b.txt", "same", 100, 100),
+		f("/big1.dat", "big", 1000, 1), f("/big2.dat", "big", 1000, 2), f("/big3.dat", "big", 1000, 3),
+		f("/mid1.dat", "mid", 50, 1), f("/mid2.dat", "mid", 50, 2),
+		f("/one.dat", "one", 7, 1),
+	}
+	groups, _ := Groups(files)
+	if len(groups) != 3 {
+		t.Fatalf("%d groups", len(groups))
+	}
+	for _, gone := range []map[string]bool{
+		{"/a.txt": true},
+		{"/big2.dat": true},
+		{"/big1.dat": true, "/big3.dat": true},
+		{"/mid2.dat": true, "/a.txt": true, "/big3.dat": true},
+		{},
+	} {
+		var left []baidu.File
+		for _, x := range files {
+			if !gone[x.Path] {
+				left = append(left, x)
+			}
+		}
+		want, _ := Groups(left)
+		got := Without(groups, gone)
+		if len(got) != len(want) {
+			t.Fatalf("gone %v: %d groups, want %d", gone, len(got), len(want))
+		}
+		for i := range want {
+			if got[i].Key != want[i].Key || got[i].Reclaim != want[i].Reclaim {
+				t.Errorf("gone %v: group %d %+v, want %+v", gone, i, got[i], want[i])
+			}
+			if !slices.Equal(ids(got[i].Files), ids(want[i].Files)) {
+				t.Errorf("gone %v: group %d files %v, want %v", gone, i, ids(got[i].Files), ids(want[i].Files))
+			}
+		}
+	}
+}
