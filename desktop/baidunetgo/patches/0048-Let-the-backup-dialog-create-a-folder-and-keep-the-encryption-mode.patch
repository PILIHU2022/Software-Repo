+// openBackupDestNew opens the 新建文件夹 dialog of 备份到 on the folder shown.
+func (a *App) openBackupDestNew() {
+	b := &a.backup
+	b.destNewName, b.destNewErr, b.destNewBusy = "", "", false
+	b.destNewOpen = true
+}
+
+// createBackupDestFolder makes the folder named in 备份到's 新建文件夹 dialog
+// under the folder shown, then moves the chooser into it so the new folder
+// can be chosen at once. It makes a missing destination folder on the way,
+// as the backup engine itself does.
+func (a *App) createBackupDestFolder() {
+	b := &a.backup
+	if b.destNewBusy {
+		return
+	}
+	name := strings.TrimSpace(b.destNewName)
+	switch {
+	case name == "":
+		b.destNewErr = "请输入文件夹名称"
+		return
+	case name == "." || name == "..":
+		b.destNewErr = "名称不能是 . 或 .."
+		return
+	case strings.ContainsAny(name, badNameChars):
+		b.destNewErr = `名称不能包含 / \ : * ? " < > |`
+		return
+	}
+	parent := b.destPicker.dir
+	newDir := path.Join(parent, name)
+	if fs, ok := b.destPicker.folders[parent]; ok {
+		for _, f := range fs {
+			if f.IsDir && strings.EqualFold(f.Name, name) {
+				b.destNewErr = "这里已有名为「" + name + "」的文件夹"
+				return
+			}
+		}
+	}
+	s := a.sess
+	if s == nil {
+		b.destNewErr = "未登录，无法新建文件夹"
+		return
+	}
+	b.destNewBusy, b.destNewErr = true, ""
+	go func() {
+		ctx := context.Background()
+		err := a.ensureNetdiskFolder(ctx, s.client, parent)
+		if err == nil {
+			err = s.client.Mkdir(ctx, newDir)
+		}
+		a.update(func() {
+			b.destNewBusy = false
+			if err != nil {
+				b.destNewErr = "无法新建「" + name + "」：" + err.Error()
+				return
+			}
+			a.netdiskChanged()
+			a.noteBackupDestFolder(parent, name, newDir)
+			b.destPicker.dir = newDir
+			b.destNewOpen, b.destNewErr, b.destNewName = false, "", ""
+		})
+	}()
+}
+
+// ensureNetdiskFolder makes dir when it is missing, and its parents before
+// it, so that a new folder can be made under a destination the first backup
+// has not created yet.
+func (a *App) ensureNetdiskFolder(ctx context.Context, c *baidu.Client, dir string) error {
+	if dir == "" || dir == "/" {
+		return nil
+	}
+	if _, err := c.List(ctx, dir, baidu.Order{By: "name"}); err == nil {
+		return nil
+	}
+	parent := path.Dir(dir)
+	if parent == dir {
+		return nil
+	}
+	if err := a.ensureNetdiskFolder(ctx, c, parent); err != nil {
+		return err
+	}
+	return c.Mkdir(ctx, dir)
+}
+
+// noteBackupDestFolder puts a folder just made into the chooser's cache of
+// its parent, and reads the parent again where the browser shows it, so
+// going back up shows the folder without another round of the chooser's own
+// loading.
+func (a *App) noteBackupDestFolder(parent, name, dir string) {
+	pk := &a.backup.destPicker
+	var fs []baidu.File
+	if cached, ok := pk.folders[parent]; ok {
+		fs = cached
+	} else if l := a.listings[parent]; l != nil && l.loaded {
+		for _, f := range l.files {
+			if f.IsDir {
+				fs = append(fs, f)
+			}
+		}
+	}
+	if fs != nil {
+		if pk.folders == nil {
+			pk.folders = map[string][]baidu.File{}
+		}
+		fs = append(fs, baidu.File{Name: name, Path: dir, IsDir: true})
+		sortFiles(fs, baidu.Order{By: "name"})
+		pk.folders[parent] = fs
+	}
+	delete(pk.folders, dir)
+	delete(pk.loading, dir)
+	a.reload(parent)
+}
