+// TestBackupEncryptModeStaysWhenSwitchedOff changes 加密方式 while 加密备份 is
+// off and then turns the switch on: the mode chosen stays, and key-only
+// encryption asks for a recipient, never for a passphrase.
+func TestBackupEncryptModeStaysWhenSwitchedOff(t *testing.T) {
+	backupTestDirs(t)
+	a, tt, _ := signedIn(t)
+	a.settings.Backup.Encrypt = false
+	a.settings.Backup.EncryptMode = backupModePassphrase
+	a.applyBackupSettings()
+	a.router.Push("/settings")
+	waitFor(t, tt, "备份到")
+	scrollToShow(t, tt, "加密方式")
+	if err := tt.Click("仅密码"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(100 * time.Millisecond)
+	if err := tt.ChooseMenuItem("收件人密钥"); err != nil {
+		t.Fatalf("%v; menu %q", err, tt.Menu())
+	}
+	tt.Advance(200 * time.Millisecond)
+	if a.settings.Backup.EncryptMode != backupModeKeys {
+		t.Fatalf("mode after choosing while off = %q, want keys", a.settings.Backup.EncryptMode)
+	}
+	if a.backup.pwdOpen || a.backup.recOpen {
+		t.Fatal("changing the mode while encryption is off opened a dialog")
+	}
+	save(t, tt, "settings-backup-mode-off")
+	if !tt.HasText("收件人密钥") {
+		t.Errorf("the 加密方式 row does not show the chosen mode; texts %q", tt.Texts())
+	}
+	if got := a.settings.backupEncryptMode(); got != "" {
+		t.Errorf("backupEncryptMode with encryption off = %q, want none", got)
+	}
+	if got := a.settings.backupConfiguredEncryptMode(); got != backupModeKeys {
+		t.Errorf("configured mode = %q, want keys", got)
+	}
+
+	scrollToShow(t, tt, "加密备份")
+	sw, ok := tt.AccessByRole(ui.RoleSwitch, "加密备份")
+	if !ok {
+		t.Fatalf("no 加密备份 switch; texts %q", tt.Texts())
+	}
+	b := sw.Bounds
+	tt.ClickAt(b.X+b.W/2, b.Y+b.H/2)
+	tt.Advance(300 * time.Millisecond)
+	if !a.settings.Backup.Encrypt {
+		t.Fatal("turning 加密备份 on did not take")
+	}
+	if a.backup.pwdOpen {
+		t.Fatal("key-only encryption asked for a passphrase")
+	}
+	if a.settings.Backup.EncryptMode != backupModeKeys || a.settings.backupEncryptModeIndex() != 1 {
+		t.Fatalf("turning encryption on changed the mode: %q index %d",
+			a.settings.Backup.EncryptMode, a.settings.backupEncryptModeIndex())
+	}
+	if !a.backup.recOpen {
+		t.Error("key-only encryption with no recipient did not open the recipients dialog")
+	}
+}
