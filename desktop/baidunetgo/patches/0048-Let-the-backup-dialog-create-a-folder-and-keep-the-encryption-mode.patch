+	if got, want := a.backup.destPicker.dir, "/备份/自动备份"; got != want {
+		t.Errorf("chooser after creating the folder = %q, want %q", got, want)
+	}
+	if a.backup.destNewOpen {
+		t.Error("the 新建文件夹 dialog stayed open after making the folder")
+	}
+	save(t, tt, "settings-backup-dest-created")
+	if !tt.HasText("当前：/备份/自动备份") {
+		t.Errorf("the chooser does not show the new folder; texts %q", tt.Texts())
+	}
+	if err := tt.Click("选择此文件夹"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if got, want := a.settings.backupDest(), "/备份/自动备份"; got != want {
+		t.Errorf("backup destination = %q, want %q", got, want)
+	}
+	if a.backup.destOpen {
+		t.Error("the 备份到 dialog stayed open after choosing")
