-    // The system back unwinds our own path stack before it leaves the app.
-    BackHandler(enabled = files.stack.isNotEmpty()) { vm.filesBack() }
+    // A selection belongs to the folder shown; leaving it or refreshing away
+    // some of its rows must not leave stale keys behind.
+    LaunchedEffect(files.path) {
+        selected = emptySet()
+        dragBase = emptySet()
+        dragAnchor = null
+    }
+    LaunchedEffect(rowKeys) {
+        selected = selected.intersect(rowKeySet)
+        dragBase = dragBase.intersect(rowKeySet)
+        val anchor = dragAnchor
+        if (anchor != null && anchor !in rowKeySet) dragAnchor = null
+    }
+    // The system back clears the selection first, then unwinds our own path
+    // stack, then leaves the app.
+    BackHandler(enabled = files.stack.isNotEmpty() || selected.isNotEmpty()) {
+        if (selected.isNotEmpty()) selected = emptySet() else vm.filesBack()
+    }
+
+    /** Starts a selection session at [key], keeping what was already selected. */
+    fun beginSelection(key: String) {
+        dragBase = selected
+        dragAnchor = key
+        selected = dragBase + key
+    }
+
+    /** A tap selects while a selection is active, and otherwise opens the row. */
+    fun tap(key: String, open: () -> Unit) {
+        if (selected.isEmpty()) {
+            open()
+        } else {
+            selected = if (key in selected) selected - key else selected + key
+        }
+    }
+
+    /** The row under [position], ignoring section labels and other list items. */
+    fun rowAt(position: Offset): String? =
+        listState.layoutInfo.visibleItemsInfo
+            .firstOrNull { position.y >= it.offset && position.y < it.offset + it.size }
+            ?.key
+            ?.let { it as? String }
+            ?.takeIf { it in rowKeySet }
+
+    /** Extends the current drag's range up to the row under [position]. */
+    fun extendSelection(position: Offset) {
+        val anchor = dragAnchor ?: return
+        val current = rowAt(position) ?: return
+        selected = dragBase + rangeKeys(rowKeys, anchor, current)
+    }
 
