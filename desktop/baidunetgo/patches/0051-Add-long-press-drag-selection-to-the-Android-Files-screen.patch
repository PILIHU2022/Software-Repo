+/** The selection key of [entry]: its type, fs id and name, so it is unique in a folder. */
+private fun entryKey(entry: RemoteFile): String =
+    "${if (entry.isDir) "dir" else "file"}:${entry.fsId}:${entry.name}"
+
+/** Every key from [from] to [to] in display order, both ends included. */
+private fun rangeKeys(order: List<String>, from: String, to: String): List<String> {
+    val start = order.indexOf(from)
+    val end = order.indexOf(to)
+    if (start < 0 || end < 0) return emptyList()
+    return order.subList(minOf(start, end), maxOf(start, end) + 1)
+}
