+                            // A gesture that is just beginning cannot be the
+                            // continuation of an older drag, so drop any anchor
+                            // a cancelled or interrupted gesture left behind.
+                            dragAnchor = null
+                            val down = awaitFirstDown(
+                                requireUnconsumed = false,
+                                pass = PointerEventPass.Initial,
+                            )
+                            val pressed = rowAt(down.position)
+                            if (pressed == null) return@awaitEachGesture
+
+                            var dragging = false
+                            while (true) {
+                                val event = awaitPointerEvent(PointerEventPass.Initial)
+                                val change = event.changes.firstOrNull { it.id == down.id }
+                                if (change == null || !change.pressed) {
+                                    // The gesture is over, whether or not it ever
+                                    // moved; a long press that stayed put still
+                                    // leaves its own selection behind.
+                                    if (dragAnchor == pressed) dragAnchor = null
+                                    return@awaitEachGesture
+                                }
+                                if (!dragging) {
+                                    // The row turns this press into a long press
+                                    // on its own timeout; until it does, leave
+                                    // the gesture to it and to the list's scroll.
+                                    if (dragAnchor == null) continue
+                                    if (dragAnchor != pressed) return@awaitEachGesture
+                                    dragging = true
+                                }
+                                change.consume()
+                                extendSelection(change.position)
+                            }
+                        }
