+                            armored = key.publicArmored,
+                            keyId = keyId,
+                            userId = key.userId,
+                            fingerprint = key.fingerprint,
+                        )
+                    }
+                    if (newEntries.isEmpty()) {
+                        str(R.string.recipients_duplicate)
+                    } else {
+                        container.pgpKeysStore.save(current.copy(recipients = current.recipients + newEntries))
