+    @Test
+    fun pgpKeysDefaultWhenMissingOrCorrupt() {
+        assertEquals(PgpKeysData(), SecureJson.decodePgpKeys(null))
+        assertEquals(PgpKeysData(), SecureJson.decodePgpKeys(""))
+        assertEquals(PgpKeysData(), SecureJson.decodePgpKeys("{not json"))
+        assertEquals(PgpKeysData(), SecureJson.decodePgpKeys("[]"))
+        // A signer entry missing its armored block or fingerprint is dropped,
+        // not turned into a half-usable key.
+        val decoded = SecureJson.decodePgpKeys("""{"signer":{"userId":"x"}}""")
+        assertNull(decoded.signer)
+        assertTrue(decoded.recipients.isEmpty())
+    }
