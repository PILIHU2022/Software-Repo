+            }
+        },
+        dismissButton = {
+            TextButton(onClick = {
+                if (adding) {
+                    adding = false
+                    error = null
+                } else {
+                    onDismiss()
+                }
+            }) {
+                Text(stringResource(R.string.action_cancel))
+            }
+        },
+    )
+}
+
+/**
+ * 签名密钥 management: the current signer (if any, removable), and two ways to
+ * set one — paste an armored private key (passphrase verified at import) or
+ * generate a fresh RSA-3072 pair on a background dispatcher. Generation shows
+ * its public armor with a copy button, ready to be imported elsewhere.
+ */
+@Composable
+fun SignerDialog(
+    signer: SignerUi?,
+    onImport: (
+        armoredText: String,
+        passphrase: CharArray,
+        onResult: (error: String?) -> Unit,
+    ) -> Unit,
+    onGenerate: (
+        name: String,
+        email: String,
+        passphrase: CharArray,
+        onResult: (publicArmored: String?, error: String?) -> Unit,
+    ) -> Unit,
+    onRemove: () -> Unit,
+    onDismiss: () -> Unit,
+) {
+    val context = LocalContext.current
+    // Resource lookups happen in composition (lint: configuration-aware);
+    // callbacks only use the captured strings.
+    val publicCopiedToast = stringResource(R.string.signer_copied)
+    var tab by rememberSaveable { mutableStateOf(0) }
+
+    // Import tab state
+    var armored by rememberSaveable { mutableStateOf("") }
+    var importPassphrase by rememberSaveable { mutableStateOf("") }
+    var importVisible by rememberSaveable { mutableStateOf(false) }
+    var importError by rememberSaveable { mutableStateOf<String?>(null) }
+    var importing by rememberSaveable { mutableStateOf(false) }
+
+    // Generate tab state
+    var name by rememberSaveable { mutableStateOf("") }
+    var email by rememberSaveable { mutableStateOf("") }
+    var generatePassphrase by rememberSaveable { mutableStateOf("") }
+    var confirmPassphrase by rememberSaveable { mutableStateOf("") }
+    var generateVisible by rememberSaveable { mutableStateOf(false) }
+    var generateError by rememberSaveable { mutableStateOf<String?>(null) }
+    var generating by rememberSaveable { mutableStateOf(false) }
+
+    // Result view: the fresh public key, ready to copy
+    var publicResult by rememberSaveable { mutableStateOf<String?>(null) }
+
+    val transformation = if (importVisible || generateVisible) {
+        VisualTransformation.None
+    } else {
+        PasswordVisualTransformation()
+    }
+    val passphraseTooShort = generatePassphrase.isNotEmpty() && generatePassphrase.length < MIN_PASSPHRASE
+    val passphraseMismatch = confirmPassphrase.isNotEmpty() && generatePassphrase != confirmPassphrase
+    val generateValid = name.isNotBlank() &&
+        email.isNotBlank() &&
+        generatePassphrase.length >= MIN_PASSPHRASE &&
+        generatePassphrase == confirmPassphrase
+
+    ExpressiveDialog(
+        onDismissRequest = onDismiss,
+        title = {
+            Text(
+                stringResource(
+                    if (publicResult != null) R.string.signer_done_title else R.string.signer_title,
+                ),
+            )
+        },
+        text = {
+            Column(
+                modifier = Modifier
+                    .heightIn(max = 460.dp)
+                    .verticalScroll(rememberScrollState()),
+                verticalArrangement = Arrangement.spacedBy(10.dp),
+            ) {
+                when {
+                    publicResult != null -> {
+                        Text(
+                            text = stringResource(R.string.signer_public_result),
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                        OutlinedTextField(
+                            value = publicResult ?: "",
+                            onValueChange = {},
+                            readOnly = true,
+                            minLines = 4,
+                            maxLines = 8,
+                            label = { Text(stringResource(R.string.signer_public_label)) },
+                            modifier = Modifier.fillMaxWidth(),
+                        )
+                        FilledTonalButton(onClick = {
+                            copyToClipboard(
+                                context,
+                                "public key",
+                                publicResult ?: "",
+                                publicCopiedToast,
+                            )
+                        }) {
+                            Icon(
+                                imageVector = Icons.Filled.ContentCopy,
+                                contentDescription = null,
+                                modifier = Modifier.size(18.dp),
+                            )
+                            Spacer(Modifier.width(6.dp))
+                            Text(stringResource(R.string.signer_copy))
+                        }
+                    }
+
+                    else -> {
+                        if (signer != null) {
+                            Row(verticalAlignment = Alignment.CenterVertically) {
+                                Column(modifier = Modifier.weight(1f)) {
+                                    Text(
+                                        text = signer.userId
+                                            ?: AppFormat.shortFingerprint(signer.fingerprint),
+                                        style = MaterialTheme.typography.bodyMedium,
+                                        maxLines = 2,
+                                    )
+                                    Text(
+                                        text = AppFormat.shortFingerprint(signer.fingerprint),
+                                        style = MaterialTheme.typography.bodySmall,
+                                        fontFamily = FontFamily.Monospace,
+                                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                    )
+                                }
+                                TextButton(
+                                    enabled = !importing && !generating,
+                                    onClick = {
+                                        onRemove()
+                                        onDismiss()
+                                    },
+                                ) {
+                                    Text(
+                                        text = stringResource(R.string.signer_remove),
+                                        color = MaterialTheme.colorScheme.error,
+                                    )
+                                }
+                            }
+                            HorizontalDivider()
+                        }
+                        ExpressiveSegmentedRow(
+                            options = listOf(
+                                stringResource(R.string.signer_import),
+                                stringResource(R.string.signer_generate),
+                            ),
+                            selectedIndex = tab,
+                            onSelect = { index ->
+                                tab = index
+                                importError = null
+                                generateError = null
+                            },
+                            enabled = !importing && !generating,
+                        )
+                        if (tab == 0) {
+                            OutlinedTextField(
+                                value = armored,
+                                onValueChange = {
+                                    armored = it
+                                    importError = null
+                                },
+                                enabled = !importing,
+                                minLines = 3,
+                                maxLines = 6,
+                                label = { Text(stringResource(R.string.signer_paste_label)) },
+                                placeholder = { Text(stringResource(R.string.signer_paste_hint)) },
+                                isError = importError != null,
+                                supportingText = importError?.let { message -> { Text(message) } },
+                                modifier = Modifier.fillMaxWidth(),
+                            )
+                            OutlinedTextField(
+                                value = importPassphrase,
+                                onValueChange = {
+                                    importPassphrase = it
+                                    importError = null
+                                },
+                                enabled = !importing,
+                                singleLine = true,
+                                label = { Text(stringResource(R.string.signer_passphrase_label)) },
+                                visualTransformation = transformation,
+                                trailingIcon = {
+                                    IconButton(onClick = { importVisible = !importVisible }) {
+                                        Icon(
+                                            imageVector = if (importVisible) {
+                                                Icons.Filled.VisibilityOff
+                                            } else {
+                                                Icons.Filled.Visibility
+                                            },
+                                            contentDescription = stringResource(
+                                                if (importVisible) R.string.passphrase_hide else R.string.passphrase_show,
+                                            ),
+                                        )
+                                    }
+                                },
+                                modifier = Modifier.fillMaxWidth(),
+                            )
+                            if (importing) {
+                                BusyRow()
+                            }
+                        } else {
+                            OutlinedTextField(
+                                value = name,
+                                onValueChange = { name = it },
+                                enabled = !generating,
+                                singleLine = true,
+                                label = { Text(stringResource(R.string.signer_name)) },
+                                modifier = Modifier.fillMaxWidth(),
+                            )
+                            OutlinedTextField(
+                                value = email,
+                                onValueChange = { email = it },
+                                enabled = !generating,
+                                singleLine = true,
+                                label = { Text(stringResource(R.string.signer_email)) },
+                                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Email),
+                                modifier = Modifier.fillMaxWidth(),
+                            )
+                            OutlinedTextField(
+                                value = generatePassphrase,
+                                onValueChange = { generatePassphrase = it },
+                                enabled = !generating,
+                                singleLine = true,
+                                label = { Text(stringResource(R.string.signer_passphrase_label)) },
+                                visualTransformation = transformation,
+                                isError = passphraseTooShort,
+                                supportingText = if (passphraseTooShort) {
+                                    { Text(stringResource(R.string.passphrase_too_short)) }
+                                } else {
+                                    null
+                                },
+                                modifier = Modifier.fillMaxWidth(),
+                            )
+                            OutlinedTextField(
+                                value = confirmPassphrase,
+                                onValueChange = { confirmPassphrase = it },
+                                enabled = !generating,
+                                singleLine = true,
+                                label = { Text(stringResource(R.string.passphrase_confirm)) },
+                                visualTransformation = transformation,
+                                isError = passphraseMismatch,
+                                supportingText = if (passphraseMismatch) {
+                                    { Text(stringResource(R.string.passphrase_mismatch)) }
+                                } else {
+                                    null
+                                },
+                                modifier = Modifier.fillMaxWidth(),
+                            )
+                            generateError?.let { message ->
+                                Text(
+                                    text = message,
+                                    style = MaterialTheme.typography.bodySmall,
+                                    color = MaterialTheme.colorScheme.error,
+                                )
+                            }
+                            if (generating) {
+                                BusyRow(label = stringResource(R.string.signer_generating))
+                            }
+                        }
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            when {
+                publicResult != null -> TextButton(onClick = onDismiss) {
+                    Text(stringResource(R.string.action_close))
+                }
+
+                tab == 0 -> TextButton(
+                    enabled = armored.isNotBlank() && importPassphrase.isNotEmpty() && !importing,
+                    onClick = {
+                        importing = true
+                        onImport(armored, importPassphrase.toCharArray()) { message ->
+                            importing = false
+                            if (message == null) {
+                                importPassphrase = ""
+                                onDismiss()
+                            } else {
+                                importError = message
+                            }
+                        }
+                    },
+                ) {
+                    Text(
+                        stringResource(
+                            if (importing) R.string.signer_importing else R.string.signer_import,
+                        ),
+                    )
+                }
+
+                else -> TextButton(
+                    enabled = generateValid && !generating,
+                    onClick = {
+                        generating = true
+                        onGenerate(name.trim(), email.trim(), generatePassphrase.toCharArray()) { public, message ->
+                            generating = false
+                            if (message == null && public != null) {
+                                generatePassphrase = ""
+                                confirmPassphrase = ""
+                                publicResult = public
+                            } else {
+                                generateError = message
+                            }
+                        }
+                    },
+                ) {
+                    Text(stringResource(R.string.signer_generate))
+                }
+            }
+        },
+        dismissButton = {
+            TextButton(
+                enabled = !importing && !generating,
+                onClick = onDismiss,
+            ) {
+                Text(stringResource(R.string.action_cancel))
+            }
+        },
+    )
+}
+
+@Composable
+private fun BusyRow(label: String = stringResource(R.string.recipients_parsing)) {
+    Row(verticalAlignment = Alignment.CenterVertically) {
+        CircularProgressIndicator(modifier = Modifier.size(18.dp), strokeWidth = 2.dp)
+        Spacer(Modifier.width(10.dp))
+        Text(
+            text = label,
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+    }
+}
