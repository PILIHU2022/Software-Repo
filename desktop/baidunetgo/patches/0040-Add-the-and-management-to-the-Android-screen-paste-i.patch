+    // ---- pgp keys ---------------------------------------------------------
+
+    fun encodePgpKeys(data: PgpKeysData): String = buildJsonObject {
+        putJsonArray("recipients") {
+            data.recipients.forEach { recipient ->
+                addJsonObject {
+                    put("armored", recipient.armored)
+                    put("keyId", recipient.keyId)
+                    recipient.userId?.let { put("userId", it) }
+                    put("fingerprint", recipient.fingerprint)
+                }
+            }
+        }
+        data.signer?.let { signer ->
+            put("signer", buildJsonObject {
+                put("armored", signer.armored)
+                signer.userId?.let { put("userId", it) }
+                put("fingerprint", signer.fingerprint)
+            })
+        }
+        data.signerPassphrase?.let { put("signerPassphrase", it) }
+    }.toString()
+
+    fun decodePgpKeys(text: String?): PgpKeysData {
+        if (text.isNullOrBlank()) return PgpKeysData()
+        return runCatching {
+            val obj = json.parseToJsonElement(text).jsonObject
+            val recipients = obj["recipients"]?.jsonArray?.mapNotNull { element ->
+                val item = element.jsonObject
+                val armored = item["armored"]?.jsonPrimitive?.contentOrNullSafe()
+                    ?: return@mapNotNull null
+                val keyId = item["keyId"]?.jsonPrimitive?.contentOrNullSafe()
+                    ?: return@mapNotNull null
+                RecipientKeyEntry(
+                    armored = armored,
+                    keyId = keyId,
+                    userId = item["userId"]?.jsonPrimitive?.contentOrNullSafe(),
+                    fingerprint = item["fingerprint"]?.jsonPrimitive?.contentOrNullSafe() ?: "",
+                )
+            }.orEmpty()
+            val signer = obj["signer"]?.jsonObject?.let { item ->
+                val armored = item["armored"]?.jsonPrimitive?.contentOrNullSafe()
+                val fingerprint = item["fingerprint"]?.jsonPrimitive?.contentOrNullSafe()
+                if (armored.isNullOrBlank() || fingerprint.isNullOrBlank()) {
+                    null
+                } else {
+                    SignerKeyEntry(
+                        armored = armored,
+                        userId = item["userId"]?.jsonPrimitive?.contentOrNullSafe(),
+                        fingerprint = fingerprint,
+                    )
+                }
+            }
+            PgpKeysData(
+                recipients = recipients,
+                signer = signer,
+                signerPassphrase = obj["signerPassphrase"]?.jsonPrimitive?.contentOrNullSafe()
+                    ?.takeIf { it.isNotEmpty() },
+            )
+        }.getOrElse { PgpKeysData() }
+    }
 }
 
