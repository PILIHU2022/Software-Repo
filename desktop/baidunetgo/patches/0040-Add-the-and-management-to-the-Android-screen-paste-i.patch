+    /**
+     * The key material one encrypted run needs, following the configured
+     * [EncryptMode]: the shared passphrase in `passphrase`/`both` modes, the
+     * parsed recipient keys in `keys`/`both` modes, and the signer key (parsed
+     * with its stored passphrase so a wrong passphrase fails here, not
+     * mid-backup) when signing is on. Unencrypted runs get an empty bundle.
+     */
+    private fun cryptoFor(encrypt: Boolean, settings: AppSettings): CryptoMaterial {
+        if (!encrypt) return CryptoMaterial(null, emptyList(), null, null)
+        val mode = settings.encryptMode
+        val stored = container.pgpKeysStore.load()
+
+        val passphrase = if (mode == EncryptMode.Keys) {
+            null
+        } else {
+            container.passphraseStore.load()?.takeIf { it.isNotEmpty() }
+                ?: throw IOException(context.getString(R.string.error_no_passphrase))
+        }
+
+        val recipients = if (mode == EncryptMode.Passphrase) {
+            emptyList()
+        } else {
+            val keys = stored.recipients.flatMap { entry ->
+                try {
+                    Pgp.readPublicKeys(entry.armored)
+                } catch (e: Exception) {
+                    throw IOException(context.getString(R.string.error_recipients_unreadable), e)
+                }
+            }
+            if (keys.isEmpty()) throw IOException(context.getString(R.string.error_no_recipients))
+            keys
+        }
+
+        var signer: PgpKey? = null
+        var signerPassphrase: CharArray? = null
+        if (settings.sign) {
+            val entry = stored.signer
+                ?: throw IOException(context.getString(R.string.error_no_signer))
+            val parsed = try {
+                signerPassphrase = (stored.signerPassphrase ?: "").toCharArray()
+                Pgp.readPrivateKey(entry.armored, signerPassphrase)
+            } catch (e: Exception) {
+                signerPassphrase?.fill('\u0000')
+                signerPassphrase = null
+                throw IOException(e.message ?: context.getString(R.string.error_no_signer), e)
+            }
+            signer = parsed
+        }
+
+        return CryptoMaterial(passphrase, recipients, signer, signerPassphrase)
+    }
+
+    /** Secret key material of one run; wiped as soon as the run ends. */
