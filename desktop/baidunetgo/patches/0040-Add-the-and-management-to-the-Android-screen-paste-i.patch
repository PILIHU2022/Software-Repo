+        val passphrase: CharArray?,
+        val recipients: List<PgpKey>,
+        val signer: PgpKey?,
+        val signerPassphrase: CharArray?,
+    ) {
+        fun wipe() {
+            passphrase?.fill('\u0000')
+            signerPassphrase?.fill('\u0000')
         }
-        return passphrase
