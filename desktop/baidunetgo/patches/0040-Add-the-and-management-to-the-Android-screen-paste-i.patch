+            _messages.tryEmit(str(R.string.backup_need_passphrase))
+            return false
+        }
+        if (mode != EncryptMode.Passphrase && state.recipients.isEmpty()) {
+            _messages.tryEmit(str(R.string.backup_need_recipients))
+            return false
+        }
+        if (state.settings.sign && state.signer == null) {
+            _messages.tryEmit(str(R.string.backup_need_signer))
+            return false
+        }
+        return true
+    }
