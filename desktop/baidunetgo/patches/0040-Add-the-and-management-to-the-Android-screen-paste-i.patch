+/**
+ * OpenPGP key material: recipient public keys, the signer private key and its
+ * passphrase, all in one Keystore-encrypted document. Never logged.
+ */
+class PgpKeysStore(private val files: EncryptedFileStore) {
+
+    fun load(): PgpKeysData = SecureJson.decodePgpKeys(files.read(PGP_KEYS_FILE))
+
+    fun save(data: PgpKeysData) {
+        files.write(PGP_KEYS_FILE, SecureJson.encodePgpKeys(data))
+    }
+
+    companion object {
+        const val PGP_KEYS_FILE = "pgp-keys.json.enc"
+    }
+}
