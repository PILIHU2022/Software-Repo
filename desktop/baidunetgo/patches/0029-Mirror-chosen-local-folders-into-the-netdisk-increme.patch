+// TestDeterministicOrder checks that the files are handed out in path order,
+// whatever the parallel setting is.
+func TestDeterministicOrder(t *testing.T) {
+	dir := t.TempDir()
+	names := []string{"b.txt", "a.txt", "d/c.txt", "d/a.txt", "z.txt", "e/f/g.txt"}
+	for _, name := range names {
+		write(t, dir, name, name)
+	}
+	want := []string{
+		"/备份/照片/a.txt",
+		"/备份/照片/b.txt",
+		"/备份/照片/d/a.txt",
+		"/备份/照片/d/c.txt",
+		"/备份/照片/e/f/g.txt",
+		"/备份/照片/z.txt",
+	}
+	var orders [][]string
+	for _, parallel := range []int{1, 3, 4} {
+		cl := newFake()
+		log := &reportLog{}
+		cfg := Config{Dest: "/备份", Folders: []Folder{{Local: dir, Remote: "照片"}}, Parallel: parallel}
+		if _, err := Run(context.Background(), cl, cfg, NewState(), "", log.add); err != nil {
+			t.Fatalf("Run: %v", err)
+		}
+		var order []string
+		for _, e := range log.starts() {
+			order = append(order, e.Remote)
+		}
+		if strings.Join(order, ",") != strings.Join(want, ",") {
+			t.Errorf("parallel %d: upload start order = %v, want %v", parallel, order, want)
+		}
+		uploaded := cl.uploadedRemotes()
+		sort.Strings(uploaded)
+		sorted := append([]string(nil), want...)
+		sort.Strings(sorted)
+		if strings.Join(uploaded, ",") != strings.Join(sorted, ",") {
+			t.Errorf("parallel %d: uploaded %v, want %v", parallel, uploaded, sorted)
+		}
+		orders = append(orders, order)
+	}
+	for i := 1; i < len(orders); i++ {
+		if strings.Join(orders[i], ",") != strings.Join(orders[0], ",") {
+			t.Errorf("order depends on Parallel: %v vs %v", orders[0], orders[i])
+		}
+	}
+}
