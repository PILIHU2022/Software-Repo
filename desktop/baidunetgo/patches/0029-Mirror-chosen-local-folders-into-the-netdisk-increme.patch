+// TestParallelLimit checks that at most Parallel uploads run at once, that a
+// zero Parallel means DefaultParallel, and that a huge one is capped.
+func TestParallelLimit(t *testing.T) {
+	cases := []struct {
+		parallel int
+		want     int
+	}{
+		{parallel: 1, want: 1},
+		{parallel: 3, want: 3},
+		{parallel: 0, want: DefaultParallel},
+		{parallel: 99, want: MaxParallel},
+	}
+	for _, tc := range cases {
+		t.Run(fmt.Sprintf("parallel=%d", tc.parallel), func(t *testing.T) {
+			dir := t.TempDir()
+			for i := 0; i < 6; i++ {
+				write(t, dir, fmt.Sprintf("f%d.txt", i), "content")
+			}
+			cl := newFake()
+			cl.hold = make(chan struct{})
+			cfg := Config{Dest: "/备份", Folders: []Folder{{Local: dir, Remote: "照片"}}, Parallel: tc.parallel}
+			done := make(chan error, 1)
+			go func() {
+				_, err := Run(context.Background(), cl, cfg, NewState(), "", nil)
+				done <- err
+			}()
+			waitFor(t, fmt.Sprintf("%d uploads in flight", tc.want), func() bool {
+				_, max := cl.concurrency()
+				return max >= tc.want
+			})
+			time.Sleep(30 * time.Millisecond) // let a worker too many start, if the cap were wrong
+			close(cl.hold)
+			if err := <-done; err != nil {
+				t.Fatalf("Run: %v", err)
+			}
+			_, max := cl.concurrency()
+			if max != tc.want {
+				t.Errorf("%d uploads ran at once, want %d", max, tc.want)
+			}
+			if got := len(cl.uploadedRemotes()); got != 6 {
+				t.Errorf("%d files uploaded, want 6", got)
+			}
+		})
+	}
+}
