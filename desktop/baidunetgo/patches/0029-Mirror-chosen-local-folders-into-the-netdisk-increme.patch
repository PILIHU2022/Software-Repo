@@ -0,0 +1,12 @@
+package backup
+
+import (
+	"github.com/pengstem/baidunetgo/internal/pgp"
+)
+
+// init wires the internal/pgp package in, so that a run that encrypts with no
+// Config.EncryptStream of its own still encrypts: the engine then calls
+// pgp.Encrypt, whose ".gpg" suffix is the one Run appends to the netdisk name.
+func init() {
+	pgpEncrypt = pgp.Encrypt
+}
diff --git a/internal/backup/pgp_integration_test.go b/internal/backup/pgp_integration_test.go
new file mode 100644
index 0000000..d2e8f1c
--- /dev/null
+++ b/internal/backup/pgp_integration_test.go
@@ -0,0 +1,89 @@
+package backup
+
+import (
+	"bytes"
+	"context"
+	"path"
+	"strings"
+	"testing"
+
+	"github.com/pengstem/baidunetgo/internal/pgp"
+)
+
+// TestEncryptWithRealPGP checks the encryption the app actually uses: a run
+// with Encrypt set and no EncryptStream of its own encrypts through
+// internal/pgp (the bridge), and what lands on the netdisk decrypts with
+// pgp.Decrypt back to the original bytes.
+func TestEncryptWithRealPGP(t *testing.T) {
+	const passphrase = "correct horse battery staple"
+	dir := t.TempDir()
+	files := map[string]string{
+		"photo.txt":     strings.Repeat("backup me, please. ", 500) + "\n中文和字节 12345\n",
+		"sub/notes.txt": "another file, small one",
+		"empty.txt":     "",
+	}
+	for name, content := range files {
+		write(t, dir, name, content)
+	}
+
+	cl := newFake()
+	before := tempLeftovers(t)
+	cfg := Config{
+		Dest:    "/备份",
+		Folders: []Folder{{Local: dir, Remote: "照片"}},
+		Encrypt: true,
+		// EncryptStream left nil: the pgp bridge must stand in.
+		Parallel: 2,
+	}
+	res, err := Run(context.Background(), cl, cfg, NewState(), passphrase, nil)
+	if err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if res.Uploaded != len(files) || res.Failed != 0 || len(res.Errors) != 0 {
+		t.Fatalf("result = %+v, want %d uploaded", res, len(files))
+	}
+	if len(tempLeftovers(t)) != len(before) {
+		t.Errorf("staging files were left behind: before %v, after %v", before, tempLeftovers(t))
+	}
+
+	remotes := map[string]string{}
+	for _, u := range mustUploads(t, cl) {
+		remotes[u.remote] = u.local
+	}
+	for name, want := range files {
+		remote := path.Join("/备份/照片", name+pgp.Suffix)
+		if !strings.HasSuffix(remote, ".gpg") {
+			t.Fatalf("pgp.Suffix is %q, but the engine appends .gpg", pgp.Suffix)
+		}
+		if _, ok := remotes[remote]; !ok {
+			t.Errorf("%s was not uploaded to %s", name, remote)
+			continue
+		}
+		data, ok := cl.file(remote)
+		if !ok || len(data) == 0 {
+			t.Errorf("%s is not on the netdisk", remote)
+			continue
+		}
+		var out bytes.Buffer
+		if err := pgp.Decrypt(&out, bytes.NewReader([]byte(data)), passphrase); err != nil {
+			t.Errorf("pgp.Decrypt(%s): %v", remote, err)
+			continue
+		}
+		if out.String() != want {
+			t.Errorf("%s decrypts to %d bytes, want %d", remote, out.Len(), len(want))
+		}
+		if err := pgp.Decrypt(&bytes.Buffer{}, bytes.NewReader([]byte(data)), "wrong passphrase"); err == nil {
+			t.Errorf("%s decrypts with the wrong passphrase", remote)
+		}
+	}
+}
+
+// mustUploads returns the uploads a fake client recorded.
+func mustUploads(t *testing.T, cl *fakeClient) []uploadCall {
+	t.Helper()
+	_, _, uploads := cl.calls()
+	if len(uploads) == 0 {
+		t.Fatal("no uploads were made")
+	}
+	return uploads
+}
diff --git a/internal/backup/state.go b/internal/backup/state.go
new file mode 100644
index 0000000..fd2d20f
--- /dev/null
+++ b/internal/backup/state.go
@@ -0,0 +1,110 @@
+package backup
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+// StateVersion is the version of the state file this package writes. A state
+// of another version is discarded by LoadState, which costs one full run and
+// never loses data.
+const StateVersion = 1
+
+// Entry is what the last successful upload of a file left behind, so that the
+// next run can tell whether the file changed.
+type Entry struct {
+	Size    int64     `json:"size"`
+	ModNano int64     `json:"mod_nano"` // modification time, UnixNano
+	Remote  string    `json:"remote"`   // netdisk path uploaded to, .gpg suffix included
+	At      time.Time `json:"at"`       // when it was uploaded
+}
+
+// State is the record of a run, keyed by absolute local path. It is a cache,
+// not a source of truth: losing it only makes the next run upload everything
+// again, and never deletes anything.
+type State struct {
+	Version int              `json:"version"`
+	Entries map[string]Entry `json:"entries"`
+}
+
+// NewState returns an empty state.
+func NewState() *State {
+	return &State{Version: StateVersion, Entries: map[string]Entry{}}
+}
+
+// LoadState reads a state file. A missing, unreadable, corrupt or
+// version-mismatched file is not an error: the returned state is empty and the
+// next run is a full one.
+func LoadState(path string) *State {
+	if path == "" {
+		return NewState()
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return NewState()
+	}
+	var loaded State
+	if err := json.Unmarshal(data, &loaded); err != nil || loaded.Version != StateVersion {
+		return NewState()
+	}
+	s := NewState()
+	if loaded.Entries != nil {
+		// Copy, so that a caller holding the decoded struct cannot share the map.
+		s.Entries = loaded.Entries
+	}
+	return s
+}
+
+// Save writes the state to path atomically (a temporary file in the same
+// directory, then a rename) with mode 0600, making the directory if needed.
+// The caller's State is not modified beyond a version fixup.
+func (s *State) Save(path string) error {
+	if s == nil {
+		return errors.New("backup: save: nil state")
+	}
+	if path == "" {
+		return errors.New("backup: save: empty state path")
+	}
+	s.Version = StateVersion
+	if s.Entries == nil {
+		s.Entries = map[string]Entry{}
+	}
+	data, err := json.MarshalIndent(s, "", "  ")
+	if err != nil {
+		return err
+	}
+	data = append(data, '\n')
+
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(dir, ".backup-state-*.tmp")
+	if err != nil {
+		return err
+	}
+	tmpName := tmp.Name()
+	// Remove the temporary file on every path that did not rename it into
+	// place; after a successful rename this removes nothing.
+	defer os.Remove(tmpName)
+
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err := tmp.Chmod(0o600); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err := tmp.Sync(); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+	return os.Rename(tmpName, path)
+}
