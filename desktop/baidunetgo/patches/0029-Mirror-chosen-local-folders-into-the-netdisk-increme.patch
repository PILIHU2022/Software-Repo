+// TestStateRoundTrip checks the state file: where it goes, its mode, and what
+// loading it back gives, including the files it tolerates being wrong.
+func TestStateRoundTrip(t *testing.T) {
+	dir := t.TempDir()
+	when := time.Now().Round(0)
+
+	st := NewState()
+	if st.Version != StateVersion || st.Entries == nil {
+		t.Fatalf("new state = %+v", st)
+	}
+	p := filepath.Join(dir, "profile", "backup-state.json") // the directory is made
+	st.Entries["/home/me/照片/a.jpg"] = Entry{Size: 42, ModNano: 1234, Remote: "/备份/照片/a.jpg", At: when}
+	if err := st.Save(p); err != nil {
+		t.Fatalf("Save: %v", err)
+	}
+	info, err := os.Stat(p)
+	if err != nil {
+		t.Fatalf("Stat: %v", err)
+	}
+	if perm := info.Mode().Perm(); perm != 0o600 {
+		t.Errorf("mode = %o, want 600", perm)
+	}
+	loaded := LoadState(p)
+	if loaded.Version != StateVersion || len(loaded.Entries) != 1 {
+		t.Fatalf("loaded = %+v", loaded)
+	}
+	got, ok := loaded.Entries["/home/me/照片/a.jpg"]
+	if !ok || got.Size != 42 || got.ModNano != 1234 || got.Remote != "/备份/照片/a.jpg" || !got.At.Equal(when) {
+		t.Errorf("entry = %+v, %v", got, ok)
+	}
+
+	// Saving again replaces the file, keeping one entry.
+	st.Entries["/home/me/照片/b.jpg"] = Entry{Size: 1}
+	if err := st.Save(p); err != nil {
+		t.Fatalf("second Save: %v", err)
+	}
+	if got := len(LoadState(p).Entries); got != 2 {
+		t.Errorf("%d entries after the second save, want 2", got)
+	}
+	if leftovers, _ := filepath.Glob(filepath.Join(filepath.Dir(p), ".backup-state-*")); len(leftovers) != 0 {
+		t.Errorf("temporary state files were left behind: %v", leftovers)
+	}
+
+	if got := LoadState(filepath.Join(dir, "nothing-here.json")); got.Version != StateVersion || len(got.Entries) != 0 {
+		t.Errorf("missing file loaded as %+v, want an empty state", got)
+	}
+	corrupt := filepath.Join(dir, "corrupt.json")
+	if err := os.WriteFile(corrupt, []byte("{not json"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if got := LoadState(corrupt); got.Version != StateVersion || len(got.Entries) != 0 {
+		t.Errorf("corrupt file loaded as %+v, want an empty state", got)
+	}
+	old := filepath.Join(dir, "old.json")
+	if err := os.WriteFile(old, []byte(`{"version":0,"entries":{"/a":{"size":1}}}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if got := LoadState(old); len(got.Entries) != 0 {
+		t.Errorf("state of another version loaded as %+v, want an empty state", got)
+	}
+
+	var nilState *State
+	if err := nilState.Save(filepath.Join(dir, "x.json")); err == nil {
+		t.Error("saving a nil state succeeded, want an error")
+	}
+	if err := st.Save(""); err == nil {
+		t.Error("saving to an empty path succeeded, want an error")
+	}
+}
