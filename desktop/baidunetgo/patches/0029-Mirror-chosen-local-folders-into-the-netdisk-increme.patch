@@ -0,0 +1,706 @@
+// Package backup mirrors local folders into a netdisk destination. It uploads
+// only what changed since the last run, optionally encrypting every file on the
+// way, creates the netdisk folders as they are needed, uploads several files at
+// once, reports progress as it goes, and stops when its context is canceled.
+// It never deletes anything, locally or on the netdisk.
+package backup
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Defaults of a run.
+const (
+	// DefaultParallel is how many uploads run at once when Config.Parallel is
+	// zero or negative.
+	DefaultParallel = 2
+	// MaxParallel caps Config.Parallel.
+	MaxParallel = 4
+	// TempPrefix starts the name of the temporary files encrypted uploads are
+	// staged in, under os.TempDir(). Each one also has a random suffix, so two
+	// files in flight never share a name.
+	TempPrefix = "baidunetgo-backup-"
+)
+
+// defaultExcludes are names never backed up, at any depth: version control and
+// package data, caches, trash, and the lock and temporary files office
+// programs leave beside a document. A name matching one of these is skipped
+// even when Config.Exclude is set (which adds to them).
+var defaultExcludes = []string{
+	".git",
+	"node_modules",
+	".cache",
+	".Trash",
+	".DS_Store",
+	"Thumbs.db",
+}
+
+// DefaultExcludes returns the names skipped at any depth even when
+// Config.Exclude is empty, so that a settings page can show them.
+func DefaultExcludes() []string {
+	return append([]string(nil), defaultExcludes...)
+}
+
+// RemoteFile is a file or directory of the netdisk, as the engine sees it.
+type RemoteFile struct {
+	Name  string
+	Size  int64
+	IsDir bool
+}
+
+// Client is the netdisk side the engine needs. The app adapts *baidu.Client to
+// it (see the package's documentation).
+type Client interface {
+	// List returns the entries of the netdisk directory dir, a path like
+	// "/备份". It may be called for a directory that does not exist yet, to
+	// find out whether it does; an error then may be returned or an empty
+	// listing.
+	List(ctx context.Context, dir string) ([]RemoteFile, error)
+	// Mkdir creates the one directory dir, whose parent exists.
+	Mkdir(ctx context.Context, dir string) error
+	// Upload sends the local file local to the full netdisk path remote,
+	// overwriting what is there, and reports progress in bytes.
+	Upload(ctx context.Context, local, remote string, progress func(done, total int64)) error
+}
+
+// Folder is one local directory to back up.
+type Folder struct {
+	Local  string `json:"local"`            // absolute local directory
+	Remote string `json:"remote,omitempty"` // netdisk subfolder under Dest; empty = base name of Local
+}
+
+// Config is what a run backs up and how.
+type Config struct {
+	Dest    string   `json:"dest"`    // netdisk destination, e.g. "/备份"
+	Folders []Folder `json:"folders"` // the local folders to mirror
+	// Encrypt makes every file be encrypted before it is uploaded; the
+	// netdisk name then ends with ".gpg".
+	Encrypt bool `json:"encrypt"`
+	// Exclude adds names skipped anywhere, on top of the default ones (see
+	// defaultExcludes).
+	Exclude []string `json:"exclude,omitempty"`
+	// Parallel is how many uploads run at once: 0 means DefaultParallel, and
+	// values are clamped to 1..MaxParallel.
+	Parallel int `json:"parallel,omitempty"`
+	// EncryptStream streams the symmetric encryption of src into dst; nil
+	// means the internal/pgp package's Encrypt is used when it is wired in
+	// (see the pgp bridge file in this package), else the run fails with a
+	// clear error when Encrypt is set.
+	EncryptStream func(dst io.Writer, src io.Reader, passphrase string) error `json:"-"`
+}
+
+// FileError is one file or folder the run could not back up. Err is never nil.
+// A failed file is not added to the state, so the next run tries it again.
+type FileError struct {
+	Local  string `json:"local"`
+	Remote string `json:"remote,omitempty"`
+	Err    error  `json:"-"`
+}
+
+// Error says what failed where.
+func (e FileError) Error() string {
+	if e.Remote != "" {
+		return fmt.Sprintf("backup %s -> %s: %v", e.Local, e.Remote, e.Err)
+	}
+	return fmt.Sprintf("backup %s: %v", e.Local, e.Err)
+}
+
+// Unwrap is the error it wraps.
+func (e FileError) Unwrap() error { return e.Err }
+
+// Progress is one report of a run. It is called from worker goroutines as
+// well as from the walk, so the app must make it safe for concurrent use (a
+// mutex or a channel, and throttle it if it repaints).
+type Progress struct {
+	Folder string // absolute local root of the folder being backed up
+	File   string // the file's path relative to Folder, "/"-separated
+	Remote string // the file's full netdisk path
+	// Done and Total are the bytes of the current file: Total is its size, and
+	// Done the bytes of it the client has sent. Encrypted files are sent as
+	// their (slightly larger) encrypted copy, so their Done grows to the
+	// temporary file's size. A file's start is reported with Done 0, then its
+	// bytes as the client sends them, and its end with Done equal to Total.
+	Done  int64
+	Total int64
+	// Files is how many files the walk has found so far in the whole run;
+	// Uploaded, Skipped and Failed count the files finished so far.
+	Files     int
+	Uploaded  int
+	Skipped   int
+	Failed    int
+	Encrypted bool
+}
+
+// Result says what a run did.
+type Result struct {
+	Folders  int         // folders processed (configured entries reached)
+	Uploaded int         // files sent
+	Skipped  int         // files already backed up unchanged
+	Failed   int         // files that could not be backed up
+	Bytes    int64       // bytes of the uploaded files, as they are locally
+	Errors   []FileError // what failed, in the order it failed
+}
+
+// encryptFn is the signature of Config.EncryptStream.
+type encryptFn func(dst io.Writer, src io.Reader, passphrase string) error
+
+// pgpEncrypt is the internal/pgp fallback for a nil Config.EncryptStream. The
+// pgp bridge file of this package sets it; it stays nil when internal/pgp is
+// not part of the build.
+var pgpEncrypt encryptFn
+
+// Run mirrors cfg's folders into cfg.Dest, sending only the files that changed
+// since the last run recorded in st, which is updated as uploads succeed. When
+// Encrypt is set, each file is encrypted into a temporary file under
+// os.TempDir() and uploaded with a ".gpg" suffix, and the temporary file is
+// removed whether the upload worked or not.
+//
+// A failure of one file does not abort the run: it is collected in Result and
+// left out of the state, so the next run retries it. Cancellation by ctx stops
+// promptly, keeps what was done, and returns ctx.Err() (context.Canceled), with
+// the partial result.
+//
+// st is written from worker goroutines while Run is in flight: the caller must
+// not touch it until Run returns, then save it (State.Save).
+func Run(ctx context.Context, cl Client, cfg Config, st *State, passphrase string, report func(Progress)) (Result, error) {
+	if cl == nil {
+		return Result{}, errors.New("backup: no client")
+	}
+	dest, err := cleanDest(cfg.Dest)
+	if err != nil {
+		return Result{}, err
+	}
+	if st == nil {
+		st = NewState()
+	}
+	if st.Entries == nil {
+		st.Entries = map[string]Entry{}
+	}
+	enc := cfg.EncryptStream
+	if cfg.Encrypt && enc == nil {
+		enc = pgpEncrypt
+	}
+	if cfg.Encrypt && enc == nil {
+		return Result{}, errors.New("backup: encryption requested but no EncryptStream and internal/pgp is not wired in")
+	}
+	if cfg.Encrypt && passphrase == "" {
+		return Result{}, errors.New("backup: encryption needs a passphrase")
+	}
+	parallel := cfg.Parallel
+	if parallel <= 0 {
+		parallel = DefaultParallel
+	}
+	if parallel > MaxParallel {
+		parallel = MaxParallel
+	}
+
+	r := &runner{
+		cl:       cl,
+		cfg:      cfg,
+		dest:     dest,
+		st:       st,
+		pass:     passphrase,
+		enc:      enc,
+		report:   report,
+		parallel: parallel,
+		excludes: excludeSet(cfg.Exclude),
+		listings: map[string]map[string]bool{},
+		made:     map[string]bool{},
+		dirErr:   map[string]error{},
+	}
+	return r.run(ctx)
+}
+
+// cleanDest normalizes the netdisk destination: an absolute path with no
+// trailing slash.
+func cleanDest(dest string) (string, error) {
+	dest = strings.TrimSpace(dest)
+	if dest == "" {
+		return "", errors.New("backup: no destination")
+	}
+	if !strings.HasPrefix(dest, "/") {
+		dest = "/" + dest
+	}
+	dest = path.Clean(dest)
+	if dest == "/" {
+		return "/", nil
+	}
+	return strings.TrimSuffix(dest, "/"), nil
+}
+
+// excludeSet is the names skipped at any depth: the default ones plus extra.
+func excludeSet(extra []string) map[string]bool {
+	set := make(map[string]bool, len(defaultExcludes)+len(extra))
+	for _, name := range defaultExcludes {
+		set[name] = true
+	}
+	for _, name := range extra {
+		if name = strings.TrimSpace(name); name != "" {
+			set[name] = true
+		}
+	}
+	return set
+}
+
+// excluded says whether a name is skipped: one of the excludes, or a "~$"
+// temporary file of an office program.
+func (r *runner) excluded(name string) bool {
+	return r.excludes[name] || strings.HasPrefix(name, "~$")
+}
+
+// pending is one file to upload.
+type pending struct {
+	folder  string // absolute local root
+	local   string // absolute local path
+	rel     string // path relative to folder, "/"-separated
+	remote  string // full netdisk path, ".gpg" suffix included when encrypting
+	size    int64
+	modNano int64
+}
+
+// runner is one run's state.
+type runner struct {
+	cl       Client
+	cfg      Config
+	dest     string
+	st       *State
+	pass     string
+	enc      encryptFn
+	report   func(Progress)
+	parallel int
+	excludes map[string]bool
+
+	mu    sync.Mutex // guards st, res and the counters below
+	res   Result
+	files int // files the walk found so far, for Progress.Files
+
+	// The walk and the directory creation run in one goroutine.
+	listings map[string]map[string]bool // known entries of a listed parent
+	made     map[string]bool            // netdisk directories the run knows exist
+	dirErr   map[string]error           // directories whose creation failed
+}
+
+// run walks and uploads every configured folder.
+func (r *runner) run(ctx context.Context) (Result, error) {
+	for _, f := range r.cfg.Folders {
+		if ctx.Err() != nil {
+			break
+		}
+		local := strings.TrimSpace(f.Local)
+		if local == "" {
+			r.addError(FileError{Err: errors.New("backup: folder has no local path")})
+			continue
+		}
+		abs, err := filepath.Abs(local)
+		if err != nil {
+			r.addError(FileError{Local: local, Err: err})
+			continue
+		}
+		remote := strings.Trim(strings.TrimSpace(f.Remote), "/")
+		if remote == "" {
+			remote = filepath.Base(abs)
+		}
+		base := path.Join(r.dest, filepath.ToSlash(remote))
+		if remote == "" || base == r.dest {
+			r.addError(FileError{Local: abs, Err: errors.New("backup: folder has no remote name")})
+			continue
+		}
+		r.mu.Lock()
+		r.res.Folders++
+		r.mu.Unlock()
+		if err := r.folder(ctx, abs, base); err != nil {
+			// Only cancellation stops the run; file and folder failures were
+			// collected as they happened.
+			break
+		}
+	}
+	r.mu.Lock()
+	res := r.res
+	r.mu.Unlock()
+	if err := ctx.Err(); err != nil {
+		return res, err
+	}
+	return res, nil
+}
+
+// folder backs up one local directory into the netdisk directory base.
+func (r *runner) folder(ctx context.Context, local, base string) error {
+	files, err := r.walk(ctx, local, base)
+	if err != nil {
+		return err
+	}
+	if len(files) == 0 {
+		return nil
+	}
+	// Make the remote folders first, in a fixed order, and only for the
+	// directories that hold something to upload.
+	var todo []pending
+	for _, p := range files {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		dir := path.Dir(p.remote)
+		if err := r.ensureDir(ctx, dir); err != nil {
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			// One error for the directory; the files in it count as failed
+			// and are left out of the state, so the next run retries them.
+			if _, seen := r.dirErr[dir]; !seen {
+				r.dirErr[dir] = err
+				r.addError(FileError{Local: p.local, Remote: dir, Err: err})
+			}
+			r.failedFile(p)
+			continue
+		}
+		todo = append(todo, p)
+	}
+	if len(todo) == 0 {
+		return nil
+	}
+	return r.uploadAll(ctx, todo)
+}
+
+// walk collects the files under local, in sorted order, reporting the ones
+// already backed up unchanged and leaving those out.
+func (r *runner) walk(ctx context.Context, local, base string) ([]pending, error) {
+	var out []pending
+	err := filepath.WalkDir(local, func(p string, d fs.DirEntry, err error) error {
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			return ctxErr
+		}
+		if err != nil {
+			// An unreadable directory or file: collect it and go on with the
+			// rest. The remote path is unknown here, so only the local one is
+			// reported.
+			r.addError(FileError{Local: p, Err: err})
+			return nil
+		}
+		if p == local {
+			return nil
+		}
+		if r.excluded(d.Name()) {
+			if d.IsDir() {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if d.IsDir() {
+			return nil
+		}
+		rel, err := filepath.Rel(local, p)
+		if err != nil {
+			r.addError(FileError{Local: p, Err: err})
+			return nil
+		}
+		rel = filepath.ToSlash(rel)
+		remote := path.Join(base, rel)
+		if r.cfg.Encrypt {
+			remote += ".gpg"
+		}
+		if d.Type()&fs.ModeSymlink != 0 {
+			// Symbolic links are not followed: what they point at is not part
+			// of this tree, and their own size would never match the upload.
+			r.mu.Lock()
+			r.files++
+			r.res.Skipped++
+			r.mu.Unlock()
+			r.emit(Progress{Folder: local, File: rel, Remote: remote, Encrypted: r.cfg.Encrypt})
+			return nil
+		}
+		info, err := d.Info()
+		if err != nil {
+			r.addError(FileError{Local: p, Remote: remote, Err: err})
+			return nil
+		}
+		pd := pending{
+			folder:  local,
+			local:   p,
+			rel:     rel,
+			remote:  remote,
+			size:    info.Size(),
+			modNano: info.ModTime().UnixNano(),
+		}
+		r.mu.Lock()
+		r.files++
+		r.mu.Unlock()
+		if r.unchanged(pd) {
+			r.mu.Lock()
+			r.res.Skipped++
+			r.mu.Unlock()
+			r.emit(Progress{Folder: local, File: rel, Remote: remote, Done: pd.size, Total: pd.size, Encrypted: r.cfg.Encrypt})
+			return nil
+		}
+		out = append(out, pd)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	sort.SliceStable(out, func(i, j int) bool { return out[i].rel < out[j].rel })
+	return out, nil
+}
+
+// unchanged says whether the state has this file backed up as it is now. A file
+// counts as unchanged when its size and modification time match the entry; an
+// entry without a remote path (one made by hand) still matches, but a remote
+// path that differs, as when encryption was turned on or off, does not: that
+// file goes to another netdisk name and is uploaded again.
+func (r *runner) unchanged(p pending) bool {
+	r.mu.Lock()
+	e, ok := r.st.Entries[p.local]
+	r.mu.Unlock()
+	if !ok || e.Size != p.size || e.ModNano != p.modNano {
+		return false
+	}
+	return e.Remote == "" || e.Remote == p.remote
+}
+
+// ensureDir makes the netdisk directory dir exist, creating each missing level
+// once. The result is cached for the run, failures included.
+func (r *runner) ensureDir(ctx context.Context, dir string) error {
+	if dir == "" || dir == "/" {
+		return nil
+	}
+	if err, ok := r.dirErr[dir]; ok {
+		return err
+	}
+	if r.made[dir] {
+		return nil
+	}
+	for _, level := range levels(r.dest, dir) {
+		parent, name := path.Dir(level), path.Base(level)
+		exists, err := r.has(ctx, parent, name)
+		if err != nil {
+			return err
+		}
+		if exists {
+			continue
+		}
+		if err := r.cl.Mkdir(ctx, level); err != nil {
+			return err
+		}
+		r.mark(parent, name)
+	}
+	r.made[dir] = true
+	return nil
+}
+
+// levels lists the netdisk directories from dest down to dir, in order, dest
+// included: what ensureDir walks.
+func levels(dest, dir string) []string {
+	if dir == "/" {
+		return nil
+	}
+	root := dest
+	if root == "/" {
+		root = ""
+	}
+	var out []string
+	cur := root
+	if root != "" {
+		out = append(out, root)
+	} else {
+		cur = "/"
+	}
+	rest := strings.TrimPrefix(dir, root)
+	rest = strings.TrimPrefix(rest, "/")
+	for _, part := range strings.Split(rest, "/") {
+		if part == "" {
+			continue
+		}
+		cur = path.Join(cur, part)
+		out = append(out, cur)
+	}
+	return out
+}
+
+// has says whether the netdisk directory parent has a child called name,
+// listing parent once per run.
+func (r *runner) has(ctx context.Context, parent, name string) (bool, error) {
+	names, ok := r.listings[parent]
+	if !ok {
+		files, err := r.cl.List(ctx, parent)
+		if err != nil {
+			return false, err
+		}
+		names = make(map[string]bool, len(files))
+		for _, f := range files {
+			names[f.Name] = true
+		}
+		r.listings[parent] = names
+	}
+	return names[name], nil
+}
+
+// mark records that the netdisk directory parent now has the child name.
+func (r *runner) mark(parent, name string) {
+	names, ok := r.listings[parent]
+	if !ok {
+		names = map[string]bool{}
+		r.listings[parent] = names
+	}
+	if name != "" {
+		names[name] = true
+	}
+}
+
+// uploadAll runs the uploads, up to parallel at once, feeding them in the order
+// of jobs so that the netdisk sees a deterministic order of file starts.
+func (r *runner) uploadAll(ctx context.Context, jobs []pending) error {
+	ch := make(chan pending)
+	var wg sync.WaitGroup
+	for i := 0; i < r.parallel; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for p := range ch {
+				if ctx.Err() != nil {
+					return
+				}
+				r.upload(ctx, p)
+			}
+		}()
+	}
+feed:
+	for _, p := range jobs {
+		// The start of a file is reported here, by the one goroutine that
+		// hands the files out, so that the reports come in sorted order
+		// however the workers happen to be scheduled.
+		r.emit(Progress{Folder: p.folder, File: p.rel, Remote: p.remote, Total: p.size, Encrypted: r.cfg.Encrypt})
+		select {
+		case <-ctx.Done():
+			break feed
+		case ch <- p:
+		}
+	}
+	close(ch)
+	wg.Wait()
+	return ctx.Err()
+}
+
+// upload sends one file, encrypting it first when the run encrypts.
+func (r *runner) upload(ctx context.Context, p pending) {
+	if ctx.Err() != nil {
+		return
+	}
+	local := p.local
+	var temp string
+	if r.cfg.Encrypt {
+		var err error
+		temp, err = r.encrypted(ctx, p)
+		if err != nil {
+			if ctx.Err() == nil {
+				r.fail(p, err)
+			}
+			return
+		}
+		defer os.Remove(temp) // whether the upload works or not
+		local = temp
+	}
+	err := r.cl.Upload(ctx, local, p.remote, func(done, total int64) {
+		r.emit(Progress{Folder: p.folder, File: p.rel, Remote: p.remote, Done: done, Total: total, Encrypted: r.cfg.Encrypt})
+	})
+	if err != nil {
+		if ctx.Err() != nil {
+			// Canceled: not a failure of this file.
+			return
+		}
+		r.fail(p, err)
+		return
+	}
+	r.mu.Lock()
+	r.st.Entries[p.local] = Entry{Size: p.size, ModNano: p.modNano, Remote: p.remote, At: time.Now()}
+	r.res.Uploaded++
+	r.res.Bytes += p.size
+	r.mu.Unlock()
+	r.emit(Progress{Folder: p.folder, File: p.rel, Remote: p.remote, Done: p.size, Total: p.size, Encrypted: r.cfg.Encrypt})
+}
+
+// encrypted writes p's file encrypted into a new temporary file in os.TempDir
+// and returns its path. The file is unique to this upload and 0600.
+func (r *runner) encrypted(ctx context.Context, p pending) (string, error) {
+	tmp, err := os.CreateTemp("", TempPrefix+"*.gpg")
+	if err != nil {
+		return "", err
+	}
+	name := tmp.Name()
+	src, err := os.Open(p.local)
+	if err != nil {
+		tmp.Close()
+		os.Remove(name)
+		return "", err
+	}
+	defer src.Close()
+	err = r.enc(tmp, checkedReader{ctx: ctx, r: src}, r.pass)
+	if cerr := tmp.Close(); err == nil {
+		err = cerr
+	}
+	if err != nil {
+		os.Remove(name)
+		return "", err
+	}
+	return name, nil
+}
+
+// checkedReader stops reading when the context is canceled, so that encrypting
+// a large file gives up promptly.
+type checkedReader struct {
+	ctx context.Context
+	r   io.Reader
+}
+
+func (c checkedReader) Read(p []byte) (int, error) {
+	if err := c.ctx.Err(); err != nil {
+		return 0, err
+	}
+	return c.r.Read(p)
+}
+
+// fail records a file that could not be uploaded.
+func (r *runner) fail(p pending, err error) {
+	r.addError(FileError{Local: p.local, Remote: p.remote, Err: err})
+	r.failedFile(p)
+}
+
+// failedFile counts a file as failed and reports the end of it, without
+// recording another error (for the files under a failed directory).
+func (r *runner) failedFile(p pending) {
+	r.mu.Lock()
+	r.res.Failed++
+	r.mu.Unlock()
+	r.emit(Progress{Folder: p.folder, File: p.rel, Remote: p.remote, Total: p.size, Encrypted: r.cfg.Encrypt})
+}
+
+// addError collects an error of the run.
+func (r *runner) addError(e FileError) {
+	if e.Err == nil {
+		e.Err = errors.New("backup: unknown error")
+	}
+	r.mu.Lock()
+	r.res.Errors = append(r.res.Errors, e)
+	r.mu.Unlock()
+}
+
+// emit reports a progress event with the counters as they are now. It is
+// called from worker goroutines; report must be safe for concurrent use.
+func (r *runner) emit(p Progress) {
+	if r.report == nil {
+		return
+	}
+	r.mu.Lock()
+	p.Files, p.Uploaded, p.Skipped, p.Failed = r.files, r.res.Uploaded, r.res.Skipped, r.res.Failed
+	r.mu.Unlock()
+	r.report(p)
+}
diff --git a/internal/backup/backup_test.go b/internal/backup/backup_test.go
new file mode 100644
index 0000000..100bc0c
--- /dev/null
+++ b/internal/backup/backup_test.go
@@ -0,0 +1,1182 @@
+package backup
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// fakeClient is an in-memory netdisk that records what the engine does.
+type fakeClient struct {
+	mu sync.Mutex
+	// tree holds every directory and file of the fake netdisk by full path;
+	// "/" is always a directory.
+	tree map[string]remoteNode
+
+	lists   []string
+	mkdirs  []string
+	uploads []uploadCall
+
+	failList   map[string]error
+	failMkdir  map[string]error
+	failUpload map[string]error
+
+	// onStart, when set, runs as each upload starts, with the context the
+	// engine passed.
+	onStart func(ctx context.Context, remote string)
+	// hold, when set, makes uploads wait for it to be closed (or the context
+	// to be canceled), so a test can let several run at once.
+	hold chan struct{}
+
+	inFlight    int
+	maxInFlight int
+}
+
+type remoteNode struct {
+	isDir bool
+	data  []byte
+}
+
+type uploadCall struct {
+	local  string
+	remote string
+	size   int64 // of the data uploaded, set once read
+	failed bool
+}
+
+func newFake() *fakeClient {
+	return &fakeClient{
+		tree:       map[string]remoteNode{"/": {isDir: true}},
+		failList:   map[string]error{},
+		failMkdir:  map[string]error{},
+		failUpload: map[string]error{},
+	}
+}
+
+// putDir makes the netdisk directory p (and its parents).
+func (f *fakeClient) putDir(p string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.putDirLocked(p)
+}
+
+func (f *fakeClient) putDirLocked(p string) {
+	if p == "" || p == "/" {
+		return
+	}
+	parent := path.Dir(p)
+	if parent != "/" {
+		f.putDirLocked(parent)
+	}
+	if n, ok := f.tree[p]; ok && !n.isDir {
+		panic("fakeClient: " + p + " is a file")
+	}
+	f.tree[p] = remoteNode{isDir: true}
+}
+
+// putFile makes a netdisk file, for a destination that exists already.
+func (f *fakeClient) putFile(p, content string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.putDirLocked(path.Dir(p))
+	f.tree[p] = remoteNode{data: []byte(content)}
+}
+
+// file returns the content of a netdisk file.
+func (f *fakeClient) file(p string) (string, bool) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	n, ok := f.tree[p]
+	return string(n.data), ok && !n.isDir
+}
+
+// isDir says whether a netdisk path is a directory.
+func (f *fakeClient) isDir(p string) bool {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	n, ok := f.tree[p]
+	return ok && n.isDir
+}
+
+// reset forgets the calls of earlier runs but keeps the tree.
+func (f *fakeClient) reset() {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.lists = nil
+	f.mkdirs = nil
+	f.uploads = nil
+	f.inFlight = 0
+	f.maxInFlight = 0
+}
+
+// calls returns copies of what the engine did so far.
+func (f *fakeClient) calls() (lists, mkdirs []string, uploads []uploadCall) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]string(nil), f.lists...), append([]string(nil), f.mkdirs...), append([]uploadCall(nil), f.uploads...)
+}
+
+// concurrency returns the uploads in flight and the most that ever were.
+func (f *fakeClient) concurrency() (inFlight, maxInFlight int) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.inFlight, f.maxInFlight
+}
+
+// uploadedRemotes returns the netdisk paths the engine uploaded to, in the
+// order the uploads started.
+func (f *fakeClient) uploadedRemotes() []string {
+	_, _, uploads := f.calls()
+	out := make([]string, len(uploads))
+	for i, u := range uploads {
+		out[i] = u.remote
+	}
+	return out
+}
+
+func (f *fakeClient) List(ctx context.Context, dir string) ([]RemoteFile, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.lists = append(f.lists, dir)
+	if err := f.failList[dir]; err != nil {
+		return nil, err
+	}
+	n, ok := f.tree[dir]
+	if !ok || !n.isDir {
+		return nil, fmt.Errorf("fake netdisk: %q is not a directory", dir)
+	}
+	var out []RemoteFile
+	for p, node := range f.tree {
+		if p != "/" && path.Dir(p) == dir {
+			out = append(out, RemoteFile{Name: path.Base(p), Size: int64(len(node.data)), IsDir: node.isDir})
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Name < out[j].Name })
+	return out, nil
+}
+
+func (f *fakeClient) Mkdir(ctx context.Context, dir string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if err := f.failMkdir[dir]; err != nil {
+		return err
+	}
+	if dir == "" || dir == "/" {
+		return fmt.Errorf("fake netdisk: cannot mkdir %q", dir)
+	}
+	if n, ok := f.tree[dir]; ok {
+		if n.isDir {
+			return fmt.Errorf("fake netdisk: %q is there already", dir)
+		}
+		return fmt.Errorf("fake netdisk: %q is a file", dir)
+	}
+	parent := path.Dir(dir)
+	if n, ok := f.tree[parent]; !ok || !n.isDir {
+		return fmt.Errorf("fake netdisk: parent of %q is missing", dir)
+	}
+	f.tree[dir] = remoteNode{isDir: true}
+	f.mkdirs = append(f.mkdirs, dir)
+	return nil
+}
+
+func (f *fakeClient) Upload(ctx context.Context, local, remote string, progress func(done, total int64)) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	f.mu.Lock()
+	idx := len(f.uploads)
+	f.uploads = append(f.uploads, uploadCall{local: local, remote: remote})
+	f.inFlight++
+	if f.inFlight > f.maxInFlight {
+		f.maxInFlight = f.inFlight
+	}
+	hold, hook, fail := f.hold, f.onStart, f.failUpload[remote]
+	parentOK := f.tree[path.Dir(remote)].isDir
+	f.mu.Unlock()
+	defer func() {
+		f.mu.Lock()
+		f.inFlight--
+		f.mu.Unlock()
+	}()
+
+	if hook != nil {
+		hook(ctx, remote)
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !parentOK {
+		return fmt.Errorf("fake netdisk: parent of %q is missing", remote)
+	}
+	if hold != nil {
+		select {
+		case <-hold:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	data, err := os.ReadFile(local)
+	if err != nil {
+		return err
+	}
+	if progress != nil {
+		progress(int64(len(data)), int64(len(data)))
+	}
+	f.mu.Lock()
+	f.uploads[idx].size = int64(len(data))
+	if fail != nil {
+		f.uploads[idx].failed = true
+	}
+	f.mu.Unlock()
+	if fail != nil {
+		return fail
+	}
+	f.mu.Lock()
+	f.tree[remote] = remoteNode{data: data}
+	f.mu.Unlock()
+	return nil
+}
+
+// reportLog collects the progress reports of a run.
+type reportLog struct {
+	mu     sync.Mutex
+	events []Progress
+}
+
+func (l *reportLog) add(p Progress) {
+	l.mu.Lock()
+	l.events = append(l.events, p)
+	l.mu.Unlock()
+}
+
+func (l *reportLog) all() []Progress {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return append([]Progress(nil), l.events...)
+}
+
+// files returns the events of one file, in order.
+func (l *reportLog) files(file string) []Progress {
+	var out []Progress
+	for _, e := range l.all() {
+		if e.File == file {
+			out = append(out, e)
+		}
+	}
+	return out
+}
+
+// starts returns the events that start a file: Done 0 with a positive total.
+func (l *reportLog) starts() []Progress {
+	var out []Progress
+	for _, e := range l.all() {
+		if e.Done == 0 && e.Total > 0 {
+			out = append(out, e)
+		}
+	}
+	return out
+}
+
+// write makes a local file, and the directories above it.
+func write(t *testing.T, dir, name, content string) string {
+	t.Helper()
+	p := filepath.Join(dir, filepath.FromSlash(name))
+	if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// rewrite changes a local file's content and sets its modification time
+// explicitly, so that a test knows whether it changed.
+func rewrite(t *testing.T, p, content string, mtime time.Time) {
+	t.Helper()
+	if err := os.WriteFile(p, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chtimes(p, mtime, mtime); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// waitFor waits for a condition, failing the test if it takes too long.
+func waitFor(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		if cond() {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatalf("timed out waiting for %s", what)
+}
+
+// tempLeftovers lists the engine's staging files left in os.TempDir().
+func tempLeftovers(t *testing.T) []string {
+	t.Helper()
+	entries, err := os.ReadDir(os.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out []string
+	for _, e := range entries {
+		if strings.HasPrefix(e.Name(), TempPrefix) {
+			out = append(out, filepath.Join(os.TempDir(), e.Name()))
+		}
+	}
+	return out
+}
+
+// TestFirstRun checks that a first run uploads the whole tree, makes the
+// netdisk folders, and reports progress for every file.
+func TestFirstRun(t *testing.T) {
+	dir := t.TempDir()
+	write(t, dir, "a.txt", "hello")
+	write(t, dir, "sub/b.txt", "world!")
+
+	cl := newFake()
+	log := &reportLog{}
+	cfg := Config{Dest: "/备份", Folders: []Folder{{Local: dir}}}
+	res, err := Run(context.Background(), cl, cfg, NewState(), "", log.add)
+	if err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if res.Folders != 1 || res.Uploaded != 2 || res.Skipped != 0 || res.Failed != 0 {
+		t.Fatalf("result = %+v, want 1 folder, 2 uploaded", res)
+	}
+	if res.Bytes != int64(len("hello")+len("world!")) {
+		t.Errorf("Bytes = %d, want %d", res.Bytes, len("hello")+len("world!"))
+	}
+	if len(res.Errors) != 0 {
+		t.Errorf("errors = %v, want none", res.Errors)
+	}
+	folder := filepath.Base(dir) // the default remote name
+	for name, want := range map[string]string{
+		"a.txt":     "hello",
+		"sub/b.txt": "world!",
+	} {
+		remote := path.Join("/备份", folder, name)
+		if got, ok := cl.file(remote); !ok || got != want {
+			t.Errorf("%s = %q, %v; want %q", remote, got, ok, want)
+		}
+	}
+	_, mkdirs, _ := cl.calls()
+	want := []string{"/备份", path.Join("/备份", folder), path.Join("/备份", folder, "sub")}
+	if strings.Join(mkdirs, ",") != strings.Join(want, ",") {
+		t.Errorf("mkdirs = %v, want %v", mkdirs, want)
+	}
+
+	for _, name := range []string{"a.txt", "sub/b.txt"} {
+		events := log.files(name)
+		if len(events) < 2 {
+			t.Errorf("%s: %d progress events, want a start and an end", name, len(events))
+			continue
+		}
+		if events[0].Done != 0 || events[0].Total == 0 {
+			t.Errorf("%s: first event = %+v, want the start", name, events[0])
+		}
+		last := events[len(events)-1]
+		if last.Done != last.Total || last.Done == 0 {
+			t.Errorf("%s: last event = %+v, want the end", name, last)
+		}
+		if last.Folder != dir || last.Remote != path.Join("/备份", folder, name) {
+			t.Errorf("%s: event = %+v, want folder %q", name, last, dir)
+		}
+		if last.Encrypted {
+			t.Errorf("%s: event says encrypted, but the run does not encrypt", name)
+		}
+	}
+}
+
+// TestSecondRunSkips checks that an unchanged second run skips everything and
+// touches the netdisk not at all, with the state read back from its file.
+func TestSecondRunSkips(t *testing.T) {
+	dir := t.TempDir()
+	write(t, dir, "a.txt", "hello")
+	write(t, dir, "sub/b.txt", "world!")
+
+	cl := newFake()
+	cfg := Config{Dest: "/备份", Folders: []Folder{{Local: dir, Remote: "照片"}}}
+	ctx := context.Background()
+	st := NewState()
+	if _, err := Run(ctx, cl, cfg, st, "", nil); err != nil {
+		t.Fatalf("first Run: %v", err)
+	}
+	statePath := filepath.Join(t.TempDir(), "state.json")
+	if err := st.Save(statePath); err != nil {
+		t.Fatalf("Save: %v", err)
+	}
+	loaded := LoadState(statePath)
+	if len(loaded.Entries) != 2 {
+		t.Fatalf("state has %d entries, want 2", len(loaded.Entries))
+	}
+
+	cl.reset()
+	res, err := Run(ctx, cl, cfg, loaded, "", nil)
+	if err != nil {
+		t.Fatalf("second Run: %v", err)
+	}
+	if res.Uploaded != 0 || res.Skipped != 2 || res.Failed != 0 || res.Bytes != 0 {
+		t.Errorf("result = %+v, want 2 skipped, nothing else", res)
+	}
+	lists, mkdirs, uploads := cl.calls()
+	if len(lists)+len(mkdirs)+len(uploads) != 0 {
+		t.Errorf("second run touched the netdisk: lists %v, mkdirs %v, uploads %d", lists, mkdirs, len(uploads))
+	}
+	if got, ok := cl.file("/备份/照片/a.txt"); !ok || got != "hello" {
+		t.Errorf("a.txt = %q, %v; the first run's copy should still be there", got, ok)
+	}
+}
+
+// TestChangedFileReuploaded checks that a file changed with its size kept is
+// uploaded again, that a renamed file goes to a new, added remote path, and
+// that nothing old is deleted.
+func TestChangedFileReuploaded(t *testing.T) {
+	dir := t.TempDir()
+	a := write(t, dir, "a.txt", "hello")
+	write(t, dir, "b.txt", "keep me")
+	ctx := context.Background()
+	cfg := Config{Dest: "/备份", Folders: []Folder{{Local: dir, Remote: "照片"}}}
+
+	cl := newFake()
+	st := NewState()
+	if _, err := Run(ctx, cl, cfg, st, "", nil); err != nil {
+		t.Fatalf("first Run: %v", err)
+	}
+
+	rewrite(t, a, "HELLO", time.Now().Add(time.Hour)) // same size, other content
+	cl.reset()
+	res, err := Run(ctx, cl, cfg, st, "", nil)
+	if err != nil {
+		t.Fatalf("second Run: %v", err)
+	}
+	if res.Uploaded != 1 || res.Skipped != 1 {
+		t.Fatalf("result = %+v, want 1 uploaded, 1 skipped", res)
+	}
+	remotes := cl.uploadedRemotes()
+	if len(remotes) != 1 || remotes[0] != "/备份/照片/a.txt" {
+		t.Errorf("uploaded %v, want only a.txt", remotes)
+	}
+	if got, _ := cl.file("/备份/照片/a.txt"); got != "HELLO" {
+		t.Errorf("a.txt = %q, want HELLO", got)
+	}
+	if got, _ := cl.file("/备份/照片/b.txt"); got != "keep me" {
+		t.Errorf("b.txt = %q, want it untouched", got)
+	}
+
+	// A rename is a new local path, so a new remote path: the file is
+	// uploaded again, and the copy under the old name is left alone.
+	renamed := filepath.Join(dir, "renamed.txt")
+	if err := os.Rename(a, renamed); err != nil {
+		t.Fatal(err)
+	}
+	cl.reset()
+	res, err = Run(ctx, cl, cfg, st, "", nil)
+	if err != nil {
+		t.Fatalf("third Run: %v", err)
+	}
+	if res.Uploaded != 1 || res.Skipped != 1 {
+		t.Fatalf("result = %+v, want 1 uploaded, 1 skipped", res)
+	}
+	if remotes := cl.uploadedRemotes(); len(remotes) != 1 || remotes[0] != "/备份/照片/renamed.txt" {
+		t.Errorf("uploaded %v, want renamed.txt", remotes)
+	}
+	if got, ok := cl.file("/备份/照片/a.txt"); !ok || got != "HELLO" {
+		t.Errorf("the old remote file was deleted or changed: %q, %v", got, ok)
+	}
+	if got, _ := cl.file("/备份/照片/renamed.txt"); got != "HELLO" {
+		t.Errorf("renamed.txt = %q, want HELLO", got)
+	}
+}
