+// TestEncryption checks that encrypted uploads carry the encrypted bytes to a
+// ".gpg" name, and that the staging files are unique, in os.TempDir, and
+// removed afterwards.
+func TestEncryption(t *testing.T) {
+	before := tempLeftovers(t)
+	dir := t.TempDir()
+	write(t, dir, "a.txt", "hello")
+	write(t, dir, "b.txt", "world!")
+
+	cl := newFake()
+	maxTemp := 0
+	var tempMu sync.Mutex
+	cl.onStart = func(ctx context.Context, remote string) {
+		leftovers := tempLeftovers(t)
+		tempMu.Lock()
+		if len(leftovers) > maxTemp {
+			maxTemp = len(leftovers)
+		}
+		tempMu.Unlock()
+	}
+	log := &reportLog{}
+	cfg := Config{
+		Dest:          "/备份",
+		Folders:       []Folder{{Local: dir, Remote: "照片"}},
+		Encrypt:       true,
+		EncryptStream: markerEncrypt,
+		Parallel:      2,
+	}
+	st := NewState()
+	res, err := Run(context.Background(), cl, cfg, st, "pw", log.add)
+	if err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if res.Uploaded != 2 || res.Failed != 0 {
+		t.Fatalf("result = %+v, want 2 uploaded", res)
+	}
+
+	_, _, uploads := cl.calls()
+	if len(uploads) != 2 {
+		t.Fatalf("%d uploads, want 2", len(uploads))
+	}
+	temps := map[string]bool{}
+	for _, u := range uploads {
+		if !strings.HasSuffix(u.remote, ".gpg") {
+			t.Errorf("%s does not end with .gpg", u.remote)
+		}
+		if filepath.Dir(u.local) != filepath.Clean(os.TempDir()) {
+			t.Errorf("staging file %q is not in %q", u.local, os.TempDir())
+		}
+		if temps[u.local] {
+			t.Errorf("staging file %q was used twice", u.local)
+		}
+		temps[u.local] = true
+		if _, err := os.Stat(u.local); !errors.Is(err, os.ErrNotExist) {
+			t.Errorf("staging file %q was not removed: %v", u.local, err)
+		}
+	}
+	want := map[string]string{
+		"/备份/照片/a.txt.gpg": "ENCRYPTED:pw:hello",
+		"/备份/照片/b.txt.gpg": "ENCRYPTED:pw:world!",
+	}
+	for remote, content := range want {
+		if got, ok := cl.file(remote); !ok || got != content {
+			t.Errorf("%s = %q, %v; want %q", remote, got, ok, content)
+		}
+	}
+	if maxTemp > cfg.Parallel {
+		t.Errorf("%d staging files existed at once, more than Parallel %d", maxTemp, cfg.Parallel)
+	}
+	for _, e := range log.all() {
+		if !e.Encrypted {
+			t.Errorf("progress %+v says not encrypted, but the run encrypts", e)
+		}
+	}
+	if len(tempLeftovers(t)) != len(before) {
+		t.Errorf("staging files were left behind: before %v, after %v", before, tempLeftovers(t))
+	}
+	// The state records the .gpg name, so the next run skips the files.
+	if got := st.Entries[filepath.Join(dir, "a.txt")].Remote; got != "/备份/照片/a.txt.gpg" {
+		t.Errorf("state remote = %q, want the .gpg name", got)
+	}
+	cl.reset()
+	res, err = Run(context.Background(), cl, cfg, st, "pw", nil)
+	if err != nil {
+		t.Fatalf("second Run: %v", err)
+	}
+	if res.Uploaded != 0 || res.Skipped != 2 {
+		t.Errorf("second result = %+v, want 2 skipped", res)
+	}
+}
