+// TestNestedFolders checks that netdisk folders are made one level at a time,
+// only where they are missing, and only for directories that hold files.
+func TestNestedFolders(t *testing.T) {
+	dir := t.TempDir()
+	write(t, dir, "a.txt", "a")
+	write(t, dir, "sub/b.txt", "b")
+	write(t, dir, "sub/deep/c.txt", "c")
+	if err := os.MkdirAll(filepath.Join(dir, "empty", "deeper"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	cfg := Config{Dest: "/备份", Folders: []Folder{{Local: dir, Remote: "照片"}}}
+
+	cl := newFake()
+	if _, err := Run(ctx, cl, cfg, NewState(), "", nil); err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	_, mkdirs, _ := cl.calls()
+	want := []string{"/备份", "/备份/照片", "/备份/照片/sub", "/备份/照片/sub/deep"}
+	if strings.Join(mkdirs, ",") != strings.Join(want, ",") {
+		t.Errorf("mkdirs = %v, want %v", mkdirs, want)
+	}
+	if cl.isDir("/备份/照片/empty") || cl.isDir("/备份/照片/empty/deeper") {
+		t.Error("an empty local directory was mirrored, but nothing in it is to be uploaded")
+	}
+
+	cl.reset()
+	if _, err := Run(ctx, cl, cfg, NewState(), "", nil); err != nil {
+		t.Fatalf("second Run: %v", err)
+	}
+	if _, mkdirs, _ := cl.calls(); len(mkdirs) != 0 {
+		t.Errorf("mkdirs on a tree that exists = %v, want none", mkdirs)
+	}
+
+	// A folder that is there already is not made again.
+	cl = newFake()
+	cl.putDir("/备份/照片")
+	dir2 := t.TempDir()
+	write(t, dir2, "a.txt", "a")
+	write(t, dir2, "sub/deep/c.txt", "c")
+	cfg2 := Config{Dest: "/备份", Folders: []Folder{{Local: dir2, Remote: "照片"}}}
+	if _, err := Run(ctx, cl, cfg2, NewState(), "", nil); err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	_, mkdirs, _ = cl.calls()
+	want = []string{"/备份/照片/sub", "/备份/照片/sub/deep"}
+	if strings.Join(mkdirs, ",") != strings.Join(want, ",") {
+		t.Errorf("mkdirs = %v, want %v", mkdirs, want)
+	}
+}
+
+// TestExclusions checks that the default and configured names are skipped at
+// any depth.
+func TestExclusions(t *testing.T) {
+	dir := t.TempDir()
+	write(t, dir, "keep.txt", "keep")
+	write(t, dir, ".git/config", "git")
+	write(t, dir, "sub/node_modules/x.js", "nm")
+	write(t, dir, ".cache/c", "cache")
+	write(t, dir, "sub/.Trash/t", "trash")
+	write(t, dir, "sub/.DS_Store", "ds")
+	write(t, dir, "Thumbs.db", "thumbs")
+	write(t, dir, "~$doc.docx", "lock")
+	write(t, dir, "secret.log", "secret")
+
