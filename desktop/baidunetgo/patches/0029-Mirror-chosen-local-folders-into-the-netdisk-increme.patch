+// markerEncrypt is a fake EncryptStream: it writes a marker, then the source.
+func markerEncrypt(dst io.Writer, src io.Reader, passphrase string) error {
+	if _, err := io.WriteString(dst, "ENCRYPTED:"+passphrase+":"); err != nil {
+		return err
+	}
+	_, err := io.Copy(dst, src)
+	return err
+}
