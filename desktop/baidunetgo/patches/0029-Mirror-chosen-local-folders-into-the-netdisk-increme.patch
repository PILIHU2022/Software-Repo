+	}
+	if res.Uploaded != 0 || res.Skipped != 0 || len(res.Errors) != 0 {
+		t.Errorf("result = %+v, want nothing to do", res)
+	}
+	for _, name := range []string{"a.txt", "b.txt"} {
+		if _, ok := cl.file("/备份/照片/" + name); !ok {
+			t.Errorf("%s was deleted from the netdisk, but nothing may be deleted", name)
+		}
+	}
+}
+
+// TestBytesCountSealedFile checks that the bytes counted are the local file's,
+// not the encrypted copy's.
+func TestBytesCountSealedFile(t *testing.T) {
+	dir := t.TempDir()
+	write(t, dir, "a.txt", "hello")
+	cl := newFake()
+	cfg := Config{
+		Dest:          "/备份",
+		Folders:       []Folder{{Local: dir, Remote: "照片"}},
+		Encrypt:       true,
+		EncryptStream: markerEncrypt,
+	}
+	res, err := Run(context.Background(), cl, cfg, NewState(), "pw", nil)
+	if err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if res.Bytes != int64(len("hello")) {
+		t.Errorf("Bytes = %d, want the local size %d", res.Bytes, len("hello"))
+	}
+}
+
+// TestFileErrorText checks that a FileError says what failed where.
+func TestFileErrorText(t *testing.T) {
+	e := FileError{Local: "/l/a.txt", Remote: "/r/a.txt", Err: errors.New("boom")}
+	if got := e.Error(); !strings.Contains(got, "/l/a.txt") || !strings.Contains(got, "/r/a.txt") || !strings.Contains(got, "boom") {
+		t.Errorf("Error() = %q, want the paths and the cause", got)
+	}
+	if !errors.Is(e, e.Err) {
+		t.Error("a FileError does not unwrap to its cause")
+	}
+	if got := (FileError{Local: "/l/a.txt", Err: errors.New("boom")}).Error(); !strings.Contains(got, "/l/a.txt") {
+		t.Errorf("Error() without a remote = %q", got)
+	}
+}
+
+// TestNilEntriesState checks that a state made by hand, with no entries map,
+// works: it is a full run, and the entries it records fill the map.
+func TestNilEntriesState(t *testing.T) {
+	dir := t.TempDir()
+	write(t, dir, "a.txt", "a")
+	cl := newFake()
+	cfg := Config{Dest: "/备份", Folders: []Folder{{Local: dir, Remote: "照片"}}}
+	st := &State{Version: StateVersion}
+	if _, err := Run(context.Background(), cl, cfg, st, "", nil); err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if len(st.Entries) != 1 {
+		t.Errorf("%d entries recorded, want 1", len(st.Entries))
+	}
+}
+
+// TestDefaultExcludes checks that the defaults the settings page shows are the
+// names the run skips.
+func TestDefaultExcludes(t *testing.T) {
+	got := DefaultExcludes()
+	want := []string{".git", "node_modules", ".cache", ".Trash", ".DS_Store", "Thumbs.db"}
+	if strings.Join(got, ",") != strings.Join(want, ",") {
+		t.Errorf("DefaultExcludes() = %v, want %v", got, want)
+	}
+	got[0] = "changed"
+	if DefaultExcludes()[0] != ".git" {
+		t.Error("DefaultExcludes() returns a slice the caller can change under it")
+	}
+}
