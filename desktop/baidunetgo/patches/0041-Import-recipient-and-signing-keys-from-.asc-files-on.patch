+
+// The largest key file the pickers read: a key ring is a few kilobytes; a cap
+// keeps a chosen huge file from being pulled into memory whole.
+private const val MAX_KEY_FILE_BYTES = 4 shl 20
+
+/** Reads a key file the document picker returned, UTF-8, or null when it is empty or unreadable. */
+private fun readKeyFile(context: Context, uri: Uri): String? {
+    return runCatching {
+        context.contentResolver.openInputStream(uri)?.use { input ->
+            val out = java.io.ByteArrayOutputStream()
+            val buf = ByteArray(64 * 1024)
+            var total = 0
+            while (true) {
+                val n = input.read(buf)
+                if (n <= 0) break
+                total += n
+                if (total > MAX_KEY_FILE_BYTES) return@use null
+                out.write(buf, 0, n)
+            }
+            String(out.toByteArray(), Charsets.UTF_8).trim().ifEmpty { null }
+        }
+    }.getOrNull()
+}
+
+/** Writes armored key text to the document the picker created; true when it landed. */
+private fun writeKeyFile(context: Context, uri: Uri, text: String): Boolean {
+    return runCatching {
+        context.contentResolver.openOutputStream(uri)?.use { output ->
+            output.write(text.toByteArray(Charsets.UTF_8))
+            true
+        } ?: false
+    }.getOrDefault(false)
+}
