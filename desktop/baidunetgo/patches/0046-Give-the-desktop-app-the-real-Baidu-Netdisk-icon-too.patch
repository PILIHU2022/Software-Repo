+// catmullRom is the cubic Catmull-Rom kernel, for the logo's resampling.
+func catmullRom(t float64) float64 {
+	t = math.Abs(t)
+	if t < 1 {
+		return 1.5*t*t*t - 2.5*t*t + 1
+	}
+	if t < 2 {
+		return -0.5*t*t*t + 2.5*t*t - 4*t + 2
+	}
+	return 0
+}
