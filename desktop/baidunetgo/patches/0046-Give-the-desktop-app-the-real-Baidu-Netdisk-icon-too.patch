+// resample scales src to dw × dh with the Catmull-Rom filter in
+// premultiplied space, so that translucent edges keep no halo. It returns
+// premultiplied RGBA.
+func resample(src *image.NRGBA, dw, dh int) *image.RGBA {
+	sw, sh := src.Rect.Dx(), src.Rect.Dy()
+	// A row of premultiplied samples.
+	line := func(src *image.NRGBA, y int) []float64 {
+		px := src.Pix[y*src.Stride : y*src.Stride+sw*4]
+		out := make([]float64, dw*4)
+		for dx := range dw {
+			// The source coordinate this destination pixel samples
+			// around, and the four taps the kernel weighs.
+			sx := (float64(dx)+0.5)*float64(sw)/float64(dw) - 0.5
+			base := int(math.Floor(sx))
+			var acc [4]float64
+			for i := base - 1; i <= base+2; i++ {
+				ci := min(max(i, 0), sw-1)
+				w := catmullRom(sx - float64(i))
+				acc[0] += float64(px[ci*4+0]) * w
+				acc[1] += float64(px[ci*4+1]) * w
+				acc[2] += float64(px[ci*4+2]) * w
+				acc[3] += float64(px[ci*4+3]) * w
+			}
+			for c := range acc {
+				out[dx*4+c] = acc[c]
+			}
+		}
+		return out
+	}
+	tmp := make([][]float64, dh)
+	for dy := range dh {
+		sy := (float64(dy)+0.5)*float64(sh)/float64(dh) - 0.5
+		base := int(math.Floor(sy))
+		rows := [4][]float64{
+			line(src, min(max(base-1, 0), sh-1)),
+			line(src, min(max(base, 0), sh-1)),
+			line(src, min(max(base+1, 0), sh-1)),
+			line(src, min(max(base+2, 0), sh-1)),
+		}
+		tmp[dy] = make([]float64, dw*4)
+		for dx := range dw {
+			var acc [4]float64
+			for r := range 4 {
+				w := catmullRom(sy - float64(base-1+r))
+				for c := range 4 {
+					acc[c] += rows[r][dx*4+c] * w
+				}
+			}
+			copy(tmp[dy][dx*4:dx*4+4], acc[:])
+		}
+	}
+	out := image.NewRGBA(image.Rect(0, 0, dw, dh))
+	for dy := range dh {
+		for dx := range dw {
+			o := dy*out.Stride + dx*4
+			for c := range 4 {
+				out.Pix[o+c] = clamp8(tmp[dy][dx*4+c])
+			}
+		}
+	}
+	return out
+}
