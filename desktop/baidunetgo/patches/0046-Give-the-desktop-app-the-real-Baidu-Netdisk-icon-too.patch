 =?UTF-8?q?=20Baidu=20Netdisk=20icon=20=E2=80=94=20tools/appicon=20now=20c?=
 =?UTF-8?q?omposes=20it=20from=20the=20official=20cloud=20logo=20on=20a=20?=
 =?UTF-8?q?white=20squircle=20instead=20of=20drawing=20its=20own=20cloud,?=
 =?UTF-8?q?=20since=20the=20patched=20build=20sits=20next=20to=20the=20off?=
