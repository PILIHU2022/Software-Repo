 AGENTS.md                             |   2 +-
 CLAUDE.md                             |   2 +-
 resources/icon.png                    | Bin 88066 -> 178640 bytes
 tools/appicon/assets/netdisk_logo.png | Bin 0 -> 52365 bytes
 tools/appicon/main.go                 | 336 ++++++++++++++++++++------
 5 files changed, 259 insertions(+), 81 deletions(-)
 create mode 100644 tools/appicon/assets/netdisk_logo.png

diff --git a/AGENTS.md b/AGENTS.md
index df6637c..c747c9d 100644
--- a/AGENTS.md
+++ b/AGENTS.md
@@ -20,7 +20,7 @@ go vet ./... && gofmt -l .
 go tool mygo build                    # package for this platform into build/
 go tool mygo build -sign "BaiduNetGo Dev"   # same, signed with a fixed self-signed cert so the keychain's "Always Allow" survives rebuilds
 CGO_ENABLED=0 GOOS=windows go build -o /dev/null .   # cross-compile check
-go run ./tools/appicon                # redraw the app icon, resources/icon.png, which mygo build packages
+go run ./tools/appicon                # compose the Baidu Netdisk icon, resources/icon.png, which mygo build packages
 cd android && ./gradlew :app:assembleDebug   # the Android client's APK (needs JDK 21 + SDK 37; not part of go build)
 go run ./cmd/fakepand                 # the fake netdisk as a standalone process (prints url=…), for the Android tests
 ```
diff --git a/CLAUDE.md b/CLAUDE.md
index 25250c8..43b9faf 100644
--- a/CLAUDE.md
+++ b/CLAUDE.md
@@ -20,7 +20,7 @@ go vet ./... && gofmt -l .
 go tool mygo build                    # package for this platform into build/
 go tool mygo build -sign "BaiduNetGo Dev"   # same, signed with a fixed self-signed cert so the keychain's "Always Allow" survives rebuilds
 CGO_ENABLED=0 GOOS=windows go build -o /dev/null .   # cross-compile check
-go run ./tools/appicon                # redraw the app icon, resources/icon.png, which mygo build packages
+go run ./tools/appicon                # compose the Baidu Netdisk icon, resources/icon.png, which mygo build packages
 cd android && ./gradlew :app:assembleDebug   # the Android client's APK (needs JDK 21 + SDK 37; not part of go build)
 go run ./cmd/fakepand                 # the fake netdisk as a standalone process (prints url=…), for the Android tests
 ```
