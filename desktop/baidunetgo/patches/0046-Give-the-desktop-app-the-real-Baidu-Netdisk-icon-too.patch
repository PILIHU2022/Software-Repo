+// premultiply turns src's straight RGBA premultiplied, so that resampling
+// a translucent edge cannot bleed its unused color into its neighbours.
+func premultiply(src *image.NRGBA) *image.NRGBA {
+	out := image.NewNRGBA(src.Rect)
+	for y := src.Rect.Min.Y; y < src.Rect.Max.Y; y++ {
+		for x := src.Rect.Min.X; x < src.Rect.Max.X; x++ {
+			o := y*src.Stride + x*4
+			a := float64(src.Pix[o+3]) / 255
+			for c := range 3 {
+				out.Pix[o+c] = uint8(math.Round(float64(src.Pix[o+c]) * a))
+			}
+			out.Pix[o+3] = src.Pix[o+3]
+		}
+	}
+	return out
+}
