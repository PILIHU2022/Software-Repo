+// clamp8 rounds a premultiplied channel to a byte, catching the filter's
+// overshoot on the hard edges of the source logo.
+func clamp8(v float64) uint8 { return uint8(math.Round(math.Min(255, math.Max(0, v)))) }
+
+// blur returns the alpha channel of src blurred with a gaussian of sigma
+// sigma, as floats.
+func blur(src *image.RGBA, sigma float64) []float64 {
+	w, h := src.Rect.Dx(), src.Rect.Dy()
+	a := make([]float64, w*h)
+	for y := range h {
+		for x := range w {
+			a[y*w+x] = float64(src.Pix[y*src.Stride+x*4+3])
+		}
+	}
+	r := int(math.Ceil(sigma * 3))
+	var k []float64
+	for i := -r; i <= r; i++ {
+		k = append(k, math.Exp(-float64(i*i)/(2*sigma*sigma)))
+	}
+	var sum float64
+	for _, v := range k {
+		sum += v
+	}
+	tmp := make([]float64, w*h)
+	for y := range h {
+		for x := range w {
+			var acc float64
+			for i := -r; i <= r; i++ {
+				ci := min(max(x+i, 0), w-1)
+				acc += a[y*w+ci] * k[i+r]
+			}
+			tmp[y*w+x] = acc / sum
+		}
+	}
+	out := make([]float64, w*h)
+	for y := range h {
+		for x := range w {
+			var acc float64
+			for i := -r; i <= r; i++ {
+				ri := min(max(y+i, 0), h-1)
+				acc += tmp[ri*w+x] * k[i+r]
+			}
+			out[y*w+x] = acc / sum
+		}
+	}
+	return out
+}
