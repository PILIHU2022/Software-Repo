+// TestBackupEncryptAsksForPassword checks that turning 加密备份 on without a
+// passphrase opens the dialog for one, that a short or mistyped passphrase is
+// refused, and that a good one is sealed in a file of its own — never in
+// settings.json.
+func TestBackupEncryptAsksForPassword(t *testing.T) {
+	settingsDir, stateDir := backupTestDirs(t)
+	a, tt, _ := signedIn(t)
+	a.router.Push("/settings")
+	waitFor(t, tt, "备份到")
+	scrollToShow(t, tt, "加密备份")
+	sw, ok := tt.AccessByRole(ui.RoleSwitch, "加密备份")
+	if !ok {
+		t.Fatalf("no 加密备份 switch; texts %q", tt.Texts())
+	}
+	b := sw.Bounds
+	tt.ClickAt(b.X+b.W/2, b.Y+b.H/2)
+	tt.Advance(300 * time.Millisecond)
+	if !a.settings.Backup.Encrypt {
+		t.Fatal("turning 加密备份 on did not take")
+	}
+	if !a.backup.pwdOpen {
+		t.Fatal("turning encryption on with no passphrase did not ask for one")
+	}
+	save(t, tt, "settings-backup-password")
+
+	// A short passphrase is refused.
+	a.backup.pwd, a.backup.pwd2 = "1234567", "1234567"
+	a.saveBackupPassphrase()
+	if a.backup.pwdErr == "" || !a.backup.pwdOpen || a.backup.passSet {
+		t.Fatalf("a 7-character passphrase was accepted: err %q open %v set %v",
+			a.backup.pwdErr, a.backup.pwdOpen, a.backup.passSet)
+	}
+	// Two different ones are refused.
+	a.backup.pwd, a.backup.pwd2 = "correct horse", "correct house"
+	a.saveBackupPassphrase()
+	if a.backup.pwdErr == "" || a.backup.passSet {
+		t.Fatalf("a mistyped passphrase was accepted: err %q", a.backup.pwdErr)
+	}
+	// A good one is taken and sealed.
+	a.backup.pwd, a.backup.pwd2 = "correct horse", "correct horse"
+	a.saveBackupPassphrase()
+	if !a.backup.passSet || a.backup.pass != "correct horse" || a.backup.pwdOpen {
+		t.Fatalf("passphrase after saving: set %v pass %q open %v",
+			a.backup.passSet, a.backup.pass, a.backup.pwdOpen)
+	}
+	sealed := filepath.Join(stateDir, "backup-key.enc")
+	waitUntil(t, tt, "the sealed passphrase", func() bool {
+		_, err := os.Stat(sealed)
+		return err == nil
+	})
+	// It reads back, and neither file holds it in plain text.
+	if pass, err := readBackupPass(stateDir, nil); err != nil || pass != "correct horse" {
+		t.Errorf("readBackupPass = %q, %v", pass, err)
+	}
+	data, err := os.ReadFile(sealed)
+	if err == nil && bytes.Contains(data, []byte("correct horse")) {
+		t.Error("the sealed passphrase is in plain text")
+	}
+	a.applyBackupSettings() // writes settings.json
+	data, err = os.ReadFile(filepath.Join(settingsDir, "settings.json"))
+	if err == nil && bytes.Contains(data, []byte("correct horse")) {
+		t.Error("settings.json holds the passphrase")
+	}
+	if !strings.Contains(string(data), `"encrypt": true`) {
+		t.Errorf("settings.json does not keep 加密备份: %s", data)
+	}
+	// The 密码 row says it is set.
+	tt.Advance(300 * time.Millisecond)
+	scrollToShow(t, tt, "密码")
+	if !tt.HasText("已设置") {
+		t.Errorf("the 密码 row does not say 已设置; texts %q", tt.Texts())
+	}
+}
