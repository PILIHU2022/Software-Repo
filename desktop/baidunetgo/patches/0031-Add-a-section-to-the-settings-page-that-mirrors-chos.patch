+
+// backupSettings is the automatic backup's settings, as the 备份 section of
+// the settings page keeps them. The passphrase is not here: it lives in the
+// user data dir's backup-key.enc, sealed with a key of its own.
+type backupSettings struct {
+	Auto     bool            `json:"auto,omitempty"`     // run by itself on the interval
+	Dest     string          `json:"dest,omitempty"`     // netdisk destination, defaultBackupDest when empty
+	Interval int             `json:"interval,omitempty"` // minutes between automatic runs, 0 only by hand
+	Encrypt  bool            `json:"encrypt,omitempty"`  // encrypt every file, ".gpg" on the netdisk
+	Folders  []backup.Folder `json:"folders,omitempty"`  // the local folders to mirror
+}
+
+// defaultBackupDest is the netdisk folder backups go to when none was
+// chosen: the engine creates it, and each folder's own subfolder, as needed.
+const defaultBackupDest = "/备份"
+
+// backupIntervals are the 间隔 choices, in minutes; 0 means only by hand.
+var backupIntervals = []int{0, 15, 30, 60, 360, 1440}
+
+// backupIntervalLabels names them, as the settings page shows them.
+var backupIntervalLabels = []string{"仅手动", "15 分钟", "30 分钟", "1 小时", "6 小时", "24 小时"}
+
+// backupDest returns the netdisk destination, an absolute path.
+func (s settings) backupDest() string {
+	d := strings.TrimSpace(s.Backup.Dest)
+	if d == "" {
+		return defaultBackupDest
+	}
+	if !strings.HasPrefix(d, "/") {
+		d = "/" + d
+	}
+	return d
+}
+
+// backupInterval returns how long between automatic runs: 0 means only by
+// hand.
+func (s settings) backupInterval() time.Duration {
+	if s.Backup.Interval <= 0 {
+		return 0
+	}
+	return time.Duration(s.Backup.Interval) * time.Minute
+}
+
+// backupIntervalIndex is where the chosen interval is among the presets, 0
+// for 仅手动.
+func (s settings) backupIntervalIndex() int {
+	if i := slices.Index(backupIntervals, s.Backup.Interval); i >= 0 {
+		return i
+	}
+	return 0
+}
+
+// backupIntervalLabel names the chosen interval.
+func (s settings) backupIntervalLabel() string {
+	return backupIntervalLabels[s.backupIntervalIndex()]
+}
+
+// backupIntervalDetail says when the automatic backup runs under the
+// current switch and interval.
+func (s settings) backupIntervalDetail() string {
+	if s.Backup.Interval <= 0 {
+		return "只在你按下「立即备份」时运行"
+	}
+	if !s.Backup.Auto {
+		return "开启自动备份后每 " + s.backupIntervalLabel() + "运行一次"
+	}
+	return "每 " + s.backupIntervalLabel() + "自动备份一次"
+}
+
+// autoBackupDetail says what the 自动备份 switch is doing.
+func (s settings) autoBackupDetail() string {
+	switch {
+	case !s.Backup.Auto:
+		return "已关闭，只能手动备份"
+	case s.Backup.Interval <= 0:
+		return "已开启，但间隔为仅手动，仍需按下「立即备份」"
+	default:
+		return "已开启，每 " + s.backupIntervalLabel() + "自动备份一次"
+	}
 }
 
