+// backupTestDirs keeps the settings and the backup state in temporary
+// folders, so that the tests never read or write the user's data directory.
+func backupTestDirs(t *testing.T) (settingsDir, stateDir string) {
+	t.Helper()
+	settingsDir = t.TempDir()
+	mygo.App.SetPath(mygo.PathUserData, settingsDir)
+	t.Cleanup(func() { mygo.App.SetPath(mygo.PathUserData, "") })
+	stateDir = t.TempDir()
+	old := backupStoreDir
+	backupStoreDir = stateDir
+	t.Cleanup(func() { backupStoreDir = old })
+	return settingsDir, stateDir
+}
+
+// backupLocalTree writes a small tree of files for a run to back up.
+func backupLocalTree(t *testing.T) (dir string, files map[string]string) {
+	t.Helper()
+	dir = t.TempDir()
+	files = map[string]string{
+		"a.txt":          "第一个文件",
+		"sub/b.txt":      "第二个文件",
+		"sub/deep/c.txt": "第三个文件",
+	}
+	for name, content := range files {
+		p := filepath.Join(dir, filepath.FromSlash(name))
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir, files
+}
+
+// waitBackupDone builds frames until the run under way finished, and returns
+// failing when it never did.
+func waitBackupDone(t *testing.T, tt *ui.Tester, a *App) {
+	t.Helper()
+	waitUntil(t, tt, "the backup run", func() bool {
+		return !a.backup.running && !a.backup.lastRun.IsZero()
+	})
+}
+
+// TestBackupSettings checks that the 备份 section renders its rows and that
+// its switches persist to settings.json.
+func TestBackupSettings(t *testing.T) {
+	settingsDir, _ := backupTestDirs(t)
+	a, tt, _ := signedIn(t)
+	a.router.Push("/settings")
+	waitFor(t, tt, "备份到")
+	scrollToShow(t, tt, "备份到")
+	for _, want := range []string{"自动备份", "备份到", "间隔", "加密备份", "密码", "立即备份"} {
+		if !tt.HasText(want) {
+			t.Errorf("%q missing; texts %q", want, tt.Texts())
+		}
+	}
+	if got, want := a.settings.backupDest(), "/备份"; got != want {
+		t.Errorf("default destination %q, want %q", got, want)
+	}
+	save(t, tt, "settings-backup")
+	tt.SetDark(true)
+	tt.Advance(300 * time.Millisecond)
+	save(t, tt, "settings-backup-dark")
+	tt.SetDark(false)
+
+	// The automatic backup switch is at the end of its row.
+	scrollToShow(t, tt, "自动备份")
+	sw, ok := tt.AccessByRole(ui.RoleSwitch, "自动备份")
+	if !ok {
+		t.Fatalf("no 自动备份 switch; texts %q", tt.Texts())
+	}
+	b := sw.Bounds
+	tt.ClickAt(b.X+b.W/2, b.Y+b.H/2)
+	tt.Advance(300 * time.Millisecond)
+	if !a.settings.Backup.Auto {
+		t.Fatal("turning 自动备份 on did not take")
+	}
+	data, err := os.ReadFile(filepath.Join(settingsDir, "settings.json"))
+	if err != nil {
+		t.Fatalf("settings.json: %v", err)
+	}
+	if !strings.Contains(string(data), `"auto": true`) {
+		t.Errorf("settings.json does not keep the switch: %s", data)
+	}
+	// And off again, the interval 仅手动 leaving no automatic run.
+	sw, ok = tt.AccessByRole(ui.RoleSwitch, "自动备份")
+	if !ok {
+		t.Fatal("the switch vanished")
+	}
+	b = sw.Bounds
+	tt.ClickAt(b.X+b.W/2, b.Y+b.H/2)
+	tt.Advance(300 * time.Millisecond)
+	if a.settings.Backup.Auto {
+		t.Error("turning 自动备份 off did not take")
+	}
+	if a.backup.timer != nil {
+		t.Error("a timer was arranged with 仅手动 and the switch off")
+	}
+}
