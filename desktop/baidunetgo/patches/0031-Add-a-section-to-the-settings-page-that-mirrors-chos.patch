+// TestBackupRun backs a tree up to the fake netdisk: the files arrive with
+// their content, the state file is written, and a second run uploads nothing.
+func TestBackupRun(t *testing.T) {
+	_, stateDir := backupTestDirs(t)
+	a, tt, srv := signedIn(t)
+	local, files := backupLocalTree(t)
+	a.settings.Backup = backupSettings{
+		Dest:    "/备份",
+		Folders: []backup.Folder{{Local: local}},
+	}
+	a.applyBackupSettings()
+	a.router.Push("/settings")
+	waitFor(t, tt, "备份到")
+
+	a.runBackupNow()
+	waitBackupDone(t, tt, a)
+	if a.backup.lastErr != "" {
+		t.Fatalf("the run failed: %s", a.backup.lastErr)
+	}
+	if a.backup.uploaded != len(files) || a.backup.skipped != 0 || a.backup.failed != 0 {
+		t.Fatalf("run did %d uploaded, %d skipped, %d failed, want %d uploaded",
+			a.backup.uploaded, a.backup.skipped, a.backup.failed, len(files))
+	}
+	base := "/备份/" + filepath.Base(local)
+	for name, content := range files {
+		p := base + "/" + name
+		if !srv.Exists(p) {
+			t.Errorf("%s is not on the fake netdisk", p)
+			continue
+		}
+		if got := string(srv.Data(p)); got != content {
+			t.Errorf("%s holds %q, want %q", p, got, content)
+		}
+	}
+
+	// The state file records the run.
+	statePath := filepath.Join(stateDir, backupStateName)
+	waitUntil(t, tt, "the state file", func() bool {
+		_, err := os.Stat(statePath)
+		return err == nil
+	})
+	data, err := os.ReadFile(statePath)
+	if err != nil {
+		t.Fatalf("state file: %v", err)
+	}
+	var f backupStateFile
+	if err := json.Unmarshal(data, &f); err != nil {
+		t.Fatalf("state file: %v", err)
+	}
+	if f.Version != backup.StateVersion || len(f.Entries) != len(files) || f.Uploaded != len(files) {
+		t.Errorf("state file = version %d, %d entries, %d uploaded, want version %d, %d entries",
+			f.Version, len(f.Entries), f.Uploaded, backup.StateVersion, len(files))
+	}
+
+	// The page shows what the last run did.
+	scrollToShow(t, tt, "备份状态")
+	if !tt.HasText("上次备份") {
+		t.Errorf("no 上次备份 summary; texts %q", tt.Texts())
+	}
+	if !tt.HasText("上传 " + itoa(len(files)) + " 个") {
+		t.Errorf("the summary does not count %d uploads; texts %q", len(files), tt.Texts())
+	}
+
+	// A second run finds everything unchanged.
+	a.runBackupNow()
+	waitUntil(t, tt, "the second run", func() bool {
+		return !a.backup.running && a.backup.uploaded == 0 && a.backup.skipped == len(files)
+	})
+	if !tt.HasText("跳过 " + itoa(len(files)) + " 个") {
+		t.Errorf("the second run's summary does not count %d skipped; texts %q", len(files), tt.Texts())
+	}
+}
+
+// TestBackupEncryptedRun encrypts every file into a ".gpg" name and checks
+// that pgp.Decrypt gives the original content back.
+func TestBackupEncryptedRun(t *testing.T) {
+	backupTestDirs(t)
+	a, tt, srv := signedIn(t)
+	local, files := backupLocalTree(t)
+	a.backup.pass, a.backup.passSet, a.backup.passRead = "correct horse", true, true
+	a.settings.Backup = backupSettings{
+		Dest:    "/备份",
+		Folders: []backup.Folder{{Local: local}},
+		Encrypt: true,
+	}
+	a.applyBackupSettings()
+	a.runBackupNow()
+	waitBackupDone(t, tt, a)
+	if a.backup.uploaded != len(files) {
+		t.Fatalf("%d uploaded, want %d; error %q", a.backup.uploaded, len(files), a.backup.lastErr)
+	}
+	base := "/备份/" + filepath.Base(local)
+	for name, content := range files {
+		remote := base + "/" + name + pgp.Suffix
+		if !srv.Exists(remote) {
+			t.Errorf("%s is not on the fake netdisk", remote)
+			continue
+		}
+		var out bytes.Buffer
+		if err := pgp.Decrypt(&out, bytes.NewReader(srv.Data(remote)), "correct horse"); err != nil {
+			t.Errorf("pgp.Decrypt(%s): %v", remote, err)
+			continue
+		}
+		if out.String() != content {
+			t.Errorf("%s decrypts to %q, want %q", remote, out.String(), content)
+		}
+	}
+}
+
+// TestBackupMissingFolderKeepsGoing checks that one folder that is not there
+// is reported without aborting the run, and that the page offers the details.
+func TestBackupMissingFolderKeepsGoing(t *testing.T) {
+	backupTestDirs(t)
+	a, tt, _ := signedIn(t)
+	local, files := backupLocalTree(t)
+	missing := filepath.Join(t.TempDir(), "已经删除")
+	a.settings.Backup = backupSettings{
+		Dest:    "/备份",
+		Folders: []backup.Folder{{Local: local}, {Local: missing}},
+	}
+	a.applyBackupSettings()
+	a.runBackupNow()
+	waitBackupDone(t, tt, a)
+	if a.backup.uploaded != len(files) {
+		t.Errorf("%d uploaded after a missing folder, want %d (the run aborted)",
+			a.backup.uploaded, len(files))
+	}
+	if len(a.backup.errs) == 0 {
+		t.Error("the missing folder was not reported")
+	}
+	if a.backup.lastErr != "" {
+		t.Errorf("a missing folder failed the whole run: %q", a.backup.lastErr)
+	}
+
+	a.router.Push("/settings")
+	waitFor(t, tt, "备份到")
+	scrollToShow(t, tt, "查看详情")
+	if err := tt.Click("查看详情"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(300 * time.Millisecond)
+	if !a.backup.detailsOpen {
+		t.Fatal("the details dialog did not open")
+	}
+	if !tt.HasText("备份详情") {
+		t.Errorf("the details dialog shows no title; texts %q", tt.Texts())
+	}
+	save(t, tt, "settings-backup-details")
+}
+
+// TestBackupFoldersAddRemove adds folders through the chooser's stand-in and
+// removes one, checking that each change reaches settings.json.
+func TestBackupFoldersAddRemove(t *testing.T) {
+	settingsDir, _ := backupTestDirs(t)
+	dir1, dir2 := t.TempDir(), t.TempDir()
+	old := backupPickFolders
+	backupPickFolders = func(*App) ([]string, error) {
+		return []string{dir1, dir1, dir2}, nil // the same folder twice is one entry
+	}
+	t.Cleanup(func() { backupPickFolders = old })
+
+	a, tt, _ := signedIn(t)
+	a.addBackupFolders()
+	waitUntil(t, tt, "the folders added", func() bool {
+		return len(a.settings.Backup.Folders) == 2
+	})
+	if got := a.settings.Backup.Folders[0].Local; got != dir1 {
+		t.Errorf("first folder %q, want %q", got, dir1)
+	}
+	if got := a.settings.Backup.Folders[1].Local; got != dir2 {
+		t.Errorf("second folder %q, want %q", got, dir2)
+	}
+	var s settings
+	data, err := os.ReadFile(filepath.Join(settingsDir, "settings.json"))
+	if err != nil {
+		t.Fatalf("settings.json: %v", err)
+	}
+	if err := json.Unmarshal(data, &s); err != nil {
+		t.Fatalf("settings.json: %v", err)
+	}
+	if len(s.Backup.Folders) != 2 {
+		t.Errorf("settings.json keeps %d folders, want 2: %s", len(s.Backup.Folders), data)
+	}
+
+	a.router.Push("/settings")
+	waitFor(t, tt, "备份到")
+	scrollToShow(t, tt, "移除")
+	if err := tt.Click("移除"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(200 * time.Millisecond)
+	if len(a.settings.Backup.Folders) != 1 || a.settings.Backup.Folders[0].Local != dir2 {
+		t.Errorf("after removing the first folder: %+v", a.settings.Backup.Folders)
+	}
+}
+
+// TestBackupSchedule checks the automatic run's timing, that a new interval
+// reschedules it, that it starts by itself, and that signing out stops it.
+func TestBackupSchedule(t *testing.T) {
+	backupTestDirs(t)
+	oldFirst := backupFirstDelay
+	backupFirstDelay = 20 * time.Millisecond
+	t.Cleanup(func() { backupFirstDelay = oldFirst })
+
+	a, tt, _ := signedIn(t)
+	t.Cleanup(a.stopBackup)
+	local, files := backupLocalTree(t)
+	a.settings.Backup = backupSettings{
+		Auto:     true,
+		Dest:     "/备份",
+		Interval: 15,
+		Folders:  []backup.Folder{{Local: local}},
+	}
+	a.applyBackupSettings()
+	if a.backup.timer == nil || a.backup.next.IsZero() {
+		t.Fatal("no automatic run was arranged")
+	}
+	// The first run waits backupFirstDelay, shorter than the interval.
+	if d := time.Until(a.backup.next); d > 5*time.Second || d < 0 {
+		t.Errorf("the first run is due in %v, want at most %v", d, 5*time.Second)
+	}
+	// It runs by itself and uploads the tree.
+	waitBackupDone(t, tt, a)
+	if a.backup.uploaded != len(files) {
+		t.Errorf("%d uploaded by the automatic run, want %d", a.backup.uploaded, len(files))
+	}
+	if a.backup.timer == nil {
+		t.Error("the next automatic run was not arranged after one finished")
+	}
+
+	// Another interval moves the next run: a past due last run fires in a
+	// second, a day's interval waits a day.
+	a.backup.lastRun = time.Now().Add(-2 * time.Hour)
+	a.settings.Backup.Interval = 60
+	a.applyBackupSettings()
+	if d := time.Until(a.backup.next); d > 2*time.Second {
+		t.Errorf("with a past due run the next is in %v, want about a second", d)
+	}
+	a.settings.Backup.Interval = 1440
+	a.applyBackupSettings()
+	if d := time.Until(a.backup.next); d < 20*time.Hour {
+		t.Errorf("with a day's interval the next run is in %v", d)
+	}
+
+	// Signing out stops the automatic runs.
+	a.signOut()
+	if a.backup.timer != nil || !a.backup.next.IsZero() {
+		t.Errorf("signing out left timer %v next %v", a.backup.timer, a.backup.next)
+	}
+}
