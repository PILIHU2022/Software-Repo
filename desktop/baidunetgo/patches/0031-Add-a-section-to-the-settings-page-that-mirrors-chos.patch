 	// 外观 section of the settings offers; empty keeps the theme's own,
 	// the system blue.
 	AccentColor string `json:"accent_color,omitempty"`
+	// Backup is the 备份 section's automatic folder backup (backup.go).
+	Backup backupSettings `json:"backup,omitempty"`
