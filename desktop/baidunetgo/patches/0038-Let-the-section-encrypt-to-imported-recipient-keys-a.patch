+// How EncryptMode names the way encrypted runs encrypt; "" is no encryption.
+const (
+	backupModePassphrase = "passphrase"
+	backupModeKeys       = "keys"
+	backupModeBoth       = "both"
+)
+
+// backupEncryptModeLabels names the 加密方式 choices, in the order of
+// backupEncryptModes.
+var backupEncryptModeLabels = []string{"仅密码", "收件人密钥", "密码+密钥"}
+
+// backupEncryptModes are the settings values behind those labels.
+var backupEncryptModes = []string{backupModePassphrase, backupModeKeys, backupModeBoth}
+
+// backupEncryptMode is the way encrypted runs encrypt now: "" for none.
+// The Encrypt switch stays the master, so an older build's settings.json —
+// encrypt without a mode — reads as passphrase-only.
+func (s settings) backupEncryptMode() string {
+	if !s.Backup.Encrypt {
+		return ""
+	}
+	switch s.Backup.EncryptMode {
+	case backupModeKeys, backupModeBoth:
+		return s.Backup.EncryptMode
+	default:
+		return backupModePassphrase
+	}
+}
+
+// backupEncryptModeIndex is where the chosen mode sits among the popup's
+// choices, 0 for 仅密码.
+func (s settings) backupEncryptModeIndex() int {
+	switch s.backupEncryptMode() {
+	case backupModeKeys:
+		return 1
+	case backupModeBoth:
+		return 2
+	default:
+		return 0
+	}
