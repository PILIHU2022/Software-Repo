+	// The signer goes through the real load path: on disk, read once by
+	// backupKeysLoaded when the section first renders.
+	if err := writeBackupKeyFile(stateDir, backupSignerFile, private); err != nil {
+		t.Fatal(err)
+	}
+	a.backup.recRead, a.backup.signerRead = false, false
+	local, _ := backupLocalTree(t)
+	a.settings.Backup = backupSettings{
+		Dest:        "/备份",
+		Folders:     []backup.Folder{{Local: local}},
+		Encrypt:     true,
+		EncryptMode: backupModeBoth,
+		Sign:        true,
+	}
+	a.applyBackupSettings()
+	a.router.Push("/settings")
+	waitFor(t, tt, "备份到")
+	scrollToShow(t, tt, "备份状态")
+	save(t, tt, "settings-backup-keys")
+	scrollToShow(t, tt, "收件人")
+	save(t, tt, "settings-backup-keys-recipients")
+	tt.SetDark(true)
+	tt.Advance(300 * time.Millisecond)
+	save(t, tt, "settings-backup-keys-dark")
+	tt.SetDark(false)
+}
+
+// TestBackupRunPromptsForMissingPieces checks that a manual run with signing
+// on but no signer key opens the signer dialog instead of failing quietly,
+// and that a keys mode without any recipient opens the recipients dialog.
+func TestBackupRunPromptsForMissingPieces(t *testing.T) {
+	backupTestDirs(t)
+	a, _, _ := signedIn(t)
+	local, _ := backupLocalTree(t)
+	a.backup.pass, a.backup.passSet, a.backup.passRead = "correct horse", true, true
+	a.settings.Backup = backupSettings{
+		Dest:    "/备份",
+		Folders: []backup.Folder{{Local: local}},
+		Encrypt: true,
+		Sign:    true,
+	}
+	a.applyBackupSettings()
+
+	a.runBackupNow()
+	if a.backup.running || !a.backup.lastRun.IsZero() {
+		t.Error("a run started without a signer key")
+	}
+	if !a.backup.sigOpen {
+		t.Errorf("no 签名密钥 dialog was opened; sigOpen %v", a.backup.sigOpen)
+	}
+
+	// Keys mode without any recipient asks for one.
+	a.settings.Backup.Sign = false
+	a.settings.Backup.EncryptMode = backupModeKeys
+	a.applyBackupSettings()
+	a.runBackupNow()
+	if a.backup.running {
+		t.Error("a run started without any recipient")
+	}
+	if !a.backup.recOpen {
+		t.Errorf("no 收件人 dialog was opened; recOpen %v", a.backup.recOpen)
+	}
+}
