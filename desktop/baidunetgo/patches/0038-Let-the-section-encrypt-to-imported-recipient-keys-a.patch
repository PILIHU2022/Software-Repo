+// backupKeysLoaded makes sure the recipients and the signer were read, once.
+// It reads them on a goroutine, as the key files sit beside the state and
+// parsing an armored key is not free.
+func (a *App) backupKeysLoaded() {
+	b := &a.backup
+	if b.recRead && b.signerRead {
+		return
+	}
+	b.recRead, b.signerRead = true, true
+	dir := a.backupDir()
+	if dir == "" {
+		return
+	}
+	kr := a.backupKeyring()
+	go func() {
+		rec, raw := loadBackupRecipients(dir)
+		signer := loadBackupSigner(dir)
+		pass, _ := readBackupSignerPass(dir, kr)
+		a.update(func() {
+			a.backup.recipients, a.backup.recRaw = rec, raw
+			a.backup.signer, a.backup.signerPass = signer, pass
+		})
+	}()
