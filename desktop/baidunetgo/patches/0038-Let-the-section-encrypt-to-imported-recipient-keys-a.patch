+// pickBackupRecipientFile reads a public key file on a goroutine — the
+// native chooser opens a window of its own — and adds it.
+func (a *App) pickBackupRecipientFile() {
+	go func() {
+		p, err := backupPickKeyFile(a)
+		if err != nil || p == "" {
+			return
+		}
+		data, err := os.ReadFile(p)
+		a.update(func() {
+			if err != nil {
+				a.backup.recErr = "读取文件失败：" + err.Error()
+				return
+			}
+			if _, err := a.addBackupRecipients(string(data)); err != nil {
+				a.backup.recErr = err.Error()
+				return
+			}
+			a.backup.recErr = ""
+		})
+	}()
