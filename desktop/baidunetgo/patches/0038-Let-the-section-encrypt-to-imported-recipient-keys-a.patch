+// generateBackupSignerNow checks the 生成新密钥对 dialog's fields and starts
+// the generation: a name, a passphrase of at least eight characters typed
+// twice alike; the email may stay empty.
+func (a *App) generateBackupSignerNow() {
+	b := &a.backup
+	name := strings.TrimSpace(b.genName)
+	if name == "" {
+		b.genErr = "请填写名称"
