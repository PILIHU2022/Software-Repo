+// TestBackupRunSigned signs every uploaded file with the generated signer:
+// DecryptAny verifies it against the signer and names who signed. The
+// default run stays unsigned.
+func TestBackupRunSigned(t *testing.T) {
+	backupTestDirs(t)
+	a, tt, srv := signedIn(t)
+	_, _, priv := backupTestKeys(t)
+	a.backup.signer, a.backup.signerPass, a.backup.signerRead = priv, "signpass1", true
+	a.backup.pass, a.backup.passSet, a.backup.passRead = "correct horse", true, true
+	local, files := backupLocalTree(t)
+	a.settings.Backup = backupSettings{
+		Dest:        "/备份",
+		Folders:     []backup.Folder{{Local: local}},
+		Encrypt:     true,
+		EncryptMode: backupModePassphrase,
+		Sign:        true,
+	}
+	a.applyBackupSettings()
+	a.runBackupNow()
+	waitBackupDone(t, tt, a)
+	if a.backup.lastErr != "" {
+		t.Fatalf("the run failed: %s", a.backup.lastErr)
+	}
+	base := "/备份/" + filepath.Base(local)
+	for name, content := range files {
+		remote := base + "/" + name + pgp.Suffix
+		if !srv.Exists(remote) {
+			t.Errorf("%s is not on the fake netdisk", remote)
+			continue
+		}
+		var out bytes.Buffer
+		vr, err := pgp.DecryptAny(&out, bytes.NewReader(srv.Data(remote)), "correct horse", []pgp.Key{priv})
+		if err != nil {
+			t.Errorf("DecryptAny(%s): %v", remote, err)
+			continue
+		}
+		if out.String() != content {
+			t.Errorf("%s decrypts to %q, want %q", remote, out.String(), content)
+		}
+		if !vr.Verified {
+			t.Errorf("%s is not verified", remote)
+		}
+		if vr.SignedByKeyID != priv.PrimaryKey.KeyId {
+			t.Errorf("%s signed by %X, want %X", remote, vr.SignedByKeyID, priv.PrimaryKey.KeyId)
+		}
+		if got, want := vr.SignedByName, keyName(priv); got != want {
+			t.Errorf("%s signed by %q, want %q", remote, got, want)
+		}
+	}
+
+	// A signed message opened without the signer's key does not verify.
+	var out bytes.Buffer
+	if _, err := pgp.DecryptAny(&out, bytes.NewReader(srv.Data(base+"/"+filepath.FromSlash("a.txt")+pgp.Suffix)), "correct horse", nil); err == nil {
+		t.Error("a signed message verified with no signer key given")
+	}
+
+	// The default run carries no signature.
+	a.settings.Backup.Sign = false
+	a.applyBackupSettings()
+	local2 := t.TempDir()
+	if err := os.WriteFile(filepath.Join(local2, "d.txt"), []byte("第四个文件"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	a.settings.Backup.Folders = []backup.Folder{{Local: local2}}
+	a.applyBackupSettings()
+	a.runBackupNow()
+	waitBackupDone(t, tt, a)
+	if a.backup.lastErr != "" {
+		t.Fatalf("the unsigned run failed: %s", a.backup.lastErr)
+	}
+	remote := "/备份/" + filepath.Base(local2) + "/d.txt" + pgp.Suffix
+	var out2 bytes.Buffer
+	vr, err := pgp.DecryptAny(&out2, bytes.NewReader(srv.Data(remote)), "correct horse", nil)
+	if err != nil {
+		t.Fatalf("DecryptAny(%s): %v", remote, err)
+	}
+	if vr.SignedByKeyID != 0 {
+		t.Errorf("the default run signed by %X, want unsigned", vr.SignedByKeyID)
+	}
+}
