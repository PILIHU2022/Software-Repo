+// TestBackupRecipientsManage adds a recipient through the file chooser's
+// stand-in, deduplicates it, rejects a private key, and removes it again,
+// checking that backup-recipients.asc follows each change.
+func TestBackupRecipientsManage(t *testing.T) {
+	_, stateDir := backupTestDirs(t)
+	public, private, _ := backupTestKeys(t)
+	keyFile := filepath.Join(t.TempDir(), "pub.asc")
+	if err := os.WriteFile(keyFile, []byte(public), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	old := backupPickKeyFile
+	backupPickKeyFile = func(*App) (string, error) { return keyFile, nil }
+	t.Cleanup(func() { backupPickKeyFile = old })
+
+	a, tt, _ := signedIn(t)
+	a.pickBackupRecipientFile()
+	waitUntil(t, tt, "the recipient added", func() bool {
+		return len(a.backup.recipients) == 1 && a.backup.recErr == ""
+	})
+	if got := keyName(a.backup.recipients[0]); got != "备份测试 <backup@example.com>" {
+		t.Errorf("recipient name %q, want the key's identity", got)
+	}
+
+	// The same key again is no second recipient; the armored file keeps one
+	// block, 0600.
+	if added, err := a.addBackupRecipients(public); err != nil || added != 0 {
+		t.Errorf("adding the same key again = %d added, %v, want none", added, err)
+	}
+	if len(a.backup.recipients) != 1 {
+		t.Fatalf("%d recipients after a duplicate, want 1", len(a.backup.recipients))
+	}
+	recPath := filepath.Join(stateDir, "backup-recipients.asc")
+	waitUntil(t, tt, "the recipients file", func() bool {
+		fi, err := os.Stat(recPath)
+		return err == nil && fi.Mode().Perm() == 0o600
+	})
+	data, _ := os.ReadFile(recPath)
+	if strings.Count(string(data), "BEGIN PGP PUBLIC KEY BLOCK") != 1 {
+		t.Errorf("recipients file keeps %d blocks, want 1: %s",
+			strings.Count(string(data), "BEGIN PGP PUBLIC KEY BLOCK"), data)
+	}
+
+	// A private key is refused with a message.
+	a.backup.recErr = ""
+	_, err := a.addBackupRecipients(private)
+	if err == nil || len(a.backup.recipients) != 1 {
+		t.Fatalf("a private key was %v, want an error", err)
+	}
+	if !strings.Contains(err.Error(), "私钥") {
+		t.Errorf("the private key refusal says %q, want it to name 私钥", err.Error())
+	}
+
+	// Removing the recipient rewrites the file empty and drops nothing else.
+	a.removeBackupRecipient(0)
+	waitUntil(t, tt, "the recipient removed", func() bool {
+		return len(a.backup.recipients) == 0
+	})
+	waitUntil(t, tt, "the emptied file", func() bool {
+		data, err := os.ReadFile(recPath)
+		return err == nil && !strings.Contains(string(data), "BEGIN PGP PUBLIC KEY BLOCK")
+	})
+}
