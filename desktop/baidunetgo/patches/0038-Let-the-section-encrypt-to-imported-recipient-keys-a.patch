+// shortKeyID formats the last 8 hex digits of a key's ID, as gpg shows the
+// short form of a long key ID.
+func shortKeyID(id uint64) string {
+	return fmt.Sprintf("%08X", id&0xFFFFFFFF)
+}
+
+// keyName is a key's primary identity, "Name <email>", or its short key ID
+// when the key names nobody.
+func keyName(k pgp.Key) string {
+	if k == nil {
+		return ""
+	}
+	if id := k.PrimaryIdentity(); id != nil && id.Name != "" {
+		return id.Name
+	}
+	return shortKeyID(k.PrimaryKey.KeyId)
+}
+
+// splitArmoredBlocks splits concatenated armored public-key blocks, keeping
+// each one whole; anything before, between or after them is dropped.
+func splitArmoredBlocks(text string) []string {
+	const begin = "-----BEGIN PGP PUBLIC KEY BLOCK-----"
+	const end = "-----END PGP PUBLIC KEY BLOCK-----"
+	var out []string
+	for {
+		i := strings.Index(text, begin)
+		if i < 0 {
+			break
+		}
+		j := strings.Index(text[i:], end)
+		if j < 0 {
+			break
+		}
+		j += i + len(end)
+		out = append(out, strings.TrimSpace(text[i:j]))
+		text = text[j:]
+	}
+	return out
+}
+
+// recipientsFromArmored parses the armored public-key blocks of text: the
+// keys in them, deduplicated by key ID, and the kept blocks joined back
+// together, ready for the recipients file. A block holding a private key, or
+// one that does not parse, rejects the whole text with a message for the
+// user.
+func recipientsFromArmored(text string) ([]pgp.Key, string, error) {
+	if strings.Contains(text, "-----BEGIN PGP PRIVATE KEY BLOCK-----") {
+		return nil, "", errors.New("这是私钥：收件人需要公钥，请用 gpg --armor --export 导出后再添加")
+	}
+	blocks := splitArmoredBlocks(text)
+	if len(blocks) == 0 {
+		return nil, "", errors.New("没有找到 OpenPGP 公钥块（-----BEGIN PGP PUBLIC KEY BLOCK-----）")
+	}
+	var keys []pgp.Key
+	var kept []string
+	seen := map[uint64]bool{}
+	for _, block := range blocks {
+		ks, err := pgp.ReadPublicKeys(strings.NewReader(block))
+		if err != nil {
+			return nil, "", fmt.Errorf("无法识别的密钥：%v", err)
+		}
+		for _, k := range ks {
+			if k.PrivateKey != nil {
+				return nil, "", errors.New("这是私钥：收件人需要公钥，请用 gpg --armor --export 导出后再添加")
+			}
+		}
+		added := false
+		for _, k := range ks {
+			if !seen[k.PrimaryKey.KeyId] {
+				seen[k.PrimaryKey.KeyId] = true
+				keys = append(keys, k)
+				added = true
+			}
+		}
+		if added {
+			kept = append(kept, block)
+		}
+	}
+	return keys, strings.Join(kept, "\n\n"), nil
+}
+
+// loadBackupRecipients reads and parses the recipients file; a missing,
+// unreadable or corrupt one is no recipients at all.
+func loadBackupRecipients(dir string) ([]pgp.Key, string) {
+	data, err := os.ReadFile(filepath.Join(dir, backupRecipientsFile))
+	if err != nil {
+		return nil, ""
+	}
+	keys, raw, err := recipientsFromArmored(string(data))
+	if err != nil {
+		return nil, ""
+	}
+	return keys, raw
+}
+
+// loadBackupSigner reads the signer's armored private key, parsed without
+// unlocking it — enough to name the key, signing unlocks it with the sealed
+// passphrase. A missing or unreadable one is no signer.
+func loadBackupSigner(dir string) pgp.Key {
+	data, err := os.ReadFile(filepath.Join(dir, backupSignerFile))
+	if err != nil {
+		return nil
+	}
+	// ReadPublicKeys parses private blocks too, which is what this file
+	// holds; a private key among them is the signer.
+	keys, err := pgp.ReadPublicKeys(bytes.NewReader(data))
+	if err != nil {
+		return nil
+	}
+	for _, k := range keys {
+		if k.PrivateKey != nil {
+			return k
+		}
+	}
+	return nil
+}
+
+// addBackupRecipients adds the armored public-key blocks of text to the
+// recipients, deduplicating by key ID. It reports how many keys were new.
+// The file is rewritten on a goroutine.
+func (a *App) addBackupRecipients(text string) (int, error) {
+	b := &a.backup
+	keys, raw, err := recipientsFromArmored(b.recRaw + "\n" + text)
+	if err != nil {
+		return 0, err
+	}
+	dir := a.backupDir()
+	if dir == "" {
+		return 0, errors.New("无法保存收件人：找不到应用的数据目录")
+	}
+	added := len(keys) - len(b.recipients)
+	b.recipients, b.recRaw = keys, raw
+	go func() {
+		if err := writeBackupKeyFile(dir, backupRecipientsFile, raw); err != nil {
+			log.Printf("backup: recipients: %v", err)
+			a.update(func() { a.toast("无法保存收件人密钥："+err.Error(), "error") })
+		}
+	}()
+	return added, nil
+}
+
+// removeBackupRecipient takes the recipient at i out of the recipients and
+// rewrites the recipients file without its block, on a goroutine. A block
+// that holds several keys goes away with the one removed.
+func (a *App) removeBackupRecipient(i int) {
+	b := &a.backup
+	if i < 0 || i >= len(b.recipients) {
+		return
+	}
+	id := b.recipients[i].PrimaryKey.KeyId
+	var kept []string
+	for _, block := range splitArmoredBlocks(b.recRaw) {
+		ks, err := pgp.ReadPublicKeys(strings.NewReader(block))
+		if err != nil {
+			continue
+		}
+		drop := false
+		for _, k := range ks {
+			if k.PrimaryKey.KeyId == id {
+				drop = true
+			}
+		}
+		if !drop {
+			kept = append(kept, block)
+		}
+	}
+	raw := strings.Join(kept, "\n\n")
+	keys, _, err := recipientsFromArmored(raw)
+	if err != nil {
+		keys, raw = nil, ""
+	}
+	b.recipients, b.recRaw = keys, raw
+	if dir := a.backupDir(); dir != "" {
+		go func() {
+			if err := writeBackupKeyFile(dir, backupRecipientsFile, raw); err != nil {
+				log.Printf("backup: recipients: %v", err)
+			}
+		}()
+	}
+}
+
+// importBackupSigner verifies the armored private key of sigFile with pass
+// and makes it the signer: the key file and the sealed passphrase are
+// written on a goroutine, the caches are set at once so this session's runs
+// can sign.
+func (a *App) importBackupSigner(text, pass string) error {
+	key, err := pgp.ReadPrivateKey(strings.NewReader(text), pass)
+	if err != nil {
+		switch {
+		case errors.Is(err, pgp.ErrNotPrivateKey):
+			err = errors.New("这不是私钥：签名密钥需要私钥块（-----BEGIN PGP PRIVATE KEY BLOCK-----）")
+		case errors.Is(err, pgp.ErrPassphrase):
+			err = errors.New("密码不对，这把私钥解不开")
+		default:
+			err = fmt.Errorf("无法识别的密钥：%v", err)
+		}
+		return err
+	}
+	dir := a.backupDir()
+	if dir == "" {
+		return errors.New("无法保存签名密钥：找不到应用的数据目录")
+	}
+	b := &a.backup
+	b.signer, b.signerPass = key, pass
+	go func() {
+		if err := writeBackupKeyFile(dir, backupSignerFile, strings.TrimSpace(text)); err != nil {
+			a.update(func() { a.toast("无法保存签名密钥："+err.Error(), "error") })
+			return
+		}
+		if err := writeBackupSignerPass(dir, a.backupKeyring(), pass); err != nil {
+			a.update(func() { a.toast("无法保存签名密钥密码："+err.Error(), "error") })
+		}
+	}()
+	return nil
+}
+
+// removeBackupSigner forgets the signer: the key file is deleted and the
+// sealed passphrase cleared, both on a goroutine, and signing turns off.
+func (a *App) removeBackupSigner() {
+	b := &a.backup
+	b.signer, b.signerPass = nil, ""
+	b.sigErr = ""
+	if a.settings.Backup.Sign {
+		a.settings.Backup.Sign = false
+		a.applyBackupSettings()
+	}
+	if dir := a.backupDir(); dir != "" {
+		go func() {
+			if err := removeBackupKeyFile(dir, backupSignerFile); err != nil {
+				log.Printf("backup: signer: %v", err)
+				return
+			}
+			if err := writeBackupSignerPass(dir, a.backupKeyring(), ""); err != nil {
+				log.Printf("backup: signer passphrase: %v", err)
+			}
+		}()
+	}
+}
+
+// generateBackupSigner makes a fresh key pair for signing, after the dialog
+// checked its fields. It runs pgp.GenerateKeyPair on a goroutine — it takes
+// a few seconds — then saves the private half as the signer, seals the
+// passphrase, and offers the public half for copying and saving.
+func (a *App) generateBackupSigner(name, email, pass string) {
+	b := &a.backup
+	dir := a.backupDir()
+	if dir == "" {
+		b.genErr, b.genBusy = "无法保存签名密钥：找不到应用的数据目录", false
+		return
+	}
+	b.genBusy = true
+	go func() {
+		public, private, err := pgp.GenerateKeyPair(name, email, pass)
+		a.update(func() {
+			b.genBusy = false
+			if err != nil {
+				b.genErr = "生成密钥失败：" + err.Error()
+				return
+			}
+			if err := writeBackupKeyFile(dir, backupSignerFile, private); err != nil {
+				b.genErr = "无法保存签名密钥：" + err.Error()
+				return
+			}
+			if err := writeBackupSignerPass(dir, a.backupKeyring(), pass); err != nil {
+				b.genErr = "无法保存签名密钥密码：" + err.Error()
+				return
+			}
+			b.signer = loadBackupSigner(dir)
+			b.signerPass = pass
+			b.genErr = ""
+			b.sigGenOpen = false
+			b.genPublic = public
+			b.genPublicOpen = true
+		})
+	}()
+}
+
+// saveBackupPublic asks where to save the generated public half and writes
+// it there, 0644 — a public key is no secret.
+func (a *App) saveBackupPublic() {
+	b := &a.backup
+	public := b.genPublic
+	go func() {
+		p, err := backupSaveKeyFile(a, "baidunetgo-backup公钥.asc")
+		if err != nil || p == "" {
+			return
+		}
+		if err := os.WriteFile(p, []byte(public), 0o644); err != nil {
+			a.update(func() { a.toast("无法保存公钥："+err.Error(), "error") })
+			return
+		}
+		a.update(func() { a.toast("公钥已保存", "success") })
+	}()
+}
