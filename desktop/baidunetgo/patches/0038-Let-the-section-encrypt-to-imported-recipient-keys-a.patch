+// TestBackupRunKeysMode backs a tree up encrypted to a recipient's public
+// key only: the uploaded files decrypt with the recipient's private half,
+// and carry no signature.
+func TestBackupRunKeysMode(t *testing.T) {
+	backupTestDirs(t)
+	a, tt, srv := signedIn(t)
+	public, _, priv := backupTestKeys(t)
+	if _, err := a.addBackupRecipients(public); err != nil {
+		t.Fatalf("add recipient: %v", err)
+	}
+	local, files := backupLocalTree(t)
+	a.settings.Backup = backupSettings{
+		Dest:        "/备份",
+		Folders:     []backup.Folder{{Local: local}},
+		Encrypt:     true,
+		EncryptMode: backupModeKeys,
+	}
+	a.applyBackupSettings()
+	a.runBackupNow()
+	waitBackupDone(t, tt, a)
+	if a.backup.lastErr != "" {
+		t.Fatalf("the run failed: %s", a.backup.lastErr)
+	}
+	if a.backup.uploaded != len(files) {
+		t.Fatalf("%d uploaded, want %d", a.backup.uploaded, len(files))
+	}
+	base := "/备份/" + filepath.Base(local)
+	for name, content := range files {
+		remote := base + "/" + name + pgp.Suffix
+		if !srv.Exists(remote) {
+			t.Errorf("%s is not on the fake netdisk", remote)
+			continue
+		}
+		var out bytes.Buffer
+		vr, err := pgp.DecryptAny(&out, bytes.NewReader(srv.Data(remote)), "", []pgp.Key{priv})
+		if err != nil {
+			t.Errorf("DecryptAny(%s): %v", remote, err)
+			continue
+		}
+		if out.String() != content {
+			t.Errorf("%s decrypts to %q, want %q", remote, out.String(), content)
+		}
+		if !vr.Verified || vr.SignedByKeyID != 0 {
+			t.Errorf("%s = verified %v by %d, want unsigned", remote, vr.Verified, vr.SignedByKeyID)
+		}
+		// The passphrase alone must not open a keys-only message.
+		var ignore bytes.Buffer
+		if _, err := pgp.DecryptAny(&ignore, bytes.NewReader(srv.Data(remote)), "correct horse", nil); err == nil {
+			t.Errorf("%s opened with the backup passphrase alone", remote)
+		}
+	}
+}
