+// themeFontSize converts a point size to DIP (1pt ≈ 4/3 DIP at 96dpi),
+// then clamps it so a very small or huge fontconfig setting stays usable.
+func themeFontSize(pt float32) float32 {
+	dip := float32(math.Round(float64(pt) * 4 / 3))
+	return min(max(dip, 11), 17)
+}
