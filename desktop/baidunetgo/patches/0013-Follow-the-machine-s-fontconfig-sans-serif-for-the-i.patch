+//go:build linux
+
+package fontconfig
+
+import (
+	"context"
+	"os/exec"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// timeout bounds fc-match: it answers at once, so a longer wait only
+// delays a frame.
+const timeout = 500 * time.Millisecond
+
+// fcMatch is the program detection runs. Tests point it at a fake
+// script; the PATH is searched when it holds a bare name.
+var fcMatch = "fc-match"
+
+// result is what fc-match said once; a zero result means none.
+type result struct {
+	family  string
+	size    float32
+	hasSize bool
+}
+
+var (
+	once   sync.Once
+	cached result
+)
+
+// detect runs fc-match for the default sans-serif and parses its family
+// and size. It runs at most once per process, as detection is cached.
+func detect() result {
+	once.Do(func() {
+		ctx, cancel := context.WithTimeout(context.Background(), timeout)
+		defer cancel()
+		out, err := exec.CommandContext(ctx, fcMatch, "-f", "%{family[0]}\n%{size}\n", "sans-serif").Output()
+		if err != nil {
+			return
+		}
+		cached = parse(string(out))
+	})
+	return cached
+}
+
+// parse reads the family from the first line and the size from the
+// second, ignoring anything unusable.
+func parse(out string) result {
+	lines := strings.Split(strings.ReplaceAll(out, "\r\n", "\n"), "\n")
+	var r result
+	if len(lines) > 0 {
+		r.family = cleanFamily(lines[0])
+	}
+	if len(lines) > 1 {
+		if pt, err := strconv.ParseFloat(strings.TrimSpace(lines[1]), 32); err == nil && pt > 0 {
+			r.size, r.hasSize = float32(pt), true
+		}
+	}
+	if r.family == "" {
+		return result{}
+	}
+	return r
+}
+
+// cleanFamily drops the emptiness and placeholders fc-match can print in
+// place of a real family.
+func cleanFamily(s string) string {
+	s = strings.TrimSpace(s)
+	switch {
+	case s == "", s == "-", strings.EqualFold(s, "system"), strings.EqualFold(s, "sans-serif"):
+		return ""
+	}
+	return s
+}
+
+// Family is the default sans-serif family fontconfig resolves, or "".
+func Family() string { return detect().family }
+
+// Size is that family's size in points, and whether fontconfig gave one.
+func Size() (float32, bool) {
+	r := detect()
+	return r.size, r.hasSize
+}
+
+// Detected describes the detected font for the interface, as
+// "霞鹜文楷 屏幕阅读版 12pt", or "" when nothing was found.
+func Detected() string {
+	r := detect()
+	if r.family == "" {
+		return ""
+	}
+	if r.hasSize {
+		return r.family + " " + strconv.FormatFloat(float64(r.size), 'f', -1, 32) + "pt"
+	}
+	return r.family
+}
