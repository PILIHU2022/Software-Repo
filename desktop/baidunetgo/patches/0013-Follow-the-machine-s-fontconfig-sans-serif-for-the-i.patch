+//go:build linux
+
+package fontconfig
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// fakeFc points detection at a shell script that prints body, and clears
+// the cache so the test sees this script.
+func fakeFc(t *testing.T, body string) {
+	t.Helper()
+	dir := t.TempDir()
+	p := filepath.Join(dir, "fc-match")
+	script := "#!/bin/sh\n" + body + "\n"
+	if err := os.WriteFile(p, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	old := fcMatch
+	fcMatch = p
+	once = sync.Once{}
+	cached = result{}
+	t.Cleanup(func() {
+		fcMatch = old
+		once = sync.Once{}
+		cached = result{}
+	})
+}
+
+// TestDetectParses checks the normal answer: a family on the first line
+// and a point size on the second.
+func TestDetectParses(t *testing.T) {
+	fakeFc(t, `printf '霞鹜文楷 屏幕阅读版\n12\n'`)
+	if got := Family(); got != "霞鹜文楷 屏幕阅读版" {
+		t.Errorf("Family() = %q", got)
+	}
+	if pt, ok := Size(); !ok || pt != 12 {
+		t.Errorf("Size() = %v, %v", pt, ok)
+	}
+	if got := Detected(); got != "霞鹜文楷 屏幕阅读版 12pt" {
+		t.Errorf("Detected() = %q", got)
+	}
+}
+
+// TestDetectEmpty checks that no output means no font, not a panic.
+func TestDetectEmpty(t *testing.T) {
+	fakeFc(t, `exit 0`)
+	if got := Family(); got != "" {
+		t.Errorf("Family() = %q", got)
+	}
+	if _, ok := Size(); ok {
+		t.Error("Size() said it had a size")
+	}
+	if got := Detected(); got != "" {
+		t.Errorf("Detected() = %q", got)
+	}
+}
+
+// TestDetectFailure checks a failing fc-match: empty, silently.
+func TestDetectFailure(t *testing.T) {
+	fakeFc(t, `exit 1`)
+	if got := Family(); got != "" {
+		t.Errorf("Family() = %q", got)
+	}
+	if _, ok := Size(); ok {
+		t.Error("Size() said it had a size")
+	}
+}
+
+// TestDetectTimeout checks that an fc-match that never answers is cut off
+// by the timeout and leaves no font rather than hanging.
+func TestDetectTimeout(t *testing.T) {
+	fakeFc(t, `exec sleep 5`) // exec, so the timeout kills it rather than a shell
+	start := time.Now()
+	if got := Family(); got != "" {
+		t.Errorf("Family() = %q", got)
+	}
+	if _, ok := Size(); ok {
+		t.Error("Size() said it had a size")
+	}
+	if d := time.Since(start); d > 3*time.Second {
+		t.Errorf("detection took %v, want about the timeout", d)
+	}
+}
+
+// TestDetectNonNumericSize checks that an unparseable size line keeps the
+// family but reports no size.
+func TestDetectNonNumericSize(t *testing.T) {
+	fakeFc(t, `printf 'Some Font\nnot-a-number\n'`)
+	if got := Family(); got != "Some Font" {
+		t.Errorf("Family() = %q", got)
+	}
+	if _, ok := Size(); ok {
+		t.Error("Size() said it had a size")
+	}
+	if got := Detected(); got != "Some Font" {
+		t.Errorf("Detected() = %q", got)
+	}
+}
+
+// TestDetectZeroSize checks that a zero size is treated as none.
+func TestDetectZeroSize(t *testing.T) {
+	fakeFc(t, `printf 'Some Font\n0\n'`)
+	if _, ok := Size(); ok {
+		t.Error("Size() said it had a size")
+	}
+}
+
+// TestDetectFiltersPlaceholder checks that a placeholder family such as
+// "System" is dropped along with its size.
+func TestDetectFiltersPlaceholder(t *testing.T) {
+	for _, fam := range []string{"System", "system", "-", "  "} {
+		fakeFc(t, "printf '"+strings.ReplaceAll(fam, "'", `\'`)+"\n12\n'")
+		if got := Family(); got != "" {
+			t.Errorf("Family() = %q for placeholder %q", got, fam)
+		}
+		if _, ok := Size(); ok {
+			t.Errorf("Size() said it had a size for placeholder %q", fam)
+		}
+	}
+}
+
+// TestDetectCached checks that detection runs once: the script counts its
+// calls, and changing the answer without clearing the cache is ignored.
+func TestDetectCached(t *testing.T) {
+	dir := t.TempDir()
+	counter := filepath.Join(dir, "count")
+	p := filepath.Join(dir, "fc-match")
+	script := "#!/bin/sh\necho x >> " + counter + "\nprintf 'Cached Font\\n11\\n'\n"
+	if err := os.WriteFile(p, []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	old := fcMatch
+	fcMatch = p
+	once = sync.Once{}
+	cached = result{}
+	t.Cleanup(func() {
+		fcMatch = old
+		once = sync.Once{}
+		cached = result{}
+	})
+	for i := 0; i < 3; i++ {
+		Family()
+		Size()
+		Detected()
+	}
+	data, err := os.ReadFile(counter)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := strings.Count(string(data), "x"); n != 1 {
+		t.Errorf("fc-match ran %d times, want once", n)
+	}
+}
