+package app
+
+import (
+	"os"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+)
+
+// TestMain pins the built-in font for the rest of the app tests, which
+// were written and measured with 13 DIP: a machine whose fontconfig picks
+// another face then lays every page out as it did before. The font tests
+// unset these and stand in for fc-match themselves.
+func TestMain(m *testing.M) {
+	os.Setenv("BAIDUNETGO_FONT", "-")
+	os.Setenv("BAIDUNETGO_FONT_SIZE", "13")
+	os.Exit(m.Run())
+}
+
+// clearFontEnv drops the font overrides for one test and restores them
+// after it, so the built-in defaults in TestMain do not hide detection.
+func clearFontEnv(t *testing.T) {
+	t.Helper()
+	for _, k := range []string{"BAIDUNETGO_FONT", "BAIDUNETGO_FONT_SIZE"} {
+		v, ok := os.LookupEnv(k)
+		if ok {
+			t.Cleanup(func() { os.Setenv(k, v) })
+		} else {
+			t.Cleanup(func() { os.Unsetenv(k) })
+		}
+		os.Unsetenv(k)
+	}
+}
+
+// stubFont makes detection report fam at pt (or nothing) for one test.
+func stubFont(t *testing.T, fam string, pt float32, hasSize bool) {
+	t.Helper()
+	oldFamily, oldSize, oldDetected := fcFamily, fcSize, fcDetected
+	fcFamily = func() string { return fam }
+	fcSize = func() (float32, bool) { return pt, hasSize }
+	fcDetected = func() string {
+		if fam == "" {
+			return ""
+		}
+		if hasSize {
+			return fam + " " + strconv.FormatFloat(float64(pt), 'f', -1, 32) + "pt"
+		}
+		return fam
+	}
+	t.Cleanup(func() { fcFamily, fcSize, fcDetected = oldFamily, oldSize, oldDetected })
+}
+
+// TestFollowSystemFontOn checks that, by default, the theme takes the
+// detected family and the size converted from points to DIP.
+func TestFollowSystemFontOn(t *testing.T) {
+	clearFontEnv(t)
+	stubFont(t, "测试字体", 12, true)
+	a := New()
+	if fam, size := a.resolvedFont(); fam != "测试字体" || size != 16 {
+		t.Fatalf("resolved %q %v, want 测试字体 16", fam, size)
+	}
+	tt := ui.NewTester(a.View, 640, 420)
+	tt.Advance(50 * time.Millisecond)
+	if lightTheme.Font != "测试字体" || lightTheme.FontSize != 16 {
+		t.Errorf("theme font %q at %v, want 测试字体 at 16", lightTheme.Font, lightTheme.FontSize)
+	}
+}
+
+// TestFollowSystemFontOff checks that turning the setting off restores the
+// built-in 13 DIP and no family.
+func TestFollowSystemFontOff(t *testing.T) {
+	clearFontEnv(t)
+	stubFont(t, "测试字体", 12, true)
+	a := New()
+	off := false
+	a.settings.FollowSystemFont = &off
+	if fam, size := a.resolvedFont(); fam != "" || size != 13 {
+		t.Fatalf("resolved %q %v, want the built-in \"\" 13", fam, size)
+	}
+	tt := ui.NewTester(a.View, 640, 420)
+	tt.Advance(50 * time.Millisecond)
+	if lightTheme.Font != "" || lightTheme.FontSize != 13 {
+		t.Errorf("theme font %q at %v, want built-in \"\" at 13", lightTheme.Font, lightTheme.FontSize)
+	}
+}
+
+// TestFontSizeEnvOverride checks that BAIDUNETGO_FONT_SIZE wins over the
+// converted size.
+func TestFontSizeEnvOverride(t *testing.T) {
+	clearFontEnv(t)
+	stubFont(t, "测试字体", 12, true)
+	t.Setenv("BAIDUNETGO_FONT_SIZE", "15")
+	a := New()
+	if fam, size := a.resolvedFont(); fam != "测试字体" || size != 15 {
+		t.Fatalf("resolved %q %v, want 测试字体 15", fam, size)
+	}
+}
+
+// TestFontFamilyEnvOverride checks that BAIDUNETGO_FONT wins over the
+// detected family, and "-" forces the built-in one.
+func TestFontFamilyEnvOverride(t *testing.T) {
+	clearFontEnv(t)
+	stubFont(t, "测试字体", 12, true)
+	t.Setenv("BAIDUNETGO_FONT", "自定义字体")
+	a := New()
+	if fam, _ := a.resolvedFont(); fam != "自定义字体" {
+		t.Fatalf("resolved family %q, want 自定义字体", fam)
+	}
+	t.Setenv("BAIDUNETGO_FONT", "-")
+	if fam, size := a.resolvedFont(); fam != "" || size != 16 {
+		t.Errorf("forced system: %q %v, want \"\" 16", fam, size)
+	}
+}
+
+// TestFontSizeClamped checks the point-to-DIP conversion's bounds: tiny
+// sizes rise to 11 and huge ones fall to 17.
+func TestFontSizeClamped(t *testing.T) {
+	cases := map[float32]float32{6: 11, 9: 12, 12: 16, 14: 17, 24: 17}
+	for pt, want := range cases {
+		if got := themeFontSize(pt); got != want {
+			t.Errorf("themeFontSize(%v) = %v, want %v", pt, got, want)
+		}
+	}
+}
+
+// TestFontDetectionFailureFallback checks that a failed detection keeps
+// the built-in font and draws without panicking.
+func TestFontDetectionFailureFallback(t *testing.T) {
+	clearFontEnv(t)
+	stubFont(t, "", 0, false)
+	a := New()
+	if fam, size := a.resolvedFont(); fam != "" || size != 13 {
+		t.Fatalf("resolved %q %v after a failed detection, want \"\" 13", fam, size)
+	}
+	tt := ui.NewTester(a.View, 640, 420)
+	tt.Advance(50 * time.Millisecond)
+	if lightTheme.Font != "" || lightTheme.FontSize != 13 {
+		t.Errorf("theme %q at %v after a failed detection", lightTheme.Font, lightTheme.FontSize)
+	}
+}
+
+// TestFollowSystemFontSetting flips the switch on the settings page and
+// checks that the choice takes effect at once.
+func TestFollowSystemFontSetting(t *testing.T) {
+	clearFontEnv(t)
+	stubFont(t, "测试字体", 12, true)
+	a, tt, _ := signedIn(t)
+	a.router.Replace("/settings")
+	tt.Advance(300 * time.Millisecond)
+	sw, ok := tt.AccessByRole(ui.RoleSwitch, "跟随系统字体")
+	if !ok {
+		t.Fatalf("no 跟随系统字体 switch; texts %q", tt.Texts())
+	}
+	if a.settings.followSystemFont() != true {
+		t.Fatal("not following by default")
+	}
+	b := sw.Bounds
+	tt.ClickAt(b.X+b.W/2, b.Y+b.H/2)
+	tt.Advance(300 * time.Millisecond)
+	if a.settings.FollowSystemFont == nil || *a.settings.FollowSystemFont {
+		t.Fatalf("setting after the click is %v, want false", a.settings.FollowSystemFont)
+	}
+	if fam, size := a.resolvedFont(); fam != "" || size != 13 {
+		t.Errorf("resolved %q %v after turning it off, want \"\" 13", fam, size)
+	}
+	// And back on.
+	sw, ok = tt.AccessByRole(ui.RoleSwitch, "跟随系统字体")
+	if !ok {
+		t.Fatal("the switch vanished")
+	}
+	b = sw.Bounds
+	tt.ClickAt(b.X+b.W/2, b.Y+b.H/2)
+	tt.Advance(300 * time.Millisecond)
+	if !a.settings.followSystemFont() {
+		t.Error("turning it back on did not take")
+	}
+	if fam, size := a.resolvedFont(); fam != "测试字体" || size != 16 {
+		t.Errorf("resolved %q %v after turning it on, want 测试字体 16", fam, size)
+	}
+}
+
+// TestFontFollowSnapshot draws the settings page following the machine's
+// real fontconfig, for a look at the glyphs and line height.
+func TestFontFollowSnapshot(t *testing.T) {
+	clearFontEnv(t)
+	a, tt, _ := signedIn(t)
+	a.router.Replace("/settings")
+	tt.Advance(500 * time.Millisecond)
+	save(t, tt, "font-follow")
+}
