+
+// marqueeFrom presses at a and drags the pointer to each point of to in
+// order, a few frames apart, leaving the button pressed: the caller
+// releases. The points may leave the list and the window.
+func marqueeFrom(tt *ui.Tester, a ui.Point, to ...ui.Point) {
+	tt.Press(a.X, a.Y)
+	tt.Frame()
+	dragThrough(tt, a, to...)
+}
+
+// dragThrough moves the pointer, already pressed, through to in order.
+func dragThrough(tt *ui.Tester, from ui.Point, to ...ui.Point) {
+	for _, p := range to {
+		for i := 1; i <= 6; i++ {
+			f := float32(i) / 6
+			tt.Move(lerp(from.X, p.X, f), lerp(from.Y, p.Y, f))
+			tt.Frame()
+		}
+		from = p
+	}
+}
+
+// chosen reports whether the listing chose exactly ids.
+func chosen(l *listing, ids ...int64) bool {
+	if l.sel.Len() != len(ids) {
+		return false
+	}
+	for _, id := range ids {
+		if !l.sel.Has(id) {
+			return false
+		}
+	}
+	return true
+}
+
+func ids(files []baidu.File) []int64 {
+	out := make([]int64, len(files))
+	for i, f := range files {
+		out[i] = f.FsID
+	}
+	return out
+}
+
+// TestMarqueeBeyondListBottom drags the band across the last three rows of
+// the list from the blank strip at its right edge, keeps going out of the
+// list's bottom, and says the choice stays the three rows while the box
+// stops at the list's edge, and the release keeps them.
+func TestMarqueeBeyondListBottom(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	n := len(l.files)
+	if n < 4 {
+		t.Fatalf("need a few rows, have %d", n)
+	}
+	area := l.dragArea
+	last3 := l.files[n-3:]
+	top := l.rowRects[last3[0].FsID].Y + 2 // the third from last row
+	start := ui.Point{X: area.X + area.W - 2, Y: top}
+	inside := ui.Point{X: area.X + 540, Y: top}
+	marqueeFrom(tt, start, inside, ui.Point{X: inside.X, Y: area.Y + area.H + 200})
+	if !l.dragOn {
+		t.Fatalf("the drag ended at the list's bottom")
+	}
+	if !chosen(l, ids(last3)...) {
+		t.Fatalf("beyond the bottom chose %d, want the last three rows", l.sel.Len())
+	}
+	if got := l.dragRect.Y + l.dragRect.H; got != area.Y+area.H {
+		t.Errorf("the box stops at y=%v, want the list's bottom %v", got, area.Y+area.H)
+	}
+	if got := l.dragRect.X; got != inside.X {
+		t.Errorf("the box starts at x=%v, want %v", got, inside.X)
+	}
+	// Going on out of the list, and out of the window, changes nothing.
+	dragThrough(tt, inside, ui.Point{X: inside.X, Y: area.Y + area.H + 400})
+	if !chosen(l, ids(last3)...) {
+		t.Errorf("another 200 DIP beyond the bottom chose %d, want the same three", l.sel.Len())
+	}
+	// Back in the window to let go: the choice stays.
+	tt.Move(inside.X, 755)
+	tt.Frame()
+	tt.Release(inside.X, 755)
+	tt.Frame()
+	if l.dragOn || l.dragRect != (ui.Rect{}) {
+		t.Errorf("the band stayed after the release: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+	if !chosen(l, ids(last3)...) {
+		t.Errorf("the release kept %d chosen, want the last three rows", l.sel.Len())
+	}
+}
+
+// TestMarqueeBeyondListTop drags up out of the list's top after covering
+// three rows: the box stops at the list's top edge and the choice is what
+// that edge covers, and going on above it keeps both.
+func TestMarqueeBeyondListTop(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	n := len(l.files)
+	area := l.dragArea
+	start := ui.Point{X: area.X + 300, Y: area.Y + area.H - 12}
+	third := l.rowRects[l.files[n-3].FsID].Y + 2
+	marqueeFrom(tt, start, ui.Point{X: start.X, Y: third})
+	if !chosen(l, ids(l.files[n-3:])...) {
+		t.Fatalf("the box over the last three rows chose %d", l.sel.Len())
+	}
+	// Above the list's edge, in the title bar.
+	dragThrough(tt, ui.Point{X: start.X, Y: third}, ui.Point{X: start.X, Y: area.Y - 40})
+	if !l.dragOn {
+		t.Fatalf("the drag ended at the list's top")
+	}
+	if got := l.dragRect.Y; got != area.Y {
+		t.Errorf("the box stops at y=%v, want the list's top %v", got, area.Y)
+	}
+	if l.sel.Len() != n {
+		t.Errorf("above the top chose %d, want all %d rows the box covers", l.sel.Len(), n)
+	}
+	all := ids(l.files)
+	from := ui.Point{X: start.X, Y: area.Y - 40}
+	for _, y := range []float32{20, 5, area.Y - 100} {
+		dragThrough(tt, from, ui.Point{X: start.X, Y: y})
+		from = ui.Point{X: start.X, Y: y}
+		if !chosen(l, all...) || l.dragRect.Y != area.Y {
+			t.Errorf("moving on at y=%v chose %d, want the same rows with the box at the top", y, l.sel.Len())
+		}
+	}
+	tt.Release(start.X, 20)
+	tt.Frame()
+	if l.dragOn || l.dragRect != (ui.Rect{}) {
+		t.Errorf("the band stayed after a release over the title bar: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+	if !chosen(l, all...) {
+		t.Errorf("the release kept %d, want all %d rows", l.sel.Len(), n)
+	}
+}
