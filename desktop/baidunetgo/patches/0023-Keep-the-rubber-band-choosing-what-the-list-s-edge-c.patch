+		if id >= 0 && s.rect.W > 0 && (first == (ui.Rect{}) || s.rect.X < first.X) {
+			first = s.rect
+		}
+	}
+	if first == (ui.Rect{}) {
+		t.Fatal("no tiles in the grid")
+	}
+	start := ui.Point{X: area.X + area.W - 20, Y: first.Y + first.H/2}
+	across := ui.Point{X: area.X + 160, Y: start.Y}
+	out := ui.Point{X: across.X, Y: area.Y + area.H + 300}
+	marqueeFrom(tt, start, across, out)
+	if !l.dragOn {
+		t.Fatalf("the drag ended at the grid's bottom")
+	}
+	if !chosen(l, ids(l.files)...) {
+		t.Errorf("the box across the tiles chose %d, want all %d", l.sel.Len(), len(l.files))
+	}
+	if got := l.dragRect.Y + l.dragRect.H; got != area.Y+area.H {
+		t.Errorf("the box stops at y=%v, want the grid's bottom %v", got, area.Y+area.H)
+	}
+	// Farther down, even off the window, changes nothing.
+	dragThrough(tt, out, ui.Point{X: out.X, Y: area.Y + area.H + 500})
+	if !chosen(l, ids(l.files)...) {
+		t.Errorf("beyond the grid's bottom chose %d, want the same tiles", l.sel.Len())
+	}
+	tt.Move(across.X, 755)
+	tt.Frame()
+	tt.Release(across.X, 755)
+	tt.Frame()
+	if l.dragOn || l.dragRect != (ui.Rect{}) {
+		t.Errorf("the band stayed after the release: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+	if !chosen(l, ids(l.files)...) {
+		t.Errorf("the release kept %d, want the tiles crossed", l.sel.Len())
+	}
+}
+
+// TestMarqueeReleaseOutsideWindow drags over rows, leaves the window above
+// it and lets go there: the band still ends (the list knows its press went,
+// which no observer off the window could tell) and keeps the choice the
+// box's edge covered.
+func TestMarqueeReleaseOutsideWindow(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	n := len(l.files)
+	area := l.dragArea
+	start := ui.Point{X: area.X + 300, Y: area.Y + area.H - 12}
+	covered := ui.Point{X: start.X, Y: l.rowRects[l.files[3].FsID].Y + 2}
+	marqueeFrom(tt, start, covered)
+	if l.sel.Len() == 0 {
+		t.Fatalf("the box over the rows chose none")
+	}
+	// Above the window, where no release observer can be.
+	dragThrough(tt, covered, ui.Point{X: start.X, Y: -100})
+	if !l.dragOn {
+		t.Fatalf("the band ended while the pointer was above the window")
+	}
+	if l.dragRect.Y != area.Y {
+		t.Errorf("above the window the box starts at %v, want the list's top %v", l.dragRect.Y, area.Y)
+	}
+	if l.sel.Len() != n {
+		t.Errorf("above the window chose %d, want all %d rows the box covers", l.sel.Len(), n)
+	}
+	tt.Release(start.X, -100)
+	tt.Frame()
+	if l.dragOn || l.pressDown || l.dragRect != (ui.Rect{}) {
+		t.Errorf("a release above the window left the band: on=%v pressDown=%v rect=%v", l.dragOn, l.pressDown, l.dragRect)
+	}
+	if l.sel.Len() != n {
+		t.Errorf("the release kept %d, want %d rows", l.sel.Len(), n)
+	}
+}
