+
+// TestLayoutAtSizes renders the browser at the sizes a tiling window
+// manager can force it to, including below the window's own minimum, and
+// checks that nothing panics and that the parts that must stay reachable
+// do: the status bar's count, the upload button and the sidebar, which
+// folds itself away when the window is narrow and comes back when it
+// widens.
+func TestLayoutAtSizes(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	cases := []struct {
+		w, h    int
+		sidebar bool // the sidebar shows
+		kind    bool // the 种类 column shows
+		size    bool // the 大小 column shows
+		date    bool // the 修改日期 column shows
+		upload  bool
+	}{
+		{w: 1180, h: 760, sidebar: true, kind: true, size: true, date: true, upload: true},
+		{w: 780, h: 540, sidebar: true, kind: true, size: true, date: false, upload: true},
+		{w: 560, h: 480, sidebar: false, kind: true, size: true, date: false, upload: true},
+		{w: 460, h: 420, sidebar: false, kind: true, size: false, date: false, upload: true},
+		{w: 420, h: 300, sidebar: false, kind: true, size: false, date: false, upload: true},
+	}
+	for _, c := range cases {
+		tt.SetSize(c.w, c.h)
+		tt.Advance(500 * time.Millisecond)
+		if got := !a.sidebarCollapsed; got != c.sidebar {
+			t.Errorf("%dx%d: sidebar shows %v, want %v", c.w, c.h, got, c.sidebar)
+		}
+		// The count at the foot is the one thing that must never fall off.
+		if !tt.HasText("项") {
+			t.Errorf("%dx%d: no item count in the status bar; texts %q", c.w, c.h, tt.Texts())
+		}
+		if got := tt.HasText("种类"); got != c.kind {
+			t.Errorf("%dx%d: 种类 column %v, want %v", c.w, c.h, got, c.kind)
+		}
+		if got := tt.HasText("大小"); got != c.size {
+			t.Errorf("%dx%d: 大小 column %v, want %v", c.w, c.h, got, c.size)
+		}
+		// The header's "修改日期" and the grid's sort menu share the name,
+		// but only the list is shown here.
+		if got := tt.HasText("修改日期"); got != c.date {
+			t.Errorf("%dx%d: 修改日期 column %v, want %v", c.w, c.h, got, c.date)
+		}
+		// The upload folds to its icon: its label is still found, and lies
+		// inside the window.
+		r, ok := tt.Find("上传")
+		if ok != c.upload {
+			t.Errorf("%dx%d: upload found %v, want %v", c.w, c.h, ok, c.upload)
+		} else if ok && (r.X < 0 || r.X+r.W > float32(c.w) || r.Y < 0 || r.Y+r.H > float32(c.h)) {
+			t.Errorf("%dx%d: upload at %v is outside the window", c.w, c.h, r)
+		}
+		// The sidebar toggle is reachable at every size.
+		toggle := "隐藏侧栏"
+		if !c.sidebar {
+			toggle = "显示侧栏"
+		}
+		if _, ok := tt.Find(toggle); !ok {
+			t.Errorf("%dx%d: no sidebar toggle %q", c.w, c.h, toggle)
+		}
+		save(t, tt, "layout-"+itoa(c.w)+"x"+itoa(c.h))
+	}
+}
+
+// TestLayoutBelowMinimum renders the browser and the grid at sizes under
+// the window's minimum, which tiling can force: they must not panic.
+func TestLayoutBelowMinimum(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	for _, sz := range [][2]int{{400, 280}, {360, 240}} {
+		tt.SetSize(sz[0], sz[1])
+		tt.Advance(300 * time.Millisecond)
+		if !tt.HasText("项") {
+			t.Errorf("%dx%d: no item count; texts %q", sz[0], sz[1], tt.Texts())
+		}
+		save(t, tt, "below-min-"+itoa(sz[0]))
+	}
+	a.gridView = true
+	for _, sz := range [][2]int{{400, 280}, {360, 240}, {420, 300}} {
+		tt.SetSize(sz[0], sz[1])
+		tt.Advance(300 * time.Millisecond)
+		if !tt.HasText("代码") {
+			t.Errorf("grid %dx%d: no folder tile; texts %q", sz[0], sz[1], tt.Texts())
+		}
+		save(t, tt, "grid-min-"+itoa(sz[0]))
+	}
+}
+
+// TestPagesAtSmallest renders every other page in the smallest window, so
+// a fixed-width card or row cannot push its content off the window.
+func TestPagesAtSmallest(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	for _, page := range []struct{ route, title string }{
+		{"/transfers", "传输"},
+		{"/shares", "我的分享"},
+		{"/offline", "离线下载"},
+		{"/dedup", "查重"},
+		{"/recycle", "回收站"},
+		{"/settings", "设置"},
+	} {
+		a.router.Replace(page.route)
+		tt.SetSize(420, 300)
+		tt.Advance(400 * time.Millisecond)
+		if !tt.HasText(page.title) {
+			t.Errorf("%s at 420x300: no title %q; texts %q", page.route, page.title, tt.Texts())
+		}
+		save(t, tt, "page-small"+strings.ReplaceAll(page.route, "/", "-"))
+	}
+}
+
+// TestLoginAtSizes renders the sign-in screen small, where it scrolls from
+// the top instead of centering, and checks its title stays in the window
+// rather than clipped away.
+func TestLoginAtSizes(t *testing.T) {
+	a := New()
+	a.fake = true
+	a.phase = phaseLogin
+	a.login.tab = 1 // the cookie panel, so no QR request is made
+	tt := ui.NewTester(a.View, 1180, 760)
+	tt.SetLocale("zh-Hans")
+	for _, sz := range [][2]int{{1180, 760}, {780, 540}, {420, 300}, {360, 240}} {
+		tt.SetSize(sz[0], sz[1])
+		tt.Advance(300 * time.Millisecond)
+		if !tt.HasText("登录百度网盘") {
+			t.Errorf("login %dx%d: title missing; texts %q", sz[0], sz[1], tt.Texts())
+		}
+		save(t, tt, "login-"+itoa(sz[0]))
+	}
+}
+
+// TestSpeedCardNarrow keeps the transfers page's speed card whole in the
+// smallest window: the speed and the counts stay, the connections
+// reading folds away with the room.
+func TestSpeedCardNarrow(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	a.transfers.tasks = []transfer.Task{{
+		ID: 1, Name: "电影.mkv", Kind: transfer.Download,
+		State: transfer.Running, Size: 1 << 30, Done: 256 << 20, Speed: 5 << 20,
+	}}
+	a.router.Push("/transfers")
+	tt.SetSize(420, 300)
+	tt.Advance(500 * time.Millisecond)
+	if !tt.HasText("当前速度") || !tt.HasText("下载") {
+		t.Errorf("speed card not shown; texts %q", tt.Texts())
+	}
+	if tt.HasText("连接") {
+		t.Errorf("connections reading still on the narrow card; texts %q", tt.Texts())
+	}
+	save(t, tt, "transfers-narrow-card")
+}
+
+// TestSidebarManualChoice keeps a choice the user made over later resizes,
+// above the width at which a forced-open sidebar would leave the tools no
+// room.
+func TestSidebarManualChoice(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	shown := func() bool { return !a.sidebarCollapsed }
+	fit := func(w, h int) {
+		tt.SetSize(w, h)
+		tt.Advance(400 * time.Millisecond)
+	}
+	// Folded by hand at a wide window, it stays folded as the window moves.
+	if err := tt.Click("隐藏侧栏"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(400 * time.Millisecond)
+	if shown() {
+		t.Fatal("the click did not fold the sidebar")
+	}
+	fit(1180, 760)
+	if shown() {
+		t.Error("a manual fold was undone by a wider window")
+	}
+	fit(900, 600)
+	if shown() {
+		t.Error("a manual fold was undone by a narrower window")
+	}
+	// Opened by hand in a narrow window, it stays open while there is room
+	// for it, and folds again only below the width that leaves no room.
+	if err := tt.Click("显示侧栏"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(400 * time.Millisecond)
+	if !shown() {
+		t.Fatal("the click did not open the sidebar")
+	}
+	fit(620, 480)
+	if !shown() {
+		t.Error("a manual open was undone by a narrower window")
+	}
+	fit(420, 300)
+	if shown() {
+		t.Error("the sidebar stayed open under the width with no room for it")
+	}
+	fit(620, 480)
+	if !shown() {
+		t.Error("the sidebar did not come back once there was room again")
+	}
+}
