+// The pane widths under which the list's trailing columns go, Finder's
+// way: the date first, then the size, then the kind, so that a narrow
+// window keeps the name and its icon. The header and the rows decide with
+// the same listColumns, so they never disagree.
+const (
+	colTimeAt = 620
+	colSizeAt = 520
+	colTypeAt = 420
+)
+
+// listCols says which trailing columns a pane w wide shows.
+type listCols struct {
+	kind, size, time bool
+}
+
+// listColumns chooses the columns of a pane w wide. No width yet (the
+// first frame) shows them all.
+func listColumns(w float32) listCols {
+	if w <= 0 {
+		return listCols{kind: true, size: true, time: true}
+	}
+	return listCols{kind: w >= colTypeAt, size: w >= colSizeAt, time: w >= colTimeAt}
+}
