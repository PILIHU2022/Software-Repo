+
+// useProfile gives this build the data and cache directory
+// BAIDUNETGO_PROFILE names, so a local build can keep its own saved
+// session, settings, transfers and caches beside an installed copy, as
+// tools/install-patched-local.sh does for the patched build.
+//
+// It changes no XDG variable on purpose. XDG_CONFIG_HOME also tells
+// fontconfig, GTK and dconf where their configuration is, so a launcher
+// that pointed it at a profile directory made the interface lose the
+// user's fonts.conf (falling back to Droid Sans here) along with the
+// desktop's settings: the profile must cover this app's data only.
+func useProfile() {
+	dir := strings.TrimSpace(os.Getenv("BAIDUNETGO_PROFILE"))
+	if dir == "" {
+		return
+	}
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		log.Printf("profile %s: %v", dir, err)
+		return
+	}
+	mygo.App.SetPath(mygo.PathUserData, dir)
+	mygo.App.SetPath(mygo.PathCache, filepath.Join(dir, "cache"))
+}
