@@ -0,0 +1,49 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/egoist/mygo"
+)
+
+// TestUseProfile checks that BAIDUNETGO_PROFILE moves this app's data and
+// cache into the profile, and leaves the environment alone: a launcher
+// that changed XDG_CONFIG_HOME instead made fontconfig and GTK lose the
+// user's configuration, fonts included.
+func TestUseProfile(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "BaiduNetGo")
+	t.Setenv("BAIDUNETGO_PROFILE", dir)
+	xdg := os.Getenv("XDG_CONFIG_HOME")
+	t.Cleanup(func() {
+		mygo.App.SetPath(mygo.PathUserData, "")
+		mygo.App.SetPath(mygo.PathCache, "")
+	})
+	useProfile()
+	if got, err := mygo.App.Path(mygo.PathUserData); err != nil || got != dir {
+		t.Errorf("PathUserData = %q, %v; want %q", got, err, dir)
+	}
+	if got, err := mygo.App.Path(mygo.PathCache); err != nil || got != filepath.Join(dir, "cache") {
+		t.Errorf("PathCache = %q, %v; want %q", got, err, filepath.Join(dir, "cache"))
+	}
+	if fi, err := os.Stat(dir); err != nil || !fi.IsDir() {
+		t.Errorf("profile directory not made: %v", err)
+	}
+	if got := os.Getenv("XDG_CONFIG_HOME"); got != xdg {
+		t.Errorf("XDG_CONFIG_HOME changed to %q, want %q", got, xdg)
+	}
+}
+
+// TestUseProfileUnset checks that no profile leaves whatever data
+// directory was in place alone, the default one included.
+func TestUseProfileUnset(t *testing.T) {
+	sentinel := t.TempDir()
+	mygo.App.SetPath(mygo.PathUserData, sentinel)
+	t.Cleanup(func() { mygo.App.SetPath(mygo.PathUserData, "") })
+	t.Setenv("BAIDUNETGO_PROFILE", "   ")
+	useProfile()
+	if got, err := mygo.App.Path(mygo.PathUserData); err != nil || got != sentinel {
+		t.Errorf("PathUserData = %q, %v with no profile; want %q", got, err, sentinel)
+	}
+}
