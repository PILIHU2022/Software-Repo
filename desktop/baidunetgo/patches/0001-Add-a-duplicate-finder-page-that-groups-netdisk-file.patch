diff --git a/app/dedup.go b/app/dedup.go
new file mode 100644
index 0000000..9314e79
--- /dev/null
+++ b/app/dedup.go
@@ -0,0 +1,574 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"path"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/egoist/mygo/plugins/loading"
+	"github.com/egoist/mygo/ui"
+
+	"github.com/pengstem/baidunetgo/internal/baidu"
+	"github.com/pengstem/baidunetgo/internal/dedup"
+)
+
+// How the scan runs: folders read at once, and how often its progress
+// comes back to the UI thread. Tests lower both.
+var (
+	dedupWorkers = dedup.DefaultConcurrency
+	dedupReport  = 180 * time.Millisecond
+)
+
+// dedupRow is a line of the results: a group's heading, or one of its
+// files.
+type dedupRow struct {
+	group int
+	file  int // -1 for the group's heading
+}
+
+// dedupState is the page finding the netdisk's duplicate files.
+type dedupState struct {
+	root   string // the folder scanned, and to scan again
+	groups []dedup.Group
+	files  []baidu.File // everything found, to group again after a delete
+	rows   []dedupRow
+
+	scannedDirs, scannedFiles int
+	skipped                   int // files with no MD5, not compared
+	failed                    int // folders that could not be read
+	truncated                 bool
+	totalReclaim              int64 // what every group could free
+
+	scanning bool
+	started  bool // the first scan was asked for
+	canceled bool
+	loaded   bool
+	err      string // why the scan failed
+	curDir   string // the folder being read
+	scanID   uint64
+	cancel   context.CancelFunc
+
+	chosen   map[int64]bool // files to move to the recycle bin
+	selCount int
+	selBytes int64
+
+	list      ui.ListState
+	scrollTop bool // the results changed: show them from the start
+	confirm   bool // asking to move the chosen files to the recycle bin
+	picking   bool // choosing the folder to scan
+	picker    picker
+	busy      bool   // moving files, or asking to
+	actErr    string // why moving them failed
+}
+
+// startDedupScan scans dir, and everything under it, on a goroutine.
+func (a *App) startDedupScan(dir string) {
+	s := a.sess
+	d := &a.dedup
+	if s == nil || d.scanning {
+		return
+	}
+	if dir == "" {
+		dir = "/"
+	}
+	dir = path.Clean("/" + strings.TrimPrefix(dir, "/"))
+	d.root, d.scanning, d.started = dir, true, true
+	d.canceled, d.loaded, d.err, d.actErr = false, false, "", ""
+	d.confirm, d.picking = false, false
+	d.groups, d.rows, d.files = nil, nil, nil
+	d.skipped, d.failed, d.totalReclaim = 0, 0, 0
+	d.scannedDirs, d.scannedFiles, d.truncated = 0, 0, false
+	d.curDir = dir
+	d.chosen = map[int64]bool{}
+	d.selCount, d.selBytes = 0, 0
+	d.scanID++
+	id := d.scanID
+	ctx, cancel := context.WithCancel(context.Background())
+	d.cancel = cancel
+	client := s.client
+	workers := dedupWorkers
+	go func() {
+		last := time.Now()
+		report := func(p dedup.Progress) {
+			if dedupReport > 0 && time.Since(last) < dedupReport {
+				return
+			}
+			last = time.Now()
+			a.update(func() {
+				if d.scanID != id {
+					return
+				}
+				d.curDir = p.Dir
+				d.scannedDirs, d.scannedFiles = p.Dirs, p.Files
+			})
+		}
+		res, err := dedup.Scan(ctx, client, dedup.Options{
+			Root:        dir,
+			Concurrency: workers,
+			MaxFiles:    dedup.DefaultMaxFiles,
+			MaxDirs:     dedup.DefaultMaxDirs,
+			Report:      report,
+		})
+		a.update(func() {
+			if d.scanID != id {
+				return
+			}
+			d.scanning, d.cancel = false, nil
+			d.curDir = ""
+			d.scannedDirs, d.scannedFiles = res.Dirs, len(res.Files)
+			d.failed, d.truncated = len(res.Failed), res.Truncated
+			switch {
+			case errors.Is(err, context.Canceled):
+				d.canceled = true
+				a.toast("已取消查重", "info")
+			case err != nil:
+				d.err = err.Error()
+			default:
+				d.loaded = true
+				d.files = res.Files
+				d.groups, d.skipped = dedup.Groups(res.Files)
+				d.flatten()
+				d.chooseDefaults()
+			}
+		})
+	}()
+}
+
+// cancelDedupScan stops the scan under way; its goroutine clears scanning
+// when it notices.
+func (a *App) cancelDedupScan() {
+	if a.dedup.cancel != nil {
+		a.dedup.cancel()
+	}
+}
+
+// flatten turns the groups into the list's lines.
+func (d *dedupState) flatten() {
+	d.rows = d.rows[:0]
+	for gi, g := range d.groups {
+		d.rows = append(d.rows, dedupRow{group: gi, file: -1})
+		for fi := range g.Files {
+			d.rows = append(d.rows, dedupRow{group: gi, file: fi})
+		}
+	}
+}
+
+// chooseDefaults chooses every copy but each group's kept one: the
+// earliest modified, its path breaking a tie.
+func (d *dedupState) chooseDefaults() {
+	d.chosen = map[int64]bool{}
+	for _, g := range d.groups {
+		for i, f := range g.Files {
+			if i > 0 {
+				d.chosen[f.FsID] = true
+			}
+		}
+	}
+	d.recount()
+}
+
+// recount adds up what is chosen and what every group could free.
+func (d *dedupState) recount() {
+	d.selCount, d.selBytes, d.totalReclaim = 0, 0, 0
+	for _, g := range d.groups {
+		d.totalReclaim += g.Reclaim
+		for _, f := range g.Files {
+			if d.chosen[f.FsID] {
+				d.selCount++
+				d.selBytes += f.Size
+			}
+		}
+	}
+}
+
+// selectedFiles are the files chosen to move to the recycle bin.
+func (d *dedupState) selectedFiles() []baidu.File {
+	out := make([]baidu.File, 0, d.selCount)
+	for _, g := range d.groups {
+		for _, f := range g.Files {
+			if d.chosen[f.FsID] {
+				out = append(out, f)
+			}
+		}
+	}
+	return out
+}
+
+// fullGroup reports a group whose every copy is chosen: deleting those
+// would leave none, so it is refused.
+func (d *dedupState) fullGroup() (dedup.Group, bool) {
+	for _, g := range d.groups {
+		all := len(g.Files) > 0
+		for _, f := range g.Files {
+			if !d.chosen[f.FsID] {
+				all = false
+				break
+			}
+		}
+		if all {
+			return g, true
+		}
+	}
+	return dedup.Group{}, false
+}
+
+// selectAll chooses every copy but the kept one of each group.
+func (d *dedupState) selectAll() {
+	d.chosen = map[int64]bool{}
+	for _, g := range d.groups {
+		for i, f := range g.Files {
+			if i > 0 {
+				d.chosen[f.FsID] = true
+			}
+		}
+	}
+	d.recount()
+}
+
+// clearSelection chooses none.
+func (d *dedupState) clearSelection() {
+	d.chosen = map[int64]bool{}
+	d.recount()
+}
+
+// keepOne chooses a group's copies but its kept one, as it starts.
+func (d *dedupState) keepOne(gi int) {
+	if gi < 0 || gi >= len(d.groups) {
+		return
+	}
+	for _, f := range d.groups[gi].Files {
+		delete(d.chosen, f.FsID)
+	}
+	for i, f := range d.groups[gi].Files {
+		if i > 0 {
+			d.chosen[f.FsID] = true
+		}
+	}
+	d.recount()
+}
+
+// deleteDedup moves the chosen files to the recycle bin, then groups what
+// is left again.
+func (a *App) deleteDedup() {
+	s := a.sess
+	d := &a.dedup
+	if s == nil || d.busy {
+		return
+	}
+	files := d.selectedFiles()
+	if len(files) == 0 {
+		return
+	}
+	if g, all := d.fullGroup(); all {
+		a.toast("「"+g.Files[0].Name+"」这一组已全选，每组至少保留一份", "error")
+		return
+	}
+	list := paths(files)
+	dirs := map[string]bool{}
+	for _, f := range files {
+		dirs[path.Dir(f.Path)] = true
+	}
+	d.busy, d.actErr = true, ""
+	go func() {
+		err := s.client.Delete(context.Background(), list)
+		a.update(func() {
+			d.busy = false
+			if err != nil {
+				d.actErr = err.Error()
+				a.toast(err.Error(), "error")
+				return
+			}
+			gone, names := map[int64]bool{}, map[string]bool{}
+			for _, f := range files {
+				gone[f.FsID] = true
+				names[f.Path] = true
+			}
+			d.files = slices.DeleteFunc(d.files, func(f baidu.File) bool {
+				return (f.FsID != 0 && gone[f.FsID]) || names[f.Path]
+			})
+			d.groups, d.skipped = dedup.Groups(d.files)
+			d.flatten()
+			d.chooseDefaults()
+			d.scrollTop = true
+			a.recycleDirty = true
+			for dir := range dirs {
+				a.reload(dir)
+			}
+			a.toast("已将 "+itoa(len(files))+" 项移入回收站", "success")
+		})
+	}()
+}
+
+// dedupPage is the page of duplicate files.
+func (a *App) dedupPage(c *ui.Context, t *ui.Theme, p *palette) {
+	d := &a.dedup
+	if !d.started {
+		a.startDedupScan("/")
+	}
+	ui.Column(c).Grow(1).Children(func() {
+		a.dedupHeader(c, t, p)
+		switch {
+		case d.err != "":
+			emptyState(c, t, p, "triangle-alert", "无法完成查重", d.err, func() {
+				a.startDedupScan(d.root)
+			})
+		case d.scanning:
+			a.dedupProgress(c, t, p)
+		case d.canceled:
+			emptyState(c, t, p, "x", "已取消扫描",
+				"已读 "+itoa(d.scannedDirs)+" 个文件夹里的 "+itoa(d.scannedFiles)+" 个文件，可以重新开始。",
+				func() { a.startDedupScan(d.root) })
+		case !d.loaded:
+			skeletonRows(c, t, p)
+		case len(d.groups) == 0:
+			emptyState(c, t, p, "copy", "没有找到重复文件", a.dedupEmptyDetail(), nil)
+		default:
+			a.dedupResults(c, t, p)
+		}
+		if d.loaded && len(d.groups) > 0 {
+			a.dedupBar(c, t, p)
+		}
+	})
+	if d.picking {
+		ui.Modal(c, &d.picking, func() {
+			dialogTitle(c, t, "选择要查重的文件夹", "扫描它和它里面的所有子文件夹")
+			a.folderChooser(c, t, p, &d.picker, 300, nil)
+			ui.Row(c).Gap(8).Justify(ui.End).Children(func() {
+				if pill(c, t, p, "", "取消", false).Clicked() {
+					d.picking = false
+				}
+				if pill(c, t, p, "search", "扫描此文件夹", true).AutoFocus().Clicked() {
+					dir := d.picker.dir
+					d.picking = false
+					a.startDedupScan(dir)
+				}
+			})
+		})
+	}
+	if d.confirm {
+		ui.Modal(c, &d.confirm, func() {
+			dialogTitle(c, t, "移入回收站？", "已选 "+itoa(d.selCount)+" 项 · 可释放 "+humanSize(d.selBytes))
+			ui.Text(c, "这些文件会进入回收站，可以还原；每组保留的那份不会被删除。").
+				TextColor(t.TextMuted)
+			ui.Row(c).Gap(8).Justify(ui.End).Children(func() {
+				if pill(c, t, p, "", "取消", false).Clicked() {
+					d.confirm = false
+				}
+				if pill(c, t, p, "trash-2", "确认移入", true).AutoFocus().Clicked() {
+					d.confirm = false
+					a.deleteDedup()
+				}
+			})
+		})
+	}
+}
+
+// dedupHeader is the panel over the results: the folder scanned and how to
+// scan another, then what the scan found.
+func (a *App) dedupHeader(c *ui.Context, t *ui.Theme, p *palette) {
+	d := &a.dedup
+	panel := group(c, p).Padding(12).Gap(8)
+	panel.Children(func() {
+		ui.Row(c).Gap(10).AlignItems(ui.Center).Children(func() {
+			tile := ui.Box(c).Size(28, 28).Radius(7).Background(t.Accent.Alpha(0.12)).Center()
+			tile.Children(func() { ui.Icon(c, icon("copy")).FontSize(15).TextColor(t.Accent) })
+			ui.Column(c).Grow(1).Shrink(1).Gap(1).Children(func() {
+				ui.Text(c, "扫描范围").FontSize(11).TextColor(t.TextMuted)
+				scope := d.root
+				if scope == "/" {
+					scope = "整个网盘（/）"
+				}
+				wholeOnHover(c, ui.Text(c, scope).FontWeight(600).SingleLine(), d.root, 0)
+			})
+			if d.scanning {
+				if pill(c, t, p, "x", "取消", false).Clicked() {
+					a.cancelDedupScan()
+				}
+				return
+			}
+			if pill(c, t, p, "folder-open", "选择文件夹", false).Clicked() {
+				if d.picker.dir == "" {
+					d.picker.dir = d.root
+				}
+				d.picking = true
+			}
+			label := "开始扫描"
+			if d.loaded {
+				label = "重新扫描"
+			}
+			if pill(c, t, p, "refresh-cw", label, true).Clicked() {
+				a.startDedupScan(d.root)
+			}
+		})
+		var parts []string
+		parts = append(parts, itoa(d.scannedDirs)+" 个文件夹", itoa(d.scannedFiles)+" 个文件")
+		if d.loaded {
+			parts = append(parts, itoa(len(d.groups))+" 组重复")
+			if d.totalReclaim > 0 {
+				parts = append(parts, "可释放 "+humanSize(d.totalReclaim))
+			}
+		}
+		if d.skipped > 0 {
+			parts = append(parts, "缺少哈希 "+itoa(d.skipped)+" 个，已跳过")
+		}
+		if d.failed > 0 {
+			parts = append(parts, itoa(d.failed)+" 个文件夹读取失败")
+		}
+		if d.truncated {
+			parts = append(parts, "已达上限，结果已截断")
+		}
+		figure(c, strings.Join(parts, " · ")).FontSize(11).TextColor(t.TextMuted).SingleLine()
+		if d.loaded && len(d.groups) > 0 {
+			ui.Text(c, "每组默认保留修改时间最早的一份，勾选其余副本一起移入回收站").
+				FontSize(11).TextColor(p.Faint).SingleLine()
+		}
+	})
+}
+
+// dedupEmptyDetail says what was compared when nothing repeats.
+func (a *App) dedupEmptyDetail() string {
+	d := &a.dedup
+	s := "按文件大小和网盘 MD5 比对了 " + itoa(d.scannedFiles) + " 个文件，没有两份相同。"
+	if d.skipped > 0 {
+		s += "有 " + itoa(d.skipped) + " 个文件缺少 MD5，已跳过。"
+	}
+	return s
+}
+
+// dedupProgress shows a scan under way.
+func (a *App) dedupProgress(c *ui.Context, t *ui.Theme, p *palette) {
+	d := &a.dedup
+	ui.Column(c).Grow(1).Center().Gap(8).Padding(40).Children(func() {
+		loading.Ring(c, loading.Options{Size: 26, Color: t.Accent}).Label("扫描中")
+		ui.Text(c, "正在扫描目录").FontSize(14).FontWeight(600)
+		figure(c, itoa(d.scannedDirs)+" 个文件夹 · "+itoa(d.scannedFiles)+" 个文件").
+			FontSize(12).TextColor(t.TextMuted)
+		if d.curDir != "" {
+			ui.Text(c, "当前："+d.curDir).FontSize(11).TextColor(t.TextMuted).SingleLine().MaxWidth(460)
+		}
+		ui.Text(c, "只读取目录列表里的 MD5，不读取文件内容").FontSize(11).TextColor(p.Faint).Margin(6, 0, 0)
+	})
+}
+
+// dedupResults is the list of groups, a heading over each and its files.
+func (a *App) dedupResults(c *ui.Context, t *ui.Theme, p *palette) {
+	d := &a.dedup
+	if d.scrollTop {
+		d.list.ScrollTo(0, ui.Start)
+		d.scrollTop = false
+	}
+	d.list.Key = func(row int) any {
+		r := d.rows[row]
+		if r.file < 0 {
+			return d.groups[r.group].Key
+		}
+		f := d.groups[r.group].Files[r.file]
+		if f.FsID != 0 {
+			return f.FsID
+		}
+		return f.Path
+	}
+	d.list.Header = func(row int) bool { return d.rows[row].file < 0 }
+	d.list.Label = func(row int) string {
+		r := d.rows[row]
+		if r.file < 0 {
+			return itoa(len(d.groups[r.group].Files)) + " 个相同文件"
+		}
+		return d.groups[r.group].Files[r.file].Name
+	}
+	now := c.Now()
+	ui.List(c, &d.list, len(d.rows), func(i int) {
+		r := d.rows[i]
+		g := d.groups[r.group]
+		if r.file < 0 {
+			a.dedupGroupRow(c, t, p, g, r.group)
+			return
+		}
+		f := g.Files[r.file]
+		on := d.chosen[f.FsID]
+		row := ui.ButtonBase(c.Key(f.FsID)).Label(f.Name).
+			Height(44).PaddingX(10).Gap(10).AlignItems(ui.Center)
+		row = stripe(row, p, i)
+		row.Children(func() {
+			box := ui.Box(c).Size(18, 18).Radius(5).Shrink(0).Center()
+			if on {
+				box.Background(t.Accent)
+			} else {
+				box.Background(t.Background).Border(1, t.Border.Mix(t.Text, 0.25))
+			}
+			box.Children(func() {
+				if on {
+					ui.Icon(c, icon("check")).FontSize(11).TextColor(t.AccentText)
+				}
+			})
+			ui.Column(c).Grow(1).Shrink(1).Gap(1).Children(func() {
+				ui.Row(c).Gap(6).AlignItems(ui.Center).Children(func() {
+					wholeOnHover(c, ui.Text(c, f.Name).SingleLine(), f.Name, 0)
+					if r.file == 0 {
+						chip(c, "保留", t.TextMuted)
+					}
+				})
+				wholeOnHover(c, ui.Text(c, f.Path).FontSize(11).TextColor(t.TextMuted).SingleLine(), f.Path, 0)
+			})
+			figure(c, humanSize(f.Size)).FontSize(11).TextColor(t.TextMuted).Width(72).TextAlign(ui.End)
+			figure(c, humanTime(f.Mtime, now)).FontSize(11).TextColor(t.TextMuted).Width(96).TextAlign(ui.End)
+		})
+		if row.Clicked() {
+			if d.chosen[f.FsID] {
+				delete(d.chosen, f.FsID)
+			} else {
+				d.chosen[f.FsID] = true
+			}
+			d.recount()
+		}
+	}).Grow(1).Padding(4, 10, 12)
+}
+
+// dedupGroupRow heads a group with its count and what it could free, and a
+// way to keep just one of its copies.
+func (a *App) dedupGroupRow(c *ui.Context, t *ui.Theme, p *palette, g dedup.Group, gi int) {
+	row := ui.Row(c).Height(42).PaddingX(10).Gap(8).AlignItems(ui.Center).Background(t.Background)
+	row.Children(func() {
+		ui.Icon(c, icon("copy")).FontSize(13).TextColor(t.TextMuted)
+		figure(c, itoa(len(g.Files))+" 个相同文件").FontSize(12).FontWeight(600)
+		figure(c, "每个 "+humanSize(g.Size())).FontSize(11).TextColor(t.TextMuted)
+		ui.Spacer(c)
+		figure(c, "共 "+humanSize(g.Total())+" · 可释放 "+humanSize(g.Reclaim)).
+			FontSize(11).TextColor(t.TextMuted)
+		if pill(c, t, p, "", "保留一份", false).Clicked() {
+			a.dedup.keepOne(gi)
+		}
+	})
+}
+
+// dedupBar is the bar under the results: what is chosen, and the action.
+func (a *App) dedupBar(c *ui.Context, t *ui.Theme, p *palette) {
+	d := &a.dedup
+	ui.Divider(c)
+	ui.Column(c).Padding(8, 12).Gap(4).Shrink(0).Children(func() {
+		ui.Row(c).Gap(10).AlignItems(ui.Center).Children(func() {
+			figure(c, "已选 "+itoa(d.selCount)+" 项 · 可释放 "+humanSize(d.selBytes)).
+				FontWeight(500).FontSize(12)
+			ui.Spacer(c)
+			if pill(c, t, p, "", "全选", false).Disabled(d.busy).Clicked() {
+				d.selectAll()
+			}
+			if pill(c, t, p, "", "全不选", false).Disabled(d.busy).Clicked() {
+				d.clearSelection()
+			}
+			b := pill(c, t, p, "trash-2", "移入回收站", true).Disabled(d.busy || d.selCount == 0)
+			if d.busy {
+				b.Children(func() { ui.Spinner(c).TextColor(t.AccentText) })
+			}
+			if b.Clicked() {
+				d.confirm = true
+			}
+		})
+		if d.actErr != "" {
+			ui.Text(c, d.actErr).FontSize(11).TextColor(t.Danger).SingleLine()
+		}
+	})
+}
diff --git a/app/dedup_test.go b/app/dedup_test.go
new file mode 100644
index 0000000..310fe9e
--- /dev/null
+++ b/app/dedup_test.go
@@ -0,0 +1,163 @@
+package app
+
+import (
+	"testing"
+	"time"
+)
+
+// TestDedup finds the fake netdisk's duplicate files, keeps one copy of
+// each by default, and moves the chosen copies to the recycle bin.
+func TestDedup(t *testing.T) {
+	oldWorkers, oldReport := dedupWorkers, dedupReport
+	dedupWorkers, dedupReport = 2, 0
+	t.Cleanup(func() { dedupWorkers, dedupReport = oldWorkers, oldReport })
+
+	a, tt, srv := signedIn(t)
+	a.router.Replace("/dedup")
+	// Entering the page starts the scan by itself.
+	waitUntil(t, tt, "the dedup scan", func() bool { return a.dedup.loaded })
+	tt.Advance(500 * time.Millisecond)
+
+	d := &a.dedup
+	if len(d.groups) == 0 {
+		t.Fatalf("no duplicates found; scanned %d folders, %d files", d.scannedDirs, d.scannedFiles)
+	}
+	if d.scannedDirs == 0 || d.scannedFiles == 0 || d.truncated || d.failed != 0 {
+		t.Errorf("scan %d folders, %d files, truncated %v, failed %d",
+			d.scannedDirs, d.scannedFiles, d.truncated, d.failed)
+	}
+	// The fake netdisk has a file whose MD5 it does not know.
+	if d.skipped == 0 {
+		t.Error("no file counted as lacking an MD5")
+	}
+	if !tt.HasText("缺少哈希") || !tt.HasText("组重复") {
+		t.Errorf("header lacks the scan's notes: %q", tt.Texts())
+	}
+
+	// Groups come by what they could free, their copies by mtime with the
+	// earliest kept and left unchosen.
+	all := map[int64]bool{}
+	wantSel, wantBytes := 0, int64(0)
+	for i, g := range d.groups {
+		if len(g.Files) < 2 {
+			t.Errorf("group %d has %d files", i, len(g.Files))
+		}
+		if i > 0 && d.groups[i-1].Reclaim < g.Reclaim {
+			t.Errorf("group %d frees %d, after %d", i, g.Reclaim, d.groups[i-1].Reclaim)
+		}
+		if g.Reclaim != g.Size()*int64(len(g.Files)-1) {
+			t.Errorf("group %d reclaims %d, not %d x %d", i, g.Reclaim, g.Size(), len(g.Files)-1)
+		}
+		if d.chosen[g.Files[0].FsID] {
+			t.Errorf("group %d keeps no copy", i)
+		}
+		for j, f := range g.Files {
+			if f.Size <= 0 || f.MD5 == "" {
+				t.Errorf("group %d file %d is no duplicate: size %d, md5 %q", i, j, f.Size, f.MD5)
+			}
+			if all[f.FsID] {
+				t.Errorf("file %d is in two groups", f.FsID)
+			}
+			all[f.FsID] = true
+			if j > 0 && f.Mtime < g.Files[j-1].Mtime {
+				t.Errorf("group %d not by mtime: %d before %d", i, g.Files[j-1].Mtime, f.Mtime)
+			}
+			if j > 0 {
+				if !d.chosen[f.FsID] {
+					t.Errorf("group %d file %d not chosen by default", i, j)
+				}
+				wantSel++
+				wantBytes += f.Size
+			}
+		}
+	}
+	if d.selCount != wantSel || d.selBytes != wantBytes {
+		t.Errorf("chose %d files, %d bytes; want %d, %d", d.selCount, d.selBytes, wantSel, wantBytes)
+	}
+	save(t, tt, "dedup")
+
+	// The copy of 读我.txt is later than the original, so the original is
+	// the copy kept.
+	var kept string
+	for _, g := range d.groups {
+		if g.Files[0].Path == "/文档/读我.txt" {
+			kept = g.Files[1].Path
+			if kept != "/代码/备份/读我（副本）.txt" {
+				t.Errorf("readme group %+v", g.Files)
+			}
+		}
+	}
+	if kept == "" {
+		t.Error("the fake netdisk's readme copies formed no group")
+	}
+
+	if err := tt.Click("全不选"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if d.selCount != 0 || d.selBytes != 0 {
+		t.Errorf("after 全不选, %d files, %d bytes", d.selCount, d.selBytes)
+	}
+	if err := tt.Click("全选"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if d.selCount != wantSel {
+		t.Errorf("after 全选, %d files, want %d", d.selCount, wantSel)
+	}
+
+	// 保留一份 on the first group chooses that group's copies again.
+	if err := tt.Click("全不选"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if err := tt.Click("保留一份"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if want := len(d.groups[0].Files) - 1; d.selCount != want {
+		t.Errorf("保留一份 chose %d files, want %d", d.selCount, want)
+	}
+
+	// Choose one copy and move it to the recycle bin.
+	g := d.groups[0]
+	keep, extra := g.Files[0], g.Files[1]
+	if err := tt.Click("全不选"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	row, ok := tt.Find(extra.Name)
+	if !ok {
+		t.Fatalf("%q not shown; texts %q", extra.Name, tt.Texts())
+	}
+	tt.ClickAt(row.X+row.W/2, row.Y+row.H/2)
+	tt.Advance(100 * time.Millisecond)
+	if d.selCount != 1 || !d.chosen[extra.FsID] {
+		t.Fatalf("clicking %q chose %d files", extra.Name, d.selCount)
+	}
+	before := len(d.groups)
+	if err := tt.Click("移入回收站"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if !d.confirm {
+		t.Fatal("移入回收站 did not ask")
+	}
+	if err := tt.Click("确认移入"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	waitUntil(t, tt, "the delete", func() bool {
+		return !d.busy && !srv.Exists(extra.Path) && len(d.groups) == before-1
+	})
+	if !srv.Exists(keep.Path) {
+		t.Errorf("the kept copy %q went too", keep.Path)
+	}
+	if d.chosen[extra.FsID] {
+		t.Errorf("the deleted copy %d is still chosen", extra.FsID)
+	}
+	tt.Advance(300 * time.Millisecond)
+	if !tt.HasText("已将 1 项移入回收站") {
+		t.Errorf("no toast after the delete: %q", tt.Texts())
+	}
+	save(t, tt, "dedup-after-delete")
+}
