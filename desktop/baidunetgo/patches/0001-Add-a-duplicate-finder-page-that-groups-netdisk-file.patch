diff --git a/internal/dedup/dedup.go b/internal/dedup/dedup.go
new file mode 100644
index 0000000..09a8d2e
--- /dev/null
+++ b/internal/dedup/dedup.go
@@ -0,0 +1,240 @@
+// Package dedup finds files of the netdisk that hold the same content. It
+// compares no bytes: the netdisk's listings already tell every file's MD5,
+// so two files are the same when their size and MD5 are.
+package dedup
+
+import (
+	"context"
+	"errors"
+	"path"
+	"sort"
+
+	"github.com/pengstem/baidunetgo/internal/baidu"
+)
+
+// Key is what makes two files the same: their size and MD5.
+type Key struct {
+	Size int64
+	MD5  string
+}
+
+// Group is a set of files holding the same content.
+type Group struct {
+	Key   Key
+	Files []baidu.File // the earliest modified first, its path breaking a tie
+	// Reclaim is what deleting every copy but one frees.
+	Reclaim int64
+}
+
+// Size is the size of one copy.
+func (g Group) Size() int64 { return g.Key.Size }
+
+// Total is the size of every copy in the group.
+func (g Group) Total() int64 { return g.Key.Size * int64(len(g.Files)) }
+
+// Groups groups files by size and MD5. Files with no MD5 are counted in
+// skipped, as are directories; 0-byte files are not duplicates of anything
+// worth freeing and are left out. A group of fewer than two files is no
+// group. Groups come by Reclaim, the most to free first. The earliest
+// modified file of a group comes first: it is the copy to keep.
+func Groups(files []baidu.File) (groups []Group, skipped int) {
+	byKey := map[Key][]baidu.File{}
+	seen := map[int64]bool{}
+	for _, f := range files {
+		if f.IsDir || f.Size <= 0 {
+			continue
+		}
+		if f.FsID != 0 {
+			if seen[f.FsID] {
+				continue
+			}
+			seen[f.FsID] = true
+		}
+		if f.MD5 == "" {
+			skipped++
+			continue
+		}
+		k := Key{Size: f.Size, MD5: f.MD5}
+		byKey[k] = append(byKey[k], f)
+	}
+	groups = make([]Group, 0, len(byKey)/2)
+	for k, fs := range byKey {
+		if len(fs) < 2 {
+			continue
+		}
+		sort.SliceStable(fs, func(i, j int) bool {
+			if fs[i].Mtime != fs[j].Mtime {
+				return fs[i].Mtime < fs[j].Mtime
+			}
+			return fs[i].Path < fs[j].Path
+		})
+		groups = append(groups, Group{Key: k, Files: fs, Reclaim: k.Size * int64(len(fs)-1)})
+	}
+	sort.Slice(groups, func(i, j int) bool {
+		if groups[i].Reclaim != groups[j].Reclaim {
+			return groups[i].Reclaim > groups[j].Reclaim
+		}
+		if groups[i].Key.Size != groups[j].Key.Size {
+			return groups[i].Key.Size > groups[j].Key.Size
+		}
+		return groups[i].Key.MD5 < groups[j].Key.MD5
+	})
+	return groups, skipped
+}
+
+// Default options of a scan.
+const (
+	DefaultConcurrency = 4
+	DefaultMaxFiles    = 50_000
+	DefaultMaxDirs     = 5_000
+)
+
+// List is the part of the netdisk client a scan reads folders with;
+// *baidu.Client does it.
+type Lister interface {
+	List(ctx context.Context, dir string, o baidu.Order) ([]baidu.File, error)
+}
+
+// Options bound a scan and say how it runs.
+type Options struct {
+	Root        string // the folder to scan, "/" for the whole netdisk
+	Concurrency int    // folders read at once, DefaultConcurrency by default
+	MaxFiles    int    // DefaultMaxFiles by default
+	MaxDirs     int    // DefaultMaxDirs by default
+	// Report is told how far the scan has got, from the scan's goroutine,
+	// after each folder.
+	Report func(Progress)
+}
+
+// Progress is how far a scan has got.
+type Progress struct {
+	Dir   string // the folder just read
+	Dirs  int    // folders read
+	Files int    // files found, those about to be skipped included
+}
+
+// Result is what a scan found.
+type Result struct {
+	// Files are the files found, every non-folder entry once: those
+	// without an MD5, and 0-byte ones, are left for Groups to skip.
+	Files []baidu.File
+	// Dirs is how many folders were read.
+	Dirs int
+	// Failed are folders that could not be read; the scan went on without
+	// them.
+	Failed []string
+	// Truncated says the scan stopped at one of its limits.
+	Truncated bool
+}
+
+const order = "name" // listings are read by name, as the browser does
+
+// Scan walks the folders under opt.Root, reading them a few at a time,
+// and collects their files. A folder that cannot be read is recorded in
+// Failed and skipped, unless it is the root: then Scan returns its error.
+// Scan stops at opt.MaxFiles or opt.MaxDirs, reporting Truncated, and
+// returns ctx's error when the context is canceled. It never reads file
+// content, only listings.
+func Scan(ctx context.Context, l Lister, opt Options) (Result, error) {
+	if l == nil {
+		return Result{}, errors.New("没有可用的网盘连接")
+	}
+	if opt.Concurrency <= 0 {
+		opt.Concurrency = DefaultConcurrency
+	}
+	if opt.MaxFiles <= 0 {
+		opt.MaxFiles = DefaultMaxFiles
+	}
+	if opt.MaxDirs <= 0 {
+		opt.MaxDirs = DefaultMaxDirs
+	}
+	root := path.Clean("/" + trimRoot(opt.Root))
+	res := Result{}
+	seenDirs := map[string]bool{root: true}
+	seenFiles := map[int64]bool{}
+	level := []string{root}
+	for len(level) > 0 && !res.Truncated {
+		if err := ctx.Err(); err != nil {
+			return res, err
+		}
+		var next []string
+		for start := 0; start < len(level); start += opt.Concurrency {
+			if err := ctx.Err(); err != nil {
+				return res, err
+			}
+			end := min(start+opt.Concurrency, len(level))
+			type listed struct {
+				dir   string
+				files []baidu.File
+				err   error
+			}
+			ch := make(chan listed, end-start)
+			for _, dir := range level[start:end] {
+				go func(dir string) {
+					files, err := l.List(ctx, dir, baidu.Order{By: order})
+					ch <- listed{dir: dir, files: files, err: err}
+				}(dir)
+			}
+			for range end - start {
+				got := <-ch
+				if got.err != nil {
+					if ctx.Err() != nil {
+						return res, ctx.Err()
+					}
+					if got.dir == root {
+						return Result{}, got.err
+					}
+					res.Failed = append(res.Failed, got.dir)
+					continue
+				}
+				res.Dirs++
+				for _, f := range got.files {
+					if f.IsDir {
+						p := path.Clean(f.Path)
+						if p == "" || p == "/" || seenDirs[p] {
+							continue
+						}
+						if len(seenDirs) >= opt.MaxDirs {
+							res.Truncated = true
+							break
+						}
+						seenDirs[p] = true
+						next = append(next, p)
+						continue
+					}
+					if f.FsID != 0 {
+						if seenFiles[f.FsID] {
+							continue
+						}
+						seenFiles[f.FsID] = true
+					}
+					if len(res.Files) >= opt.MaxFiles {
+						res.Truncated = true
+						break
+					}
+					res.Files = append(res.Files, f)
+				}
+				if opt.Report != nil {
+					opt.Report(Progress{Dir: got.dir, Dirs: res.Dirs, Files: len(res.Files)})
+				}
+				if res.Truncated {
+					break
+				}
+			}
+			if res.Truncated {
+				break
+			}
+		}
+		level = next
+	}
+	return res, nil
+}
+
+// trimRoot turns a root path into one without its leading slash, for
+// path.Clean to put back.
+func trimRoot(root string) string {
+	for len(root) > 0 && root[0] == '/' {
+		root = root[1:]
+	}
+	return root
+}
diff --git a/internal/dedup/dedup_test.go b/internal/dedup/dedup_test.go
new file mode 100644
index 0000000..75ab02e
--- /dev/null
+++ b/internal/dedup/dedup_test.go
@@ -0,0 +1,333 @@
+package dedup
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"path"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/pengstem/baidunetgo/internal/baidu"
+)
+
+// f makes a file of a size and MD5, modified at mtime.
+func f(path, md5 string, size, mtime int64) baidu.File {
+	return baidu.File{FsID: fileIDs.Add(1), Path: path, Name: pathBase(path), Size: size, MD5: md5, Mtime: mtime}
+}
+
+// fileIDs numbers the files the tests make, so that no two share an
+// fs_id and Groups drops none of them.
+var fileIDs atomic.Int64
+
+func pathBase(p string) string {
+	if i := strings.LastIndexByte(p, '/'); i >= 0 {
+		return p[i+1:]
+	}
+	return p
+}
+
+func ids(fs []baidu.File) []int64 {
+	out := make([]int64, len(fs))
+	for i, x := range fs {
+		out[i] = x.FsID
+	}
+	return out
+}
+
+func TestGroups(t *testing.T) {
+	files := []baidu.File{
+		f("/a.txt", "same", 100, 200),
+		f("/dir/b.txt", "same", 100, 100), // same content, earlier
+		f("/c.txt", "same", 200, 300),     // same MD5, other size: no group
+		f("/empty.txt", "", 100, 100),
+		f("/zero.txt", "zero", 0, 100),
+		f("/one.txt", "one", 50, 100),
+		{Path: "/dir", IsDir: true, MD5: "same", Size: 100},
+	}
+	groups, skipped := Groups(files)
+	if len(groups) != 1 {
+		t.Fatalf("%d groups: %+v", len(groups), groups)
+	}
+	g := groups[0]
+	if g.Key.MD5 != "same" || g.Size() != 100 || len(g.Files) != 2 || g.Reclaim != 100 {
+		t.Errorf("group %+v", g)
+	}
+	if g.Files[0].Path != "/dir/b.txt" || g.Files[1].Path != "/a.txt" {
+		t.Errorf("kept copy first: %v", []string{g.Files[0].Path, g.Files[1].Path})
+	}
+	if skipped != 1 {
+		t.Errorf("skipped %d, want the file with no MD5 only", skipped)
+	}
+}
+
+// TestGroupsSameMD5DifferentSize keeps files with the same hash but
+// another size apart: a listing that disagrees is no duplicate.
+func TestGroupsSameMD5DifferentSize(t *testing.T) {
+	groups, _ := Groups([]baidu.File{
+		f("/a.bin", "hash", 10, 1),
+		f("/b.bin", "hash", 11, 1),
+	})
+	if len(groups) != 0 {
+		t.Errorf("groups %+v", groups)
+	}
+}
+
+func TestGroupsOrder(t *testing.T) {
+	groups, _ := Groups([]baidu.File{
+		f("/small1", "small", 10, 1), f("/small2", "small", 10, 2),
+		f("/big1", "big", 1000, 1), f("/big2", "big", 1000, 2), f("/big3", "big", 1000, 3),
+		f("/mid1", "mid", 100, 1), f("/mid2", "mid", 100, 2),
+	})
+	if len(groups) != 3 {
+		t.Fatalf("%d groups", len(groups))
+	}
+	var got []int64
+	for _, g := range groups {
+		got = append(got, g.Reclaim)
+	}
+	if !sort.SliceIsSorted(got, func(i, j int) bool { return got[i] > got[j] }) {
+		t.Errorf("reclaim %v not descending", got)
+	}
+	if got[0] != 2000 || got[1] != 100 || got[2] != 10 {
+		t.Errorf("reclaim %v", got)
+	}
+}
+
+// TestGroupsLarge covers a group of many copies, as a synced folder makes.
+func TestGroupsLarge(t *testing.T) {
+	var files []baidu.File
+	for i := range 40 {
+		files = append(files, f(fmt.Sprintf("/copy/%02d.dat", i), "many", 1<<20, int64(i)))
+	}
+	files = append(files, f("/other.dat", "many", 1<<20, -1)) // one more copy
+	groups, _ := Groups(files)
+	if len(groups) != 1 || len(groups[0].Files) != 41 {
+		t.Fatalf("%d groups, first %d files", len(groups), len(groups[0].Files))
+	}
+	if want := int64(40) << 20; groups[0].Reclaim != want {
+		t.Errorf("reclaim %d, want %d", groups[0].Reclaim, want)
+	}
+	for i := 1; i < len(groups[0].Files); i++ {
+		if groups[0].Files[i-1].Mtime > groups[0].Files[i].Mtime {
+			t.Fatalf("copies not by mtime: %v", ids(groups[0].Files))
+		}
+	}
+}
+
+// fakeLister serves a tree of folders.
+type fakeLister struct {
+	mu    sync.Mutex
+	tree  map[string][]baidu.File
+	dirs  []string
+	sleep time.Duration
+}
+
+func (l *fakeLister) List(ctx context.Context, dir string, _ baidu.Order) ([]baidu.File, error) {
+	l.mu.Lock()
+	l.dirs = append(l.dirs, dir)
+	files, ok := l.tree[dir]
+	l.mu.Unlock()
+	if l.sleep > 0 {
+		select {
+		case <-time.After(l.sleep):
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	if !ok {
+		return nil, errors.New("no such folder: " + dir)
+	}
+	return files, nil
+}
+
+func (l *fakeLister) seen() []string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return append([]string(nil), l.dirs...)
+}
+
+func file(path string, size int64, md5 string) baidu.File {
+	return baidu.File{Path: path, Name: pathBase(path), Size: size, MD5: md5}
+}
+
+func dir(path string) baidu.File {
+	return baidu.File{Path: path, Name: pathBase(path), IsDir: true}
+}
+
+func TestScan(t *testing.T) {
+	tree := map[string][]baidu.File{
+		"/":       {dir("/a"), dir("/b"), file("/root.txt", 1, "r")},
+		"/a":      {dir("/a/deep"), file("/a/x.txt", 1, "x")},
+		"/a/deep": {file("/a/deep/y.txt", 2, "y")},
+		"/b":      {file("/b/z.txt", 3, "z")},
+	}
+	l := &fakeLister{tree: tree}
+	var progress []Progress
+	res, err := Scan(context.Background(), l, Options{Root: "/", Concurrency: 2, Report: func(p Progress) {
+		progress = append(progress, p)
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Dirs != 4 || len(res.Files) != 4 || len(res.Failed) != 0 || res.Truncated {
+		t.Errorf("result %+v", res)
+	}
+	paths := map[string]bool{}
+	for _, f := range res.Files {
+		paths[f.Path] = true
+	}
+	for _, want := range []string{"/root.txt", "/a/x.txt", "/a/deep/y.txt", "/b/z.txt"} {
+		if !paths[want] {
+			t.Errorf("%s missing from %v", want, paths)
+		}
+	}
+	if len(progress) != 4 || progress[len(progress)-1].Files != 4 {
+		t.Errorf("progress %+v", progress)
+	}
+}
+
+func TestScanSubfolder(t *testing.T) {
+	l := &fakeLister{tree: map[string][]baidu.File{
+		"/":    {dir("/one"), dir("/two")},
+		"/one": {file("/one/a", 1, "a")},
+		"/two": {file("/two/b", 1, "b")},
+	}}
+	res, err := Scan(context.Background(), l, Options{Root: "/one"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Dirs != 1 || len(res.Files) != 1 || res.Files[0].Path != "/one/a" {
+		t.Errorf("result %+v", res)
+	}
+	for _, d := range l.seen() {
+		if d == "/" {
+			t.Error("scanned above its root")
+		}
+	}
+}
+
+func TestScanCaps(t *testing.T) {
+	tree := map[string][]baidu.File{
+		"/": {},
+	}
+	for i := range 10 {
+		p := fmt.Sprintf("/d%d", i)
+		tree["/"] = append(tree["/"], dir(p))
+		tree[p] = []baidu.File{file(p+"/a", 1, "a"), file(p+"/b", 1, "b")}
+	}
+	l := &fakeLister{tree: tree}
+	res, err := Scan(context.Background(), l, Options{Root: "/", MaxFiles: 5, MaxDirs: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !res.Truncated {
+		t.Error("not truncated at the caps")
+	}
+	if len(res.Files) > 5 || len(l.seen()) > 4 {
+		t.Errorf("%d files, %d folders", len(res.Files), len(l.seen()))
+	}
+}
+
+// TestScanFailedFolder goes on past a folder it cannot read, and reports
+// the root's own error.
+func TestScanFailedFolder(t *testing.T) {
+	l := &fakeLister{tree: map[string][]baidu.File{
+		"/":   {dir("/gone"), dir("/ok")},
+		"/ok": {file("/ok/a", 1, "a")},
+	}}
+	res, err := Scan(context.Background(), l, Options{Root: "/"})
+	if err != nil {
+		t.Fatalf("a folder missing stopped the scan: %v", err)
+	}
+	if len(res.Failed) != 1 || res.Failed[0] != "/gone" || len(res.Files) != 1 {
+		t.Errorf("result %+v", res)
+	}
+	if _, err := Scan(context.Background(), l, Options{Root: "/missing"}); err == nil {
+		t.Error("a missing root read without error")
+	}
+}
+
+func TestScanCancel(t *testing.T) {
+	l := &fakeLister{tree: map[string][]baidu.File{
+		"/":    {dir("/a")},
+		"/a":   {dir("/a/b")},
+		"/a/b": {},
+	}, sleep: 10 * time.Millisecond}
+	ctx, cancel := context.WithCancel(context.Background())
+	var n atomic.Int32
+	res, err := Scan(ctx, l, Options{Root: "/", Report: func(Progress) {
+		if n.Add(1) == 1 {
+			cancel()
+		}
+	}})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("err %v", err)
+	}
+	_ = res
+}
+
+// TestScanDedupes keeps one entry per fs_id, as a listing repeated across
+// pages may give.
+func TestScanDedupes(t *testing.T) {
+	a := file("/a/x", 1, "x")
+	a.FsID = 7
+	b := a
+	b.Path = "/a/y"
+	l := &fakeLister{tree: map[string][]baidu.File{"/": {dir("/a")}, "/a": {a, b}}}
+	res, err := Scan(context.Background(), l, Options{Root: "/"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(res.Files) != 1 {
+		t.Errorf("%d files, want one fs_id", len(res.Files))
+	}
+}
+
+// TestGroupAfterScan runs a scan and the grouping together, as the page
+// does.
+func TestGroupAfterScan(t *testing.T) {
+	dup := []byte("the same bytes")
+	l := &fakeLister{tree: map[string][]baidu.File{
+		"/": {
+			dir("/photos"),
+			file("/one.txt", int64(len(dup)), "abc"),
+			file("/no-hash.txt", 10, ""),
+		},
+		"/photos": {
+			file("/photos/one-copy.txt", int64(len(dup)), "abc"),
+			file("/photos/zero.txt", 0, "zero"),
+		},
+	}}
+	res, err := Scan(context.Background(), l, Options{Root: "/"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	groups, skipped := Groups(res.Files)
+	if len(groups) != 1 || len(groups[0].Files) != 2 {
+		t.Errorf("groups %+v", groups)
+	}
+	if skipped != 1 {
+		t.Errorf("skipped %d", skipped)
+	}
+	if groups[0].Reclaim != int64(len(dup)) {
+		t.Errorf("reclaim %d", groups[0].Reclaim)
+	}
+}
+
+// TestRootCleaning reads a root given with or without its leading slash.
+func TestRootCleaning(t *testing.T) {
+	for _, root := range []string{"/a", "a", "a/", "/a/"} {
+		l := &fakeLister{tree: map[string][]baidu.File{"/a": {}}}
+		if _, err := Scan(context.Background(), l, Options{Root: root}); err != nil {
+			t.Errorf("%q: %v", root, err)
+		}
+	}
+	if path.Clean("/a") != "/a" {
+		t.Fatal("path.Clean changed")
+	}
+}
