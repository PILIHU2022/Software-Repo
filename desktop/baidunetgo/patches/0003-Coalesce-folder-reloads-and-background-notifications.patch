+// TestFinishedNotice tells how the transfers that finish together are
+// gathered: one keeps its own title and ID, several say how many and name
+// the latest.
+func TestFinishedNotice(t *testing.T) {
+	var g finishedNotice
+	g.add("上传", "dir:/照片", "一.png")
+	if title, body, id := g.message(); title != "上传完成" || body != "一.png" || id != "dir:/照片" {
+		t.Errorf("one says %q, %q, %q", title, body, id)
+	}
+	g.add("下载", "file:/tmp/二.mkv", "二.mkv")
+	g.add("上传", "dir:/照片", "三.png")
+	if title, body, id := g.message(); title != "3 个文件传输完成" || body != "三.png" || id != "dir:/照片" {
+		t.Errorf("three say %q, %q, %q", title, body, id)
+	}
+	g.reset()
+	if g.n != 0 || g.timer != nil {
+		t.Errorf("reset left %+v", g)
+	}
+}
+
+// TestReloadSoonCoalesces reads a folder once for a burst of finished
+// transfers in it, reloadDelay later, and does not read one not cached.
+func TestReloadSoonCoalesces(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	old := reloadDelay
+	reloadDelay = 25 * time.Millisecond
+	t.Cleanup(func() { reloadDelay = old })
+
+	l := a.listings["/"]
+	loads := l.loads
+	srv.Add(fakepan.Node{Path: "/批量完成.txt", Data: []byte("hi")})
+	a.reloadSoon("/")
+	a.reloadSoon("/")
+	a.reloadSoon("/")
+	deadline := time.Now().Add(3 * time.Second)
+	for !tt.HasText("批量完成.txt") {
+		if time.Now().After(deadline) {
+			t.Fatalf("never read the folder again: %+v", a.transfers.tasks)
+		}
+		time.Sleep(10 * time.Millisecond)
+		tt.Advance(20 * time.Millisecond)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if got := l.loads; got != loads+1 {
+		t.Errorf("read the folder %d times, want once", got-loads)
+	}
+	a.reloadSoon("/没有缓存")
+	if len(a.reloads) != 0 {
+		t.Errorf("a folder not cached waits to be read: %v", a.reloads)
+	}
+}
