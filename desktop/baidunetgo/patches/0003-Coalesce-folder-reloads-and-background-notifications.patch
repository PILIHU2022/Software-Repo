+// reloadSoon reads a directory again after reloadDelay, so that the many
+// files of an upload finishing one after another cause one read, not one
+// each. A folder not cached is not read.
+func (a *App) reloadSoon(dir string) {
+	if a.listings[dir] == nil {
+		return
+	}
+	if a.reloads == nil {
+		a.reloads = map[string]*time.Timer{}
+	}
+	if a.reloads[dir] != nil {
+		return
+	}
+	a.reloads[dir] = time.AfterFunc(reloadDelay, func() {
+		a.update(func() {
+			delete(a.reloads, dir)
+			a.reload(dir)
+		})
+	})
+}
+
+// stopReloads cancels the reads waiting to happen, as a session ends.
+func (a *App) stopReloads() {
+	for dir, timer := range a.reloads {
+		timer.Stop()
+		delete(a.reloads, dir)
+	}
+}
