diff --git a/app/transfers.go b/app/transfers.go
index 474b945..dfb0936 100644
--- a/app/transfers.go
+++ b/app/transfers.go
@@ -24,6 +24,49 @@ type transfersState struct {
 	list    ui.ListState
 	speeds  []float64 // the total speed each second, the latest last
 	sampled time.Time // when speeds last took a sample
+	notice  finishedNotice
+}
+
+// noticeDelay is how long finished transfers are gathered while the window
+// is in the background: those within it make one notification.
+var noticeDelay = 2 * time.Second
+
+// finishedNotice gathers the transfers that finish while the window is in
+// the background, so that many small files make one notification, not one
+// each. It is changed on the main thread only.
+type finishedNotice struct {
+	n     int
+	verb  string // "上传" or "下载", of the first
+	id    string // the latest's, to open what it says
+	name  string // the first file's name
+	last  string // the latest file's name
+	timer *time.Timer
+}
+
+// add gathers another finished transfer.
+func (g *finishedNotice) add(verb, id, name string) {
+	if g.n == 0 {
+		g.verb, g.name = verb, name
+	}
+	g.n++
+	g.id, g.last = id, name
+}
+
+// message is what the gathered transfers say: one as it always did, else
+// how many finished, with the latest file's name and its ID.
+func (g *finishedNotice) message() (title, body, id string) {
+	if g.n <= 1 {
+		return g.verb + "完成", g.name, g.id
+	}
+	return itoa(g.n) + " 个文件传输完成", g.last, g.id
+}
+
+// reset forgets what gathered, and the notification waiting to show it.
+func (g *finishedNotice) reset() {
+	if g.timer != nil {
+		g.timer.Stop()
+	}
+	*g = finishedNotice{}
 }
 
 // startTransfers starts the queue of a session.
@@ -65,6 +108,7 @@ func (a *App) stopTransfers() {
