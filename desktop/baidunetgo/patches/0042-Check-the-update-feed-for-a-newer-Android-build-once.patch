+    // ------------------------------------------------------------- updates
+
+    /**
+     * One silent check per launch, about 30 s after sign-in, when
+     * 自动检查更新 is on. Scheduled at most once per process.
+     */
+    private fun scheduleAutoUpdateCheck() {
+        if (autoUpdateCheckScheduled) return
+        autoUpdateCheckScheduled = true
+        viewModelScope.launch {
+            delay(AUTO_UPDATE_CHECK_DELAY_MS)
+            if (_ui.value.settings.autoCheckUpdates) checkForUpdates(manual = false)
+        }
+    }
+
+    /**
+     * Asks the update feed for the newest release ([UpdateUiState] carries the
+     * outcome). Automatic checks are throttled to one per hour per process and
+     * report nothing unless an update is available; a manual check (检查更新
+     * row) always goes out and always reports its result.
+     */
+    fun checkForUpdates(manual: Boolean) {
+        if (_ui.value.update is UpdateUiState.Checking) return
+        val now = System.currentTimeMillis()
+        if (!manual && now - lastUpdateCheckAt < UPDATE_CHECK_THROTTLE_MS) return
+        lastUpdateCheckAt = now
+        viewModelScope.launch {
+            _ui.update { it.copy(update = UpdateUiState.Checking) }
+            val outcome = try {
+                val info = withContext(Dispatchers.IO) {
+                    updateChecker.check(BuildConfig.UPDATE_FEED_URL)
+                }
+                val raw = when {
+                    info == null -> UpdateUiState.Error
+                    !UpdateLogic.isNewer(info, BuildConfig.VERSION_CODE) ->
+                        UpdateUiState.UpToDate(info.versionName.ifBlank { null })
+                    // A version the user ignored never auto-pops again, but a
+                    // manual check still offers it.
+                    manual || UpdateLogic.mayAutoShow(info, _ui.value.settings.ignoredVersionCode) ->
+                        UpdateUiState.Available(info, fromAutoCheck = !manual)
+                    else -> UpdateUiState.Idle
+                }
+                // Automatic checks stay silent unless a dialog is warranted.
+                when {
+                    raw is UpdateUiState.Available -> raw
+                    raw is UpdateUiState.UpToDate && manual -> raw
+                    raw is UpdateUiState.Error && manual -> raw
+                    else -> UpdateUiState.Idle
+                }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                // Automatic failures are silent; manual ones tell the user.
+                if (manual) UpdateUiState.Error else UpdateUiState.Idle
+            }
+            _ui.update { it.copy(update = outcome) }
+        }
