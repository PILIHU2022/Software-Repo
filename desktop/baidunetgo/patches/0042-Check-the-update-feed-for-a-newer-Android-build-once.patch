+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.text.style.TextOverflow
+import androidx.compose.ui.unit.dp
+import com.pengstem.baidunetgo.R
+import com.pengstem.baidunetgo.data.UpdateInfo
+
+/**
+ * 有新版本 dialog: the feed's release notes (scrollable, ellipsized), the
+ * running version, and three actions — 忽略此版本 (persisted, never auto-pops
+ * for that release again), 去下载 (browser download of the APK, falling back
+ * to the F-Droid page when the feed has no APK link) and 打开 F-Droid (only
+ * when the feed advertises an F-Droid URL).
+ *
+ * Nothing is ever downloaded or installed by the app itself: every action is
+ * a plain `ACTION_VIEW` on an https URL, and a device that cannot open it
+ * gets a toast instead of a crash.
+ */
+@Composable
+fun UpdateDialog(
+    info: UpdateInfo,
+    currentVersionName: String,
+    onIgnore: () -> Unit,
+    onDismiss: () -> Unit,
+) {
+    val context = LocalContext.current
+    // 去下载 prefers the direct APK link; a feed without one still offers the
+    // F-Droid page.
+    val downloadUrl = info.apkUrl.ifBlank { info.fdroidUrl }
+
+    ExpressiveDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(R.string.update_available_title, info.versionName)) },
+        text = {
+            Column(
+                modifier = Modifier
+                    .heightIn(max = 320.dp)
+                    .verticalScroll(rememberScrollState()),
+                verticalArrangement = Arrangement.spacedBy(10.dp),
+            ) {
+                if (info.notes.isNotBlank()) {
+                    Text(
+                        text = info.notes,
+                        style = MaterialTheme.typography.bodyMedium,
+                        maxLines = 8,
+                        overflow = TextOverflow.Ellipsis,
+                    )
+                }
+                Text(
+                    text = stringResource(R.string.update_current_version, currentVersionName),
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+        },
+        confirmButton = {
+            Row(horizontalArrangement = Arrangement.spacedBy(4.dp), verticalAlignment = Alignment.CenterVertically) {
+                if (info.fdroidUrl.isNotBlank()) {
+                    TextButton(onClick = { openUrl(context, info.fdroidUrl) }) {
+                        Text(stringResource(R.string.update_open_fdroid))
+                    }
+                }
+                if (downloadUrl.isNotBlank()) {
+                    FilledTonalButton(onClick = { openUrl(context, downloadUrl) }) {
+                        Text(stringResource(R.string.update_download))
+                    }
+                }
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = {
+                onIgnore()
+                onDismiss()
+            }) {
+                Text(stringResource(R.string.update_ignore))
+            }
+        },
+    )
+}
+
+/**
+ * Opens an https URL in whatever app handles it. `startActivity` is tried
+ * inside a catch: resolving the handler through the package manager first
+ * would need `<queries>` declarations and silently fails on API 30+, while a
+ * missing handler surfaces here as [ActivityNotFoundException] — shown as a
+ * toast, never a crash.
+ */
+private fun openUrl(context: Context, url: String) {
+    if (url.isBlank()) return
+    try {
+        context.startActivity(
+            Intent(Intent.ACTION_VIEW, Uri.parse(url)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK),
+        )
+    } catch (e: ActivityNotFoundException) {
+        Toast.makeText(context, R.string.update_no_browser, Toast.LENGTH_SHORT).show()
+    } catch (e: Exception) {
+        // SecurityException et al. — still no crash, same user-visible result.
+        Toast.makeText(context, R.string.update_no_browser, Toast.LENGTH_SHORT).show()
+    }
+}
