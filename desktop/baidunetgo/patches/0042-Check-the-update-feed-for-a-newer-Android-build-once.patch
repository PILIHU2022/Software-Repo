@@ -0,0 +1,150 @@
+package com.pengstem.baidunetgo.data
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+/**
+ * One release advertised by the update feed
+ * (`https://software.sparkzh.top/baidunetgo/update.json`).
+ *
+ * Every field except `versionCode` is tolerated to be missing or blank in the
+ * feed; the UI degrades (falls back to the F-Droid link, hides the notes…)
+ * instead of failing the whole check.
+ */
+data class UpdateInfo(
+    /** Release versionCode; the only field the comparison uses. */
+    val versionCode: Int,
+    /** Display name, e.g. "0.9.0"; empty when the feed omits it. */
+    val versionName: String,
+    /** Human-readable release notes (Chinese), shown in the update dialog. */
+    val notes: String,
+    /** Direct APK link the browser downloads; empty means "use F-Droid". */
+    val apkUrl: String,
+    /** F-Droid package/repo page; optional. */
+    val fdroidUrl: String,
+)
+
+/**
+ * Parses the update feed document. Kept pure (no Android, no network) so it
+ * is unit-testable on the JVM.
+ *
+ * Feed contract (all but `versionCode` optional, unknown keys ignored):
+ * ```json
+ * {
+ *   "versionCode": 804,
+ *   "versionName": "0.8.4",
+ *   "notes": "修复…",
+ *   "apk": "https://…/baidunetgo-0.8.4.apk",
+ *   "fdroid": "https://f-droid.org/packages/com.pengstem.baidunetgo"
+ * }
+ * ```
+ */
+object UpdateFeedParser {
+
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /** The newest release, or null when the body is not a usable feed document. */
+    fun parse(text: String?): UpdateInfo? {
+        if (text.isNullOrBlank()) return null
+        return runCatching {
+            val obj = json.parseToJsonElement(text).jsonObject
+            val code = obj["versionCode"]?.jsonPrimitive?.content?.toIntOrNull() ?: return null
+            UpdateInfo(
+                versionCode = code,
+                versionName = obj.text("versionName"),
+                notes = obj.text("notes"),
+                apkUrl = obj.text("apk"),
+                fdroidUrl = obj.text("fdroid"),
+            )
+        }.getOrNull()
+    }
+
+    private fun kotlinx.serialization.json.JsonObject.text(key: String): String {
+        val element = this[key] ?: return ""
+        // JsonNull.content is the literal "null", so nulls must be filtered
+        // before they can leak into the strings.
+        if (element is kotlinx.serialization.json.JsonNull) return ""
+        return runCatching { element.jsonPrimitive.content }.getOrNull()?.trim().orEmpty()
+    }
+}
+
+/**
+ * Version comparison and dialog-suppression rules, pure so tests cover them:
+ * a feed entry is an update only when its versionCode is strictly greater
+ * than the running build's, and the auto-pop never returns for a version the
+ * user ignored (a manual check still offers it).
+ */
+object UpdateLogic {
+
+    /** Whether [info] is a newer release than the running build. */
+    fun isNewer(info: UpdateInfo, currentVersionCode: Int): Boolean =
+        info.versionCode > currentVersionCode
+
+    /**
+     * Whether an automatically triggered check may pop the dialog for [info]:
+     * never for a version the user already ignored.
+     */
+    fun mayAutoShow(info: UpdateInfo, ignoredVersionCode: Int): Boolean =
+        info.versionCode > ignoredVersionCode
+}
+
+/**
+ * Fetches the update feed: a single plain HTTPS GET with a 10 s timeout.
+ * Deliberately `HttpURLConnection` (JDK) instead of OkHttp — `:core` keeps
+ * okhttp as an `implementation` dependency, so it is not on `:app`'s compile
+ * classpath, and adding it would mean a new dependency or catalog entry.
+ *
+ * Failures are reported as null; the caller keeps them silent for automatic
+ * checks. No request/response data is logged (the URL is not a secret, but
+ * this class never logs anything at all).
+ */
+class UpdateChecker {
+
+    /** The feed document parsed into [UpdateInfo], or null on any failure. */
+    suspend fun check(feedUrl: String): UpdateInfo? = withContext(Dispatchers.IO) {
+        runCatching {
+            val body = fetch(feedUrl) ?: return@withContext null
+            UpdateFeedParser.parse(body)
+        }.getOrNull()
+    }
+
+    private fun fetch(feedUrl: String): String? {
+        val connection = (java.net.URI(feedUrl).toURL().openConnection() as java.net.HttpURLConnection).apply {
+            connectTimeout = TIMEOUT_MS
+            readTimeout = TIMEOUT_MS
+            requestMethod = "GET"
+            instanceFollowRedirects = true
+            setRequestProperty("Accept", "application/json")
+        }
+        try {
+            val code = connection.responseCode
+            if (code !in 200..299) return null
+            // The feed is a small JSON document; cap the read so a hostile or
+            // broken mirror cannot make the app buffer megabytes.
+            val stream = connection.inputStream
+            val bytes = stream.use { input ->
+                val buffer = java.io.ByteArrayOutputStream()
+                val chunk = ByteArray(8 * 1024)
+                var total = 0
+                while (total < MAX_BODY_BYTES) {
+                    val read = input.read(chunk)
+                    if (read < 0) break
+                    buffer.write(chunk, 0, read)
+                    total += read
+                }
+                buffer.toByteArray()
+            }
+            return String(bytes, Charsets.UTF_8)
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private companion object {
+        const val TIMEOUT_MS = 10_000
+        const val MAX_BODY_BYTES = 256 * 1024
+    }
+}
