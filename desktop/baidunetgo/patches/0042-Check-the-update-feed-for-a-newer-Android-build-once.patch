index 0000000..3bccaff
--- /dev/null
+++ b/android/app/src/test/java/com/pengstem/baidunetgo/data/UpdateFeedParserTest.kt
@@ -0,0 +1,136 @@
+package com.pengstem.baidunetgo.data
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * JVM tests for the update-check logic in `:app`: the feed JSON parser, the
+ * version comparison / ignore rules, and the new settings keys' codec
+ * behaviour (defaults for legacy documents). No Android APIs involved.
+ */
+class UpdateFeedParserTest {
+
+    // ---- feed parser -----------------------------------------------------
+
+    @Test
+    fun parseFullDocument() {
+        val info = UpdateFeedParser.parse(
+            """
+            {
+              "versionCode": 804,
+              "versionName": "0.8.4",
+              "notes": "修复相册备份中断的问题。",
+              "apk": "https://example.com/baidunetgo-0.8.4.apk",
+              "fdroid": "https://f-droid.org/packages/com.pengstem.baidunetgo"
+            }
+            """.trimIndent(),
+        )
+        assertEquals(
+            UpdateInfo(
+                versionCode = 804,
+                versionName = "0.8.4",
+                notes = "修复相册备份中断的问题。",
+                apkUrl = "https://example.com/baidunetgo-0.8.4.apk",
+                fdroidUrl = "https://f-droid.org/packages/com.pengstem.baidunetgo",
+            ),
+            info,
+        )
+    }
+
+    @Test
+    fun parseToleratesMissingAndNullFields() {
+        val info = UpdateFeedParser.parse("""{"versionCode": 900}""")
+        assertEquals(900, info?.versionCode)
+        assertEquals("", info?.versionName)
+        assertEquals("", info?.notes)
+        assertEquals("", info?.apkUrl)
+        assertEquals("", info?.fdroidUrl)
+
+        val withNulls = UpdateFeedParser.parse(
+            """{"versionCode": 901, "versionName": null, "notes": null, "apk": null, "fdroid": null}""",
+        )
+        assertEquals(901, withNulls?.versionCode)
+        assertEquals("", withNulls?.versionName)
+    }
+
+    @Test
+    fun parseIgnoresUnknownKeys() {
+        val info = UpdateFeedParser.parse(
+            """{"versionCode": 902, "channel": "beta", "sha256": "abc", "extra": {"a": 1}}""",
+        )
+        assertEquals(902, info?.versionCode)
+        assertEquals("", info?.versionName) // no leaked extras
+    }
+
+    @Test
+    fun parseGarbageReturnsNull() {
+        assertNull(UpdateFeedParser.parse(null))
+        assertNull(UpdateFeedParser.parse(""))
+        assertNull(UpdateFeedParser.parse("   "))
+        assertNull(UpdateFeedParser.parse("{not json"))
+        assertNull(UpdateFeedParser.parse("[]"))
+        assertNull(UpdateFeedParser.parse("\"just a string\""))
+        assertNull(UpdateFeedParser.parse("{}")) // missing versionCode
+        assertNull(UpdateFeedParser.parse("""{"versionCode": "eight-oh-four"}"""))
+        assertNull(UpdateFeedParser.parse("""{"versionCode": null}"""))
+    }
+
+    @Test
+    fun parseAcceptsNumericStringVersionCode() {
+        // A feed that quotes the code ("804") is still usable.
+        val info = UpdateFeedParser.parse("""{"versionCode": "804"}""")
+        assertEquals(804, info?.versionCode)
+    }
+
+    @Test
+    fun parseTrimsWhitespaceUrls() {
+        val info = UpdateFeedParser.parse(
+            """{"versionCode": 903, "apk": "  https://example.com/a.apk  "}""",
+        )
+        assertEquals("https://example.com/a.apk", info?.apkUrl)
+    }
+
+    // ---- version comparison / ignore rules --------------------------------
+
+    private fun info(code: Int) = UpdateInfo(code, "x", "", "", "")
+
+    @Test
+    fun newerByVersionCode() {
+        assertTrue(UpdateLogic.isNewer(info(804), 803))
+        assertFalse(UpdateLogic.isNewer(info(803), 803)) // equal build
+        assertFalse(UpdateLogic.isNewer(info(802), 803)) // older build
+    }
+
+    @Test
+    fun ignoredVersionNeverAutoShows() {
+        // 804 was ignored: auto checks stay silent for it and anything older.
+        assertFalse(UpdateLogic.mayAutoShow(info(804), ignoredVersionCode = 804))
+        assertFalse(UpdateLogic.mayAutoShow(info(803), ignoredVersionCode = 804))
+        assertTrue(UpdateLogic.mayAutoShow(info(805), ignoredVersionCode = 804))
+        assertTrue(UpdateLogic.mayAutoShow(info(804), ignoredVersionCode = 0))
+    }
+
+    // ---- settings codec (new keys) ----------------------------------------
+
+    @Test
+    fun settingsRoundTripKeepsUpdateKeys() {
+        val settings = AppSettings(autoCheckUpdates = false, ignoredVersionCode = 804)
+        assertEquals(settings, SecureJson.decodeSettings(SecureJson.encodeSettings(settings)))
+    }
+
+    @Test
+    fun settingsLegacyDocumentDefaultsUpdateKeys() {
+        // A settings document written before the update checker existed must
+        // default to auto-check-on and nothing ignored.
+        val decoded = SecureJson.decodeSettings("""{"dest":"/备份"}""")
+        assertTrue(decoded.autoCheckUpdates)
+        assertEquals(0, decoded.ignoredVersionCode)
+        // A corrupt value falls back to the default instead of crashing.
+        val bad = SecureJson.decodeSettings("""{"autoCheckUpdates":"yes","ignoredVersionCode":"NaN"}""")
+        assertTrue(bad.autoCheckUpdates)
+        assertEquals(0, bad.ignoredVersionCode)
+    }
+}
