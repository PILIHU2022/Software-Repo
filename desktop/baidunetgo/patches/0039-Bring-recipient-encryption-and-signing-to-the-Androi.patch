+package com.pengstem.baidunetgo.core.crypto
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.After
+import org.junit.Assume.assumeTrue
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.IOException
+import java.util.Random
+import java.util.concurrent.TimeUnit
+
+/**
+ * Public-key (recipient) encryption and signing with [Pgp]: generated keys
+ * round-trip with each other and with the real `gpg` 2.4 in both directions.
+ *
+ * `gpg` is required; the class skips itself cleanly when it is absent. Every
+ * test gets a throw-away `GNUPGHOME`, so nothing touches the machine's keyrings.
+ */
+class PgpKeysTest {
+
+    @get:Rule
+    val tmp = TemporaryFolder()
+
+    private val passphrase = "correct horse battery staple"
+
+    private lateinit var gnupgHome: File
+
+    @Before
+    fun setUp() {
+        assumeTrue("gpg is required for the OpenPGP interop tests", gpgAvailable())
+        // gpg-agent binds its control sockets under GNUPGHOME, so the home must
+        // be a short path (the 108-byte Unix socket limit) and owner-only (0700),
+        // which a long build/tmp path or a loose TemporaryFolder mode breaks.
+        gnupgHome = File("/tmp", "bng-gpg-" + java.lang.Long.toHexString(System.nanoTime()))
+        gnupgHome.mkdir()
+        gnupgHome.setReadable(false, false)
+        gnupgHome.setWritable(false, false)
+        gnupgHome.setExecutable(false, false)
+        gnupgHome.setReadable(true, true)
+        gnupgHome.setWritable(true, true)
+        gnupgHome.setExecutable(true, true)
+    }
+
+    @After
+    fun tearDown() {
+        gnupgHome.deleteRecursively()
+    }
+
+    // -----------------------------------------------------------------------
+    // Kotlin-only round trips
+    // -----------------------------------------------------------------------
+
+    @Test
+    fun generatedPairRoundTripsInKotlin() {
+        val pair = generated()
+        val keys = Pgp.readPublicKeys(pair.publicArmored)
+        assertEquals("one public block is one key", 1, keys.size)
+        val recipient = keys.first()
+        assertEquals("Backup 测试 <test@example.com>", recipient.userId)
+        assertEquals(false, recipient.isPrivate)
+
+        val payload = randomBytes(64 shl 10)
+        val encrypted = ByteArrayOutputStream()
+        Pgp.encrypt(encrypted, payload.inputStream(), recipients = listOf(recipient))
+
+        val plain = ByteArrayOutputStream()
+        val result = Pgp.decrypt(plain, encrypted.toByteArray().inputStream(), keys = listOf(readSecret(pair)))
+        assertArrayEquals("the recipient's key decrypts", payload, plain.toByteArray())
+        assertNull("an unsigned message has no signer", result.signedByKeyId)
+        assertNull(result.signedByName)
+        assertEquals(false, result.verified)
+    }
+
+    @Test
+    fun twoRecipientsEitherKeyDecrypts() {
+        val (first, second) = Pair(generated(), generated())
+        val payload = randomBytes(16 shl 10)
+        val encrypted = ByteArrayOutputStream()
+        Pgp.encrypt(
+            encrypted,
+            payload.inputStream(),
+            recipients = listOf(
+                Pgp.readPublicKeys(first.publicArmored).first(),
+                Pgp.readPublicKeys(second.publicArmored).first(),
+            ),
+        )
+
+        for (pair in listOf(first, second)) {
+            val plain = ByteArrayOutputStream()
+            Pgp.decrypt(plain, encrypted.toByteArray().inputStream(), keys = listOf(readSecret(pair)))
+            assertArrayEquals("each recipient can decrypt", payload, plain.toByteArray())
+        }
+    }
+
+    @Test
+    fun passphraseAndRecipientsWorkTogether() {
+        val pair = generated()
+        val payload = randomBytes(8 shl 10)
+        val encrypted = ByteArrayOutputStream()
+        Pgp.encrypt(
+            encrypted,
+            payload.inputStream(),
+            passphrase = passphrase.toCharArray(),
+            recipients = listOf(Pgp.readPublicKeys(pair.publicArmored).first()),
+        )
+
+        val withKey = ByteArrayOutputStream()
+        Pgp.decrypt(withKey, encrypted.toByteArray().inputStream(), keys = listOf(readSecret(pair)))
+        assertArrayEquals("the key alone decrypts", payload, withKey.toByteArray())
+
+        val withPassphrase = ByteArrayOutputStream()
+        Pgp.decrypt(withPassphrase, encrypted.toByteArray().inputStream(), passphrase.toCharArray())
+        assertArrayEquals("the passphrase alone decrypts too", payload, withPassphrase.toByteArray())
+    }
+
+    @Test
+    fun signatureIsVerifiedAndTamperingThrows() {
+        val pair = generated()
+        val other = generated()
+        val payload = randomBytes(32 shl 10)
+        val encrypted = ByteArrayOutputStream()
+        Pgp.encrypt(
+            encrypted,
+            payload.inputStream(),
+            passphrase = "vault".toCharArray(),
+            recipients = listOf(Pgp.readPublicKeys(other.publicArmored).first()),
+            signer = readSecret(pair),
+        )
+
+        val result = Pgp.decrypt(
+            ByteArrayOutputStream(),
+            encrypted.toByteArray().inputStream(),
+            "vault".toCharArray(),
+            keys = listOf(readSecret(other), readSecret(pair)),
+        )
+        assertEquals("the signature verifies", true, result.verified)
+        assertEquals(publicKey(pair).keyId, result.signedByKeyId)
+        assertEquals("Backup 测试 <test@example.com>", result.signedByName)
+
+        // One flipped byte of ciphertext must break the signature (or the MDC).
+        val tampered = encrypted.toByteArray().also { it[it.size / 2] = (it[it.size / 2] + 1).toByte() }
+        try {
+            Pgp.decrypt(
+                ByteArrayOutputStream(),
+                ByteArrayInputStream(tampered),
+                "vault".toCharArray(),
+                keys = listOf(readSecret(other), readSecret(pair)),
+            )
+            fail("a tampered signed message must throw")
+        } catch (expected: PgpSignatureException) {
+            assertTrue("the message must be user facing: ${expected.message}", expected.message!!.contains("签名"))
+        }
+    }
+
+    @Test
+    fun unknownSignerThrows() {
+        val signer = generated()
+        val recipient = generated()
+        val encrypted = ByteArrayOutputStream()
+        Pgp.encrypt(
+            encrypted,
+            randomBytes(4096).inputStream(),
+            recipients = listOf(Pgp.readPublicKeys(recipient.publicArmored).first()),
+            signer = readSecret(signer),
+        )
+        try {
+            Pgp.decrypt(
+                ByteArrayOutputStream(),
+                encrypted.toByteArray().inputStream(),
+                keys = listOf(readSecret(recipient)), // the signer's key is not here
+            )
+            fail("an untrusted signature must throw")
+        } catch (expected: PgpSignatureException) {
+            assertTrue(expected.message!!.contains("公钥"))
+        }
+    }
+
+    @Test
+    fun signingWithoutSecretOrPassphraseFailsClearly() {
+        val pair = generated()
+        val recipient = Pgp.readPublicKeys(pair.publicArmored).first()
+        // A public-only key cannot sign.
+        try {
+            Pgp.encrypt(
+                ByteArrayOutputStream(),
+                randomBytes(64).inputStream(),
+                passphrase = "vault".toCharArray(),
+                recipients = listOf(recipient),
+                signer = recipient,
+            )
+            fail("signing with a public-only key must throw")
+        } catch (expected: PgpException) {
+            assertTrue(expected.message!!.contains("私钥"))
+        }
+        // A secret ring whose passphrase was never given cannot sign either
+        // (readPublicKeys does not remember one).
+        try {
+            Pgp.encrypt(
+                ByteArrayOutputStream(),
+                randomBytes(64).inputStream(),
+                passphrase = "vault".toCharArray(),
+                recipients = listOf(recipient),
+                signer = Pgp.readPublicKeys(generated().privateArmored).first(),
+            )
+            fail("signing without any passphrase must throw")
+        } catch (expected: PgpException) {
+            assertTrue(expected.message!!.contains("口令"))
+        }
+    }
+
+    @Test
+    fun wrongSignerPassphraseFailsClearly() {
+        val pair = generated()
+        val recipient = Pgp.readPublicKeys(pair.publicArmored).first()
+        try {
+            Pgp.encrypt(
+                ByteArrayOutputStream(),
+                randomBytes(64).inputStream(),
+                passphrase = "vault".toCharArray(),
+                recipients = listOf(recipient),
+                signer = readSecret(pair),
+                signerPassphrase = "wrong".toCharArray(),
+            )
+            fail("signing with the wrong passphrase must throw")
+        } catch (expected: PgpException) {
+            assertTrue(expected.message!!.contains("口令"))
+        }
+    }
+
+    @Test
+    fun encryptNeedsAPassphraseOrARecipient() {
+        try {
+            Pgp.encrypt(ByteArrayOutputStream(), randomBytes(64).inputStream())
+            fail("encrypting to nobody must throw")
+        } catch (expected: PgpException) {
+            assertTrue(expected.message!!.contains("接收人"))
+        }
+    }
+
+    @Test
+    fun readPrivateKeyVerifiesPassphraseAndReadsSeveralBlocks() {
+        val first = generated()
+        val second = generated()
+        try {
+            Pgp.readPrivateKey(first.privateArmored, "wrong".toCharArray())
+            fail("a wrong private-key passphrase must throw at import")
+        } catch (expected: PgpException) {
+            assertTrue(expected.message!!.contains("口令"))
+        }
+        val key = Pgp.readPrivateKey(first.privateArmored, passphrase.toCharArray())
+        assertEquals(true, key.isPrivate)
+
+        val both = first.publicArmored + second.publicArmored
+        assertEquals("two concatenated blocks are two keys", 2, Pgp.readPublicKeys(both).size)
+    }
+
+    @Test
+    fun wrongPrivateKeyPassphraseFailsAtDecrypt() {
+        val pair = generated()
+        val encrypted = ByteArrayOutputStream()
+        Pgp.encrypt(encrypted, randomBytes(64).inputStream(), recipients = listOf(
+            Pgp.readPublicKeys(pair.publicArmored).first(),
+        ))
+        // A key read with the wrong passphrase cannot be verified, so it cannot
+        // have been imported; decrypting with a key whose remembered passphrase
+        // is right must work, one read with a wrong one must not exist.
+        Pgp.decrypt(ByteArrayOutputStream(), encrypted.toByteArray().inputStream(), keys = listOf(
+            Pgp.readPrivateKey(pair.privateArmored, passphrase.toCharArray()),
+        ))
+    }
+
+    // -----------------------------------------------------------------------
+    // gpg interop
+    // -----------------------------------------------------------------------
+
+    @Test
+    fun gpgDecryptsKotlinRecipientEncryption() {
+        val pair = generated()
+        importKeys(pair)
+        val src = tmp.newFile("plain.bin").apply { writeBytes(randomBytes(4 shl 20)) }
+        val encrypted = tmp.newFile("plain.bin.gpg")
+        val decrypted = tmp.newFile("plain.out").apply { delete() }
+
+        Pgp.encryptFile(encrypted, src, passphrase = null, recipients = listOf(publicKey(pair)))
+
+        val result = gpg(
+            "--batch", "--yes", "--no-tty",
+            "--pinentry-mode", "loopback",
+            "--passphrase", passphrase,
+            "--trust-model", "always",
+            "--output", decrypted.absolutePath,
+            "--decrypt", encrypted.absolutePath,
+        )
+        assertEquals("gpg could not decrypt our recipient-encrypted file: ${result.output}", 0, result.exitCode)
+        assertArrayEquals(src.readBytes(), decrypted.readBytes())
+    }
+
+    @Test
+    fun gpgDecryptsAndVerifiesKotlinSignEncrypt() {
+        val pair = generated()
+        importKeys(pair)
+        val src = tmp.newFile("signed.bin").apply { writeBytes(randomBytes(256 shl 10)) }
+        val encrypted = tmp.newFile("signed.bin.gpg")
+        val decrypted = tmp.newFile("signed.out").apply { delete() }
+
+        Pgp.encryptFile(
+            encrypted,
+            src,
+            passphrase = passphrase.toCharArray(),
+            recipients = listOf(publicKey(pair)),
+            signer = readSecret(pair),
+        )
+
+        val result = gpg(
+            "--batch", "--yes", "--no-tty",
+            "--pinentry-mode", "loopback",
+            "--passphrase", passphrase,
+            "--trust-model", "always",
+            "--status-fd", "1",
+            "--output", decrypted.absolutePath,
+            "--decrypt", encrypted.absolutePath,
+        )
+        assertEquals("gpg could not decrypt our signed file: ${result.output}", 0, result.exitCode)
+        assertTrue("gpg must report a good signature:\n${result.output}", result.output.contains("GOODSIG"))
+        assertArrayEquals(src.readBytes(), decrypted.readBytes())
+    }
+
+    @Test
+    fun kotlinDecryptsGpgRecipientEncryption() {
+        val pair = generated()
+        importKeys(pair)
+        val src = tmp.newFile("from-gpg.bin").apply { writeBytes(randomBytes(1 shl 20)) }
+        val encrypted = tmp.newFile("from-gpg.bin.gpg").apply { delete() }
+        val decrypted = tmp.newFile("from-gpg.out").apply { delete() }
+
+        val result = gpg(
+            "--batch", "--yes", "--no-tty",
+            "--trust-model", "always",
+            "--encrypt", "--recipient", publicKey(pair).fingerprint,
+            "--output", encrypted.absolutePath,
+            src.absolutePath,
+        )
+        assertEquals("gpg could not encrypt: ${result.output}", 0, result.exitCode)
+
+        Pgp.decryptFile(decrypted, encrypted, keys = listOf(readSecret(pair)))
+        assertArrayEquals(src.readBytes(), decrypted.readBytes())
+    }
+
+    @Test
+    fun kotlinVerifiesGpgSignedMessages() {
+        val pair = generated()
+        importKeys(pair)
+        val src = tmp.newFile("gpg-signed.bin").apply { writeBytes(randomBytes(128 shl 10)) }
+        val signed = tmp.newFile("gpg-signed.asc").apply { delete() }
+
+        val result = gpg(
+            "--batch", "--yes", "--no-tty",
+            "--pinentry-mode", "loopback",
+            "--passphrase", passphrase,
+            "--output", signed.absolutePath,
+            "--sign", src.absolutePath,
+        )
+        assertEquals("gpg could not sign: ${result.output}", 0, result.exitCode)
+
+        // gpg --sign writes a signed (not encrypted) OpenPGP message; decrypt()
+        // unwraps it and verifies the signature.
+        val plain = ByteArrayOutputStream()
+        val verified = Pgp.decrypt(plain, signed.inputStream(), keys = listOf(readSecret(pair)))
+        assertEquals(true, verified.verified)
+        assertEquals("Backup 测试 <test@example.com>", verified.signedByName)
+        assertArrayEquals(src.readBytes(), plain.toByteArray())
+
+        // And the combined encrypt+sign form of gpg's.
+        val both = tmp.newFile("gpg-both.gpg").apply { delete() }
+        val combined = gpg(
+            "--batch", "--yes", "--no-tty",
+            "--pinentry-mode", "loopback",
+            "--passphrase", passphrase,
+            "--trust-model", "always",
+            "--encrypt", "--sign", "--recipient", publicKey(pair).fingerprint,
+            "--output", both.absolutePath,
+            src.absolutePath,
+        )
+        assertEquals("gpg could not encrypt+sign: ${combined.output}", 0, combined.exitCode)
+        val plainBoth = ByteArrayOutputStream()
+        val verifiedBoth = Pgp.decrypt(plainBoth, both.inputStream(), keys = listOf(readSecret(pair)))
+        assertEquals(true, verifiedBoth.verified)
+        assertEquals("Backup 测试 <test@example.com>", verifiedBoth.signedByName)
+        assertArrayEquals(src.readBytes(), plainBoth.toByteArray())
+    }
+
+    @Test
+    fun gpgAcceptsTheGeneratedKeyRing() {
+        val pair = generated()
+        val file = tmp.newFile("public.asc")
+        file.writeText(pair.publicArmored)
+        val packets = gpg("--batch", "--no-tty", "--list-packets", file.absolutePath)
+        assertEquals("gpg cannot parse our generated key:\n${packets.output}", 0, packets.exitCode)
+        val text = packets.output
+        assertTrue("a master key is expected:\n$text", text.contains("public key packet"))
+        assertTrue("an encryption subkey is expected:\n$text", text.contains("sub key packet"))
+        assertTrue("a user id is expected:\n$text", text.contains("user ID packet"))
+        assertTrue("SHA-256 self-signatures are expected:\n$text", text.contains("digest algo 8"))
+    }
+
+    // -----------------------------------------------------------------------
+
+    private fun generated(): PgpKeyPair =
+        Pgp.generateKeyPair("Backup 测试", "test@example.com", passphrase.toCharArray())
+
+    private fun publicKey(pair: PgpKeyPair): PgpKey = Pgp.readPublicKeys(pair.publicArmored).first()
+
+    private fun readSecret(pair: PgpKeyPair): PgpKey =
+        Pgp.readPrivateKey(pair.privateArmored, passphrase.toCharArray())
+
+    /** Imports the pair's secret key (which carries the public half) into the test's GNUPGHOME. */
+    private fun importKeys(vararg pairs: PgpKeyPair) {
+        val file = tmp.newFile("keys.asc")
+        file.writeText(pairs.joinToString(separator = "\n") { it.privateArmored })
+        val result = gpg("--batch", "--yes", "--no-tty", "--import", file.absolutePath)
+        assertEquals("gpg could not import the generated key: ${result.output}", 0, result.exitCode)
+    }
+
+    private fun randomBytes(size: Int): ByteArray {
+        val bytes = ByteArray(size)
+        Random(size.toLong() xor 0x5EED).nextBytes(bytes)
+        return bytes
+    }
+
+    private class GpgResult(val exitCode: Int, val output: String)
+
+    private fun gpg(vararg args: String): GpgResult {
+        val command = ArrayList<String>(args.size + 1)
+        command += "gpg"
+        command += args
+        val process = ProcessBuilder(command)
+            .redirectErrorStream(true)
+            .apply { environment()["GNUPGHOME"] = gnupgHome.absolutePath }
+            .start()
+        val output = process.inputStream.readBytes().toString(Charsets.UTF_8)
+        if (!process.waitFor(180, TimeUnit.SECONDS)) {
+            process.destroyForcibly()
+            fail("gpg did not finish in time: $output")
+        }
+        return GpgResult(process.exitValue(), output)
+    }
+
+    private fun gpgAvailable(): Boolean = try {
+        val process = ProcessBuilder("gpg", "--version").redirectErrorStream(true).start()
+        process.inputStream.readBytes()
+        process.waitFor(15, TimeUnit.SECONDS) && process.exitValue() == 0
+    } catch (e: IOException) {
+        false
+    }
+}
