+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import java.io.InputStream
+
+/**
+ * Thrown when a message is signed but the signature cannot be trusted: the
+ * bytes were tampered with, the signature packet is missing or malformed, or
+ * the signer's public key is not among the keys given to [Pgp.decrypt]. A
+ * subclass of [PgpException], so existing `catch (PgpException)` code keeps
+ * catching it.
+ */
+class PgpSignatureException(message: String, cause: Throwable? = null) : PgpException(message, cause)
+
+/**
+ * What [Pgp.decrypt] learned about the message's signature: who signed it and
+ * whether the bytes verified. Unsigned messages read as `(null, null, false)`.
+ */
+data class VerifyResult(
+    /** The key id of the signing key, or null when the message is unsigned. */
+    val signedByKeyId: Long?,
+    /** The signer's first user id, e.g. `"张三 <me@example.com>"`, or null. */
+    val signedByName: String?,
+    /** Whether the signature over the literal data verified. */
+    val verified: Boolean,
+) {
+    internal companion object {
+        val Unsigned = VerifyResult(signedByKeyId = null, signedByName = null, verified = false)
+    }
+}
+
+/** A generated OpenPGP key pair: both halves as ASCII-armored text. */
+data class PgpKeyPair(
+    /** The public key (master + subkey), armor-ready to give to a recipient. */
+    val publicArmored: String,
+    /** The private key, armor-ready to import on the machine that decrypts. */
+    val privateArmored: String,
+)
+
+/**
+ * One OpenPGP key (a public key ring, or a secret key ring with the public
+ * parts), as read by [Pgp.readPublicKeys]/[Pgp.readPrivateKey] or handed to
+ * [Pgp.encrypt] as a recipient or a signer.
+ *
+ * Keys are in-memory objects over the parsed BouncyCastle packets; nothing
+ * here touches a file, a keyring store or Android. Callers persist keys as
+ * armored text ([publicArmored]/[privateArmored]) and parse them again on load
+ * — a [PgpKey] itself is not serializable.
+ */
+class PgpKey internal constructor(
+    /** The ring's public keys, master first. */
+    internal val publicKeys: List<PGPPublicKey>,
+    /** The secret ring when the key carries private material, else null. */
+    internal val secretRing: PGPSecretKeyRing?,
+    /** The passphrase remembered from [Pgp.readPrivateKey], if any. */
+    internal val passphrase: CharArray?,
+) {
+
+    /** Whether the key carries private (secret) material and can sign/decrypt. */
+    val isPrivate: Boolean
+        get() = secretRing != null
+
+    /** The primary key's id, e.g. `0x...` as a plain long. */
+    val keyId: Long
+        get() = master.keyID
+
+    /** The primary key's first user id, e.g. `"张三 <me@example.com>"`. */
+    val userId: String?
+        get() = master.userIDs.asSequence().firstOrNull()
+
+    /** The primary key's fingerprint, upper-case hex. */
+    val fingerprint: String
+        get() = master.fingerprint.joinToString(separator = "") { "%02X".format(it) }
+
+    /** The public half as ASCII armor, ready to share with a recipient. */
+    val publicArmored: String
+        get() = armor(PGPPublicKeyRing(publicKeys))
+
+    /** The private half as ASCII armor, or null for a public-only key. */
+    val privateArmored: String?
+        get() = secretRing?.let { armor(it) }
+
+    /** The ring's master (primary) public key. */
+    internal val master: PGPPublicKey
+        get() = publicKeys.firstOrNull { it.isMasterKey } ?: publicKeys.first()
+
+    /**
+     * The public key to encrypt the session key to: the encryption-capable
+     * subkey (gpg-style) when the ring has one, else the master key.
+     */
+    internal fun encryptionPublicKey(): PGPPublicKey {
+        val encryptFlags = KeyFlags.ENCRYPT_COMMS or KeyFlags.ENCRYPT_STORAGE
+        val capable = publicKeys.filter { it.isEncryptionKey }
+        return capable.firstOrNull { !it.isMasterKey && hasKeyFlag(it, encryptFlags) }
+            ?: capable.firstOrNull { it.isMasterKey && hasKeyFlag(it, encryptFlags) }
+            ?: capable.firstOrNull { !it.isMasterKey }
+            ?: capable.firstOrNull()
+            ?: throw PgpException("加密失败：该密钥不能用于加密")
+    }
+
+    /**
+     * The secret key to sign with: the master key (its SIGN key flag, as
+     * gpg-generated keys carry) when it has one, else a signing subkey, else
+     * the master's secret key.
+     */
+    internal fun signingSecretKey(): PGPSecretKey {
+        val ring = secretRing ?: throw PgpException("签名失败：需要私钥，请导入私钥后重试")
+        val keys = ring.getSecretKeys().asSequence().toList()
+        return keys.firstOrNull { it.isMasterKey && hasKeyFlag(it.publicKey, KeyFlags.SIGN_DATA) }
+            ?: keys.firstOrNull { !it.isMasterKey && hasKeyFlag(it.publicKey, KeyFlags.SIGN_DATA) }
+            ?: keys.firstOrNull { it.isMasterKey }
+            ?: ring.getSecretKey()
+    }
+
+    /** Whether any signature on [key] grants the given key flags. */
+    private fun hasKeyFlag(key: PGPPublicKey, wanted: Int): Boolean {
+        val signatures = try {
+            key.getSignatures().asSequence().toList()
+        } catch (e: Exception) {
+            emptyList()
+        }
+        return signatures.any { flagsOf(it) and wanted != 0 }
+    }
+
+    internal companion object {
+
+        /** The key flags any signature on [key] grants; 0 when there are none. */
+        private fun flagsOf(signature: PGPSignature): Int = try {
+            signature.hashedSubPackets?.keyFlags ?: 0
+        } catch (e: Exception) {
+            0
+        }
+
+        /** Extracts [secret]'s private key with [passphrase]; wrong passphrase is a clear error. */
+        internal fun keyPair(secret: PGPSecretKey, passphrase: CharArray?, action: String): PGPKeyPair {
+            val decryptor = BcPBESecretKeyDecryptorBuilder(BcPGPDigestCalculatorProvider())
+                .build(if (passphrase == null || passphrase.isEmpty()) null else passphrase)
+            return try {
+                secret.extractKeyPair(decryptor)
+            } catch (e: PGPException) {
+                throw PgpException("${action}失败：私钥口令不正确", e)
+            }
+        }
+
+        /** Builds a key from a parsed secret ring, remembering [passphrase] for later use. */
+        internal fun ofSecret(ring: PGPSecretKeyRing, passphrase: CharArray?): PgpKey =
+            PgpKey(
+                publicKeys = ring.getPublicKeys().asSequence().toList(),
+                secretRing = ring,
+                passphrase = passphrase,
+            )
+
+        /**
+         * Collects every key in an armored or binary key stream. ASCII armor
+         * is split into its `BEGIN…END` blocks first, because a decoder stream
+         * stops after the first one.
+         */
+        internal fun parse(input: InputStream): List<PgpKey> {
+            val keys = ArrayList<PgpKey>()
+            try {
+                val objects = BcPGPObjectFactory(PGPUtil.getDecoderStream(input))
+                while (true) {
+                    val obj = objects.nextObject() ?: break
+                    when (obj) {
+                        is PGPPublicKeyRing -> keys += PgpKey(obj.getPublicKeys().asSequence().toList(), null, null)
+                        is PGPSecretKeyRing -> keys += ofSecret(obj, null)
+                    }
+                }
+            } catch (e: PGPException) {
+                throw PgpException("导入失败：不是有效的 OpenPGP 密钥文本", e)
+            } catch (e: IOException) {
+                throw PgpException("导入失败：不是有效的 OpenPGP 密钥文本", e)
+            }
+            return keys
+        }
+
+        /** Collects every key in [armored] (one or more ASCII-armored blocks). */
+        internal fun parseArmored(armored: String): List<PgpKey> {
+            val blocks = Regex(
+                "-----BEGIN PGP [A-Z ]*KEY BLOCK-----.*?-----END PGP [A-Z ]*KEY BLOCK-----",
+                RegexOption.DOT_MATCHES_ALL,
+            ).findAll(armored).map { "${it.value}\n" }.toList()
+            val keys = if (blocks.isEmpty()) {
+                parse(armored.toByteArray().inputStream())
+            } else {
+                blocks.flatMap { parse(it.toByteArray().inputStream()) }
+            }
+            if (keys.isEmpty()) throw PgpException("导入失败：文本里没有 OpenPGP 密钥")
+            return keys
+        }
+
+        private fun armor(ring: PGPKeyRing): String {
+            val out = ByteArrayOutputStream()
+            val armored = ArmoredOutputStream(out)
+            try {
+                ring.encode(armored)
+            } finally {
+                armored.close() // writes the "-----END ..." line
+            }
+            return out.toString("UTF-8")
+        }
+
+        /** Armors a parsed key ring for [Pgp.generateKeyPair] and [PgpKey]'s properties. */
+        internal fun armorFor(ring: PGPKeyRing): String = armor(ring)
+    }
+}
