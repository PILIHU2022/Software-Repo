+
+// TestAccentColors derives the shades of an accent color: the base itself
+// in the light theme, a lighter one in the dark theme, a hover toward white
+// and a pressed toward black, and text that reads on the base.
+func TestAccentColors(t *testing.T) {
+	light, hover, pressed, text, err := accentColors("#007aff", false)
+	if err != nil {
+		t.Fatalf("#007aff: %v", err)
+	}
+	if light != ui.Hex("#007aff") {
+		t.Errorf("light base %v, want #007aff", light)
+	}
+	if light == hover || light == pressed || hover == pressed {
+		t.Errorf("shades %v, %v, %v are not apart", light, hover, pressed)
+	}
+	if accentLuminance(hover) <= accentLuminance(light) {
+		t.Errorf("hover %v is not lighter than the base %v", hover, light)
+	}
+	if accentLuminance(pressed) >= accentLuminance(light) {
+		t.Errorf("pressed %v is not darker than the base %v", pressed, light)
+	}
+	if text != ui.Hex("#ffffff") {
+		t.Errorf("text on #007aff is %v, want white", text)
+	}
+
+	dark, darkHover, darkPressed, darkText, err := accentColors("#007aff", true)
+	if err != nil {
+		t.Fatalf("#007aff in the dark: %v", err)
+	}
+	if accentLuminance(dark) <= accentLuminance(light) {
+		t.Errorf("dark base %v is not lighter than the light one %v", dark, light)
+	}
+	if accentLuminance(darkHover) <= accentLuminance(dark) {
+		t.Errorf("dark hover %v is not lighter than the dark base %v", darkHover, dark)
+	}
+	if accentLuminance(darkPressed) >= accentLuminance(dark) {
+		t.Errorf("dark pressed %v is not darker than the dark base %v", darkPressed, dark)
+	}
+	if darkText != ui.Hex("#ffffff") {
+		t.Errorf("text on the dark base %v, want white", darkText)
+	}
+
+	// A light accent takes near-black text rather than white.
+	if _, _, _, onYellow, err := accentColors("#ffd60a", false); err != nil {
+		t.Fatalf("#ffd60a: %v", err)
+	} else if onYellow != ui.Hex("#1d1d1f") {
+		t.Errorf("text on #ffd60a is %v, want #1d1d1f", onYellow)
+	}
+
+	// #rgb doubles each digit, and case does not matter.
+	if acc, _, _, _, err := accentColors("#F90", false); err != nil {
+		t.Fatalf("#F90: %v", err)
+	} else if acc != ui.Hex("#ff9900") {
+		t.Errorf("#F90 read as %v, want #ff9900", acc)
+	}
+
+	for _, bad := range []string{"red", "#12345", "#gggggg", "", "#", "#1234567"} {
+		if _, _, _, _, err := accentColors(bad, false); err == nil {
+			t.Errorf("%q parsed as a color", bad)
+		}
+	}
+
+	// What the dialog saves is the color in one shape, whatever came in.
+	for in, want := range map[string]string{
+		"#007AFF": "#007aff",
+		" af52de": "#af52de",
+		"#F90":    "#ff9900",
+		"#abc":    "#aabbcc",
+	} {
+		if got, err := accentNormalize(in); err != nil {
+			t.Errorf("%q: %v", in, err)
+		} else if got != want {
+			t.Errorf("%q normalized to %q, want %q", in, got, want)
+		}
+	}
+}
+
+// TestApplyAccent puts an accent into a theme: the theme's own color when
+// the user has none, theirs when they have one, and the default again when
+// what they have cannot be read, so a broken setting cannot break the look.
+func TestApplyAccent(t *testing.T) {
+	t.Cleanup(func() {
+		applyAccent(lightTheme, "")
+		applyAccent(darkTheme, "")
+	})
+
+	light := ui.LightTheme()
+	applyAccent(light, "")
+	if light.Accent != ui.Hex("#007aff") {
+		t.Errorf("light default accent %v, want #007aff", light.Accent)
+	}
+	if light.AccentHover != ui.Hex("#006ee6") || light.AccentPressed != ui.Hex("#0062cc") || light.AccentText != ui.Hex("#ffffff") {
+		t.Errorf("light default shades %v, %v, %v", light.AccentHover, light.AccentPressed, light.AccentText)
+	}
+	if light.Selection != ui.Hex("#007aff").Alpha(0.22) || light.Focus != ui.Hex("#007aff").Alpha(0.5) {
+		t.Errorf("light default tints %v, %v", light.Selection, light.Focus)
+	}
+
+	dark := ui.DarkTheme()
+	applyAccent(dark, "")
+	if dark.Accent != ui.Hex("#0a84ff") {
+		t.Errorf("dark default accent %v, want #0a84ff", dark.Accent)
+	}
+	if dark.AccentHover != ui.Hex("#2b95ff") || dark.AccentPressed != ui.Hex("#0077e6") {
+		t.Errorf("dark default shades %v, %v", dark.AccentHover, dark.AccentPressed)
+	}
+	if dark.Selection != ui.Hex("#0a84ff").Alpha(0.35) || dark.Focus != ui.Hex("#0a84ff").Alpha(0.6) {
+		t.Errorf("dark default tints %v, %v", dark.Selection, dark.Focus)
+	}
+
+	// A color of the user's own, with the tints made from it, not from the
+	// theme's default.
+	acc, hover, pressed, text, err := accentColors("#ff9500", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	applyAccent(light, "#ff9500")
+	if light.Accent != acc || light.AccentHover != hover || light.AccentPressed != pressed || light.AccentText != text {
+		t.Errorf("custom accent %v, %v, %v, %v; want %v, %v, %v, %v",
+			light.Accent, light.AccentHover, light.AccentPressed, light.AccentText, acc, hover, pressed, text)
+	}
+	if light.Accent == ui.Hex("#007aff") {
+		t.Error("the custom accent left the default in place")
+	}
+	if light.Selection != acc.Alpha(0.22) || light.Focus != acc.Alpha(0.5) {
+		t.Errorf("custom tints %v, %v made from the accent", light.Selection, light.Focus)
+	}
+	if light.Selection.A == 0 || light.Focus.A == 0 {
+		t.Errorf("tints %v, %v are invisible", light.Selection, light.Focus)
+	}
+
+	// A theme now in dark mode takes the dark shades of the same color.
+	dacc, _, _, _, err := accentColors("#ff9500", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	applyAccent(dark, "#ff9500")
+	if dark.Accent != dacc {
+		t.Errorf("dark custom accent %v, want %v", dark.Accent, dacc)
+	}
+	if dark.Selection != dacc.Alpha(0.35) || dark.Focus != dacc.Alpha(0.6) {
+		t.Errorf("dark custom tints %v, %v", dark.Selection, dark.Focus)
+	}
+
+	// A setting that does not read as a color falls back to the default.
+	applyAccent(light, "not a color")
+	if light.Accent != ui.Hex("#007aff") {
+		t.Errorf("unreadable accent left %v, want the default", light.Accent)
+	}
+
+	// And clearing it goes back to the default too.
+	applyAccent(light, "#ff9500")
+	applyAccent(light, "")
+	if light.Accent != ui.Hex("#007aff") || light.Selection != ui.Hex("#007aff").Alpha(0.22) {
+		t.Errorf("cleared accent is %v with tint %v, want the default", light.Accent, light.Selection)
+	}
+}
