+// TestAccentSettingJSON keeps the accent in the settings file under its own
+// key, and leaves the key out while the default is chosen.
+func TestAccentSettingJSON(t *testing.T) {
+	data, err := json.Marshal(settings{AccentColor: "#ff9500"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(data), `"accent_color":"#ff9500"`) {
+		t.Errorf("saved %s, without the accent", data)
+	}
+	empty, err := json.Marshal(settings{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(empty), "accent_color") {
+		t.Errorf("the default accent saved as %s", empty)
+	}
+	var s settings
+	if err := json.Unmarshal([]byte(`{"accent_color":"#ff9500"}`), &s); err != nil {
+		t.Fatal(err)
+	}
+	if s.AccentColor != "#ff9500" {
+		t.Errorf("read back %q", s.AccentColor)
+	}
+}
+
+// TestSettingsAccentColor chooses an accent in the 外观 section, which saves
+// it and paints the interface with it, tries a color of the user's own in
+// the dialog, which refuses one it cannot read, and tells the version in
+// 关于 in a row of its own.
+func TestSettingsAccentColor(t *testing.T) {
+	// Keep what this test saves out of the real profile.
+	dir := t.TempDir()
+	mygo.App.SetPath(mygo.PathUserData, dir)
+	t.Cleanup(func() { mygo.App.SetPath(mygo.PathUserData, "") })
+
+	a, tt, _ := signedIn(t)
+	// A window tall enough that the whole settings page shows at once, so
+	// its rows are there to be pressed.
+	tt.SetSize(1180, 2400)
+	a.router.Push("/settings")
+	waitFor(t, tt, "主题色")
+	tt.Advance(300 * time.Millisecond)
+	save(t, tt, "settings-accent")
+
+	// 关于 tells the version, once, in a row of its own.
+	if !tt.HasText("百度网盘的原生桌面客户端") {
+		t.Fatalf("about copy missing; texts %q", tt.Texts())
+	}
+	if _, ok := tt.Find("版本"); !ok {
+		t.Errorf("no 版本 row; texts %q", tt.Texts())
+	}
+	// The title bar names the build too; the page tells it once, as a row.
+	shown := 0
+	for _, text := range tt.Texts() {
+		if text == version() {
+			shown++
+		}
+	}
+	if shown != 1 {
+		t.Errorf("version %q shown %d times, want its own row", version(), shown)
+	}
+	if tt.HasText(version() + " · 百度网盘的原生桌面客户端") {
+		t.Error("the version still rides on the name row")
+	}
+
+	// A preset swatch is the whole choice: press it and the accent is saved
+	// and in effect.
+	if err := tt.Click("紫"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(200 * time.Millisecond)
+	if a.settings.AccentColor != "#af52de" {
+		t.Errorf("accent %q after pressing 紫, want #af52de", a.settings.AccentColor)
+	}
+	if want, _, _, _, err := accentColors("#af52de", false); err != nil {
+		t.Fatal(err)
+	} else if lightTheme.Accent != want {
+		t.Errorf("theme accent %v, want %v", lightTheme.Accent, want)
+	}
+	if got := savedAccent(t, dir); got != "#af52de" {
+		t.Errorf("saved accent %q, want #af52de", got)
+	}
+	save(t, tt, "settings-accent-purple")
+
+	// The dialog refuses what is not a color, and keeps one that is, in the
+	// one shape it is written in.
+	if err := tt.Click("自定义…"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if !a.accentEditing {
+		t.Fatal("自定义… did not open the dialog")
+	}
+	a.accentDraft = "red"
+	tt.Advance(100 * time.Millisecond)
+	if err := tt.Click("保存"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if !a.accentEditing || a.accentErr == "" {
+		t.Fatalf("an unreadable color left editing %v with error %q", a.accentEditing, a.accentErr)
+	}
+	save(t, tt, "settings-accent-dialog")
+	a.accentDraft = "#F90"
+	tt.Advance(100 * time.Millisecond)
+	if err := tt.Click("保存"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(200 * time.Millisecond)
+	if a.accentEditing || a.accentErr != "" {
+		t.Fatalf("a readable color left editing %v with error %q", a.accentEditing, a.accentErr)
+	}
+	if a.settings.AccentColor != "#ff9900" {
+		t.Errorf("accent %q after saving #F90, want #ff9900", a.settings.AccentColor)
+	}
+	if got := savedAccent(t, dir); got != "#ff9900" {
+		t.Errorf("saved accent %q, want #ff9900", got)
+	}
+
+	// 默认 goes back to the theme's own blue.
+	if err := tt.Click("默认"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(200 * time.Millisecond)
+	if a.settings.AccentColor != "" {
+		t.Errorf("accent %q after 默认, want none", a.settings.AccentColor)
+	}
+	if lightTheme.Accent != ui.Hex("#007aff") {
+		t.Errorf("theme accent %v after 默认, want the default", lightTheme.Accent)
+	}
+	if got := savedAccent(t, dir); got != "" {
+		t.Errorf("saved accent %q after 默认, want none", got)
+	}
+}
+
+// savedAccent reads the accent out of the settings file this test had the
+// app save.
+func savedAccent(t *testing.T, dir string) string {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(dir, "settings.json"))
+	if err != nil {
+		t.Fatalf("read the settings: %v", err)
+	}
+	var saved struct {
+		AccentColor string `json:"accent_color"`
+	}
+	if err := json.Unmarshal(data, &saved); err != nil {
+		t.Fatalf("read the settings: %v", err)
+	}
+	return saved.AccentColor
+}
