+// accentRow is the 外观 section's 主题色: the preset colors as swatches, one
+// press each, a way back to the theme's own color, and a dialog for a color
+// of the user's own.
+func (a *App) accentRow(c *ui.Context, t *ui.Theme, p *palette) {
+	s := &a.settings
+	settingRow(c, t, p, "主题色", "", accentDetail(s.AccentColor), func() {
+		for _, preset := range accentPresets {
+			b := ui.ButtonBase(c.Key("accent:"+preset.Hex)).Label(preset.Name).Tooltip(preset.Name).
+				Size(20, 20).Radius(10).Center().Background(ui.Hex(preset.Hex))
+			// The color in effect wears a ring; with none of the user's
+			// own, that is the theme's blue, which the first preset is.
+			if preset.Hex == s.AccentColor || (s.AccentColor == "" && preset.Hex == accentPresets[0].Hex) {
+				b.Border(2, t.Text)
+			}
+			if b.Clicked() {
+				s.AccentColor = preset.Hex
+				a.applySettings()
+			}
+		}
+		if pill(c, t, p, "", "默认", false).Clicked() {
+			s.AccentColor = ""
+			a.applySettings()
+		}
+		if pill(c, t, p, "", "自定义…", false).Clicked() {
+			a.accentErr = ""
+			a.accentDraft = s.AccentColor
+			if a.accentDraft == "" {
+				a.accentDraft = accentPresets[0].Hex // the dialog starts on the system blue
+			}
+			a.accentEditing = true
+		}
+	})
+}
+
+// saveAccent keeps the 主题色 dialog's color once it reads as one, as
+// #rrggbb; a color it cannot read leaves the dialog open with the reason.
+func (a *App) saveAccent() {
+	hex, err := accentNormalize(a.accentDraft)
+	if err != nil {
+		a.accentErr = err.Error()
+		return
+	}
+	a.accentErr, a.accentEditing = "", false
+	if a.settings.AccentColor == hex {
+		return
+	}
+	a.settings.AccentColor = hex
+	a.applySettings()
+}
+
+// accentDialog asks for a color of the user's own in a small dialog of the
+// settings page's own, like the 更新地址 one, showing the color as it is
+// typed.
+func (a *App) accentDialog(c *ui.Context, t *ui.Theme, p *palette) {
+	ui.Modal(c, &a.accentEditing, func() {
+		dialogTitle(c, t, "主题色", "预设之外的颜色，填写 #RRGGBB 或 #RGB")
+		in := ui.TextInputBase(c.Key("accent-hex"), &a.accentDraft).Label("主题色").
+			Placeholder("#007aff").Grow(1)
+		if a.accentErr != "" {
+			ui.Text(c, a.accentErr).FontSize(11).TextColor(t.Danger).Transition(rowEnter)
+		}
+		if hex, err := accentNormalize(a.accentDraft); err == nil {
+			ui.Row(c).Gap(8).AlignItems(ui.Center).Children(func() {
+				ui.ButtonBase(c).Size(20, 20).Radius(10).Background(ui.Hex(hex))
+				ui.Text(c, accentDetail(hex)).FontSize(11).TextColor(t.TextMuted)
+			})
+		}
+		ui.Row(c).Gap(8).Justify(ui.End).Margin(4, 0, 0).Children(func() {
+			if pill(c, t, p, "", "取消", false).Clicked() {
+				a.accentEditing, a.accentErr = false, ""
+			}
+			if pill(c, t, p, "", "保存", true).Clicked() {
+				a.saveAccent()
+			}
+		})
+		if in.Submitted() {
+			a.saveAccent()
+		}
+	})
+}
+
