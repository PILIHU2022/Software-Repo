@@ -121,2 +126,163 @@ func init() {
 
+// accentPreset is one of the accent colors the settings page offers beside
+// a color of the user's own.
+type accentPreset struct {
+	Name string // what the settings page calls it: 蓝, 紫, 粉 …
+	Hex  string // its color, as #rrggbb
+}
+
+// accentPresets are the colors offered in the 外观 section, in the order
+// the swatches show them.
+var accentPresets = []accentPreset{
+	{"蓝", "#007aff"},
+	{"紫", "#af52de"},
+	{"粉", "#ff2d55"},
+	{"橙", "#ff9500"},
+	{"绿", "#34c759"},
+	{"红", "#ff3b30"},
+	{"青", "#32ade6"},
+	{"靛", "#5856d6"},
+}
+
+// defaultAccent is the accent a theme keeps when the user chooses none: the
+// one its init gave it.
+func defaultAccent(dark bool) accentSet {
+	if dark {
+		return accentDarkDefault
+	}
+	return accentLightDefault
+}
+
+// accentColors derives a theme's accent colors from hex, the color the user
+// chose: the base itself in the light theme and a tenth of the way to white
+// in the dark one, so it holds up on a dark background, a hover shade
+// toward white, a pressed shade toward black, and the text that reads on the
+// base: white on a dark color, near black on a light one such as #ffd60a.
+// The color may be #rgb or #rrggbb in either case; anything else is an
+// error, as ui.Hex would otherwise panic on it.
+func accentColors(hex string, dark bool) (acc, hover, pressed, text ui.Color, err error) {
+	norm, err := accentNormalize(hex)
+	if err != nil {
+		return ui.Color{}, ui.Color{}, ui.Color{}, ui.Color{}, err
+	}
+	white, black := ui.Hex("#ffffff"), ui.Hex("#000000")
+	base := ui.Hex(norm)
+	if dark {
+		base = base.Mix(white, 0.10)
+	}
+	acc = base
+	if dark {
+		hover, pressed = base.Mix(white, 0.12), base.Mix(black, 0.18)
+	} else {
+		hover, pressed = base.Mix(white, 0.16), base.Mix(black, 0.14)
+	}
+	text = white
+	if accentLuminance(base) >= 0.55 {
+		text = ui.Hex("#1d1d1f")
+	}
+	return acc, hover, pressed, text, nil
+}
+
+// accentNormalize reads an accent color as #rrggbb in lower case. It takes
+// #rgb or #rrggbb, the letters in either case, with or without the #, so a
+// color typed into the dialog is read as it is meant. Anything else is an
+// error naming what it wanted, which the dialog shows.
+func accentNormalize(hex string) (string, error) {
+	h := accentTrimSpace(hex)
+	if len(h) > 0 && h[0] == '#' {
+		h = h[1:]
+	}
+	switch len(h) {
+	case 3:
+		h = string([]byte{h[0], h[0], h[1], h[1], h[2], h[2]})
+	case 6:
+	default:
+		return "", fmt.Errorf("主题色 %q 不是 #RRGGBB 或 #RGB", hex)
+	}
+	out := make([]byte, 0, 7)
+	out = append(out, '#')
+	for i := 0; i < len(h); i++ {
+		c := h[i]
+		switch {
+		case '0' <= c && c <= '9', 'a' <= c && c <= 'f':
+		case 'A' <= c && c <= 'F':
+			c += 'a' - 'A'
+		default:
+			return "", fmt.Errorf("主题色 %q 不是 #RRGGBB 或 #RGB", hex)
+		}
+		out = append(out, c)
+	}
+	return string(out), nil
+}
+
+// accentTrimSpace cuts the white space a pasted color may bring from both
+// ends of s.
+func accentTrimSpace(s string) string {
+	space := func(c byte) bool {
+		return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'
+	}
+	for len(s) > 0 && space(s[0]) {
+		s = s[1:]
+	}
+	for len(s) > 0 && space(s[len(s)-1]) {
+		s = s[:len(s)-1]
+	}
+	return s
+}
+
+// accentLuminance is the relative luminance of c's sRGB value, 0 for black
+// and 1 for white: what tells whether text reads on it.
+func accentLuminance(c ui.Color) float64 {
+	linear := func(v uint8) float64 {
+		s := float64(v) / 255
+		if s <= 0.04045 {
+			return s / 12.92
+		}
+		return math.Pow((s+0.055)/1.055, 2.4)
+	}
+	return 0.2126*linear(c.R) + 0.7152*linear(c.G) + 0.0722*linear(c.B)
+}
+
+// accentName is the preset hex names, or "" when it is none of them.
+func accentName(hex string) string {
+	for _, p := range accentPresets {
+		if p.Hex == hex {
+			return p.Name
+		}
+	}
+	return ""
+}
+
+// accentDetail names the accent in effect for the settings page: the
+// theme's own, a preset's name, or the color the user typed.
+func accentDetail(hex string) string {
+	if hex == "" {
+		return "默认（系统蓝）"
+	}
+	if name := accentName(hex); name != "" {
+		return name
+	}
+	return hex
+}
+
+// applyAccent puts the user's accent color into t, rebuilding everything
+// drawn from it: an empty or unreadable hex falls back to the theme's own
+// color, which keeps a broken setting from breaking the interface. The
+// selection and focus tints are made from the accent in effect, so clearing
+// a custom color puts them back as well.
+func applyAccent(t *ui.Theme, hex string) {
+	set := defaultAccent(t.Dark)
+	if hex != "" {
+		if acc, hover, pressed, text, err := accentColors(hex, t.Dark); err == nil {
+			set = accentSet{acc, hover, pressed, text}
+		}
+	}
+	t.Accent, t.AccentHover, t.AccentPressed, t.AccentText = set.Accent, set.Hover, set.Pressed, set.Text
+	if t.Dark {
+		t.Selection, t.Focus = set.Accent.Alpha(0.35), set.Accent.Alpha(0.6)
+	} else {
+		t.Selection, t.Focus = set.Accent.Alpha(0.22), set.Accent.Alpha(0.5)
+	}
+}
+
