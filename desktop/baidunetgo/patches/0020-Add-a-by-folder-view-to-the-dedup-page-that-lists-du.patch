+// TestDedupFolderCache checks that results read back from the cache show in
+// the folder view too, every folder open, without a scan.
+func TestDedupFolderCache(t *testing.T) {
+	dir := dedupCacheIn(t)
+	a, tt, srv := dedupFolderScan(t)
+	if err := tt.Click("按文件夹"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(200 * time.Millisecond)
+	dirs, copies := len(a.dedup.dirs), dedupCopyRows(&a.dedup)
+	waitDedupCache(t, tt, filepath.Join(dir, "dedup.json"))
+
+	a2, tt2 := signedInAt(t, srv)
+	a2.router.Replace("/dedup")
+	waitUntil(t, tt2, "the cached results", func() bool { return a2.dedup.loaded || a2.dedup.scanning })
+	d2 := &a2.dedup
+	if !d2.cached || !d2.loaded {
+		t.Fatalf("the page did not open on the cache: cached %v, loaded %v", d2.cached, d2.loaded)
+	}
+	if d2.byFolder != 0 {
+		t.Errorf("the cached page opens on view %d, not on the groups", d2.byFolder)
+	}
+	if err := tt2.Click("按文件夹"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt2.Texts())
+	}
+	tt2.Advance(200 * time.Millisecond)
+	if d2.scanning || d2.scanID != 0 {
+		t.Errorf("the folder view scanned again: %d scans", d2.scanID)
+	}
+	if d2.byFolder != 1 || len(d2.dirs) != dirs {
+		t.Errorf("the cached page shows %d folders in view %d, want %d folders in view 1", len(d2.dirs), d2.byFolder, dirs)
+	}
+	if len(d2.folded) != 0 || dedupCopyRows(d2) != copies {
+		t.Errorf("the cached folder view opens with %d folded and %d copies, want 0 and %d",
+			len(d2.folded), dedupCopyRows(d2), copies)
+	}
+	save(t, tt2, "dedup-folders-cached")
+}
