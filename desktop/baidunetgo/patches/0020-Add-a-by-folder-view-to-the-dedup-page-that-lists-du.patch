+// TestDedupFolderCrossGroup checks a group whose copies lie in two folders:
+// each folder lists its own copy once, marked kept or spare, and says where
+// the rest of the group is.
+func TestDedupFolderCrossGroup(t *testing.T) {
+	a, tt, _ := dedupFolderScan(t)
+	d := &a.dedup
+	gi := -1
+	for i, g := range d.groups {
+		if len(g.Files) >= 2 && path.Dir(g.Files[0].Path) != path.Dir(g.Files[1].Path) {
+			gi = i
+			break
+		}
+	}
+	if gi < 0 {
+		t.Fatal("the fake netdisk has no group of copies in two folders")
+	}
+	g := d.groups[gi]
+	if err := tt.Click("按文件夹"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(200 * time.Millisecond)
+
+	seen := map[string]int{}
+	for i, r := range d.rows {
+		if r.file < 0 || r.group != gi {
+			continue
+		}
+		dir := d.dirs[r.dir].path
+		seen[dir]++
+		f := g.Files[r.file]
+		if got := path.Dir(f.Path); got != dir {
+			t.Errorf("row %d lists %q under %q, in %q", i, f.Path, dir, got)
+		}
+		switch {
+		case r.file == 0 && d.chosen[f.Path]:
+			t.Errorf("the kept copy %q is chosen", f.Path)
+		case r.file > 0 && !d.chosen[f.Path]:
+			t.Errorf("the spare copy %q is not chosen", f.Path)
+		}
+	}
+	want := []string{path.Dir(g.Files[0].Path), path.Dir(g.Files[1].Path)}
+	if len(seen) != 2 || seen[want[0]] != 1 || seen[want[1]] != 1 {
+		t.Fatalf("the group shows as %v, want one copy in each of %v", seen, want)
+	}
+	// Its rows say how much of the group lies elsewhere, where.
+	note, tip := dedupGroupNote(g, want[0])
+	if !strings.Contains(note, "另 1 处") || !strings.Contains(note, humanSize(g.Size())) {
+		t.Errorf("note %q says not where the group is", note)
+	}
+	if !strings.Contains(tip, want[0]) && !strings.Contains(tip, want[1]) {
+		t.Errorf("tip %q names neither folder", tip)
+	}
+	if !tt.HasText(note) {
+		t.Errorf("no row says %q; texts %q", note, tt.Texts())
+	}
+	if !tt.HasText("保留") {
+		t.Errorf("the kept copy is not marked; texts %q", tt.Texts())
+	}
+	// A group the one folder holds says nothing of other folders.
+	same := dedup.Group{Key: g.Key, Reclaim: g.Size()}
+	same.Files = append(same.Files, g.Files[0])
+	if n, _ := dedupGroupNote(same, want[0]); n != "" {
+		t.Errorf("a group in one folder says %q of others", n)
+	}
+	save(t, tt, "dedup-folders-cross")
+}
