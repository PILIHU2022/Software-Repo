+// TestDedupFolderSelectDelete chooses and deletes in the folder view: a
+// click on a copy chooses it, 全不选 and 全选 and 保留一份 work as in the
+// group view, and the copy taken goes to the recycle bin.
+func TestDedupFolderSelectDelete(t *testing.T) {
+	a, tt, srv := dedupFolderScan(t)
+	d := &a.dedup
+	if err := tt.Click("按文件夹"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(200 * time.Millisecond)
+
+	// 全不选 and 全选 are the same in either view.
+	if err := tt.Click("全不选"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if d.selCount != 0 || len(d.chosen) != 0 {
+		t.Fatalf("全不选 in the folder view chose %d files", d.selCount)
+	}
+	g := d.groups[0]
+	keep, extra := g.Files[0], g.Files[1]
+
+	// A click on a copy of the folder view chooses it.
+	clickDedupRow(t, tt, extra.Name)
+	tt.Advance(100 * time.Millisecond)
+	if d.selCount != 1 || !d.chosen[extra.Path] {
+		t.Fatalf("clicking %q chose %d files: %v", extra.Name, d.selCount, d.chosen)
+	}
+	// The choice survives the way back, where the heading keeps one copy.
+	if err := tt.Click("按重复组"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if d.selCount != 1 || !d.chosen[extra.Path] {
+		t.Fatalf("the group view lost the choice: %d files", d.selCount)
+	}
+	if err := tt.Click("保留一份"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(100 * time.Millisecond)
+	if want := len(g.Files) - 1; d.selCount != want {
+		t.Errorf("保留一份 chose %d files, want %d", d.selCount, want)
+	}
+
+	// Chosen in the folder view and moved to the recycle bin.
+	if err := tt.Click("按文件夹"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if err := tt.Click("全不选"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	clickDedupRow(t, tt, extra.Name)
+	tt.Advance(100 * time.Millisecond)
+	if d.selCount != 1 || !d.chosen[extra.Path] {
+		t.Fatalf("clicking %q in the folder view chose %d files", extra.Name, d.selCount)
+	}
+	if err := tt.Click("移入回收站"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if !d.confirm {
+		t.Fatal("移入回收站 did not ask")
+	}
+	if err := tt.Click("确认移入"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	waitUntil(t, tt, "the delete", func() bool { return !d.busy && !srv.Exists(extra.Path) })
+	if !srv.Exists(keep.Path) {
+		t.Errorf("the kept copy %q went too", keep.Path)
+	}
+	tt.Advance(300 * time.Millisecond)
+	if !tt.HasText("已将 1 项移入回收站") {
+		t.Errorf("no toast after the delete: %q", tt.Texts())
+	}
+	// The folder view is regrouped: the deleted copy is gone from its
+	// folder, and a folder left without copies is no heading.
+	if d.byFolder != 1 {
+		t.Errorf("the delete changed the view to %d", d.byFolder)
+	}
+	for _, r := range d.rows {
+		if r.file >= 0 {
+			f := d.groups[r.group].Files[r.file]
+			if f.Path == extra.Path {
+				t.Errorf("the deleted copy %q is still listed", f.Path)
+			}
+			if dir := d.dirs[r.dir].path; dir != path.Dir(f.Path) {
+				t.Errorf("%q is listed under %q", f.Path, dir)
+			}
+		}
+	}
+	for i := range d.dirs {
+		if len(d.dirs[i].files) == 0 {
+			t.Errorf("folder %q has no copies but is still headed", d.dirs[i].path)
+		}
+	}
+	if n := dedupCopyRows(d); n == 0 {
+		t.Error("no copies left in the folder view")
+	}
+}
