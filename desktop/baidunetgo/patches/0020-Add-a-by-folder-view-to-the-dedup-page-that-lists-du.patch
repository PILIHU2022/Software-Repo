+// TestDedupFolderFold folds a folder away and shows it again: the lines
+// under it leave the list, no scan runs, and what is chosen and what the
+// results could free stay as they are.
+func TestDedupFolderFold(t *testing.T) {
+	a, tt, _ := dedupFolderScan(t)
