+// TestDedupFolderNarrow renders the folder view in a narrow window, where
+// the view switch folds into a pop-up: the folder's line keeps its path and
+// count, and a click folds it.
+func TestDedupFolderNarrow(t *testing.T) {
+	a, tt, _ := dedupFolderScan(t)
+	d := &a.dedup
+	tt.SetSize(420, 300)
+	tt.Advance(200 * time.Millisecond)
+	if !a.compact {
+		t.Fatal("the narrow window's header did not fold its switch")
+	}
+	// The switch is a pop-up of both views here.
+	if err := tt.Click("按重复组"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	if err := tt.ChooseMenuItem("按文件夹"); err != nil {
+		t.Fatalf("%v; menu %q", err, tt.Menu())
+	}
+	tt.Advance(200 * time.Millisecond)
+	if d.byFolder != 1 {
+		t.Fatalf("the pop-up left view %d", d.byFolder)
+	}
+	if len(d.rows) == 0 || len(d.dirs) == 0 {
+		t.Fatalf("no folder view: %d rows, %d folders", len(d.rows), len(d.dirs))
+	}
+	// The window shows the first folder's line, which still folds.
+	f := d.dirs[0]
+	clickDedupRow(t, tt, f.label)
+	tt.Advance(200 * time.Millisecond)
+	if !d.folded[f.path] {
+		t.Fatalf("the narrow window did not fold %q", f.path)
+	}
+	save(t, tt, "dedup-folders-narrow")
+}
