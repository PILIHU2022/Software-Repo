+// dedupGroupNote says how much of a copy's group lies in other folders, for
+// the folder view's row, and its tip names them. Both are empty when the
+// group keeps to this one folder, where the copies beside it are its own.
+func dedupGroupNote(g dedup.Group, dir string) (string, string) {
+	others := map[string]int{}
+	var order []string
+	here := 0
+	for _, f := range g.Files {
+		d := path.Dir(f.Path)
+		if d == dir {
+			here++
+			continue
+		}
+		if _, ok := others[d]; !ok {
+			order = append(order, d)
+		}
+		others[d]++
+	}
+	if len(order) == 0 {
+		return "", ""
+	}
+	copies := len(g.Files) - here
+	note := "另 " + itoa(len(order)) + " 处 · " + humanSize(g.Size()*int64(copies))
+	var parts []string
+	if here > 1 {
+		parts = append(parts, "本文件夹还有 "+itoa(here-1)+" 份")
+	}
+	parts = append(parts, "另 "+itoa(copies)+" 份、共 "+humanSize(g.Size()*int64(copies))+" 在 "+strings.Join(order, "、"))
+	tip := "同组共 " + itoa(len(g.Files)) + " 份，每份 " + humanSize(g.Size()) + "；" + strings.Join(parts, "；")
+	return note, tip
+}
