+// dedupFolderScan signs in to the fake netdisk, opens the dedup page and
+// waits for the scan its entry starts.
+func dedupFolderScan(t *testing.T) (*App, *ui.Tester, *fakepan.Server) {
+	t.Helper()
+	oldWorkers, oldReport := dedupWorkers, dedupReport
+	dedupWorkers, dedupReport = 2, 0
+	t.Cleanup(func() { dedupWorkers, dedupReport = oldWorkers, oldReport })
+	a, tt, srv := signedIn(t)
+	a.router.Replace("/dedup")
+	waitUntil(t, tt, "the dedup scan", func() bool { return a.dedup.loaded })
+	tt.Advance(300 * time.Millisecond)
+	return a, tt, srv
+}
+
+// clickDedupRow clicks the center of a row of the results list, by the name
+// the list gives it: a folder's line can share its label with the sidebar's.
+func clickDedupRow(t *testing.T, tt *ui.Tester, label string) {
+	t.Helper()
+	row, ok := tt.AccessByRole(ui.RoleListItem, label)
+	if !ok || row.Offscreen || row.Bounds.W <= 0 || row.Bounds.H <= 0 {
+		t.Fatalf("no visible list row %q; texts %q", label, tt.Texts())
+	}
+	r := row.Bounds
+	tt.ClickAt(r.X+r.W/2, r.Y+r.H/2)
+}
+
+// dedupCopyRows counts the lines under folders: the copies the folder view
+// shows.
+func dedupCopyRows(d *dedupState) int {
+	n := 0
+	for _, r := range d.rows {
+		if r.file >= 0 {
+			n++
+		}
+	}
+	return n
+}
+
+// TestDedupFolderView checks the folder view beside the group view: the page
+// still opens on the groups, the switch heads a line for every folder that
+// holds a copy, each copy is under its own folder once, and the choice in
+// hand survives the move between the views.
+func TestDedupFolderView(t *testing.T) {
+	a, tt, _ := dedupFolderScan(t)
+	d := &a.dedup
+	if d.byFolder != 0 {
+		t.Fatalf("the page opens on view %d, not on the groups", d.byFolder)
+	}
+	for i, r := range d.rows {
+		if r.dir >= 0 {
+			t.Fatalf("row %d of the group view is of a folder: %+v", i, r)
+		}
+	}
+	if !tt.HasText("按重复组") || !tt.HasText("按文件夹") {
+		t.Fatalf("no view switch; texts %q", tt.Texts())
+	}
+	scans, selBefore := d.scanID, d.selCount
+	chosenBefore := make(map[string]bool, len(d.chosen))
+	for p := range d.chosen {
+		chosenBefore[p] = true
+	}
+
+	if err := tt.Click("按文件夹"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(200 * time.Millisecond)
+	if d.byFolder != 1 {
+		t.Fatalf("the switch left view %d", d.byFolder)
+	}
+	if d.scanID != scans {
+		t.Errorf("switching views scanned again: %d scans", d.scanID)
+	}
+	if d.selCount != selBefore || len(d.chosen) != len(chosenBefore) {
+		t.Errorf("switching views chose %d files of %d, want %d of %d",
+			d.selCount, len(d.chosen), selBefore, len(chosenBefore))
+	}
+	for p := range chosenBefore {
+		if !d.chosen[p] {
+			t.Errorf("%q is no longer chosen after the switch", p)
+		}
+	}
+
+	// Every folder of the results heads its copies, once, in the order of
+	// what it could free.
+	want := map[string]bool{}
+	var copies int
+	for _, g := range d.groups {
+		copies += len(g.Files)
+		for _, f := range g.Files {
+			want[path.Dir(f.Path)] = true
+		}
+	}
+	seen := map[string]int{}
+	rows := 0
+	for i, r := range d.rows {
+		if r.file < 0 {
+			if r.dir < 0 || r.dir >= len(d.dirs) {
+				t.Fatalf("row %d heads nothing: %+v", i, r)
+			}
+			seen[d.dirs[r.dir].path]++
+			if i > 0 && d.dirs[r.dir].reclaim > d.dirs[d.rows[i-1].dir].reclaim {
+				t.Errorf("folder %q (%d to free) comes after %q (%d)",
+					d.dirs[r.dir].path, d.dirs[r.dir].reclaim,
+					d.dirs[d.rows[i-1].dir].path, d.dirs[d.rows[i-1].dir].reclaim)
+			}
+			continue
+		}
+		rows++
+		if r.dir < 0 || d.dirs[r.dir].path != path.Dir(d.groups[r.group].Files[r.file].Path) {
+			t.Errorf("row %d shows %q under the wrong folder", i, d.groups[r.group].Files[r.file].Path)
+		}
+	}
+	if len(seen) != len(want) || len(seen) != len(d.dirs) {
+		t.Errorf("%d folders headed, want %d", len(seen), len(want))
+	}
+	for dir, n := range seen {
+		if n != 1 {
+			t.Errorf("folder %q is headed %d times", dir, n)
+		}
+		if !want[dir] {
+			t.Errorf("folder %q has no copies", dir)
+		}
+	}
+	if rows != copies {
+		t.Errorf("%d copies listed, want %d", rows, copies)
+	}
+	// Every folder open at first: its line and its copies.
+	if len(d.rows) != len(d.dirs)+copies {
+		t.Errorf("%d rows for %d folders and %d copies", len(d.rows), len(d.dirs), copies)
+	}
+	if len(d.folded) != 0 {
+		t.Errorf("the folder view opens with %d folders folded", len(d.folded))
+	}
+	for i := 1; i < len(d.dirs); i++ {
+		a, b := d.dirs[i-1], d.dirs[i]
+		if a.reclaim < b.reclaim || a.reclaim == b.reclaim && a.path > b.path {
+			t.Errorf("folder order: %q (%d) before %q (%d)", a.path, a.reclaim, b.path, b.reclaim)
+		}
+	}
+	// The header says the folders hold the copies, and how they fold.
+	if s := "分布在 " + itoa(len(d.dirs)) + " 个文件夹"; !tt.HasText(s) {
+		t.Errorf("no word of %q; texts %q", s, tt.Texts())
+	}
+	if !tt.HasText("点击文件夹可折叠") {
+		t.Errorf("no word of folding; texts %q", tt.Texts())
+	}
+	save(t, tt, "dedup-folders")
+
+	// And back to the groups: the same results, the same choice.
+	if err := tt.Click("按重复组"); err != nil {
+		t.Fatalf("%v; texts %q", err, tt.Texts())
+	}
+	tt.Advance(200 * time.Millisecond)
+	if d.byFolder != 0 {
+		t.Errorf("the way back left view %d", d.byFolder)
+	}
+	if len(d.rows) != len(d.groups)+copies {
+		t.Errorf("%d rows in the group view, want %d", len(d.rows), len(d.groups)+copies)
+	}
+	if len(d.chosen) != len(chosenBefore) || d.selCount != selBefore {
+		t.Errorf("the way back chose %d files of %d, want %d of %d",
+			d.selCount, len(d.chosen), selBefore, len(chosenBefore))
+	}
+}
