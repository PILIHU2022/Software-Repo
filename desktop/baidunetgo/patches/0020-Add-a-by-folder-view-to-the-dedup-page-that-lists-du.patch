+
+	// The first folder, the one that could free the most, unless it is the
+	// root, whose label the sidebar shows too.
+	di := 0
+	if d.dirs[di].path == "/" && len(d.dirs) > 1 {
+		di = 1
+	}
+	f := d.dirs[di]
+	if len(f.files) == 0 {
+		t.Fatalf("folder %q holds no copies", f.path)
+	}
+	var names []string
+	for _, ref := range f.files {
+		names = append(names, d.groups[ref.group].Files[ref.file].Name)
+	}
+	before := len(d.rows)
+	scans, selBefore, chosenBefore := d.scanID, d.selCount, len(d.chosen)
+	reclaimBefore := d.totalReclaim
+	for i, r := range d.rows {
+		if r.file < 0 && d.dirs[r.dir].path == f.path {
+			if i != di {
+				t.Errorf("folder %q heads row %d, want %d", f.path, i, di)
+			}
+			break
+		}
+	}
+
+	clickDedupRow(t, tt, f.label)
+	tt.Advance(200 * time.Millisecond)
+	if !d.folded[f.path] {
+		t.Fatalf("clicking %q did not fold it; folded %v", f.path, d.folded)
+	}
+	if len(d.rows) != before-len(f.files) {
+		t.Errorf("folding left %d rows, want %d", len(d.rows), before-len(f.files))
+	}
+	for _, r := range d.rows {
+		if r.file >= 0 && d.dirs[r.dir].path == f.path {
+			t.Errorf("a copy of the folded %q is still listed: %+v", f.path, r)
+		}
+	}
+	for _, name := range names {
+		if tt.HasText(name) {
+			t.Errorf("the folded copy %q is still shown; texts %q", name, tt.Texts())
+		}
+	}
+	// Its line stays, saying how many copies it holds.
+	if !tt.HasText(f.label) || !tt.HasText(itoa(len(f.files))+" 项") {
+		t.Errorf("the folded folder's line is gone; texts %q", tt.Texts())
+	}
+	// Folding changes no result and starts no scan.
+	if d.scanID != scans {
+		t.Errorf("folding scanned again: %d scans", d.scanID)
+	}
+	if d.totalReclaim != reclaimBefore {
+		t.Errorf("folding changed what the results could free: %d, was %d", d.totalReclaim, reclaimBefore)
+	}
+	var dirsReclaim int64
+	for i := range d.dirs {
+		dirsReclaim += d.dirs[i].reclaim
+	}
+	if dirsReclaim != reclaimBefore {
+		t.Errorf("the folders could free %d, the groups %d", dirsReclaim, reclaimBefore)
+	}
+	if d.selCount != selBefore || len(d.chosen) != chosenBefore {
+		t.Errorf("folding chose %d files of %d, want %d of %d",
+			d.selCount, len(d.chosen), selBefore, chosenBefore)
+	}
+	save(t, tt, "dedup-folders-folded")
+
+	// The fold is of the page, not of a view: it stays as the views change.
+	if err := tt.Click("按重复组"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if !d.folded[f.path] {
+		t.Errorf("the group view forgot the fold of %q", f.path)
+	}
+	if err := tt.Click("按文件夹"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Advance(100 * time.Millisecond)
+	if len(d.rows) != before-len(f.files) {
+		t.Errorf("the folder view shows %d rows after its way back, want %d", len(d.rows), before-len(f.files))
+	}
+
+	// A click on the line shows the copies again.
+	clickDedupRow(t, tt, f.label)
+	tt.Advance(200 * time.Millisecond)
+	if d.folded[f.path] {
+		t.Fatalf("%q stayed folded", f.path)
+	}
+	if len(d.rows) != before {
+		t.Errorf("%d rows after unfolding, want %d", len(d.rows), before)
+	}
+	for _, name := range names {
+		if !tt.HasText(name) {
+			t.Errorf("the unfolded copy %q is not shown", name)
+		}
+	}
+	if d.scanID != scans || d.selCount != selBefore {
+		t.Errorf("unfolding scanned or chose: %d scans, %d chosen", d.scanID, d.selCount)
+	}
+}
