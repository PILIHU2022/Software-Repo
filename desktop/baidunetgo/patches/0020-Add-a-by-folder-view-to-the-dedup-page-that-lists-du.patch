diff --git a/app/dedup.go b/app/dedup.go
index 07b7ec0..ef0ec65 100644
--- a/app/dedup.go
+++ b/app/dedup.go
@@ -8,6 +8,7 @@ import (
 	"path"
 	"path/filepath"
 	"slices"
+	"sort"
 	"strings"
 	"time"
 
@@ -26,11 +27,28 @@ var (
 	dedupReport  = 180 * time.Millisecond
 )
 
-// dedupRow is a line of the results: a group's heading, or one of its
-// files.
+// dedupRow is a line of the results: a group's heading in the group view, a
+// folder's heading in the folder view, or one of their files. The two views
+// order the same results differently; neither holds lines of its own.
 type dedupRow struct {
-	group int
-	file  int // -1 for the group's heading
+	dir   int // the folder of the folder view the row is of, -1 in the group view
+	group int // the group a heading or a file belongs to, -1 for a folder's heading
+	file  int // the file of its group, -1 for a heading of either view
+}
+
+// dedupFolder is a folder of the results as the folder view shows it: the
+// copies under it, and what removing its spare ones would free.
+type dedupFolder struct {
+	path    string // the folder on the netdisk
+	label   string // its path under the root scanned, 我的文件 for that root
+	files   []dedupFileRef
+	reclaim int64 // what deleting the copies here that are not their group's kept one frees
+}
+
+// dedupFileRef is a copy as the folder view lists it: the group it is of,
+// and that group's file.
+type dedupFileRef struct {
+	group, file int
 }
 
 // dedupState is the page finding the netdisk's duplicate files.
@@ -39,6 +57,19 @@ type dedupState struct {
 	groups []dedup.Group
 	rows   []dedupRow
 
+	// The view the results are in: the groups together (0, the way the
+	// page opens), or the folders (1), whose lines can be folded away.
+	// Neither holds results of its own: the same groups, chosen files and
+	// scan lie under both, and switching between them keeps the choice.
+	byFolder int
+	folded   map[string]bool // folders folded away in the folder view, by path
+	dirs     []dedupFolder   // the folders of the folder view, built by flatten
+	// A folder's line clicked to fold it, applied once the list is built:
+	// the lines under it leave while it walks them. foldWantRow is the row
+	// the line was at, kept in view as it folds.
+	foldWant    string
+	foldWantRow int
+
 	scannedDirs, scannedFiles int
 	skipped                   int // files with no MD5, not compared
 	failed                    int // folders that could not be read
@@ -529,17 +560,122 @@ func (a *App) dedupEnter() {
 	a.enterDedup()
 }
 
-// flatten turns the groups into the list's lines.
+// flatten turns the groups into the list's lines, as the view in hand
+// shows them.
 func (d *dedupState) flatten() {
+	if d.byFolder == 1 {
+		d.flattenFolders()
+		return
+	}
 	d.rows = d.rows[:0]
 	for gi, g := range d.groups {
-		d.rows = append(d.rows, dedupRow{group: gi, file: -1})
+		d.rows = append(d.rows, dedupRow{dir: -1, group: gi, file: -1})
 		for fi := range g.Files {
-			d.rows = append(d.rows, dedupRow{group: gi, file: fi})
+			d.rows = append(d.rows, dedupRow{dir: -1, group: gi, file: fi})
+		}
+	}
+}
+
+// flattenFolders turns the groups into the folder view's lines: a heading
+// for every folder that holds a repeating file, and under it the copies it
+// holds while it is not folded. A copy is listed under the folder it is in,
+// once, however many other folders its group reaches; a folder comes by
+// what removing its spare copies would free, the most first, its path
+// breaking a tie, and its copies keep the order the group view gives them.
+func (d *dedupState) flattenFolders() {
+	d.dirs = d.dirs[:0]
+	at := make(map[string]int, len(d.groups))
+	for gi, g := range d.groups {
+		for fi, f := range g.Files {
+			dir := path.Dir(f.Path)
+			di, ok := at[dir]
+			if !ok {
+				di = len(d.dirs)
+				at[dir] = di
+				d.dirs = append(d.dirs, dedupFolder{path: dir})
+			}
+			// The group's kept copy is its first, so the other copies here
+			// are what a delete in this folder alone would free.
+			if fi > 0 {
+				d.dirs[di].reclaim += f.Size
+			}
+			d.dirs[di].files = append(d.dirs[di].files, dedupFileRef{group: gi, file: fi})
+		}
+	}
+	// A folder that no longer holds a copy keeps no fold.
+	for dir := range d.folded {
+		if _, ok := at[dir]; !ok {
+			delete(d.folded, dir)
+		}
+	}
+	for i := range d.dirs {
+		d.dirs[i].label = dedupDirLabel(d.root, d.dirs[i].path)
+	}
+	sort.SliceStable(d.dirs, func(i, j int) bool {
+		a, b := d.dirs[i], d.dirs[j]
+		if a.reclaim != b.reclaim {
+			return a.reclaim > b.reclaim
+		}
+		return a.path < b.path
+	})
+	d.rows = d.rows[:0]
+	for di := range d.dirs {
+		f := &d.dirs[di]
+		d.rows = append(d.rows, dedupRow{dir: di, group: -1, file: -1})
+		if d.folded[f.path] {
+			continue
+		}
+		for _, ref := range f.files {
+			d.rows = append(d.rows, dedupRow{dir: di, group: ref.group, file: ref.file})
 		}
 	}
 }
 
+// dedupDirLabel is a folder's path as the folder view heads it: under the
+// root scanned, which shows as 我的文件.
+func dedupDirLabel(root, dir string) string {
+	if root == "" {
+		root = "/"
+	}
+	if dir == root {
+		return "我的文件"
+	}
+	if root == "/" {
+		return strings.TrimPrefix(dir, "/")
+	}
+	return strings.TrimPrefix(strings.TrimPrefix(dir, root), "/")
+}
+
+// setView shows the results as the groups (0) or as the folders (1),
+// reordering the lines only: the groups, the files chosen and what a delete
+// would remove stay as they are, so switching views loses no choice. The
+// view in hand is the caller's, as the control that changed it has already
+// written it: setView always builds the lines again.
+func (d *dedupState) setView(v int) {
+	if v != 0 {
+		v = 1
+	}
+	d.byFolder = v
+	d.foldWant = ""
+	d.flatten()
+	d.scrollTop = true
+}
+
+// toggleFold folds a folder of the folder view away, or shows it again. It
+// reads nothing again and starts no scan: the results stay as they are, and
+// so does the choice.
+func (d *dedupState) toggleFold(dir string) {
+	if d.folded == nil {
+		d.folded = map[string]bool{}
+	}
+	if d.folded[dir] {
+		delete(d.folded, dir)
+	} else {
+		d.folded[dir] = true
+	}
+	d.flatten()
+}
+
 // chooseDefaults chooses every copy but each group's kept one: the
 // earliest modified, its path breaking a tie.
 func (d *dedupState) chooseDefaults() {
@@ -927,10 +1063,25 @@ func (a *App) dedupHeader(c *ui.Context, t *ui.Theme, p *palette) {
 				a.startDedupScan(d.root)
 			}
 		})
+		// The same results in either order: the groups' copies together, or
+		// the folders that hold them, whose lines fold away. Switching
+		// reorders the lines only, so the choice in hand stays.
+		if d.loaded && len(d.groups) > 0 {
+			was := d.byFolder
+			ui.Row(c).Gap(10).AlignItems(ui.Center).Children(func() {
+				choice(c, t, p, &d.byFolder, a.compact, "按重复组", "按文件夹").Label("查看方式")
+			})
+			if d.byFolder != was {
+				d.setView(d.byFolder)
+			}
+		}
 		var parts []string
 		parts = append(parts, itoa(d.scannedDirs)+" 个文件夹", itoa(d.scannedFiles)+" 个文件")
