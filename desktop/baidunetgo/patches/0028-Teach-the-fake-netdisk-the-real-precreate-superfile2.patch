+// TestChunkedUploadRefusesBadBlockList checks create refuses parts whose
+// MD5 does not match the block list, and stores no file then.
+func TestChunkedUploadRefusesBadBlockList(t *testing.T) {
+	s := New()
+	defer s.Close()
+
+	content := []byte("only one part")
+	const target = "/上传/坏哈希.txt"
+	id := precreate(t, s, target, content, []string{md5Hex(content)})
+	sendPart(t, s, id, target, 0, content, true)
+
+	bl, err := json.Marshal([]string{md5Hex([]byte("something else"))})
+	if err != nil {
+		t.Fatalf("block list: %v", err)
+	}
+	cr := postForm(t, s, "/api/create", url.Values{
+		"path": {target}, "size": {strconv.Itoa(len(content))}, "isdir": {"0"},
+		"block_list": {string(bl)}, "uploadid": {id}, "rtype": {"2"},
+	})
+	if cr["errno"] == float64(0) {
+		t.Fatalf("create accepted a block_list that does not match the part")
+	}
+	if s.Exists(target) {
+		t.Fatalf("create of a mismatched block_list stored %q anyway", target)
+	}
+	if got := s.Data(target); got != nil {
+		t.Fatalf("create of a mismatched block_list stored %d bytes", len(got))
+	}
+}
