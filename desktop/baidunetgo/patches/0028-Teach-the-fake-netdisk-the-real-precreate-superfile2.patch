 // New starts a fake netdisk holding a few sample folders and files.
 func New() *Server {
+	s := newServer()
+	s.Server = httptest.NewServer(s.mux)
+	s.mirror = httptest.NewServer(s.mux)
+	return s
+}
+
+// Serve starts a fake netdisk serving on addr until Close, for a process
+// that hosts it for other programs to talk to (cmd/fakepand does that for
+// the Android client's tests). wrap, when not nil, is applied to the routes
+// before serving, to log or shape requests. The URL field holds the address
+// actually taken, which matters when addr ends in ":0".
+func Serve(addr string, wrap func(http.Handler) http.Handler) (*Server, error) {
+	ln, err := net.Listen("tcp", addr)
+	if err != nil {
+		return nil, err
+	}
+	s := newServer()
+	var h http.Handler = s.mux
+	if wrap != nil {
+		h = wrap(h)
+	}
+	ts := httptest.NewUnstartedServer(h)
+	ts.Listener.Close() // the port httptest picked, never used
+	ts.Listener = ln
+	ts.Start()
+	s.Server = ts
+	s.mirror = httptest.NewServer(s.mux)
+	return s, nil
+}
+
+// newServer builds the fake netdisk's tree and routes, not serving them yet.
+func newServer() *Server {
 	s := &Server{nodes: map[string]*Node{}, nextID: 1000}
 	s.nodes["/"] = &Node{FsID: 1, Path: "/", IsDir: true}
 	s.seed()
@@ -109,8 +148,8 @@ func New() *Server {
 	mux.HandleFunc("/locatedownload", s.locate)
 	s.opsRoutes(mux)
 	s.shareRoutes(mux)
-	s.Server = httptest.NewServer(mux)
-	s.mirror = httptest.NewServer(mux)
+	s.upload2Routes(mux)
+	s.mux = mux
 	return s
 }
 
