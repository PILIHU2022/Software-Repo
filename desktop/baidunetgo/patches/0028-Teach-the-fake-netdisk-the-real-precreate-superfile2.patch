diff --git a/cmd/fakepand/main.go b/cmd/fakepand/main.go
new file mode 100644
index 0000000..51c5881
--- /dev/null
+++ b/cmd/fakepand/main.go
@@ -0,0 +1,82 @@
+// Command fakepand runs the fake Baidu Netdisk of internal/fakepan as a
+// standalone process, so that a test of a client that is not Go — the new
+// Android app's Kotlin netdisk client — can host the same pretend netdisk
+// the desktop app's own tests use.
+//
+// It prints one line, "url=<base url>", to stdout once listening (with
+// -addr 127.0.0.1:0 the kernel picks a free port, so the line is the only
+// place the real one is told), then serves until SIGINT or SIGTERM and
+// exits 0. The spawned process is meant to be killed with a signal; it
+// keeps no state on disk.
+//
+// Usage:
+//
+//	fakepand [-addr 127.0.0.1:0] [-quiet]
+//
+// The fake netdisk answers the pan.baidu.com and pcs.baidu.com endpoints
+// the client needs, including the real chunked upload protocol —
+// POST /api/precreate, POST /rest/2.0/pcs/file?method=locateupload,
+// POST /rest/2.0/pcs/superfile2?method=upload and POST /api/create.
+package main
+
+import (
+	"flag"
+	"fmt"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"github.com/pengstem/baidunetgo/internal/fakepan"
+)
+
+func main() {
+	addr := flag.String("addr", "127.0.0.1:0", "address to listen on")
+	quiet := flag.Bool("quiet", false, "do not log requests to stderr")
+	flag.Parse()
+
+	var wrap func(http.Handler) http.Handler
+	if !*quiet {
+		wrap = logRequests
+	}
+	srv, err := fakepan.Serve(*addr, wrap)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "fakepand:", err)
+		os.Exit(1)
+	}
+	fmt.Printf("url=%s\n", srv.URL)
+	os.Stdout.Sync() // tell the parent the server is ready, not to wait
+
+	sig := make(chan os.Signal, 1)
+	signal.Notify(sig, os.Interrupt, syscall.SIGTERM)
+	<-sig
+	srv.Close()
+}
+
+// logRequests writes each request to stderr, so that whoever runs the
+// process by hand sees what its client did; -quiet leaves it out, as a
+// test spawning the process wants no noise.
+func logRequests(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rec := &statusRecorder{ResponseWriter: w, status: http.StatusOK}
+		next.ServeHTTP(rec, r)
+		fmt.Fprintf(os.Stderr, "%s %s %d\n", r.Method, r.URL.RequestURI(), rec.status)
+	})
+}
+
+// statusRecorder keeps the status a handler wrote, for the log line.
+type statusRecorder struct {
+	http.ResponseWriter
+	status int
+}
+
+func (r *statusRecorder) WriteHeader(code int) {
+	r.status = code
+	r.ResponseWriter.WriteHeader(code)
+}
+
+func (r *statusRecorder) Flush() {
+	if f, ok := r.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
