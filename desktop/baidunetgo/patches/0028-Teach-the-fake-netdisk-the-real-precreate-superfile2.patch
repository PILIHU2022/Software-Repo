+// TestChunkedUploadUnknownID checks superfile2 and create for an id the
+// netdisk never gave answer an error instead of panicking.
+func TestChunkedUploadUnknownID(t *testing.T) {
+	s := New()
+	defer s.Close()
+
+	resp, err := http.Post(partURL(s, "no-such-upload", "/x.bin", 0), "application/octet-stream", strings.NewReader("part"))
+	if err != nil {
+		t.Fatalf("POST superfile2: %v", err)
+	}
+	out := decodeJSON(t, resp, "superfile2")
+	resp.Body.Close()
+	if out["errno"] == float64(0) {
+		t.Fatalf("superfile2 accepted an unknown uploadid: %v", out)
+	}
+
+	bl, err := json.Marshal([]string{md5Hex([]byte("part"))})
+	if err != nil {
+		t.Fatalf("block list: %v", err)
+	}
+	cr := postForm(t, s, "/api/create", url.Values{
+		"path": {"/x.bin"}, "size": {"4"}, "isdir": {"0"},
+		"block_list": {string(bl)}, "uploadid": {"no-such-upload"},
+	})
+	if cr["errno"] == float64(0) {
+		t.Fatalf("create accepted an unknown uploadid: %v", cr)
+	}
+	// The fake netdisk keeps answering.
+	if st := getJSON(t, s, "/api/loginStatus"); st["errno"] != float64(0) {
+		t.Fatalf("loginStatus after unknown uploads: %v", st)
+	}
+}
