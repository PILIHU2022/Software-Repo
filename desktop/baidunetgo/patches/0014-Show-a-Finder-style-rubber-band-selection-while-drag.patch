+// The rubber band: from the press point to the pointer, in the accent
+// color, with a faint fill and a 1px edge, rounded a little.
+const (
+	marqueeRadius = 3
+	marqueeSlop   = 3 // DIPs the pointer must move before the box shows
+)
+
+// marqueeBlocked says a rubber band must not show: the preview or a
+// dialog owns the pointer, a name is being edited, a folder is being
+// named, or files from another app are dragged in.
+func (a *App) marqueeBlocked(l *listing) bool {
+	return a.pv != nil || a.dlg.open || a.dlg.busy || a.renaming != nil || a.creating != nil || l.over
+}
+
+// marquee moves the rubber band along with the pointer and paints it over
+// the page, above the rows or the tiles. The selection itself stays as it
+// was: the list's rows are still chosen by MyGo's DragSelect, and the grid
+// chooses the tiles the box covers.
+func (a *App) marquee(c *ui.Context, t *ui.Theme, l *listing, page ui.Element) {
+	if a.marqueeBlocked(l) || !l.pressDown {
+		l.dragOn, l.dragRows, l.dragGrid = false, false, false
+		l.dragRect = ui.Rect{}
+		return
+	}
+	if l.pressNew {
+		l.pressNew = false
+		// A press in the viewport starts a box; a tile in the grid choosing
+		// itself, or a press on the header or the status bar, does not.
+		if l.dragArea.W > 0 && l.dragArea.Contains(l.pressAt.X, l.pressAt.Y) &&
+			!(a.gridView && l.dragTileHit) {
+			l.dragOn, l.dragFrom, l.dragGrid = true, l.pressAt, a.gridView
+			l.dragRows, l.dragLast = false, ui.Rect{}
+		}
+	}
+	if !l.dragOn {
+		return
+	}
+	if !l.dragGrid {
+		if l.list.DragSelecting() {
+			l.dragRows = true // MyGo's own drag began choosing rows
+		} else if l.dragRows {
+			// It ended, even if the release came outside the window.
+			l.dragOn, l.dragRows = false, false
+			l.dragRect = ui.Rect{}
+			return
+		}
+	}
+	b := page.Bounds()
+	x, y, _ := page.PointerPosition()
+	to := ui.Point{X: b.X + x, Y: b.Y + y}
+	rect := marqueeRect(l.dragFrom, to, l.dragArea)
+	if rect.W < marqueeSlop && rect.H < marqueeSlop && !l.list.DragSelecting() {
+		l.dragRect = ui.Rect{} // a click, not yet a drag
+		return
+	}
+	l.dragRect = rect
+	page.DrawOver(func(p *ui.Painter, r ui.Rect) {
+		rr := l.dragRect
+		if rr.W <= 0 && rr.H <= 0 {
+			return
+		}
+		// A drag straight up, down or across is a 1px line, not nothing.
+		if rr.W < 1 {
+			rr.W = 1
+		}
+		if rr.H < 1 {
+			rr.H = 1
+		}
+		p.Fill(rr, t.Accent.Alpha(0.12), marqueeRadius)
+		p.Stroke(rr, t.Accent, marqueeRadius, 1)
+	})
+	if l.dragGrid {
+		a.gridMarquee(l, rect)
+	}
+}
+
+// marqueeRect is the rectangle from a to b, clipped to area.
+func marqueeRect(a, b ui.Point, area ui.Rect) ui.Rect {
+	x0, x1 := min(a.X, b.X), max(a.X, b.X)
+	y0, y1 := min(a.Y, b.Y), max(a.Y, b.Y)
+	x0, y0 = max(x0, area.X), max(y0, area.Y)
+	x1, y1 = min(x1, area.X+area.W), min(y1, area.Y+area.H)
+	if x1 < x0 {
+		x1 = x0
+	}
+	if y1 < y0 {
+		y1 = y0
+	}
+	return ui.Rect{X: x0, Y: y0, W: x1 - x0, H: y1 - y0}
+}
+
+// gridMarquee chooses the grid's tiles the box covers. It is the grid's
+// own version of DragSelect, which the list has and the grid does not.
+func (a *App) gridMarquee(l *listing, rect ui.Rect) {
+	if rect == l.dragLast {
+		return
+	}
+	l.dragLast = rect
+	l.sel.Clear()
+	for id, spot := range l.grid.spots {
+		if id >= 0 && spot.rect.W > 0 && rectIntersects(rect, spot.rect) {
+			l.sel.Add(id)
+		}
+	}
+	l.selected = -1
+}
+
+// rectIntersects reports whether a and b share some area.
+func rectIntersects(a, b ui.Rect) bool {
+	return a.X < b.X+b.W && b.X < a.X+a.W && a.Y < b.Y+b.H && b.Y < a.Y+a.H
+}
