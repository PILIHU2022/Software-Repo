+package app
+
+import (
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+
+	"github.com/pengstem/baidunetgo/internal/fakepan"
+)
+
+// TestMarqueeDragSelect drags over the rows: MyGo's DragSelect still
+// chooses the three rows, and a rubber-band rectangle follows the pointer
+// from where it went down, then goes at the release. A second drag from
+// the rows' blank space shows the box too, without changing the choice.
+func TestMarqueeDragSelect(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.Advance(time.Second)
+	l := a.listings["/"]
+	from, _ := tt.Find(l.files[0].Name)
+	to, _ := tt.Find(l.files[2].Name)
+	x, y0 := from.X+5, from.Y+5
+	y1 := to.Y + 5
+
+	tt.Press(x, y0)
+	tt.Frame()
+	tallest := ui.Rect{}
+	steps := int((y1 - y0) / 6)
+	for i := 1; i <= steps; i++ {
+		tt.Move(x+float32(i)*4, y0+float32(i)*6)
+		tt.Frame()
+		if l.dragOn && l.dragRect.H > tallest.H {
+			tallest = l.dragRect
+		}
+	}
+	if !l.dragOn {
+		t.Fatalf("no marquee while dragging; press %v rect %v", l.dragFrom, l.dragRect)
+	}
+	if tallest.W <= 0 || tallest.H <= 0 {
+		t.Fatalf("marquee has no size: %v", tallest)
+	}
+	// It starts at the press, not snapped to a row, and keeps inside the
+	// list's viewport.
+	if d := l.dragFrom.Y - y0; d < -1 || d > 1 {
+		t.Errorf("marquee starts at y=%.0f, press at %.0f", l.dragFrom.Y, y0)
+	}
+	if r := tallest; r.Y < l.dragArea.Y-1 || r.Y+r.H > l.dragArea.Y+l.dragArea.H+1 {
+		t.Errorf("marquee %v outside the list %v", r, l.dragArea)
+	}
+
+	tt.Release(x+float32(steps)*4, y0+float32(steps)*6)
+	tt.Frame()
+	if l.dragOn || l.dragRect != (ui.Rect{}) {
+		t.Errorf("marquee stayed after release: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+	if l.sel.Len() != 3 || !l.sel.Has(l.files[0].FsID) || !l.sel.Has(l.files[2].FsID) {
+		t.Fatalf("drag chose %d, not the three rows", l.sel.Len())
+	}
+
+	// A drag begun in the rows' blank space shows the box as well; the
+	// choice is still MyGo's DragSelect's, which a blank press does not
+	// begin, so the three rows stay chosen.
+	last, _ := tt.Find(l.files[len(l.files)-1].Name)
+	bx, by := last.X+30, last.Y+80
+	tt.Press(bx, by)
+	tt.Frame()
+	for i := 1; i <= 18; i++ {
+		tt.Move(bx+float32(i)*2, by-float32(i)*11)
+		tt.Frame()
+	}
+	if !l.dragOn || l.dragRect.W <= 0 || l.dragRect.H <= 0 {
+		t.Fatalf("no marquee from blank space: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+	save(t, tt, "marquee")
+	tt.Release(bx+36, by-198)
+	tt.Frame()
+	if l.dragOn || l.dragRect != (ui.Rect{}) {
+		t.Errorf("marquee stayed after the blank drag: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+}
+
+// TestMarqueeHidden says the rectangle stays away while a dialog owns the
+// pointer, a name is edited, a folder is named, the preview shows, or files
+// from another app are dragged in.
+func TestMarqueeHidden(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	l := a.listings["/"]
+	if a.marqueeBlocked(l) {
+		t.Fatal("no overlay open, yet a rubber band is blocked")
+	}
+	cases := []struct {
+		name string
+		set  func()
+		undo func()
+	}{
+		{"dialog", func() { a.dlg = dialog{open: true} }, func() { a.dlg = dialog{} }},
+		{"renaming", func() { a.renaming = &renaming{} }, func() { a.renaming = nil }},
+		{"creating", func() { a.creating = &creating{} }, func() { a.creating = nil }},
+		{"preview", func() { a.pv = &previewState{} }, func() { a.pv = nil }},
+		{"files over", func() { l.over = true }, func() { l.over = false }},
+	}
+	for _, c := range cases {
+		c.set()
+		if !a.marqueeBlocked(l) {
+			t.Errorf("%s did not block the rubber band", c.name)
+		}
+		c.undo()
+	}
+
+	// A real drag with a dialog open shows no box, though the pointer moves
+	// over the rows.
+	a.dlg = dialog{open: true}
+	from, _ := tt.Find(l.files[0].Name)
+	tt.Press(from.X+5, from.Y+5)
+	for y := from.Y + 5; y < from.Y+80; y += 8 {
+		tt.Move(from.X+5, y)
+		tt.Frame()
+	}
+	if l.dragOn || l.dragRect != (ui.Rect{}) {
+		t.Errorf("marquee showed with a dialog open: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+	tt.Release(from.X+5, from.Y+80)
+	a.dlg = dialog{}
+	tt.Frame()
+}
+
+// TestMarqueeGridDrags a blank part of the grid: the box selects the tiles
+// it covers, and it goes at the release.
+func TestMarqueeGridDrags(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	for i := 1; i <= 3; i++ {
+		srv.Add(fakepan.Node{Path: fmt.Sprintf("/剧集/E%02d.mkv", i), Category: 1, Size: 1 << 30})
+	}
+	a.gridView = true
+	a.router.Push(filesRoute("/剧集"))
+	waitFor(t, tt, "E01.mkv")
+	tt.Advance(time.Second)
+	l := a.listingFor("/剧集")
+	area := l.dragArea
+	if area.W <= 0 || area.H <= 0 {
+		t.Fatalf("no grid viewport: %v", area)
+	}
+	// Press below the single row of tiles, in blank space, and drag up over
+	// them.
+	x0 := area.X + 40
+	y0 := area.Y + area.H - 24
+	x1, y1 := x0+120, area.Y+24
+	tt.Press(x0, y0)
+	tt.Frame()
+	for i := 1; i <= 16; i++ {
+		f := float32(i) / 16
+		tt.Move(x0+(x1-x0)*f, y0+(y1-y0)*f)
+		tt.Frame()
+	}
+	if !l.dragOn || l.dragRect.W <= 0 || l.dragRect.H <= 0 {
+		t.Fatalf("no marquee in the grid: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+	if l.sel.Len() == 0 {
+		t.Errorf("the box over the tiles chose none")
+	}
+	for id := range l.sel.All() {
+		if id < 0 {
+			t.Errorf("chose a temporary row %d", id)
+		}
+	}
+	save(t, tt, "marquee-grid")
+
+	tt.Release(x1, y1)
+	tt.Frame()
+	if l.dragOn || l.dragRect != (ui.Rect{}) {
+		t.Errorf("marquee stayed after release: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+
+	// A press on a tile is no rubber band: it chooses the tile as before.
+	tile, _ := tt.Find(l.files[0].Name)
+	tt.Press(tile.X+5, tile.Y+5)
+	tt.Frame()
+	if l.dragOn || l.dragRect != (ui.Rect{}) {
+		t.Errorf("marquee began on a tile: on=%v rect=%v", l.dragOn, l.dragRect)
+	}
+	tt.Release(tile.X+5, tile.Y+5)
+	tt.Frame()
+	if l.sel.Len() != 1 || !l.sel.Has(l.files[0].FsID) {
+		t.Errorf("a click on a tile chose %d, want the tile", l.sel.Len())
+	}
+}
