+)
+
+// The benchmarks build frames with ui.Tester, as the UI tests do, so that
+// the cost of a frame's view build can be measured without a window. The
+// tester runs shaders and text layout on the CPU, so absolute numbers are
+// not a desktop's, but the same window, font and effects are built before
+// and after a change, which is what a comparison needs.
+//
+// Run them with:
+//
+//	go test ./app -run '^$' -bench 'Benchmark' -benchmem -count=3
+//
+// and add -cpuprofile/-memprofile to find a hot spot.
+
+// signedInB is signedIn for benchmarks.
+func signedInB(b *testing.B) (*App, *ui.Tester, *fakepan.Server) {
+	b.Helper()
+	srv := fakepan.New()
+	b.Cleanup(srv.Close)
+	a := New()
+	a.fake = true
+	go a.signInWith(baidu.OpenAt(baidu.Credentials{BDUSS: "fake", UID: 1}, srv.URL), false)
+	tt := ui.NewTester(a.View, 1200, 800)
+	tt.SetLocale("zh-Hans")
+	waitForB(b, tt, "照片")
+	return a, tt, srv
+}
+
+// waitForB is waitFor for benchmarks.
+func waitForB(b *testing.B, tt *ui.Tester, text string) {
+	b.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for !tt.HasText(text) {
+		if time.Now().After(deadline) {
+			b.Fatalf("%q never showed; texts %q", text, tt.Texts())
+		}
+		time.Sleep(10 * time.Millisecond)
+		tt.Advance(50 * time.Millisecond)
+	}
+}
+
+// benchFolder fills dir in the fake netdisk with n files, none with a
+// thumbnail, so that a frame does not fetch images, and opens it.
+func benchFolder(b testing.TB, a *App, tt *ui.Tester, srv *fakepan.Server, dir string, n int) *listing {
+	b.Helper()
+	for i := range n {
+		srv.Add(fakepan.Node{
+			Path:  fmt.Sprintf("%s/文件 %04d.dat", dir, i),
+			Size:  int64(1<<20) * int64(i+1),
+			Mtime: time.Now().Add(-time.Duration(i) * time.Hour).Unix(),
+		})
+	}
+	a.router.Push(filesRoute(dir))
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		l := a.listings[dir]
+		if l != nil && l.loaded && len(l.files) == n {
+			// No entrance animation, no read again while the benchmark
+			// runs: the frames measured are of a folder that has settled.
+			l.shown = time.Now().Add(-time.Hour)
+			l.read = time.Now()
+			return l
+		}
+		if time.Now().After(deadline) {
+			b.Fatalf("%s never loaded (%d files)", dir, len(l.files))
+		}
+		time.Sleep(5 * time.Millisecond)
+		tt.Advance(20 * time.Millisecond)
+	}
+}
+
+// benchFrames runs the frames of tt for b.N iterations, reporting frames
+// built per tester frame so that a change that quietly builds several
+// frames per call cannot pass as a speedup.
+func benchFrames(b *testing.B, a *App, tt *ui.Tester) {
+	b.Helper()
+	// Settle the one-shot animations (transitions, entrances, glides) the
+	// page started: at the tester's frozen time they would otherwise ask
+	// for frame after frame, and one tt.Frame would build many.
+	tt.Advance(time.Second)
+	built := a.frame
+	tt.Frame()
+	if one := a.frame - built; one != 1 {
+		b.Fatalf("a settled frame builds %d views, want 1", one)
+	}
+	built = a.frame
+	var gc0, gc1 runtime.MemStats
+	runtime.ReadMemStats(&gc0)
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		tt.Frame()
+	}
+	b.StopTimer()
+	runtime.ReadMemStats(&gc1)
+	b.ReportMetric(float64(a.frame-built)/float64(b.N), "builds/frame")
+	// Garbage a frame makes brings the collector in, and that is where
+	// much of a frame's cost goes: this says how often.
+	b.ReportMetric(float64(gc1.NumGC-gc0.NumGC)/float64(b.N), "gc/op")
+}
+
+// BenchmarkFilesList2000 builds the list view of a folder of 2 000 files.
+func BenchmarkFilesList2000(b *testing.B) {
+	a, tt, srv := signedInB(b)
+	benchFolder(b, a, tt, srv, "/大目录", 2000)
+	benchFrames(b, a, tt)
+}
