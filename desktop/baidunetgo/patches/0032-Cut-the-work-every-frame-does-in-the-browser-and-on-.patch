+// rowText is a file's size, kind and date as a row and a tile show them,
+// formatted once: a frame shows the same rows frame after frame, and
+// formatting each size, kind and date again costs a string and an
+// allocation apiece. The entry is used while it describes the file still
+// (its name, size and mtime), and the date it was written for, as
+// stampTime reads the day it is called on.
+type rowText struct {
+	size, kind, when, typeOf string
+	name                     string
+	sizeOf, mtime            int64
+	day, year                int
+}
+
+// textFor returns f's formatted size, kind and date in l, formatting them
+// when the file or the day changed. Ghost rows, uploads the listing shows
+// before it lists them, are made afresh as the upload moves and are not
+// kept.
+func (a *App) textFor(l *listing, f *baidu.File, now time.Time) *rowText {
+	if f.FsID < 0 {
+		return &rowText{size: sizeLabel(f), kind: kindLabel(f), when: stampTime(f.Mtime, now)}
+	}
+	t := l.texts[f.FsID]
+	if t != nil && t.name == f.Name && t.sizeOf == f.Size && t.mtime == f.Mtime {
+		if t.day != now.YearDay() || t.year != now.Year() {
+			// "今天" and "昨天" are the day's, the rest the year's.
+			t.when = stampTime(f.Mtime, now)
+			t.day, t.year = now.YearDay(), now.Year()
+		}
+		return t
+	}
+	t = &rowText{size: sizeLabel(f), kind: kindLabel(f), when: stampTime(f.Mtime, now),
+		name: f.Name, sizeOf: f.Size, mtime: f.Mtime, day: now.YearDay(), year: now.Year()}
+	if l.texts == nil {
+		l.texts = map[int64]*rowText{}
+	}
+	l.texts[f.FsID] = t
+	return t
+}
+
+// sizeLabel is a file's size as a row shows it: a folder's is a dash.
+func sizeLabel(f *baidu.File) string {
+	if f.IsDir {
