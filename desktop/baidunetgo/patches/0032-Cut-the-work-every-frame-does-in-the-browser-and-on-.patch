+// rowsVary reports whether the list's rows are not all rowHeight tall this
+// frame: a file dissolving closes up, and the row of a failed upload too,
+// so that the rows after them move and rowTops has their tops.
+func (a *App) rowsVary() bool {
+	if len(a.dying) > 0 {
+		return true
+	}
+	for _, g := range a.gathers {
+		if g.failed {
+			return true
+		}
+	}
+	return false
+}
