+	for i := range 100 {
+		l.sel.Add(l.files[i].FsID)
+	}
+	l.selected = 0
+	benchFrames(b, a, tt)
+}
+
+// BenchmarkFilesListUploads builds the list view of a folder of 2 000
+// files while 50 uploads gather into it: every frame tells which of them
+// the listing still lacks, to show them as rows. The uploads are into
+// files the folder already lists, so that no row of theirs comes or goes
+// and every frame measured is the settled one; what they cost a frame is
+// telling them apart from the files.
+func BenchmarkFilesListUploads(b *testing.B) {
+	a, tt, srv := signedInB(b)
+	l := benchFolder(b, a, tt, srv, "/大目录", 2000)
+	const uploading = 50
+	tasks := make([]transfer.Task, 0, uploading)
+	a.gathers = map[string]*gather{}
+	for i := range uploading {
+		// The last files of the folder: the walk to find each of them is
+		// what telling the uploads apart costs.
+		f := l.files[len(l.files)-1-i]
+		tasks = append(tasks, transfer.Task{
+			ID: int64(i + 1), Kind: transfer.Upload, Name: f.Name,
+			Remote: f.Path, Size: 1 << 20, Done: 1 << 20,
+			State: transfer.Running, Speed: 1 << 20,
+		})
+		a.gathers[f.Path] = &gather{size: 1 << 20, target: 1, shown: 1, done: true, ended: tt.Now()}
+	}
+	a.transfers.tasks = tasks
+	l.uploadsSeen = [2]int{a.transfers.gen, l.loads}
+	benchFrames(b, a, tt)
+}
+
+// BenchmarkFilesListGathering builds the list view of a folder of 2 000
+// files with five uploads whose rows the listing does not have yet: their
+// ghost rows sort to the top, and the rows under them glide down to make
+// room. A frame may only be measured once they have arrived: before
+// glideRow's fix the glide restarted for ever, so this benchmark failed
+// instead of measuring.
+func BenchmarkFilesListGathering(b *testing.B) {
+	a, tt, srv := signedInB(b)
+	l := benchFolder(b, a, tt, srv, "/大目录", 2000)
+	const gathering = 5
+	a.gathers = map[string]*gather{}
+	for i := range gathering {
+		name := fmt.Sprintf("AAA 上传 %02d.dat", i)
+		a.gathers[path.Join("/大目录", name)] = &gather{size: 1 << 20, target: 1, shown: 1, done: true, ended: tt.Now()}
+	}
+	l.uploadsSeen = [2]int{a.transfers.gen, l.loads}
+	benchFrames(b, a, tt)
+}
+
+// BenchmarkRowTops measures computing where the rows of 2 000 files start
+// while rows come or go: it builds a map of every file a frame, and now
+// fills a slice the listing keeps.
+func BenchmarkRowTops(b *testing.B) {
+	a, tt, srv := signedInB(b)
+	l := benchFolder(b, a, tt, srv, "/大目录", 2000)
+	now := tt.Now()
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		a.rowTops(l, now)
+	}
+}
+
+// TestGlideSettles checks that rows shifted by five uploads' rows arriving
+// glide to their places and stop: the view must stop asking for frames,
+// and a settled frame must build one view. A glide used to restart every
+// frame whose step came to more than half a row — five rows at once, say —
+// so it never arrived and the frame was built for ever (see
+// docs/PERFORMANCE.md).
+func TestGlideSettles(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	l := benchFolder(t, a, tt, srv, "/大目录", 200)
+	a.gathers = map[string]*gather{}
+	for i := range 5 {
+		name := fmt.Sprintf("AAA 上传 %02d.dat", i)
+		a.gathers[path.Join("/大目录", name)] = &gather{size: 1 << 20, target: 1, shown: 1, done: true, ended: tt.Now()}
+	}
+	l.uploadsSeen = [2]int{a.transfers.gen, l.loads}
+	tt.Advance(time.Second)
+	if n := len(l.ghosts); n != 5 {
+		t.Fatalf("%d ghost rows, want 5", n)
+	}
+	if tt.FramePending() {
+		t.Fatalf("the view still asks for frames after the rows glided: %d glides left", len(l.glides))
+	}
+	built := a.frame
+	tt.Frame()
+	if got := a.frame - built; got != 1 {
+		t.Fatalf("a settled frame built %d views, want 1", got)
+	}
+}
+
+// benchTransferTasks makes a transfers page's tasks: n of them, some
+// running, some queued, some done.
+func benchTransferTasks(n int) []transfer.Task {
+	tasks := make([]transfer.Task, 0, n)
+	for i := range n {
+		t := transfer.Task{
+			ID:      int64(n - i),
+			Kind:    transfer.Download,
+			Name:    fmt.Sprintf("剧集 S01E%02d.mkv", i),
+			Remote:  fmt.Sprintf("/剧集/剧集 S01E%02d.mkv", i),
+			Local:   fmt.Sprintf("/downloads/剧集 S01E%02d.mkv", i),
+			Size:    int64(1<<30) * int64(i+1),
+			Done:    int64(1<<29) * int64(i+1),
+			State:   transfer.Running,
+			Created: time.Now().Add(-time.Duration(i) * time.Minute),
+			Speed:   8 << 20,
+		}
+		switch i % 3 {
+		case 1:
+			t.State = transfer.Queued
+		case 2:
+			t.State = transfer.Done
+			t.Done = t.Size
+			t.Finished = time.Now().Add(-time.Duration(i) * time.Minute)
+		}
+		tasks = append(tasks, t)
+	}
+	return tasks
+}
+
+// BenchmarkTransfersActive builds the transfers page while 200 tasks go.
+func BenchmarkTransfersActive(b *testing.B) {
+	a, tt, _ := signedInB(b)
+	a.transfers.tasks = benchTransferTasks(200)
+	a.router.Push("/transfers")
+	benchFrames(b, a, tt)
+}
+
+// BenchmarkTransfersDone builds the transfers page's finished tab with 200
+// finished tasks.
+func BenchmarkTransfersDone(b *testing.B) {
+	a, tt, _ := signedInB(b)
+	tasks := benchTransferTasks(200)
+	for i := range tasks {
+		tasks[i].State = transfer.Done
+		tasks[i].Done = tasks[i].Size
+	}
+	a.transfers.tasks = tasks
+	a.transfers.tab = 1
+	a.router.Push("/transfers")
+	benchFrames(b, a, tt)
+}
+
+// BenchmarkSettings builds the settings page.
+func BenchmarkSettings(b *testing.B) {
+	a, tt, _ := signedInB(b)
+	a.router.Push("/settings")
+	benchFrames(b, a, tt)
+}
