+}
+
+// BenchmarkFilesListSelected builds the list view with 100 of the 2 000
+// files chosen, whose rows all draw the selection fill and the status bar
+// counts them.
+func BenchmarkFilesListSelected(b *testing.B) {
+	a, tt, srv := signedInB(b)
