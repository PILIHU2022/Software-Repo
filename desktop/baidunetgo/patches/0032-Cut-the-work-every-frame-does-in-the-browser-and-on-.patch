+// listingNames returns the names l lists, in a set kept until its files
+// change: a read, or a file leaving as it dissolves.
+func (l *listing) listingNames() map[string]bool {
+	if l.names == nil {
+		names := make(map[string]bool, len(l.files))
+		for _, f := range l.files {
+			if f.FsID >= 0 {
+				names[f.Name] = true
+			}
+		}
+		l.names = names
+	}
+	return l.names
+}
