+
+// splitTasks puts the tasks into the going and the finished, counting what
+// the page and its toolbar and status dots show, once for each change of
+// them; the lists are kept and filled again as the tasks change.
+func (x *transfersState) splitTasks() {
+	// gen counts the app's changes of the tasks, and the tasks are replaced
+	// whole as they change; the length and the first task's address tell a
+	// replacement from the same slice as well, which the tests (and any
+	// caller setting the tasks without counting a change) rely on.
+	var at *transfer.Task
+	if len(x.tasks) > 0 {
+		at = &x.tasks[0]
+	}
+	if x.splitOK && x.splitGen == x.gen && x.splitLen == len(x.tasks) && x.splitAt == at {
+		return
+	}
+	x.splitOK, x.splitGen, x.splitLen, x.splitAt = true, x.gen, len(x.tasks), at
+	x.going, x.done = x.going[:0], x.done[:0]
+	x.stopped, x.active, x.running, x.down, x.up, x.queued, x.runSpeed = 0, 0, 0, 0, 0, 0, 0
+	clear(x.details)
+	for _, task := range x.tasks {
+		if task.State == transfer.Done {
+			x.done = append(x.done, task)
+			continue
+		}
+		x.going = append(x.going, task)
+		switch task.State {
+		case transfer.Paused, transfer.Failed:
+			x.stopped++
+		case transfer.Running:
+			x.active++
+			x.running++
+			x.runSpeed += task.Speed
+			if task.Kind == transfer.Download {
+				x.down++
+			} else {
+				x.up++
+			}
+		case transfer.Queued:
+			x.active++
+			x.queued++
+		}
+	}
+}
+
+// doneDetail is a finished task's line, written once until the tasks
+// change: a finished task's line does not.
+func (x *transfersState) doneDetail(task transfer.Task) string {
+	if s, ok := x.details[task.ID]; ok {
+		return s
+	}
+	if x.details == nil {
+		x.details = map[int64]string{}
+	}
+	s := transferDetail(task)
+	x.details[task.ID] = s
+	return s
 }
 
