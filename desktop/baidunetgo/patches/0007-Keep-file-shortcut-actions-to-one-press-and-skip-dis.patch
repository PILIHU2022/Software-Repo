+// TestFileClipboardPasteBusy: while a paste, move or copy is under way the
+// browser takes no further file key, so an auto-repeated Cmd-V cannot start
+// a second operation beside the first.
+func TestFileClipboardPasteBusy(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	chooseFiles(t, a, "/", "README.md")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyC)
+	tt.Advance(100 * time.Millisecond)
+	a.router.Push(filesRoute("/代码"))
+	waitFor(t, tt, "main.go")
+
+	a.dlg.busy = true // the first paste is still working
+	tt.Key(ui.Cmd, ui.KeyV)
+	tt.Advance(300 * time.Millisecond)
+	if srv.Exists("/代码/README.md") {
+		t.Error("a second paste started while one was under way")
+	}
+	if a.dlg.open {
+		t.Errorf("a dialog opened while busy: %+v", a.dlg)
+	}
+	a.dlg.busy = false
+}
+
+// TestFileClipboardCancelKeeps: cancelling the question a same-name copy
+// raises leaves the copy in the clipboard, to paste elsewhere or again.
+func TestFileClipboardCancelKeeps(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	srv.Add(fakepan.Node{Path: "/代码/README.md", Data: []byte("旧的")})
+	chooseFiles(t, a, "/", "README.md")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyC)
+	tt.Advance(100 * time.Millisecond)
+	a.router.Push(filesRoute("/代码"))
+	waitFor(t, tt, "main.go")
+	tt.Key(ui.Cmd, ui.KeyV)
+	waitUntil(t, tt, "the question", func() bool { return a.dlg.open && a.dlg.kind == dlgConflict })
+	if err := tt.Click("取消"); err != nil {
+		t.Fatal(err)
+	}
+	settle(tt)
+	if a.dlg.open {
+		t.Error("the dialog stayed open")
+	}
+	if len(a.fileClip.files) != 1 || a.fileClip.cut {
+		t.Errorf("cancelling lost the copy: %+v", a.fileClip)
+	}
+	if srv.Exists("/代码/README (1).md") {
+		t.Error("cancelling still copied")
+	}
+}
+
+// TestFileClipboardSignOutClears: another account must not inherit the
+// paths of the first account's clipboard.
+func TestFileClipboardSignOutClears(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	chooseFiles(t, a, "/", "README.md")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyX)
+	tt.Advance(100 * time.Millisecond)
+	tt.SetClipboard("链接: https://pan.baidu.com/s/1demo?pwd=abcd 提取码: abcd")
+	a.signOut()
+	tt.Advance(300 * time.Millisecond)
+	if len(a.fileClip.files) != 0 || a.fileClip.cut || a.fileClip.cutSet != nil {
+		t.Errorf("signing out kept the clipboard: %+v", a.fileClip)
+	}
+}
+
+// TestFileClipboardRepeatIgnored: an auto-repeated Cmd-V does not fall
+// back to the system clipboard's share link, as a cut that just cleared
+// the file clipboard would otherwise do on the next repeat.
+func TestFileClipboardRepeatIgnored(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	tt.SetClipboard("链接: https://pan.baidu.com/s/1demo?pwd=abcd 提取码: abcd")
+	tt.KeyRepeat(ui.Cmd, ui.KeyV)
+	tt.Advance(300 * time.Millisecond)
+	if a.dlg.open {
+		t.Errorf("a repeated Cmd-V opened the share link: %+v", a.dlg)
+	}
+}
