+            // Absent = the legacy "everything in scope" meaning; a present array
+            // (even an empty one) is the user's explicit choice.
+            val encryptedFolders = obj["encryptedFolders"]?.jsonArray
+                ?.mapNotNull { it.jsonPrimitive.contentOrNullSafe() }
+                ?.toSet()
+            val encryptedAlbums = obj["encryptedAlbums"]?.jsonArray
+                ?.mapNotNull { it.jsonPrimitive.contentOrNullSafe()?.toLongOrNull() }
+                ?.toSet()
             AppSettings(
                 dest = obj["dest"]?.jsonPrimitive?.contentOrNullSafe() ?: AppSettings.DEFAULT_DEST,
                 autoFolder = obj["autoFolder"]?.jsonPrimitive?.contentOrNullSafe()?.toBooleanStrictOrNull() ?: false,
@@ -166,6 +233,8 @@ internal object SecureJson {
                 launcherIcon = obj["launcherIcon"]?.jsonPrimitive?.contentOrNullSafe()
                     ?.let { name -> LauncherIcon.entries.firstOrNull { it.name == name } }
                     ?: LauncherIcon.Classic,
+                encryptedFolders = encryptedFolders,
+                encryptedAlbums = encryptedAlbums,
             )
         }.getOrElse { AppSettings() }
     }
