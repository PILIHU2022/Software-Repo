     val ignoredVersionCode: Int = 0,
     /** Which launcher icon (activity-alias) the user picked; see [LauncherIcons]. */
     val launcherIcon: LauncherIcon = LauncherIcon.Classic,
+    /**
+     * Which configured SAF trees the backup encrypts, by tree URI. `null` is
+     * the default, and the meaning of settings written before per-item scopes
+     * existed: every configured tree is encrypted, including one added later.
+     * An empty set means nothing is encrypted; any other set means exactly the
+     * trees it lists. Only consulted while [folderEncrypt] is on.
+     */
+    val encryptedFolders: Set<String>? = null,
+    /**
+     * Which backed-up albums the backup encrypts, by MediaStore bucket id.
+     * `null` (the default, and the legacy meaning) is every album that is not
+     * in [deselectedAlbums]; an empty set is none. Only consulted while
+     * [albumEncrypt] is on.
+     */
+    val encryptedAlbums: Set<Long>? = null,
 ) {
     companion object {
         const val DEFAULT_DEST = "/备份"
     }
 }
 
+/**
+ * Whether the SAF tree at [uri] is encrypted by this configuration: encryption
+ * must be switched on, and [uri] must be in scope (an
+ * [AppSettings.encryptedFolders] of `null` means every tree).
+ */
+fun AppSettings.encryptsFolder(uri: String): Boolean =
+    folderEncrypt && (encryptedFolders?.contains(uri) ?: true)
+
+/**
+ * Whether the album with [bucketId] is encrypted by this configuration:
+ * encryption must be switched on, and the album must be in scope (an
+ * [AppSettings.encryptedAlbums] of `null` means every selected album). An album
+ * in [AppSettings.deselectedAlbums] is not backed up, so its bit does not matter.
+ */
+fun AppSettings.encryptsAlbum(bucketId: Long): Boolean =
+    albumEncrypt && (encryptedAlbums?.contains(bucketId) ?: true)
+
+/**
+ * Whether at least one configured tree would actually be encrypted, i.e.
+ * whether a folder run needs the passphrase, recipient keys or signer at all.
+ * False when [AppSettings.folderEncrypt] is off, when the scope is empty, and
+ * when there is no configured tree to encrypt.
+ */
+fun AppSettings.anyFolderEncrypted(): Boolean =
+    folderEncrypt && folders.any { encryptedFolders?.contains(it.uri) ?: true }
+
+/**
+ * Whether any of [selectedBucketIds] (the albums that will actually be backed
+ * up) is in the encryption scope. Unlike folders, [AppSettings] no longer keeps
+ * the selected albums (it stores the deselected ones), so the caller passes the
+ * live selection; the album run and the UI both know it.
+ */
+fun AppSettings.anyAlbumEncrypted(selectedBucketIds: Collection<Long>): Boolean =
+    albumEncrypt && selectedBucketIds.any { encryptedAlbums?.contains(it) ?: true }
+
 /** Encodes settings / credentials / passphrase documents without a codegen plugin. */
