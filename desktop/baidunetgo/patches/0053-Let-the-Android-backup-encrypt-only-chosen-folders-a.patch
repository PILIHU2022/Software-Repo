diff --git a/android/app/src/test/java/com/pengstem/baidunetgo/data/EncryptedScopeTest.kt b/android/app/src/test/java/com/pengstem/baidunetgo/data/EncryptedScopeTest.kt
new file mode 100644
index 0000000..2894803
--- /dev/null
+++ b/android/app/src/test/java/com/pengstem/baidunetgo/data/EncryptedScopeTest.kt
@@ -0,0 +1,124 @@
+package com.pengstem.baidunetgo.data
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * JVM tests for the per-item encrypted-backup scope: the persisted
+ * `encryptedFolders`/`encryptedAlbums` arrays and the helpers the backup runner
+ * and the UI use to ask what a run encrypts. They need no Android APIs.
+ */
+class EncryptedScopeTest {
+
+    private val treeA = FolderEntry(uri = "content://tree/a", name = "相机")
+    private val treeB = FolderEntry(uri = "content://tree/b", name = "文档")
+
+    @Test
+    fun defaultNullScopeIsNotWrittenAndRoundTrips() {
+        val settings = AppSettings(
+            folderEncrypt = true,
+            albumEncrypt = true,
+            folders = listOf(treeA),
+            deselectedAlbums = setOf(6L),
+        )
+        val encoded = SecureJson.encodeSettings(settings)
+        // An absent key is the "everything" default, so nothing is written.
+        assertFalse(encoded.contains("encryptedFolders"))
+        assertFalse(encoded.contains("encryptedAlbums"))
+        val decoded = SecureJson.decodeSettings(encoded)
+        assertEquals(settings, decoded)
+        assertNull(decoded.encryptedFolders)
+        assertNull(decoded.encryptedAlbums)
+    }
+
+    @Test
+    fun explicitSubsetRoundTrips() {
+        val settings = AppSettings(
+            folderEncrypt = true,
+            albumEncrypt = true,
+            folders = listOf(treeB, treeA),
+            deselectedAlbums = setOf(6L),
+            encryptedFolders = setOf(treeA.uri),
+            encryptedAlbums = setOf(2L, 1L),
+        )
+        val decoded = SecureJson.decodeSettings(SecureJson.encodeSettings(settings))
+        assertEquals(settings, decoded)
+        assertEquals(setOf(treeA.uri), decoded.encryptedFolders)
+        assertEquals(setOf(1L, 2L), decoded.encryptedAlbums)
+    }
+
+    @Test
+    fun explicitEmptyScopeRoundTrips() {
+        val settings = AppSettings(
+            folderEncrypt = true,
+            albumEncrypt = true,
+            folders = listOf(treeA),
+            encryptedFolders = emptySet(),
+            encryptedAlbums = emptySet(),
+        )
+        val decoded = SecureJson.decodeSettings(SecureJson.encodeSettings(settings))
+        assertEquals(emptySet<String>(), decoded.encryptedFolders)
+        assertEquals(emptySet<Long>(), decoded.encryptedAlbums)
+    }
+
+    @Test
+    fun legacyJsonWithoutScopeKeysDecodesToNull() {
+        val legacy = """{"version":1,"dest":"/备份","deselectedAlbums":[3]}"""
+        val decoded = SecureJson.decodeSettings(legacy)
+        assertNull(decoded.encryptedFolders)
+        assertNull(decoded.encryptedAlbums)
+    }
+
+    @Test
+    fun folderScopeHelpersTruthTable() {
+        val off = AppSettings(folderEncrypt = false, folders = listOf(treeA, treeB), encryptedFolders = emptySet())
+        assertFalse(off.anyFolderEncrypted())
+        assertFalse(off.encryptsFolder(treeA.uri))
+
+        val all = AppSettings(folderEncrypt = true, folders = listOf(treeA, treeB))
+        assertTrue(all.anyFolderEncrypted())
+        assertTrue(all.encryptsFolder(treeA.uri))
+        assertTrue(all.encryptsFolder(treeB.uri))
+
+        val subset = AppSettings(
+            folderEncrypt = true,
+            folders = listOf(treeA, treeB),
+            encryptedFolders = setOf(treeA.uri),
+        )
+        assertTrue(subset.anyFolderEncrypted())
+        assertTrue(subset.encryptsFolder(treeA.uri))
+        assertFalse(subset.encryptsFolder(treeB.uri))
+
+        val none = AppSettings(folderEncrypt = true, folders = listOf(treeA), encryptedFolders = emptySet())
+        assertFalse(none.anyFolderEncrypted())
+        assertFalse(none.encryptsFolder(treeA.uri))
+
+        val noTrees = AppSettings(folderEncrypt = true, folders = emptyList())
+        assertFalse(noTrees.anyFolderEncrypted())
+    }
+
+    @Test
+    fun albumScopeHelpersTruthTable() {
+        val off = AppSettings(albumEncrypt = false, encryptedAlbums = setOf(1L))
+        assertFalse(off.anyAlbumEncrypted(listOf(1L, 2L)))
+        assertFalse(off.encryptsAlbum(1L))
+
+        val all = AppSettings(albumEncrypt = true)
+        assertTrue(all.anyAlbumEncrypted(listOf(1L, 2L)))
+        assertTrue(all.encryptsAlbum(1L))
+        assertTrue(all.encryptsAlbum(99L))
+
+        val subset = AppSettings(albumEncrypt = true, encryptedAlbums = setOf(2L))
+        assertTrue(subset.anyAlbumEncrypted(listOf(1L, 2L)))
+        assertFalse(subset.anyAlbumEncrypted(listOf(1L, 3L)))
+        assertTrue(subset.encryptsAlbum(2L))
+        assertFalse(subset.encryptsAlbum(1L))
+
+        val none = AppSettings(albumEncrypt = true, encryptedAlbums = emptySet())
+        assertFalse(none.anyAlbumEncrypted(listOf(1L)))
+        assertFalse(none.encryptsAlbum(1L))
+    }
+}
