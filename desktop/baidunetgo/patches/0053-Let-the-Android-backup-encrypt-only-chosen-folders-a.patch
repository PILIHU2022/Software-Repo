+        // The per-item scopes are written only when the user narrowed them: an
+        // absent key decodes to null, the "everything in scope" default, which
+        // is also what settings from before this feature mean.
+        settings.encryptedFolders?.let { scope ->
+            putJsonArray("encryptedFolders") { scope.sorted().forEach { add(it) } }
+        }
+        settings.encryptedAlbums?.let { scope ->
+            putJsonArray("encryptedAlbums") { scope.sorted().forEach { add(it) } }
+        }
     }.toString()
 
