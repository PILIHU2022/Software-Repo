+    val labelStyle = MaterialTheme.typography.bodyMedium
+    val labelColor = MaterialTheme.colorScheme.onSurfaceVariant
+    BoxWithConstraints(modifier.fillMaxWidth()) {
+        // A value too long for the space beside its label moves to its own
+        // line as a whole; it is never truncated.
+        if (
+            rememberLabelValueFitsInline(
+                label,
+                labelStyle,
+                value,
+                labelStyle,
+                maxWidth,
+                maxValueFraction = LabeledValueInlineMaxFraction,
+            )
+        ) {
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                Text(
+                    text = label,
+                    style = labelStyle,
+                    color = labelColor,
+                    modifier = Modifier.weight(1f),
+                )
+                Spacer(Modifier.width(LabelValueGap))
+                Text(text = value, style = labelStyle, color = valueColor)
+            }
+        } else {
+            Column {
+                Text(text = label, style = labelStyle, color = labelColor)
+                Spacer(Modifier.height(2.dp))
+                Text(
+                    text = value,
+                    style = labelStyle,
+                    color = valueColor,
+                    modifier = Modifier.fillMaxWidth(),
+                )
+            }
+        }
     }
 }
 
