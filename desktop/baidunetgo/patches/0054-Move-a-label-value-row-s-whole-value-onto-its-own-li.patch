+/** Gap between a row's label or title and its value. */
+private val LabelValueGap = 16.dp
+
+/**
+ * Room the inline layout must leave beside a value beyond its measured width,
+ * so a value that only just fits is stacked rather than left with its last
+ * characters clipped by a rounding difference between measurement and layout.
+ */
+private val LabelValueSlack = 4.dp
+
+/**
+ * How much of a row's content width a value may take and still stay on the
+ * label's line. A value wider than this is "long": it moves to its own line as
+ * a whole, so it never squeezes the title and description into a narrow column
+ * (a long signer id, say, used to wrap its one-line description over three
+ * very short lines). Short settings values — 已设置, 1 小时, 已选 2 / 3 个 —
+ * stay inline as before.
+ */
+private const val LabelValueInlineMaxFraction = 0.5f
+
+/** A little more room for a bare [LabeledValue], which has no description beside it. */
+private const val LabeledValueInlineMaxFraction = 0.6f
+
+/**
+ * Whether [value] still fits on the same line as [label] inside [availableWidth].
+ *
+ * Both strings are measured at their intrinsic single-line width, so this only
+ * asks whether the two texts naturally fit side by side: it never decides to
+ * truncate. Callers stack the whole value on its own line when it returns
+ * `false`, which keeps a long value readable instead of squeezing it. The value
+ * must also take no more than [maxValueFraction] of the line, so a release-long
+ * value is stacked even when it would technically fit beside a short title.
+ */
+@Composable
+private fun rememberLabelValueFitsInline(
+    label: String,
+    labelStyle: TextStyle,
+    value: String,
+    valueStyle: TextStyle,
+    availableWidth: Dp,
+    maxValueFraction: Float = 1f,
+): Boolean {
+    val textMeasurer = rememberTextMeasurer()
+    val density = LocalDensity.current
+    return remember(
+        textMeasurer,
+        label,
+        labelStyle,
+        value,
+        valueStyle,
+        availableWidth,
+        maxValueFraction,
+        density,
+    ) {
+        // Measure as a single line so the natural width is compared, not the
+        // width after wrapping.
+        val labelWidth = with(density) {
+            textMeasurer.measure(
+                text = label,
+                style = labelStyle,
+                softWrap = false,
+                maxLines = 1,
+            ).size.width.toDp()
+        }
+        val valueWidth = with(density) {
+            textMeasurer.measure(
+                text = value,
+                style = valueStyle,
+                softWrap = false,
+                maxLines = 1,
+            ).size.width.toDp()
+        }
+        labelWidth + LabelValueGap + valueWidth + LabelValueSlack <= availableWidth &&
+            valueWidth <= availableWidth * maxValueFraction
+    }
+}
