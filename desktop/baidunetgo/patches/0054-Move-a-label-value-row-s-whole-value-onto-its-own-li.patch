-                )
-            }
-        },
-        headlineContent = { Text(title) },
-        supportingContent = description?.let { text -> { Text(text) } },
-        trailingContent = trailing ?: value?.let { text ->
-            {
-                Text(
-                    text = text,
-                    style = MaterialTheme.typography.bodyMedium,
-                    color = if (enabled) {
-                        MaterialTheme.colorScheme.primary
-                    } else {
-                        MaterialTheme.colorScheme.onSurfaceVariant
-                    },
-                    textAlign = androidx.compose.ui.text.style.TextAlign.End,
+    if (trailing != null || value == null) {
+        ListItem(
+            modifier = if (onClick != null && enabled) {
+                Modifier.clickable(onClick = onClick)
+            } else {
+                Modifier
+            },
+            colors = rowColors(),
+            leadingContent = leading?.let { icon ->
+                {
+                    Icon(
+                        imageVector = icon,
+                        contentDescription = null,
+                        tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                }
+            },
+            headlineContent = { Text(title) },
+            supportingContent = description?.let { text -> { Text(text) } },
+            trailingContent = trailing,
+        )
+        return
+    }
+
+    // A value that does not fit beside the title would be squeezed or cut by a
+    // ListItem, so this custom row measures both texts and moves the whole
+    // value onto its own line instead. Its 56/72 dp heights and 16 x 8 dp
+    // insets match the ListItem it replaces.
+    val valueColor = if (enabled) {
+        MaterialTheme.colorScheme.primary
+    } else {
+        MaterialTheme.colorScheme.onSurfaceVariant
+    }
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .then(
+                if (onClick != null && enabled) {
+                    Modifier.clickable(onClick = onClick)
+                } else {
+                    Modifier
+                },
+            )
+            .heightIn(min = if (description != null) 72.dp else 56.dp)
+            .padding(horizontal = 16.dp, vertical = 8.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        leading?.let { icon ->
+            Icon(
+                imageVector = icon,
+                contentDescription = null,
+                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.size(24.dp),
+            )
+            Spacer(Modifier.width(LabelValueGap))
+        }
+        BoxWithConstraints(Modifier.weight(1f)) {
+            val titleStyle = MaterialTheme.typography.bodyLarge
+            val valueStyle = MaterialTheme.typography.bodyMedium
+            if (
+                rememberLabelValueFitsInline(
+                    title,
+                    titleStyle,
+                    value,
+                    valueStyle,
+                    maxWidth,
+                    maxValueFraction = LabelValueInlineMaxFraction,
                 )
+            ) {
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Column(Modifier.weight(1f)) {
+                        Text(text = title, style = titleStyle)
+                        description?.let { text ->
+                            Text(
+                                text = text,
+                                style = valueStyle,
+                                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            )
+                        }
+                    }
+                    Spacer(Modifier.width(LabelValueGap))
+                    Text(
+                        text = value,
+                        style = valueStyle,
+                        color = valueColor,
+                        textAlign = TextAlign.End,
+                    )
+                }
+            } else {
+                Column(Modifier.fillMaxWidth()) {
+                    Text(text = title, style = titleStyle)
+                    description?.let { text ->
+                        Text(
+                            text = text,
+                            style = valueStyle,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                    }
+                    Spacer(Modifier.height(LabelValueSlack))
+                    Text(
+                        text = value,
+                        style = valueStyle,
+                        color = valueColor,
+                        modifier = Modifier.fillMaxWidth(),
+                    )
+                }
             }
-        },
