diff --git a/app/fileclip.go b/app/fileclip.go
new file mode 100644
index 0000000..3949174
--- /dev/null
+++ b/app/fileclip.go
@@ -0,0 +1,126 @@
+package app
+
+import (
+	"path"
+	"strings"
+
+	"github.com/pengstem/baidunetgo/internal/baidu"
+)
+
+// fileClipboard is the files cut or copied in the browser, waiting to be
+// pasted into another folder. It lives in memory: a netdisk path means
+// nothing to another application, so the system clipboard is not used.
+// from is the folder the files were taken from, and cut tells whether a
+// paste moves them there rather than copying them. cutSet holds the paths
+// of a cut, so that a row tells in constant time whether it is to move.
+// gen says which putting this is: a paste it started clears the clipboard
+// only while it is still the one the user put there, not one cut
+// meanwhile.
+type fileClipboard struct {
+	files  []baidu.File
+	from   string
+	cut    bool
+	cutSet map[string]bool
+	gen    uint64
+}
+
+// putFiles puts files taken from dir in the file clipboard, cut when they
+// are to be moved. It says so, as the paste may be in a folder far away.
+func (a *App) putFiles(dir string, files []baidu.File, cut bool) {
+	if len(files) == 0 {
+		return
+	}
+	var cutSet map[string]bool
+	if cut {
+		cutSet = make(map[string]bool, len(files))
+		for _, f := range files {
+			cutSet[f.Path] = true
+		}
+	}
+	a.fileClipGen++
+	a.fileClip = fileClipboard{
+		files: append([]baidu.File(nil), files...), from: path.Clean(dir), cut: cut, cutSet: cutSet, gen: a.fileClipGen,
+	}
+	verb := "已复制"
+	if cut {
+		verb = "已剪切"
+	}
+	a.toast(verb+" "+itoa(len(files))+" 项，可在其他文件夹粘贴", "success")
+}
+
+// clipLabel says what the file clipboard holds, as the status bar shows
+// it.
+func (a *App) clipLabel() string {
+	verb := "已复制"
+	if a.fileClip.cut {
+		verb = "已剪切"
+	}
+	return verb + " " + itoa(len(a.fileClip.files)) + " 项，可在其他文件夹粘贴"
+}
+
+// copyPaths puts the netdisk paths of files on the system clipboard, one a
+// line when there are several.
+func (a *App) copyPaths(files []baidu.File) {
+	if len(files) == 0 {
+		return
+	}
+	a.copy(strings.Join(paths(files), "\n"), "已复制路径")
+}
+
+// isCut reports whether f is one of the files cut in the file clipboard,
+// which show a chip saying they are to move: a path lookup, as a folder
+// may hold thousands of rows and thousands of files may be cut.
+func (a *App) isCut(f *baidu.File) bool {
+	return a.fileClip.cut && a.fileClip.cutSet[f.Path]
+}
+
+// selectAllFiles chooses every file of a listing, in the list and in the
+// grid, but the temporary rows: an upload still gathering and the folder
+// being named have no fs_id to act on.
+func (a *App) selectAllFiles(l *listing) {
+	l.sel.Clear()
+	for _, f := range l.files {
+		if f.FsID >= 0 {
+			l.sel.Add(f.FsID)
+		}
+	}
+}
+
+// pasteFiles pastes the file clipboard into the folder showing. A cut is a
+// move and a copy a copy, both through place so that names the folder has
+// already get the same question as a move from the picker: skip, replace
+// or keep both. A folder cannot go into itself or under itself, and cut
+// files cannot be pasted where they already are. The clipboard is cleared
+// only once a cut went through, and only while it is still the clip that
+// was pasted, so a paste that failed, was skipped or was cancelled can be
+// tried again; a copy stays for as many pastes as wanted.
+func (a *App) pasteFiles(l *listing) {
+	fc := &a.fileClip
+	if len(fc.files) == 0 {
+		return
+	}
+	to := path.Clean(l.dir)
+	for _, f := range fc.files {
+		p := path.Clean(f.Path)
+		if f.IsDir && (to == p || strings.HasPrefix(to, p+"/")) {
+			a.toast("不能把「"+f.Name+"」放进它自己里面", "error")
+			return
+		}
+	}
+	if fc.cut && path.Clean(fc.from) == to {
+		a.toast("文件已在当前文件夹", "")
+		return
+	}
+	kind, files, from := dlgCopy, fc.files, fc.from
+	if fc.cut {
+		kind = dlgMove
+	}
+	// A cut clears the clipboard once its move went through, but only if
+	// the user has not cut or copied something else meanwhile.
+	gen := fc.gen
+	a.moveOrCopyAfter(kind, files, from, to, func() {
+		if a.fileClip.gen == gen && a.fileClip.cut {
+			a.fileClip = fileClipboard{}
+		}
+	})
+}
