+// TestFileClipboardShareKey: Cmd-Shift-V opens a share link in the system
+// clipboard even while files are cut or copied, which Cmd-V would paste
+// instead.
+func TestFileClipboardShareKey(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	chooseFiles(t, a, "/", "README.md")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyC)
+	tt.Advance(100 * time.Millisecond)
+	tt.SetClipboard("链接: https://pan.baidu.com/s/1demo?pwd=abcd 提取码: abcd")
+	tt.Key(ui.Cmd|ui.Shift, ui.KeyV)
+	waitFor(t, tt, "旅行的猫 的分享")
+	if len(a.fileClip.files) != 1 {
+		t.Errorf("Cmd-Shift-V touched the file clipboard: %+v", a.fileClip)
+	}
+}
