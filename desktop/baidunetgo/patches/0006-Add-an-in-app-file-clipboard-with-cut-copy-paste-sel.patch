+// TestFileClipboardStaleCut: a cut starting while an older cut is still
+// moving keeps its place; the older paste must not clear it when it ends.
+func TestFileClipboardStaleCut(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	srv.Add(fakepan.Node{Path: "/代码/README.md", Data: []byte("旧的")})
+	chooseFiles(t, a, "/", "README.md")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyX)
+	tt.Advance(100 * time.Millisecond)
+	older := a.fileClip.gen
+	a.router.Push(filesRoute("/代码"))
+	waitFor(t, tt, "main.go")
+	tt.Key(ui.Cmd, ui.KeyV)
+	waitUntil(t, tt, "the question", func() bool { return a.dlg.open && a.dlg.kind == dlgConflict })
+	// Another cut lands while the first paste waits to be answered.
+	a.putFiles("/", []baidu.File{fileNamed(t, a, "/", "安装包.dmg")}, true)
+	if err := tt.Click("保留两者"); err != nil {
+		t.Fatal(err)
+	}
+	waitUntil(t, tt, "the first move", func() bool {
+		return srv.Exists("/代码/README (1).md") && !srv.Exists("/README.md")
+	})
+	settle(tt)
+	if a.fileClip.gen == older || len(a.fileClip.files) != 1 || a.fileClip.files[0].Name != "安装包.dmg" {
+		t.Errorf("the older paste cleared the newer clip: %+v", a.fileClip)
+	}
+}
