+package app
+
+import (
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+
+	"github.com/pengstem/baidunetgo/internal/baidu"
+	"github.com/pengstem/baidunetgo/internal/fakepan"
+)
+
+// chooseFiles adds the named files of dir to its selection.
+func chooseFiles(t *testing.T, a *App, dir string, names ...string) []baidu.File {
+	t.Helper()
+	l := a.listings[dir]
+	if l == nil {
+		t.Fatalf("no listing of %q", dir)
+	}
+	var out []baidu.File
+	for _, n := range names {
+		f := fileNamed(t, a, dir, n)
+		l.sel.Add(f.FsID)
+		out = append(out, f)
+	}
+	return out
+}
+
+// realFiles counts a listing's files that a shortcut may act on: the
+// temporary rows of uploads and the folder being named have no fs_id.
+func realFiles(l *listing) int {
+	n := 0
+	for _, f := range l.files {
+		if f.FsID >= 0 {
+			n++
+		}
+	}
+	return n
+}
+
+func menuHas(tt *ui.Tester, label string) bool { return slices.Contains(tt.Menu(), label) }
+
+// TestFileClipboardCopyPaste copies files, goes elsewhere and pastes them
+// there: the copies arrive, the originals stay, and the clipboard keeps
+// them for another paste. Cmd-V pastes the file clipboard rather than
+// opening the share link the system clipboard may also hold.
+func TestFileClipboardCopyPaste(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	files := chooseFiles(t, a, "/", "README.md", "安装包.dmg")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyC)
+	tt.Advance(100 * time.Millisecond)
+	if a.fileClip.cut || len(a.fileClip.files) != 2 || a.fileClip.from != "/" {
+		t.Fatalf("clipboard %+v", a.fileClip)
+	}
+	if !tt.HasText("已复制 2 项，可在其他文件夹粘贴") {
+		t.Errorf("no copy toast or status; texts %q", tt.Texts())
+	}
+
+	a.router.Push(filesRoute("/代码"))
+	waitFor(t, tt, "main.go")
+	// A share link in the system clipboard must give way to the files.
+	tt.SetClipboard("链接: https://pan.baidu.com/s/1demo?pwd=abcd 提取码: abcd")
+	tt.Key(ui.Cmd, ui.KeyV)
+	waitUntil(t, tt, "the copies", func() bool {
+		return srv.Exists("/代码/README.md") && srv.Exists("/代码/安装包.dmg")
+	})
+	settle(tt)
+	if a.dlg.kind == dlgSaveLink || a.dlg.open {
+		t.Fatalf("Cmd-V opened the share link instead of pasting: %+v", a.dlg)
+	}
+	if !srv.Exists("/README.md") || !srv.Exists("/安装包.dmg") {
+		t.Error("copying moved the originals")
+	}
+	if a.fileClip.cut || len(a.fileClip.files) != len(files) {
+		t.Errorf("clipboard after copying %+v", a.fileClip)
+	}
+	if !tt.HasText("已复制 2 项，可在其他文件夹粘贴") {
+		t.Errorf("the status bar lost the copy: %q", tt.Texts())
+	}
+	// The row menu offers pasting while the file clipboard holds any, and
+	// cutting and copying always.
+	rightClickRow(t, tt, "README.md")
+	tt.Advance(100 * time.Millisecond)
+	for _, want := range []string{"剪切", "复制", "粘贴", "复制路径"} {
+		if !menuHas(tt, want) {
+			t.Errorf("menu has no %q: %q", want, tt.Menu())
+		}
+	}
+	tt.CloseMenu()
+	tt.Advance(100 * time.Millisecond)
+}
+
+// TestFileClipboardCutPaste cuts files and pastes them elsewhere: they
+// leave the folder they came from, arrive in the other, and the clipboard
+// empties so that a second paste does nothing.
+func TestFileClipboardCutPaste(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	chooseFiles(t, a, "/", "安装包.dmg")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyX)
+	tt.Advance(100 * time.Millisecond)
+	if !a.fileClip.cut || len(a.fileClip.files) != 1 {
+		t.Fatalf("clipboard %+v", a.fileClip)
+	}
+	if !tt.HasText("已剪切 1 项，可在其他文件夹粘贴") {
+		t.Errorf("no cut toast or status; texts %q", tt.Texts())
+	}
+	// The file to move says so beside its name.
+	if !tt.HasText("待移动") {
+		t.Errorf("no chip on the cut file: %q", tt.Texts())
+	}
+
+	a.router.Push(filesRoute("/代码"))
+	waitFor(t, tt, "main.go")
+	tt.Key(ui.Cmd, ui.KeyV)
+	waitUntil(t, tt, "the move", func() bool {
+		return !srv.Exists("/安装包.dmg") && srv.Exists("/代码/安装包.dmg")
+	})
+	settle(tt)
+	if len(a.fileClip.files) != 0 || a.fileClip.cut {
+		t.Errorf("the clipboard did not empty after a cut: %+v", a.fileClip)
+	}
+	if tt.HasText("待移动") {
+		t.Errorf("the chip outlived the clip: %q", tt.Texts())
+	}
+	// A second Cmd-V has no files to paste and falls back to the system
+	// clipboard, which holds no link here.
+	tt.Key(ui.Cmd, ui.KeyV)
+	settle(tt)
+	if a.dlg.open {
+		t.Errorf("a second paste acted: %+v", a.dlg)
+	}
+}
+
+// TestFileClipboardSelectAll: Cmd-A chooses every file, in the list and in
+// the grid, and Escape lets them go.
+func TestFileClipboardSelectAll(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	l := a.listings["/"]
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyA)
+	tt.Advance(100 * time.Millisecond)
+	if want := realFiles(l); l.sel.Len() != want || want == 0 {
+		t.Fatalf("Cmd-A chose %d of %d files", l.sel.Len(), want)
+	}
+	for id := range l.sel.All() {
+		if id < 0 {
+			t.Errorf("Cmd-A chose the temporary row %d", id)
+		}
+	}
+	tt.Key(0, ui.KeyEscape)
+	tt.Advance(100 * time.Millisecond)
+	if l.sel.Len() != 0 {
+		t.Errorf("Escape kept %d chosen", l.sel.Len())
+	}
+
+	a.gridView = true
+	tt.Advance(200 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyA)
+	tt.Advance(100 * time.Millisecond)
+	if want := realFiles(l); l.sel.Len() != want {
+		t.Errorf("Cmd-A in the grid chose %d of %d files", l.sel.Len(), want)
+	}
+}
+
+// TestFileClipboardCopyPath: Cmd-Shift-C puts the netdisk paths on the
+// system clipboard, one a line for several files.
+func TestFileClipboardCopyPath(t *testing.T) {
+	a, tt, _ := signedIn(t)
+	chooseFiles(t, a, "/", "README.md", "安装包.dmg")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd|ui.Shift, ui.KeyC)
+	tt.Advance(100 * time.Millisecond)
+	got := tt.Clipboard()
+	lines := strings.Split(got, "\n")
+	if len(lines) != 2 || !slices.Contains(lines, "/README.md") || !slices.Contains(lines, "/安装包.dmg") {
+		t.Errorf("clipboard %q", got)
+	}
+	if !tt.HasText("已复制路径") {
+		t.Errorf("no toast: %q", tt.Texts())
+	}
+	if a.fileClip.files != nil {
+		t.Error("Cmd-Shift-C touched the file clipboard")
+	}
+}
+
+// TestFileClipboardCutInPlace: cutting and pasting in the folder the files
+// are already in moves nothing and says so, keeping the clipboard to paste
+// elsewhere.
+func TestFileClipboardCutInPlace(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	chooseFiles(t, a, "/", "README.md")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyX)
+	tt.Advance(100 * time.Millisecond)
+	// Even with a share link in the system clipboard, the file clipboard
+	// takes Cmd-V.
+	tt.SetClipboard("链接: https://pan.baidu.com/s/1demo?pwd=abcd 提取码: abcd")
+	tt.Key(ui.Cmd, ui.KeyV)
+	settle(tt)
+	if !tt.HasText("文件已在当前文件夹") {
+		t.Errorf("no word about the same folder: %q", tt.Texts())
+	}
+	if a.dlg.open || a.dlg.kind == dlgSaveLink {
+		t.Errorf("the paste did something: %+v", a.dlg)
+	}
+	if !srv.Exists("/README.md") || srv.Exists("/README (1).md") {
+		t.Error("the files moved or were copied beside themselves")
+	}
+	if !a.fileClip.cut || len(a.fileClip.files) != 1 {
+		t.Errorf("the clipboard did not keep the cut: %+v", a.fileClip)
+	}
+}
+
+// TestFileClipboardFolderIntoItself: a cut folder cannot be pasted into
+// itself or a folder under it, which would lose it.
+func TestFileClipboardFolderIntoItself(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	chooseFiles(t, a, "/", "代码")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyX)
+	tt.Advance(100 * time.Millisecond)
+	a.router.Push(filesRoute("/代码/备份"))
+	waitFor(t, tt, "读我（副本）.txt")
+	tt.Key(ui.Cmd, ui.KeyV)
+	settle(tt)
+	if !tt.HasText("不能把「代码」放进它自己里面") {
+		t.Errorf("no refusal: %q", tt.Texts())
+	}
+	if !srv.Exists("/代码/main.go") || srv.Exists("/代码/备份/代码") {
+		t.Error("the folder moved into its own subtree")
+	}
+	if !a.fileClip.cut || len(a.fileClip.files) != 1 {
+		t.Errorf("the clipboard did not keep the cut: %+v", a.fileClip)
+	}
+}
+
+// TestFileClipboardConflict: pasting onto a name the folder has asks the
+// same question a move from the picker does; keeping both gives the copy a
+// free name.
+func TestFileClipboardConflict(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	srv.Add(fakepan.Node{Path: "/代码/README.md", Data: []byte("旧的")})
+	chooseFiles(t, a, "/", "README.md")
+	tt.Advance(100 * time.Millisecond)
+	tt.Key(ui.Cmd, ui.KeyC)
+	tt.Advance(100 * time.Millisecond)
+	a.router.Push(filesRoute("/代码"))
+	waitFor(t, tt, "main.go")
+	tt.Key(ui.Cmd, ui.KeyV)
+	waitUntil(t, tt, "the question", func() bool { return a.dlg.open && a.dlg.kind == dlgConflict })
+	tt.Advance(200 * time.Millisecond)
+	if err := tt.Click("保留两者"); err != nil {
+		t.Fatal(err)
+	}
+	waitUntil(t, tt, "the copy beside its name", func() bool { return srv.Exists("/代码/README (1).md") })
+	settle(tt)
+	if a.dlg.open {
+		t.Errorf("the dialog stayed open: %q", a.dlg.err)
+	}
+	if string(srv.Data("/代码/README.md")) != "旧的" {
+		t.Error("keeping both changed the file there")
+	}
+	if a.fileClip.cut || len(a.fileClip.files) != 1 {
+		t.Errorf("the clipboard changed after a copy: %+v", a.fileClip)
+	}
+}
