+// TestShortcutRefreshAlias: F5 reads the folder again as Cmd-R does.
+func TestShortcutRefreshAlias(t *testing.T) {
+	a, tt, srv := signedIn(t)
+	srv.Add(fakepan.Node{Path: "/刷新出来的.txt", Data: []byte("hi")})
+	if tt.HasText("刷新出来的.txt") {
+		t.Fatal("the file showed before the refresh")
+	}
+	tt.Key(0, ui.KeyF5)
+	waitFor(t, tt, "刷新出来的.txt")
+	if a.listings["/"].loaded != true {
+		t.Error("the listing was not read")
+	}
+}
