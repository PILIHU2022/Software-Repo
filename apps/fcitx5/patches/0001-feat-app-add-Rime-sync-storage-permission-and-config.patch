+package org.fcitx.fcitx5.android.ui.files
+
+import android.Manifest
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.provider.Settings
+import androidx.appcompat.app.AlertDialog
+import androidx.core.app.ActivityCompat
+import org.fcitx.fcitx5.android.R
+
+/**
+ * Helpers for the "All files access" permission.
+ *
+ * Rime (librime) performs plain POSIX writes into the directory configured by
+ * `sync_dir` in `installation.yaml`.  When that directory lives in shared
+ * storage (for example `/sdcard/Download/Rime-Sync`) Android's scoped storage
+ * denies the write unless the app holds [Manifest.permission.MANAGE_EXTERNAL_STORAGE]
+ * (Android 11+) or the legacy write permission (Android 10 and below).
+ */
+object StoragePermission {
+
+    const val REQUEST_LEGACY_STORAGE = 0x5701
+
+    private const val PREFS = "storage_permission"
+    private const val KEY_PROMPTED = "prompted"
+
+    fun hasAccess(context: Context): Boolean = StorageAccess.hasAllFilesAccess(context)
+
+    fun wasPrompted(context: Context): Boolean =
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .getBoolean(KEY_PROMPTED, false)
+
+    fun markPrompted(context: Context) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit().putBoolean(KEY_PROMPTED, true).apply()
+    }
+
+    /**
+     * Open the system settings page where the user can grant "All files access".
+     * On Android 10 and below this requests the legacy storage permission instead.
+     */
+    fun request(activity: Activity) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            val appIntent = Intent(
+                Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION,
+                Uri.parse("package:${activity.packageName}")
+            )
+            try {
+                activity.startActivity(appIntent)
+                return
+            } catch (_: Exception) {
+                // Some ROMs only implement the global page.
+            }
+            try {
+                activity.startActivity(Intent(Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION))
+            } catch (e: Exception) {
+                activity.toastError(e)
+            }
+        } else {
+            ActivityCompat.requestPermissions(
+                activity,
+                arrayOf(Manifest.permission.WRITE_EXTERNAL_STORAGE),
+                REQUEST_LEGACY_STORAGE
+            )
+        }
+    }
+
+    /**
+     * Explain why shared-storage access is needed and offer to open the settings page.
+     *
+     * @param onDismiss called when the dialog is dismissed without granting.
+     */
+    fun showDialog(
+        activity: Activity,
+        onDismiss: (() -> Unit)? = null
+    ) {
+        markPrompted(activity)
+        AlertDialog.Builder(activity)
+            .setIconAttribute(android.R.attr.alertDialogIcon)
+            .setTitle(R.string.storage_permission_title)
+            .setMessage(R.string.storage_permission_message)
+            .setPositiveButton(R.string.storage_permission_grant) { _, _ ->
+                request(activity)
+            }
+            .setNegativeButton(R.string.storage_permission_later) { _, _ -> }
+            .setOnDismissListener {
+                onDismiss?.invoke()
+            }
+            .show()
+    }
+
+    /**
+     * Show a short toast describing the current state after returning from settings.
+     */
+    fun toastState(context: Context) {
+        val msg = if (hasAccess(context)) {
+            R.string.storage_permission_granted
+        } else {
+            R.string.storage_permission_not_granted
+        }
+        android.widget.Toast.makeText(context, msg, android.widget.Toast.LENGTH_SHORT).show()
+    }
+
+    private fun Activity.toastError(e: Exception) {
+        android.widget.Toast.makeText(
+            this, e.message ?: e.javaClass.simpleName, android.widget.Toast.LENGTH_LONG
+        ).show()
+    }
+}
