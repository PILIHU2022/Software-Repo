+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.ui.files
+
+import android.content.ActivityNotFoundException
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.content.Context
+import android.content.Intent
+import android.content.SharedPreferences
+import android.os.Build
+import android.os.Bundle
+import android.text.InputType
+import android.view.Menu
+import android.view.MenuItem
+import android.view.View
+import android.view.ViewGroup
+import android.view.WindowManager
+import android.widget.EditText
+import android.widget.Toast
+import androidx.activity.addCallback
+import androidx.activity.enableEdgeToEdge
+import androidx.appcompat.app.AlertDialog
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.content.ContextCompat
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.core.view.updateLayoutParams
+import androidx.core.view.updatePadding
+import androidx.recyclerview.widget.LinearLayoutManager
+import org.fcitx.fcitx5.android.R
+import org.fcitx.fcitx5.android.databinding.ActivityFileManagerBinding
+import java.io.File
+import java.io.IOException
+import java.util.Locale
+
+/**
+ * Minimal file browser used to edit Rime/Fcitx5 configuration files.
+ *
+ * The activity only browses inside one of two roots: the app-specific external
+ * files directory or shared storage (when "All files access" is granted).
+ */
+class FileManagerActivity : AppCompatActivity() {
+
+    private lateinit var binding: ActivityFileManagerBinding
+    private lateinit var adapter: FileListAdapter
+    private lateinit var preferences: SharedPreferences
+    private lateinit var appRoot: File
+    private lateinit var sharedRoot: File
+
+    private var rootType = RootType.APP
+    private var currentDir: File = File("/")
+    private var lastAppDir: File? = null
+    private var lastSharedDir: File? = null
+    private var showHidden = true
+
+    private val rootDir: File
+        get() = when (rootType) {
+            RootType.APP -> appRoot
+            RootType.SHARED -> sharedRoot
+        }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        enableEdgeToEdge()
+
+        binding = ActivityFileManagerBinding.inflate(layoutInflater)
+        // The toolbar has a fixed ?attr/actionBarSize height.  Adding the status
+        // bar inset as padding without growing the toolbar clips its title and
+        // navigation icon, so keep the original height and add the inset to it.
+        // minimumHeight is the resolved ?attr/actionBarSize; fall back to the
+        // layout height for safety.
+        val toolbarHeight = binding.toolbar.minimumHeight.takeIf { it > 0 }
+            ?: binding.toolbar.layoutParams.height
+        val recyclerBottomPadding = binding.recyclerView.paddingBottom
+        ViewCompat.setOnApplyWindowInsetsListener(binding.root) { _, windowInsets ->
+            val statusBars = windowInsets.getInsets(WindowInsetsCompat.Type.statusBars())
+            val navBars = windowInsets.getInsets(WindowInsetsCompat.Type.navigationBars())
+            val cutout = windowInsets.getInsets(WindowInsetsCompat.Type.displayCutout())
+            binding.root.updateLayoutParams<ViewGroup.MarginLayoutParams> {
+                leftMargin = maxOf(navBars.left, cutout.left)
+                rightMargin = maxOf(navBars.right, cutout.right)
+            }
+            binding.toolbar.updateLayoutParams {
+                height = toolbarHeight + statusBars.top
+            }
+            binding.toolbar.updatePadding(top = statusBars.top)
+            binding.recyclerView.updatePadding(bottom = recyclerBottomPadding + navBars.bottom)
+            binding.emptyView.updateLayoutParams<ViewGroup.MarginLayoutParams> {
+                bottomMargin = navBars.bottom
+            }
+            windowInsets
+        }
+        setContentView(binding.root)
+
+        setSupportActionBar(binding.toolbar)
+        supportActionBar?.apply {
+            setDisplayHomeAsUpEnabled(true)
+            setHomeAsUpIndicator(R.drawable.ic_arrow_up_24)
+        }
+        binding.toolbar.overflowIcon =
+            ContextCompat.getDrawable(this, R.drawable.ic_more_vert_24)
+
+        preferences = getSharedPreferences(PREFS_NAME, MODE_PRIVATE)
+        appRoot = StorageAccess.appFilesRoot(this)
+        sharedRoot = StorageAccess.sharedStorageRoot()
+
+        showHidden = savedInstanceState?.getBoolean(KEY_SHOW_HIDDEN, true) ?: true
+        restoreInitialState(savedInstanceState)
+        updateToolbar()
+
+        adapter = FileListAdapter(::onEntryClick, ::onEntryLongClick)
+        binding.recyclerView.layoutManager = LinearLayoutManager(this)
+        binding.recyclerView.adapter = adapter
+
+        onBackPressedDispatcher.addCallback(this) {
+            if (isAtRoot()) finish() else goUp()
+        }
+    }
+
+    override fun onResume() {
+        super.onResume()
+        // Also refreshes file sizes after returning from the editor and the
+        // "All files access" menu after returning from system settings.
+        invalidateOptionsMenu()
+        refresh()
+    }
+
+    override fun onPause() {
+        super.onPause()
+        saveLastPath()
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        super.onSaveInstanceState(outState)
+        outState.putString(KEY_CURRENT_PATH, currentDir.absolutePath)
+        outState.putString(KEY_ROOT, rootType.name)
+        outState.putBoolean(KEY_SHOW_HIDDEN, showHidden)
+    }
+
+    override fun onCreateOptionsMenu(menu: Menu): Boolean {
+        menu.add(Menu.NONE, MENU_NEW_FILE, 0, R.string.file_manager_new_file)
+            .setIcon(R.drawable.ic_note_add_24)
+            .setShowAsAction(MenuItem.SHOW_AS_ACTION_NEVER)
+        menu.add(Menu.NONE, MENU_NEW_FOLDER, 1, R.string.file_manager_new_folder)
+            .setIcon(R.drawable.ic_create_folder_24)
+            .setShowAsAction(MenuItem.SHOW_AS_ACTION_NEVER)
+        menu.add(Menu.NONE, MENU_REFRESH, 2, R.string.file_manager_refresh)
+            .setIcon(R.drawable.ic_refresh_24)
+            .setShowAsAction(MenuItem.SHOW_AS_ACTION_NEVER)
+        menu.add(Menu.NONE, MENU_SWITCH_ROOT, 3, R.string.file_manager_switch_root)
+            .setShowAsAction(MenuItem.SHOW_AS_ACTION_NEVER)
+        menu.add(Menu.NONE, MENU_TOGGLE_HIDDEN, 4, R.string.file_manager_show_hidden)
+            .setCheckable(true)
+            .setChecked(showHidden)
+            .setShowAsAction(MenuItem.SHOW_AS_ACTION_NEVER)
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R &&
+            !StorageAccess.hasAllFilesAccess(this)
+        ) {
+            menu.add(
+                Menu.NONE,
+                MENU_ALL_FILES_SETTINGS,
+                5,
+                R.string.file_manager_open_all_files_settings
+            ).setShowAsAction(MenuItem.SHOW_AS_ACTION_NEVER)
+        }
+        return true
+    }
+
+    override fun onOptionsItemSelected(item: MenuItem): Boolean {
+        return when (item.itemId) {
+            android.R.id.home -> {
+                if (isAtRoot()) finish() else goUp()
+                true
+            }
+
+            MENU_NEW_FILE -> {
+                showCreateEntryDialog(isDirectory = false)
+                true
+            }
+
+            MENU_NEW_FOLDER -> {
+                showCreateEntryDialog(isDirectory = true)
+                true
+            }
+
+            MENU_REFRESH -> {
+                refresh()
+                true
+            }
+
+            MENU_SWITCH_ROOT -> {
+                showSwitchRootDialog()
+                true
+            }
+
+            MENU_TOGGLE_HIDDEN -> {
+                showHidden = !showHidden
+                item.isChecked = showHidden
+                refresh()
+                true
+            }
+
+            MENU_ALL_FILES_SETTINGS -> {
+                openAllFilesSettings()
+                true
+            }
+
+            else -> super.onOptionsItemSelected(item)
+        }
+    }
+
+    private fun restoreInitialState(savedInstanceState: Bundle?) {
+        val restored = restoreFromState(savedInstanceState)
+        if (restored != null) {
+            applyInitialState(restored.first, restored.second)
+            return
+        }
+
+        val extraDir = intent.getStringExtra(EXTRA_START_PATH)?.let(::File)
+        if (extraDir != null && extraDir.isDirectory) {
+            val type = rootTypeFor(extraDir)
+            if (type != null) {
+                applyInitialState(type, extraDir)
+                return
+            }
+        }
+
+        val savedDir = preferences.getString(KEY_LAST_PATH, null)?.let(::File)
+        if (savedDir != null && savedDir.isDirectory && isInside(savedDir, appRoot)) {
+            applyInitialState(RootType.APP, savedDir)
+            return
+        }
+
+        applyInitialState(RootType.APP, StorageAccess.defaultStartDir(this))
+    }
+
+    private fun restoreFromState(savedInstanceState: Bundle?): Pair<RootType, File>? {
+        if (savedInstanceState == null) return null
+        val path = savedInstanceState.getString(KEY_CURRENT_PATH) ?: return null
+        val type = if (savedInstanceState.getString(KEY_ROOT) == RootType.SHARED.name) {
+            RootType.SHARED
+        } else {
+            RootType.APP
+        }
+        val dir = File(path)
+        val root = if (type == RootType.SHARED) sharedRoot else appRoot
+        if (!dir.isDirectory || !isInside(dir, root)) return null
+        if (type == RootType.SHARED && !StorageAccess.hasAllFilesAccess(this)) return null
+        return type to dir
+    }
+
+    private fun rootTypeFor(dir: File): RootType? {
+        return when {
+            isInside(dir, appRoot) -> RootType.APP
+            isInside(dir, sharedRoot) && StorageAccess.hasAllFilesAccess(this) -> RootType.SHARED
+            else -> null
+        }
+    }
+
+    private fun applyInitialState(type: RootType, dir: File) {
+        rootType = type
+        currentDir = dir
+        if (type == RootType.APP) {
+            lastAppDir = dir
+        } else {
+            lastSharedDir = dir
+        }
+    }
+
+    private fun refresh() {
+        val directory = currentDir
+        val entries: List<FileEntry> = if (!directory.isDirectory) {
+            toast(R.string.file_manager_error_list)
+            emptyList()
+        } else {
+            val files = try {
+                directory.listFiles()
+            } catch (_: SecurityException) {
+                null
+            }
+            if (files == null) {
+                toast(R.string.file_manager_error_list)
+                emptyList()
+            } else {
+                files.asSequence()
+                    .filter { showHidden || !it.name.startsWith(".") }
+                    .map { file ->
+                        FileEntry(
+                            name = file.name,
+                            file = file,
+                            isDirectory = file.isDirectory,
+                            size = if (file.isDirectory) 0L else file.length(),
+                            lastModified = file.lastModified()
+                        )
+                    }
+                    .sortedWith(
+                        compareBy<FileEntry> { if (it.isDirectory) 0 else 1 }
+                            .thenBy { it.name.lowercase(Locale.ROOT) }
+                    )
+                    .toList()
+            }
+        }
+
+        adapter.submitList(entries)
+        binding.emptyView.visibility = if (entries.isEmpty()) View.VISIBLE else View.GONE
+        updatePath()
+        updateToolbar()
+    }
+
+    private fun updatePath() {
+        binding.path.text = try {
+            val rootPath = rootDir.canonicalPath
+            val currentPath = currentDir.canonicalPath
+            when {
+                currentPath == rootPath -> "/"
+                currentPath.startsWith(rootPath + File.separator) ->
+                    currentPath.removePrefix(rootPath)
+                else -> currentDir.absolutePath
+            }
+        } catch (_: IOException) {
+            currentDir.absolutePath
+        }
+    }
+
+    private fun updateToolbar() {
+        supportActionBar?.title = getString(R.string.file_manager_title)
+        supportActionBar?.subtitle = getString(
+            if (rootType == RootType.APP) {
+                R.string.file_manager_root_app
+            } else {
+                R.string.file_manager_root_shared
+            }
+        )
+    }
+
+    private fun onEntryClick(entry: FileEntry) {
+        if (entry.isDirectory) {
+            enterDirectory(entry.file)
+            return
+        }
+        if (FileEntry.isTextual(entry.file)) {
+            try {
+                startActivity(
+                    Intent(this, FileEditorActivity::class.java)
+                        .putExtra(FileEditorActivity.EXTRA_PATH, entry.file.absolutePath)
+                )
+            } catch (_: ActivityNotFoundException) {
+                toast(R.string.file_manager_error_open_file)
+            }
+        } else {
+            showFileInfoDialog(entry)
+        }
+    }
+
+    private fun onEntryLongClick(entry: FileEntry) {
+        val actions = arrayOf(
+            getString(R.string.file_manager_rename),
+            getString(R.string.file_manager_delete),
+            getString(R.string.file_manager_copy_path)
+        )
+        AlertDialog.Builder(this)
+            .setTitle(entry.name)
+            .setItems(actions) { _, which ->
+                when (which) {
+                    0 -> showRenameDialog(entry)
+                    1 -> confirmDelete(entry)
+                    2 -> copyPath(entry)
+                }
+            }
+            .setNegativeButton(R.string.file_manager_cancel, null)
+            .show()
+    }
+
+    private fun enterDirectory(dir: File) {
+        if (!dir.isDirectory) {
+            toast(R.string.file_manager_error_list)
+            refresh()
+            return
+        }
+        if (!isInside(dir, rootDir)) {
+            toast(R.string.file_manager_error_outside_root)
+            return
+        }
+        setCurrentDir(dir)
+    }
+
+    private fun goUp() {
+        val parent = currentDir.parentFile
+        if (isAtRoot() || parent == null || !isInside(parent, rootDir)) {
+            finish()
+            return
+        }
+        setCurrentDir(parent)
+    }
+
+    private fun setCurrentDir(dir: File) {
+        currentDir = dir
+        if (rootType == RootType.APP) {
+            lastAppDir = dir
+            saveLastPath()
+        } else {
+            lastSharedDir = dir
+        }
+        refresh()
+        binding.recyclerView.scrollToPosition(0)
+    }
+
+    private fun isAtRoot(): Boolean = runCatching {
+        currentDir.canonicalPath == rootDir.canonicalPath
+    }.getOrDefault(currentDir == rootDir)
+
+    private fun isInside(file: File, root: File): Boolean = runCatching {
+        val path = file.canonicalPath
+        val rootPath = root.canonicalPath.trimEnd(File.separatorChar)
+        path == rootPath || path.startsWith(rootPath + File.separator)
+    }.getOrDefault(false)
+
+    private fun saveLastPath() {
+        if (rootType != RootType.APP) return
+        preferences.edit().putString(KEY_LAST_PATH, currentDir.absolutePath).apply()
+    }
+
+    private fun showSwitchRootDialog() {
+        val labels = arrayOf(
+            getString(R.string.file_manager_root_app),
+            getString(R.string.file_manager_root_shared)
+        )
+        AlertDialog.Builder(this)
+            .setTitle(R.string.file_manager_switch_root)
+            .setItems(labels) { _, which ->
+                when (which) {
+                    0 -> switchRoot(RootType.APP)
+                    1 -> if (StorageAccess.hasAllFilesAccess(this)) {
+                        switchRoot(RootType.SHARED)
+                    } else {
+                        showAllFilesPermissionDialog()
+                    }
+                }
+            }
+            .setNegativeButton(R.string.file_manager_cancel, null)
+            .show()
+    }
+
+    private fun switchRoot(type: RootType) {
+        if (type == rootType) return
+        rootType = type
+        currentDir = when (type) {
+            RootType.APP -> lastAppDir
+                ?.takeIf { it.isDirectory && isInside(it, appRoot) }
+                ?: StorageAccess.defaultStartDir(this)
+
+            RootType.SHARED -> lastSharedDir
+                ?.takeIf { it.isDirectory && isInside(it, sharedRoot) }
+                ?: sharedRoot
+        }
+        if (type == RootType.APP) {
+            lastAppDir = currentDir
+            saveLastPath()
+        } else {
+            lastSharedDir = currentDir
+        }
+        updateToolbar()
+        refresh()
+        invalidateOptionsMenu()
+    }
+
+    private fun showAllFilesPermissionDialog() {
+        val settingsIntent = StorageAccess.allFilesAccessIntent(this)
+        val builder = AlertDialog.Builder(this)
+            .setTitle(R.string.file_manager_permission_title)
+            .setMessage(R.string.file_manager_permission_message)
+        if (settingsIntent != null) {
+            builder.setPositiveButton(R.string.file_manager_permission_open_settings) { _, _ ->
+                launchSettings(settingsIntent)
+            }
+            builder.setNegativeButton(R.string.file_manager_cancel, null)
+        } else {
+            builder.setPositiveButton(R.string.file_manager_ok, null)
+        }
+        builder.show()
+    }
+
+    private fun openAllFilesSettings() {
+        val settingsIntent = StorageAccess.allFilesAccessIntent(this)
+        if (settingsIntent == null) {
+            toast(R.string.file_manager_permission_unavailable)
+            return
+        }
+        launchSettings(settingsIntent)
+    }
+
+    private fun launchSettings(intent: Intent) {
+        try {
+            startActivity(intent)
+        } catch (_: ActivityNotFoundException) {
+            toast(R.string.file_manager_permission_unavailable)
+        } catch (_: SecurityException) {
+            toast(R.string.file_manager_permission_unavailable)
+        }
+    }
+
+    private fun showCreateEntryDialog(isDirectory: Boolean) {
+        val titleRes = if (isDirectory) {
+            R.string.file_manager_new_folder
+        } else {
+            R.string.file_manager_new_file
+        }
+        val hintRes = if (isDirectory) {
+            R.string.file_manager_new_folder_hint
+        } else {
+            R.string.file_manager_new_file_hint
+        }
+        showNameDialog(
+            titleRes = titleRes,
+            initialValue = "",
+            hintRes = hintRes,
+            validate = { name ->
+                validateEntryName(name) ?: if (File(currentDir, name).exists()) {
+                    R.string.file_manager_error_name_exists
+                } else {
+                    null
+                }
+            },
+            onConfirm = { name -> createEntry(name, isDirectory) }
+        )
+    }
+
+    private fun createEntry(name: String, isDirectory: Boolean): Boolean {
+        val target = File(currentDir, name)
+        val created = try {
+            if (isDirectory) target.mkdirs() else target.createNewFile()
+        } catch (_: IOException) {
+            false
+        } catch (_: SecurityException) {
+            false
+        }
+        if (!created) {
+            toast(
+                if (isDirectory) {
+                    R.string.file_manager_error_create_folder
+                } else {
+                    R.string.file_manager_error_create_file
+                }
+            )
+            return false
+        }
+        refresh()
+        return true
+    }
+
+    private fun showRenameDialog(entry: FileEntry) {
+        showNameDialog(
+            titleRes = R.string.file_manager_rename,
+            initialValue = entry.name,
+            hintRes = R.string.file_manager_rename_hint,
+            validate = { name ->
+                if (name == entry.name) {
+                    null
+                } else {
+                    validateEntryName(name) ?: if (
+                        File(entry.file.parentFile ?: currentDir, name).exists()
+                    ) {
+                        R.string.file_manager_error_name_exists
+                    } else {
+                        null
+                    }
+                }
+            },
+            onConfirm = { name -> renameEntry(entry, name) }
+        )
+    }
+
+    private fun renameEntry(entry: FileEntry, newName: String): Boolean {
+        if (newName == entry.name) return true
+        val target = File(entry.file.parentFile ?: currentDir, newName)
+        val renamed = try {
+            entry.file.renameTo(target)
+        } catch (_: SecurityException) {
+            false
+        }
+        if (!renamed) {
+            toast(R.string.file_manager_error_rename)
+            return false
+        }
+        refresh()
+        return true
+    }
+
+    private fun confirmDelete(entry: FileEntry) {
+        AlertDialog.Builder(this)
+            .setTitle(R.string.file_manager_delete)
+            .setMessage(getString(R.string.file_manager_delete_confirm, entry.name))
+            .setPositiveButton(R.string.file_manager_delete) { _, _ -> deleteEntry(entry) }
+            .setNegativeButton(R.string.file_manager_cancel, null)
+            .show()
+    }
+
+    private fun deleteEntry(entry: FileEntry) {
+        val deleted = try {
+            if (entry.isDirectory) {
+                entry.file.deleteRecursively()
+            } else {
+                entry.file.delete()
+            }
+        } catch (_: Exception) {
+            false
+        }
+        if (deleted) {
+            refresh()
+        } else {
+            toast(R.string.file_manager_error_delete)
+        }
+    }
+
+    private fun copyPath(entry: FileEntry) {
+        val clipboard = getSystemService(Context.CLIPBOARD_SERVICE) as? ClipboardManager
+        if (clipboard == null) {
+            toast(R.string.file_manager_error_copy_path)
+            return
+        }
+        clipboard.setPrimaryClip(
+            ClipData.newPlainText(
+                getString(R.string.file_manager_copy_path),
+                entry.file.absolutePath
+            )
+        )
+        toast(R.string.file_manager_path_copied)
+    }
+
+    private fun showFileInfoDialog(entry: FileEntry) {
+        AlertDialog.Builder(this)
+            .setTitle(R.string.file_manager_file_info_title)
+            .setMessage(
+                getString(
+                    R.string.file_manager_file_info_message,
+                    entry.name,
+                    entry.file.absolutePath,
+                    entry.formattedSize,
+                    entry.formattedDate
+                )
+            )
+            .setPositiveButton(R.string.file_manager_ok, null)
+            .show()
+    }
+
+    private fun validateEntryName(name: String): Int? {
+        if (name.isEmpty()) return R.string.file_manager_error_empty_name
+        if (name == "." || name == "..") return R.string.file_manager_error_invalid_name
+        if (name.contains('/') || name.contains('\u0000')) {
+            return R.string.file_manager_error_invalid_name
+        }
+        return null
+    }
+
+    private fun showNameDialog(
+        titleRes: Int,
+        initialValue: String,
+        hintRes: Int,
+        validate: (String) -> Int?,
+        onConfirm: (String) -> Boolean
+    ) {
+        val input = EditText(this).apply {
+            hint = getString(hintRes)
+            inputType = InputType.TYPE_CLASS_TEXT
+            setText(initialValue)
+            if (initialValue.isEmpty()) {
+                setSelection(0)
+            } else {
+                setSelection(0, text.length)
+            }
+        }
+        val dialog = AlertDialog.Builder(this)
+            .setTitle(titleRes)
+            .setView(input)
+            .setPositiveButton(R.string.file_manager_ok, null)
+            .setNegativeButton(R.string.file_manager_cancel, null)
+            .create()
+        dialog.setOnShowListener {
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener {
+                val name = input.text.toString().trim()
+                val errorRes = validate(name)
+                if (errorRes != null) {
+                    input.error = getString(errorRes)
+                    return@setOnClickListener
+                }
+                if (onConfirm(name)) {
+                    dialog.dismiss()
+                }
+            }
+            input.requestFocus()
+            dialog.window?.setSoftInputMode(
+                WindowManager.LayoutParams.SOFT_INPUT_STATE_ALWAYS_VISIBLE
+            )
+        }
+        dialog.show()
+    }
+
+    private fun toast(messageRes: Int) {
+        Toast.makeText(this, messageRes, Toast.LENGTH_SHORT).show()
+    }
+
+    private enum class RootType { APP, SHARED }
+
+    companion object {
+        const val EXTRA_START_PATH = "start_path"
+
+        private const val PREFS_NAME = "file_manager"
+        private const val KEY_LAST_PATH = "last_path"
+        private const val KEY_CURRENT_PATH = "current_path"
+        private const val KEY_ROOT = "root"
+        private const val KEY_SHOW_HIDDEN = "show_hidden"
+
+        private const val MENU_NEW_FILE = 1
+        private const val MENU_NEW_FOLDER = 2
+        private const val MENU_REFRESH = 3
+        private const val MENU_SWITCH_ROOT = 4
+        private const val MENU_TOGGLE_HIDDEN = 5
+        private const val MENU_ALL_FILES_SETTINGS = 6
+    }
+}
