+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.ui.files
+
+import android.content.Intent
+import android.os.Bundle
+import android.view.Menu
+import android.view.MenuItem
+import android.view.ViewGroup
+import android.widget.Toast
+import androidx.activity.addCallback
+import androidx.activity.enableEdgeToEdge
+import androidx.appcompat.app.AlertDialog
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.core.view.updateLayoutParams
+import androidx.core.view.updatePadding
+import androidx.core.widget.doAfterTextChanged
+import org.fcitx.fcitx5.android.R
+import org.fcitx.fcitx5.android.databinding.ActivityFileEditorBinding
+import java.io.File
+import java.io.IOException
+
+/**
+ * Plain text editor for Rime/Fcitx5 configuration files.
+ *
+ * Files are small (the editor refuses anything above 2 MB), so IO is done
+ * synchronously on the main thread to keep the implementation simple.
+ */
+class FileEditorActivity : AppCompatActivity() {
+
+    private lateinit var binding: ActivityFileEditorBinding
+    private var file: File? = null
+    private var dirty = false
+    private var wrapEnabled = true
+    private var acceptingEdits = false
+    private var suppressTextWatcher = false
+    private var unsavedDialog: AlertDialog? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        enableEdgeToEdge()
+
+        val path = savedInstanceState?.getString(KEY_PATH)
+            ?: intent.getStringExtra(EXTRA_PATH)
+        if (path.isNullOrBlank()) {
+            toast(R.string.file_editor_error_invalid_path)
+            finish()
+            return
+        }
+        val target = File(path)
+        if (!target.isFile) {
+            toast(R.string.file_editor_error_not_found)
+            finish()
+            return
+        }
+
+        binding = ActivityFileEditorBinding.inflate(layoutInflater)
+        // Same as the file manager: grow the fixed-height toolbar by the status
+        // bar inset, otherwise the title/subtitle are clipped at the bottom.
+        val toolbarHeight = binding.toolbar.minimumHeight.takeIf { it > 0 }
+            ?: binding.toolbar.layoutParams.height
+        ViewCompat.setOnApplyWindowInsetsListener(binding.root) { _, windowInsets ->
+            val statusBars = windowInsets.getInsets(WindowInsetsCompat.Type.statusBars())
+            val navBars = windowInsets.getInsets(WindowInsetsCompat.Type.navigationBars())
+            val ime = windowInsets.getInsets(WindowInsetsCompat.Type.ime())
+            val cutout = windowInsets.getInsets(WindowInsetsCompat.Type.displayCutout())
+            binding.root.updateLayoutParams<ViewGroup.MarginLayoutParams> {
+                leftMargin = maxOf(navBars.left, cutout.left)
+                rightMargin = maxOf(navBars.right, cutout.right)
+            }
+            binding.toolbar.updateLayoutParams {
+                height = toolbarHeight + statusBars.top
+            }
+            binding.toolbar.updatePadding(top = statusBars.top)
+            binding.root.updatePadding(bottom = maxOf(navBars.bottom, ime.bottom))
+            windowInsets
+        }
+        setContentView(binding.root)
+
+        setSupportActionBar(binding.toolbar)
+        supportActionBar?.apply {
+            setDisplayHomeAsUpEnabled(true)
+            title = target.name
+            subtitle = target.parent
+        }
+        binding.toolbar.setNavigationOnClickListener {
+            onBackPressedDispatcher.onBackPressed()
+        }
+
+        wrapEnabled = savedInstanceState?.getBoolean(KEY_WRAP, true) ?: true
+        dirty = savedInstanceState?.getBoolean(KEY_DIRTY, false) ?: false
+
+        val content = readTextFile(target)
+        if (content == null) {
+            finish()
+            return
+        }
+        file = target
+
+        suppressTextWatcher = true
+        binding.editor.setText(content)
+        binding.editor.setSelection(0)
+        suppressTextWatcher = false
+        applyWrapMode()
+        updateStatus()
+
+        binding.editor.doAfterTextChanged {
+            if (acceptingEdits && !suppressTextWatcher) {
+                dirty = true
+            }
+            updateStatus()
+        }
+
+        onBackPressedDispatcher.addCallback(this) {
+            if (dirty) showUnsavedChangesDialog() else finish()
+        }
+    }
+
+    override fun onPostResume() {
+        super.onPostResume()
+        // View state (including the restored text) has been applied by now, so
+        // text changes from here on are real user edits.
+        acceptingEdits = true
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        super.onSaveInstanceState(outState)
+        file?.let { outState.putString(KEY_PATH, it.absolutePath) }
+        outState.putBoolean(KEY_DIRTY, dirty)
+        outState.putBoolean(KEY_WRAP, wrapEnabled)
+    }
+
+    override fun onCreateOptionsMenu(menu: Menu): Boolean {
+        menu.add(Menu.NONE, MENU_SAVE, 0, R.string.file_editor_save)
+            .setIcon(R.drawable.ic_baseline_save_24)
+            .setShowAsAction(MenuItem.SHOW_AS_ACTION_IF_ROOM)
+        menu.add(Menu.NONE, MENU_RELOAD, 1, R.string.file_editor_reload)
+            .setIcon(R.drawable.ic_refresh_24)
+            .setShowAsAction(MenuItem.SHOW_AS_ACTION_NEVER)
+        menu.add(Menu.NONE, MENU_WRAP, 2, R.string.file_editor_wrap)
+            .setCheckable(true)
+            .setChecked(wrapEnabled)
+            .setShowAsAction(MenuItem.SHOW_AS_ACTION_NEVER)
+        return true
+    }
+
+    override fun onOptionsItemSelected(item: MenuItem): Boolean {
+        return when (item.itemId) {
+            android.R.id.home -> {
+                onBackPressedDispatcher.onBackPressed()
+                true
+            }
+
+            MENU_SAVE -> {
+                saveFile()
+                true
+            }
+
+            MENU_RELOAD -> {
+                reloadFile()
+                true
+            }
+
+            MENU_WRAP -> {
+                wrapEnabled = !wrapEnabled
+                item.isChecked = wrapEnabled
+                applyWrapMode()
+                true
+            }
+
+            else -> super.onOptionsItemSelected(item)
+        }
+    }
+
+    override fun onSupportNavigateUp(): Boolean {
+        onBackPressedDispatcher.onBackPressed()
+        return true
+    }
+
+    private fun applyWrapMode() {
+        // Let TextView wrap long lines instead of laying them out horizontally.
+        binding.editor.setHorizontallyScrolling(!wrapEnabled)
+    }
+
+    private fun readTextFile(target: File): String? {
+        if (target.length() > FileEntry.MAX_TEXT_FILE_SIZE) {
+            toast(R.string.file_editor_error_too_large)
+            return null
+        }
+        val bytes = try {
+            target.readBytes()
+        } catch (_: IOException) {
+            toast(R.string.file_editor_error_read)
+            return null
+        } catch (_: SecurityException) {
+            toast(R.string.file_editor_error_read)
+            return null
+        }
+        if (bytes.size > FileEntry.MAX_TEXT_FILE_SIZE) {
+            toast(R.string.file_editor_error_too_large)
+            return null
+        }
+        if (bytes.any { it == 0.toByte() }) {
+            toast(R.string.file_editor_error_binary)
+            return null
+        }
+        var content = String(bytes, Charsets.UTF_8)
+        if (content.startsWith("\uFEFF")) {
+            content = content.substring(1)
+        }
+        return content
+    }
+
+    private fun reloadFile() {
+        if (dirty) {
+            AlertDialog.Builder(this)
+                .setTitle(R.string.file_editor_unsaved_title)
+                .setMessage(R.string.file_editor_reload_message)
+                .setPositiveButton(R.string.file_editor_discard) { _, _ -> doReload() }
+                .setNegativeButton(R.string.file_editor_cancel, null)
+                .show()
+        } else {
+            doReload()
+        }
+    }
+
+    private fun doReload() {
+        val target = file ?: return
+        val content = readTextFile(target) ?: return
+        suppressTextWatcher = true
+        binding.editor.setText(content)
+        binding.editor.setSelection(0)
+        suppressTextWatcher = false
+        dirty = false
+        updateStatus()
+    }
+
+    /**
+     * Save [file] atomically where possible.
+     *
+     * The previous contents are copied to `<name>.bak` first. The new contents
+     * are written to a temporary file in the same directory and renamed over
+     * the original; if the rename fails, the file is written directly.
+     */
+    private fun saveFile(): Boolean {
+        val target = file ?: return false
+        val parent = target.parentFile
+        if (parent == null || !parent.isDirectory) {
+            toast(R.string.file_editor_error_save)
+            return false
+        }
+        if (target.exists() && !target.canWrite()) {
+            toast(R.string.file_editor_error_read_only)
+            return false
+        }
+
+        if (target.exists() && !target.name.endsWith(".bak", ignoreCase = true)) {
+            val backup = File(parent, "${target.name}.bak")
+            val backedUp = try {
+                target.copyTo(backup, overwrite = true)
+                true
+            } catch (_: IOException) {
+                false
+            } catch (_: SecurityException) {
+                false
+            }
+            if (!backedUp) {
+                toast(R.string.file_editor_error_backup)
+                return false
+            }
+        }
+
+        val content = binding.editor.text.toString()
+        val saved = try {
+            val temp = File.createTempFile("fcitx5_edit_", ".tmp", parent)
+            try {
+                temp.writeText(content, Charsets.UTF_8)
+                if (!temp.renameTo(target)) {
+                    target.writeText(content, Charsets.UTF_8)
+                }
+            } finally {
+                if (temp.exists()) temp.delete()
+            }
+            true
+        } catch (_: IOException) {
+            false
+        } catch (_: SecurityException) {
+            false
+        }
+
+        if (!saved) {
+            toast(R.string.file_editor_error_save)
+            return false
+        }
+        dirty = false
+        updateStatus()
+        toast(R.string.file_editor_saved)
+        return true
+    }
+
+    private fun showUnsavedChangesDialog() {
+        if (unsavedDialog?.isShowing == true) return
+        val dialog = AlertDialog.Builder(this)
+            .setTitle(R.string.file_editor_unsaved_title)
+            .setMessage(R.string.file_editor_unsaved_message)
+            .setPositiveButton(R.string.file_editor_save) { _, _ ->
+                if (saveFile()) finish()
+            }
+            .setNegativeButton(R.string.file_editor_discard) { _, _ -> finish() }
+            .setNeutralButton(R.string.file_editor_cancel, null)
+            .create()
+        dialog.setOnDismissListener { unsavedDialog = null }
+        unsavedDialog = dialog
+        dialog.show()
+    }
+
+    private fun updateStatus() {
+        val chars = binding.editor.length()
+        val messageRes = if (dirty) {
+            R.string.file_editor_status_modified
+        } else {
+            R.string.file_editor_status_chars
+        }
+        binding.status.text = getString(messageRes, chars)
+    }
+
+    private fun toast(messageRes: Int) {
+        Toast.makeText(this, messageRes, Toast.LENGTH_SHORT).show()
+    }
+
+    companion object {
+        const val EXTRA_PATH = "path"
+
+        private const val KEY_PATH = "state_path"
+        private const val KEY_DIRTY = "state_dirty"
+        private const val KEY_WRAP = "state_wrap"
+
+        private const val MENU_SAVE = 1
+        private const val MENU_RELOAD = 2
+        private const val MENU_WRAP = 3
+    }
+}
