@@ -0,0 +1,109 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.ui.files
+
+import java.io.File
+import java.io.IOException
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * One row in the file manager list.
+ */
+data class FileEntry(
+    val name: String,
+    val file: File,
+    val isDirectory: Boolean,
+    val size: Long,
+    val lastModified: Long
+) {
+    val formattedSize: String
+        get() = if (isDirectory) "" else formatSize(size)
+
+    val formattedDate: String
+        get() = formatDate(lastModified)
+
+    val isHidden: Boolean
+        get() = name.startsWith(".")
+
+    companion object {
+        /** Files bigger than this are never opened in the text editor. */
+        const val MAX_TEXT_FILE_SIZE: Long = 2L * 1024L * 1024L
+
+        private val TEXT_EXTENSIONS = setOf(
+            "yaml", "yml", "txt", "json", "conf", "custom", "lua",
+            "dict", "schema", "md", "properties", "ini", "xml"
+        )
+
+        /**
+         * Human readable file size, e.g. `512 B`, `1.5 KB`, `12 MB`.
+         */
+        fun formatSize(bytes: Long): String {
+            if (bytes < 0L) return "—"
+            if (bytes < 1024L) return "$bytes B"
+
+            val units = arrayOf("KB", "MB", "GB", "TB")
+            var value = bytes.toDouble() / 1024.0
+            var unitIndex = 0
+            while (value >= 1024.0 && unitIndex < units.lastIndex) {
+                value /= 1024.0
+                unitIndex++
+            }
+            val pattern = if (value >= 100.0) "%.0f %s" else "%.1f %s"
+            return String.format(Locale.getDefault(), pattern, value, units[unitIndex])
+        }
+
+        /**
+         * Locale-aware modification time, e.g. `2026-10-25 12:30`.
+         */
+        fun formatDate(timestamp: Long): String {
+            if (timestamp <= 0L) return "—"
+            return SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.getDefault())
+                .format(Date(timestamp))
+        }
+
+        /**
+         * Cheap check used to pick the icon in the list. It deliberately does not
+         * read the file, since the adapter may bind many rows.
+         */
+        fun hasTextExtension(name: String): Boolean {
+            val dot = name.lastIndexOf('.')
+            if (dot < 0 || dot == name.lastIndex) return false
+            return name.substring(dot + 1).lowercase(Locale.ROOT) in TEXT_EXTENSIONS
+        }
+
+        /**
+         * Full check used before opening a file in the editor: text extension,
+         * at most [MAX_TEXT_FILE_SIZE] bytes, and no NUL byte in the content.
+         */
+        fun isTextual(entry: FileEntry): Boolean =
+            !entry.isDirectory && isTextual(entry.file)
+
+        fun isTextual(file: File): Boolean {
+            if (!file.isFile) return false
+            if (!hasTextExtension(file.name)) return false
+            if (file.length() > MAX_TEXT_FILE_SIZE) return false
+
+            return try {
+                file.inputStream().use { input ->
+                    val buffer = ByteArray(8192)
+                    while (true) {
+                        val read = input.read(buffer)
+                        if (read <= 0) break
+                        for (i in 0 until read) {
+                            if (buffer[i] == 0.toByte()) return false
+                        }
+                    }
+                }
+                true
+            } catch (_: IOException) {
+                false
+            } catch (_: SecurityException) {
+                false
+            }
+        }
+    }
+}
