diff --git a/app/src/main/java/org/fcitx/fcitx5/android/utils/RimeSyncUtils.kt b/app/src/main/java/org/fcitx/fcitx5/android/utils/RimeSyncUtils.kt
new file mode 100644
index 00000000..4e1cf82c
--- /dev/null
+++ b/app/src/main/java/org/fcitx/fcitx5/android/utils/RimeSyncUtils.kt
@@ -0,0 +1,43 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.utils
+
+import org.fcitx.fcitx5.android.FcitxApplication
+import timber.log.Timber
+import java.io.File
+
+/**
+ * Maintenance helpers for the Rime user data directory.
+ *
+ * librime uses a temporary LevelDB (`.temp.userdb`) while merging user
+ * dictionaries during `sync_user_data()`.  If the process is killed or a sync
+ * aborts (for example because the configured sync directory is not writable),
+ * the temporary database and its LOCK file can be left behind.  Every later
+ * sync in the same process then fails with:
+ *
+ *     Error opening db '.temp': IO error: lock .../.temp.userdb/LOCK: already held by process
+ *
+ * Deleting the temporary database before Fcitx starts is safe: it contains no
+ * user data, only intermediate merge state.
+ */
+object RimeSyncUtils {
+
+    fun rimeUserDataDir(): File =
+        File(FcitxApplication.getInstance().getExternalFilesDir(null) ?: FcitxApplication.getInstance().filesDir, "data/rime")
+
+    /**
+     * Remove a leftover `.temp.userdb` from an interrupted sync.  Must only be
+     * called when no sync is running (i.e. before the Fcitx core starts).
+     */
+    fun cleanupStaleTempDatabase() {
+        val temp = File(rimeUserDataDir(), ".temp.userdb")
+        if (!temp.exists()) return
+        if (temp.deleteRecursively()) {
+            Timber.w("Removed stale Rime sync database: ${temp.absolutePath}")
+        } else {
+            Timber.w("Failed to remove stale Rime sync database: ${temp.absolutePath}")
+        }
+    }
+}
