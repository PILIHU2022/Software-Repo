+    <string name="storage_permission_later">Later</string>
+    <string name="storage_permission_granted">All files access granted</string>
+    <string name="storage_permission_not_granted">All files access not granted — Rime sync to shared storage will fail</string>
+    <string name="storage_permission_settings_title">All files access</string>
+    <string name="file_manager">File manager</string>
+    <string name="file_manager_summary">Browse and edit Rime/Fcitx5 configuration files</string>
+</resources>
