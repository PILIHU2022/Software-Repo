+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.debug
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.os.Environment
+import kotlinx.coroutines.launch
+import org.fcitx.fcitx5.android.FcitxApplication
+import org.fcitx.fcitx5.android.daemon.FcitxDaemon
+import timber.log.Timber
+import java.io.File
+
+/**
+ * Debug-only hook used by the maintainer to verify native addon actions and
+ * shared-storage access over `adb shell am broadcast`.
+ *
+ *     adb shell am broadcast \
+ *       -a org.fcitx.fcitx5.android.debug.SYNC_TEST \
+ *       -n org.fcitx.fcitx5.android.debug/.DebugSyncReceiver
+ *
+ *     adb shell am broadcast \
+ *       -a org.fcitx.fcitx5.android.debug.WRITE_TEST \
+ *       -n org.fcitx.fcitx5.android.debug/.DebugSyncReceiver
+ */
+class DebugSyncReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        when (intent.action) {
+            ACTION_SYNC -> sync()
+            ACTION_WRITE -> writeTest()
+        }
+    }
+
+    private fun sync() {
+        val fcitx = FcitxDaemon.getFirstConnectionOrNull()
+        if (fcitx == null) {
+            Timber.w("DebugSyncReceiver: no fcitx connection")
+            return
+        }
+        FcitxApplication.getInstance().coroutineScope.launch {
+            fcitx.runOnReady {
+                // The Rime engine (and its `fcitx-rime-sync` action) is only
+                // created once an input context actually uses it.
+                Timber.i(
+                    "DebugSyncReceiver: addons=%s available=%s enabled=%s",
+                    addons().joinToString { "${it.uniqueName}:${it.enabled}" },
+                    availableIme().joinToString { it.uniqueName },
+                    enabledIme().joinToString { it.uniqueName }
+                )
+                setEnabledIme(arrayOf("rime"))
+                activate(android.os.Process.myUid(), "org.fcitx.fcitx5.android.debug")
+                runCatching { activateIme("rime") }
+                    .onFailure { Timber.w(it, "DebugSyncReceiver: activateIme failed") }
+                kotlinx.coroutines.delay(1000L)
+                val current = runCatching { currentIme().uniqueName }.getOrNull()
+                val ok = activateActionByName("fcitx-rime-sync")
+                Timber.i("DebugSyncReceiver: current=$current fcitx-rime-sync activated=$ok")
+            }
+        }
+    }
+
+    private fun writeTest() {
+        val target = File(
+            Environment.getExternalStorageDirectory(),
+            "Download/Rime-Sync/Android/_fcitx_write_test"
+        )
+        val result = runCatching {
+            target.parentFile?.mkdirs()
+            target.writeText("fcitx5 write test")
+            val read = target.readText()
+            target.delete()
+            read == "fcitx5 write test"
+        }
+        Timber.i("DebugSyncReceiver: shared-storage write test ok=${result.getOrNull()} err=${result.exceptionOrNull()}")
+    }
+
+    companion object {
+        const val ACTION_SYNC = "org.fcitx.fcitx5.android.debug.SYNC_TEST"
+        const val ACTION_WRITE = "org.fcitx.fcitx5.android.debug.WRITE_TEST"
+    }
+}
