+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.ui.files
+
+import android.Manifest
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Build
+import android.os.Environment
+import android.provider.Settings
+import java.io.File
+
+/**
+ * Small, dependency-free helpers describing where the file manager is allowed to
+ * browse. Kept separate from the UI so the entry point can reuse the same roots.
+ */
+object StorageAccess {
+
+    /**
+     * Whether the app currently holds the broad storage permission needed to
+     * browse all of shared storage.
+     */
+    fun hasAllFilesAccess(context: Context): Boolean {
+        return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            Environment.isExternalStorageManager()
+        } else {
+            context.checkSelfPermission(Manifest.permission.WRITE_EXTERNAL_STORAGE) ==
+                PackageManager.PERMISSION_GRANTED
+        }
+    }
+
+    /**
+     * Intent that opens the system page for granting "All files access".
+     *
+     * Returns `null` on Android 10 and below, where the legacy runtime permission
+     * has to be requested by the caller instead.
+     */
+    fun allFilesAccessIntent(context: Context): Intent? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return null
+
+        val appSpecific = Intent(
+            Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION,
+            Uri.parse("package:${context.packageName}")
+        )
+        return if (context.packageManager.resolveActivity(appSpecific, 0) != null) {
+            appSpecific
+        } else {
+            // Some ROMs only implement the global settings page.
+            Intent(Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION)
+        }
+    }
+
+    /** Root of shared storage, usually `/storage/emulated/0`. */
+    fun sharedStorageRoot(): File = Environment.getExternalStorageDirectory()
+
+    /** App-specific external files directory, falling back to internal storage. */
+    fun appFilesRoot(context: Context): File =
+        context.getExternalFilesDir(null) ?: context.filesDir
+
+    /** Directory where Rime/Fcitx5 user data lives. */
+    fun rimeDataDir(context: Context): File =
+        File(appFilesRoot(context), "data/rime")
+
+    /** The most useful starting directory: Rime data if it exists, else app files. */
+    fun defaultStartDir(context: Context): File =
+        rimeDataDir(context).takeIf { it.isDirectory } ?: appFilesRoot(context)
+}
