@@ -6,6 +6,7 @@ package org.fcitx.fcitx5.android.data.stats
 
 import android.content.Context
 import android.os.Handler
+import android.os.SystemClock
 import android.os.Looper
 import androidx.annotation.Keep
 import androidx.room.withTransaction
@@ -184,15 +185,30 @@ object TypingStatsManager {
         }
     }
 
+    private var lastRefreshAtMs = 0L
+
     /** Reload the snapshot from Room, after flushing anything still buffered. */
     fun refresh() {
         if (!initialized) return
+        lastRefreshAtMs = SystemClock.elapsedRealtime()
         scope.launch {
             write(drainPending())
             publishSnapshot()
         }
     }
 
+    /**
+     * Like [refresh], but skips the Room round-trip (and the resulting recomposition of the
+     * home heatmap) when it just ran. The home page calls this every time it re-enters the
+     * composition; hitting the database on every back navigation costs frames for no data.
+     */
+    fun refreshIfStale(minIntervalMs: Long = 2_000L) {
+        if (!initialized) return
+        val now = SystemClock.elapsedRealtime()
+        if (now - lastRefreshAtMs < minIntervalMs) return
+        refresh()
+    }
+
     /** Drop all recorded statistics and restart the "since install" anchor from now. */
     fun reset() {
         if (!initialized) return
