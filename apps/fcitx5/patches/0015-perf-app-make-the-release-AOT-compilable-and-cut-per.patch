diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index e24ced49..40bc664f 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -42,10 +42,13 @@ android {
 
     buildTypes {
         release {
-            // Patchwork builds keep the release signature but stay debuggable so
-            // `adb shell run-as org.fcitx.fcitx5.android` can inspect the Rime
-            // data dir and recover a bad deployment without reinstalling.
-            isDebuggable = true
+            // Must stay `false`: Android installs debuggable APKs with the `verify` (interpret
