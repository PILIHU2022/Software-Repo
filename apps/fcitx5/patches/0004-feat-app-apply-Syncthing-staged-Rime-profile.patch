diff --git a/app/src/main/java/org/fcitx/fcitx5/android/utils/RimeProfileSync.kt b/app/src/main/java/org/fcitx/fcitx5/android/utils/RimeProfileSync.kt
new file mode 100644
index 00000000..b74185b8
--- /dev/null
+++ b/app/src/main/java/org/fcitx/fcitx5/android/utils/RimeProfileSync.kt
@@ -0,0 +1,131 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.utils
+
+import android.os.Environment
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.fcitx.fcitx5.android.daemon.FcitxDaemon
+import timber.log.Timber
+import java.io.File
+
+/**
+ * Bridge between a Syncthing folder in shared storage and the app-private Rime
+ * user data directory.
+ *
+ * Android does not let Syncthing (a different app) write into
+ * `/sdcard/Android/data/org.fcitx.fcitx5.android/files/data/rime`, so Rime
+ * configuration can only be delivered to `Download/` and then copied in by the
+ * app itself. [apply] performs that copy, drops librime's `build/` staging
+ * directory so the schema is regenerated, and restarts Fcitx so that the
+ * deployment runs.
+ */
+object RimeProfileSync {
+
+    /** Folder shared with the PC through Syncthing (relative to shared storage). */
+    const val STAGING_RELATIVE_PATH = "Download/Rime-Sync/Rime-Arch"
+
+    /**
+     * Top-level entries that must never be copied into the Rime user dir:
+     * - `build` is librime's machine-specific compilation cache
+     * - `sync`, `.git`, `tools`, `others` are not Rime deployment input
+     * - Syncthing bookkeeping
+     */
+    private val SKIP_TOP_LEVEL = setOf(
+        "build", "sync", ".git", "tools", "others",
+        ".stfolder", ".stversions", ".stignore"
+    )
+
+    /** Files larger than this are compared by size only (cheap, no full read). */
+    private const val CONTENT_COMPARE_MAX_SIZE = 8_000_000L
+
+    fun stagingDir(): File =
+        File(Environment.getExternalStorageDirectory(), STAGING_RELATIVE_PATH)
+
+    fun rimeDir(): File = RimeSyncUtils.rimeUserDataDir()
+
+    fun hasStaging(): Boolean = stagingDir().isDirectory
+
+    /**
+     * Copy new/changed files from the staging folder into the Rime user data
+     * dir and, only when something actually changed, remove `build/` and
+     * restart Fcitx so that Rime redeploys on next use.
+     *
+     * Must be called from the main thread: Fcitx is stopped and restarted here,
+     * while the file comparison and copy run on [Dispatchers.IO].
+     *
+     * @return number of files that were actually written (0 = nothing to do)
+     */
+    suspend fun apply(): Int {
+        val src = stagingDir()
+        check(src.isDirectory) { "Staging folder not found: ${src.absolutePath}" }
+        val dst = rimeDir().apply { mkdirs() }
+        val changes = withContext(Dispatchers.IO) { countChanges(src, dst) }
+        if (changes == 0) {
+            Timber.i("RimeProfileSync: already up to date")
+            return 0
+        }
+        Timber.i("RimeProfileSync: $changes changed file(s), ${src.absolutePath} -> ${dst.absolutePath}")
+        FcitxDaemon.stopFcitx()
+        var copied = 0
+        try {
+            copied = withContext(Dispatchers.IO) {
+                RimeSyncUtils.cleanupStaleTempDatabase()
+                var n = 0
+                src.listFiles()?.forEach { entry ->
+                    if (entry.name in SKIP_TOP_LEVEL) return@forEach
+                    n += copyEntry(entry, File(dst, entry.name))
+                }
+                File(dst, "build").deleteRecursively()
+                File(dst, ".synced-from-shared").writeText(System.currentTimeMillis().toString())
+                n
+            }
+            Timber.i("RimeProfileSync: wrote $copied file(s), removed build/")
+        } finally {
+            FcitxDaemon.restartFcitx()
+        }
+        return copied
+    }
+
+    private fun countChanges(src: File, dst: File): Int {
+        if (src.name in SKIP_TOP_LEVEL) return 0
+        if (isSkippedFile(src.name)) return 0
+        if (src.isDirectory) {
+            var n = 0
+            src.listFiles()?.forEach { n += countChanges(it, File(dst, it.name)) }
+            return n
+        }
+        if (!src.isFile) return 0
+        return if (sameContent(src, dst)) 0 else 1
+    }
+
+    private fun copyEntry(src: File, dst: File): Int {
+        if (isSkippedFile(src.name)) return 0
+        if (src.isDirectory) {
+            if (!dst.isDirectory && !dst.mkdirs()) {
+                Timber.w("RimeProfileSync: cannot create ${dst.absolutePath}")
+                return 0
+            }
+            var n = 0
+            src.listFiles()?.forEach { n += copyEntry(it, File(dst, it.name)) }
+            return n
+        }
+        if (!src.isFile || sameContent(src, dst)) return 0
+        src.copyTo(dst, overwrite = true)
+        return 1
+    }
+
+    /** Keep the phone's own installation.yaml / user.yaml and never copy LevelDB user dictionaries. */
+    private fun isSkippedFile(name: String): Boolean =
+        name.contains(".userdb") ||
+            name == "installation.yaml" || name == "installation.yaml.bak" ||
+            name == "user.yaml" || name == "user.yaml.bak"
+
+    private fun sameContent(a: File, b: File): Boolean {
+        if (!b.isFile || a.length() != b.length()) return false
+        if (a.length() > CONTENT_COMPARE_MAX_SIZE) return true
+        return runCatching { a.readBytes().contentEquals(b.readBytes()) }.getOrDefault(false)
+    }
+}
