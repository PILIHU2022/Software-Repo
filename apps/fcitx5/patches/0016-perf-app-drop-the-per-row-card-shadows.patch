From ad6c35d25d770f6285b1505bdaebf54b10254041 Mon Sep 17 00:00:00 2001
From: DeepSeek Harness <noreply@deepseek.com>
Date: Sat, 21 Nov 2026 11:48:58 +0800
Subject: [PATCH 16/17] perf(app): drop the per-row card shadows

Every SettingsRow / preference / info card carried a 1dp elevation shadow. The
settings design is tonal, so the shadow is invisible but costs GPU time on
every frame of the page transitions (dumpsys gfxinfo showed 13-17ms 90th
percentile GPU time at 60Hz).
---
 .../android/ui/main/compose/components/SettingsScaffold.kt     | 3 +++
 .../fcitx/fcitx5/android/ui/main/compose/home/HeatmapCard.kt   | 1 +
 .../fcitx5/android/ui/main/compose/screens/DataScreens.kt      | 2 ++
 .../android/ui/main/compose/screens/PreferenceControls.kt      | 1 +
 4 files changed, 7 insertions(+)

diff --git a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/components/SettingsScaffold.kt b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/components/SettingsScaffold.kt
index 8a9b6918..61452ee7 100644
--- a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/components/SettingsScaffold.kt
+++ b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/components/SettingsScaffold.kt
@@ -129,6 +129,9 @@ fun SettingsRow(
             containerColor = scheme.surfaceContainerLow,
             disabledContainerColor = scheme.surfaceContainerLowest,
         ),
+        // Flat rows: a 1dp shadow per card costs GPU time on every transition frame and is
+        // invisible against the tonal surface.
+        elevation = CardDefaults.cardElevation(defaultElevation = 0.dp),
     ) {
         Row(
             modifier = Modifier.padding(start = 16.dp, top = 14.dp, end = 12.dp, bottom = 14.dp),
diff --git a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/home/HeatmapCard.kt b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/home/HeatmapCard.kt
index 6ffb00b2..8a56baba 100644
--- a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/home/HeatmapCard.kt
+++ b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/home/HeatmapCard.kt
@@ -172,6 +172,7 @@ fun HeatmapCard(onClick: () -> Unit) {
             .padding(top = 8.dp),
         shape = RoundedCornerShape(28.dp),
         colors = CardDefaults.cardColors(containerColor = scheme.surfaceContainerHigh),
+        elevation = CardDefaults.cardElevation(defaultElevation = 0.dp),
     ) {
         Column(modifier = Modifier.padding(20.dp)) {
             // Expressive header: icon, title, live summary, compact total pill.
diff --git a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/DataScreens.kt b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/DataScreens.kt
index b76ba5f3..48490a78 100644
--- a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/DataScreens.kt
+++ b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/DataScreens.kt
@@ -1411,6 +1411,7 @@ private fun InfoRow(
                 .padding(vertical = 4.dp),
             shape = shape,
             colors = colors,
+            elevation = CardDefaults.cardElevation(defaultElevation = 0.dp),
             content = content,
         )
     } else {
@@ -1420,6 +1421,7 @@ private fun InfoRow(
                 .padding(vertical = 4.dp),
             shape = shape,
             colors = colors,
+            elevation = CardDefaults.cardElevation(defaultElevation = 0.dp),
             content = content,
         )
     }
diff --git a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/PreferenceControls.kt b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/PreferenceControls.kt
index ee91d15d..56d4ce54 100644
--- a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/PreferenceControls.kt
+++ b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/PreferenceControls.kt
@@ -138,6 +138,7 @@ private fun PreferenceCard(
             containerColor = if (enabled) scheme.surfaceContainerLow
             else scheme.surfaceContainerLowest,
         ),
+        elevation = CardDefaults.cardElevation(defaultElevation = 0.dp),
     ) {
         Column(
             modifier = Modifier.padding(start = 20.dp, top = 14.dp, end = 20.dp, bottom = 10.dp),
