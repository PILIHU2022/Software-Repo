+package org.fcitx.fcitx5.android.data.backup
+
+import android.content.Context
+import android.os.Build
+import androidx.core.content.edit
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import kotlinx.serialization.json.Json
+import org.fcitx.fcitx5.android.R
+import org.fcitx.fcitx5.android.data.UserDataManager
+import org.fcitx.fcitx5.android.utils.formatDateTime
+import org.fcitx.fcitx5.android.utils.userManager
+import org.fcitx.fcitx5.android.utils.versionCodeCompat
+import timber.log.Timber
+import java.io.File
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.zip.ZipFile
+
+/**
+ * Keeps a few automatic ZIP backups of the user data (shared prefs, databases and the external
+ * app files dir) and can restore the newest one.
+ *
+ * A backup is created once per app version upgrade, before any of the data-dir managers open
+ * their SQLite databases, so the copy is consistent. It intentionally contains only the small,
+ * update-safe state (`shared_prefs` and `databases`: settings, clipboard, typing statistics).
+ * The external files dir (Rime config, dictionaries, themes) is several dozen MB and is preserved
+ * by a same-package/same-signature `install -r` upgrade, so it is not copied automatically; the
+ * manual "Export user data" still includes it.
+ *
+ * The ZIP layout is the regular [UserDataManager] user data ZIP (minus the `external/` entries),
+ * therefore it can also be imported through Settings > Advanced > Import user data (or by older
+ * app versions), and importing it leaves the current external data untouched.
+ *
+ * Everything here is best effort: failures are logged and the app keeps running.
+ */
+object AutoBackupManager {
+
+    private const val PREFS_NAME = "auto_backup"
+    private const val KEY_LAST_BACKED_UP_VERSION = "last_backed_up_version_code"
+    private const val OWN_PREFS_FILE_NAME = PREFS_NAME + ".xml"
+
+    private const val BACKUP_DIR_NAME = "auto_backup"
+    private const val STAGING_DIR_NAME = "auto_backup_staging"
+    private const val PARTIAL_SUFFIX = ".part"
+
+    private const val METADATA_ENTRY_NAME = "metadata.json"
+
+    /**
+     * Snapshots up to this size are zipped on the calling (main) thread so the backup file
+     * exists immediately. Automatic backups only contain prefs and databases, so this is the
+     * normal path; it is only exceeded by a very large clipboard history.
+     */
+    private const val MAX_SYNCHRONOUS_ZIP_BYTES = 8L * 1024L * 1024L
+
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /** Background zip work; only used after the synchronously copied snapshot is complete. */
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+
+    /** At most one backup attempt per process. */
+    private val attempted = AtomicBoolean(false)
+
+    // region public API
+
+    /**
+     * Create a pre-upgrade backup if the installed version changed since the last backup.
+     *
+     * Must be called after `AppPrefs.init()` and before `ClipboardManager.init()` /
+     * `TypingStatsManager.init()`, so no SQLite database is open yet while the dirs are copied.
+     * Never throws.
+     */
+    fun maybeBackupOnUpgrade(context: Context) {
+        if (!attempted.compareAndSet(false, true)) {
+            Timber.d("Auto backup already handled in this process")
+            return
+        }
+        try {
+            val appContext = context.applicationContext ?: context
+            if (isDirectBoot(appContext)) {
+                Timber.d("Auto backup skipped: direct boot mode")
+                return
+            }
+            val currentVersion = currentVersionCode(appContext)
+            if (currentVersion == null) {
+                Timber.w("Auto backup skipped: unknown versionCode")
+                return
+            }
+            cleanStaleArtifacts(appContext)
+            val lastVersion = readLastBackedUpVersion(appContext)
+            if (!AutoBackupPolicy.shouldBackup(lastVersion, currentVersion)) {
+                if (currentVersion < lastVersion) {
+                    Timber.i(
+                        "Auto backup skipped: downgrade (last=$lastVersion current=$currentVersion)"
+                    )
+                } else {
+                    Timber.d("Auto backup skipped: already backed up for version $currentVersion")
+                }
+                return
+            }
+            val dataDir = File(appContext.applicationInfo.dataDir)
+            val sharedPrefs = File(dataDir, "shared_prefs")
+            val databases = File(dataDir, "databases")
+            val databaseFileSizes = listFilesOf(databases)
+                .filter { it.isFile && it.length() > 0L }
+                .map { it.length() }
+            val sharedPrefsFileNames = listFilesOf(sharedPrefs)
+                .filter { it.isFile }
+                .map { it.name }
+            val defaultPrefsFileName = defaultSharedPrefsFileName(appContext)
+            if (!AutoBackupPolicy.isMeaningfulBackup(
+                    databaseFileSizes = databaseFileSizes,
+                    sharedPrefsFileNames = sharedPrefsFileNames,
+                    defaultSharedPrefsFileName = defaultPrefsFileName,
+                    ignoredSharedPrefsFileNames = setOf(OWN_PREFS_FILE_NAME)
+                )
+            ) {
+                Timber.i("Auto backup skipped: no meaningful user data yet (fresh install?)")
+                // Nothing to protect, but do not re-check on every launch of this version.
+                writeLastBackedUpVersion(appContext, currentVersion)
+                return
+            }
+            val staging = stagingDir(appContext)
+            if (staging.exists() && !staging.deleteRecursively()) {
+                Timber.w("Cannot clean stale auto backup staging dir ${staging.path}")
+            }
+            if (!staging.mkdirs() && !staging.isDirectory) {
+                Timber.w("Auto backup skipped: cannot create staging dir ${staging.path}")
+                return
+            }
+            // Snapshot synchronously, while databases are still closed. Only the small state is
+            // copied: a few hundred KB at most, never the huge Rime data in the external dir.
+            if (!copyTree(sharedPrefs, File(staging, "shared_prefs")) ||
+                !copyTree(databases, File(staging, "databases"))
+            ) {
+                Timber.w("Auto backup skipped: failed to copy the data dirs")
+                staging.deleteRecursively()
+                return
+            }
+            val timestamp = System.currentTimeMillis()
+            val fileName = AutoBackupPolicy.backupFileName(currentVersion, timestamp)
+            val finish = {
+                try {
+                    zipSnapshot(appContext, staging, fileName, timestamp)
+                    writeLastBackedUpVersion(appContext, currentVersion)
+                    prune(appContext)
+                } catch (t: Throwable) {
+                    Timber.e(t, "Auto backup failed")
+                } finally {
+                    staging.deleteRecursively()
+                }
+            }
+            val snapshotBytes = databaseFileSizes.sum() +
+                    listFilesOf(sharedPrefs).filter { it.isFile }.sumOf { it.length() }
+            if (snapshotBytes <= MAX_SYNCHRONOUS_ZIP_BYTES) {
+                // Small data set: finish right away so the backup exists immediately.
+                finish()
+            } else {
+                // Large clipboard history: deflating it here would delay app start.
+                Timber.d("Auto backup zip deferred to background (${snapshotBytes} bytes)")
+                scope.launch { finish() }
+            }
+        } catch (t: Throwable) {
+            // a broken backup must never take the app down
+            Timber.e(t, "Auto backup failed")
+        }
+    }
+
+    /** The newest automatic backup, or `null` if there is none. */
+    fun latestBackup(context: Context): File? = listBackups(context).firstOrNull()
+
+    /** All automatic backups, newest first. */
+    fun listBackups(context: Context): List<File> {
+        val appContext = context.applicationContext ?: context
+        val files = backupDir(appContext).listFiles { file ->
+            file.isFile && AutoBackupPolicy.parseBackupFileName(file.name) != null
+        } ?: return emptyList()
+        return files.sortedWith(
+            compareByDescending<File> {
+                AutoBackupPolicy.parseBackupFileName(it.name)?.timestamp ?: it.lastModified()
+            }.thenByDescending { it.name }
+        )
+    }
+
+    /**
+     * Localized one line summary of the newest backup (date, app version, size),
+     * or `null` when there is no backup yet.
+     */
+    fun backupSummary(context: Context): String? {
+        val appContext = context.applicationContext ?: context
+        val backup = latestBackup(appContext) ?: return null
+        val parsed = AutoBackupPolicy.parseBackupFileName(backup.name)
+        val metadata = readMetadata(backup)
+        val time = metadata?.exportTime ?: parsed?.timestamp ?: backup.lastModified()
+        val version = metadata?.versionName?.takeIf { it.isNotBlank() }
+            ?: parsed?.versionCode?.toString()
+            ?: "?"
+        return appContext.getString(
+            R.string.backup_summary_format,
+            formatDateTime(time),
+            version,
+            AutoBackupPolicy.formatSize(backup.length())
+        )
+    }
+
+    /**
+     * Import the newest automatic backup. The caller is responsible for stopping fcitx before
+     * calling this and for restarting the app afterwards (see the existing import user data flow).
+     */
+    fun restoreLatest(context: Context): Result<File> = runCatching {
+        val appContext = context.applicationContext ?: context
+        val backup = latestBackup(appContext)
+            ?: error(appContext.getString(R.string.backup_restore_no_backup))
+        backup.inputStream().use { input ->
+            UserDataManager.import(input).getOrThrow()
+        }
+        backup
+    }
+
+    // endregion
+
+    // region internals
+
+    private fun isDirectBoot(context: Context): Boolean =
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.N && !context.userManager.isUserUnlocked
+
+    private fun backupDir(context: Context) = File(context.filesDir, BACKUP_DIR_NAME)
+
+    /**
+     * File name of the default [android.content.SharedPreferences] created by
+     * `PreferenceManager.getDefaultSharedPreferences()`, which is `<packageName>_preferences.xml`.
+     * It always exists after the first run, so it does not count as user data on its own.
+     */
+    private fun defaultSharedPrefsFileName(context: Context) =
+        context.packageName + "_preferences.xml"
+
+    private fun stagingDir(context: Context) = File(context.cacheDir, STAGING_DIR_NAME)
+
+    private fun prefs(context: Context) =
+        context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    private fun readLastBackedUpVersion(context: Context): Long = try {
+        prefs(context).getLong(KEY_LAST_BACKED_UP_VERSION, AutoBackupPolicy.NO_VERSION)
+    } catch (t: Throwable) {
+        Timber.w(t, "Cannot read last backed up version")
+        AutoBackupPolicy.NO_VERSION
+    }
+
+    private fun writeLastBackedUpVersion(context: Context, versionCode: Long) {
+        try {
+            prefs(context).edit(commit = true) {
+                putLong(KEY_LAST_BACKED_UP_VERSION, versionCode)
+            }
+        } catch (t: Throwable) {
+            Timber.w(t, "Cannot persist last backed up version")
+        }
+    }
+
+    private fun currentVersionCode(context: Context): Long? = try {
+        context.packageManager.getPackageInfo(context.packageName, 0).versionCodeCompat
+    } catch (t: Throwable) {
+        Timber.e(t, "Cannot determine current versionCode")
+        null
+    }
+
+    private fun listFilesOf(dir: File): List<File> {
+        if (!dir.isDirectory) return emptyList()
+        return dir.listFiles()?.toList() ?: emptyList()
+    }
+
+    private fun copyTree(source: File, target: File): Boolean {
+        if (!source.isDirectory) {
+            Timber.d("Skip copying missing data dir ${source.path}")
+            return true
+        }
+        return try {
+            source.copyRecursively(target, overwrite = true)
+        } catch (t: Throwable) {
+            Timber.e(t, "Failed to copy ${source.path} to ${target.path}")
+            false
+        }
+    }
+
+    private fun cleanStaleArtifacts(context: Context) {
+        try {
+            val staging = stagingDir(context)
+            if (staging.exists()) staging.deleteRecursively()
+            backupDir(context).listFiles { file ->
+                file.isFile && file.name.endsWith(PARTIAL_SUFFIX)
+            }?.forEach { partial ->
+                if (!partial.delete()) Timber.w("Cannot delete stale ${partial.path}")
+            }
+        } catch (t: Throwable) {
+            Timber.w(t, "Failed to clean stale auto backup artifacts")
+        }
+    }
+
+    private fun zipSnapshot(context: Context, staging: File, fileName: String, timestamp: Long) {
+        val dir = backupDir(context)
+        if (!dir.isDirectory && !dir.mkdirs()) {
+            error("Cannot create auto backup dir ${dir.path}")
+        }
+        val partial = File(dir, fileName + PARTIAL_SUFFIX)
+        if (partial.exists()) partial.delete()
+        try {
+            partial.outputStream().buffered().use { output ->
+                UserDataManager.exportSnapshot(
+                    sharedPrefs = File(staging, "shared_prefs"),
+                    databases = File(staging, "databases"),
+                    // Rime data in the external dir is huge and survives `install -r`, so the
+                    // automatic backup deliberately omits it (manual export still includes it).
+                    external = null,
+                    dest = output,
+                    timestamp = timestamp
+                ).getOrThrow()
+            }
+            val target = File(dir, fileName)
+            if (!partial.renameTo(target)) {
+                error("Cannot move ${partial.path} to ${target.path}")
+            }
+            Timber.i("Auto backup created: ${target.name} (${target.length()} bytes)")
+        } catch (t: Throwable) {
+            partial.delete()
+            throw t
+        }
+    }
+
+    private fun prune(context: Context, keep: Int = AutoBackupPolicy.MAX_BACKUPS) {
+        try {
+            val dir = backupDir(context)
+            val namesNewestFirst = listBackups(context).map { it.name }
+            AutoBackupPolicy.filesToPrune(namesNewestFirst, keep).forEach { name ->
+                val file = File(dir, name)
+                if (file.delete()) {
+                    Timber.d("Pruned old auto backup: $name")
+                } else {
+                    Timber.w("Cannot delete old auto backup: $name")
+                }
+            }
+        } catch (t: Throwable) {
+            Timber.w(t, "Failed to prune old auto backups")
+        }
+    }
+
+    private fun readMetadata(file: File): UserDataManager.Metadata? = try {
+        ZipFile(file).use { zip ->
+            val entry = zip.getEntry(METADATA_ENTRY_NAME) ?: return null
+            val text = zip.getInputStream(entry).bufferedReader().use { it.readText() }
+            json.decodeFromString<UserDataManager.Metadata>(text)
+        }
+    } catch (t: Throwable) {
+        Timber.w(t, "Cannot read metadata from ${file.name}")
+        null
+    }
+
+    // endregion
+}
