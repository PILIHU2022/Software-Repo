+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.data.backup
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * JVM-only tests: [AutoBackupPolicy] must not depend on the Android framework.
+ */
+class AutoBackupPolicyTest {
+
+    // region shouldBackup
+
+    @Test
+    fun shouldBackupOnFirstLaunchEver() {
+        assertTrue(AutoBackupPolicy.shouldBackup(AutoBackupPolicy.NO_VERSION, 1L))
+        assertTrue(AutoBackupPolicy.shouldBackup(AutoBackupPolicy.NO_VERSION, 20312L))
+    }
+
+    @Test
+    fun shouldBackupOnNewerVersion() {
+        assertTrue(AutoBackupPolicy.shouldBackup(100L, 101L))
+        assertTrue(AutoBackupPolicy.shouldBackup(0L, 1L))
+        assertTrue(AutoBackupPolicy.shouldBackup(1L, Long.MAX_VALUE))
+    }
+
+    @Test
+    fun shouldNotBackupOnSameVersion() {
+        // at most one backup per installed version
+        assertFalse(AutoBackupPolicy.shouldBackup(101L, 101L))
+        assertFalse(AutoBackupPolicy.shouldBackup(1L, 1L))
+    }
+
+    @Test
+    fun shouldNotBackupOnDowngrade() {
+        assertFalse(AutoBackupPolicy.shouldBackup(101L, 100L))
+        assertFalse(AutoBackupPolicy.shouldBackup(20312L, 20311L))
+    }
+
+    // endregion
+
+    // region filesToPrune
+
+    private fun names(count: Int): List<String> =
+        (1..count).map { AutoBackupPolicy.backupFileName(it.toLong(), it * 1_000L) }
+            .reversed() // newest first: higher index = newer
+
+    @Test
+    fun pruneKeepsThreeNewestBackups() {
+        val newestFirst = names(5) // version 5, 4, 3, 2, 1
+        val pruned = AutoBackupPolicy.filesToPrune(newestFirst, 3)
+        assertEquals(2, pruned.size)
+        // the two oldest ones go, newest three stay
+        assertEquals(newestFirst.subList(3, 5), pruned)
+    }
+
+    @Test
+    fun pruneDoesNothingWhenAtMostKeep() {
+        assertEquals(emptyList<String>(), AutoBackupPolicy.filesToPrune(emptyList(), 3))
+        assertEquals(
+            emptyList<String>(),
+            AutoBackupPolicy.filesToPrune(names(1), 3)
+        )
+        assertEquals(
+            emptyList<String>(),
+            AutoBackupPolicy.filesToPrune(names(3), 3)
+        )
+    }
+
+    @Test
+    fun pruneWithZeroKeepDeletesEverything() {
+        val newestFirst = names(3)
+        assertEquals(newestFirst, AutoBackupPolicy.filesToPrune(newestFirst, 0))
+        // negative keep is treated like zero instead of producing a negative index
+        assertEquals(newestFirst, AutoBackupPolicy.filesToPrune(newestFirst, -1))
+    }
+
+    @Test
+    fun pruneOfSingleBackupWithKeepOne() {
+        assertEquals(emptyList<String>(), AutoBackupPolicy.filesToPrune(names(1), 1))
+    }
+
+    // endregion
+
+    // region formatSize
+
+    @Test
+    fun formatSizeOfZeroAndNegative() {
+        assertEquals("0 B", AutoBackupPolicy.formatSize(0L))
+        assertEquals("0 B", AutoBackupPolicy.formatSize(-1L))
+    }
+
+    @Test
+    fun formatSizeOfBytes() {
+        assertEquals("1 B", AutoBackupPolicy.formatSize(1L))
+        assertEquals("512 B", AutoBackupPolicy.formatSize(512L))
+        assertEquals("1023 B", AutoBackupPolicy.formatSize(1023L))
+    }
+
+    @Test
+    fun formatSizeOfKilobytes() {
+        assertEquals("1.0 KB", AutoBackupPolicy.formatSize(1024L))
+        assertEquals("1.5 KB", AutoBackupPolicy.formatSize(1536L))
+        assertEquals("10.0 KB", AutoBackupPolicy.formatSize(10L * 1024L))
+    }
+
+    @Test
+    fun formatSizeOfMegabytesAndGigabytes() {
+        assertEquals("1.0 MB", AutoBackupPolicy.formatSize(1024L * 1024L))
+        assertEquals("5.0 MB", AutoBackupPolicy.formatSize(5L * 1024L * 1024L))
+        assertEquals("3.0 GB", AutoBackupPolicy.formatSize(3L * 1024L * 1024L * 1024L))
+    }
+
+    @Test
+    fun formatSizeHasNoThousandsSeparatorThatWouldConfuseTheUi() {
+        assertEquals("1023 B", AutoBackupPolicy.formatSize(1023L))
+        assertTrue(AutoBackupPolicy.formatSize(12L * 1024L * 1024L).endsWith(" MB"))
+    }
+
+    // endregion
+
+    // region file names
+
+    @Test
+    fun backupFileNameRoundTrips() {
+        val name = AutoBackupPolicy.backupFileName(20312L, 1_763_000_000_000L)
+        assertEquals("fcitx5-data-20312-1763000000000.zip", name)
+        val parsed = AutoBackupPolicy.parseBackupFileName(name)
+        assertEquals(AutoBackupPolicy.BackupName(20312L, 1_763_000_000_000L), parsed)
+    }
+
+    @Test
+    fun parseRejectsForeignFileNames() {
+        assertNull(AutoBackupPolicy.parseBackupFileName("fcitx5-data-1.zip"))
+        assertNull(AutoBackupPolicy.parseBackupFileName("fcitx5-data-1-2.zip.part"))
+        assertNull(AutoBackupPolicy.parseBackupFileName("fcitx5-data-a-b.zip"))
+        assertNull(AutoBackupPolicy.parseBackupFileName("fcitx5-android_2026-11-14T04:00:00Z.zip"))
+        assertNull(AutoBackupPolicy.parseBackupFileName(""))
+    }
+
+    // endregion
+
+    // region isMeaningfulBackup
+
+    private val defaultPrefs = "org.fcitx.fcitx5.android_preferences.xml"
+    private val ownMarkerPrefs = "auto_backup.xml"
+
+    @Test
+    fun freshInstallIsNotMeaningful() {
+        // no databases and no prefs at all
+        assertFalse(AutoBackupPolicy.isMeaningfulBackup(emptyList(), emptyList(), defaultPrefs))
+        // the default prefs file is written on the first run, so it alone is not data
+        assertFalse(
+            AutoBackupPolicy.isMeaningfulBackup(
+                emptyList(),
+                listOf(defaultPrefs),
+                defaultPrefs
+            )
+        )
+        // a freshly created (almost empty) database is not enough either
+        assertFalse(
+            AutoBackupPolicy.isMeaningfulBackup(
+                listOf(0L, 4_096L, 8_192L),
+                listOf(defaultPrefs),
+                defaultPrefs
+            )
+        )
+    }
+
+    @Test
+    fun ownMarkerPrefsIsNotMeaningful() {
+        assertFalse(
+            AutoBackupPolicy.isMeaningfulBackup(
+                emptyList(),
+                listOf(defaultPrefs, ownMarkerPrefs),
+                defaultPrefs,
+                ignoredSharedPrefsFileNames = setOf(ownMarkerPrefs)
+            )
+        )
+    }
+
+    @Test
+    fun largeDatabaseIsMeaningful() {
+        assertTrue(
+            AutoBackupPolicy.isMeaningfulBackup(
+                listOf(AutoBackupPolicy.MIN_MEANINGFUL_DATABASE_BYTES + 1L),
+                emptyList(),
+                defaultPrefs
+            )
+        )
+        assertTrue(
+            AutoBackupPolicy.isMeaningfulBackup(
+                listOf(0L, 1_024L, 64L * 1024L),
+                emptyList(),
+                defaultPrefs
+            )
+        )
+    }
+
+    @Test
+    fun databaseExactlyAtThresholdIsNotMeaningful() {
+        // "larger than" the threshold, not "at least"
+        assertFalse(
+            AutoBackupPolicy.isMeaningfulBackup(
+                listOf(AutoBackupPolicy.MIN_MEANINGFUL_DATABASE_BYTES),
+                emptyList(),
+                defaultPrefs
+            )
+        )
+    }
+
+    @Test
+    fun nonDefaultSharedPrefsFileIsMeaningful() {
+        assertTrue(
+            AutoBackupPolicy.isMeaningfulBackup(
+                emptyList(),
+                listOf(defaultPrefs, "picker_recently_used.xml"),
+                defaultPrefs
+            )
+        )
+    }
+
+    @Test
+    fun nonXmlFilesInPrefsDirAreIgnored() {
+        assertFalse(
+            AutoBackupPolicy.isMeaningfulBackup(
+                emptyList(),
+                listOf(defaultPrefs, "$ownMarkerPrefs.bak", "some.tmp"),
+                defaultPrefs,
+                ignoredSharedPrefsFileNames = setOf(ownMarkerPrefs)
+            )
+        )
+    }
+
+    // endregion
+}
