diff --git a/app/src/main/res/layout/preference_m3.xml b/app/src/main/res/layout/preference_m3.xml
new file mode 100644
index 00000000..7598a086
--- /dev/null
+++ b/app/src/main/res/layout/preference_m3.xml
@@ -0,0 +1,82 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Material 3 settings row for the preferences hosted by MainActivity.
+
+  A rounded surface-container card (12dp side margins, 4dp vertical margins, 16dp inner
+  padding, 72dp minimum height) with MD3 typography: bodyLarge/onSurface title and
+  bodyMedium/onSurfaceVariant summary. The stock @android:id/title, @android:id/summary
+  and @android:id/widget_frame ids are kept so androidx.preference can bind any
+  Preference subclass (switch, checkbox, list/edit-text dialog preference, ...).
+
+  The ripple comes from @android:attr/selectableItemBackground on the foreground and is
+  clipped to the 16dp corner radius; the card background provides the outline.
+  Selected through ThemeOverlay.Fcitx.Md3.Preference (values/styles_md3.xml).
+-->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:layout_marginStart="12dp"
+    android:layout_marginTop="4dp"
+    android:layout_marginEnd="12dp"
+    android:layout_marginBottom="4dp"
+    android:background="@drawable/bg_md3_preference_card"
+    android:baselineAligned="false"
+    android:clipToOutline="true"
+    android:foreground="?android:attr/selectableItemBackground"
+    android:gravity="center_vertical"
+    android:minHeight="72dp"
+    android:orientation="horizontal"
+    android:paddingStart="16dp"
+    android:paddingTop="12dp"
+    android:paddingEnd="16dp"
+    android:paddingBottom="12dp">
+
+    <LinearLayout
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_weight="1"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@android:id/title"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:ellipsize="end"
+            android:maxLines="2"
+            android:textAppearance="?attr/textAppearanceBodyLarge"
+            android:textColor="?attr/colorOnSurface" />
+
+        <TextView
+            android:id="@android:id/summary"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="2dp"
+            android:ellipsize="end"
+            android:maxLines="3"
+            android:textAppearance="?attr/textAppearanceBodyMedium"
+            android:textColor="?attr/colorOnSurfaceVariant" />
+    </LinearLayout>
+
+    <!--
+      Optional trailing icon (androidx.preference binds android.R.id.icon here when a
+      Preference sets one, e.g. the custom-color dot on the statistics page). It measures
+      0x0 when unset, so it does not indent the other rows.
+    -->
+    <ImageView
+        android:id="@android:id/icon"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:adjustViewBounds="true"
+        android:contentDescription="@null"
+        android:importantForAccessibility="no"
+        android:scaleType="centerInside" />
+
+    <!-- Preference inflates android:widgetLayout (switch / checkbox / ...) in here. -->
+    <LinearLayout
+        android:id="@android:id/widget_frame"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="12dp"
+        android:gravity="end|center_vertical"
+        android:orientation="vertical" />
+</LinearLayout>
