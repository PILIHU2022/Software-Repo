diff --git a/app/src/main/res/values/styles_md3.xml b/app/src/main/res/values/styles_md3.xml
new file mode 100644
index 00000000..8e87a27f
--- /dev/null
+++ b/app/src/main/res/values/styles_md3.xml
@@ -0,0 +1,121 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Material 3 preference styles for the settings UI hosted by MainActivity.
+
+  androidx.preference resolves its widget styles through the theme attribute
+  `preferenceTheme`; PreferenceFragmentCompat applies that overlay to the activity theme in
+  onCreate. Everything here therefore hangs off ThemeOverlay.Fcitx.Md3.Preference, which is
+  referenced from Theme.FcitxAppTheme.Md3 (values/themes.xml, values-night/themes.xml).
+
+  Each custom style keeps the stock `*.Material` behaviour (widgets, dialogs, icon handling)
+  and only swaps the row layout for the MD3 card / header and disables the list dividers.
+  Seekbar and dropdown preference styles are intentionally left untouched: they ship their
+  own complete layouts and would need full replacements to look like cards.
+-->
+<resources>
+
+    <!-- Applied to MainActivity through <item name="preferenceTheme">. -->
+    <style name="ThemeOverlay.Fcitx.Md3.Preference" parent="PreferenceThemeOverlay">
+        <item name="preferenceStyle">@style/Preference.Fcitx.Md3</item>
+        <item name="preferenceCategoryStyle">@style/Preference.Fcitx.Md3.Category</item>
+        <item name="switchPreferenceStyle">@style/Preference.Fcitx.Md3.Switch</item>
+        <item name="switchPreferenceCompatStyle">@style/Preference.Fcitx.Md3.SwitchCompat</item>
+        <item name="dialogPreferenceStyle">@style/Preference.Fcitx.Md3.Dialog</item>
+        <item name="editTextPreferenceStyle">@style/Preference.Fcitx.Md3.EditText</item>
+        <item name="checkBoxPreferenceStyle">@style/Preference.Fcitx.Md3.CheckBox</item>
+        <item name="preferenceFragmentListStyle">@style/PreferenceFragmentList.Fcitx.Md3</item>
+        <item name="preferenceFragmentCompatStyle">@style/PreferenceFragment.Fcitx.Md3</item>
+        <item name="preferenceFragmentStyle">@style/PreferenceFragment.Fcitx.Md3</item>
+    </style>
+
+    <!-- Plain rows (also used by ListPreference / custom DialogPreference subclasses). -->
+    <style name="Preference.Fcitx.Md3" parent="Preference.Material">
+        <item name="android:layout">@layout/preference_m3</item>
+        <item name="allowDividerAbove">false</item>
+        <item name="allowDividerBelow">false</item>
+        <item name="singleLineTitle">false</item>
+        <item name="iconSpaceReserved">false</item>
+    </style>
+
+    <!-- Section headers: label only, no card, no divider. -->
+    <style name="Preference.Fcitx.Md3.Category" parent="Preference.Category.Material">
+        <item name="android:layout">@layout/preference_category_m3</item>
+        <item name="allowDividerAbove">false</item>
+        <item name="allowDividerBelow">false</item>
+        <item name="iconSpaceReserved">false</item>
+    </style>
+
+    <!-- Switch preferences: the widget frame picks up the MD3 SwitchCompat styling. -->
+    <style name="Preference.Fcitx.Md3.Switch" parent="Preference.SwitchPreference.Material">
+        <item name="android:layout">@layout/preference_m3</item>
+        <item name="allowDividerAbove">false</item>
+        <item name="allowDividerBelow">false</item>
+        <item name="singleLineTitle">false</item>
+        <item name="iconSpaceReserved">false</item>
+    </style>
+
+    <style name="Preference.Fcitx.Md3.SwitchCompat" parent="Preference.SwitchPreferenceCompat.Material">
+        <item name="android:layout">@layout/preference_m3</item>
+        <item name="allowDividerAbove">false</item>
+        <item name="allowDividerBelow">false</item>
+        <item name="singleLineTitle">false</item>
+        <item name="iconSpaceReserved">false</item>
+    </style>
+
+    <style name="Preference.Fcitx.Md3.Dialog" parent="Preference.DialogPreference.Material">
+        <item name="android:layout">@layout/preference_m3</item>
+        <item name="allowDividerAbove">false</item>
+        <item name="allowDividerBelow">false</item>
+        <item name="singleLineTitle">false</item>
+        <item name="iconSpaceReserved">false</item>
+    </style>
+
+    <style name="Preference.Fcitx.Md3.EditText" parent="Preference.DialogPreference.EditTextPreference.Material">
+        <item name="android:layout">@layout/preference_m3</item>
+        <item name="allowDividerAbove">false</item>
+        <item name="allowDividerBelow">false</item>
+        <item name="singleLineTitle">false</item>
+        <item name="iconSpaceReserved">false</item>
+    </style>
+
+    <style name="Preference.Fcitx.Md3.CheckBox" parent="Preference.CheckBoxPreference.Material">
+        <item name="android:layout">@layout/preference_m3</item>
+        <item name="allowDividerAbove">false</item>
+        <item name="allowDividerBelow">false</item>
+        <item name="singleLineTitle">false</item>
+        <item name="iconSpaceReserved">false</item>
+    </style>
+
+    <!--
+      RecyclerView style of PreferenceFragmentCompat (preference_recyclerview.xml uses
+      style="?attr/preferenceFragmentListStyle"). Note: that library layout hardcodes
+      android:paddingTop/Bottom="0dp", which wins over a style, so the vertical breathing
+      room comes from the 3dp row margins and the 20dp category padding instead.
+    -->
+    <style name="PreferenceFragmentList.Fcitx.Md3" parent="PreferenceFragmentList.Material">
+        <item name="android:background">?attr/colorSurface</item>
+        <item name="android:clipToPadding">false</item>
+        <item name="android:paddingStart">0dp</item>
+        <item name="android:paddingEnd">0dp</item>
+        <item name="android:paddingLeft">0dp</item>
+        <item name="android:paddingRight">0dp</item>
+        <item name="android:scrollbars">vertical</item>
+    </style>
+
+    <!--
+      PreferenceFragmentCompat reads the item divider from preferenceFragmentCompatStyle.
+      The MD3 rows are separate cards, so the Material list divider is removed entirely.
+    -->
+    <style name="PreferenceFragment.Fcitx.Md3" parent="PreferenceFragment.Material">
+        <item name="android:divider">@null</item>
+        <item name="android:dividerHeight">0dp</item>
+        <item name="allowDividerAfterLastItem">false</item>
+    </style>
+
+    <!--
+      MaterialAlertDialogBuilder only. AppCompat's AlertDialog (used by the preference
+      dialogs and MainActivity) keeps the theme's AppCompat compatible `alertDialogTheme`
+      from the Material 3 base theme on purpose - see the report for why.
+    -->
+    <style name="ThemeOverlay.Fcitx.Md3.Dialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog" />
+</resources>
