+package org.fcitx.fcitx5.android.data.backup
+
+import java.util.Locale
+
+/**
+ * Pure (Android-free) decision helpers behind [AutoBackupManager].
+ *
+ * Everything in here must stay free of Android framework classes so that it can be unit tested
+ * on the JVM, see `AutoBackupPolicyTest`.
+ */
+object AutoBackupPolicy {
+
+    /** How many automatic backups are kept on disk. */
+    const val MAX_BACKUPS = 3
+
+    /** Marker value meaning "no version has ever been backed up". */
+    const val NO_VERSION = -1L
+
+    private const val FILE_PREFIX = "fcitx5-data"
+    private const val FILE_EXTENSION = ".zip"
+
+    private val fileNameRegex =
+        Regex("""^${Regex.escape(FILE_PREFIX)}-(\d+)-(\d+)${Regex.escape(FILE_EXTENSION)}$""")
+
+    /** Parsed parts of an automatic backup file name. */
+    data class BackupName(val versionCode: Long, val timestamp: Long)
+
+    /**
+     * Whether the current app version should trigger a backup.
+     *
+     * Only upgrades (and the first launch after a fresh install, where the marker is [NO_VERSION])
+     * are backed up. Re-launching the same version or downgrading never creates a new backup.
+     */
+    fun shouldBackup(lastBackedUpVersion: Long, currentVersion: Long): Boolean =
+        currentVersion > lastBackedUpVersion
+
+    /**
+     * @param sortedNewestFirst backup file names, newest first
+     * @param keep number of newest backups to retain
+     * @return names that should be deleted, oldest first
+     */
+    fun filesToPrune(sortedNewestFirst: List<String>, keep: Int): List<String> {
+        val effectiveKeep = keep.coerceAtLeast(0)
+        if (sortedNewestFirst.size <= effectiveKeep) return emptyList()
+        return sortedNewestFirst.subList(effectiveKeep, sortedNewestFirst.size).toList()
+    }
+
+    /**
+     * Human readable file size, e.g. `0 B`, `512 B`, `1.5 KB`, `12.0 MB`.
+     * Locale independent so that it is stable in tests and predictable in the UI summary.
+     */
+    fun formatSize(bytes: Long): String {
+        if (bytes <= 0L) return "0 B"
+        val units = arrayOf("B", "KB", "MB", "GB", "TB")
+        var value = bytes.toDouble()
+        var unit = 0
+        while (value >= 1024.0 && unit < units.lastIndex) {
+            value /= 1024.0
+            unit++
+        }
+        return if (unit == 0) {
+            "$bytes ${units[0]}"
+        } else {
+            String.format(Locale.ROOT, "%.1f %s", value, units[unit])
+        }
+    }
+
+    /** Automatic backups are skipped on a fresh install; a database file above this is data. */
+    const val MIN_MEANINGFUL_DATABASE_BYTES = 8L * 1024L
+
+    private const val PREFS_FILE_SUFFIX = ".xml"
+
+    /**
+     * A backup is only worth creating when there is real user state to protect:
+     *
+     * - at least one non-empty database file larger than [MIN_MEANINGFUL_DATABASE_BYTES]
+     *   (clipboard history or typing statistics; an essentially empty ClipboardDatabase is
+     *   usually smaller than that), or
+     * - a shared preferences file other than the app's default preferences file (e.g. recently
+     *   used picker items). The default preferences file always exists after the first run, so
+     *   it alone says nothing. Our own marker file must be passed in
+     *   [ignoredSharedPrefsFileNames].
+     *
+     * This is deliberately conservative: it is fine to skip a backup on a brand-new install.
+     *
+     * Pure function so that the heuristic can be tested on the JVM.
+     */
+    fun isMeaningfulBackup(
+        databaseFileSizes: List<Long>,
+        sharedPrefsFileNames: List<String>,
+        defaultSharedPrefsFileName: String,
+        ignoredSharedPrefsFileNames: Set<String> = emptySet()
+    ): Boolean {
+        if (databaseFileSizes.any { it > MIN_MEANINGFUL_DATABASE_BYTES }) return true
+        return sharedPrefsFileNames.any { name ->
+            name.endsWith(PREFS_FILE_SUFFIX) &&
+                    name != defaultSharedPrefsFileName &&
+                    name !in ignoredSharedPrefsFileNames
+        }
+    }
+
+    /** File name used for automatic backups, e.g. `fcitx5-data-20312-1763000000000.zip`. */
+    fun backupFileName(versionCode: Long, timestamp: Long): String =
+        "$FILE_PREFIX-$versionCode-$timestamp$FILE_EXTENSION"
+
+    /** @return parsed [BackupName] or `null` if [name] is not an automatic backup file name. */
+    fun parseBackupFileName(name: String): BackupName? {
+        val match = fileNameRegex.matchEntire(name) ?: return null
+        val versionCode = match.groupValues[1].toLongOrNull() ?: return null
+        val timestamp = match.groupValues[2].toLongOrNull() ?: return null
+        return BackupName(versionCode, timestamp)
+    }
+}
