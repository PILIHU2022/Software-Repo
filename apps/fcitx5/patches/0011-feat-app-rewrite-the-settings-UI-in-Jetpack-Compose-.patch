+@Composable
+private fun AddonListContent(
+    padding: PaddingValues,
+    addons: List<AddonInfo>,
+    onOpen: (AddonInfo) -> Unit,
+    onToggle: (AddonInfo, Boolean) -> Unit,
+) {
+    val groups = remember(addons) { addons.groupedByCategory() }
+    LazyColumn(
+        modifier = Modifier
+            .fillMaxSize()
+            .padding(padding),
+        contentPadding = PaddingValues(start = 16.dp, end = 16.dp, top = 4.dp, bottom = 32.dp),
+    ) {
+        groups.forEach { (category, entries) ->
+            item(key = "section-" + category.name) {
+                SectionLabel(category.sectionTitle())
+            }
+            items(entries, key = { it.uniqueName }) { addon ->
+                AddonRow(addon, onOpen, onToggle)
+            }
+        }
+        if (addons.isEmpty()) {
+            item { EmptyStateCard(stringResource(R.string._not_available_)) }
+        }
+    }
+}
