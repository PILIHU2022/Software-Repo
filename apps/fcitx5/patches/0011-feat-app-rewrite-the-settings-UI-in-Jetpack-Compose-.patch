+/**
+ * Persists the enabled input method order. [SubtypeManager.syncWith] is refreshed on
+ * Android 14+ exactly like the legacy fragment does.
+ */
+private fun FcitxConnection.persistEnabledIme(names: Array<String>) {
+    launchOnReady { fcitx ->
+        try {
+            fcitx.setEnabledIme(names)
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+                SubtypeManager.syncWith(fcitx.enabledIme())
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Timber.w(e, "Failed to persist enabled input methods")
+        }
+    }
+}
