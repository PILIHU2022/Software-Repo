+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun PalettePickerSheet(
+    current: HeatmapPalette,
+    customColor: Int,
+    isDark: Boolean,
+    onSelect: (HeatmapPalette) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    ModalBottomSheet(
+        onDismissRequest = onDismiss,
+    ) {
+        Column(modifier = Modifier.padding(start = 8.dp, end = 8.dp, bottom = 28.dp)) {
+            Text(
+                text = stringResource(R.string.stats_ui_palette),
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.Bold,
+                modifier = Modifier.padding(start = 16.dp, end = 16.dp, bottom = 8.dp),
+            )
+            HeatmapPalette.entries.forEach { entry ->
+                val entryColors = remember(entry, customColor, isDark) {
+                    entry.colors(customColor, isDark)
+                }
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clickable { onSelect(entry) }
+                        .padding(start = 16.dp, end = 20.dp, top = 6.dp, bottom = 6.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    RadioButton(
+                        selected = entry == current,
+                        onClick = { onSelect(entry) },
+                    )
+                    Text(
+                        text = stringResource(entry.stringRes),
+                        style = MaterialTheme.typography.bodyLarge,
+                        modifier = Modifier.weight(1f),
+                    )
+                    PaletteSwatches(entryColors, swatchSize = 12.dp)
+                }
+            }
+        }
+    }
+}
+
+/** The five live palette shades, rendered like the heatmap legend on the home page card. */
+@Composable
+private fun PaletteSwatches(colors: IntArray, swatchSize: Dp = 12.dp) {
+    Row(verticalAlignment = Alignment.CenterVertically) {
+        colors.forEachIndexed { index, color ->
+            if (index > 0) Spacer(Modifier.width(3.dp))
+            Box(
+                modifier = Modifier
+                    .size(swatchSize)
+                    .background(
+                        Color(colors.getOrElse(index) { colors.first() }),
+                        RoundedCornerShape(3.dp),
+                    ),
+            )
+        }
+    }
+}
+
+/** A small filled circle for the custom color row, standing in for the legacy color-dot icon. */
+@Composable
+private fun ColorDot(color: Color) {
+    val outline = MaterialTheme.colorScheme.outlineVariant
+    Box(
+        modifier = Modifier
+            .size(22.dp)
+            .border(1.dp, outline, CircleShape)
+            .padding(2.dp)
