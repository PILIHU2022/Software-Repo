+ * SPDX-FileCopyrightText: Copyright 2021-2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.ui.main.compose
+
+import androidx.activity.compose.BackHandler
+import androidx.compose.animation.AnimatedContent
+import androidx.compose.animation.fadeIn
+import androidx.compose.animation.fadeOut
+import androidx.compose.animation.slideInHorizontally
+import androidx.compose.animation.slideOutHorizontally
+import androidx.compose.animation.togetherWith
+import androidx.compose.material3.ExperimentalMaterial3ExpressiveApi
+import androidx.compose.material3.MotionScheme
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.remember
+import androidx.compose.ui.unit.IntOffset
+import org.fcitx.fcitx5.android.ui.main.compose.home.HomeScreen
+import org.fcitx.fcitx5.android.ui.main.compose.screens.AddonListScreen
+import org.fcitx.fcitx5.android.ui.main.compose.screens.InfoScreen
+import org.fcitx.fcitx5.android.ui.main.compose.screens.InputMethodListScreen
+import org.fcitx.fcitx5.android.ui.main.compose.screens.PreferenceSettingsScreen
+import org.fcitx.fcitx5.android.ui.main.compose.screens.RawConfigSettingsScreen
+import org.fcitx.fcitx5.android.ui.main.compose.screens.StatsScreen
+import org.fcitx.fcitx5.android.ui.main.compose.screens.UnmigratedScreen
+
+@OptIn(ExperimentalMaterial3ExpressiveApi::class)
+@Composable
+fun SettingsApp(onOpenNativeRoute: (String) -> Unit) {
+    val navigator = remember { SettingsNavigator(onOpenNativeRoute) }
+    val motion = MotionScheme.expressive()
+
+    BackHandler(enabled = navigator.stack.size > 1) {
+        navigator.back()
+    }
+
+    CompositionLocalProvider(LocalSettingsNavigator provides navigator) {
+        AnimatedContent(
+            targetState = navigator.currentRoute,
+            transitionSpec = {
+                // Directional transitions: pushing slides the new page in from the right and
+                // the old one out to the left; popping (back gesture / back arrow) plays the
+                // reverse — the deeper page returns toward the right edge where the swipe
+                // started, while the previous page is revealed from the left.
+                val spatial = motion.defaultSpatialSpec<IntOffset>()
+                val effects = motion.defaultEffectsSpec<Float>()
+                if (navigator.lastDirection == NavDirection.Forward) {
+                    (slideInHorizontally(
+                        animationSpec = spatial,
+                        initialOffsetX = { it / 6 },
+                    ) + fadeIn(animationSpec = effects))
+                        .togetherWith(
+                            slideOutHorizontally(
+                                animationSpec = spatial,
+                                targetOffsetX = { -it / 8 },
+                            ) + fadeOut(animationSpec = effects)
+                        )
+                } else {
+                    (slideInHorizontally(
+                        animationSpec = spatial,
+                        initialOffsetX = { -it / 6 },
+                    ) + fadeIn(animationSpec = effects))
+                        .togetherWith(
+                            slideOutHorizontally(
+                                animationSpec = spatial,
+                                targetOffsetX = { it / 4 },
+                            ) + fadeOut(animationSpec = effects)
+                        )
+                }
+            },
+            label = "settings-page",
+        ) { route ->
+            SettingsDestination(route)
+        }
+    }
+}
+
+@Composable
+private fun SettingsDestination(route: String) {
+    when {
+        route == SettingsRoutes.HOME -> HomeScreen()
+
+        route == SettingsRoutes.VIRTUAL_KEYBOARD ||
+                route == SettingsRoutes.CANDIDATES ||
+                route == SettingsRoutes.CLIPBOARD ||
+                route == SettingsRoutes.SYMBOL ||
+                route == SettingsRoutes.ADVANCED -> PreferenceSettingsScreen(route)
+
+        route == SettingsRoutes.GLOBAL ||
+                route.startsWith("addon/") ||
+                route.startsWith("im/") -> RawConfigSettingsScreen(route)
+
+        route == SettingsRoutes.IM_LIST -> InputMethodListScreen()
+        route == SettingsRoutes.ADDON_LIST -> AddonListScreen()
+
+        route == SettingsRoutes.ABOUT ||
+                route == SettingsRoutes.LICENSE ||
+                route == SettingsRoutes.DEVELOPER ||
+                route == SettingsRoutes.PLUGIN -> InfoScreen(route)
+
+        route == SettingsRoutes.STATS -> StatsScreen()
+
+        else -> UnmigratedScreen(route)
+    }
+}
