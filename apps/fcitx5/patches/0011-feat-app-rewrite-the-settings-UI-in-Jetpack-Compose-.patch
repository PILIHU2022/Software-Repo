+/**
+ * The 53-week grid inside a horizontally scrollable viewport, plus the "no data" hint and the
+ * tapped-day tooltip bubble.
+ */
+@Composable
+private fun HeatmapGrid(
+    levels: Map<LocalDate, Int>,
+    counts: Map<LocalDate, Long>,
+    colors: IntArray,
+    today: LocalDate,
+    hasData: Boolean,
+    onOpenStats: () -> Unit,
+) {
+    val scrollState = rememberScrollState()
+    var selectedDay by remember { mutableStateOf<LocalDate?>(null) }
+    var viewportSize by remember { mutableStateOf(IntSize.Zero) }
+
+    // Hide the tooltip as soon as the grid scrolls (the legacy bubble dismisses on scroll).
+    LaunchedEffect(scrollState) {
+        snapshotFlow { scrollState.value }.drop(1).collect { selectedDay = null }
+    }
+    // Start on the newest week, mirroring the legacy scrollToRecentPending behavior.
+    LaunchedEffect(scrollState.maxValue) {
+        if (scrollState.maxValue > 0) scrollState.scrollTo(scrollState.maxValue)
+    }
+
+    val density = LocalDensity.current
+    val labelColor = MaterialTheme.colorScheme.onSurfaceVariant
+    val locale = Locale.getDefault()
+    val shortMonths = remember(locale) { DateFormatSymbols.getInstance(locale).shortMonths }
+    // Rows are Monday-first; Calendar indexes 1 = Sunday .. 7 = Saturday, so Monday is 2.
+    val weekdayLabels = remember(locale) {
+        WEEKDAY_ROWS.map { DateFormatSymbols.getInstance(locale).shortWeekdays[it + 2] }
+    }
+    val labelStyle = remember(labelColor) { TextStyle(fontSize = 10.sp, color = labelColor) }
+    val textMeasurer = rememberTextMeasurer()
+    val labelLayouts = remember(weekdayLabels, labelStyle) {
+        weekdayLabels.map { textMeasurer.measure(it, labelStyle) }
+    }
+    val monthLayouts = remember(shortMonths, labelStyle) {
+        shortMonths.map { textMeasurer.measure(it, labelStyle) }
+    }
+
+    val cellPx = with(density) { 11.dp.toPx() }
+    val gapPx = with(density) { 3.dp.toPx() }
+    val stepPx = cellPx + gapPx
+    val cellRadiusPx = with(density) { 2.5.dp.toPx() }
+    val labelGapPx = with(density) { 6.dp.toPx() }
+    val todayStrokePx = with(density) { 1.4.dp.toPx() }
+    val monthLabelTopPx = with(density) { 1.dp.toPx() }
+    val monthLabelHeightPx = with(density) {
+        (labelLayouts.maxOf { it.size.height } + 4.dp.roundToPx()).toFloat()
+    }
+    val labelWidthPx = labelLayouts.maxOf { it.size.width }.toFloat()
+    val gridLeftPx = labelWidthPx + labelGapPx
+    val gridTopPx = monthLabelHeightPx
+    val gridWidthPx = gridLeftPx + WEEKS * cellPx + (WEEKS - 1) * gapPx
+    val gridHeightPx = gridTopPx + DAYS_PER_WEEK * cellPx + (DAYS_PER_WEEK - 1) * gapPx
+    val firstMonday = remember(today) { firstMonday(today) }
+
+    Box(
+        modifier = Modifier
+            .fillMaxWidth()
+            .onSizeChanged { viewportSize = it },
+    ) {
+        Box(modifier = Modifier.horizontalScroll(scrollState)) {
+            Canvas(
+                modifier = Modifier
+                    .size(
+                        with(density) { gridWidthPx.toDp() },
+                        with(density) { gridHeightPx.toDp() },
+                    )
+                    .pointerInput(levels, today, gridLeftPx, gridTopPx, stepPx) {
+                        detectTapGestures { offset ->
+                            val week = ((offset.x - gridLeftPx) / stepPx).toInt()
+                            val row = ((offset.y - gridTopPx) / stepPx).toInt()
+                            if (week in 0 until WEEKS && row in 0 until DAYS_PER_WEEK) {
+                                val date = firstMonday
+                                    .plusWeeks(week.toLong())
+                                    .plusDays(row.toLong())
+                                if (!date.isAfter(today)) {
+                                    // A cell tap shows the tooltip and never opens the stats page.
+                                    selectedDay = date
+                                    return@detectTapGestures
+                                }
+                            }
+                            // Taps on the label gutter (or past the last week) behave like a card
+                            // click and open the statistics screen, as in the legacy view.
+                            onOpenStats()
+                        }
+                    },
+            ) {
+                drawCells(
+                    levels, colors, today, firstMonday,
+                    gridLeftPx, gridTopPx, cellPx, stepPx, cellRadiusPx, todayStrokePx,
+                )
+                drawMonthLabels(
+                    shortMonths, monthLayouts, today, firstMonday,
+                    gridLeftPx, monthLabelTopPx, stepPx, labelGapPx,
+                )
+                drawWeekdayLabels(
+                    labelLayouts, gridLeftPx, gridTopPx, cellPx, stepPx, labelGapPx,
+                )
+            }
+        }
+        if (!hasData) {
+            // Centered on the visible part of the grid, like the legacy no-data hint.
+            Text(
+                text = stringResource(R.string.heatmap_no_data),
+                style = MaterialTheme.typography.bodySmall,
+                color = labelColor,
+                modifier = Modifier
+                    .align(Alignment.Center)
+                    .background(Color(colors[0]), RoundedCornerShape(9.dp))
+                    .padding(horizontal = 12.dp, vertical = 5.dp),
+            )
+        }
+        selectedDay?.let { day ->
+            DayTooltip(
+                day = day,
+                count = counts[day] ?: 0L,
+                firstMonday = firstMonday,
+                cellPx = cellPx,
+                gapPx = gapPx,
+                gridLeftPx = gridLeftPx,
+                gridTopPx = gridTopPx,
+                scrollOffsetPx = scrollState.value.toFloat(),
+                viewportWidthPx = viewportSize.width,
+                onDismiss = { selectedDay = null },
+            )
+        }
+    }
+}
+
+private fun DrawScope.drawCells(
+    levels: Map<LocalDate, Int>,
+    colors: IntArray,
+    today: LocalDate,
+    firstMonday: LocalDate,
+    gridLeftPx: Float,
+    gridTopPx: Float,
+    cellPx: Float,
+    stepPx: Float,
+    cellRadiusPx: Float,
+    todayStrokePx: Float,
+) {
+    val maxLevel = colors.size - 1
+    for (week in 0 until WEEKS) {
+        val monday = firstMonday.plusWeeks(week.toLong())
+        if (monday.isAfter(today)) break
+        val x = gridLeftPx + week * stepPx
+        for (row in 0 until DAYS_PER_WEEK) {
+            val date = monday.plusDays(row.toLong())
+            // Future days of the current week stay empty so the grid keeps a rectangular
+            // silhouette, exactly like the legacy view.
+            val level = if (date.isAfter(today)) {
+                0
+            } else {
+                (levels[date] ?: 0).coerceIn(0, maxLevel)
+            }
+            val y = gridTopPx + row * stepPx
+            drawRoundRect(
+                color = Color(colors[level]),
+                topLeft = Offset(x, y),
+                size = Size(cellPx, cellPx),
+                cornerRadius = CornerRadius(cellRadiusPx),
+            )
+        }
+    }
+    // Outline around today's cell, matching the legacy accent stroke.
+    val thisMonday = today.with(TemporalAdjusters.previousOrSame(DayOfWeek.MONDAY))
+    val week = ChronoUnit.WEEKS.between(firstMonday, thisMonday).toInt()
+    val row = today.dayOfWeek.value - 1
+    if (week in 0 until WEEKS && row in 0 until DAYS_PER_WEEK) {
+        val x = gridLeftPx + week * stepPx
+        val y = gridTopPx + row * stepPx
+        drawRoundRect(
+            color = Color((colors[maxLevel] and 0x00FFFFFF) or 0xCC000000.toInt()),
+            topLeft = Offset(x, y),
+            size = Size(cellPx, cellPx),
+            cornerRadius = CornerRadius(cellRadiusPx),
+            style = Stroke(width = todayStrokePx),
+        )
+    }
+}
+
+private fun DrawScope.drawMonthLabels(
+    shortMonths: Array<String>,
+    monthLayouts: List<TextLayoutResult>,
+    today: LocalDate,
+    firstMonday: LocalDate,
+    gridLeftPx: Float,
+    monthLabelTopPx: Float,
+    stepPx: Float,
+    labelGapPx: Float,
+) {
+    var lastRight = Float.NEGATIVE_INFINITY
+    var lastMonth = -1
+    for (week in 0 until WEEKS) {
+        val monday = firstMonday.plusWeeks(week.toLong())
+        if (monday.isAfter(today)) break
+        if (monday.monthValue == lastMonth) continue
+        lastMonth = monday.monthValue
+        if (shortMonths.getOrNull(monday.monthValue - 1).isNullOrEmpty()) continue
+        val layout = monthLayouts.getOrNull(monday.monthValue - 1) ?: continue
+        val x = gridLeftPx + week * stepPx
+        // Never overlap the previous month label.
+        if (x < lastRight + labelGapPx) continue
+        drawText(layout, topLeft = Offset(x, monthLabelTopPx))
+        lastRight = x + layout.size.width
+    }
+}
+
+private fun DrawScope.drawWeekdayLabels(
+    labelLayouts: List<TextLayoutResult>,
+    gridLeftPx: Float,
+    gridTopPx: Float,
+    cellPx: Float,
+    stepPx: Float,
+    labelGapPx: Float,
+) {
+    WEEKDAY_ROWS.forEachIndexed { index, row ->
+        val layout = labelLayouts.getOrNull(index) ?: return@forEachIndexed
+        val centerY = gridTopPx + row * stepPx + cellPx / 2f
+        drawText(
+            layout,
+            topLeft = Offset(
+                gridLeftPx - labelGapPx - layout.size.width,
+                centerY - layout.size.height / 2f,
+            ),
+        )
+    }
+}
+
+/**
+ * GitHub-style bubble for the tapped day. It prefers the space above the cell (like the legacy
+ * bubble) and falls below it when the top of the window leaves no room; it is dismissed on
+ * scroll, and by tapping the bubble itself.
+ *
+ * Styling and geometry deliberately mirror the legacy [org.fcitx.fcitx5.android.ui.main.heatmap.HeatmapTooltipView]:
+ * a theme-independent near-black bubble (`heatmap_tooltip_background` / `_foreground`, like
+ * GitHub's tooltip in light *and* dark mode), 8dp corners and a 12x6dp notch on the edge facing
+ * the tapped cell. The notch tracks the tapped cell in bubble-local coordinates and is clamped
+ * so it keeps pointing at the cell even when the bubble itself is clamped to the screen edge —
+ * including cells in the first/last grid columns.
+ */
+@Composable
+private fun DayTooltip(
+    day: LocalDate,
+    count: Long,
+    firstMonday: LocalDate,
+    cellPx: Float,
+    gapPx: Float,
+    gridLeftPx: Float,
+    gridTopPx: Float,
+    scrollOffsetPx: Float,
+    viewportWidthPx: Int,
+    onDismiss: () -> Unit,
+) {
+    val context = LocalContext.current
+    val density = LocalDensity.current
+    var popupSize by remember { mutableStateOf(IntSize.Zero) }
+
+    val stepPx = cellPx + gapPx
+    val monday = day.with(TemporalAdjusters.previousOrSame(DayOfWeek.MONDAY))
+    val week = ChronoUnit.WEEKS.between(firstMonday, monday).toInt()
+    val row = day.dayOfWeek.value - 1
+    if (week !in 0 until WEEKS || row !in 0 until DAYS_PER_WEEK) return
+
+    val marginPx = with(density) { 8.dp.roundToPx() }
+    val arrowGapPx = with(density) { 2.dp.roundToPx() }
+    val cornerRadiusPx = with(density) { 8.dp.toPx() }
+    val arrowWidthPx = with(density) { 12.dp.toPx() }
+    val arrowHeightPx = with(density) { 6.dp.toPx() }
+    val configuration = LocalConfiguration.current
+    val windowHeightPx = with(density) { configuration.screenHeightDp.dp.toPx() }
+    val cellCenterX = gridLeftPx + week * stepPx + cellPx / 2f - scrollOffsetPx
+    val cellTopPx = gridTopPx + row * stepPx
+    val cellBottomPx = cellTopPx + cellPx
+
+    // The bubble stays fully inside the heatmap (the grid viewport): its left/right edges never
+    // leave the grid bounds. No horizontal margin is kept — edge cells sit flush against the
+    // viewport edge, so any inset would push the bubble off the cell and put the notch out of
+    // reach (it can only travel inside the bubble).
+    val x = (cellCenterX.roundToInt() - popupSize.width / 2).coerceIn(
+        0,
+        (viewportWidthPx - popupSize.width).coerceAtLeast(0),
+    )
+
+    // Prefer above the cell (notch on the bubble's bottom edge, tip 2dp above the cell); when
+    // there is no room at the top, flip below the cell instead (notch on the top edge).
+    val above = (cellTopPx - arrowGapPx - popupSize.height) >= marginPx
+    val y = if (above) {
+        (cellTopPx - arrowGapPx - popupSize.height).roundToInt()
+    } else {
+        (cellBottomPx.roundToInt() + arrowGapPx)
+            .coerceAtMost((windowHeightPx - marginPx - popupSize.height).roundToInt())
+            .coerceAtLeast(marginPx)
+    }
+    // The notch tracks the tapped cell in bubble-local pixels. It only keeps its own half
+    // width (plus 2dp) inside the bubble — the rounded corner on that side is shrunk in
+    // BubbleShape so the notch always sits exactly over the tapped cell, including the first
+    // and last columns where the bubble has to be clamped against the grid edge.
+    val arrowHalfPx = arrowWidthPx / 2f
+    val arrowCenterXPx = if (popupSize.width == 0) {
+        null
+    } else {
+        (cellCenterX - x).coerceIn(
+            arrowHalfPx,
+            (popupSize.width - arrowHalfPx).coerceAtLeast(arrowHalfPx),
+        )
+    }
+
+
+    // Rendered as an overlay child of the grid Box (not a Popup): it shares the exact local
+    // coordinate space the cells are drawn in, so the notch always lands on the tapped cell.
+    val shape = remember(arrowCenterXPx, above, popupSize.height) {
+        BubbleShape(
+            cornerRadiusPx = cornerRadiusPx,
+            arrowWidthPx = arrowWidthPx,
+            arrowHeightPx = arrowHeightPx,
+            arrowCenterXPx = arrowCenterXPx,
+            arrowOnTop = !above,
+        )
+    }
+    Column(
+        modifier = Modifier
+            .absoluteOffset { IntOffset(x, y) }
+            // Tap the bubble itself to dismiss; scrolling and picking another day re-place it.
+            .pointerInput(Unit) { detectTapGestures { onDismiss() } },
+    ) {
+        Surface(
+            shape = shape,
+            color = colorResource(R.color.heatmap_tooltip_background),
+            shadowElevation = 3.dp,
+            // Measure the Surface itself: it is the bubble (text + padding + notch strip). The
+            // Text is smaller than the bubble, and using its size would shift the bubble and
+            // the notch off the tapped cell.
+            modifier = Modifier.onSizeChanged { popupSize = it },
+        ) {
+            Text(
+                text = dayTooltipText(context, day, count),
+                style = MaterialTheme.typography.labelMedium.copy(fontSize = 12.5.sp),
+                color = colorResource(R.color.heatmap_tooltip_foreground),
+                textAlign = TextAlign.Center,
+                modifier = Modifier
+                    .padding(
+                        start = 10.dp,
+                        end = 10.dp,
+                        // Extra room on the notch side: the shape spends the arrow height on
+                        // the bubble edge facing the cell.
+                        top = if (above) 6.dp else (6.dp + 6.dp),
+                        bottom = if (above) (6.dp + 6.dp) else 6.dp,
+                    ),
+            )
+        }
+    }
+}
+
+/**
+ * Rounded bubble with a triangular notch on the edge facing the tapped cell. The notch lives
+ * inside the layout bounds: the bubble rect stops [arrowHeightPx] short of the notch edge, and
+ * the triangle spans the remaining strip, so Compose clips/shadows exactly the silhouette the
+ * legacy view painted.
+ */
+private class BubbleShape(
+    private val cornerRadiusPx: Float,
+    private val arrowWidthPx: Float,
+    private val arrowHeightPx: Float,
+    /** Notch center in bubble-local pixels, or `null` to center it on the bubble. */
+    private val arrowCenterXPx: Float?,
+    /** `true`: notch on the top edge (bubble below the cell); `false`: bottom edge. */
+    private val arrowOnTop: Boolean,
+) : Shape {
+
+    override fun createOutline(size: Size, layoutDirection: LayoutDirection, density: Density): Outline {
+        val path = Path()
+        val rectHeight = size.height - arrowHeightPx
+        val rectTop = if (arrowOnTop) arrowHeightPx else 0f
+        val halfArrow = arrowWidthPx / 2f
+        // Notch center, kept fully inside the bubble's horizontal extent.
+        val notchX = (arrowCenterXPx ?: size.width / 2f)
+            .coerceIn(halfArrow, (size.width - halfArrow).coerceAtLeast(halfArrow))
+        // If the notch reaches into a corner, shrink that corner to where the notch base begins
+        // so the triangle sits flush on the bubble outline instead of floating past a rounded
+        // corner. Corners the notch does not touch keep the normal radius.
+        val leftCorner = minOf(cornerRadiusPx, (notchX - halfArrow).coerceAtLeast(0f))
+        val rightCorner = minOf(cornerRadiusPx, (size.width - notchX - halfArrow).coerceAtLeast(0f))
+        path.addRoundRect(
+            RoundRect(
+                left = 0f,
+                top = rectTop,
+                right = size.width,
+                bottom = rectTop + rectHeight,
+                topLeftCornerRadius = CornerRadius(leftCorner),
+                topRightCornerRadius = CornerRadius(rightCorner),
+                bottomRightCornerRadius = CornerRadius(rightCorner),
+                bottomLeftCornerRadius = CornerRadius(leftCorner),
+            )
+        )
+        val centerX = notchX
+        val tipY = if (arrowOnTop) 0f else size.height
+        val baseY = if (arrowOnTop) arrowHeightPx else rectHeight
+        path.moveTo(centerX - arrowWidthPx / 2f, baseY)
+        path.lineTo(centerX + arrowWidthPx / 2f, baseY)
+        path.lineTo(centerX, tipY)
+        path.close()
+        return Outline.Generic(path)
+    }
+}
