+/**
+ * Home page card that shows the real typing heatmap, the headline metrics and the legend.
+ *
+ * The Compose counterpart of [org.fcitx.fcitx5.android.ui.main.heatmap.TypingHeatmapPreference]:
+ * it feeds on the same [TypingStatsManager.snapshot], observes the same [AppPrefs] palette /
+ * custom color / enabled preferences and renders the same 53-week grid semantics as
+ * [org.fcitx.fcitx5.android.ui.main.heatmap.ContributionHeatmapView] (Monday-first rows, month
+ * labels above, weekday labels, today outline, tap tooltip, scrolled to the newest week).
+ */
+@Composable
+fun HeatmapCard(onClick: () -> Unit) {
+    val context = LocalContext.current
+    val scheme = MaterialTheme.colorScheme
+
+    // Idempotent: TypingStatsManager.init uses a double-checked lock; refresh() reloads Room.
+    LaunchedEffect(Unit) {
+        TypingStatsManager.init(context)
+        TypingStatsManager.refresh()
+    }
+    val snapshot by TypingStatsManager.snapshot.collectAsStateWithLifecycle()
+
+    // Mirror TypingHeatmapPreference: observe the palette / custom color / enabled preferences
+    // and hold their values as Compose state so color and pause changes re-render live.
+    val appPrefs = remember { runCatching { AppPrefs.getInstance() }.getOrNull() }
+    var paletteRaw by remember {
+        mutableStateOf(
+            appPrefs?.stats?.palette?.getValue() ?: HeatmapPalette.Github.storageKey
+        )
+    }
+    var customColor by remember {
+        mutableIntStateOf(appPrefs?.stats?.customColor?.getValue() ?: DEFAULT_CUSTOM_COLOR)
+    }
+    var trackingEnabled by remember {
+        mutableStateOf(appPrefs?.stats?.enabled?.getValue() ?: true)
+    }
+
+    DisposableEffect(appPrefs) {
+        val stats = appPrefs?.stats
+        val paletteListener =
+            ManagedPreference.OnChangeListener<String> { _, value -> paletteRaw = value }
+        val customColorListener =
+            ManagedPreference.OnChangeListener<Int> { _, value -> customColor = value }
+        val enabledListener =
+            ManagedPreference.OnChangeListener<Boolean> { _, value -> trackingEnabled = value }
+        stats?.palette?.registerOnChangeListener(paletteListener)
+        stats?.customColor?.registerOnChangeListener(customColorListener)
+        stats?.enabled?.registerOnChangeListener(enabledListener)
+        onDispose {
+            stats?.palette?.unregisterOnChangeListener(paletteListener)
+            stats?.customColor?.unregisterOnChangeListener(customColorListener)
+            stats?.enabled?.unregisterOnChangeListener(enabledListener)
+        }
+    }
+
+    // The legacy card keys off the system dark mode (Configuration.isDarkMode), and so does the
+    // Compose settings theme (FcitxSettingsTheme defaults to isSystemInDarkTheme()).
+    val isDark = isSystemInDarkTheme()
+    val palette = remember(paletteRaw) { HeatmapPalette.fromStorage(paletteRaw) }
+    val colors = remember(palette, customColor, isDark) { palette.colors(customColor, isDark) }
+
+    val counts = remember(snapshot) { snapshot.countsByDate() }
+    val levels = remember(counts) {
+        if (counts.isEmpty()) emptyMap() else TypingStatsMath.heatmapLevels(counts)
+    }
+    val hasData = counts.values.any { it > 0L }
+    val today = snapshot.today
+
+    Card(
+        onClick = onClick,
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(top = 8.dp),
+        shape = RoundedCornerShape(28.dp),
+        colors = CardDefaults.cardColors(containerColor = scheme.surfaceContainerHigh),
+    ) {
+        Column(modifier = Modifier.padding(20.dp)) {
+            // Expressive header: icon, title, live summary, compact total pill.
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Box(
+                    modifier = Modifier
+                        .size(40.dp)
+                        .background(
+                            color = scheme.primary,
+                            shape = RoundedCornerShape(12.dp),
+                        ),
+                    contentAlignment = Alignment.Center,
+                ) {
+                    Icon(
+                        Icons.Rounded.LocalFireDepartment,
+                        contentDescription = null,
+                        tint = scheme.onPrimary,
+                    )
+                }
+                Spacer(Modifier.width(12.dp))
+                Column(modifier = Modifier.weight(1f)) {
+                    Text(
+                        text = stringResource(R.string.home_stats_title),
+                        style = MaterialTheme.typography.titleMedium,
+                        fontWeight = FontWeight.Bold,
+                    )
+                    Text(
+                        text = summaryText(context, snapshot),
+                        style = MaterialTheme.typography.bodySmall,
+                        color = scheme.onSurfaceVariant,
+                    )
+                }
+                Box(
+                    modifier = Modifier
+                        .background(
+                            color = scheme.tertiaryContainer,
+                            shape = RoundedCornerShape(999.dp),
+                        )
+                        .padding(horizontal = 12.dp, vertical = 6.dp),
+                ) {
+                    Text(
+                        text = formatCountCompact(snapshot.totalCharacters),
+                        style = MaterialTheme.typography.labelMedium,
+                        color = scheme.onTertiaryContainer,
+                        fontWeight = FontWeight.Bold,
+                    )
+                }
+            }
+
+            if (!trackingEnabled) {
+                Spacer(Modifier.height(8.dp))
+                Text(
+                    text = stringResource(R.string.heatmap_stats_paused),
+                    style = MaterialTheme.typography.labelSmall,
+                    color = scheme.onSurfaceVariant,
+                    modifier = Modifier
+                        .background(scheme.surfaceContainerHighest, RoundedCornerShape(12.dp))
+                        .padding(horizontal = 10.dp, vertical = 4.dp),
+                )
+            }
+
+            Spacer(Modifier.height(12.dp))
+            MetricRow(context, snapshot)
+            Spacer(Modifier.height(12.dp))
+            HeatmapGrid(levels, counts, colors, today, hasData, onClick)
+            Spacer(Modifier.height(10.dp))
+            LegendRow(colors)
+        }
+    }
+}
