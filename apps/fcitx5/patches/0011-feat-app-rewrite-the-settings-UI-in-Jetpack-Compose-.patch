+/**
+ * Snapshot of the input method state, plus the ordered list of enabled unique names.
+ *
+ * Ordering mirrors [InputMethodListFragment]: the enabled methods keep the order returned by
+ * `enabledIme()`, the remaining available methods follow in Fcitx's `availableIme()` order.
+ * Disabling a method removes it from the list; enabling it appends it at the end, matching
+ * the add/remove semantics of the legacy dynamic list.
+ */
+private class ImeListData(
+    val available: List<InputMethodEntry>,
+    enabledNames: List<String>,
+    val active: InputMethodEntry?,
+) {
+    val enabled = mutableStateListOf<String>().apply { addAll(enabledNames) }
+
+    /** Every input method the daemon knows about; used to reject the placeholder entries. */
+    val knownNames: Set<String> = available.mapTo(mutableSetOf()) { it.uniqueName }
+
+    /** Only set when the daemon reported a real, known active input method. */
+    val activeUniqueName: String? = active?.uniqueName
+        ?.takeIf { it.isNotBlank() && it in knownNames }
+
+    val rows: List<InputMethodEntry>
+        get() {
+            val byName = available.associateBy { it.uniqueName }
+            val enabledSet = enabled.toSet()
+            return enabled.mapNotNull { byName[it] } +
+                    available.filter { it.uniqueName !in enabledSet }
+        }
+
+    fun isEnabled(uniqueName: String): Boolean = uniqueName in enabled
+
+    fun setEnabled(uniqueName: String, enabledNow: Boolean) {
+        if (enabledNow) {
+            if (uniqueName !in enabled) enabled.add(uniqueName)
+        } else {
+            enabled.removeAll { it == uniqueName }
+        }
+    }
+
+    fun enabledNames(): Array<String> = enabled.toTypedArray()
+}
+
+@Composable
+fun InputMethodListScreen() {
+    val navigator = LocalSettingsNavigator.current
+    val context = LocalContext.current
+    val viewModel = viewModel<SettingsViewModel>()
+    val fcitx = viewModel.fcitx
+
+    var data by remember { mutableStateOf<ImeListData?>(null) }
+    var loading by remember { mutableStateOf(true) }
+    var error by remember { mutableStateOf<String?>(null) }
+    var reload by remember { mutableIntStateOf(0) }
+
+    LaunchedEffect(reload) {
+        loading = true
+        error = null
+        data = null
+        try {
+            val snapshot = fcitx.runOnReady {
+                val available = availableIme().toList()
+                val enabled = enabledIme().map { it.uniqueName }
+                val known = available.map { it.uniqueName }.toSet()
+                ImeListData(
+                    available = available,
+                    enabledNames = enabled.filter { it in known }.distinct(),
+                    active = currentIme(),
+                )
+            }
+            data = snapshot
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Timber.w(e, "Failed to load input methods")
+            error = e.localizedMessage ?: e.javaClass.simpleName
+        } finally {
+            loading = false
+        }
+    }
+
+    // currentIme() returns a "(Not Available)" placeholder whenever no input context is
+    // focused (which is the normal case while browsing settings), so only trust it when it
+    // names a real, known input method.
+    val snapshot = data
+    val activeName = snapshot?.active
+        ?.takeIf { it.uniqueName.isNotBlank() && it.uniqueName in snapshot.knownNames }
+        ?.displayName
+    val summary = activeName?.takeIf { it.isNotBlank() }
+        ?: stringResource(R.string.home_summary_ime)
+
+    SettingsScaffold(
+        title = stringResource(R.string.input_methods),
+        subtitle = summary,
+    ) { padding ->
+        when {
+            loading -> LoadingPane(padding)
+            data != null -> ImeListContent(
+                padding = padding,
+                data = data!!,
+                onOpen = { navigator.navigate("im/" + it.uniqueName) },
+                onToggle = { entry, enabledNow ->
+                    val listData = data ?: return@ImeListContent
+                    listData.setEnabled(entry.uniqueName, enabledNow)
+                    fcitx.persistEnabledIme(listData.enabledNames())
+                },
+            )
+
+            else -> FailurePane(padding, error) { reload++ }
+        }
+    }
+}
