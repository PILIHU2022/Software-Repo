+// -- Plugins ----------------------------------------------------------------------------------
+
+private data class PluginSnapshot(
+    val synced: DataManager.PluginSet,
+    val detected: DataManager.PluginSet,
+)
+
+private suspend fun awaitDataSynced() {
+    if (DataManager.synced) return
+    suspendCancellableCoroutine { continuation ->
+        DataManager.addOnNextSyncedCallback {
+            if (continuation.isActive) continuation.resume(Unit)
+        }
+        // Guard against the sync finishing between the read above and the registration.
+        if (DataManager.synced && continuation.isActive) continuation.resume(Unit)
+    }
+}
+
+@Composable
+private fun PluginScreen() {
+    val context = LocalContext.current
+    val lifecycleOwner = LocalLifecycleOwner.current
+    var snapshot by remember { mutableStateOf<PluginSnapshot?>(null) }
+    var loading by remember { mutableStateOf(true) }
+    var error by remember { mutableStateOf<String?>(null) }
+    var reload by remember { mutableIntStateOf(0) }
+
+    LaunchedEffect(reload) {
+        loading = true
+        error = null
+        snapshot = null
+        try {
+            awaitDataSynced()
+            snapshot = withContext(Dispatchers.IO) {
+                PluginSnapshot(
+                    synced = DataManager.getSyncedPluginSet(),
+                    detected = DataManager.detectPlugins(),
+                )
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Timber.w(e, "Failed to load plugin information")
+            error = e.localizedMessage ?: e.javaClass.simpleName
+        } finally {
+            loading = false
+        }
+    }
+
+    // Refresh when a plugin package is installed/removed while the page is visible, mirroring
+    // PluginFragment's package change receiver.
+    DisposableEffect(lifecycleOwner) {
+        val receiver = object : BroadcastReceiver() {
+            override fun onReceive(ctx: Context?, intent: Intent?) {
+                reload++
+            }
+        }
+        val filter = IntentFilter().apply {
+            addAction(Intent.ACTION_PACKAGE_ADDED)
+            addAction(Intent.ACTION_PACKAGE_REMOVED)
+            addAction(Intent.ACTION_PACKAGE_REPLACED)
+            addDataScheme("package")
+        }
+        var registered = false
+        fun register() {
+            if (!registered) {
+                context.registerReceiver(receiver, filter)
+                registered = true
+            }
+        }
+
+        fun unregister() {
+            if (registered) {
+                runCatching { context.unregisterReceiver(receiver) }
+                registered = false
+            }
+        }
+
+        val observer = LifecycleEventObserver { _, event ->
+            when (event) {
+                Lifecycle.Event.ON_START -> register()
+                Lifecycle.Event.ON_STOP -> unregister()
+                else -> Unit
+            }
+        }
+        lifecycleOwner.lifecycle.addObserver(observer)
+        if (lifecycleOwner.lifecycle.currentState.isAtLeast(Lifecycle.State.STARTED)) {
+            register()
+        }
+        onDispose {
+            lifecycleOwner.lifecycle.removeObserver(observer)
+            unregister()
+        }
+    }
+
+    SettingsScaffold(
+        title = stringResource(R.string.plugins),
+        subtitle = stringResource(R.string.home_summary_plugins),
+    ) { padding ->
+        when {
+            loading -> LoadingPane(padding)
+            snapshot != null -> PluginContent(
+                padding = padding,
+                snapshot = snapshot!!,
+                onReload = {
+                    DataManager.addOnNextSyncedCallback { reload++ }
+                    FcitxDaemon.restartFcitx()
+                },
+                onOpenPlugin = { context.openPluginDetails(it) },
+            )
+
+            else -> FailurePane(padding, error) { reload++ }
+        }
+    }
+}
+
+@Composable
+private fun PluginContent(
+    padding: PaddingValues,
+    snapshot: PluginSnapshot,
+    onReload: () -> Unit,
+    onOpenPlugin: (String) -> Unit,
+) {
+    val context = LocalContext.current
+    val loaded = remember(snapshot) { snapshot.synced.loaded.sortedBy { it.name } }
+    val failed = remember(snapshot) { snapshot.synced.failed.toList().sortedBy { it.first } }
+    val needsReload = snapshot.synced != snapshot.detected
+
+    LazyColumn(
+        modifier = Modifier
+            .fillMaxSize()
+            .padding(padding),
+        contentPadding = PaddingValues(start = 16.dp, end = 16.dp, top = 4.dp, bottom = 32.dp),
+    ) {
+        if (needsReload) {
+            item(key = "needs-reload") {
+                SettingsRow(
+                    title = stringResource(R.string.plugin_needs_reload),
+                    icon = Icons.Rounded.Refresh,
+                    onClick = onReload,
+                )
+            }
+        }
+        if (loaded.isEmpty() && failed.isEmpty()) {
+            item(key = "empty") { EmptyStateCard(stringResource(R.string.no_plugins)) }
+            return@LazyColumn
+        }
+        if (loaded.isNotEmpty()) {
+            item(key = "loaded-header") {
+                SectionLabel(stringResource(R.string.plugins_loaded))
+            }
+            items(loaded, key = { it.packageName }) { plugin ->
+                PluginRow(plugin, onOpenPlugin)
+            }
+        }
+        if (failed.isNotEmpty()) {
+            item(key = "failed-header") {
+                SectionLabel(stringResource(R.string.plugins_failed))
+            }
+            items(failed, key = { it.first }) { (packageName, reason) ->
+                SettingsRow(
+                    title = packageName,
+                    summary = pluginFailureText(context, reason),
+                    icon = Icons.Rounded.Warning,
+                    onClick = { onOpenPlugin(packageName) },
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun PluginRow(plugin: PluginDescriptor, onOpenPlugin: (String) -> Unit) {
+    SettingsRow(
+        title = plugin.name,
+        summary = listOf(plugin.versionName, plugin.description)
+            .filter { it.isNotBlank() }
+            .joinToString("\n"),
+        icon = Icons.Rounded.Extension,
+        onClick = { onOpenPlugin(plugin.packageName) },
+    )
+}
+
+private fun pluginFailureText(context: Context, reason: PluginLoadFailed): String = when (reason) {
+    is PluginLoadFailed.DataDescriptorParseError ->
+        context.getString(R.string.invalid_data_descriptor)
+
+    is PluginLoadFailed.MissingDataDescriptor ->
+        context.getString(R.string.missing_data_descriptor)
+
+    PluginLoadFailed.MissingPluginDescriptor ->
+        context.getString(R.string.missing_plugin_descriptor)
+
+    is PluginLoadFailed.PathConflict -> {
+        val owner = when (val source = reason.existingSrc) {
+            FileSource.Main -> context.getString(R.string.main_program)
+            is FileSource.Plugin -> source.descriptor.name
+        }
+        context.getString(R.string.path_conflict, reason.path, owner)
+    }
+
+    is PluginLoadFailed.PluginAPIIncompatible ->
+        context.getString(R.string.incompatible_api, reason.api)
+
+    PluginLoadFailed.PluginDescriptorParseError ->
+        context.getString(R.string.invalid_plugin_descriptor)
+}
