+/**
+ * Renders one [ConfigDescriptor] as a Compose settings row/section.
+ *
+ * [path] is the chain of [RawConfig.name]s from the config root (`raw["cfg"]`) to the value
+ * node, so custom sub-sections (whose child names may collide with top-level names) resolve
+ * to the right entry.
+ */
+@Composable
+internal fun RawConfigControl(
+    descriptor: ConfigDescriptor<*, *>,
+    path: List<String>,
+    cfg: RawConfig,
+    onValueChange: (String) -> Unit,
+) {
+    val node = cfg.findByPath(path)
+    when (descriptor) {
+        is ConfigBool -> BoolRow(descriptor, node, onValueChange)
+        is ConfigInt -> IntControl(descriptor, node, onValueChange)
+        is ConfigString -> StringRow(descriptor, node, onValueChange)
+        is ConfigEnum -> EnumRow(descriptor, node, onValueChange)
+        is ConfigEnumList -> EnumListRow(descriptor, node)
+        is ConfigList -> ListRow(descriptor, node)
+        is ConfigKey -> KeyRow(descriptor, node)
+        is ConfigCustom -> Unit // rendered as a section by the screen
+        is ConfigExternal -> Unit // rendered as an action row by the screen
+    }
+}
+
+@Composable
+private fun BoolRow(
+    descriptor: ConfigBool,
+    node: RawConfig?,
+    onValueChange: (String) -> Unit,
+) {
+    val checked = node?.value?.let { it == "True" } ?: descriptor.defaultValue ?: false
+    val toggle = { onValueChange(if (checked) "False" else "True") }
+    SettingsRow(
+        title = descriptor.description ?: descriptor.name,
+        summary = descriptor.tooltip,
+        onClick = toggle,
+        trailing = {
+            Switch(
+                checked = checked,
+                onCheckedChange = { onValueChange(if (it) "True" else "False") },
+            )
+        },
+    )
+}
+
+@Composable
+private fun IntControl(
+    descriptor: ConfigInt,
+    node: RawConfig?,
+    onValueChange: (String) -> Unit,
+) {
+    val min = descriptor.intMin
+    val max = descriptor.intMax
+    val current = clampInt(
+        node?.value?.toIntOrNull() ?: descriptor.defaultValue ?: 0,
+        min,
+        max,
+    )
+    if (min != null && max != null && max - min in 1..100) {
+        SliderIntRow(descriptor, min, max, current, onValueChange)
+    } else {
+        NumericIntRow(descriptor, current, min, max, onValueChange)
+    }
+}
+
+/**
+ * Slider for small integer ranges, matching the native preference factory threshold
+ * (`intMax - intMin <= 100`). The value is committed only when the drag finishes so that a
+ * save isn't issued for every intermediate position.
+ */
+@Composable
+private fun SliderIntRow(
+    descriptor: ConfigInt,
+    min: Int,
+    max: Int,
+    current: Int,
+    onValueChange: (String) -> Unit,
+) {
+    var sliderValue by remember(descriptor.name, current) {
+        mutableFloatStateOf(current.toFloat())
+    }
+    val scheme = MaterialTheme.colorScheme
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(vertical = 4.dp),
+        shape = RoundedCornerShape(24.dp),
+        colors = CardDefaults.cardColors(containerColor = scheme.surfaceContainerLow),
+    ) {
+        Column(modifier = Modifier.padding(horizontal = 16.dp, vertical = 12.dp)) {
+            Row(verticalAlignment = Alignment.Top) {
+                Column(modifier = Modifier.weight(1f)) {
+                    Text(
+                        text = descriptor.description ?: descriptor.name,
+                        style = MaterialTheme.typography.bodyLarge,
+                        fontWeight = FontWeight.SemiBold,
+                    )
+                    descriptor.tooltip?.let {
+                        Text(
+                            text = it,
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = scheme.onSurfaceVariant,
+                        )
+                    }
+                }
+                Text(
+                    text = sliderValue.roundToInt().toString(),
+                    style = MaterialTheme.typography.titleMedium,
+                    fontWeight = FontWeight.Bold,
+                    color = scheme.primary,
+                )
+            }
+            Spacer(Modifier.height(4.dp))
+            Slider(
+                value = sliderValue,
+                onValueChange = { sliderValue = it },
+                valueRange = min.toFloat()..max.toFloat(),
+                steps = (max - min - 1).coerceAtLeast(0),
+                onValueChangeFinished = {
+                    val rounded = sliderValue.roundToInt().coerceIn(min, max)
+                    sliderValue = rounded.toFloat()
+                    if (rounded != current) onValueChange(rounded.toString())
+                },
+            )
+        }
+    }
+}
+
+/** Numeric dialog row for huge or unbounded integer ranges. */
+@Composable
+private fun NumericIntRow(
+    descriptor: ConfigInt,
+    current: Int,
+    min: Int?,
+    max: Int?,
+    onValueChange: (String) -> Unit,
+) {
+    var show by remember { mutableStateOf(false) }
+    SettingsRow(
+        title = descriptor.description ?: descriptor.name,
+        summary = current.toString(),
+        onClick = { show = true },
+    )
+    if (show) {
+        var text by remember { mutableStateOf(current.toString()) }
+        val parsed = text.trim().toIntOrNull()
+        val range = when {
+            min != null && max != null -> "$min – $max"
+            min != null -> "≥ $min"
+            max != null -> "≤ $max"
+            else -> null
+        }
+        AlertDialog(
+            onDismissRequest = { show = false },
+            title = { Text(descriptor.description ?: descriptor.name) },
+            text = {
+                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    descriptor.tooltip?.let {
+                        Text(
+                            text = it,
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                    }
+                    if (range != null) {
+                        Text(
+                            text = range,
+                            style = MaterialTheme.typography.labelMedium,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                    }
+                    OutlinedTextField(
+                        value = text,
+                        onValueChange = { text = it },
+                        modifier = Modifier.fillMaxWidth(),
+                        singleLine = true,
+                        isError = text.isNotBlank() && parsed == null,
+                        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                    )
+                }
+            },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        if (parsed != null) {
+                            onValueChange(clampInt(parsed, min, max).toString())
+                            show = false
+                        }
+                    },
+                    enabled = parsed != null,
+                ) { Text(stringResource(R.string.save)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { show = false }) {
+                    Text(stringResource(android.R.string.cancel))
+                }
+            },
+        )
+    }
+}
+
+@Composable
+private fun StringRow(
+    descriptor: ConfigString,
+    node: RawConfig?,
+    onValueChange: (String) -> Unit,
+) {
+    val value = node?.value ?: descriptor.defaultValue ?: ""
+    var show by remember { mutableStateOf(false) }
+    SettingsRow(
+        title = descriptor.description ?: descriptor.name,
+        summary = if (value.isEmpty()) stringResource(R.string.none) else value,
+        onClick = { show = true },
+    )
+    if (show) {
+        var text by remember { mutableStateOf(value) }
+        AlertDialog(
+            onDismissRequest = { show = false },
+            title = { Text(descriptor.description ?: descriptor.name) },
+            text = {
+                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    descriptor.tooltip?.let {
+                        Text(
+                            text = it,
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                    }
+                    OutlinedTextField(
+                        value = text,
+                        onValueChange = { text = it },
+                        modifier = Modifier.fillMaxWidth(),
+                        singleLine = false,
+                        minLines = 1,
+                        maxLines = 5,
+                    )
+                }
+            },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        onValueChange(text)
+                        show = false
+                    },
+                ) { Text(stringResource(R.string.save)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { show = false }) {
+                    Text(stringResource(android.R.string.cancel))
+                }
+            },
+        )
+    }
+}
+
+@Composable
+private fun EnumRow(
+    descriptor: ConfigEnum,
+    node: RawConfig?,
+    onValueChange: (String) -> Unit,
+) {
+    val current = node?.value ?: descriptor.defaultValue ?: ""
+    val labels = descriptor.entriesI18n ?: descriptor.entries
+    val index = descriptor.entries.indexOf(current)
+    val label = if (index >= 0) labels.getOrNull(index) ?: current else current
+    var show by remember { mutableStateOf(false) }
+    SettingsRow(
+        title = descriptor.description ?: descriptor.name,
+        summary = if (label.isEmpty()) stringResource(R.string.none) else label,
+        onClick = { show = true },
+        trailing = {
+            Icon(
+                imageVector = Icons.Rounded.ArrowDropDown,
+                contentDescription = null,
+            )
+        },
+    )
+    if (show) {
+        val sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)
+        ModalBottomSheet(
+            onDismissRequest = { show = false },
+            sheetState = sheetState,
+        ) {
+            Column(modifier = Modifier.fillMaxWidth()) {
+                Text(
+                    text = descriptor.description ?: descriptor.name,
+                    style = MaterialTheme.typography.titleMedium,
+                    fontWeight = FontWeight.Bold,
+                    modifier = Modifier.padding(horizontal = 24.dp, vertical = 12.dp),
+                )
+                LazyColumn(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .heightIn(max = 480.dp),
+                ) {
+                    itemsIndexed(descriptor.entries) { idx, entry ->
+                        Row(
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .clickable {
+                                    onValueChange(entry)
+                                    show = false
+                                }
+                                .padding(horizontal = 16.dp, vertical = 10.dp),
+                            verticalAlignment = Alignment.CenterVertically,
+                        ) {
+                            RadioButton(
+                                selected = entry == current,
+                                onClick = null,
+                            )
+                            Spacer(Modifier.width(12.dp))
+                            Text(
+                                text = labels.getOrNull(idx) ?: entry,
+                                style = MaterialTheme.typography.bodyLarge,
+                            )
+                        }
+                    }
+                }
+                Spacer(Modifier.height(16.dp))
+            }
+        }
+    }
+}
+
+@Composable
+private fun EnumListRow(
+    descriptor: ConfigEnumList,
+    node: RawConfig?,
+) {
+    val selected = node?.subItems?.map { it.value } ?: descriptor.defaultValue ?: emptyList()
+    val labels = descriptor.entriesI18n ?: descriptor.entries
+    val selectedText = if (selected.isEmpty()) {
+        stringResource(R.string.none)
+    } else {
+        selected.joinToString(", ") { value ->
+            val index = descriptor.entries.indexOf(value)
+            if (index >= 0) labels.getOrNull(index) ?: value else value
+        }
+    }
+    ReadOnlyRow(
+        title = descriptor.description ?: descriptor.name,
+        summary = descriptor.tooltip?.let { "$it\n$selectedText" } ?: selectedText,
+    )
+}
+
+@Composable
+private fun ListRow(
+    descriptor: ConfigList,
+    node: RawConfig?,
+) {
+    val values = node?.subItems?.map { it.value }
+        ?: descriptor.defaultValue?.map { it.asText() }
+        ?: emptyList()
+    ReadOnlyRow(
+        title = descriptor.description ?: descriptor.name,
+        summary = if (values.isEmpty()) {
+            stringResource(R.string.none)
+        } else {
+            values.joinToString(", ")
+        },
+    )
+}
+
+@Composable
+private fun KeyRow(
+    descriptor: ConfigKey,
+    node: RawConfig?,
+) {
+    val value = node?.value ?: descriptor.defaultValue ?: ""
+    ReadOnlyRow(
+        title = descriptor.description ?: descriptor.name,
+        summary = if (value.isEmpty()) stringResource(R.string.none) else value,
+    )
+}
+
+@Composable
+private fun ReadOnlyRow(title: String, summary: String) {
+    SettingsRow(
+        title = title,
+        summary = summary,
+        enabled = false,
+        onClick = {},
+    )
+}
+
+private fun clampInt(value: Int, min: Int?, max: Int?): Int {
+    var result = value
+    if (min != null) result = result.coerceAtLeast(min)
+    if (max != null) result = result.coerceAtMost(max)
+    return result
+}
+
+private fun ConfigListValue.asText(): String = when (this) {
+    is ConfigListValue.BoolValue -> if (value) "True" else "False"
+    is ConfigListValue.IntValue -> value.toString()
+    is ConfigListValue.KeyValue -> value
+    is ConfigListValue.StringValue -> value
+}
