+@Composable
+private fun AddonRow(
+    addon: AddonInfo,
+    onOpen: (AddonInfo) -> Unit,
+    onToggle: (AddonInfo, Boolean) -> Unit,
+) {
+    // Mirrors AddonListFragment: only enabled, configurable addons expose their config page,
+    // and the clipboard addon is controlled by the Android side instead.
+    val configurable =
+        addon.isConfigurable && addon.enabled && addon.uniqueName != "clipboard"
+    SettingsRow(
+        title = addon.displayName,
+        summary = listOf(addon.comment, addon.uniqueName)
+            .filter { it.isNotBlank() }
+            .joinToString(" · "),
+        enabled = configurable,
+        onClick = { if (configurable) onOpen(addon) },
+        trailing = {
+            // The Android frontend addon must stay enabled (see AddonListFragment).
+            Switch(
+                checked = addon.enabled,
+                enabled = addon.uniqueName != "androidfrontend",
+                onCheckedChange = { onToggle(addon, it) },
+            )
+        },
+    )
+}
+
+private fun FcitxConnection.persistAddonState(uniqueName: String, enabled: Boolean) {
+    launchOnReady { fcitx ->
+        try {
+            fcitx.setAddonState(arrayOf(uniqueName), booleanArrayOf(enabled))
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            Timber.w(e, "Failed to persist addon state")
+        }
+    }
+}
