+/**
+ * Compose renderers for the [ManagedPreferenceUi] descriptors.
+ *
+ * Nothing here inflates AndroidX-Preference views: the descriptors are only used as metadata
+ * (title/summary resources, min/max/step/unit) while the actual state lives in
+ * [ManagedPreferenceProvider.managedPreferences] and is written back immediately through
+ * [ManagedPreference.setValue].
+ */
+
+/* ---------------------------------------------------------------- persistence */
+
+/**
+ * The current persisted value of [key]. The map is star projected, so callers narrow the value
+ * with a safe cast to the type they expect (`PBool` -> [Boolean], `PInt` -> [Int], ...).
+ */
+internal fun ManagedPreferenceProvider.readPref(key: String): Any? =
+    managedPreferences[key]?.getValue()
+
+/**
+ * Persists [value] for [key] and notifies every listener right away:
+ * [ManagedPreference.setValue] commits to SharedPreferences synchronously, then
+ * [ManagedPreferenceProvider.fireChange] refreshes both the provider level listeners (used by
+ * the input method service, clipboard manager, ...) and the preference level ones.
+ */
+@Suppress("UNCHECKED_CAST")
+internal fun ManagedPreferenceProvider.writePref(key: String, value: Any) {
+    val pref = managedPreferences[key] ?: return
+    // The descriptor already knows the concrete type; the cast only bridges the star projection.
+    (pref as ManagedPreference<Any>).setValue(value)
+    fireChange(key)
+}
