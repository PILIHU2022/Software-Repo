+}
+
+/** The same summary line the legacy card builds. */
+private fun summaryText(context: Context, snapshot: TypingStatsSnapshot): String = when {
+    snapshot.totalCharacters > 0L -> context.getString(
+        R.string.heatmap_summary_last_year,
+        formatCountCompact(snapshot.totalCharacters)
+    )
+
+    snapshot.startTime > 0L -> context.getString(
+        R.string.heatmap_summary_since,
+        formatStartTime(snapshot.startTime)
+    )
+
+    else -> context.getString(R.string.heatmap_no_data)
+}
+
+private fun formatStartTime(startTime: Long): String {
+    // Be forgiving about values stored as seconds (the contract is epoch millis).
+    val millis = if (startTime in 1L until 100_000_000_000L) startTime * 1_000L else startTime
+    return DateFormat.getDateInstance(DateFormat.MEDIUM, Locale.getDefault())
+        .format(Date(millis))
+}
+
+/** GitHub-like bubble label: localized count with its unit, plus the localized medium date. */
+private fun dayTooltipText(context: Context, date: LocalDate, count: Long): String {
+    val millis = date.atStartOfDay(ZoneId.systemDefault()).toInstant().toEpochMilli()
+    val dateText = DateFormat.getDateInstance(DateFormat.MEDIUM, Locale.getDefault())
+        .format(Date(millis))
+    val countText = context.resources.getQuantityString(
+        R.plurals.heatmap_chars_count,
+        count.coerceIn(0L, 2L).toInt(),
+        NumberFormat.getIntegerInstance(Locale.getDefault()).format(count)
+    )
+    return context.getString(R.string.heatmap_day_tooltip_detail, countText, dateText)
+}
+
+/** Monday-first grid: the first column starts at the Monday 52 weeks before the current one. */
+private fun firstMonday(today: LocalDate): LocalDate =
+    today.with(TemporalAdjusters.previousOrSame(DayOfWeek.MONDAY))
+        .minusWeeks((WEEKS - 1).toLong())
+
+private const val WEEKS = 53
+private const val DAYS_PER_WEEK = 7
+
+/** Rows that get a weekday label: Monday, Wednesday, Friday. */
+private val WEEKDAY_ROWS = intArrayOf(0, 2, 4)
+
+private const val NO_VALUE = "—"
+private val DEFAULT_CUSTOM_COLOR = 0xFF2DA44E.toInt()
