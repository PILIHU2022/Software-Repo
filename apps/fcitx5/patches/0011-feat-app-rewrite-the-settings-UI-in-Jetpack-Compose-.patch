+package org.fcitx.fcitx5.android.ui.main.compose
+
+import androidx.lifecycle.ViewModel
+import org.fcitx.fcitx5.android.daemon.FcitxConnection
+import org.fcitx.fcitx5.android.daemon.FcitxDaemon
+
+/**
+ * Backing view model for the Compose settings UI. Owns the Fcitx5 connection used by the
+ * screens that read or write the engine configuration (global options, addons, input
+ * methods) and keeps it alive across configuration changes.
+ *
+ * The lifetime is bound to the settings activity, separate from the input method service.
+ */
+class SettingsViewModel : ViewModel() {
+
+    val fcitx: FcitxConnection = FcitxDaemon.connect(TAG)
+
+    override fun onCleared() {
+        FcitxDaemon.disconnect(TAG)
+        super.onCleared()
+    }
+
+    companion object {
+        private const val TAG = "SettingsCompose"
+    }
+}
