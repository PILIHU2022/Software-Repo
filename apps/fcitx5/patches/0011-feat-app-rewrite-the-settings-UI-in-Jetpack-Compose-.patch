+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2021-2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.ui.main.compose
+
+import androidx.compose.runtime.compositionLocalOf
+import androidx.compose.runtime.mutableStateListOf
+import androidx.compose.runtime.snapshots.SnapshotStateList
+
+/** Whether the last stack mutation was a push or a pop; drives the page transition. */
+enum class NavDirection { Forward, Back }
+
+/**
+ * Route ids used by the Compose settings UI. Keep them in sync with the legacy
+ * [org.fcitx.fcitx5.android.ui.main.settings.SettingsRoute] names so deep links and the
+ * unmigrated pages keep working.
+ */
+object SettingsRoutes {
+    const val HOME = "home"
+
+    // Fcitx
+    const val GLOBAL = "global"
+    const val IM_LIST = "im_list"
+    const val ADDON_LIST = "addon_list"
+    const val THEME = "theme"
+
+    // Android
+    const val VIRTUAL_KEYBOARD = "virtual_keyboard"
+    const val CANDIDATES = "candidates"
+    const val CLIPBOARD = "clipboard"
+    const val SYMBOL = "symbol"
+    const val ADVANCED = "advanced"
+    const val STATS = "stats"
+    const val PLUGIN = "plugin"
+    const val FILES = "files"
+    const val DEVELOPER = "developer"
+    const val ABOUT = "about"
+    const val LICENSE = "license"
+}
+
+/**
+ * Tiny screen stack. The settings hierarchy is a straight line (home → page → page), so a
+ * list of route ids is enough and keeps the Compose code free of a navigation dependency.
+ */
+class SettingsNavigator(
+    private val openNative: (String) -> Unit,
+) {
+    val stack: SnapshotStateList<String> = mutableStateListOf(SettingsRoutes.HOME)
+
+    /**
+     * Direction of the most recent stack mutation. A plain var on purpose: it is written right
+     * before the stack changes and read in [androidx.compose.animation.AnimatedContent]'s
+     * transitionSpec during the same recomposition, so it never needs to notify on its own.
+     */
+    var lastDirection: NavDirection = NavDirection.Forward
+        private set
+
+    val currentRoute: String
+        get() = stack.lastOrNull() ?: SettingsRoutes.HOME
+
+    fun navigate(route: String) {
+        if (route == currentRoute) return
+        lastDirection = NavDirection.Forward
+        stack.add(route)
+    }
+
+    fun back(): Boolean {
+        if (stack.size <= 1) return false
+        lastDirection = NavDirection.Back
+        stack.removeAt(stack.lastIndex)
+        return true
+    }
+
+    /** Escapes to the legacy AndroidX-Preference screens for destinations not migrated yet. */
+    fun openNative(route: String) {
+        openNative.invoke(route)
+    }
+}
+
+val LocalSettingsNavigator = compositionLocalOf<SettingsNavigator> {
+    error("SettingsNavigator not provided")
+}
