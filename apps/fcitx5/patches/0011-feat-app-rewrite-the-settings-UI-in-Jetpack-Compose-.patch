+// ---------------------------------------------------------------------------------------------
+// Descriptor walk
+// ---------------------------------------------------------------------------------------------
+
+private sealed interface RawConfigItem {
+    val key: String
+
+    data class Section(override val key: String, val title: String) : RawConfigItem
+
+    data class Unsupported(
+        override val key: String,
+        val title: String,
+        val typeName: String,
+    ) : RawConfigItem
+
+    data class Control(
+        override val key: String,
+        val descriptor: ConfigDescriptor<*, *>,
+        val path: List<String>,
+    ) : RawConfigItem
+}
+
+/**
+ * Mirrors `PreferenceScreenFactory.create/general/custom`:
+ * - top-level descriptors come from `topLevelDesc.values`
+ * - `ConfigCustom` becomes a section whose children live under `cfg[customName][childName]`
+ * - key configs are hidden when `advanced.hideKeyConfig` is enabled
+ *
+ * IDs carry the list index so custom children with colliding names stay unique in the
+ * underlying LazyColumn, while [RawConfigItem.Control.path] keeps the config lookup correct.
+ */
+private fun flattenRawConfig(
+    desc: ConfigTopLevelDef,
+    hideKeyConfig: Boolean,
+): List<RawConfigItem> {
+    val out = mutableListOf<RawConfigItem>()
+
+    fun walk(
+        descriptors: List<ConfigDescriptor<*, *>>,
+        parentPath: List<String>,
+        parentKey: String,
+        depth: Int,
+        customTypes: Set<String>,
+    ) {
+        descriptors.forEachIndexed { index, descriptor ->
+            if (hideKeyConfig && ConfigType.pretty(descriptor.ty).contains("Key")) {
+                return@forEachIndexed
+            }
+            val key = "$parentKey/$index"
+            val path = parentPath + descriptor.name
+            if (descriptor is ConfigCustom) {
+                val title = descriptor.description ?: descriptor.name
+                out += RawConfigItem.Section("section:$key", title)
+                val def = descriptor.customTypeDef
+                val typeName = descriptor.ty.typeName
+                if (def == null || depth >= MAX_CUSTOM_DEPTH || typeName in customTypes) {
+                    // No parsed type definition, or a defensive recursion/cycle guard.
+                    out += RawConfigItem.Unsupported("unsupported:$key", title, typeName)
+                } else {
+                    walk(def.values, path, key, depth + 1, customTypes + typeName)
+                }
+            } else {
+                out += RawConfigItem.Control("control:$key", descriptor, path)
+            }
+        }
+    }
+
+    walk(desc.values, emptyList(), "", 0, emptySet())
+    return out
+}
