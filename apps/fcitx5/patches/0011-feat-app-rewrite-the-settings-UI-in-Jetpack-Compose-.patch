+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Self-contained resources for the androidTest APK.
+
+  The app's debug build type declares resValues (app_icon / app_icon_round / app_name) that
+  point back at main-res names (ic_launcher_debug / app_name_debug). Those resValues propagate
+  into the androidTest variant, whose AAPT link cannot see the app's main resources, which
+  broke `connectedDebugAndroidTest` linking. Providing the referenced names here keeps the
+  test APK linkable; the values themselves are irrelevant placeholders (test APK icon/label).
+-->
+<resources>
+    <string name="app_name_debug">Fcitx5 Tests</string>
+</resources>
