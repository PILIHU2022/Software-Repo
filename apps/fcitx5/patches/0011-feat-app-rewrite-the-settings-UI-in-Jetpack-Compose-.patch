+/**
+ * Opens the plugin's own "about" activity, falling back to the system app info page when the
+ * plugin does not provide one (mirrors [org.fcitx.fcitx5.android.ui.main.PluginFragment]).
+ */
+private fun Context.openPluginDetails(packageName: String) {
+    val pm = packageManager
+    val pluginIntent = Intent(DataManager.PLUGIN_INTENT)
+    val activity = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+        pm.queryIntentActivities(
+            pluginIntent,
+            PackageManager.ResolveInfoFlags.of(PackageManager.MATCH_ALL.toLong()),
+        )
+    } else {
+        pm.queryIntentActivities(pluginIntent, PackageManager.MATCH_ALL)
+    }.firstOrNull { it.activityInfo.packageName == packageName }
+
+    if (activity != null) {
+        startActivity(
+            Intent().apply {
+                flags = Intent.FLAG_ACTIVITY_NEW_TASK
+                component = ComponentName(
+                    activity.activityInfo.packageName,
+                    activity.activityInfo.name,
+                )
+            }
+        )
+    } else {
+        startActivity(
+            Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
+                flags = Intent.FLAG_ACTIVITY_NEW_TASK
+                data = Uri.fromParts("package", packageName, null)
+            }
+        )
+    }
