+@Composable
+private fun DeveloperScreen() {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val prefs = remember { AppPrefs.getInstance() }
+
+    var verbose by remember { mutableStateOf(prefs.internal.verboseLog.getValue()) }
+    var inspector by remember { mutableStateOf(prefs.internal.editorInfoInspector.getValue()) }
+    var confirmAction by remember { mutableStateOf<DevAction?>(null) }
+    var hprofFile by remember { mutableStateOf<File?>(null) }
+
+    val doneText = stringResource(R.string.done)
+    val syncedText = stringResource(R.string.synced)
+    val failedText = stringResource(R.string._not_available_)
+
+    fun toast(text: String) = Toast.makeText(context, text, Toast.LENGTH_SHORT).show()
+
+    val hprofLauncher = rememberLauncherForActivityResult(
+        contract = ActivityResultContracts.CreateDocument("application/octet-stream"),
+    ) { uri ->
+        val file = hprofFile
+        hprofFile = null
+        if (file == null) return@rememberLauncherForActivityResult
+        if (uri == null) {
+            file.delete()
+            return@rememberLauncherForActivityResult
+        }
+        scope.launch {
+            val ok = withContext(Dispatchers.IO) {
+                try {
+                    context.contentResolver.openOutputStream(uri)!!.use { out ->
+                        file.inputStream().use { input -> input.copyTo(out) }
+                    }
+                    true
+                } catch (e: Exception) {
+                    Timber.w(e, "Failed to export heap dump")
+                    false
+                } finally {
+                    file.delete()
+                }
+            }
+            toast(if (ok) doneText else failedText)
+        }
+    }
+
+    fun perform(action: DevAction) {
+        scope.launch {
+            when (action) {
+                DevAction.RestartFcitx -> {
+                    FcitxDaemon.restartFcitx()
+                    toast(doneText)
+                }
+
+                DevAction.DeleteAndSync -> {
+                    withContext(Dispatchers.IO) { DataManager.deleteAndSync() }
+                    toast(syncedText)
+                }
+
+                DevAction.ClearClipboard -> {
+                    withContext(Dispatchers.IO) { ClipboardManager.nukeTable() }
+                    toast(doneText)
+                }
+            }
+        }
+    }
+
+    SettingsScaffold(
+        title = stringResource(R.string.developer),
+        subtitle = stringResource(R.string.home_summary_developer),
+    ) { padding ->
+        LazyColumn(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding),
+            contentPadding = PaddingValues(start = 16.dp, end = 16.dp, top = 4.dp, bottom = 32.dp),
+        ) {
+            item {
+                SettingsRow(
+                    title = stringResource(R.string.real_time_logs),
+                    icon = Icons.Rounded.Terminal,
+                    onClick = {
+                        context.startActivity(Intent(context, LogActivity::class.java))
+                    },
+                )
+            }
+            item {
+                SwitchRow(
+                    title = stringResource(R.string.verbose_log),
+                    summary = stringResource(R.string.verbose_log_summary),
+                    checked = verbose,
+                    onCheckedChange = { checked ->
+                        verbose = checked
+                        prefs.internal.verboseLog.setValue(checked)
+                        // Same side effects as the legacy DeveloperFragment preference.
+                        Timber.setupForest(checked)
+                        FcitxDaemon.getFirstConnectionOrNull()?.runIfReady {
+                            setLogRule(checked)
+                        }
+                    },
+                )
+            }
+            item {
+                SwitchRow(
+                    title = stringResource(R.string.editor_info_inspector),
+                    checked = inspector,
+                    onCheckedChange = { checked ->
+                        inspector = checked
+                        prefs.internal.editorInfoInspector.setValue(checked)
+                    },
+                )
+            }
+            item {
+                SettingsRow(
+                    title = stringResource(R.string.restart_fcitx_instance),
+                    icon = Icons.Rounded.Refresh,
+                    onClick = { confirmAction = DevAction.RestartFcitx },
+                )
+            }
+            item {
+                SettingsRow(
+                    title = stringResource(R.string.delete_and_sync_data),
+                    icon = Icons.Rounded.Delete,
+                    onClick = { confirmAction = DevAction.DeleteAndSync },
+                )
+            }
+            item {
+                SettingsRow(
+                    title = stringResource(R.string.clear_clb_db),
+                    icon = Icons.Rounded.Storage,
+                    onClick = { confirmAction = DevAction.ClearClipboard },
+                )
+            }
+            item {
+                SettingsRow(
+                    title = stringResource(R.string.capture_heap_dump),
+                    icon = Icons.Rounded.Science,
+                    onClick = {
+                        scope.launch {
+                            val file = context.cacheDir.resolve(
+                                context.packageName + "_" + iso8601UTCDateTime() + ".hprof"
+                            )
+                            val ok = withContext(Dispatchers.IO) {
+                                try {
+                                    System.gc()
+                                    Debug.dumpHprofData(file.absolutePath)
+                                    true
+                                } catch (e: Exception) {
+                                    Timber.w(e, "Failed to capture heap dump")
+                                    false
+                                }
+                            }
+                            if (ok) {
+                                hprofFile = file
+                                hprofLauncher.launch(file.name)
+                            } else {
+                                file.delete()
+                                toast(failedText)
+                            }
+                        }
+                    },
+                )
+            }
+        }
+    }
+
+    val action = confirmAction
+    if (action != null) {
+        val (titleRes, messageRes) = when (action) {
+            DevAction.RestartFcitx ->
+                R.string.restart_fcitx_instance to R.string.restart_fcitx_instance_confirm
