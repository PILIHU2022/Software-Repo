+// ---------------------------------------------------------------------------------------------
+// Route / loading
+// ---------------------------------------------------------------------------------------------
+
+private sealed interface RawConfigRoute {
+    data object Global : RawConfigRoute
+    data class Addon(val uniqueName: String) : RawConfigRoute
+    data class Im(val uniqueName: String) : RawConfigRoute
+    data class Unknown(val route: String) : RawConfigRoute
+}
+
+private fun parseRawConfigRoute(route: String): RawConfigRoute = when {
+    route == SettingsRoutes.GLOBAL -> RawConfigRoute.Global
+    route.startsWith("addon/") -> RawConfigRoute.Addon(route.removePrefix("addon/"))
+    route.startsWith("im/") -> RawConfigRoute.Im(route.removePrefix("im/"))
+    else -> RawConfigRoute.Unknown(route)
+}
+
+private data class RawConfigPage(
+    val title: String,
+    val desc: ConfigTopLevelDef,
+    val cfg: RawConfig,
+)
+
+private suspend fun loadRawConfigPage(
+    fcitx: FcitxConnection,
+    spec: RawConfigRoute,
+    context: Context,
+): RawConfigPage? {
+    val raw = fcitx.runOnReady {
+        when (spec) {
+            RawConfigRoute.Global -> getGlobalConfig()
+            is RawConfigRoute.Addon -> getAddonConfig(spec.uniqueName)
+            is RawConfigRoute.Im -> getImConfig(spec.uniqueName)
+            is RawConfigRoute.Unknown -> error("Unsupported RawConfig route: ${spec.route}")
+        }
+    }
+    val descRaw = raw.findByName("desc")
+    val cfg = raw.findByName("cfg")
+    if (descRaw == null || cfg == null) return null
+
+    // Android-specific synthetic row, same as AddonConfigFragment.obtainConfig(). It is only
+    // added to the in-memory descriptor tree; saves pass `cfg`, so it never reaches the daemon.
+    if (spec is RawConfigRoute.Addon && spec.uniqueName == "table") {
+        descRaw.findByName("TableGlobalConfig")?.let { tableGlobal ->
+            if (tableGlobal.findByName("AndroidTable") == null) {
+                tableGlobal.subItems = (tableGlobal.subItems ?: emptyArray()) + RawConfig(
+                    "AndroidTable",
+                    subItems = arrayOf(
+                        RawConfig("Type", "External"),
+                        RawConfig("Description", context.getString(R.string.manage_table_im)),
+                    ),
+                )
+            }
+        }
+    }
+
+    val desc = ConfigDescriptor.parseTopLevel(descRaw).fold({ throw it }, { it })
+    return RawConfigPage(
+        title = resolvePageTitle(fcitx, spec, context),
+        desc = desc,
+        cfg = cfg,
+    )
+}
+
+/** Readable page title when the daemon has the addon/IME metadata, else the unique name. */
+private suspend fun resolvePageTitle(
+    fcitx: FcitxConnection,
+    spec: RawConfigRoute,
+    context: Context,
+): String = when (spec) {
+    RawConfigRoute.Global -> context.getString(R.string.global_options)
+
+    is RawConfigRoute.Addon -> runCatching {
+        fcitx.runOnReady {
+            addons().firstOrNull { it.uniqueName == spec.uniqueName }?.displayName
+        }
+    }.getOrNull() ?: spec.uniqueName
+
+    is RawConfigRoute.Im -> runCatching {
+        fcitx.runOnReady {
+            availableIme().firstOrNull { it.uniqueName == spec.uniqueName }?.displayName
+        }
+    }.getOrNull() ?: spec.uniqueName
+
+    is RawConfigRoute.Unknown -> spec.route
+}
+
+// ---------------------------------------------------------------------------------------------
+// Page state / config helpers
+// ---------------------------------------------------------------------------------------------
+
+private sealed interface RawConfigPageState {
+    data object Loading : RawConfigPageState
+
+    data class Failure(val title: String, val message: String) : RawConfigPageState
+
+    data class Ready(
+        val title: String,
+        val desc: ConfigTopLevelDef,
+        val cfg: RawConfig,
+        val lastGood: RawConfig,
+    ) : RawConfigPageState
+}
+
+private class SaveScheduler {
+    var job: Job? = null
+    var dirty: Boolean = false
+}
+
+internal fun RawConfig.deepCopy(): RawConfig =
+    copy(subItems = subItems?.map { it.deepCopy() }?.toTypedArray())
+
+internal fun RawConfig.findByPath(path: List<String>): RawConfig? {
+    var current: RawConfig = this
+    for (name in path) {
+        current = current.findByName(name) ?: return null
+    }
+    return current
+}
+
+private fun RawConfig.getOrCreateByPath(path: List<String>): RawConfig {
+    var current: RawConfig = this
+    for (name in path) {
+        current = current.getOrCreate(name)
+    }
+    return current
+}
