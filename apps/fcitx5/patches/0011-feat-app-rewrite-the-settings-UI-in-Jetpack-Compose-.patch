+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import org.fcitx.fcitx5.android.R
+import org.fcitx.fcitx5.android.data.prefs.AppPrefs
+import org.fcitx.fcitx5.android.data.prefs.ManagedPreferenceProvider
+import org.fcitx.fcitx5.android.data.prefs.ManagedPreferenceUi
+import org.fcitx.fcitx5.android.ui.main.compose.SettingsRoutes
+import org.fcitx.fcitx5.android.ui.main.compose.components.SettingsScaffold
+
+/**
+ * ManagedPreference based pages (virtual keyboard, candidates, clipboard, symbols, advanced).
+ *
+ * The AndroidX-Preference views are never inflated: [ManagedPreferenceProvider.managedPreferencesUi]
+ * supplies ordering, titles, min/max/step/unit and the enable rules, while the values themselves
+ * are read from [ManagedPreferenceProvider.managedPreferences] and written back immediately with
+ * [org.fcitx.fcitx5.android.data.prefs.ManagedPreference.setValue].
+ *
+ * Every row reads its value through `remember(revision)`: after an edit the page bumps the
+ * revision counter and notifies the provider, so rows whose `isEnabled()` depends on the edited
+ * key (haptics, clipboard listening, ...) collapse or expand without leaving the page.
+ */
+@Composable
+fun PreferenceSettingsScreen(route: String) {
+    val provider = remember(route) { providerFor(route) }
+    if (provider != null) {
+        PreferenceSettingsContent(provider = provider, title = stringResource(titleFor(route)))
+    } else {
+        // SettingsDestination only sends the five routes below here; keep the page total anyway.
+        SettingsScaffold(title = route) { padding ->
+            Box(modifier = Modifier.fillMaxSize().padding(padding))
+        }
+    }
+}
+
+@Composable
+private fun PreferenceSettingsContent(provider: ManagedPreferenceProvider, title: String) {
+    val context = LocalContext.current
+    var revision by remember { mutableIntStateOf(0) }
+    var optionSheetKey by remember { mutableStateOf<String?>(null) }
+    var editDialogKey by remember { mutableStateOf<String?>(null) }
+
+    val rows = provider.managedPreferencesUi
+    // Voice input method ids/labels come from the PackageManager; harvest them once per page.
+    val voiceInputOptions = remember(provider, context) {
+        rows.filterIsInstance<ManagedPreferenceUi.VoiceInputList>()
+            .associate { it.key to harvestVoiceInputOptions(context, it) }
+    }
+    val bumpRevision: () -> Unit = { revision++ }
+
+    SettingsScaffold(title = title) { padding ->
+        LazyColumn(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding),
+            contentPadding = PaddingValues(start = 16.dp, top = 8.dp, end = 16.dp, bottom = 32.dp),
+        ) {
+            items(rows, key = { it.key }) { ui ->
+                when (ui) {
+                    is ManagedPreferenceUi.Switch ->
+                        SwitchPreferenceRow(provider, ui, revision, bumpRevision)
+
+                    is ManagedPreferenceUi.StringList<*> ->
+                        StringListPreferenceRow(
+                            provider, ui, revision,
+                            onOpen = { optionSheetKey = ui.key },
+                        )
+
+                    is ManagedPreferenceUi.VoiceInputList ->
+                        VoiceInputPreferenceRow(
+                            provider, ui,
+                            options = voiceInputOptions[ui.key]
+                                ?: VoiceInputOptions(emptyList(), emptyList()),
+                            revision = revision,
+                            onOpen = { optionSheetKey = ui.key },
+                        )
+
+                    is ManagedPreferenceUi.SeekBarInt ->
+                        SeekBarPreferenceRow(provider, ui, revision, bumpRevision)
+
+                    is ManagedPreferenceUi.EditTextInt ->
+                        EditIntPreferenceRow(
+                            provider, ui, revision,
+                            onOpen = { editDialogKey = ui.key },
+                        )
+
+                    is ManagedPreferenceUi.TwinSeekBarInt ->
+                        TwinSeekBarPreferenceRow(provider, ui, revision, bumpRevision)
+
+                    // Future descriptor kinds: not rendered until they get a Compose widget.
+                    else -> Unit
+                }
+            }
+        }
+    }
+
+    // Single choice sheets and the free text integer dialog live above the list so that they
+    // survive the rows being recycled by the LazyColumn.
+    val sheetUi = optionSheetKey?.let { key -> rows.firstOrNull { it.key == key } }
+    when (sheetUi) {
+        is ManagedPreferenceUi.StringList<*> -> {
+            val current = provider.readPref(sheetUi.key)
+            OptionSheet(
+                title = stringResource(sheetUi.title),
+                labels = sheetUi.entryLabels.map { stringResource(it) },
+                selectedIndex = sheetUi.entryValues.indexOfFirst { it == current },
+                onSelect = { index ->
+                    // PStringLike.setValue runs the descriptor's codec, which stores the
+                    // encoded (String) form; see ManagedPreference.StringLikeCodec.
+                    sheetUi.entryValues.getOrNull(index)
+                        ?.let { provider.writePref(sheetUi.key, it) }
+                    bumpRevision()
+                    optionSheetKey = null
+                },
+                onDismiss = { optionSheetKey = null },
+            )
+        }
+
+        is ManagedPreferenceUi.VoiceInputList -> {
+            val options = voiceInputOptions[sheetUi.key]
+                ?: VoiceInputOptions(emptyList(), emptyList())
+            val current = provider.readPref(sheetUi.key) as? String ?: sheetUi.defaultValue
+            OptionSheet(
+                title = stringResource(sheetUi.title),
+                labels = options.labels,
+                selectedIndex = options.values.indexOf(current),
+                onSelect = { index ->
+                    options.values.getOrNull(index)
+                        ?.let { provider.writePref(sheetUi.key, it) }
+                    bumpRevision()
+                    optionSheetKey = null
+                },
+                onDismiss = { optionSheetKey = null },
+            )
+        }
+
+        else -> Unit
+    }
+
+    val editUi = editDialogKey?.let { key ->
+        rows.firstOrNull { it.key == key } as? ManagedPreferenceUi.EditTextInt
+    }
+    if (editUi != null) {
+        EditIntDialog(
+            provider = provider,
+            ui = editUi,
+            onDismiss = { editDialogKey = null },
+            onChanged = bumpRevision,
+        )
+    }
+}
+
+/** AppPrefs category behind a Compose settings route. */
+private fun providerFor(route: String): ManagedPreferenceProvider? {
+    val prefs = AppPrefs.getInstance()
+    return when (route) {
+        SettingsRoutes.VIRTUAL_KEYBOARD -> prefs.keyboard
+        SettingsRoutes.CANDIDATES -> prefs.candidates
+        SettingsRoutes.CLIPBOARD -> prefs.clipboard
+        SettingsRoutes.SYMBOL -> prefs.symbols
+        SettingsRoutes.ADVANCED -> prefs.advanced
+        else -> null
+    }
+}
+
+@StringRes
+private fun titleFor(route: String): Int = when (route) {
+    SettingsRoutes.VIRTUAL_KEYBOARD -> R.string.virtual_keyboard
+    SettingsRoutes.CANDIDATES -> R.string.candidates_window
+    SettingsRoutes.CLIPBOARD -> R.string.clipboard
+    SettingsRoutes.SYMBOL -> R.string.emoji_and_symbols
+    SettingsRoutes.ADVANCED -> R.string.advanced
+    else -> R.string.settings_title
+}
