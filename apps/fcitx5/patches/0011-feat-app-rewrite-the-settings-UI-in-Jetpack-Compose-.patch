+/** The three headline chips of the legacy card: characters, accuracy and streak. */
+@Composable
+private fun MetricRow(context: Context, snapshot: TypingStatsSnapshot) {
+    val totalText = formatCountCompact(snapshot.totalCharacters)
+    val accuracyText = if (snapshot.totalCharacters > 0L) {
+        String.format(Locale.getDefault(), "%.1f%%", snapshot.accuracy * 100f)
+    } else {
+        NO_VALUE
+    }
+    val streakText = snapshot.currentStreak.toString()
+
+    Row(verticalAlignment = Alignment.CenterVertically) {
+        MetricChip(
+            value = totalText,
+            label = stringResource(R.string.heatmap_total_characters),
+            description = stringResource(R.string.heatmap_total_characters) + ": " + totalText,
+            modifier = Modifier.weight(1f),
+        )
+        Spacer(Modifier.width(8.dp))
+        MetricChip(
+            value = accuracyText,
+            label = stringResource(R.string.heatmap_accuracy),
+            description = stringResource(R.string.heatmap_accuracy) + ": " + accuracyText,
+            modifier = Modifier.weight(1f),
+        )
+        Spacer(Modifier.width(8.dp))
+        MetricChip(
+            value = streakText,
+            label = stringResource(R.string.heatmap_streak),
+            description = stringResource(R.string.heatmap_streak) + ": " +
+                context.resources.getQuantityString(
+                    R.plurals.heatmap_days_count,
+                    snapshot.currentStreak.coerceIn(0, 2),
+                    streakText
+                ),
+            modifier = Modifier.weight(1f),
+        )
+    }
+}
