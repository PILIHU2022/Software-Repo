+/** `42 %` (the unit is a raw string, appended verbatim) or just `42` when there is no unit. */
+internal fun formatIntValue(value: Int, unit: String): String =
+    if (unit.isEmpty()) value.toString() else "$value $unit"
+
+/**
+ * Summary semantics of the legacy `DialogSeekBarPreference` / `TwinSeekBarPreference`: show the
+ * "system default" label when the value is still the default one, the plain number otherwise.
+ */
+@Composable
+internal fun intValueText(
+    value: Int,
+    defaultValue: Int,
+    unit: String,
+    defaultLabel: Int?,
+): String =
+    if (defaultLabel != null && value == defaultValue) stringResource(defaultLabel)
+    else formatIntValue(value, unit)
+
+/** Snaps a slider position to the `min + n * step` grid used by the legacy seek bar widgets. */
+internal fun snapToStep(value: Float, min: Int, max: Int, step: Int): Int {
+    val safeStep = step.coerceAtLeast(1)
+    val snapped = min + ((value - min) / safeStep).roundToInt() * safeStep
+    return snapped.coerceIn(min, max)
+}
+
+/**
+ * Number of ticks strictly between the endpoints, for short ranges only. Long ranges stay
+ * continuous (ticks would be unreadable) and snap to the step when the drag finishes.
+ */
+internal fun sliderSteps(min: Int, max: Int, step: Int): Int {
+    val intervals = (max - min) / step.coerceAtLeast(1)
+    return if (intervals in 2..25) intervals - 1 else 0
+}
