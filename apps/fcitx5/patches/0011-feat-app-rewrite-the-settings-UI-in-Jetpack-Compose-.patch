+/**
+ * Addons grouped by their [AddonCategory]. [AddonCategory] has no localized labels, so the
+ * section headers are derived from the enum name ("InputMethod" -> "Input Method").
+ */
+private fun List<AddonInfo>.groupedByCategory(): List<Pair<AddonCategory, List<AddonInfo>>> =
+    AddonCategory.entries.mapNotNull { category ->
+        filter { it.category == category }
+            .sortedBy { it.uniqueName }
+            .takeIf { it.isNotEmpty() }
+            ?.let { category to it }
+    }
+
+private fun AddonCategory.sectionTitle(): String =
+    name.replace(Regex("([a-z])([A-Z])"), "\$1 \$2")
