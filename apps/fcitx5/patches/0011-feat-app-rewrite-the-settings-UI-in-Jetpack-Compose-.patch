+    SettingsRow(
+        title = title,
+        summary = summary,
+        enabled = enabled,
+        onClick = onClick,
+        trailing = {
+            Icon(
+                imageVector = Icons.Rounded.ChevronRight,
+                contentDescription = null,
+                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        },
+    )
+}
+
+/* -------------------------------------------------------------------- switches */
+
+@Composable
+internal fun SwitchPreferenceRow(
+    provider: ManagedPreferenceProvider,
+    ui: ManagedPreferenceUi.Switch,
+    revision: Int,
+    onChanged: () -> Unit,
+) {
+    val enabled = ui.isEnabled()
+    val checked = remember(revision, ui.key) {
+        provider.readPref(ui.key) as? Boolean ?: ui.defaultValue
+    }
+    val setChecked: (Boolean) -> Unit = { newValue ->
+        provider.writePref(ui.key, newValue)
+        onChanged()
+    }
+    SettingsRow(
+        title = stringResource(ui.title),
+        summary = ui.summary?.let { stringResource(it) },
+        enabled = enabled,
+        onClick = { setChecked(!checked) },
+        trailing = {
+            Switch(
+                checked = checked,
+                onCheckedChange = setChecked,
+                enabled = enabled,
+            )
+        },
+    )
+}
+
+/* ---------------------------------------------------------------- list options */
+
+/** Harvested AndroidX `ListPreference` content: parallel label / value lists. */
+internal data class VoiceInputOptions(
+    val labels: List<String>,
+    val values: List<String>,
+)
+
+/**
+ * [ManagedPreferenceUi.VoiceInputList] only exposes its content through the `ListPreference`
+ * built by [ManagedPreferenceUi.createUi], which queries the voice input methods from the
+ * PackageManager. Build one throwaway instance to read `entries` / `entryValues` and never
+ * attach it to a view hierarchy.
+ */
+internal fun harvestVoiceInputOptions(
+    context: Context,
+    ui: ManagedPreferenceUi.VoiceInputList,
+): VoiceInputOptions = runCatching {
+    val pref = ui.createUi(context)
+    VoiceInputOptions(
+        labels = pref.entries?.map { it.toString() }.orEmpty(),
+        values = pref.entryValues?.map { it.toString() }.orEmpty(),
+    )
+}.getOrDefault(VoiceInputOptions(emptyList(), emptyList()))
+
+@Composable
+internal fun StringListPreferenceRow(
+    provider: ManagedPreferenceProvider,
+    ui: ManagedPreferenceUi.StringList<*>,
+    revision: Int,
+    onOpen: () -> Unit,
+) {
+    val value = remember(revision, ui.key) { provider.readPref(ui.key) }
+    val index = ui.entryValues.indexOfFirst { it == value }
+    val label = if (index >= 0) stringResource(ui.entryLabels[index])
+    else stringResource(R.string._not_available_)
+    ValuePreferenceRow(
+        title = stringResource(ui.title),
+        summary = label,
+        enabled = ui.isEnabled(),
+        onClick = onOpen,
+    )
+}
+
+@Composable
+internal fun VoiceInputPreferenceRow(
+    provider: ManagedPreferenceProvider,
+    ui: ManagedPreferenceUi.VoiceInputList,
+    options: VoiceInputOptions,
+    revision: Int,
+    onOpen: () -> Unit,
+) {
+    val value = remember(revision, ui.key) {
+        provider.readPref(ui.key) as? String ?: ui.defaultValue
+    }
+    val index = options.values.indexOf(value)
+    // Same behaviour as the AndroidX summary provider: IDs that are gone are reported as such.
+    val label = if (index >= 0) options.labels.getOrElse(index) { value }
+    else stringResource(R.string._not_available_)
+    ValuePreferenceRow(
+        title = stringResource(ui.title),
+        summary = label,
+        enabled = ui.isEnabled(),
+        onClick = onOpen,
+    )
+}
+
+/**
+ * Single choice bottom sheet shared by [ManagedPreferenceUi.StringList] and
+ * [ManagedPreferenceUi.VoiceInputList]. [selectedIndex] is `-1` when the persisted value is not
+ * part of the current option list.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+internal fun OptionSheet(
+    title: String,
+    labels: List<String>,
+    selectedIndex: Int,
+    onSelect: (Int) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    ModalBottomSheet(
+        onDismissRequest = onDismiss,
+        sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true),
+    ) {
+        Text(
+            text = title,
+            style = MaterialTheme.typography.titleLarge,
+            fontWeight = FontWeight.Bold,
+            modifier = Modifier.padding(start = 28.dp, end = 28.dp, bottom = 12.dp),
+        )
+        Column(
+            modifier = Modifier
+                .fillMaxWidth()
+                .heightIn(max = 420.dp)
+                .verticalScroll(rememberScrollState())
+                .padding(bottom = 24.dp),
+        ) {
+            labels.forEachIndexed { index, label ->
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clickable { onSelect(index) }
+                        .padding(horizontal = 20.dp, vertical = 4.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    RadioButton(
+                        selected = index == selectedIndex,
+                        onClick = null,
+                        modifier = Modifier.padding(8.dp),
+                    )
+                    Spacer(Modifier.width(12.dp))
+                    Text(
+                        text = label,
+                        style = MaterialTheme.typography.bodyLarge,
+                        modifier = Modifier.padding(vertical = 12.dp),
+                    )
+                }
+            }
+        }
+    }
+}
+
+/* -------------------------------------------------------------------- sliders */
+
+/**
+ * One labelled slider: title/label and current value on top, the thumb below. The value is only
+ * persisted when the drag finishes, but the label follows the finger through local state.
+ */
+@Composable
+private fun ManagedIntSlider(
+    label: String,
+    isTitle: Boolean,
+    persistedValue: Int,
+    defaultValue: Int,
+    unit: String,
+    defaultLabel: Int?,
+    min: Int,
+    max: Int,
+    step: Int,
+    enabled: Boolean,
+    onCommit: (Int) -> Unit,
+) {
+    val scheme = MaterialTheme.colorScheme
+    val lower = min.toFloat()
+    val upper = max.toFloat()
+    var dragValue by remember { mutableStateOf<Float?>(null) }
+    val shown = if (lower < upper) (dragValue ?: persistedValue.toFloat()).coerceIn(lower, upper)
+    else persistedValue.toFloat()
+    val displayValue = snapToStep(shown, min, max, step)
+
+    Column(modifier = Modifier.fillMaxWidth()) {
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(top = 12.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Text(
+                text = label,
+                style = if (isTitle) MaterialTheme.typography.bodyLarge
+                else MaterialTheme.typography.bodyMedium,
+                fontWeight = if (isTitle) FontWeight.SemiBold else null,
+                color = when {
+                    !enabled -> scheme.onSurface.copy(alpha = 0.38f)
+                    isTitle -> scheme.onSurface
+                    else -> scheme.onSurfaceVariant
+                },
+                modifier = Modifier.weight(1f),
+            )
+            Spacer(Modifier.width(8.dp))
+            Text(
+                text = intValueText(displayValue, defaultValue, unit, defaultLabel),
+                style = MaterialTheme.typography.labelLarge,
+                fontWeight = FontWeight.SemiBold,
+                color = if (enabled) scheme.primary else scheme.onSurface.copy(alpha = 0.38f),
+            )
+        }
+        if (lower < upper) {
+            Slider(
+                value = shown,
+                onValueChange = { dragValue = it },
+                onValueChangeFinished = {
+                    // The lambda closes over the state object, so this reads the last drag value.
+                    val finished = dragValue ?: shown
+                    dragValue = null
+                    onCommit(snapToStep(finished, min, max, step))
+                },
+                valueRange = lower..upper,
+                steps = sliderSteps(min, max, step),
+                enabled = enabled,
+                modifier = Modifier.fillMaxWidth(),
+            )
+        }
+    }
+}
+
+@Composable
+internal fun SeekBarPreferenceRow(
+    provider: ManagedPreferenceProvider,
+    ui: ManagedPreferenceUi.SeekBarInt,
+    revision: Int,
+    onChanged: () -> Unit,
+) {
+    val enabled = ui.isEnabled()
+    val value = remember(revision, ui.key) {
+        provider.readPref(ui.key) as? Int ?: ui.defaultValue
+    }
+    PreferenceCard(enabled = enabled) {
+        ManagedIntSlider(
+            label = stringResource(ui.title),
+            isTitle = true,
+            persistedValue = value,
+            defaultValue = ui.defaultValue,
+            unit = ui.unit,
+            defaultLabel = ui.defaultLabel,
+            min = ui.min,
+            max = ui.max,
+            step = ui.step,
+            enabled = enabled,
+            onCommit = { committed ->
+                provider.writePref(ui.key, committed)
+                onChanged()
+            },
+        )
+    }
+}
+
+@Composable
+internal fun TwinSeekBarPreferenceRow(
+    provider: ManagedPreferenceProvider,
+    ui: ManagedPreferenceUi.TwinSeekBarInt,
+    revision: Int,
+    onChanged: () -> Unit,
+) {
+    val enabled = ui.isEnabled()
+    val primary = remember(revision, ui.key) {
+        provider.readPref(ui.key) as? Int ?: ui.defaultValue
+    }
+    val secondary = remember(revision, ui.secondaryKey) {
+        provider.readPref(ui.secondaryKey) as? Int ?: ui.secondaryDefaultValue
+    }
+    PreferenceCard(enabled = enabled) {
+        Text(
+            text = stringResource(ui.title),
+            style = MaterialTheme.typography.titleMedium,
+            fontWeight = FontWeight.Bold,
+            color = if (enabled) MaterialTheme.colorScheme.onSurface
+            else MaterialTheme.colorScheme.onSurface.copy(alpha = 0.38f),
+            modifier = Modifier.padding(top = 4.dp),
+        )
+        ManagedIntSlider(
+            label = stringResource(ui.label),
+            isTitle = false,
+            persistedValue = primary,
+            defaultValue = ui.defaultValue,
+            unit = ui.unit,
+            defaultLabel = ui.defaultLabel,
+            min = ui.min,
+            max = ui.max,
+            step = ui.step,
+            enabled = enabled,
+            onCommit = { committed ->
+                provider.writePref(ui.key, committed)
+                onChanged()
+            },
+        )
+        ManagedIntSlider(
+            label = stringResource(ui.secondaryLabel),
+            isTitle = false,
+            persistedValue = secondary,
+            defaultValue = ui.secondaryDefaultValue,
+            unit = ui.unit,
+            defaultLabel = ui.defaultLabel,
+            min = ui.min,
+            max = ui.max,
+            step = ui.step,
+            enabled = enabled,
+            onCommit = { committed ->
+                provider.writePref(ui.secondaryKey, committed)
+                onChanged()
+            },
+        )
+    }
+}
+
+/* ----------------------------------------------------------------- edit dialog */
+
+@Composable
+internal fun EditIntPreferenceRow(
+    provider: ManagedPreferenceProvider,
+    ui: ManagedPreferenceUi.EditTextInt,
+    revision: Int,
+    onOpen: () -> Unit,
+) {
+    val value = remember(revision, ui.key) {
+        provider.readPref(ui.key) as? Int ?: ui.defaultValue
+    }
+    ValuePreferenceRow(
+        title = stringResource(ui.title),
+        summary = formatIntValue(value, ui.unit),
+        enabled = ui.isEnabled(),
+        onClick = onOpen,
+    )
+}
+
+/**
+ * Free text integer editor for ranges that are too wide for a slider (e.g. the clipboard
+ * history limit, whose maximum is `Int.MAX_VALUE`). Values outside `min..max` cannot be
+ * confirmed, mirroring `EditTextIntPreference` which clamps rejected input.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+internal fun EditIntDialog(
+    provider: ManagedPreferenceProvider,
+    ui: ManagedPreferenceUi.EditTextInt,
+    onDismiss: () -> Unit,
+    onChanged: () -> Unit,
+) {
+    val scheme = MaterialTheme.colorScheme
+    val current = remember(ui.key) { provider.readPref(ui.key) as? Int ?: ui.defaultValue }
+    var text by remember(ui.key) { mutableStateOf(current.toString()) }
+    val parsed = text.toIntOrNull()
+    val valid = parsed != null && parsed in ui.min..ui.max
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(ui.title)) },
+        text = {
+            Column {
+                OutlinedTextField(
+                    value = text,
+                    onValueChange = { text = it },
+                    modifier = Modifier.fillMaxWidth(),
+                    singleLine = true,
+                    isError = !valid,
+                    // A digits only IME cannot produce the leading minus of a negative minimum.
+                    keyboardOptions = KeyboardOptions(
+                        keyboardType = if (ui.min < 0) KeyboardType.Text else KeyboardType.Number
+                    ),
+                    suffix = { if (ui.unit.isNotEmpty()) Text(ui.unit) },
+                )
+                if (!valid) {
+                    Text(
+                        text = stringResource(R.string.invalid_value),
+                        style = MaterialTheme.typography.labelMedium,
+                        color = scheme.error,
+                        modifier = Modifier.padding(start = 16.dp, top = 6.dp),
+                    )
+                }
+            }
+        },
+        confirmButton = {
+            TextButton(
+                enabled = valid,
+                onClick = {
+                    val value = parsed ?: return@TextButton
+                    provider.writePref(ui.key, value)
+                    onChanged()
+                    onDismiss()
+                },
+            ) { Text(stringResource(android.R.string.ok)) }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) { Text(stringResource(android.R.string.cancel)) }
+        },
+    )
+}
