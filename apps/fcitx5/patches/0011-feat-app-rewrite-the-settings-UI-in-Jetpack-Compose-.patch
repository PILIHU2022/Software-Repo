+import androidx.core.content.ContextCompat
+
+/**
+ * Material 3 Expressive theme for the settings UI.
+ *
+ * Expressive character comes from [MaterialExpressiveTheme] and its expressive motion
+ * scheme (spring based, overshoot on spatial motion) plus the larger corner scale below.
+ * Android 12+ picks up the user's wallpaper palette; older devices fall back to the same
+ * #769CDE baseline the native theme uses.
+ */
+@OptIn(ExperimentalMaterial3ExpressiveApi::class)
+@Composable
+fun FcitxSettingsTheme(
+    darkTheme: Boolean = isSystemInDarkTheme(),
+    dynamicColor: Boolean = true,
+    content: @Composable () -> Unit,
+) {
+    val context = LocalContext.current
+    val colorScheme: ColorScheme = when {
+        dynamicColor && Build.VERSION.SDK_INT >= Build.VERSION_CODES.S ->
+            if (darkTheme) dynamicDarkColorScheme(context) else dynamicLightColorScheme(context)
+
+        darkTheme -> darkColorScheme(
+            primary = Color(0xFFAEC6FF),
+            onPrimary = Color(0xFF0A2E5C),
+            primaryContainer = Color(0xFF2A4A7A),
+            onPrimaryContainer = Color(0xFFD8E2FF),
+            secondary = Color(0xFFBDC7DC),
+            tertiary = Color(0xFFD9BEE0),
+        )
+
+        else -> lightColorScheme(
+            primary = Color(0xFF455E91),
+            onPrimary = Color.White,
+            primaryContainer = Color(0xFFD8E2FF),
+            onPrimaryContainer = Color(0xFF001A41),
+            secondary = Color(0xFF575E71),
+            tertiary = Color(0xFF725572),
+        )
+    }
+
+    val shapes = Shapes(
+        extraSmall = RoundedCornerShape(8.dp),
+        small = RoundedCornerShape(12.dp),
+        medium = RoundedCornerShape(16.dp),
+        large = RoundedCornerShape(24.dp),
+        extraLarge = RoundedCornerShape(28.dp),
+    )
+
+    MaterialExpressiveTheme(
+        colorScheme = colorScheme,
+        motionScheme = MotionScheme.expressive(),
+        shapes = shapes,
+        content = content,
+    )
+}
+
+/** Resolves a color attribute from the current activity theme (for edge-to-edge bars). */
+internal fun resolveThemeColor(
+    context: android.content.Context,
+    attr: Int,
+    fallback: Color,
+): Color = runCatching {
+    val tv = android.util.TypedValue()
+    if (context.theme.resolveAttribute(attr, tv, true)) {
+        if (tv.resourceId != 0) Color(ContextCompat.getColor(context, tv.resourceId))
+        else Color(tv.data)
+    } else fallback
+}.getOrDefault(fallback)
