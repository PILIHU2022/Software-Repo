+/**
+ * Compose migration of [org.fcitx.fcitx5.android.ui.main.settings.stats.TypingStatsFragment]:
+ * the "Statistics & heatmap" page with the appearance section (heatmap palette + custom color)
+ * and the data & privacy section (tracking switch, reset action).
+ *
+ * Every statistic lives on the home page heatmap card, so the page stays short and does not
+ * repeat numbers.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun StatsScreen() {
+    val context = LocalContext.current
+    val statsPrefs = AppPrefs.getInstance().stats
+
+    // Mirrors TypingStatsFragment.onCreatePreferences: the manager is idempotent and init()
+    // also makes sure the "since install" anchor exists.
+    LaunchedEffect(Unit) {
+        TypingStatsManager.init(context)
+        TypingStatsManager.refresh()
+    }
+
+    // Hold the preference values as Compose state so palette/color/tracking changes made
+    // anywhere (including the IME side) re-render live. Same pattern as home/HeatmapCard.
+    var paletteRaw by remember { mutableStateOf(statsPrefs.palette.getValue()) }
+    var customColor by remember { mutableIntStateOf(statsPrefs.customColor.getValue()) }
+    var trackingEnabled by remember { mutableStateOf(statsPrefs.enabled.getValue()) }
+    var showPalettePicker by remember { mutableStateOf(false) }
+    var showResetDialog by remember { mutableStateOf(false) }
+
+    DisposableEffect(statsPrefs) {
+        val paletteListener =
+            ManagedPreference.OnChangeListener<String> { _, value -> paletteRaw = value }
+        val customColorListener =
+            ManagedPreference.OnChangeListener<Int> { _, value -> customColor = value }
+        val enabledListener =
+            ManagedPreference.OnChangeListener<Boolean> { _, value -> trackingEnabled = value }
+        statsPrefs.palette.registerOnChangeListener(paletteListener)
+        statsPrefs.customColor.registerOnChangeListener(customColorListener)
+        statsPrefs.enabled.registerOnChangeListener(enabledListener)
+        onDispose {
+            statsPrefs.palette.unregisterOnChangeListener(paletteListener)
+            statsPrefs.customColor.unregisterOnChangeListener(customColorListener)
+            statsPrefs.enabled.unregisterOnChangeListener(enabledListener)
+        }
+    }
+
+    // The legacy preferences key off the system dark mode; the Compose settings theme
+    // (FcitxSettingsTheme) defaults to isSystemInDarkTheme() as well.
+    val isDark = isSystemInDarkTheme()
+    val palette = remember(paletteRaw) { HeatmapPalette.fromStorage(paletteRaw) }
+    val colors = remember(palette, customColor, isDark) { palette.colors(customColor, isDark) }
+
+    SettingsScaffold(title = stringResource(R.string.stats_ui_title)) { padding ->
+        LazyColumn(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding),
+            contentPadding = PaddingValues(start = 16.dp, end = 16.dp, top = 4.dp, bottom = 32.dp),
+        ) {
+            item(key = "section-appearance") {
+                SectionLabel(stringResource(R.string.stats_ui_appearance))
+            }
+            item(key = "palette") {
+                SettingsRow(
+                    title = stringResource(R.string.stats_ui_palette),
+                    summary = stringResource(palette.stringRes),
+                    onClick = { showPalettePicker = true },
+                    trailing = { PaletteSwatches(colors) },
+                )
+            }
+            item(key = "custom-color") {
+                SettingsRow(
+                    title = stringResource(R.string.stats_ui_custom_color),
+                    summary = formatArgbHex(customColor),
+                    onClick = {
+                        // Reuse the legacy native picker dialog; it works fine from a
+                        // Compose host. Picking a custom color implies the custom palette.
+                        HeatmapColorPickerDialog.show(context, customColor) { color ->
+                            statsPrefs.customColor.setValue(color)
+                            statsPrefs.palette.setValue(HeatmapPalette.Custom.storageKey)
+                        }
+                    },
+                    trailing = { ColorDot(Color(customColor)) },
+                )
+            }
+            item(key = "section-data-privacy") {
+                SectionLabel(stringResource(R.string.stats_ui_data_privacy))
+            }
+            item(key = "tracking") {
+                SettingsRow(
+                    title = stringResource(R.string.stats_ui_tracking),
+                    summary = stringResource(R.string.stats_ui_tracking_summary),
+                    // Route through the manager so buffered counts are flushed before pausing.
+                    onClick = { TypingStatsManager.setEnabled(!trackingEnabled) },
+                    trailing = {
+                        Switch(
+                            checked = trackingEnabled,
+                            onCheckedChange = { TypingStatsManager.setEnabled(it) },
+                        )
+                    },
+                )
+            }
+            item(key = "reset") {
+                SettingsRow(
+                    title = stringResource(R.string.stats_ui_reset),
+                    onClick = { showResetDialog = true },
+                )
+            }
+        }
+    }
+
+    if (showPalettePicker) {
+        PalettePickerSheet(
+            current = palette,
+            customColor = customColor,
+            isDark = isDark,
+            onSelect = { entry ->
+                statsPrefs.palette.setValue(entry.storageKey)
+                showPalettePicker = false
+            },
+            onDismiss = { showPalettePicker = false },
+        )
+    }
+
+    if (showResetDialog) {
+        AlertDialog(
+            onDismissRequest = { showResetDialog = false },
+            title = { Text(stringResource(R.string.stats_ui_reset_title)) },
+            text = { Text(stringResource(R.string.stats_ui_reset_message)) },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        showResetDialog = false
+                        TypingStatsManager.reset()
+                        // reset() publishes the empty snapshot itself; refresh() covers a
+                        // concurrent flush race and keeps the tracking anchor up to date.
+                        TypingStatsManager.refresh()
+                        context.toast(R.string.stats_ui_reset_done)
+                    }
+                ) {
+                    Text(stringResource(R.string.stats_ui_reset))
+                }
+            },
+            dismissButton = {
+                TextButton(onClick = { showResetDialog = false }) {
+                    Text(stringResource(android.R.string.cancel))
+                }
+            },
+        )
+    }
+}
