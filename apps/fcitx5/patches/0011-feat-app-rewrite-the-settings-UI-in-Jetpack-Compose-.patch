+/**
+ * Fcitx RawConfig pages: global options (`global`), addon config (`addon/<uniqueName>`) and
+ * input method config (`im/<uniqueName>`).
+ *
+ * The descriptor tree comes from `raw["desc"]` exactly like `PreferenceScreenFactory`; every
+ * edit is applied to a deep copy of `raw["cfg"]` and pushed through the matching Fcitx setter.
+ * Saves are coalesced and serialized by a [Mutex], and a failed save restores the last config
+ * that was successfully persisted.
+ */
+@Composable
+fun RawConfigSettingsScreen(route: String) {
+    val spec = remember(route) { parseRawConfigRoute(route) }
+    val viewModel: SettingsViewModel = viewModel()
+    val fcitx = viewModel.fcitx
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val snackbarHostState = remember { SnackbarHostState() }
+    val saveMutex = remember(route) { Mutex() }
+    val scheduler = remember(route) { SaveScheduler() }
+    val hideKeyConfig = remember { AppPrefs.getInstance().advanced.hideKeyConfig.getValue() }
+
+    val fallbackTitle = when (spec) {
+        RawConfigRoute.Global -> stringResource(R.string.global_options)
+        is RawConfigRoute.Addon -> spec.uniqueName
+        is RawConfigRoute.Im -> spec.uniqueName
+        is RawConfigRoute.Unknown -> spec.route
+    }
+
+    var state by remember(route) {
+        mutableStateOf<RawConfigPageState>(RawConfigPageState.Loading)
+    }
+    var reloadKey by remember(route) { mutableIntStateOf(0) }
+    var saving by remember(route) { mutableStateOf(false) }
+
+    // Loading (and retrying) the daemon config. The last good config stays in `state` until
+    // the new one arrives, so unrelated recompositions never blank the page.
+    LaunchedEffect(route, reloadKey) {
+        state = RawConfigPageState.Loading
+        val result = runCatching { loadRawConfigPage(fcitx, spec, context) }
+        state = result.fold(
+            onSuccess = { page ->
+                if (page == null) {
+                    RawConfigPageState.Failure(
+                        fallbackTitle,
+                        context.getString(R.string.config_addon_not_loaded),
+                    )
+                } else {
+                    RawConfigPageState.Ready(
+                        title = page.title,
+                        desc = page.desc,
+                        cfg = page.cfg,
+                        lastGood = page.cfg.deepCopy(),
+                    )
+                }
+            },
+            onFailure = { error ->
+                if (error is CancellationException) throw error
+                RawConfigPageState.Failure(
+                    fallbackTitle,
+                    error.localizedMessage ?: error.toString(),
+                )
+            },
+        )
+    }
+
+    suspend fun persist(cfg: RawConfig) {
+        saveMutex.withLock {
+            fcitx.runOnReady {
+                when (spec) {
+                    RawConfigRoute.Global -> setGlobalConfig(cfg)
+                    is RawConfigRoute.Addon -> setAddonConfig(spec.uniqueName, cfg)
+                    is RawConfigRoute.Im -> setImConfig(spec.uniqueName, cfg)
+                    is RawConfigRoute.Unknown -> error("Unsupported RawConfig route: ${spec.route}")
+                }
+            }
+        }
+    }
+
+    fun requestSave() {
+        scheduler.dirty = true
+        if (scheduler.job?.isActive == true) return
+        scheduler.job = scope.launch {
+            saving = true
+            try {
+                while (scheduler.dirty) {
+                    scheduler.dirty = false
+                    val ready = state as? RawConfigPageState.Ready ?: break
+                    val snapshot = ready.cfg
+                    val result = runCatching { persist(snapshot.deepCopy()) }
+                    if (result.isSuccess) {
+                        val now = state
+                        // Guard against a reload having swapped the page while saving.
+                        if (now is RawConfigPageState.Ready && now.desc === ready.desc) {
+                            state = now.copy(lastGood = snapshot)
+                        }
+                    } else {
+                        val error = result.exceptionOrNull()!!
+                        if (error is CancellationException) throw error
+                        val now = state
+                        // Only roll back when this save is still the newest edit, so edits
+                        // made while the save was in flight aren't silently discarded.
+                        if (now is RawConfigPageState.Ready && now.cfg === snapshot) {
+                            state = now.copy(cfg = now.lastGood)
+                        }
+                        scope.launch {
+                            snackbarHostState.showSnackbar(
+                                error.localizedMessage ?: error.toString()
+                            )
+                        }
+                    }
+                }
+            } finally {
+                saving = false
+            }
+        }
+    }
+
+    fun updateValue(path: List<String>, newValue: String) {
+        val ready = state as? RawConfigPageState.Ready ?: return
+        val newCfg = ready.cfg.deepCopy()
+        val node = newCfg.getOrCreateByPath(path)
+        if (node.value == newValue) return
+        node.value = newValue
+        state = ready.copy(cfg = newCfg)
+        requestSave()
+    }
+
+    val onError: (Throwable) -> Unit = { error ->
+        scope.launch {
+            snackbarHostState.showSnackbar(error.localizedMessage ?: error.toString())
+        }
+    }
+
+    val title = when (val current = state) {
+        RawConfigPageState.Loading -> fallbackTitle
+        is RawConfigPageState.Failure -> current.title
+        is RawConfigPageState.Ready -> current.title
+    }
+
+    SettingsScaffold(
+        title = title,
+        actions = {
+            if (saving) {
+                CircularProgressIndicator(
+                    modifier = Modifier
+                        .padding(end = 16.dp)
+                        .size(22.dp),
+                    strokeWidth = 2.dp,
+                )
+            }
+        },
+    ) { padding ->
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(padding),
+        ) {
+            when (val current = state) {
+                RawConfigPageState.Loading -> LoadingContent()
+
+                is RawConfigPageState.Failure -> FailureContent(
+                    message = current.message,
+                    onRetry = { reloadKey += 1 },
+                )
+
+                is RawConfigPageState.Ready -> ReadyContent(
+                    ready = current,
+                    hideKeyConfig = hideKeyConfig,
+                    onValueChange = ::updateValue,
+                    onError = onError,
+                )
+            }
+            SnackbarHost(
+                hostState = snackbarHostState,
+                modifier = Modifier
+                    .align(Alignment.BottomCenter)
+                    .padding(16.dp),
+            )
+        }
+    }
+}
