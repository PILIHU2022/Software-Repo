+++ b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/Preferences.kt
@@ -11,6 +11,8 @@ import androidx.compose.foundation.layout.fillMaxSize
 import androidx.compose.foundation.layout.padding
 import androidx.compose.foundation.lazy.LazyColumn
 import androidx.compose.foundation.lazy.items
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.rounded.Handyman
 import androidx.compose.runtime.Composable
 import androidx.compose.runtime.getValue
 import androidx.compose.runtime.mutableIntStateOf
@@ -25,7 +27,9 @@ import org.fcitx.fcitx5.android.R
 import org.fcitx.fcitx5.android.data.prefs.AppPrefs
 import org.fcitx.fcitx5.android.data.prefs.ManagedPreferenceProvider
 import org.fcitx.fcitx5.android.data.prefs.ManagedPreferenceUi
+import org.fcitx.fcitx5.android.ui.main.compose.LocalSettingsNavigator
 import org.fcitx.fcitx5.android.ui.main.compose.SettingsRoutes
+import org.fcitx.fcitx5.android.ui.main.compose.components.SettingsRow
 import org.fcitx.fcitx5.android.ui.main.compose.components.SettingsScaffold
 
 /**
@@ -44,7 +48,11 @@ import org.fcitx.fcitx5.android.ui.main.compose.components.SettingsScaffold
 fun PreferenceSettingsScreen(route: String) {
     val provider = remember(route) { providerFor(route) }
     if (provider != null) {
-        PreferenceSettingsContent(provider = provider, title = stringResource(titleFor(route)))
+        PreferenceSettingsContent(
+            provider = provider,
+            title = stringResource(titleFor(route)),
+            route = route,
+        )
     } else {
         // SettingsDestination only sends the five routes below here; keep the page total anyway.
         SettingsScaffold(title = route) { padding ->
@@ -54,8 +62,13 @@ fun PreferenceSettingsScreen(route: String) {
 }
 
 @Composable
-private fun PreferenceSettingsContent(provider: ManagedPreferenceProvider, title: String) {
+private fun PreferenceSettingsContent(
+    provider: ManagedPreferenceProvider,
+    title: String,
+    route: String,
+) {
     val context = LocalContext.current
+    val navigator = LocalSettingsNavigator.current
     var revision by remember { mutableIntStateOf(0) }
     var optionSheetKey by remember { mutableStateOf<String?>(null) }
     var editDialogKey by remember { mutableStateOf<String?>(null) }
@@ -111,6 +124,20 @@ private fun PreferenceSettingsContent(provider: ManagedPreferenceProvider, title
                     else -> Unit
                 }
             }
+
+            if (route == SettingsRoutes.ADVANCED) {
+                // The managed-preference model does not cover the data-management rows
+                // (export/import, automatic backups, all-files access, Syncthing Rime
+                // profile). Keep a working path to the legacy page that still hosts them.
+                item(key = "legacy_advanced") {
+                    SettingsRow(
+                        title = stringResource(R.string.advanced_legacy_title),
+                        summary = stringResource(R.string.advanced_legacy_summary),
+                        icon = Icons.Rounded.Handyman,
+                        onClick = { navigator.openNative(SettingsRoutes.ADVANCED) },
+                    )
+                }
+            }
         }
     }
 
