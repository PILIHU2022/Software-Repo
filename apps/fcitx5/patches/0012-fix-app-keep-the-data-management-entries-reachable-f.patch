From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DeepSeek Harness <noreply@deepseek.com>
Date: Sat, 21 Nov 2026 10:53:47 +0800
Subject: [PATCH] fix(app): keep the data-management entries reachable from
 Compose advanced

The Compose rewrite of the settings UI replaced the Advanced page with the
managed-preference list, which does not cover the custom rows the legacy
AdvancedSettingsFragment hosts: export/import user data, automatic backups,
all-files access, browse user data directory and the Syncthing Rime profile.

Append a 'Classic advanced settings' row to the Compose Advanced page and map
the advanced route to SettingsRoute.Advanced in MainActivity.nativeRouteFor.

Also send NativeSettingsActivity an ACTION_RUN intent when a route is known:
ACTION_MAIN drops the route extra and, while a setup page is pending (Fcitx5
not the default IME), detours through SetupActivity instead of opening the
requested page.
---
 .../fcitx5/android/ui/main/MainActivity.kt    | 13 ++++++--
 .../ui/main/compose/screens/Preferences.kt    | 31 +++++++++++++++++--
 .../main/res/values-zh-rCN/strings_home.xml   |  2 ++
 .../main/res/values-zh-rTW/strings_home.xml   |  2 ++
 app/src/main/res/values/strings_home.xml      |  2 ++
 5 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/MainActivity.kt b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/MainActivity.kt
index 6a86dd8e..a31eb68e 100644
--- a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/MainActivity.kt
+++ b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/MainActivity.kt
@@ -65,9 +65,14 @@ class MainActivity : ComponentActivity() {
     }
 
     private fun openNativeSettings(route: String) {
+        val nativeRoute = nativeRouteFor(route)
         val intent = Intent(this, NativeSettingsActivity::class.java).apply {
-            setAction(Intent.ACTION_MAIN)
-            nativeRouteFor(route)?.let { putExtra(EXTRA_SETTINGS_ROUTE, it) }
+            // ACTION_RUN makes NativeSettingsActivity navigate straight to the requested
+            // fragment. ACTION_MAIN would drop the route and (when a setup page is still
+            // pending, e.g. Fcitx5 is not the default IME) send the user to SetupActivity
+            // instead of the page they tapped.
+            setAction(Intent.ACTION_RUN)
+            if (nativeRoute != null) putExtra(EXTRA_SETTINGS_ROUTE, nativeRoute)
         }
         startActivity(intent)
     }
@@ -85,6 +90,10 @@ class MainActivity : ComponentActivity() {
         "developer" -> SettingsRoute.Developer
         "about" -> SettingsRoute.About
         "license" -> SettingsRoute.License
+        // The Compose "Advanced" page only renders managed preferences. The legacy page also
+        // hosts the data-management rows (export/import user data, automatic backups, all-files
+        // access, Syncthing Rime profile), so the Compose page links to it explicitly.
+        "advanced" -> SettingsRoute.Advanced
         else -> null
     }
 
diff --git a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/Preferences.kt b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/compose/screens/Preferences.kt
index 4da02311..3ab4779f 100644
