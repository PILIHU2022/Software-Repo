+
+    /**
+     * Hide the day tooltip bubble if it is showing.
+     *
+     * The view already dismisses the bubble on scroll, touch cancel, rotation, window visibility
+     * changes and detach; hosts that recycle or unbind the view should call this as well.
+     */
+    fun dismissTooltip() {
+        val popup = tooltipPopup ?: return
+        if (popup.isShowing) popup.dismiss()
+    }
+
+    /**
+     * Show, or move, the GitHub-style bubble for one tapped [cell].
+     *
+     * GitHub anchors its contribution tooltip in a separate window, so this one is a [PopupWindow]
+     * placed in window coordinates. The bubble is centered on the cell and clamped to the visible
+     * window. It prefers the space above the cell, with the notch pointing down at it; when the
+     * first weekday rows leave no room there it flips below the cell, notch pointing up, so the
+     * bubble is never clipped by the status bar.
+     */
+    private fun showDayTooltip(cell: DayCell, count: Long) {
+        if (!isAttachedToWindow || windowToken == null) return
+        val bubble = tooltipBubble ?: HeatmapTooltipView(context).also { tooltipBubble = it }
+        bubble.text = dayTooltipText(cell.date, count)
+        val popup = tooltipPopup ?: createTooltipPopup(bubble)
+
+        // The popup window is a child of the window hosting the heatmap, while
+        // getWindowVisibleDisplayFrame() reports screen coordinates, so convert it by the
+        // difference between the two origins before using it for clamping.
+        val visible = Rect().also { getWindowVisibleDisplayFrame(it) }
+        val onScreen = IntArray(2).also { getLocationOnScreen(it) }
+        val inWindow = IntArray(2).also { getLocationInWindow(it) }
+        visible.offset(inWindow[0] - onScreen[0], inWindow[1] - onScreen[1])
+
+        val margin = dp(TOOLTIP_SCREEN_MARGIN_DP).roundToInt()
+        val maxBubbleWidth = max(
+            visible.width() - 2 * margin,
+            dp(TOOLTIP_MIN_BUBBLE_WIDTH_DP).roundToInt()
+        )
+        bubble.maxBubbleWidth = maxBubbleWidth
+        bubble.measure(
+            MeasureSpec.makeMeasureSpec(maxBubbleWidth, MeasureSpec.AT_MOST),
+            MeasureSpec.makeMeasureSpec(visible.height(), MeasureSpec.AT_MOST)
+        )
+        val bubbleWidth = bubble.measuredWidth
+        val bubbleHeight = bubble.measuredHeight
+        val tipInset = bubble.arrowTipInsetPx
+
+        val gap = dp(TOOLTIP_GAP_DP)
+        val cellCenterX = inWindow[0] + gridLeft + cell.week * step + cellSize / 2f
+        val cellTop = inWindow[1] + gridTop + cell.row * step
+        val cellBottom = cellTop + cellSize
+        // Aim the notch tip at `gap` from the cell, so account for how deep the tip sits in the
+        // measured bounds on the arrow side.
+        val aboveTop = cellTop - gap - bubbleHeight + tipInset
+        val belowTop = cellBottom + gap - tipInset
+        bubble.arrowDown = aboveTop >= visible.top.toFloat()
+
+        val left = (cellCenterX - bubbleWidth / 2f).roundToInt().coerceIn(
+            visible.left + margin,
+            max(visible.right - margin - bubbleWidth, visible.left + margin)
+        )
+        // Point the notch at the cell even when the bubble had to be clamped to the window edge.
+        bubble.arrowCenterX = cellCenterX - left
+        val top = if (bubble.arrowDown) {
+            aboveTop.roundToInt()
+        } else {
+            belowTop.roundToInt()
+                .coerceAtMost(visible.bottom - bubbleHeight)
+                .coerceAtLeast(visible.top)
+        }
+
+        popup.width = bubbleWidth
+        popup.height = bubbleHeight
+        if (popup.isShowing) {
+            popup.update(left, top, bubbleWidth, bubbleHeight)
+        } else {
+            popup.showAtLocation(this, Gravity.NO_GRAVITY, left, top)
+        }
+    }
+
+    private fun createTooltipPopup(bubble: HeatmapTooltipView): PopupWindow =
+        PopupWindow(
+            bubble,
+            ViewGroup.LayoutParams.WRAP_CONTENT,
+            ViewGroup.LayoutParams.WRAP_CONTENT,
+            true
+        ).apply {
+            // A popup only gets outside touches (and therefore dismisses) with a background; the
+            // bubble paints itself, so the window background has to stay transparent. PopupWindow
+            // elevation is deliberately left at 0: with a transparent background the window manager
+            // would shadow the rectangular window bounds instead of the rounded bubble, so
+            // HeatmapTooltipView paints its own soft shadow.
+            setBackgroundDrawable(ColorDrawable(Color.TRANSPARENT))
+            isOutsideTouchable = true
+            isFocusable = true
+            // Without clipping the window manager cannot silently drag the notch off its cell.
+            isClippingEnabled = false
+            inputMethodMode = PopupWindow.INPUT_METHOD_NOT_NEEDED
+        }.also { tooltipPopup = it }
