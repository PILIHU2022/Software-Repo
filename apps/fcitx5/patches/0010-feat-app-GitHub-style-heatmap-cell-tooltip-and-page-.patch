+import kotlin.math.roundToInt
+
+/**
+ * GitHub-style tooltip bubble shown for a tapped [ContributionHeatmapView] day cell.
+ *
+ * Anchoring rules: the bubble is drawn with a small triangular notch on one edge, always centered
+ * on the bubble's horizontal axis so it can point at the cell the host anchors it to.
+ *
+ * - [arrowDown] `true` (the normal case): the bubble floats *above* the cell, the notch is on the
+ *   bottom edge and its tip points down at the cell.
+ * - [arrowDown] `false`: the bubble floats *below* the cell, used when there is not enough room
+ *   above it (e.g. the first weekday rows right under the status bar); the notch is on the top edge
+ *   and points up.
+ *
+ * The bubble never positions itself: the host sets [text] and [maxBubbleWidth], measures the view
+ * to learn its exact size, then places the popup so that the notch tip is a few dp above/below the
+ * cell and the bubble stays inside the visible window. [arrowTipInsetPx] tells the host how far the
+ * tip sits inside the measured bounds, so the visible gap does not depend on the shadow padding.
+ *
+ * Styling follows GitHub's contribution tooltip: near-black (deliberately independent of the app
+ * theme, like GitHub's bubble in both light and dark mode), rounded corners, no border, white
+ * centered text of one or two lines. [onDraw] does not allocate.
+ */
+class HeatmapTooltipView(context: Context) : View(context) {
+
+    /** Text of the bubble; it is laid out again (1 to [MAX_LINES] lines) on the next measure. */
+    var text: CharSequence = ""
+        set(value) {
+            field = value
+            invalidate()
+        }
+
+    /** `true`: notch on the bottom edge (bubble above the cell); `false`: notch on the top edge. */
+    var arrowDown: Boolean = true
+        set(value) {
+            field = value
+            invalidate()
+        }
+
+    /**
+     * Horizontal center of the notch in view-local pixels, or `-1` to center it on the bubble.
+     *
+     * The host passes the cell center converted to bubble-local coordinates so the notch keeps
+     * pointing at the tapped cell even when the bubble itself had to be clamped to the screen
+     * edge; the value is clamped so the notch never overlaps the rounded corners.
+     */
+    var arrowCenterX: Float = -1f
+        set(value) {
+            field = value
+            invalidate()
+        }
+
+    /**
+     * Upper bound in pixels for the measured bubble, shadow padding included (`0` = no bound).
+     * Text that does not fit wraps onto a second line instead of growing off screen.
+     */
+    var maxBubbleWidth: Int = 0
+        set(value) {
+            field = value
+            requestLayout()
+            invalidate()
+        }
+
+    /** Distance in pixels between the notch tip and the nearest view bound on the arrow side. */
+    val arrowTipInsetPx: Float get() = shadowExtent
+
+    private val textPaint = TextPaint(Paint.ANTI_ALIAS_FLAG or Paint.SUBPIXEL_TEXT_FLAG).apply {
+        textSize = sp(TEXT_SIZE_SP)
+        color = ContextCompat.getColor(context, R.color.heatmap_tooltip_foreground)
+    }
+
+    private val bubblePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.FILL
+        color = ContextCompat.getColor(context, R.color.heatmap_tooltip_background)
+    }
+
+    private val shadowPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.FILL
+    }
+
+    private val cornerRadius = dp(CORNER_RADIUS_DP)
+    private val arrowWidth = dp(ARROW_WIDTH_DP)
+    private val arrowHeight = dp(ARROW_HEIGHT_DP)
+    private val horizontalPadding = dp(PADDING_HORIZONTAL_DP)
+    private val verticalPadding = dp(PADDING_VERTICAL_DP)
+    private val shadowOffset = dp(SHADOW_OFFSET_DP)
+    private val shadowSpread = dp(SHADOW_SPREAD_DP)
+
+    /**
+     * Room the soft shadow needs on every side. The extra half pixel keeps the outermost, barely
+     * opaque edge inside the view bounds instead of letting it be clipped on one side.
+     */
+    private val shadowExtent = shadowSpread + shadowOffset + dp(0.5f)
+
+    private var textLayout: StaticLayout? = null
+    private val bubbleRect = RectF()
+    private val shadowRect = RectF()
+    private val bubblePath = Path()
+
+    init {
+        // A transient visual hint, not an interactive node: keep it out of the accessibility tree
+        // so TalkBack is never pulled into a popup that disappears on the next touch.
+        importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val horizontalInset = (horizontalPadding + shadowExtent).roundToInt()
+        val maxTextWidth = if (maxBubbleWidth > 0) {
+            max(maxBubbleWidth - 2 * horizontalInset, 1)
+        } else {
+            Int.MAX_VALUE
+        }
+        val desiredWidth = textPaint.measureText(text, 0, text.length).roundToInt()
+        val layout = buildTextLayout(text, desiredWidth.coerceIn(1, maxTextWidth))
+        textLayout = layout
+        val width = layout.width + 2 * horizontalInset
+        val height = layout.height + 2 * (verticalPadding + shadowExtent).roundToInt() +
+            arrowHeight.roundToInt()
+        setMeasuredDimension(
+            resolveSize(width, widthMeasureSpec),
+            resolveSize(height, heightMeasureSpec)
+        )
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        val layout = textLayout ?: return
+        val w = width.toFloat()
+        val h = height.toFloat()
+        val tipDown = arrowDown
+        val left = shadowExtent
+        val right = w - shadowExtent
+        // Leave room for the notch on its own edge; the other edge only keeps the shadow inside.
+        val top = shadowExtent + if (tipDown) 0f else arrowHeight
+        val bottom = h - shadowExtent - if (tipDown) arrowHeight else 0f
+        bubbleRect.set(left, top, right, bottom)
+
+        // Hardware canvases only honor Paint#shadowLayer for text, so GitHub's soft elevation is
+        // faked with two translucent rounded rings below the bubble.
+        shadowRect.set(bubbleRect)
+        shadowRect.offset(0f, shadowOffset)
+        shadowRect.inset(-shadowSpread, -shadowSpread)
+        shadowPaint.color = SHADOW_COLOR_OUTER
+        canvas.drawRoundRect(
+            shadowRect,
+            cornerRadius + shadowSpread,
+            cornerRadius + shadowSpread,
+            shadowPaint
+        )
+        shadowRect.inset(shadowSpread / 2f, shadowSpread / 2f)
+        shadowPaint.color = SHADOW_COLOR_INNER
+        canvas.drawRoundRect(
+            shadowRect,
+            cornerRadius + shadowSpread / 2f,
+            cornerRadius + shadowSpread / 2f,
+            shadowPaint
+        )
+
+        // Body and notch share one path so they fill as a single continuous shape (no seam).
+        val halfArrow = arrowWidth / 2f
+        // Keep the notch on the straight part of the edge: rounded corners + a little slack.
+        val minCenterX = bubbleRect.left + cornerRadius + halfArrow
+        val maxCenterX = bubbleRect.right - cornerRadius - halfArrow
+        val centerX = if (arrowCenterX >= 0f) {
+            arrowCenterX.coerceIn(minCenterX, maxCenterX)
+        } else {
+            w / 2f
+        }
+        bubblePath.reset()
+        bubblePath.addRoundRect(bubbleRect, cornerRadius, cornerRadius, Path.Direction.CW)
+        if (tipDown) {
+            bubblePath.moveTo(centerX - halfArrow, bottom)
+            bubblePath.lineTo(centerX + halfArrow, bottom)
+            bubblePath.lineTo(centerX, bottom + arrowHeight)
+        } else {
+            bubblePath.moveTo(centerX - halfArrow, top)
+            bubblePath.lineTo(centerX, top - arrowHeight)
+            bubblePath.lineTo(centerX + halfArrow, top)
+        }
+        bubblePath.close()
+        canvas.drawPath(bubblePath, bubblePaint)
+
+        // The layout already centers its (possibly two) lines; center the laid out block as well.
+        canvas.save()
+        canvas.translate((w - layout.width) / 2f, top + verticalPadding)
+        layout.draw(canvas)
+        canvas.restore()
+    }
+
+    private fun buildTextLayout(source: CharSequence, width: Int): StaticLayout =
+        StaticLayout.Builder.obtain(source, 0, source.length, textPaint, width)
+            .setAlignment(Layout.Alignment.ALIGN_CENTER)
+            .setTextDirection(TextDirectionHeuristics.FIRSTSTRONG_LTR)
+            .setMaxLines(MAX_LINES)
+            .setEllipsize(TextUtils.TruncateAt.END)
+            .setIncludePad(false)
+            .build()
+
+    private fun dp(value: Float): Float = TypedValue.applyDimension(
+        TypedValue.COMPLEX_UNIT_DIP, value, resources.displayMetrics
+    )
+
+    private fun sp(value: Float): Float = TypedValue.applyDimension(
+        TypedValue.COMPLEX_UNIT_SP, value, resources.displayMetrics
+    )
+
+    companion object {
+        private const val TEXT_SIZE_SP = 12.5f
+        private const val MAX_LINES = 2
+        private const val CORNER_RADIUS_DP = 8f
+        private const val ARROW_WIDTH_DP = 12f
+        private const val ARROW_HEIGHT_DP = 6f
+        private const val PADDING_HORIZONTAL_DP = 10f
+        private const val PADDING_VERTICAL_DP = 6f
+        private const val SHADOW_OFFSET_DP = 1f
+        private const val SHADOW_SPREAD_DP = 1.5f
+        private const val SHADOW_COLOR_OUTER = 0x0A000000
+        private const val SHADOW_COLOR_INNER = 0x14000000
+    }
+}
