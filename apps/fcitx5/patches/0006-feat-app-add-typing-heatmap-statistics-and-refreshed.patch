+package org.fcitx.fcitx5.android.ui.main.settings.stats
+
+import android.content.Context
+import android.content.res.ColorStateList
+import android.graphics.drawable.GradientDrawable
+import android.util.AttributeSet
+import android.view.View
+import android.widget.TextView
+import androidx.appcompat.app.AlertDialog
+import androidx.preference.Preference
+import androidx.preference.PreferenceViewHolder
+import org.fcitx.fcitx5.android.R
+import org.fcitx.fcitx5.android.data.prefs.AppPrefs
+import org.fcitx.fcitx5.android.ui.main.heatmap.HeatmapPalette
+import org.fcitx.fcitx5.android.utils.isDarkMode
+
+/**
+ * Preference row for the heatmap color palette.
+ *
+ * The row shows the title, the name of the current palette (plus the hex value for
+ * [HeatmapPalette.Custom]) and the five actual heatmap shades of the current theme.
+ * Tapping it opens a single-choice list of all [HeatmapPalette] entries.
+ *
+ * The preference is not backed by `SharedPreferences` itself; it reads and writes
+ * `AppPrefs.stats.palette` so the IME and the home page card stay in sync.
+ */
+class HeatmapPalettePreference @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+) : Preference(context, attrs) {
+
+    init {
+        layoutResource = R.layout.preference_heatmap_palette
+        isPersistent = false
+        isSingleLineTitle = false
+        isIconSpaceReserved = false
+        setTitle(R.string.stats_ui_palette)
+        // The custom layout owns the summary text; a non-null placeholder keeps
+        // androidx.preference from hiding the summary row in onBindViewHolder().
+        setSummary("")
+        setOnPreferenceClickListener {
+            showPalettePicker()
+            true
+        }
+    }
+
+    override fun onBindViewHolder(holder: PreferenceViewHolder) {
+        super.onBindViewHolder(holder)
+        bind(holder.itemView)
+    }
+
+    /**
+     * Repaint the bound row from the current preferences.
+     *
+     * Called by the screen after the custom color changed, so the swatches do not keep showing
+     * the previous ramp until the next rebind.
+     */
+    fun refresh() {
+        notifyChanged()
+    }
+
+    private fun bind(root: View) {
+        val prefs = AppPrefs.getInstance().stats
+        val palette = HeatmapPalette.fromStorage(prefs.palette.getValue())
+        val customColor = prefs.customColor.getValue()
+        val isDark = context.resources.configuration.isDarkMode()
+
+        root.findViewById<TextView>(android.R.id.title)?.setText(R.string.stats_ui_palette)
+        root.findViewById<TextView>(android.R.id.summary)?.apply {
+            visibility = View.VISIBLE
+            text = summary(palette, customColor)
+        }
+
+        val colors = palette.colors(customColor, isDark)
+        SWATCH_IDS.forEachIndexed { index, id ->
+            root.findViewById<View>(id)?.backgroundTintList =
+                ColorStateList.valueOf(colors.getOrElse(index) { colors.last() })
+        }
+    }
+
+    /**
+     * `current · other options`, so the row tells both the active palette (not just its color)
+     * and which palettes are available.
+     */
+    private fun summary(palette: HeatmapPalette, customColor: Int): CharSequence {
+        val currentName = context.getString(palette.stringRes)
+        val alternatives = HeatmapPalette.entries
+            .filter { it != palette }
+            .joinToString(" / ") { context.getString(it.stringRes) }
+        val custom = if (palette == HeatmapPalette.Custom) " ${formatArgbHex(customColor)}" else ""
+        return "$currentName$custom · $alternatives"
+    }
+
+    private fun showPalettePicker() {
+        val prefs = AppPrefs.getInstance().stats
+        val palettes = HeatmapPalette.entries
+        val labels = palettes
+            .map { context.getString(it.stringRes) as CharSequence }
+            .toTypedArray()
+        val current = HeatmapPalette.fromStorage(prefs.palette.getValue())
+        AlertDialog.Builder(context)
+            .setTitle(R.string.stats_ui_palette)
+            .setSingleChoiceItems(labels, palettes.indexOf(current)) { dialog, which ->
+                val selected = palettes[which]
+                prefs.palette.setValue(selected.storageKey)
+                dialog.dismiss()
+                notifyChanged()
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    companion object {
+        private val SWATCH_IDS = intArrayOf(
+            R.id.heatmap_palette_swatch_1,
+            R.id.heatmap_palette_swatch_2,
+            R.id.heatmap_palette_swatch_3,
+            R.id.heatmap_palette_swatch_4,
+            R.id.heatmap_palette_swatch_5,
+        )
+    }
+}
+
+/** A small filled circle used as the icon of the custom color preference. */
+internal fun colorDot(context: Context, color: Int, sizeDp: Float = 18f): GradientDrawable {
+    val size = (sizeDp * context.resources.displayMetrics.density).toInt().coerceAtLeast(1)
+    return GradientDrawable().apply {
+        shape = GradientDrawable.OVAL
+        setColor(color)
+        setStroke((context.resources.displayMetrics.density).toInt().coerceAtLeast(1), 0x33000000)
+        setSize(size, size)
+    }
+}
