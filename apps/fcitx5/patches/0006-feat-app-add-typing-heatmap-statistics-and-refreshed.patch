+
+import android.content.Context
+import android.content.res.Configuration
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.util.AttributeSet
+import android.util.TypedValue
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewTreeObserver
+import android.widget.HorizontalScrollView
+import androidx.annotation.AttrRes
+import androidx.annotation.ColorInt
+import androidx.core.content.ContextCompat
+import org.fcitx.fcitx5.android.R
+import org.fcitx.fcitx5.android.data.stats.TypingStatsMath
+import org.fcitx.fcitx5.android.utils.isDarkMode
+import org.fcitx.fcitx5.android.utils.toast
+import java.text.DateFormat
+import java.text.DateFormatSymbols
+import java.time.DayOfWeek
+import java.time.LocalDate
+import java.time.ZoneId
+import java.time.temporal.ChronoUnit
+import java.time.temporal.TemporalAdjusters
+import java.util.Date
+import java.util.Locale
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+
+/**
+ * GitHub-style contribution calendar for typing statistics.
+ *
+ * Columns are weeks (the 53 weeks ending with the current one), rows are weekdays
+ * (Monday first). The view renders itself at its natural size and is meant to live inside a
+ * [android.widget.HorizontalScrollView]; tapping a cell reports the day through
+ * [onDayClickListener].
+ */
+class ContributionHeatmapView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null
+) : View(context, attrs) {
+
+    /**
+     * Invoked when a day cell is tapped. The default implementation shows a toast with the
+     * localized date and the number of characters typed that day.
+     */
+    var onDayClickListener: ((LocalDate, Long) -> Unit)? = null
+
+    private var isDark: Boolean = context.resources.configuration.isDarkMode()
+    private var palette: HeatmapPalette = HeatmapPalette.Github
+    private var customColor: Int = 0xFF2DA44E.toInt()
+    private var colors: IntArray = HeatmapPalette.Github.colors(customColor, isDark)
+
+    private var counts: Map<LocalDate, Long> = emptyMap()
+    private var levels: Map<LocalDate, Int> = emptyMap()
+    private var totalCharacters: Long = 0L
+    private var hasData: Boolean = false
+
+    /** A gesture started on a day cell; we consume it even if the finger ends on a gap. */
+    private var trackingTap: Boolean = false
+
+    /** Keeps the "no data" hint centered on the visible part of the scrolled grid. */
+    private val scrollInvalidator = ViewTreeObserver.OnScrollChangedListener {
+        if (!hasData) invalidate()
+    }
+
+    private var cellSize = 0f
+    private var cellGap = 0f
+    private var cellRadius = 0f
+    private var labelGap = 0f
+    private var labelWidth = 0f
+    private var monthLabelHeight = 0f
+    private var monthBaseline = 0f
+    private var hintRadius = 0f
+    private var weekdayLabels: List<String> = emptyList()
+    private var shortMonths: Array<String> = emptyArray()
+
+    private val cellPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val outlinePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE
+    }
+    private val labelPaint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.SUBPIXEL_TEXT_FLAG)
+    private val hintTextPaint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.SUBPIXEL_TEXT_FLAG)
+    private val hintBackdropPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    private val defaultDayClickListener: (LocalDate, Long) -> Unit = { date, count ->
+        val dateText = if (date == LocalDate.now()) {
+            context.getString(R.string.heatmap_today)
+        } else {
+            val millis = date.atStartOfDay(ZoneId.systemDefault()).toInstant().toEpochMilli()
+            DateFormat.getDateInstance(DateFormat.MEDIUM, Locale.getDefault())
+                .format(Date(millis))
+        }
+        val countText = context.resources.getQuantityString(
+            R.plurals.heatmap_chars_count,
+            count.coerceIn(0L, 2L).toInt(),
+            formatCountCompact(count)
+        )
+        context.toast(context.getString(R.string.heatmap_day_tooltip, dateText, countText))
+    }
+
+    /** Screen-space left edge of the first cell column. */
+    private val gridLeft: Float get() = paddingLeft + labelWidth + labelGap
+
+    /** Screen-space top edge of the first cell row. */
+    private val gridTop: Float get() = paddingTop + monthLabelHeight
+
+    /** Distance between two adjacent cell origins. */
+    private val step: Float get() = cellSize + cellGap
+
+    init {
+        isClickable = true
+        importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_YES
+        refreshMetrics()
+        refreshThemeColors()
+        updateContentDescription()
+    }
+
+    /**
+     * Replace the rendered data.
+     *
+     * @param counts characters per day, keyed by local date
+     * @param palette selected color palette
+     * @param customColor ARGB color for [HeatmapPalette.Custom]
+     * @param isDark whether the surrounding theme is dark
+     */
+    fun setData(
+        counts: Map<LocalDate, Long>,
+        palette: HeatmapPalette,
+        customColor: Int,
+        isDark: Boolean
+    ) {
+        this.counts = counts
+        this.palette = palette
+        this.customColor = customColor
+        this.isDark = isDark
+        this.colors = palette.colors(customColor, isDark)
+        this.levels = if (counts.isEmpty()) emptyMap() else TypingStatsMath.heatmapLevels(counts)
+        this.totalCharacters = counts.values.sum()
+        this.hasData = counts.any { it.value > 0L }
+        refreshThemeColors()
+        updateContentDescription()
+        invalidate()
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val gridWidth = WEEKS * cellSize + (WEEKS - 1) * cellGap
+        val gridHeight = DAYS_PER_WEEK * cellSize + (DAYS_PER_WEEK - 1) * cellGap
+        val desiredWidth = (gridLeft + gridWidth + paddingRight).roundToInt()
+        val desiredHeight = (gridTop + gridHeight + paddingBottom).roundToInt()
+
+        val width = when (MeasureSpec.getMode(widthMeasureSpec)) {
+            MeasureSpec.EXACTLY -> MeasureSpec.getSize(widthMeasureSpec)
+            MeasureSpec.AT_MOST -> min(desiredWidth, MeasureSpec.getSize(widthMeasureSpec))
+            else -> desiredWidth
+        }
+        val height = resolveSize(desiredHeight, heightMeasureSpec)
+        setMeasuredDimension(
+            max(width, suggestedMinimumWidth),
+            max(height, suggestedMinimumHeight)
+        )
+    }
+
+    override fun onConfigurationChanged(newConfig: Configuration) {
+        super.onConfigurationChanged(newConfig)
+        isDark = newConfig.isDarkMode()
+        colors = palette.colors(customColor, isDark)
+        refreshMetrics()
+        refreshThemeColors()
+        requestLayout()
+        invalidate()
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        val today = LocalDate.now()
+        val firstMonday = firstMonday(today)
+        drawMonthLabels(canvas, firstMonday, today)
+        drawWeekdayLabels(canvas)
+        drawCells(canvas, firstMonday, today)
+        if (!hasData) drawNoDataHint(canvas)
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        viewTreeObserver.addOnScrollChangedListener(scrollInvalidator)
+    }
+
+    override fun onDetachedFromWindow() {
+        viewTreeObserver.removeOnScrollChangedListener(scrollInvalidator)
+        super.onDetachedFromWindow()
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                // Consume the whole grid area (gaps included) so taps on empty space do not
+                // reach the preference row and open the statistics screen by accident.
+                trackingTap = isInsideGrid(event.x, event.y)
+                if (trackingTap) return true
+            }
+
+            MotionEvent.ACTION_UP -> {
+                if (trackingTap) {
+                    trackingTap = false
+                    val date = dateAt(event.x, event.y)
+                    if (date != null) {
+                        performClick()
+                        val count = counts[date] ?: 0L
+                        (onDayClickListener ?: defaultDayClickListener).invoke(date, count)
+                    }
+                    return true
+                }
+            }
+
+            MotionEvent.ACTION_CANCEL -> {
+                if (trackingTap) {
+                    trackingTap = false
+                    return true
+                }
+            }
+        }
+        return super.onTouchEvent(event)
+    }
+
+    private fun firstMonday(today: LocalDate): LocalDate =
+        today.with(TemporalAdjusters.previousOrSame(DayOfWeek.MONDAY))
+            .minusWeeks((WEEKS - 1).toLong())
+
+    private fun drawMonthLabels(canvas: Canvas, firstMonday: LocalDate, today: LocalDate) {
+        val baseline = paddingTop + monthBaseline
+        var lastRight = Float.NEGATIVE_INFINITY
+        var lastMonth = -1
+        for (week in 0 until WEEKS) {
+            val monday = firstMonday.plusWeeks(week.toLong())
+            if (monday.isAfter(today)) break
+            if (monday.monthValue == lastMonth) continue
+            lastMonth = monday.monthValue
+            val label = shortMonths.getOrNull(monday.monthValue - 1) ?: continue
+            if (label.isEmpty()) continue
+            val x = gridLeft + week * step
+            // Never overlap the previous month label.
+            if (x < lastRight + labelGap) continue
+            canvas.drawText(label, x, baseline, labelPaint)
+            lastRight = x + labelPaint.measureText(label)
+        }
+    }
+
+    private fun drawWeekdayLabels(canvas: Canvas) {
+        val metrics = labelPaint.fontMetrics
+        val verticalCentering = cellSize / 2f - (metrics.ascent + metrics.descent) / 2f
+        WEEKDAY_ROWS.forEachIndexed { index, row ->
+            val text = weekdayLabels.getOrNull(index) ?: return@forEachIndexed
+            val y = gridTop + row * step + verticalCentering
+            val x = gridLeft - labelGap - labelPaint.measureText(text)
+            canvas.drawText(text, x, y, labelPaint)
+        }
+    }
+
+    private fun drawCells(canvas: Canvas, firstMonday: LocalDate, today: LocalDate) {
+        val left = gridLeft
+        val top = gridTop
+        val maxLevel = colors.size - 1
+        for (week in 0 until WEEKS) {
+            val monday = firstMonday.plusWeeks(week.toLong())
+            if (monday.isAfter(today)) break
+            val x = left + week * step
+            for (row in 0 until DAYS_PER_WEEK) {
+                val date = monday.plusDays(row.toLong())
+                // Draw the rest of the current week as empty cells, like GitHub does, so the
+                // grid keeps a rectangular silhouette instead of a ragged edge.
+                val level = if (date.isAfter(today)) {
+                    0
+                } else {
+                    (levels[date] ?: 0).coerceIn(0, maxLevel)
+                }
+                cellPaint.color = colors[level]
+                val y = top + row * step
+                canvas.drawRoundRect(
+                    x, y, x + cellSize, y + cellSize, cellRadius, cellRadius, cellPaint
+                )
+            }
+        }
+        drawTodayOutline(canvas, firstMonday, today)
+    }
+
+    private fun drawTodayOutline(canvas: Canvas, firstMonday: LocalDate, today: LocalDate) {
+        val thisMonday = today.with(TemporalAdjusters.previousOrSame(DayOfWeek.MONDAY))
+        val week = ChronoUnit.WEEKS.between(firstMonday, thisMonday).toInt()
+        val row = today.dayOfWeek.value - 1
+        if (week !in 0 until WEEKS || row !in 0 until DAYS_PER_WEEK) return
+        val x = gridLeft + week * step
+        val y = gridTop + row * step
+        canvas.drawRoundRect(x, y, x + cellSize, y + cellSize, cellRadius, cellRadius, outlinePaint)
+    }
+
+    private fun drawNoDataHint(canvas: Canvas) {
+        val text = context.getString(R.string.heatmap_no_data)
+        val textWidth = hintTextPaint.measureText(text)
+        val metrics = hintTextPaint.fontMetrics
+        val halfTextHeight = (metrics.descent - metrics.ascent) / 2f
+        val horizontalPadding = dp(HINT_PADDING_HORIZONTAL_DP)
+        val verticalPadding = dp(HINT_PADDING_VERTICAL_DP)
+
+        val gridWidth = WEEKS * cellSize + (WEEKS - 1) * cellGap
+        val gridHeight = DAYS_PER_WEEK * cellSize + (DAYS_PER_WEEK - 1) * cellGap
+        // Center the hint on the part of the grid that is actually visible: the full 53 weeks
+        // are wider than a phone screen, and the hint is the only content in this state.
+        val scroller = parent as? HorizontalScrollView
+        val visibleCenter = if (scroller != null && scroller.width > 0) {
+            scroller.scrollX + scroller.width / 2f
+        } else {
+            gridLeft + gridWidth / 2f
+        }
+        val halfWidth = textWidth / 2f + horizontalPadding
+        val minCenter = gridLeft + halfWidth
+        val maxCenter = gridLeft + gridWidth - halfWidth
+        val centerX = if (maxCenter >= minCenter) {
+            visibleCenter.coerceIn(minCenter, maxCenter)
+        } else {
+            (minCenter + maxCenter) / 2f
+        }
+        val centerY = gridTop + gridHeight / 2f
+
+        val backdrop = RectF(
+            centerX - textWidth / 2f - horizontalPadding,
+            centerY - halfTextHeight - verticalPadding,
+            centerX + textWidth / 2f + horizontalPadding,
+            centerY + halfTextHeight + verticalPadding
+        )
+        canvas.drawRoundRect(backdrop, hintRadius, hintRadius, hintBackdropPaint)
+        val baseline = centerY - (metrics.ascent + metrics.descent) / 2f
+        canvas.drawText(text, centerX - textWidth / 2f, baseline, hintTextPaint)
+    }
+
+    private fun isInsideGrid(x: Float, y: Float): Boolean {
+        val week = ((x - gridLeft) / step).toInt()
+        val row = ((y - gridTop) / step).toInt()
+        if (x < gridLeft || y < gridTop) return false
+        return week in 0 until WEEKS && row in 0 until DAYS_PER_WEEK
+    }
+
+    private fun dateAt(x: Float, y: Float): LocalDate? {
+        if (!isInsideGrid(x, y)) return null
+        val week = ((x - gridLeft) / step).toInt()
+        val row = ((y - gridTop) / step).toInt()
+        val today = LocalDate.now()
+        val date = firstMonday(today).plusWeeks(week.toLong()).plusDays(row.toLong())
+        return if (date.isAfter(today)) null else date
+    }
+
+    private fun refreshMetrics() {
+        cellSize = dp(CELL_SIZE_DP)
+        cellGap = dp(CELL_GAP_DP)
+        cellRadius = dp(CELL_RADIUS_DP)
+        labelGap = dp(LABEL_GAP_DP)
+        hintRadius = dp(HINT_RADIUS_DP)
+        outlinePaint.strokeWidth = dp(TODAY_STROKE_DP)
+        labelPaint.textSize = sp(LABEL_TEXT_SP)
+        hintTextPaint.textSize = sp(HINT_TEXT_SP)
+
+        val symbols = DateFormatSymbols.getInstance(Locale.getDefault())
+        shortMonths = symbols.shortMonths
+        val weekdays = symbols.shortWeekdays
+        // Calendar indexes weekdays 1 = Sunday .. 7 = Saturday, so Monday is 2.
+        weekdayLabels = WEEKDAY_ROWS.map { row -> weekdays.getOrNull(row + 2).orEmpty() }
+        labelWidth = weekdayLabels.maxOfOrNull { labelPaint.measureText(it) } ?: 0f
+
+        val metrics = labelPaint.fontMetrics
+        monthLabelHeight = (metrics.descent - metrics.ascent) + dp(MONTH_LABEL_BOTTOM_PADDING_DP)
+        monthBaseline = -metrics.ascent + dp(1f)
+    }
+
+    private fun refreshThemeColors() {
+        val fallbackSecondary = if (isDark) 0xFF9AA0A6.toInt() else 0xFF5F6368.toInt()
+        val secondary = resolveThemeColor(android.R.attr.textColorSecondary, fallbackSecondary)
+        labelPaint.color = secondary
+        hintTextPaint.color = secondary
+        hintBackdropPaint.color = colors[0]
+        val accent = resolveThemeColor(android.R.attr.colorAccent, colors[colors.size - 1])
+        outlinePaint.color = (accent and 0x00FFFFFF) or 0xCC000000.toInt()
+    }
+
+    private fun updateContentDescription() {
+        contentDescription = if (hasData) {
+            context.getString(
+                R.string.heatmap_summary_last_year,
+                formatCountCompact(totalCharacters)
+            )
+        } else {
+            context.getString(R.string.heatmap_no_data)
+        }
+    }
+
+    @ColorInt
+    private fun resolveThemeColor(@AttrRes attr: Int, @ColorInt fallback: Int): Int {
+        val value = TypedValue()
+        if (!context.theme.resolveAttribute(attr, value, true)) return fallback
+        return when {
+            value.resourceId != 0 -> ContextCompat.getColor(context, value.resourceId)
+            value.type in TypedValue.TYPE_FIRST_COLOR_INT..TypedValue.TYPE_LAST_COLOR_INT -> value.data
+            else -> fallback
+        }
+    }
+
+    private fun dp(value: Float): Float =
+        TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, value, resources.displayMetrics)
+
+    private fun sp(value: Float): Float =
+        TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, value, resources.displayMetrics)
+
+    companion object {
+        /** Number of week columns, matching GitHub's one-year contribution graph. */
+        private const val WEEKS = 53
+
+        private const val DAYS_PER_WEEK = 7
+
+        /** Rows that get a weekday label: Monday, Wednesday, Friday. */
+        private val WEEKDAY_ROWS = intArrayOf(0, 2, 4)
+
+        private const val CELL_SIZE_DP = 11f
+        private const val CELL_GAP_DP = 3f
+        private const val CELL_RADIUS_DP = 2.5f
+        private const val LABEL_GAP_DP = 6f
+        private const val LABEL_TEXT_SP = 10f
+        private const val MONTH_LABEL_BOTTOM_PADDING_DP = 4f
+        private const val HINT_TEXT_SP = 12f
+        private const val HINT_RADIUS_DP = 9f
+        private const val HINT_PADDING_HORIZONTAL_DP = 12f
+        private const val HINT_PADDING_VERTICAL_DP = 5f
+        private const val TODAY_STROKE_DP = 1.4f
+    }
+}
+
+/**
+ * Format a character count for the compact stat chips: grouped small numbers and short
+ * `K`/`M`/`B` suffixes for large ones, so the card never overflows.
+ */
+internal fun formatCountCompact(count: Long): String {
+    val value = count.coerceAtLeast(0L)
+    return when {
+        value < 10_000L -> java.text.NumberFormat.getIntegerInstance(Locale.getDefault())
+            .format(value)
+
+        // The upper bounds leave room for rounding, so 999_999 reads "1.0M" instead of "1000.0K".
+        value < 999_950L -> String.format(Locale.getDefault(), "%.1fK", value / 1_000.0)
+        value < 999_950_000L -> String.format(Locale.getDefault(), "%.1fM", value / 1_000_000.0)
+        else -> String.format(Locale.getDefault(), "%.1fB", value / 1_000_000_000.0)
+    }
+}
