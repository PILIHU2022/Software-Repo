+ */
+package org.fcitx.fcitx5.android.data.stats
+
+import android.content.Context
+import androidx.room.Database
+import androidx.room.Room
+import androidx.room.RoomDatabase
+
+@Database(
+    entities = [TypingDailyStat::class],
+    version = 1,
+    exportSchema = false
+)
+abstract class TypingStatsDatabase : RoomDatabase() {
+
+    abstract fun typingStatsDao(): TypingStatsDao
+
+    companion object {
+        private const val DB_NAME = "typing_stats"
+
+        fun build(context: Context): TypingStatsDatabase = Room
+            .databaseBuilder(context, TypingStatsDatabase::class.java, DB_NAME)
+            // allow wipe the database instead of crashing when downgrade
+            .fallbackToDestructiveMigrationOnDowngrade(dropAllTables = true)
+            .build()
+    }
+}
