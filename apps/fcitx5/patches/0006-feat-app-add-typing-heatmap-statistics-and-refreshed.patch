+import org.fcitx.fcitx5.android.R
+import org.fcitx.fcitx5.android.ui.main.heatmap.HeatmapPalette
+import org.fcitx.fcitx5.android.utils.isDarkMode
+import java.util.Locale
+
+/**
+ * Dialog that lets the user pick the custom heatmap color.
+ *
+ * Offers a grid of [PRESET_COLORS] and a free-form `#RRGGBB` / `#AARRGGBB` input field with a
+ * live preview of the resulting five heatmap shades. Invalid input never dismisses the dialog,
+ * it only shows an error hint, so a typo cannot clear the stored color.
+ */
+object HeatmapColorPickerDialog {
+
+    /** Number of columns in the preset color grid. */
+    private const val COLUMNS = 6
+
+    private const val CELL_HEIGHT_DP = 42f
+    private const val CELL_MARGIN_DP = 3f
+    private const val CHIP_INSET_DP = 3f
+    private const val CHIP_CORNER_DP = 6f
+
+    /** A mix of saturated colors that all read well on light and dark backgrounds. */
+    private val PRESET_COLORS = intArrayOf(
+        // first row: defaults of the preset palettes
+        0xFF2DA44E.toInt(), // GitHub green
+        0xFF3B82F6.toInt(), // blue
+        0xFF8B5CF6.toInt(), // purple
+        0xFFEC4899.toInt(), // pink
+        0xFFF97316.toInt(), // orange
+        0xFF14B8A6.toInt(), // teal
+        // second row: cool tones
+        0xFF06B6D4.toInt(), // cyan
+        0xFF0EA5E9.toInt(), // sky
+        0xFF6366F1.toInt(), // indigo
+        0xFFA855F7.toInt(), // violet
+        0xFFD946EF.toInt(), // fuchsia
+        0xFF7C3AED.toInt(), // deep violet
+        // third row: warm tones
+        0xFFEF4444.toInt(), // red
+        0xFFF43F5E.toInt(), // rose
+        0xFFB91C1C.toInt(), // deep red
+        0xFFF59E0B.toInt(), // amber
+        0xFFEAB308.toInt(), // yellow
+        0xFF84CC16.toInt(), // lime
+        // fourth row: greens and neutrals
+        0xFF22C55E.toInt(), // green
+        0xFF10B981.toInt(), // emerald
+        0xFF0F766E.toInt(), // deep teal
+        0xFF0E7490.toInt(), // deep cyan
+        0xFF64748B.toInt(), // slate
+        0xFF78716C.toInt(), // stone
+    )
+
+    private val PREVIEW_IDS = intArrayOf(
+        R.id.color_preview_1,
+        R.id.color_preview_2,
+        R.id.color_preview_3,
+        R.id.color_preview_4,
+        R.id.color_preview_5,
+    )
+
+    /**
+     * Show the picker.
+     *
+     * @param currentColor initial color, used as the text field value and the highlighted chip
+     * @param onColorSelected invoked with the validated ARGB color when the user confirms
+     */
+    fun show(context: Context, @ColorInt currentColor: Int, onColorSelected: (Int) -> Unit) {
+        val root = LayoutInflater.from(context).inflate(R.layout.dialog_heatmap_color, null)
+        val input = root.findViewById<EditText>(R.id.color_hex_input)
+        val error = root.findViewById<TextView>(R.id.color_hex_error)
+        val isDark = context.resources.configuration.isDarkMode()
+
+        val cells = ArrayList<Pair<Int, FrameLayout>>(PRESET_COLORS.size)
+
+        fun renderPreview(@ColorInt color: Int) {
+            val colors = HeatmapPalette.Custom.colors(color, isDark)
+            PREVIEW_IDS.forEachIndexed { index, id ->
+                root.findViewById<View>(id)?.backgroundTintList =
+                    ColorStateList.valueOf(colors[index.coerceIn(0, colors.size - 1)])
+            }
+        }
+
+        /** Highlight the chip of [color]; a plain custom hex simply highlights nothing. */
+        fun markSelection(@ColorInt color: Int) {
+            val selected = ContextCompat.getDrawable(context, R.drawable.bg_heatmap_swatch_selected)
+            cells.forEach { (chipColor, cell) ->
+                cell.background = if (chipColor == color) selected else null
+            }
+        }
+
+        fun select(@ColorInt color: Int) {
+            input.setText(formatArgbHex(color))
+            input.setSelection(input.text.length)
+            renderPreview(color)
+            markSelection(color)
+        }
+
+        buildGrid(context, root) { color ->
+            error.isVisible = false
+            select(color)
+        }.also { cells.addAll(it) }
+
+        input.doAfterTextChanged { editable ->
+            error.isVisible = false
+            val parsed = parseArgbHex(editable?.toString())
+            if (parsed != null) {
+                renderPreview(parsed)
+                markSelection(parsed)
+            }
+        }
+
+        select(currentColor)
+
+        val dialog = AlertDialog.Builder(context)
+            .setTitle(R.string.stats_ui_color_dialog_title)
+            .setView(root)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok, null)
+            .create()
+
+        dialog.setOnShowListener {
+            // Override the positive button so invalid input keeps the dialog open.
+            dialog.getButton(android.content.DialogInterface.BUTTON_POSITIVE).setOnClickListener {
+                val parsed = parseArgbHex(input.text?.toString())
+                if (parsed == null) {
+                    error.isVisible = true
+                    input.requestFocus()
+                } else {
+                    onColorSelected(parsed)
+                    dialog.dismiss()
+                }
+            }
+        }
+        dialog.show()
+    }
+
+    /**
+     * Fill [R.id.color_grid] with clickable color chips of [PRESET_COLORS], [COLUMNS] per row.
+     *
+     * @return the created chips as pairs of (color, clickable cell)
+     */
+    private fun buildGrid(
+        context: Context,
+        root: View,
+        onColorClick: (Int) -> Unit,
+    ): List<Pair<Int, FrameLayout>> {
+        val grid = root.findViewById<LinearLayout>(R.id.color_grid)
+        val cells = ArrayList<Pair<Int, FrameLayout>>(PRESET_COLORS.size)
+        val height = dp(context, CELL_HEIGHT_DP).toInt()
+        val margin = dp(context, CELL_MARGIN_DP).toInt()
+        val inset = dp(context, CHIP_INSET_DP).toInt()
+
+        PRESET_COLORS.toList().chunked(COLUMNS).forEach { rowColors ->
+            val row = LinearLayout(context).apply { orientation = LinearLayout.HORIZONTAL }
+            grid.addView(
+                row,
+                LinearLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT,
+                    ViewGroup.LayoutParams.WRAP_CONTENT
+                )
+            )
+            rowColors.forEach { color ->
+                val cell = FrameLayout(context).apply {
+                    isClickable = true
+                    isFocusable = true
+                    contentDescription = formatArgbHex(color)
+                    setOnClickListener { onColorClick(color) }
+                }
+                cell.addView(
+                    View(context).apply {
+                        background = GradientDrawable().apply {
+                            shape = GradientDrawable.RECTANGLE
+                            cornerRadius = dp(context, CHIP_CORNER_DP)
+                            setColor(color)
+                        }
+                    },
+                    FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.MATCH_PARENT
+                    ).apply { setMargins(inset, inset, inset, inset) }
+                )
+                row.addView(
+                    cell,
+                    LinearLayout.LayoutParams(0, height, 1f).apply {
+                        setMargins(margin, margin, margin, margin)
+                    }
+                )
+                cells.add(color to cell)
+            }
+            // keep the last row aligned when the preset count is not a multiple of COLUMNS
+            repeat(COLUMNS - rowColors.size) {
+                row.addView(
+                    View(context),
+                    LinearLayout.LayoutParams(0, height, 1f).apply {
+                        setMargins(margin, margin, margin, margin)
+                    }
+                )
+            }
+        }
+        return cells
+    }
+
+    private fun dp(context: Context, value: Float): Float =
+        TypedValue.applyDimension(
+            TypedValue.COMPLEX_UNIT_DIP, value, context.resources.displayMetrics
+        )
+}
+
+/**
+ * Parse `#RRGGBB` or `#AARRGGBB` (the leading `#` is optional, case does not matter).
+ *
+ * @return the ARGB color, or `null` when [raw] is not a valid hex color
+ */
+internal fun parseArgbHex(raw: String?): Int? {
+    val text = raw?.trim()?.removePrefix("#") ?: return null
+    if (text.length != 6 && text.length != 8) return null
+    if (text.any { it !in '0'..'9' && it !in 'a'..'f' && it !in 'A'..'F' }) return null
+    val value = text.toLongOrNull(16) ?: return null
+    return if (text.length == 6) (0xFF000000L or value).toInt() else value.toInt()
+}
+
+/** Format [color] as `#RRGGBB`, or `#AARRGGBB` when it is not fully opaque. */
+internal fun formatArgbHex(@ColorInt color: Int): String =
+    if ((color ushr 24) and 0xFF == 0xFF) {
+        String.format(Locale.ROOT, "#%06X", color and 0xFFFFFF)
+    } else {
+        String.format(Locale.ROOT, "#%08X", color)
+    }
