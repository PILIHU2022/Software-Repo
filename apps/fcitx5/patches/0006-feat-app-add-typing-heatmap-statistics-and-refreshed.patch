new file mode 100644
index 00000000..2fe41ac1
--- /dev/null
+++ b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/home/HomePreference.kt
@@ -0,0 +1,150 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.ui.main.home
+
+import android.content.Context
+import android.content.res.ColorStateList
+import android.graphics.drawable.GradientDrawable
+import android.util.TypedValue
+import android.view.View
+import android.widget.ImageView
+import androidx.annotation.ColorInt
+import androidx.annotation.DrawableRes
+import androidx.annotation.StringRes
+import androidx.core.view.isVisible
+import androidx.preference.Preference
+import androidx.preference.PreferenceGroup
+import androidx.preference.PreferenceViewHolder
+import org.fcitx.fcitx5.android.R
+import org.fcitx.fcitx5.android.utils.alpha
+import splitties.resources.styledColor
+
+/**
+ * A home page entry: rounded accent tinted icon container, title, secondary summary and a
+ * subtle chevron.
+ *
+ * The layout keeps the stock [Preference] ids ([android.R.id.title], [android.R.id.summary]),
+ * so click, long press, enabled and dependency handling remains untouched.
+ */
+class HomePreference(context: Context) : Preference(context) {
+
+    /** Icon shown inside the rounded container, or `0` to leave the container out. */
+    @DrawableRes
+    var iconRes: Int = 0
+        set(value) {
+            field = value
+            notifyChanged()
+        }
+
+    /** Optional tint override for the icon (defaults to the theme accent color). */
+    @ColorInt
+    var iconTint: Int? = null
+        set(value) {
+            field = value
+            notifyChanged()
+        }
+
+    init {
+        layoutResource = R.layout.preference_home_entry
+        isIconSpaceReserved = false
+        isSingleLineTitle = false
+    }
+
+    override fun onBindViewHolder(holder: PreferenceViewHolder) {
+        super.onBindViewHolder(holder)
+        val accent = iconTint ?: context.styledColor(android.R.attr.colorAccent)
+        bindIcon(holder, accent)
+        bindChevron(holder)
+    }
+
+    private fun bindIcon(holder: PreferenceViewHolder, @ColorInt accent: Int) {
+        val enabled = isEnabled
+        val container = holder.itemView.findViewById<View>(R.id.home_icon_container)
+        val icon = holder.itemView.findViewById<ImageView>(R.id.home_icon)
+        if (iconRes == 0) {
+            container?.isVisible = false
+            return
+        }
+        container?.let {
+            it.isVisible = true
+            it.background = roundedBackground(accent.alpha(ICON_BACKGROUND_ALPHA))
+            it.alpha = if (enabled) 1f else DISABLED_ALPHA
+        }
+        icon?.apply {
+            setImageResource(iconRes)
+            imageTintList = ColorStateList.valueOf(accent)
+            alpha = if (enabled) 1f else DISABLED_ALPHA
+        }
+    }
+
+    private fun bindChevron(holder: PreferenceViewHolder) {
+        val enabled = isEnabled
+        val chevron = holder.itemView.findViewById<ImageView>(R.id.home_chevron) ?: return
+        // Only entries that actually navigate get the affordance. Disabled entries keep it
+        // (so the row still reads as a link) but dim it.
+        chevron.imageTintList = ColorStateList.valueOf(
+            context.styledColor(android.R.attr.textColorSecondary)
+        )
+        chevron.isVisible = onPreferenceClickListener != null
+        chevron.alpha = if (enabled) 1f else DISABLED_ALPHA
+        // The shared chevron drawable points to the right; mirror it in RTL layouts.
+        val rtl = context.resources.configuration.layoutDirection == View.LAYOUT_DIRECTION_RTL
+        chevron.scaleX = if (rtl) -1f else 1f
+    }
+
+    private fun roundedBackground(@ColorInt color: Int): GradientDrawable =
+        GradientDrawable().apply {
+            shape = GradientDrawable.RECTANGLE
+            cornerRadius = dp(ICON_CORNER_RADIUS_DP)
+            setColor(color)
+        }
+
+    private fun dp(value: Float): Float = TypedValue.applyDimension(
+        TypedValue.COMPLEX_UNIT_DIP, value, context.resources.displayMetrics
+    )
+
+    companion object {
+        private const val ICON_BACKGROUND_ALPHA = 0.14f
+        private const val ICON_CORNER_RADIUS_DP = 11f
+        private const val DISABLED_ALPHA = 0.38f
+    }
+}
+
+/**
+ * Adds a [HomePreference] to this group, keeping MainFragment readable.
+ */
+fun PreferenceGroup.addHomePreference(
+    @StringRes title: Int,
+    @StringRes summary: Int,
+    @DrawableRes icon: Int,
+    onClick: (() -> Unit)? = null
+) {
+    addPreference(HomePreference(context).apply {
+        setTitle(title)
+        setSummary(summary)
+        iconRes = icon
+        if (onClick != null) {
+            setOnPreferenceClickListener {
+                onClick()
+                true
+            }
+        }
+    })
+}
+
+/**
+ * An empty, non interactive row used as bottom breathing room. Reuses the category layout,
+ * which leaves just its vertical padding once the (empty) title is hidden.
+ */
+class HomeSpacerPreference(context: Context) : Preference(context) {
+
+    init {
+        layoutResource = R.layout.preference_home_category
+        isSelectable = false
+        isPersistent = false
+        isIconSpaceReserved = false
+        isSingleLineTitle = false
+    }
+}
