+++ b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/heatmap/TypingHeatmapPreference.kt
@@ -0,0 +1,254 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.ui.main.heatmap
+
+import android.content.Context
+import android.graphics.drawable.GradientDrawable
+import android.util.TypedValue
+import android.view.View
+import android.widget.HorizontalScrollView
+import android.widget.ImageView
+import android.widget.TextView
+import androidx.annotation.ColorInt
+import androidx.annotation.Keep
+import androidx.core.view.isVisible
+import androidx.preference.Preference
+import androidx.preference.PreferenceViewHolder
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.launch
+import org.fcitx.fcitx5.android.R
+import org.fcitx.fcitx5.android.data.prefs.AppPrefs
+import org.fcitx.fcitx5.android.data.prefs.ManagedPreference
+import org.fcitx.fcitx5.android.data.stats.TypingStatsManager
+import org.fcitx.fcitx5.android.data.stats.TypingStatsSnapshot
+import org.fcitx.fcitx5.android.utils.isDarkMode
+import java.lang.ref.WeakReference
+import java.text.DateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * Home page card that shows the typing heatmap, three headline metrics and a legend.
+ *
+ * The preference is not backed by [android.content.SharedPreferences] itself; the palette and
+ * the data come from [AppPrefs] and [TypingStatsManager]. Clicking the card (or the header
+ * icon) invokes [onOpenStats].
+ */
+class TypingHeatmapPreference(context: Context) : Preference(context) {
+
+    /** Invoked when the user asks for the statistics screen. */
+    var onOpenStats: (() -> Unit)? = null
+
+    @Keep
+    private val paletteListener = ManagedPreference.OnChangeListener<String> { _, _ -> render() }
+
+    @Keep
+    private val customColorListener = ManagedPreference.OnChangeListener<Int> { _, _ -> render() }
+
+    @Keep
+    private val enabledListener = ManagedPreference.OnChangeListener<Boolean> { _, _ -> render() }
+
+    private var scope: CoroutineScope? = null
+    private var snapshotJob: Job? = null
+    private var boundRoot: WeakReference<View>? = null
+    private var attached: Boolean = false
+
+    /** Scroll the grid to the newest week the first time a row is bound. */
+    private var scrollToRecentPending: Boolean = true
+
+    init {
+        layoutResource = R.layout.preference_typing_heatmap
+        isPersistent = false
+        isIconSpaceReserved = false
+        isSingleLineTitle = false
+        setOnPreferenceClickListener {
+            onOpenStats?.invoke()
+            true
+        }
+    }
+
+    override fun onAttached() {
+        super.onAttached()
+        if (!attached) {
+            attached = true
+            TypingStatsManager.init(context)
+            TypingStatsManager.refresh()
+            val prefs = appPrefs()
+            prefs?.stats?.palette?.registerOnChangeListener(paletteListener)
+            prefs?.stats?.customColor?.registerOnChangeListener(customColorListener)
+            prefs?.stats?.enabled?.registerOnChangeListener(enabledListener)
+            val newScope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+            scope = newScope
+            snapshotJob = newScope.launch {
+                TypingStatsManager.snapshot.collect { if (attached) render() }
+            }
+        }
+        render()
+    }
+
+    override fun onDetached() {
+        attached = false
+        snapshotJob?.cancel()
+        snapshotJob = null
+        scope?.cancel()
+        scope = null
+        val prefs = appPrefs()
+        prefs?.stats?.palette?.unregisterOnChangeListener(paletteListener)
+        prefs?.stats?.customColor?.unregisterOnChangeListener(customColorListener)
+        prefs?.stats?.enabled?.unregisterOnChangeListener(enabledListener)
+        boundRoot = null
+        super.onDetached()
+    }
+
+    override fun onBindViewHolder(holder: PreferenceViewHolder) {
+        super.onBindViewHolder(holder)
+        // The card draws its own outline; preference dividers around it would look stray.
+        holder.setDividerAllowedAbove(false)
+        holder.setDividerAllowedBelow(false)
+        val root = holder.itemView
+        boundRoot = WeakReference(root)
+        scrollToRecentPending = true
+        root.findViewById<ImageView>(R.id.heatmap_open_stats)?.setOnClickListener {
+            onOpenStats?.invoke()
+        }
+        render()
+    }
+
+    /**
+     * Re-read the preferences and the current snapshot and repaint the bound views.
+     *
+     * Safe to call at any time; it is a no-op while the preference is not bound.
+     */
+    fun refresh() {
+        render()
+    }
+
+    private fun render() {
+        val root = boundRoot?.get() ?: return
+        val prefs = appPrefs()
+        val snapshot = TypingStatsManager.snapshot.value
+        val palette = HeatmapPalette.fromStorage(prefs?.stats?.palette?.getValue())
+        val customColor = prefs?.stats?.customColor?.getValue() ?: DEFAULT_CUSTOM_COLOR
+        val enabled = prefs?.stats?.enabled?.getValue() ?: true
+        val isDark = root.context.resources.configuration.isDarkMode()
+
+        root.findViewById<TextView>(R.id.heatmap_title)?.setText(R.string.heatmap_title)
+        root.findViewById<TextView>(R.id.heatmap_summary)?.text = summary(snapshot)
+        root.findViewById<TextView>(R.id.heatmap_paused_hint)?.isVisible = !enabled
+
+        bindMetrics(root, snapshot)
+        bindLegend(root, palette, customColor, isDark)
+
+        root.findViewById<ContributionHeatmapView>(R.id.heatmap_heatmap)?.setData(
+            snapshot.countsByDate(),
+            palette,
+            customColor,
+            isDark
+        )
+
+        if (scrollToRecentPending) {
+            val scroll = root.findViewById<HorizontalScrollView>(R.id.heatmap_scroll)
+            if (scroll != null) {
+                scrollToRecentPending = false
+                scroll.post { scroll.fullScroll(View.FOCUS_RIGHT) }
+            }
+        }
+    }
+
+    private fun bindMetrics(root: View, snapshot: TypingStatsSnapshot) {
+        val totalText = formatCountCompact(snapshot.totalCharacters)
+        val accuracyText = if (snapshot.totalCharacters > 0L) {
+            String.format(Locale.getDefault(), "%.1f%%", snapshot.accuracy * 100f)
+        } else {
+            NO_VALUE
+        }
+        val streakText = snapshot.currentStreak.toString()
+
+        root.findViewById<TextView>(R.id.heatmap_total_value)?.let {
+            it.text = totalText
+            it.contentDescription =
+                context.getString(R.string.heatmap_total_characters) + ": " + totalText
+        }
+        root.findViewById<TextView>(R.id.heatmap_accuracy_value)?.let {
+            it.text = accuracyText
+            it.contentDescription =
+                context.getString(R.string.heatmap_accuracy) + ": " + accuracyText
+        }
+        root.findViewById<TextView>(R.id.heatmap_streak_value)?.let {
+            it.text = streakText
+            it.contentDescription = context.getString(R.string.heatmap_streak) + ": " +
+                context.resources.getQuantityString(
+                    R.plurals.heatmap_days_count,
+                    snapshot.currentStreak.coerceIn(0, 2),
+                    streakText
+                )
+        }
+    }
+
+    private fun bindLegend(
+        root: View,
+        palette: HeatmapPalette,
+        customColor: Int,
+        isDark: Boolean
+    ) {
+        val colors = palette.colors(customColor, isDark)
+        LEGEND_SWATCH_IDS.forEachIndexed { index, id ->
+            val swatch = root.findViewById<View>(id) ?: return@forEachIndexed
+            swatch.background = swatchDrawable(colors[index.coerceIn(0, colors.size - 1)])
+        }
+    }
+
+    private fun summary(snapshot: TypingStatsSnapshot): CharSequence = when {
+        snapshot.totalCharacters > 0L -> context.getString(
+            R.string.heatmap_summary_last_year,
+            formatCountCompact(snapshot.totalCharacters)
+        )
+
+        snapshot.startTime > 0L -> context.getString(
+            R.string.heatmap_summary_since,
+            formatStartTime(snapshot.startTime)
+        )
+
+        else -> context.getString(R.string.heatmap_no_data)
+    }
+
+    private fun formatStartTime(startTime: Long): String {
+        // Be forgiving about values stored as seconds (the contract is epoch millis).
+        val millis = if (startTime in 1L until 100_000_000_000L) startTime * 1_000L else startTime
+        return DateFormat.getDateInstance(DateFormat.MEDIUM, Locale.getDefault())
+            .format(Date(millis))
+    }
+
+    private fun swatchDrawable(@ColorInt color: Int): GradientDrawable =
+        GradientDrawable().apply {
+            shape = GradientDrawable.RECTANGLE
+            cornerRadius = dp(SWATCH_CORNER_RADIUS_DP)
+            setColor(color)
+        }
+
+    private fun dp(value: Float): Float = TypedValue.applyDimension(
+        TypedValue.COMPLEX_UNIT_DIP, value, context.resources.displayMetrics
+    )
+
+    private fun appPrefs(): AppPrefs? = runCatching { AppPrefs.getInstance() }.getOrNull()
+
+    companion object {
+        private val DEFAULT_CUSTOM_COLOR = 0xFF2DA44E.toInt()
+        private const val NO_VALUE = "—"
+        private const val SWATCH_CORNER_RADIUS_DP = 2.5f
+
+        private val LEGEND_SWATCH_IDS = intArrayOf(
+            R.id.heatmap_legend_swatch_1,
+            R.id.heatmap_legend_swatch_2,
+            R.id.heatmap_legend_swatch_3,
+            R.id.heatmap_legend_swatch_4,
+            R.id.heatmap_legend_swatch_5
+        )
+    }
+}
