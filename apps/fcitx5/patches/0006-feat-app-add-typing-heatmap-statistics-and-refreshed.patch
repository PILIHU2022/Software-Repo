+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.data.stats
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import androidx.annotation.Keep
+import androidx.room.withTransaction
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import org.fcitx.fcitx5.android.data.prefs.AppPrefs
+import org.fcitx.fcitx5.android.data.prefs.ManagedPreference
+import timber.log.Timber
+import java.time.LocalDate
+import java.time.ZoneId
+
+/**
+ * Entry point of the typing statistics feature.
+ *
+ * Counting is deliberately cheap for the IME main thread: [recordCommit] and
+ * [recordCorrection] only bump in-memory counters and (re)schedule a debounced flush.
+ * Everything else happens on a background [Dispatchers.IO] coroutine scope, so Room is
+ * never touched from the main thread.
+ *
+ * Only aggregated counts are stored, never any text content.
+ */
+object TypingStatsManager {
+
+    /** How long to buffer increments before writing them to Room. */
+    private const val FLUSH_DELAY_MS = 1_500L
+
+    /**
+     * Also flush while the user is still typing after this many buffered characters, so a long
+     * uninterrupted burst is not lost if the IME process is killed before the debounce fires.
+     */
+    private const val EARLY_FLUSH_CHARACTERS = 2_000L
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val writeMutex = Mutex()
+    private val mainHandler by lazy { Handler(Looper.getMainLooper()) }
+
+    private val _snapshot = MutableStateFlow(TypingStatsSnapshot.empty())
+
+    /** Latest statistics; updated after flushing/reloading, not on every character. */
+    val snapshot: StateFlow<TypingStatsSnapshot> = _snapshot.asStateFlow()
+
+    private val prefs: AppPrefs
+        get() = AppPrefs.getInstance()
+
+    private lateinit var database: TypingStatsDatabase
+    private lateinit var dao: TypingStatsDao
+
+    @Volatile
+    private var initialized = false
+
+    /** Cached value of [AppPrefs.stats]`enabled`, to avoid touching prefs per keystroke. */
+    @Volatile
+    private var trackingEnabled = true
+
+    private val initLock = Any()
+    private val bufferLock = Any()
+
+    // buffered increments per local day, guarded by [bufferLock].
+    // Keep the day the keys were pressed, so a burst that crosses midnight is still
+    // attributed to the correct heatmap cell.
+    private val pending = mutableMapOf<String, Delta>()
+
+    private val flushRunnable = Runnable { flush() }
+
+    @Keep
+    private val enabledListener = ManagedPreference.OnChangeListener<Boolean> { _, value ->
+        trackingEnabled = value
+    }
+
+    private class Delta(
+        val characters: Long,
+        val corrections: Long,
+        val commits: Long,
+    ) {
+        val isEmpty: Boolean
+            get() = characters == 0L && corrections == 0L && commits == 0L
+
+        companion object {
+            val Empty = Delta(0L, 0L, 0L)
+        }
+    }
+
+    /**
+     * Open the database and load the initial snapshot.
+     *
+     * Idempotent, safe to call from both [android.app.Application] and the IME service,
+     * and safe when the database cannot be opened (statistics are silently disabled then).
+     */
+    fun init(context: Context) {
+        if (initialized) return
+        synchronized(initLock) {
+            if (initialized) return
+            try {
+                val appContext = context.applicationContext ?: context
+                database = TypingStatsDatabase.build(appContext)
+                dao = database.typingStatsDao()
+                val startTimePref = prefs.stats.startTime
+                if (startTimePref.getValue() == 0L) {
+                    // "since install" anchor, first time we ever run
+                    startTimePref.setValue(System.currentTimeMillis())
+                }
+                trackingEnabled = prefs.stats.enabled.getValue()
+                prefs.stats.enabled.registerOnChangeListener(enabledListener)
+                initialized = true
+            } catch (e: Exception) {
+                Timber.e(e, "Failed to initialize typing statistics")
+                return
+            }
+        }
+        _snapshot.value = TypingStatsSnapshot.empty(prefs.stats.startTime.getValue())
+        refresh()
+    }
+
+    /**
+     * Buffer [text] (which is about to be committed) for today.
+     *
+     * A no-op when tracking is disabled or the manager failed to initialize.
+     */
+    fun recordCommit(text: CharSequence) {
+        if (text.isEmpty()) return
+        if (!isTrackingActive()) return
+        val characters = TypingStatsMath.countCharacters(text)
+        val date = todayKey()
+        val bufferedCharacters = synchronized(bufferLock) {
+            val old = pending[date] ?: Delta.Empty
+            pending[date] = Delta(
+                old.characters + characters,
+                old.corrections,
+                old.commits + 1L
+            )
+            pending.values.sumOf { it.characters }
+        }
+        if (bufferedCharacters >= EARLY_FLUSH_CHARACTERS) {
+            flush()
+        } else {
+            scheduleFlush()
+        }
+    }
+
+    /**
+     * Buffer [count] deleted characters that had already been committed.
+     *
+     * A no-op when tracking is disabled or the manager failed to initialize.
+     */
+    fun recordCorrection(count: Int) {
+        if (count <= 0) return
+        if (!isTrackingActive()) return
+        val date = todayKey()
+        synchronized(bufferLock) {
+            val old = pending[date] ?: Delta.Empty
+            pending[date] = Delta(old.characters, old.corrections + count.toLong(), old.commits)
+        }
+        scheduleFlush()
+    }
+
+    /**
+     * Write buffered increments to Room as soon as possible.
+     *
+     * Non-blocking, safe to call from the main thread.
+     */
+    fun flush() {
+        if (!initialized) return
+        mainHandler.removeCallbacks(flushRunnable)
+        val deltas = drainPending()
+        if (deltas.isEmpty()) return
+        scope.launch {
+            write(deltas)
+            publishSnapshot()
+        }
+    }
+
+    /** Reload the snapshot from Room, after flushing anything still buffered. */
+    fun refresh() {
+        if (!initialized) return
+        scope.launch {
+            write(drainPending())
+            publishSnapshot()
+        }
+    }
+
+    /** Drop all recorded statistics and restart the "since install" anchor from now. */
+    fun reset() {
+        if (!initialized) return
+        mainHandler.removeCallbacks(flushRunnable)
+        synchronized(bufferLock) {
+            pending.clear()
+        }
+        scope.launch {
+            writeMutex.withLock {
+                try {
+                    dao.clear()
+                } catch (e: Exception) {
+                    Timber.e(e, "Failed to clear typing statistics")
+                }
+            }
+            prefs.stats.startTime.setValue(System.currentTimeMillis())
+            publishSnapshot()
+        }
+    }
+
+    /** Persist whether typing activity should be recorded at all. */
+    fun setEnabled(enabled: Boolean) {
+        trackingEnabled = enabled
+        prefs.stats.enabled.setValue(enabled)
+        // persist what has been buffered so far before recording stops
+        if (!enabled) flush()
+    }
+
+    private fun isTrackingActive(): Boolean = initialized && trackingEnabled
+
+    private fun scheduleFlush() {
+        val handler = mainHandler
+        handler.removeCallbacks(flushRunnable)
+        handler.postDelayed(flushRunnable, FLUSH_DELAY_MS)
+    }
+
+    private fun drainPending(): Map<String, Delta> {
+        synchronized(bufferLock) {
+            if (pending.isEmpty()) return emptyMap()
+            val drained = pending.toMap()
+            pending.clear()
+            return drained
+        }
+    }
+
+    private fun todayKey(): String = LocalDate.now(ZoneId.systemDefault()).toString()
+
+    private suspend fun write(deltas: Map<String, Delta>) {
+        if (deltas.isEmpty()) return
+        writeMutex.withLock {
+            try {
+                val now = System.currentTimeMillis()
+                database.withTransaction {
+                    deltas.forEach { (date, delta) ->
+                        if (delta.isEmpty) return@forEach
+                        val existing = dao.get(date)
+                        val updated = if (existing == null) {
+                            TypingDailyStat(
+                                date = date,
+                                characters = delta.characters,
+                                corrections = delta.corrections,
+                                commits = delta.commits,
+                                updatedAt = now,
+                            )
+                        } else {
+                            existing.copy(
+                                characters = existing.characters + delta.characters,
+                                corrections = existing.corrections + delta.corrections,
+                                commits = existing.commits + delta.commits,
+                                updatedAt = now,
+                            )
+                        }
+                        dao.upsert(updated)
+                    }
+                }
+            } catch (e: Exception) {
+                Timber.e(e, "Failed to persist typing statistics")
+            }
+        }
+    }
+
+    private suspend fun publishSnapshot() {
+        writeMutex.withLock {
+            if (!initialized) return
+            try {
+                val days = dao.all()
+                val startTime = prefs.stats.startTime.getValue()
+                _snapshot.value = TypingStatsSnapshot.from(days, startTime)
+            } catch (e: Exception) {
+                Timber.e(e, "Failed to load typing statistics")
+            }
+        }
+    }
+}
