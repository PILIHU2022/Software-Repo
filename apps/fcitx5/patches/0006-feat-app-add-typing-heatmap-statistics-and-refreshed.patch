+package org.fcitx.fcitx5.android.ui.main.home
+
+import android.content.Context
+import androidx.preference.PreferenceCategory
+import org.fcitx.fcitx5.android.R
+
+/**
+ * Section header for the home page: a small, subtle label with generous spacing above it.
+ *
+ * Uses a custom layout so the sections do not look like a second level of preferences.
+ */
+class HomeCategoryPreference(context: Context, title: CharSequence) : PreferenceCategory(context) {
+
+    init {
+        this.title = title
+        layoutResource = R.layout.preference_home_category
+        isIconSpaceReserved = false
+        isSingleLineTitle = false
+        // A header is a label, not a row: no click, no focus, no pressed state.
+        isSelectable = false
+        // PreferenceCategory is disabled by design; the header is only a label, so keep the
+        // theme color instead of the greyed out disabled variant.
+        setShouldDisableView(false)
+    }
+}
