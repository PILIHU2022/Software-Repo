+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.data.stats
+
+import java.time.LocalDate
+
+/**
+ * Pure functions behind the typing statistics feature.
+ *
+ * Everything here is plain Kotlin/JVM (only `java.time` is used, which is available on Android
+ * via core library desugaring), so it can be unit tested without the Android framework.
+ */
+object TypingStatsMath {
+
+    /**
+     * Count the characters of [text] as Unicode code points, excluding whitespace and
+     * ISO control characters, so that newlines, tabs and similar do not count as typing work.
+     */
+    fun countCharacters(text: CharSequence): Int {
+        var count = 0
+        var i = 0
+        while (i < text.length) {
+            val codePoint = Character.codePointAt(text, i)
+            i += Character.charCount(codePoint)
+            if (Character.isWhitespace(codePoint)) continue
+            if (Character.isISOControl(codePoint)) continue
+            count++
+        }
+        return count
+    }
+
+    /**
+     * `characters / (characters + corrections)`, clamped to `0..1`.
+     * Returns `1f` when the denominator is not positive, i.e. when nothing is recorded yet.
+     */
+    fun accuracy(characters: Long, corrections: Long): Float {
+        val denominator = characters.toDouble() + corrections.toDouble()
+        if (denominator <= 0.0) return 1f
+        return (characters.toDouble() / denominator).toFloat().coerceIn(0f, 1f)
+    }
+
+    fun errorRate(characters: Long, corrections: Long): Float =
+        1f - accuracy(characters, corrections)
+
+    /**
+     * Number of consecutive active days ending today.
+     *
+     * If today has no activity yet but yesterday has, the streak is still alive and counted
+     * from yesterday (the user may simply not have typed today). The streak stops at the
+     * first missing day.
+     */
+    fun currentStreak(activeDates: Set<LocalDate>, today: LocalDate): Int {
+        if (activeDates.isEmpty()) return 0
+        var day = when {
+            today in activeDates -> today
+            today.minusDays(1) in activeDates -> today.minusDays(1)
+            else -> return 0
+        }
+        var streak = 0
+        while (day in activeDates) {
+            streak++
+            day = day.minusDays(1)
+        }
+        return streak
+    }
+
+    fun longestStreak(activeDates: Set<LocalDate>): Int {
+        if (activeDates.isEmpty()) return 0
+        var longest = 1
+        var run = 0
+        var previous: LocalDate? = null
+        // newest first, so consecutive days are adjacent in the iteration
+        for (day in activeDates.sortedDescending()) {
+            run = if (previous != null && previous.minusDays(1) == day) run + 1 else 1
+            if (run > longest) longest = run
+            previous = day
+        }
+        return longest
+    }
+
+    /**
+     * Map raw per-day counts to heatmap levels in `0..maxLevel`.
+     *
+     * Level 0 means "no activity"; every positive count is scaled against the global maximum
+     * so that the busiest day always reaches [maxLevel]:
+     * `1 + floor(count / max * (maxLevel - 1))`.
+     */
+    fun heatmapLevels(
+        counts: Map<LocalDate, Long>,
+        maxLevel: Int = 4
+    ): Map<LocalDate, Int> {
+        if (maxLevel <= 0) return counts.keys.associateWith { 0 }
+        val max = counts.values.maxOrNull() ?: return emptyMap()
+        if (max <= 0L) return counts.keys.associateWith { 0 }
+        val spread = (maxLevel - 1).toLong()
+        return counts.mapValues { (_, count) ->
+            when {
+                count <= 0L -> 0
+                count >= max -> maxLevel
+                else -> (1 + scaledLevel(count, max, spread)).coerceIn(1, maxLevel)
+            }
+        }
+    }
+
+    /**
+     * `floor(count * spread / max)` for `0 < count < max`, using exact integer arithmetic
+     * (a floating point division would drop the exact boundaries, e.g. `2 / 6 * 3`).
+     */
+    private fun scaledLevel(count: Long, max: Long, spread: Long): Int {
+        if (spread == 0L) return 0
+        val product = if (count > Long.MAX_VALUE / spread) {
+            // unreachable for realistic counts, fall back to floating point instead of overflowing
+            return ((count.toDouble() * spread.toDouble()) / max.toDouble()).toInt()
+        } else {
+            count * spread
+        }
+        return (product / max).toInt()
+    }
+}
