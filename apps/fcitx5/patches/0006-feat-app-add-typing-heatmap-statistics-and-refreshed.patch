+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.data.stats
+
+import androidx.room.Dao
+import androidx.room.Query
+import androidx.room.Upsert
+
+@Dao
+abstract class TypingStatsDao {
+
+    @Query("SELECT * FROM ${TypingDailyStat.TABLE_NAME} ORDER BY date ASC")
+    abstract suspend fun all(): List<TypingDailyStat>
+
+    /**
+     * All rows whose date is greater than or equal to [fromDate] (`yyyy-MM-dd`).
+     * ISO local dates compare correctly as strings within the same calendar era.
+     */
+    @Query("SELECT * FROM ${TypingDailyStat.TABLE_NAME} WHERE date >= :fromDate ORDER BY date ASC")
+    abstract suspend fun since(fromDate: String): List<TypingDailyStat>
+
+    @Query("SELECT * FROM ${TypingDailyStat.TABLE_NAME} WHERE date = :date LIMIT 1")
+    abstract suspend fun get(date: String): TypingDailyStat?
+
+    @Upsert
+    abstract suspend fun upsert(stat: TypingDailyStat)
+
+    @Query("DELETE FROM ${TypingDailyStat.TABLE_NAME}")
+    abstract suspend fun clear()
+}
