+/**
+ * "Statistics & heatmap" settings screen.
+ *
+ * Read-only overview of the aggregated typing statistics, the last seven days, the heatmap
+ * palette / custom color and the data & privacy section (tracking switch, reset action).
+ *
+ * All values are kept in sync with [TypingStatsManager.snapshot] while the screen is started.
+ */
+class TypingStatsFragment : PaddingPreferenceFragment() {
+
+    private lateinit var totalCharacters: Preference
+    private lateinit var corrections: Preference
+    private lateinit var accuracy: Preference
+    private lateinit var errorRate: Preference
+    private lateinit var activeDays: Preference
+    private lateinit var currentStreak: Preference
+    private lateinit var longestStreak: Preference
+    private lateinit var bestDay: Preference
+    private lateinit var since: Preference
+
+    private val recentDayPreferences = ArrayList<Preference>(RECENT_DAY_COUNT)
+
+    private lateinit var palettePreference: HeatmapPalettePreference
+    private lateinit var customColorPreference: Preference
+    private lateinit var trackingPreference: SwitchPreferenceCompat
+
+    private val statsPrefs
+        get() = AppPrefs.getInstance().stats
+
+    override fun onCreatePreferences(savedInstanceState: Bundle?, rootKey: String?) {
+        val ctx = requireContext()
+        // The manager is idempotent; init also makes sure the "since install" anchor exists.
+        TypingStatsManager.init(ctx)
+        TypingStatsManager.refresh()
+
+        val screen = preferenceManager.createPreferenceScreen(ctx)
+        recentDayPreferences.clear()
+
+        screen.addCategory(R.string.stats_ui_overview) {
+            totalCharacters = addValueRow(R.string.stats_ui_total_chars)
+            corrections = addValueRow(R.string.stats_ui_corrections)
+            accuracy = addValueRow(R.string.stats_ui_accuracy)
+            errorRate = addValueRow(R.string.stats_ui_error_rate)
+            activeDays = addValueRow(R.string.stats_ui_active_days)
+            currentStreak = addValueRow(R.string.stats_ui_current_streak)
+            longestStreak = addValueRow(R.string.stats_ui_longest_streak)
+            bestDay = addValueRow(R.string.stats_ui_best_day)
+            since = addValueRow(R.string.stats_ui_since)
+        }
+
+        screen.addCategory(R.string.stats_ui_recent_7_days) {
+            repeat(RECENT_DAY_COUNT) {
+                recentDayPreferences.add(addValueRow(R.string.stats_ui_today))
+            }
+        }
+
+        screen.addCategory(R.string.stats_ui_appearance) {
+            palettePreference = HeatmapPalettePreference(ctx)
