+            // setChecked() persists, so only touch it when it actually differs
+            if (trackingPreference.isChecked != enabled) {
+                trackingPreference.isChecked = enabled
+            }
+        }
+        updateCustomColor()
+    }
+
+    private fun renderRecentDays(snapshot: TypingStatsSnapshot) {
+        val today = LocalDate.now()
+        val statsByDate = snapshot.days.associateBy { it.date }
+        recentDayPreferences.forEachIndexed { index, row ->
+            val date = today.minusDays((RECENT_DAY_COUNT - 1 - index).toLong())
+            val dateText = formatDateWithWeekday(date)
+            row.title = if (date == today) {
+                "${getString(R.string.stats_ui_today)} · $dateText"
+            } else {
+                dateText
+            }
+            val stat = statsByDate[date.toString()]
+            row.summary = if (stat == null || stat.characters <= 0L) {
+                noData()
+            } else {
+                getString(
+                    R.string.stats_ui_day_summary,
+                    formatCount(stat.characters),
+                    stat.corrections
+                )
+            }
+        }
+    }
+
+    private fun updateCustomColor() {
+        if (!::customColorPreference.isInitialized) return
+        val color = statsPrefs.customColor.getValue()
+        customColorPreference.setSummary(formatArgbHex(color))
+        customColorPreference.icon = colorDot(requireContext(), color)
+    }
+
+    private fun confirmReset() {
+        val ctx = requireContext()
+        AlertDialog.Builder(ctx)
+            .setTitle(R.string.stats_ui_reset_title)
+            .setMessage(R.string.stats_ui_reset_message)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(R.string.stats_ui_reset) { _, _ ->
+                TypingStatsManager.reset()
+                // reset() publishes the empty snapshot itself; refresh() covers a concurrent
+                // flush race and keeps the "since" anchor up to date.
+                TypingStatsManager.refresh()
+                ctx.toast(R.string.stats_ui_reset_done)
+            }
+            .show()
+    }
+
+    private fun PreferenceGroup.addValueRow(@StringRes titleRes: Int): Preference =
+        valueRow(titleRes).also { addPreference(it) }
+
+    private fun valueRow(@StringRes titleRes: Int): Preference =
+        Preference(requireContext()).apply {
+            isPersistent = false
+            isSelectable = false
+            isSingleLineTitle = false
+            isIconSpaceReserved = false
+            setTitle(titleRes)
+            setSummary(R.string.stats_ui_no_data)
+        }
+
+    private fun noData(): String = getString(R.string.stats_ui_no_data)
+
+    private fun formatCount(value: Long): String =
+        NumberFormat.getIntegerInstance(Locale.getDefault()).format(value)
+
+    private fun formatPercent(fraction: Float): String =
+        String.format(Locale.getDefault(), "%.1f%%", fraction * 100f)
+
+    private fun formatDate(date: LocalDate): String = date.format(
+        DateTimeFormatter.ofLocalizedDate(FormatStyle.MEDIUM).withLocale(Locale.getDefault())
+    )
+
+    private fun formatDateWithWeekday(date: LocalDate): String {
+        val weekday = date.dayOfWeek.getDisplayName(TextStyle.SHORT, Locale.getDefault())
+        return "${formatDate(date)} · $weekday"
+    }
+
+    private fun formatIsoDate(raw: String): String =
+        runCatching { LocalDate.parse(raw) }.getOrNull()?.let(::formatDate) ?: raw
+
+    private fun formatStartDate(startTime: Long): String {
+        if (startTime <= 0L) return noData()
+        // Be forgiving about values stored as seconds instead of epoch millis.
+        val millis = if (startTime < 100_000_000_000L) startTime * 1_000L else startTime
+        val date = Instant.ofEpochMilli(millis).atZone(ZoneId.systemDefault()).toLocalDate()
+        return formatDate(date)
+    }
+
+    companion object {
+        private const val RECENT_DAY_COUNT = 7
+    }
+}
