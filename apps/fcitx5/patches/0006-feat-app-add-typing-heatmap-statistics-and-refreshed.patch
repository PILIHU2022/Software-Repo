+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.data.stats
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDate
+
+/**
+ * JVM-only tests: [TypingStatsMath] must not depend on the Android framework.
+ */
+class TypingStatsMathTest {
+
+    private val today: LocalDate = LocalDate.of(2026, 11, 14)
+
+    private fun daysAgo(days: Long): LocalDate = today.minusDays(days)
+
+    // region countCharacters
+
+    @Test
+    fun countCharactersOfEmptyText() {
+        assertEquals(0, TypingStatsMath.countCharacters(""))
+    }
+
+    @Test
+    fun countCharactersOfPlainAscii() {
+        assertEquals(5, TypingStatsMath.countCharacters("hello"))
+    }
+
+    @Test
+    fun countCharactersExcludesWhitespace() {
+        assertEquals(10, TypingStatsMath.countCharacters(" hello\tworld\n"))
+        assertEquals(0, TypingStatsMath.countCharacters(" \t\n\r"))
+        assertEquals(2, TypingStatsMath.countCharacters("a b"))
+    }
+
+    @Test
+    fun countCharactersExcludesIsoControlCharacters() {
+        assertEquals(2, TypingStatsMath.countCharacters("a\u0000b\u0007"))
+        assertEquals(0, TypingStatsMath.countCharacters("\u0000\u0001\u001F\u007F"))
+    }
+
+    @Test
+    fun countCharactersCountsCodePointsNotChars() {
+        // U+1F600 GRINNING FACE is a single code point in UTF-16 surrogate pair form
+        assertEquals(1, TypingStatsMath.countCharacters("\uD83D\uDE00"))
+        assertEquals(3, TypingStatsMath.countCharacters("a\uD83D\uDE00b"))
+        // counting code points, not grapheme clusters: combining acute is its own code point
+        assertEquals(2, TypingStatsMath.countCharacters("e\u0301"))
+    }
+
+    @Test
+    fun countCharactersCountsCjk() {
+        assertEquals(3, TypingStatsMath.countCharacters("\u4F60\u597D\u5417"))
+    }
+
+    @Test
+    fun countCharactersHandlesStringBuilder() {
+        assertEquals(3, TypingStatsMath.countCharacters(StringBuilder("a b c")))
+    }
+
+    // endregion
+
+    // region accuracy / errorRate
+
+    @Test
+    fun accuracyWithoutAnyInputIsPerfect() {
+        assertEquals(1f, TypingStatsMath.accuracy(0L, 0L), 1e-6f)
+        assertEquals(0f, TypingStatsMath.errorRate(0L, 0L), 1e-6f)
+    }
+
+    @Test
+    fun accuracyWithoutCorrectionsIsPerfect() {
+        assertEquals(1f, TypingStatsMath.accuracy(42L, 0L), 1e-6f)
+    }
+
+    @Test
+    fun accuracyAccountsForCorrections() {
+        assertEquals(0.75f, TypingStatsMath.accuracy(3L, 1L), 1e-6f)
+        assertEquals(0.25f, TypingStatsMath.errorRate(3L, 1L), 1e-6f)
+        assertEquals(0.5f, TypingStatsMath.accuracy(10L, 10L), 1e-6f)
+    }
+
+    @Test
+    fun accuracyWithoutCharactersIsZero() {
+        assertEquals(0f, TypingStatsMath.accuracy(0L, 7L), 1e-6f)
+        assertEquals(1f, TypingStatsMath.errorRate(0L, 7L), 1e-6f)
+    }
+
+    @Test
+    fun accuracyIsClamped() {
+        // corrupted rows must not produce values outside 0..1
+        assertEquals(0f, TypingStatsMath.accuracy(-5L, 10L), 1e-6f)
+        assertEquals(1f, TypingStatsMath.accuracy(10L, -5L), 1e-6f)
+    }
+
+    @Test
+    fun accuracyDoesNotOverflowOnHugeCounts() {
+        val result = TypingStatsMath.accuracy(Long.MAX_VALUE, Long.MAX_VALUE)
+        assertEquals(0.5f, result, 1e-6f)
+    }
+
+    // endregion
+
+    // region currentStreak
+
+    @Test
+    fun currentStreakWithoutActivity() {
+        assertEquals(0, TypingStatsMath.currentStreak(emptySet(), today))
+    }
+
+    @Test
+    fun currentStreakOfSingleDay() {
+        assertEquals(1, TypingStatsMath.currentStreak(setOf(today), today))
+    }
+
+    @Test
+    fun currentStreakEndingToday() {
+        val active = setOf(today, daysAgo(1), daysAgo(2))
+        assertEquals(3, TypingStatsMath.currentStreak(active, today))
+    }
+
+    @Test
+    fun currentStreakEndingYesterdayWhenTodayIsIdle() {
+        val active = setOf(daysAgo(1), daysAgo(2))
+        assertEquals(2, TypingStatsMath.currentStreak(active, today))
+    }
+
+    @Test
+    fun currentStreakStopsAtFirstGap() {
+        val active = setOf(today, daysAgo(2), daysAgo(3), daysAgo(4))
+        assertEquals(1, TypingStatsMath.currentStreak(active, today))
+    }
+
+    @Test
+    fun currentStreakIsZeroWhenLastTwoDaysAreIdle() {
+        val active = setOf(daysAgo(2), daysAgo(3))
+        assertEquals(0, TypingStatsMath.currentStreak(active, today))
+    }
+
+    @Test
+    fun currentStreakIgnoresFutureDates() {
+        val active = setOf(today.plusDays(1), daysAgo(1))
+        assertEquals(1, TypingStatsMath.currentStreak(active, today))
+    }
+
+    // endregion
+
+    // region longestStreak
+
+    @Test
+    fun longestStreakWithoutActivity() {
+        assertEquals(0, TypingStatsMath.longestStreak(emptySet()))
+    }
+
+    @Test
+    fun longestStreakOfSingleDay() {
+        assertEquals(1, TypingStatsMath.longestStreak(setOf(today)))
+    }
+
+    @Test
+    fun longestStreakOfConsecutiveDays() {
+        val active = setOf(today, daysAgo(1), daysAgo(2), daysAgo(3))
+        assertEquals(4, TypingStatsMath.longestStreak(active))
+    }
+
+    @Test
+    fun longestStreakPicksTheLongestRun() {
+        // run of 2 (today, yesterday), gap, run of 4
+        val active = setOf(
+            today, daysAgo(1),
+            daysAgo(3), daysAgo(4), daysAgo(5), daysAgo(6),
+            daysAgo(10)
+        )
+        assertEquals(4, TypingStatsMath.longestStreak(active))
+    }
+
+    @Test
+    fun longestStreakHandlesUnsortedInput() {
+        val active = setOf(daysAgo(6), daysAgo(4), daysAgo(5), today, daysAgo(1))
+        assertEquals(3, TypingStatsMath.longestStreak(active))
+    }
+
+    // endregion
+
+    // region heatmapLevels
+
+    @Test
+    fun heatmapLevelsOfEmptyMap() {
+        assertTrue(TypingStatsMath.heatmapLevels(emptyMap()).isEmpty())
+    }
+
+    @Test
+    fun heatmapLevelsOfZeroAndNegativeCountsAreZero() {
+        val counts = mapOf(today to 0L, daysAgo(1) to -5L, daysAgo(2) to 10L)
+        val levels = TypingStatsMath.heatmapLevels(counts)
+        assertEquals(0, levels.getValue(today))
+        assertEquals(0, levels.getValue(daysAgo(1)))
+        assertEquals(4, levels.getValue(daysAgo(2)))
+    }
+
+    @Test
+    fun heatmapLevelsOfAllZeroCountsAreZero() {
+        val counts = mapOf(today to 0L, daysAgo(1) to 0L)
+        val levels = TypingStatsMath.heatmapLevels(counts)
+        assertEquals(mapOf(today to 0, daysAgo(1) to 0), levels)
+    }
+
+    @Test
+    fun heatmapLevelsScaleAgainstTheGlobalMaximum() {
+        val counts = (1..9).associate { daysAgo(it.toLong()) to it.toLong() }
+        val levels = TypingStatsMath.heatmapLevels(counts, maxLevel = 4)
+        // 1 + floor(3 * count / 9)
+        assertEquals(1, levels.getValue(daysAgo(1)))
+        assertEquals(1, levels.getValue(daysAgo(2)))
+        assertEquals(2, levels.getValue(daysAgo(3)))
+        assertEquals(3, levels.getValue(daysAgo(6)))
+        assertEquals(4, levels.getValue(daysAgo(9)))
+    }
+
+    @Test
+    fun heatmapLevelsUseExactIntegerBoundaries() {
+        // 1 + floor(3 * 2 / 6) == 2, floating point arithmetic would yield 1 here
+        val counts = mapOf(daysAgo(1) to 2L, daysAgo(2) to 6L)
+        val levels = TypingStatsMath.heatmapLevels(counts, maxLevel = 4)
+        assertEquals(2, levels.getValue(daysAgo(1)))
+        assertEquals(4, levels.getValue(daysAgo(2)))
+    }
+
+    @Test
+    fun heatmapLevelsRespectCustomMaximumLevel() {
+        val counts = mapOf(daysAgo(1) to 1L, daysAgo(2) to 2L, daysAgo(3) to 10L)
+        val levels = TypingStatsMath.heatmapLevels(counts, maxLevel = 1)
+        assertEquals(1, levels.getValue(daysAgo(1)))
+        assertEquals(1, levels.getValue(daysAgo(2)))
+        assertEquals(1, levels.getValue(daysAgo(3)))
+    }
+
+    @Test
+    fun heatmapLevelsWithNonPositiveMaximumLevelAreZero() {
+        val counts = mapOf(today to 5L)
+        assertEquals(mapOf(today to 0), TypingStatsMath.heatmapLevels(counts, maxLevel = 0))
+        assertEquals(mapOf(today to 0), TypingStatsMath.heatmapLevels(counts, maxLevel = -1))
+    }
+
+    @Test
+    fun heatmapLevelsNeverExceedMaximumLevel() {
+        val counts = mapOf(today to Long.MAX_VALUE, daysAgo(1) to 1L)
+        val levels = TypingStatsMath.heatmapLevels(counts, maxLevel = 4)
+        assertEquals(4, levels.getValue(today))
+        assertEquals(1, levels.getValue(daysAgo(1)))
+    }
+
+    // endregion
+}
