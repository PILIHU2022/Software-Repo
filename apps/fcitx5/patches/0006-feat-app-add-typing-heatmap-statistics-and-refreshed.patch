+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.data.stats
+
+import java.time.LocalDate
+
+/**
+ * Immutable view of the stored typing statistics.
+ *
+ * [days] is expected to be sorted by date, one entry per day with recorded activity.
+ *
+ * @param startTime epoch millis of the "since install" anchor (when tracking started)
+ */
+data class TypingStatsSnapshot(
+    val days: List<TypingDailyStat>,
+    val startTime: Long,
+    val totalCharacters: Long,
+    val totalCorrections: Long,
+    val totalCommits: Long,
+    val today: LocalDate = LocalDate.now(),
+) {
+
+    val accuracy: Float
+        get() = TypingStatsMath.accuracy(totalCharacters, totalCorrections)
+
+    val errorRate: Float
+        get() = TypingStatsMath.errorRate(totalCharacters, totalCorrections)
+
+    val activeDays: Int
+        get() = days.size
+
+    val currentStreak: Int
+        get() = TypingStatsMath.currentStreak(activeDateSet(), today)
+
+    val longestStreak: Int
+        get() = TypingStatsMath.longestStreak(activeDateSet())
+
+    val bestDay: TypingDailyStat?
+        get() = days.filter { it.characters > 0L }.maxByOrNull { it.characters }
+
+    val todayStat: TypingDailyStat?
+        get() = days.firstOrNull { it.date == today.toString() }
+
+    /** Characters per day, for [TypingStatsMath.heatmapLevels]. */
+    fun countsByDate(): Map<LocalDate, Long> {
+        val result = LinkedHashMap<LocalDate, Long>(days.size)
+        days.forEach { day ->
+            val date = day.date.toLocalDateOrNull() ?: return@forEach
+            result[date] = day.characters
+        }
+        return result
+    }
+
+    private fun activeDateSet(): Set<LocalDate> {
+        val result = HashSet<LocalDate>(days.size)
+        days.forEach { day ->
+            day.date.toLocalDateOrNull()?.let { result.add(it) }
+        }
+        return result
+    }
+
+    companion object {
+        fun empty(startTime: Long = 0L): TypingStatsSnapshot =
+            TypingStatsSnapshot(
+                days = emptyList(),
+                startTime = startTime,
+                totalCharacters = 0L,
+                totalCorrections = 0L,
+                totalCommits = 0L,
+            )
+
+        fun from(days: List<TypingDailyStat>, startTime: Long): TypingStatsSnapshot =
+            TypingStatsSnapshot(
+                days = days,
+                startTime = startTime,
+                totalCharacters = days.sumOf { it.characters },
+                totalCorrections = days.sumOf { it.corrections },
+                totalCommits = days.sumOf { it.commits },
+            )
+    }
+}
+
+/**
+ * Parse an ISO local date, tolerating corrupted rows (a broken row must never crash the IME).
+ */
+internal fun String.toLocalDateOrNull(): LocalDate? = try {
+    LocalDate.parse(this)
+} catch (e: RuntimeException) {
+    null
+}
