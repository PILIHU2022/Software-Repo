+/**
+ * Color ramps for the typing heatmap.
+ *
+ * Every palette yields exactly [COLOR_COUNT] ARGB colors:
+ * index `0` is the empty cell, `1..4` are increasing intensity levels.
+ * Presets have explicit light and dark variants; [Custom] derives its ramp from a user
+ * supplied color by blending it towards the card background while preserving the hue.
+ */
+enum class HeatmapPalette(
+    val storageKey: String,
+    @StringRes override val stringRes: Int,
+    private val presetColors: IntArray?
+) : ManagedPreferenceEnum {
+
+    Github(
+        storageKey = "Github",
+        stringRes = R.string.heatmap_palette_github,
+        presetColors = intArrayOf(
+            // light
+            0xFFEBEDF0.toInt(), 0xFF9BE9A8.toInt(), 0xFF40C463.toInt(),
+            0xFF30A14E.toInt(), 0xFF216E39.toInt(),
+            // dark
+            0xFF2C3137.toInt(), 0xFF0E4429.toInt(), 0xFF006D32.toInt(),
+            0xFF26A641.toInt(), 0xFF39D353.toInt()
+        )
+    ),
+
+    Blue(
+        storageKey = "Blue",
+        stringRes = R.string.heatmap_palette_blue,
+        presetColors = intArrayOf(
+            // light
+            0xFFEBEDF0.toInt(), 0xFFBFDBFE.toInt(), 0xFF93C5FD.toInt(),
+            0xFF3B82F6.toInt(), 0xFF1D4ED8.toInt(),
+            // dark
+            0xFF2C3137.toInt(), 0xFF0C3454.toInt(), 0xFF14568A.toInt(),
+            0xFF1E7FC0.toInt(), 0xFF4FB3F0.toInt()
+        )
+    ),
+
+    Purple(
+        storageKey = "Purple",
+        stringRes = R.string.heatmap_palette_purple,
+        presetColors = intArrayOf(
+            // light
+            0xFFEBEDF0.toInt(), 0xFFE9D5FF.toInt(), 0xFFC4B5FD.toInt(),
+            0xFF8B5CF6.toInt(), 0xFF6D28D9.toInt(),
+            // dark
+            0xFF2C3137.toInt(), 0xFF3B1F6E.toInt(), 0xFF5B21B6.toInt(),
+            0xFF7C3AED.toInt(), 0xFFA78BFA.toInt()
+        )
+    ),
+
+    Orange(
+        storageKey = "Orange",
+        stringRes = R.string.heatmap_palette_orange,
+        presetColors = intArrayOf(
+            // light
+            0xFFEBEDF0.toInt(), 0xFFFED7AA.toInt(), 0xFFFDBA74.toInt(),
+            0xFFF97316.toInt(), 0xFFC2410C.toInt(),
+            // dark
+            0xFF2C3137.toInt(), 0xFF431407.toInt(), 0xFF7C2D12.toInt(),
+            0xFFEA580C.toInt(), 0xFFFB923C.toInt()
+        )
+    ),
+
+    Pink(
+        storageKey = "Pink",
+        stringRes = R.string.heatmap_palette_pink,
+        presetColors = intArrayOf(
+            // light
+            0xFFEBEDF0.toInt(), 0xFFFBCFE8.toInt(), 0xFFF9A8D4.toInt(),
+            0xFFEC4899.toInt(), 0xFFBE185D.toInt(),
+            // dark
+            0xFF2C3137.toInt(), 0xFF4A0E2E.toInt(), 0xFF831747.toInt(),
+            0xFFDB2777.toInt(), 0xFFF472B6.toInt()
+        )
+    ),
+
+    Custom(
+        storageKey = "Custom",
+        stringRes = R.string.heatmap_palette_custom,
+        presetColors = null
+    );
+
+    /**
+     * The five colors of this palette for the current theme.
+     *
+     * @param customColor ARGB color used by [Custom], ignored by presets
+     * @param isDark whether the surrounding UI uses a dark theme
+     */
+    fun colors(@ColorInt customColor: Int, isDark: Boolean): IntArray {
+        val presets = presetColors ?: return customColors(customColor, isDark)
+        val offset = if (isDark) DARK_OFFSET else 0
+        return presets.copyOfRange(offset, offset + COLOR_COUNT)
+    }
+
+    private fun customColors(@ColorInt customColor: Int, isDark: Boolean): IntArray {
+        // Force opacity: the color picker may hand us a translucent value.
+        val opaque = (customColor and 0x00FFFFFF) or ALPHA_OPAQUE
+        val target = if (isDark) DARK_SURFACE else LIGHT_SURFACE
+        // Very light custom colors would wash out on a white card (and very dark ones on a
+        // dark card), so nudge the anchor color until the ramp is visible. On dark themes the
+        // anchor is also brightened a little: the strongest level has to pop on a dark card.
+        val base = when {
+            isDark -> {
+                val visible = if (luminance(opaque) < 0.32f) blend(opaque, WHITE, 0.35f) else opaque
+                blend(visible, WHITE, DARK_ANCHOR_LIGHTENING)
+            }
+
+            luminance(opaque) > 0.72f -> blend(opaque, BLACK, 0.35f)
+            else -> opaque
+        }
+        val ramp = if (isDark) DARK_RAMP else LIGHT_RAMP
+        return intArrayOf(
+            if (isDark) DARK_EMPTY else LIGHT_EMPTY,
+            blend(base, target, ramp[0]),
+            blend(base, target, ramp[1]),
+            blend(base, target, ramp[2]),
+            base
+        )
+    }
+
+    companion object {
+        /** Number of intensity levels above the empty cell. */
+        const val LEVEL_COUNT = 4
+
+        /** Number of colors returned by [colors]. */
+        const val COLOR_COUNT = LEVEL_COUNT + 1
+
+        private const val DARK_OFFSET = COLOR_COUNT
+
+        private const val ALPHA_OPAQUE = 0xFF000000.toInt()
+        private const val WHITE = 0xFFFFFFFF.toInt()
+        private const val BLACK = 0xFF000000.toInt()
+
+        private const val LIGHT_EMPTY = 0xFFEBEDF0.toInt()
+        private const val DARK_EMPTY = 0xFF2C3137.toInt()
+
+        /** Background the custom ramp fades into. */
+        private const val LIGHT_SURFACE = 0xFFFFFFFF.toInt()
+        private const val DARK_SURFACE = 0xFF20252B.toInt()
+
+        /** How much of the background is mixed into levels 1..3 (4 is the pure color). */
+        private val LIGHT_RAMP = floatArrayOf(0.74f, 0.50f, 0.25f)
+        private val DARK_RAMP = floatArrayOf(0.58f, 0.32f, 0.12f)
+
+        /** Dark themes lift the custom anchor so the busiest days still stand out. */
+        private const val DARK_ANCHOR_LIGHTENING = 0.12f
+
+        /**
+         * Resolve a stored palette name.
+         *
+         * Unknown or blank values (for example from an older version) fall back to [Github].
+         */
+        fun fromStorage(raw: String?): HeatmapPalette {
+            val value = raw?.trim()
+            if (value.isNullOrEmpty()) return Github
+            return values().firstOrNull { it.storageKey.equals(value, ignoreCase = true) }
+                ?: Github
+        }
+
+        private fun blend(@ColorInt from: Int, @ColorInt to: Int, fraction: Float): Int {
+            val t = fraction.coerceIn(0f, 1f)
+            val inverse = 1f - t
+            fun channel(shift: Int): Int {
+                val a = (from ushr shift) and 0xFF
+                val b = (to ushr shift) and 0xFF
+                return (a * inverse + b * t).roundToInt().coerceIn(0, 255)
+            }
+            return ALPHA_OPAQUE or (channel(16) shl 16) or (channel(8) shl 8) or channel(0)
+        }
+
+        /** Rough perceived brightness in `0..1`, good enough to pick a visible anchor. */
+        private fun luminance(@ColorInt color: Int): Float {
+            val r = (color ushr 16) and 0xFF
+            val g = (color ushr 8) and 0xFF
+            val b = color and 0xFF
+            return (0.299f * r + 0.587f * g + 0.114f * b) / 255f
+        }
+    }
+}
