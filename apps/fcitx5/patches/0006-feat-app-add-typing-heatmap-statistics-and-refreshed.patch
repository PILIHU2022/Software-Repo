+package org.fcitx.fcitx5.android.data.stats
+
+import androidx.room.Entity
+import androidx.room.PrimaryKey
+
+/**
+ * Aggregated typing activity of one day.
+ *
+ * No text content is ever stored here, only counts.
+ *
+ * @param date local date in ISO-8601 format (`yyyy-MM-dd`), as produced by
+ * [java.time.LocalDate.toString]
+ * @param characters number of committed (non-whitespace, non-control) code points
+ * @param corrections number of already-committed characters the user deleted
+ * @param commits number of commit operations (not characters)
+ * @param updatedAt epoch millis of the last update of this row
+ */
+@Entity(tableName = TypingDailyStat.TABLE_NAME)
+data class TypingDailyStat(
+    @PrimaryKey
+    val date: String,
+    val characters: Long = 0L,
+    val corrections: Long = 0L,
+    val commits: Long = 0L,
+    val updatedAt: Long = System.currentTimeMillis(),
+) {
+    companion object {
+        const val TABLE_NAME = "typing_daily"
+    }
+}
