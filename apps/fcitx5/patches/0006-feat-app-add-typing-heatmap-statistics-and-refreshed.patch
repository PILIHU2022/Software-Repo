+
+            addPreference(Preference(ctx).apply {
+                isPersistent = false
+                isSelectable = false
+                isSingleLineTitle = false
+                isIconSpaceReserved = false
+                setTitle(R.string.stats_ui_privacy_title)
+                setSummary(R.string.stats_ui_privacy_summary)
+            })
+
+            addPreference(Preference(ctx).apply {
