+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.ui.main.heatmap
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * JVM-only tests for the pure palette math. The Android views are intentionally not touched.
+ */
+class HeatmapPaletteTest {
+
+    private fun alpha(color: Int): Int = (color ushr 24) and 0xFF
+
+    private fun luma(color: Int): Float {
+        val red = (color ushr 16) and 0xFF
+        val green = (color ushr 8) and 0xFF
+        val blue = color and 0xFF
+        return (0.299f * red + 0.587f * green + 0.114f * blue) / 255f
+    }
+
+    @Test
+    fun everyPaletteReturnsFiveOpaqueColors() {
+        val custom = 0xFF2DA44E.toInt()
+        for (palette in HeatmapPalette.values()) {
+            for (isDark in booleanArrayOf(false, true)) {
+                val colors = palette.colors(custom, isDark)
+                assertEquals("$palette (dark=$isDark) color count", HeatmapPalette.COLOR_COUNT, colors.size)
+                colors.forEach { color ->
+                    assertEquals("$palette (dark=$isDark) must be opaque", 0xFF, alpha(color))
+                }
+            }
+        }
+    }
+
+    @Test
+    fun presetRampsHaveDistinctLevels() {
+        for (palette in HeatmapPalette.values()) {
+            if (palette == HeatmapPalette.Custom) continue
+            for (isDark in booleanArrayOf(false, true)) {
+                val colors = palette.colors(0, isDark)
+                assertEquals(
+                    "$palette (dark=$isDark) has duplicate levels",
+                    colors.size,
+                    colors.toSet().size
+                )
+            }
+        }
+    }
+
+    @Test
+    fun customPaletteBlendsTowardsTheBackground() {
+        val custom = 0xFF2DA44E.toInt()
+        val light = HeatmapPalette.Custom.colors(custom, false)
+
+        assertEquals(HeatmapPalette.COLOR_COUNT, light.size)
+        assertEquals("the strongest level is the chosen color", custom, light[4])
+        assertTrue("empty cell is the lightest", luma(light[0]) > luma(light[1]))
+        assertTrue("levels get darker", luma(light[1]) > luma(light[2]))
+        assertTrue("levels get darker", luma(light[2]) > luma(light[3]))
+        assertTrue("levels get darker", luma(light[3]) > luma(light[4]))
+    }
+
+    @Test
+    fun customPaletteDarkVariantIsSeparateRamp() {
+        val custom = 0xFF2DA44E.toInt()
+        val light = HeatmapPalette.Custom.colors(custom, false)
+        val dark = HeatmapPalette.Custom.colors(custom, true)
+
+        assertNotEquals("empty cells differ per theme", light[0], dark[0])
+        assertNotEquals("the strongest level is brightened on dark", light[4], dark[4])
+        assertTrue(luma(dark[1]) < luma(dark[2]))
+        assertTrue(luma(dark[2]) < luma(dark[3]))
+        assertTrue(luma(dark[3]) < luma(dark[4]))
+    }
+
+    @Test
+    fun customPaletteForcesOpaqueColors() {
+        val translucent = 0x802DA44E.toInt()
+        val colors = HeatmapPalette.Custom.colors(translucent, false)
+        colors.forEach { assertEquals(0xFF, alpha(it)) }
+        assertEquals(0xFF2DA44E.toInt(), colors[4])
+    }
+
+    @Test
+    fun customPaletteKeepsVeryLightColorsVisible() {
+        val colors = HeatmapPalette.Custom.colors(0xFFFFFFF0.toInt(), isDark = false)
+        for (level in 1..4) {
+            assertNotEquals("level $level must stand out from the empty cell", colors[0], colors[level])
+        }
+    }
+
+    @Test
+    fun lightAndDarkPresetRampsDiffer() {
+        for (palette in HeatmapPalette.values()) {
+            if (palette == HeatmapPalette.Custom) continue
+            val light = palette.colors(0, false)
+            val dark = palette.colors(0, true)
+            assertEquals(light.size, dark.size)
+            for (level in light.indices) {
+                assertNotEquals("$palette level $level", light[level], dark[level])
+            }
+        }
+    }
+
+    @Test
+    fun fromStorageFallsBackToGithub() {
+        assertEquals(HeatmapPalette.Github, HeatmapPalette.fromStorage(null))
+        assertEquals(HeatmapPalette.Github, HeatmapPalette.fromStorage(""))
+        assertEquals(HeatmapPalette.Github, HeatmapPalette.fromStorage("   "))
+        assertEquals(HeatmapPalette.Github, HeatmapPalette.fromStorage("chartreuse"))
+        assertEquals(HeatmapPalette.Blue, HeatmapPalette.fromStorage("Blue"))
+        assertEquals(HeatmapPalette.Blue, HeatmapPalette.fromStorage("blue"))
+        assertEquals(HeatmapPalette.Custom, HeatmapPalette.fromStorage(" Custom "))
+    }
+
+    @Test
+    fun storageKeysRoundTrip() {
+        for (palette in HeatmapPalette.values()) {
+            assertEquals(palette, HeatmapPalette.fromStorage(palette.storageKey))
+            assertEquals(palette, HeatmapPalette.fromStorage(palette.name))
+        }
+    }
+}
