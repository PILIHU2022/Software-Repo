+# Device serial is auto-detected when exactly one adb device is connected.
+# Environment=ADB_SERIAL=adb-c7005367-9fl33M._adb-tls-connect._tcp
+# Environment=RIME_SYNC_DIR=%h/Useless/Rime-Sync
+TimeoutStartSec=15min
diff --git a/tools/systemd/rime-sync-android.timer b/tools/systemd/rime-sync-android.timer
new file mode 100644
index 00000000..9a284d6e
--- /dev/null
+++ b/tools/systemd/rime-sync-android.timer
@@ -0,0 +1,14 @@
+[Unit]
+Description=Periodically sync the Rime dictionary with Fcitx5 for Android
+
+[Timer]
+# First attempt shortly after login, then every five minutes.  The script
+# compares checksums, so rounds without changes only cost a few adb calls.
+OnStartupSec=2min
+OnUnitActiveSec=5min
+AccuracySec=30s
+Persistent=true
+Unit=rime-sync-android.service
+
+[Install]
+WantedBy=timers.target
