index ee478630..a2d589c4 100644
--- a/app/src/main/java/org/fcitx/fcitx5/android/receiver/RimeImportReceiver.kt
+++ b/app/src/main/java/org/fcitx/fcitx5/android/receiver/RimeImportReceiver.kt
@@ -8,44 +8,123 @@ import android.content.BroadcastReceiver
 import android.content.Context
 import android.content.Intent
 import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeoutOrNull
 import org.fcitx.fcitx5.android.FcitxApplication
+import org.fcitx.fcitx5.android.daemon.FcitxDaemon
 import org.fcitx.fcitx5.android.utils.RimeProfileSync
 import timber.log.Timber
 
 /**
- * Applies the Rime profile staged by Syncthing in shared storage.
+ * Headless entry points for the Syncthing <-> Rime bridge.
  *
- * Protected by `android.permission.READ_INPUT_STATE` (held by shell/adb), so it
- * can be triggered from a PC or a script:
+ * Both actions are protected by `android.permission.READ_INPUT_STATE` (held by
+ * shell/adb), so they can be triggered from a PC or a script but not by normal
+ * apps:
  *
  * ```
+ * # copy Download/Rime-Sync/Rime-Arch into the Rime dir and redeploy
  * adb shell am broadcast \
  *   -a org.fcitx.fcitx5.android.action.RIME_IMPORT \
  *   -n org.fcitx.fcitx5.android/.receiver.RimeImportReceiver
- * ```
  *
- * Fcitx restarts at the end, which makes Rime rebuild from the new files.
+ * # merge the dictionaries found in the shared sync directory
+ * # (same code path as "Synchronize" in the Rime schema menu)
+ * adb shell am broadcast \
+ *   -a org.fcitx.fcitx5.android.action.RIME_SYNC \
+ *   -n org.fcitx.fcitx5.android/.receiver.RimeImportReceiver
+ * ```
  */
 class RimeImportReceiver : BroadcastReceiver() {
 
     override fun onReceive(context: Context, intent: Intent) {
-        if (intent.action != ACTION) return
-        val app = FcitxApplication.getInstance()
+        when (intent.action) {
+            ACTION_IMPORT -> importProfile()
+            ACTION_SYNC -> syncProfile()
+            else -> return
+        }
+    }
+
+    private fun importProfile() {
         val pendingResult = goAsync()
         Timber.i("RimeImportReceiver: apply staged profile")
-        app.coroutineScope.launch {
+        FcitxApplication.getInstance().coroutineScope.launch {
             try {
                 val copied = RimeProfileSync.apply()
                 Timber.i("RimeImportReceiver: done, wrote $copied file(s)")
             } catch (e: Exception) {
                 Timber.e(e, "RimeImportReceiver: failed")
             } finally {
+                // The profile copy (and a possible redeploy) is the part the
+                // broadcast has to wait for; merging the dictionaries can take
+                // longer, so release the broadcast first.
                 pendingResult.finish()
             }
+            // Merging is also what imports the dictionary snapshots staged in
+            // the same folder (the profile copy deliberately skips *.userdb).
+            runCatching { syncRimeUserData(SYNC_AFTER_IMPORT_TIMEOUT_MS) }
+                .onFailure { Timber.w(it, "RimeImportReceiver: post-import sync failed") }
+        }
+    }
+
+    private fun syncProfile() {
+        val pendingResult = goAsync()
+        Timber.i("RimeImportReceiver: sync user data")
+        FcitxApplication.getInstance().coroutineScope.launch {
+            try {
+                syncRimeUserData(READY_TIMEOUT_MS)
+            } catch (e: Exception) {
+                Timber.e(e, "RimeImportReceiver: sync failed")
+            } finally {
+                pendingResult.finish()
+            }
+        }
+    }
+
+    /**
+     * Run librime's `sync_user_data()` through the Rime addon's `sync`
+     * sub-config, which is the same code path as the "Synchronize" item in the
+     * schema menu, but without needing a visible keyboard or input context.
+     *
+     * The daemon is started on demand; the wait is bounded so that a pending
+     * deployment cannot keep a broadcast alive past its timeout.
+     */
+    private suspend fun syncRimeUserData(timeoutMs: Long) {
+        val connection = FcitxDaemon.connect(CONNECTION_NAME)
+        try {
+            val requested = withTimeoutOrNull(timeoutMs) {
+                connection.runOnReady {
+                    setAddonSubConfig(RIME_ADDON, RIME_SYNC_SUBCONFIG)
+                }
+                true
+            }
+            if (requested == true) {
+                Timber.i("RimeImportReceiver: rime sync requested")
+            } else {
+                Timber.w("RimeImportReceiver: fcitx not ready, sync skipped")
+            }
+        } finally {
+            FcitxDaemon.disconnect(CONNECTION_NAME)
         }
     }
 
     companion object {
-        const val ACTION = "org.fcitx.fcitx5.android.action.RIME_IMPORT"
+        const val ACTION_IMPORT = "org.fcitx.fcitx5.android.action.RIME_IMPORT"
+        const val ACTION_SYNC = "org.fcitx.fcitx5.android.action.RIME_SYNC"
+
+        /** Backwards-compatible alias for the original import action. */
+        const val ACTION = ACTION_IMPORT
+
+        private const val CONNECTION_NAME = "rime-import-receiver"
+        private const val RIME_ADDON = "rime"
+        private const val RIME_SYNC_SUBCONFIG = "sync"
+
+        /** Fcitx needs a moment to start; never block a broadcast for longer. */
+        private const val READY_TIMEOUT_MS = 8_000L
+
+        /**
+         * A redeploy after a profile change can take minutes; the sync runs in
+         * the background after the broadcast has already been released.
+         */
+        private const val SYNC_AFTER_IMPORT_TIMEOUT_MS = 300_000L
     }
 }
