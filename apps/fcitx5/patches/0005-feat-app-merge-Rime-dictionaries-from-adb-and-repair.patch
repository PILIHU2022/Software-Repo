+#!/usr/bin/env bash
+# Install the rime-sync-android user units.
+#
+# Run from a desktop terminal (a shell inside the DSH sandbox usually cannot
+# reach the user systemd bus):
+#
+#   fcitx5-android/tools/install-rime-sync-systemd.sh
+#
+# Copies both units into ~/.config/systemd/user.  If the user bus is reachable
+# the timer is enabled and started right away; otherwise a timers.target.wants
+# symlink is created so it starts with the next login.
+set -euo pipefail
+
+here=$(cd "$(dirname "$0")" && pwd)
+unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
+timer=rime-sync-android.timer
+
+mkdir -p "$unit_dir"
+install -m 644 "$here/systemd/rime-sync-android.service" "$unit_dir/"
+install -m 644 "$here/systemd/rime-sync-android.timer" "$unit_dir/"
+
+if command -v systemctl >/dev/null &&
+    systemctl --user daemon-reload 2>/dev/null &&
+    systemctl --user enable --now "$timer" 2>/dev/null; then
+    systemctl --user --no-pager status "$timer" || true
+    cat <<'EOF'
+
+Enabled. Check the next runs with:
+  systemctl --user list-timers rime-sync-android.timer
+  journalctl --user -u rime-sync-android.service -n 50
+Run one round by hand:
+  systemctl --user start rime-sync-android.service
+EOF
+    exit 0
+fi
+
+# No user bus (e.g. inside a container/sandbox): enable for the next login.
+mkdir -p "$unit_dir/timers.target.wants"
+ln -sfn "$unit_dir/$timer" "$unit_dir/timers.target.wants/$timer"
+cat <<EOF
+
+systemd user bus is not reachable from this shell; the units are installed in
+$unit_dir and the timer will start with the next login.
+
+To activate it now, run in a desktop terminal:
+  systemctl --user daemon-reload
+  systemctl --user start $timer
+EOF
diff --git a/tools/rime-sync-android.sh b/tools/rime-sync-android.sh
new file mode 100755
index 00000000..9b8ed117
--- /dev/null
+++ b/tools/rime-sync-android.sh
@@ -0,0 +1,226 @@
+#!/usr/bin/env bash
+# rime-sync-android.sh — bridge the PC's merged Rime dictionary to Fcitx5 for
+# Android and bring the phone's snapshot back.
+#
+# The phone runs a patched Fcitx5 that understands two adb-triggerable actions:
+#   RIME_IMPORT  copy Download/Rime-Sync/Rime-Arch into the app Rime dir,
+#                redeploy if config files changed, then merge dictionaries
+#   RIME_SYNC    merge dictionaries only (same path as the "Synchronize" menu)
+#
+# Syncthing keeps the config mirror fresh but ignores *.userdb.txt, so the
+# merged dictionary produced by the PC (in Rime-Sync/Rime-Arch/) has to be
+# pushed over adb; this script does that and asks the phone to merge it.
+#
+# Usage:
+#   rime-sync-android.sh                 # push + import/sync + pull back
+#   rime-sync-android.sh --watch         # same, whenever the PC dict changes
+#   rime-sync-android.sh --no-pull       # push + import/sync only
+#   rime-sync-android.sh --no-import     # dictionary merge only
+#
+# Environment:
+#   ADB_SERIAL     device serial (default: the only connected device)
+#   RIME_SYNC_DIR  PC mirror of the phone's sync dir (default: ~/Useless/Rime-Sync)
+#
+# Exit status: 0 on success, 1 on configuration/connection errors.
+set -euo pipefail
+
+PKG=org.fcitx.fcitx5.android
+RECEIVER="$PKG/.receiver.RimeImportReceiver"
+ACTION_IMPORT="$PKG.action.RIME_IMPORT"
+ACTION_SYNC="$PKG.action.RIME_SYNC"
+
+PHONE_SYNC_ROOT="${PHONE_SYNC_ROOT:-/sdcard/Download/Rime-Sync}"
+PHONE_STAGING="$PHONE_SYNC_ROOT/Rime-Arch"
+LOCAL_SYNC="${RIME_SYNC_DIR:-$HOME/Useless/Rime-Sync}"
+LOCAL_STAGING="$LOCAL_SYNC/Rime-Arch"
+# Where the phone's snapshots are written back; same folder as the PC mirror by
+# default, so the PC's next Rime sync merges them.
+LOCAL_PULL="${RIME_PULL_DIR:-$LOCAL_SYNC}"
+
+WATCH=0
+DO_PULL=1
+DO_IMPORT=1
+
+while (($#)); do
+    case "$1" in
+        --watch) WATCH=1 ;;
+        --no-pull) DO_PULL=0 ;;
+        --no-import) DO_IMPORT=0 ;;
+        -h | --help)
+            sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
+            exit 0
+            ;;
+        *)
+            echo "unknown option: $1" >&2
+            exit 1
+            ;;
+    esac
+    shift
+done
+
+log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
+die() {
+    echo "error: $*" >&2
+    exit 1
+}
+
+adb_do() { adb -s "$ADB_SERIAL" "$@"; }
+
+# Same as adb_do, but bounded: without a device some adb commands block forever.
+adb_to() {
+    local seconds=$1
+    shift
+    if [[ -n "${ADB_SERIAL:-}" ]]; then
+        timeout "$seconds" adb -s "$ADB_SERIAL" "$@"
+    else
+        timeout "$seconds" adb "$@"
+    fi
+}
+
+# --- device -----------------------------------------------------------------
+
+resolve_device() {
+    if [[ -n "${ADB_SERIAL:-}" ]]; then
+        adb_do get-state >/dev/null 2>&1 || die "device '$ADB_SERIAL' is not connected"
+        return
+    fi
+    adb start-server >/dev/null 2>&1 || true
+    local serials i
+    for i in $(seq 1 10); do
+        # wireless debugging reconnects through mDNS, which takes a moment
+        serials=$(adb devices | awk 'NR > 1 && $2 == "device" { print $1 }')
+        [[ -n "$serials" ]] && break
+        sleep 2
+    done
+    [[ -n "$serials" ]] || die "no adb device; is wireless debugging on?"
+    if [[ $(grep -c . <<<"$serials") -gt 1 ]]; then
+        # One phone can be listed twice (mDNS name plus ip:port).  Both point at
+        # the same device, so prefer the mDNS transport and move on.
+        local mdns
+        mdns=$(grep -m1 '_adb-tls-connect\._tcp' <<<"$serials" || true)
+        if [[ -n "$mdns" && $(grep -c . <<<"$serials") -eq 2 ]]; then
+            serials=$mdns
+        else
+            die "more than one device, set ADB_SERIAL to one of: $(tr '\n' ' ' <<<"$serials")"
+        fi
+    fi
+    ADB_SERIAL=$serials
+}
+
+# --- push -------------------------------------------------------------------
+
+push_dictionaries() {
+    [[ -d "$LOCAL_STAGING" ]] || die "missing local folder: $LOCAL_STAGING"
+    shopt -s nullglob
+    local files=("$LOCAL_STAGING"/*.userdb.txt)
+    shopt -u nullglob
+    ((${#files[@]})) || {
+        log "no *.userdb.txt in $LOCAL_STAGING, nothing to push"
+        return 0
+    }
+    local pushed=0 f name local_md5 remote_md5
+    for f in "${files[@]}"; do
+        name=$(basename "$f")
+        local_md5=$(md5sum "$f" | cut -d' ' -f1)
+        remote_md5=$(adb_do shell "md5sum '$PHONE_STAGING/$name' 2>/dev/null" | awk '{ print $1 }')
+        if [[ "$local_md5" == "$remote_md5" ]]; then
+            continue
+        fi
+        adb_do push "$f" "$PHONE_STAGING/$name" >/dev/null
+        log "pushed $name"
+        pushed=$((pushed + 1))
+    done
+    ((pushed)) || log "phone already has the current dictionary"
+}
+
+# --- ask the phone to merge -------------------------------------------------
+
+broadcast() {
+    local action=$1 attempt
+    # Wireless debugging reconnects now and then; retry instead of failing the
+    # whole round on a transient "device offline".
+    for attempt in 1 2 3 4 5; do
+        if adb_do shell am broadcast -a "$action" -n "$RECEIVER" >/dev/null 2>&1; then
+            return 0
+        fi
+        log "broadcast $action failed (attempt $attempt), retrying"
+        sleep 3
+        adb_to 15 wait-for-device >/dev/null 2>&1 || true
+    done
+    die "broadcast $action failed"
+}
+
+wait_for_sync() {
+    local deadline=$((SECONDS + 600))
+    local started=0
+    while ((SECONDS < deadline)); do
+        local buffer
+        buffer=$(adb_to 20 logcat -d -s rime.fcitx-rime 2>/dev/null || true)
+        if ((started == 0)) && grep -q 'synchronize user dict' <<<"$buffer"; then
+            started=1
+        fi
+        if ((started)) && grep -q 'tasks ran' <<<"$buffer"; then
+            return 0
+        fi
+        sleep 3
+    done
+    log "warning: no sync completion seen in logcat within 10 minutes"
+}
+
+request_sync() {
+    adb_to 15 logcat -c >/dev/null 2>&1 || true
+    if ((DO_IMPORT)); then
+        broadcast "$ACTION_IMPORT" # applies configs and merges dictionaries
+    else
+        broadcast "$ACTION_SYNC"
+    fi
+    wait_for_sync
+}
+
+# --- pull the phone's snapshot back ----------------------------------------
+
+pull_snapshots() {
+    ((DO_PULL)) || return 0
+    local name file
+    local -a dirs=()
+    # Read the listing first: adb inherits the loop's stdin and would otherwise
+    # swallow the remaining lines.
+    mapfile -t dirs < <(adb_do shell "ls '$PHONE_SYNC_ROOT' 2>/dev/null" | tr -d '\r')
+    for dir in "${dirs[@]}"; do
+        name=$(basename "$dir")
+        [[ "$name" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || continue
+        mkdir -p "$LOCAL_PULL/$name"
+        local remote_files=()
+        mapfile -t remote_files < <(
+            adb_do shell "ls '$PHONE_SYNC_ROOT/$name' 2>/dev/null" |
+                tr -d '\r' | grep -E '\.userdb\.txt$' || true
+        )
+        for file in "${remote_files[@]}"; do
+            adb_do pull "$PHONE_SYNC_ROOT/$name/$file" "$LOCAL_PULL/$name/$file" >/dev/null 2>&1 || true
+        done
+        log "pulled $name snapshot"
+    done
+}
+
+# --- one round --------------------------------------------------------------
+
+sync_once() {
+    resolve_device
+    push_dictionaries
+    request_sync
+    pull_snapshots
+}
+
+if ((WATCH)); then
+    [[ -d "$LOCAL_STAGING" ]] || die "missing local folder: $LOCAL_STAGING"
+    command -v inotifywait >/dev/null || die "watch mode needs inotify-tools"
+    log "watching $LOCAL_STAGING (Ctrl-C to stop)"
+    sync_once
+    while inotifywait -q -e close_write,create,moved_to --include '\.userdb\.txt$' \
+        "$LOCAL_STAGING" >/dev/null 2>&1; do
+        sleep 1 # let the writer finish
+        sync_once || log "sync round failed, still watching"
+    done
+else
+    sync_once
+fi
