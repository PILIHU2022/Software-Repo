@@ -62,12 +62,21 @@ object RimeProfileSync {
         val src = stagingDir()
         check(src.isDirectory) { "Staging folder not found: ${src.absolutePath}" }
         val dst = rimeDir().apply { mkdirs() }
+        // A profile reset (fresh install, cleared app data, restored backup)
+        // recreates installation.yaml without sync_dir.  librime then writes
+        // its synced dictionaries into the app-private rime/sync directory
+        // instead of the folder shared with the PC, which looks like "sync
+        // does nothing".  Restore the pointer whenever it is missing.
+        val syncDirFixed = withContext(Dispatchers.IO) { ensureSyncDir(dst) }
         val changes = withContext(Dispatchers.IO) { countChanges(src, dst) }
-        if (changes == 0) {
+        if (changes == 0 && !syncDirFixed) {
             Timber.i("RimeProfileSync: already up to date")
             return 0
         }
-        Timber.i("RimeProfileSync: $changes changed file(s), ${src.absolutePath} -> ${dst.absolutePath}")
+        Timber.i(
+            "RimeProfileSync: $changes changed file(s) (sync_dir restored: $syncDirFixed), " +
+                "${src.absolutePath} -> ${dst.absolutePath}"
+        )
         FcitxDaemon.stopFcitx()
         var copied = 0
         try {
@@ -89,6 +98,31 @@ object RimeProfileSync {
         return copied
     }
 
+    /**
+     * Make sure `installation.yaml` points librime at the shared sync folder.
+     *
+     * The phone's own installation id must be preserved, so the file itself is
+     * never replaced: only a missing `sync_dir` key is appended.  The value is
+     * the parent of the staging folder (e.g. `Download/Rime-Sync`), which is
+     * where `RimeSyncUserData` looks for and writes back snapshots.
+     *
+     * @return true when the file was modified
+     */
+    private fun ensureSyncDir(dst: File): Boolean {
+        val sharedRoot = stagingDir().parentFile?.absolutePath ?: return false
+        val installation = File(dst, "installation.yaml")
+        if (!installation.isFile) return false
+        val text = runCatching { installation.readText() }.getOrNull() ?: return false
+        if (Regex("(?m)^\\s*sync_dir\\s*:").containsMatchIn(text)) return false
+        return runCatching {
+            val newline = if (text.endsWith("\n")) "" else "\n"
+            installation.appendText("$newline" + "sync_dir: \"$sharedRoot\"\n")
+            true
+        }.onFailure {
+            Timber.w(it, "RimeProfileSync: cannot update ${installation.absolutePath}")
+        }.getOrDefault(false)
+    }
+
     private fun countChanges(src: File, dst: File): Int {
         if (src.name in SKIP_TOP_LEVEL) return 0
         if (isSkippedFile(src.name)) return 0
