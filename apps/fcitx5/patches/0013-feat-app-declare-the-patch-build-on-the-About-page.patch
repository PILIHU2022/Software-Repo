+/**
+ * Explicit "this APK is a patch build" notice. The version name already carries the
+ * `-patchwork` suffix, but a self-built APK should say so on the About page instead of
+ * looking like an official release.
+ */
+@Composable
+private fun PatchNoticeCard() {
+    val scheme = MaterialTheme.colorScheme
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(top = 8.dp),
+        shape = RoundedCornerShape(24.dp),
+        colors = CardDefaults.cardColors(containerColor = scheme.surfaceContainerHighest),
+    ) {
+        Column(modifier = Modifier.padding(20.dp)) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Surface(
+                    shape = RoundedCornerShape(50),
+                    color = scheme.tertiaryContainer,
+                    contentColor = scheme.onTertiaryContainer,
+                ) {
+                    Text(
+                        text = stringResource(R.string.about_patch_badge),
+                        style = MaterialTheme.typography.labelMedium,
+                        fontWeight = FontWeight.SemiBold,
+                        modifier = Modifier.padding(horizontal = 10.dp, vertical = 4.dp),
+                    )
+                }
+            }
+            Spacer(Modifier.height(10.dp))
+            Text(
+                text = stringResource(R.string.about_patch_note),
+                style = MaterialTheme.typography.bodyMedium,
+                color = scheme.onSurfaceVariant,
+            )
+        }
+    }
+}
+
 @Composable
