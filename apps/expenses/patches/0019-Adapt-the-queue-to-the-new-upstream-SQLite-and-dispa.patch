From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DeepSeek Harness <noreply@deepseek.com>
Date: Sat, 14 Nov 2026 18:45:41 +0800
Subject: [PATCH] Adapt the queue to the new upstream SQLite and dispatcher
 APIs

11cc955d moved database migrations to SQLiteConnection.executeSQL and replaced
Dispatchers.IO with the shared ioDispatcher. The queue still used execSQL in
migration_11_12/migration_12_13 and Dispatchers.IO in setSuspended, and the
Analytics default-tab value left the legacy settings screen's when
non-exhaustive.
---
 .../expensetracker/shared/model/database/ExpenseRepository.kt | 2 +-
 .../shared/model/database/RecurringExpenseDatabase.kt         | 4 ++--
 .../expensetracker/shared/ui/settings/SettingsMainScreen.kt   | 2 ++
 3 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/ExpenseRepository.kt b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/ExpenseRepository.kt
index 4291f1a..d00ab60 100644
--- a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/ExpenseRepository.kt
+++ b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/ExpenseRepository.kt
@@ -116,7 +116,7 @@ class ExpenseRepository(
     override suspend fun setSuspended(
         expenseId: Int,
         suspended: Boolean,
-    ) = withContext(Dispatchers.IO) {
+    ) = withContext(ioDispatcher) {
         recurringExpenseDao.setSuspended(expenseId, suspended)
     }
 
diff --git a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/RecurringExpenseDatabase.kt b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/RecurringExpenseDatabase.kt
index fa004bc..6aae176 100644
--- a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/RecurringExpenseDatabase.kt
+++ b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/RecurringExpenseDatabase.kt
@@ -348,7 +348,7 @@ abstract class RecurringExpenseDatabase : RoomDatabase() {
         val migration_11_12 =
             object : Migration(11, 12) {
                 override suspend fun migrate(connection: SQLiteConnection) {
-                    connection.execSQL(
+                    connection.executeSQL(
                         "ALTER TABLE recurring_expenses ADD COLUMN serviceId TEXT DEFAULT NULL",
                     )
                 }
@@ -356,7 +356,7 @@ abstract class RecurringExpenseDatabase : RoomDatabase() {
         val migration_12_13 =
             object : Migration(12, 13) {
                 override suspend fun migrate(connection: SQLiteConnection) {
-                    connection.execSQL(
+                    connection.executeSQL(
                         "ALTER TABLE recurring_expenses ADD COLUMN suspended INTEGER NOT NULL DEFAULT 0",
                     )
                 }
diff --git a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/ui/settings/SettingsMainScreen.kt b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/ui/settings/SettingsMainScreen.kt
index 2c1d14f..fa69f2c 100644
--- a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/ui/settings/SettingsMainScreen.kt
+++ b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/ui/settings/SettingsMainScreen.kt
@@ -76,6 +76,7 @@ import recurringexpensetracker.shared.generated.resources.settings_notifications
 import recurringexpensetracker.shared.generated.resources.settings_notifications_subtitle
 import recurringexpensetracker.shared.generated.resources.settings_notifications_upcoming
 import recurringexpensetracker.shared.generated.resources.settings_security_biometric_lock
+import recurringexpensetracker.shared.generated.resources.settings_start_analytics
 import recurringexpensetracker.shared.generated.resources.settings_show_converted_currency
 import recurringexpensetracker.shared.generated.resources.settings_system_default
 import recurringexpensetracker.shared.generated.resources.settings_theme_mode
@@ -143,6 +144,7 @@ fun SettingsMainScreen(
                     DefaultTab.Home -> stringResource(Res.string.bottom_nav_home)
                     DefaultTab.Upcoming -> stringResource(Res.string.bottom_nav_upcoming)
                     DefaultTab.Calendar -> stringResource(Res.string.bottom_nav_calendar)
+                    DefaultTab.Analytics -> stringResource(Res.string.settings_start_analytics)
                 },
             onClick = viewModel::onClickDefaultTabSelection,
             icon = Icons.Rounded.Rocket,
