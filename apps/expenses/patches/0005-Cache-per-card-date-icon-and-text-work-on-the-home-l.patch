+private data class TillaCardStyle(
+    val service: ExpenseService?,
+    val background: Color,
+    val foreground: Color,
+    val iconTint: Color,
+    val descriptionColor: Color,
+    val labelColor: Color,
+)
+
+private fun buildCardStyle(
+    serviceId: String?,
+    name: String,
+): TillaCardStyle {
+    val service = ExpenseServiceCatalog.find(serviceId)
+    val background = service?.backgroundColor ?: fallbackCardColor(name)
+    val foreground =
+        service?.foregroundColor ?: if (background.luminance() > 0.5f) Color(0xFF151719) else Color.White
+    return TillaCardStyle(
+        service = service,
+        background = background,
+        foreground = foreground,
+        iconTint = service?.iconTint ?: foreground,
+        descriptionColor = foreground.copy(alpha = 0.72f),
+        labelColor = foreground.copy(alpha = 0.78f),
+    )
+}
+
+/** Pre-localised remaining-time state, computed once per expense and day. */
+private sealed interface Remaining {
+    data object Today : Remaining
+
+    data object Tomorrow : Remaining
+
+    data class Days(val count: Int) : Remaining
+
+    data class Months(val count: Int) : Remaining
+
+    data class Years(val count: Int) : Remaining
+
+    data class RecurrenceText(val recurrence: Recurrence) : Remaining
+}
+
+private fun remainingFor(
+    expense: RecurringExpenseData,
+    today: LocalDate,
+): Remaining {
+    val nextPayment = expense.getNextPaymentDayAfter(today)
+        ?: return Remaining.RecurrenceText(expense.recurrence)
 
     val days = (nextPayment.toEpochDays() - today.toEpochDays()).toInt()
     return when {
-        days <= 0 -> stringResource(Res.string.home_card_today)
-        days == 1 -> stringResource(Res.string.home_card_tomorrow)
-        days < 30 -> pluralStringResource(Res.plurals.home_card_days, days, days)
-        days < 365 -> {
-            val months = (days / 30).coerceAtLeast(1)
-            pluralStringResource(Res.plurals.home_card_months, months, months)
-        }
-        else -> {
-            val years = (days / 365).coerceAtLeast(1)
-            pluralStringResource(Res.plurals.home_card_years, years, years)
-        }
+        days <= 0 -> Remaining.Today
+        days == 1 -> Remaining.Tomorrow
+        days < 30 -> Remaining.Days(days)
+        days < 365 -> Remaining.Months((days / 30).coerceAtLeast(1))
+        else -> Remaining.Years((days / 365).coerceAtLeast(1))
     }
 }
 
+@Composable
+private fun rememberLabelText(remaining: Remaining): String {
+    val label =
+        when (remaining) {
+            Remaining.Today -> stringResource(Res.string.home_card_today)
+            Remaining.Tomorrow -> stringResource(Res.string.home_card_tomorrow)
+            is Remaining.Days -> pluralStringResource(Res.plurals.home_card_days, remaining.count, remaining.count)
+            is Remaining.Months -> pluralStringResource(Res.plurals.home_card_months, remaining.count, remaining.count)
+            is Remaining.Years -> pluralStringResource(Res.plurals.home_card_years, remaining.count, remaining.count)
+            is Remaining.RecurrenceText -> stringResource(remaining.recurrence.fullStringRes)
+        }
+    return remember(label) { label.uppercase() }
+}
