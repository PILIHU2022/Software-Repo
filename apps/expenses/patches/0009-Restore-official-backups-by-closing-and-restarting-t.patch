+    /**
+     * Restores a backup into the live database.
+     *
+     * The backup is a zip of the SQLite files (main + wal/shm). We extract it to a temporary
+     * directory first, then close the open Room connection and replace the files. Replacing
+     * files while Room still has the old database open leaves the app reading stale data (the
+     * official backup database is schema v11, while this build is v12 and must migrate on the
+     * next open). The caller must restart the process after this method returns.
+     */
     suspend fun importDatabaseFile(
         srcZipUri: Uri,
         targetPath: String,
         applicationContext: Context,
     ): Boolean =
         withContext(Dispatchers.IO) {
+            val tempDir = File(applicationContext.cacheDir, "expense-restore-${System.nanoTime()}")
             return@withContext try {
-                extractZipToDirectory(
-                    srcZipUri,
-                    targetPath,
-                    applicationContext,
-                )
+                tempDir.mkdirs()
+                extractZipToDirectory(srcZipUri, tempDir.absolutePath, applicationContext)
+                val backupDatabase = File(tempDir, Constants.DATABASE_NAME)
+                if (!backupDatabase.isFile) {
+                    throw IllegalStateException("Backup does not contain ${Constants.DATABASE_NAME}")
+                }
+
+                // Stop Room from touching the files while they are replaced. The process is
+                // restarted by the caller immediately afterwards.
+                runCatching { database?.close() }
+
+                val targetDirectory = File(targetPath)
+                // Stale sidecar files belong to the old database connection and must not be
+                // replayed against the restored main file.
+                listOf("-wal", "-shm", "-journal").forEach { suffix ->
+                    File(targetDirectory, "${Constants.DATABASE_NAME}$suffix").delete()
+                }
+                backupDatabase.parentFile
+                    ?.listFiles()
+                    .orEmpty()
+                    .filter { it.name == Constants.DATABASE_NAME || it.name.startsWith("${Constants.DATABASE_NAME}-") }
+                    .forEach { source ->
+                        source.inputStream().use { input ->
+                            File(targetDirectory, source.name).outputStream().use { output ->
+                                input.copyTo(output)
+                            }
+                        }
+                    }
                 true
             } catch (e: Exception) {
                 e.printStackTrace()
                 false
+            } finally {
+                tempDir.deleteRecursively()
             }
         }
 
