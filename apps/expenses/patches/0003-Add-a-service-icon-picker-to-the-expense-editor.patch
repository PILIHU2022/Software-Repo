+import androidx.compose.ui.unit.sp
+import de.dbauer.expensetracker.shared.data.ExpenseService
+import de.dbauer.expensetracker.shared.data.ExpenseServiceCatalog
+import de.dbauer.expensetracker.shared.data.ExpenseServiceCategory
+import de.dbauer.expensetracker.shared.ui.ExpenseServiceIconView
+import org.jetbrains.compose.resources.StringResource
+import org.jetbrains.compose.resources.stringResource
+import recurringexpensetracker.shared.generated.resources.Res
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_ai
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_all
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_count
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_finance
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_gaming
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_health
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_music
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_none
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_other
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_search
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_security
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_shopping
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_social
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_streaming
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_summary
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_tech
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_title
+import recurringexpensetracker.shared.generated.resources.edit_expense_service_work
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ServiceOption(
+    selectedServiceId: String?,
+    onServiceSelected: (String?) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val selectedService = ExpenseServiceCatalog.find(selectedServiceId)
+    var showPicker by remember { mutableStateOf(false) }
+
+    Column(
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .padding(vertical = 8.dp),
+    ) {
+        Text(
+            text = stringResource(Res.string.edit_expense_service_title),
+            style = MaterialTheme.typography.bodyLarge,
+        )
+        Spacer(modifier = Modifier.height(8.dp))
+        Surface(
+            shape = RoundedCornerShape(20.dp),
+            color = MaterialTheme.colorScheme.surfaceContainerHigh,
+            modifier =
+                Modifier
+                    .fillMaxWidth()
+                    .clip(RoundedCornerShape(20.dp))
+                    .clickable { showPicker = true },
+        ) {
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                modifier = Modifier.padding(horizontal = 14.dp, vertical = 12.dp),
+            ) {
+                ServiceAvatar(
+                    service = selectedService,
+                    size = 38.dp,
+                    iconSize = 20.dp,
+                )
+                Column(
+                    modifier =
+                        Modifier
+                            .weight(1f)
+                            .padding(horizontal = 12.dp),
+                ) {
+                    Text(
+                        text = selectedService?.name ?: stringResource(Res.string.edit_expense_service_none),
+                        style = MaterialTheme.typography.bodyLarge,
+                        fontWeight = FontWeight.Medium,
+                    )
+                    Text(
+                        text = stringResource(Res.string.edit_expense_service_summary),
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                }
+                Icon(
+                    imageVector = Icons.Rounded.ChevronRight,
+                    contentDescription = null,
+                )
+            }
+        }
+    }
+
+    if (showPicker) {
+        ModalBottomSheet(
+            onDismissRequest = { showPicker = false },
+            sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true),
+        ) {
+            ServicePicker(
+                selectedServiceId = selectedServiceId,
+                onServiceSelected = {
+                    onServiceSelected(it)
+                    showPicker = false
+                },
+            )
+        }
+    }
+}
+
+@Composable
+private fun ServiceAvatar(
+    service: ExpenseService?,
+    size: Dp,
+    iconSize: Dp,
+) {
+    val backgroundColor = service?.backgroundColor ?: MaterialTheme.colorScheme.surfaceContainerHigh
+    val tint =
+        service?.let {
+            it.iconTint
+                ?: it.foregroundColor
+                ?: if (it.backgroundColor.luminance() > 0.5f) Color(0xFF151719) else Color.White
+        } ?: MaterialTheme.colorScheme.onSurfaceVariant
+    Box(
+        modifier =
+            Modifier
+                .size(size)
+                .clip(CircleShape)
+                .background(backgroundColor),
+        contentAlignment = Alignment.Center,
+    ) {
+        ExpenseServiceIconView(
+            service = service,
+            tint = tint,
+            modifier = Modifier.size(iconSize),
+        )
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun ServicePicker(
+    selectedServiceId: String?,
+    onServiceSelected: (String?) -> Unit,
+) {
+    var query by remember { mutableStateOf("") }
+    var category by remember { mutableStateOf<ExpenseServiceCategory?>(null) }
+
+    val services =
+        remember(query, category) {
+            ExpenseServiceCatalog
+                .search(query)
+                .filter { category == null || it.category == category }
+        }
+
+    Column(modifier = Modifier.fillMaxWidth()) {
+        Text(
+            text = stringResource(Res.string.edit_expense_service_title),
+            style = MaterialTheme.typography.titleLarge,
+            fontWeight = FontWeight.Bold,
+            modifier = Modifier.padding(horizontal = 20.dp),
+        )
+        Text(
+            text = stringResource(Res.string.edit_expense_service_count, ExpenseServiceCatalog.services.size),
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(horizontal = 20.dp, vertical = 4.dp),
+        )
+        TextField(
+            value = query,
+            onValueChange = { query = it },
+            placeholder = { Text(stringResource(Res.string.edit_expense_service_search)) },
+            leadingIcon = { Icon(Icons.Rounded.Search, contentDescription = null) },
+            singleLine = true,
+            colors = TextFieldDefaults.colors(
+                focusedIndicatorColor = Color.Transparent,
+                unfocusedIndicatorColor = Color.Transparent,
+                disabledIndicatorColor = Color.Transparent,
+            ),
+            modifier =
+                Modifier
+                    .fillMaxWidth()
+                    .padding(horizontal = 16.dp, vertical = 8.dp),
+        )
+
+        Row(
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+            modifier =
+                Modifier
+                    .fillMaxWidth()
+                    .horizontalScroll(rememberScrollState())
+                    .padding(horizontal = 16.dp),
+        ) {
+            CategoryChip(
+                label = stringResource(Res.string.edit_expense_service_all),
+                selected = category == null,
+                onClick = { category = null },
+            )
+            ExpenseServiceCategory.entries.forEach { entry ->
+                CategoryChip(
+                    label = stringResource(entry.labelRes()),
+                    selected = category == entry,
+                    onClick = { category = entry },
+                )
+            }
+        }
+
+        LazyVerticalGrid(
+            columns = GridCells.Fixed(4),
+            modifier =
+                Modifier
+                    .fillMaxWidth()
+                    .heightIn(max = 420.dp)
+                    .padding(horizontal = 8.dp, vertical = 8.dp),
+        ) {
+            item {
+                PickerItem(
+                    label = stringResource(Res.string.edit_expense_service_none),
+                    service = null,
+                    selected = selectedServiceId == null,
+                    onClick = { onServiceSelected(null) },
+                )
+            }
+            items(services, key = { it.id }) { service ->
+                PickerItem(
+                    label = service.name,
+                    service = service,
+                    selected = selectedServiceId == service.id,
+                    onClick = { onServiceSelected(service.id) },
+                )
+            }
+        }
+        Spacer(modifier = Modifier.height(16.dp))
+    }
+}
+
+@Composable
+private fun CategoryChip(
+    label: String,
+    selected: Boolean,
+    onClick: () -> Unit,
+) {
+    FilterChip(
+        selected = selected,
+        onClick = onClick,
+        label = { Text(label, maxLines = 1) },
+    )
+}
+
+@Composable
+private fun PickerItem(
+    label: String,
+    service: ExpenseService?,
+    selected: Boolean,
+    onClick: () -> Unit,
+) {
+    Column(
+        horizontalAlignment = Alignment.CenterHorizontally,
+        modifier =
+            Modifier
+                .padding(vertical = 6.dp)
+                .clip(RoundedCornerShape(14.dp))
+                .clickable(onClick = onClick)
+                .padding(4.dp),
+    ) {
+        Box(
+            contentAlignment = Alignment.Center,
+            modifier =
+                Modifier
+                    .size(54.dp)
+                    .clip(RoundedCornerShape(16.dp))
+                    .background(if (selected) MaterialTheme.colorScheme.primaryContainer else Color.Transparent),
+        ) {
+            ServiceAvatar(
+                service = service,
+                size = 44.dp,
+                iconSize = 24.dp,
+            )
+        }
+        Text(
+            text = label,
+            style = MaterialTheme.typography.labelSmall,
+            fontSize = 10.sp,
+            textAlign = TextAlign.Center,
+            maxLines = 2,
+            overflow = TextOverflow.Ellipsis,
+            modifier = Modifier.padding(top = 4.dp),
+        )
+    }
+}
+
+private fun ExpenseServiceCategory.labelRes(): StringResource =
+    when (this) {
+        ExpenseServiceCategory.STREAMING -> Res.string.edit_expense_service_streaming
+        ExpenseServiceCategory.MUSIC -> Res.string.edit_expense_service_music
+        ExpenseServiceCategory.AI -> Res.string.edit_expense_service_ai
+        ExpenseServiceCategory.WORK -> Res.string.edit_expense_service_work
+        ExpenseServiceCategory.SECURITY -> Res.string.edit_expense_service_security
+        ExpenseServiceCategory.GAMING -> Res.string.edit_expense_service_gaming
+        ExpenseServiceCategory.HEALTH -> Res.string.edit_expense_service_health
+        ExpenseServiceCategory.FINANCE -> Res.string.edit_expense_service_finance
+        ExpenseServiceCategory.SHOPPING -> Res.string.edit_expense_service_shopping
+        ExpenseServiceCategory.TECH -> Res.string.edit_expense_service_tech
+        ExpenseServiceCategory.SOCIAL -> Res.string.edit_expense_service_social
+        ExpenseServiceCategory.OTHER -> Res.string.edit_expense_service_other
+    }
