index 0000000..be1d507
--- /dev/null
+++ b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/viewmodel/CalendarViewModel.kt
@@ -0,0 +1,145 @@
+package de.dbauer.expensetracker.shared.viewmodel
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import de.dbauer.expensetracker.shared.data.RecurringExpenseData
+import de.dbauer.expensetracker.shared.model.DateTimeCalculator
+import de.dbauer.expensetracker.shared.model.calendar.CalendarDayCell
+import de.dbauer.expensetracker.shared.model.calendar.CalendarOccurrence
+import de.dbauer.expensetracker.shared.model.calendar.ISO_MONDAY
+import de.dbauer.expensetracker.shared.model.calendar.monthGrid
+import de.dbauer.expensetracker.shared.model.calendar.occurrencesForMonth
+import de.dbauer.expensetracker.shared.model.database.IExpenseRepository
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.launch
+import kotlinx.datetime.DateTimeUnit
+import kotlinx.datetime.LocalDate
+import kotlinx.datetime.plus
+
+/**
+ * State holder for the Tilla-style calendar tab.
+ *
+ * The per-day projection is only rebuilt when the displayed month or the expense list changes;
+ * selecting a day, changing the locale's first day of week or clicking an arrow only re-renders
+ * the (cheap) grid around the already projected occurrences.
+ */
+class CalendarViewModel(
+    private val expenseRepository: IExpenseRepository,
+) : ViewModel() {
+    private var today: LocalDate = DateTimeCalculator.getCurrentLocalDate()
+
+    var currentMonth by mutableStateOf(today.startOfMonth())
+        private set
+    var selectedDate by mutableStateOf(today)
+        private set
+    var days by mutableStateOf<List<CalendarDayCell>>(emptyList())
+        private set
+    var itemsByDay by mutableStateOf<Map<LocalDate, List<CalendarOccurrence>>>(emptyMap())
+        private set
+    var firstDayOfWeekIso by mutableIntStateOf(ISO_MONDAY)
+        private set
+    var isLoading by mutableStateOf(true)
+        private set
+
+    private val displayedMonth = MutableStateFlow(currentMonth)
+
+    init {
+        viewModelScope.launch {
+            combine(expenseRepository.allRecurringExpenses, displayedMonth) { expenses, month ->
+                month to projectMonth(expenses, month)
+            }.collect { (month, occurrences) ->
+                // A month projection can finish after the user already swiped to another month.
+                if (month != currentMonth) return@collect
+                today = DateTimeCalculator.getCurrentLocalDate()
+                itemsByDay = occurrences
+                days = buildDays(month, occurrences)
+                isLoading = false
+            }
+        }
+    }
+
+    fun onPreviousMonth() {
+        changeMonth(-1)
+    }
+
+    fun onNextMonth() {
+        changeMonth(1)
+    }
+
+    fun onDaySelected(date: LocalDate) {
+        selectedDate = date
+        val monthOfDate = date.startOfMonth()
+        if (monthOfDate == currentMonth) {
+            days = buildDays(currentMonth, itemsByDay)
+        } else {
+            changeMonthTo(monthOfDate)
+        }
+    }
+
+    /**
+     * Keeps the week labels in sync with the platform locale. The composable reads the tag with
+     * `Locale.current` (a Compose-only API) and passes the resulting ISO day number in.
+     */
+    fun onFirstDayOfWeekChanged(isoDayNumber: Int) {
+        val normalized = isoDayNumber.coerceIn(1, 7)
+        if (normalized == firstDayOfWeekIso) return
+        firstDayOfWeekIso = normalized
+        days = buildDays(currentMonth, itemsByDay)
+    }
+
+    private fun changeMonth(delta: Int) {
+        changeMonthTo(currentMonth.plus(delta, DateTimeUnit.MONTH))
+    }
+
+    private fun changeMonthTo(monthStart: LocalDate) {
+        if (monthStart == currentMonth) return
+        currentMonth = monthStart
+        today = DateTimeCalculator.getCurrentLocalDate()
+        if (!selectedDate.isInMonth(monthStart)) {
+            // Tilla keeps the old selection when changing months, which leaves the day list showing
+            // a date outside the visible grid. Prefer today when it is in the new month, else the 1st.
+            selectedDate = if (today.isInMonth(monthStart)) today else monthStart
+        }
+        itemsByDay = emptyMap()
+        days = buildDays(monthStart, emptyMap())
+        isLoading = true
+        displayedMonth.value = monthStart
+    }
+
+    private fun buildDays(
+        monthStart: LocalDate,
+        occurrences: Map<LocalDate, List<CalendarOccurrence>>,
+    ): List<CalendarDayCell> {
+        return monthGrid(
+            monthStart = monthStart,
+            firstDayOfWeekIso = firstDayOfWeekIso,
+            today = today,
+            selectedDate = selectedDate,
+            itemsByDay = occurrences,
+        )
+    }
+
+    private suspend fun projectMonth(
+        expenses: List<RecurringExpenseData>,
+        monthStart: LocalDate,
+    ): Map<LocalDate, List<CalendarOccurrence>> {
+        // payment_records only exist for manual-confirmation expenses; fetching them per expense
+        // keeps the repository interface unchanged.
+        val paidDatesByExpense = mutableMapOf<Int, Set<Long>>()
+        expenses.filter { it.requireManualConfirmation }.forEach { expense ->
+            paidDatesByExpense[expense.id] = expenseRepository.getPaymentRecordsForExpense(expense.id).toSet()
+        }
+        return occurrencesForMonth(expenses, monthStart, paidDatesByExpense)
+    }
+
+    private fun LocalDate.startOfMonth(): LocalDate = LocalDate(year, month, 1)
+
+    private fun LocalDate.isInMonth(monthStart: LocalDate): Boolean {
+        return year == monthStart.year && month == monthStart.month
+    }
+}
