diff --git a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/viewmodel/CalendarViewModel.kt b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/viewmodel/CalendarViewModel.kt
