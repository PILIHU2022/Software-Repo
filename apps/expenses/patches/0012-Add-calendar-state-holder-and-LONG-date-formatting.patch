--- a/shared/src/iosMain/kotlin/de/dbauer/expensetracker/shared/Extensions.ios.kt
+++ b/shared/src/iosMain/kotlin/de/dbauer/expensetracker/shared/Extensions.ios.kt
@@ -6,6 +6,7 @@ import platform.Foundation.NSCalendar
 import platform.Foundation.NSDate
 import platform.Foundation.NSDateComponents
 import platform.Foundation.NSDateFormatter
+import platform.Foundation.NSDateFormatterLongStyle
 import platform.Foundation.NSDateFormatterMediumStyle
 import platform.Foundation.NSNumber
 import platform.Foundation.NSNumberFormatter
@@ -58,3 +59,22 @@ actual fun LocalDate.toMonthYearStringUTC(): String {
     dateFormatter.dateFormat = "MMMM"
     return "${dateFormatter.stringFromDate(date)} $year"
 }
+
+actual fun LocalDate.toLongDateString(): String {
+    val comps =
+        NSDateComponents().apply {
+            setYear(year)
+            setMonth(this@toLongDateString.month.number.toLong())
+            setDay(day.toLong())
+            timeZone = NSTimeZone.timeZoneWithAbbreviation("UTC")
+        }
+    val calendar = NSCalendar.currentCalendar
+    val date = calendar.dateFromComponents(comps)!!
+
+    val dateFormatter =
+        NSDateFormatter().apply {
+            dateStyle = NSDateFormatterLongStyle
+            timeZone = NSTimeZone.timeZoneWithAbbreviation("UTC")
+        }
+    return dateFormatter.stringFromDate(date)
+}
