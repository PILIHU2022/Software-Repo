+package de.dbauer.expensetracker.shared.ui.home
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class HomeSpendingSummaryMathTest {
+    @Test
+    fun convertsMonthlyTotalToWeekAndYear() {
+        assertEquals(12f * 12f / 52f, averageExpenseForPeriod(12f, 0), 0.0001f)
+        assertEquals(12f, averageExpenseForPeriod(12f, 1), 0.0001f)
+        assertEquals(144f, averageExpenseForPeriod(12f, 2), 0.0001f)
+    }
+
+    @Test
+    fun cyclesWeekToMonthToYearLikeTilla() {
+        assertEquals(1, nextAverageExpensePeriod(0))
+        assertEquals(2, nextAverageExpensePeriod(1))
+        assertEquals(0, nextAverageExpensePeriod(2))
+    }
+}
