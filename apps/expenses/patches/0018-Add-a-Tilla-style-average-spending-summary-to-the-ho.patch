+/**
+ * Colours sampled over adb from Tilla 2.8.1's home "Average expenses" card.
+ *
+ * Dark: 1080x2414 screenshot, card pixel (540, 2200) = #1C222F, page #0F131C.
+ * Light: same card with Tilla dark mode disabled, pixel (540, 2200) = #E5ECFA.
+ *
+ * The card only rounds its top corners (24 px = 8 dp on the 480 dpi device) and
+ * runs edge to edge at the bottom of the home screen, exactly like Tilla.
+ */
+private val SummaryCardDark = Color(0xFF1C222F)
+private val SummaryTitleDark = Color(0xFFDFE2EF)
+private val SummaryPeriodDark = Color(0xFFC2C6D6)
+private val SummaryCardLight = Color(0xFFE5ECFA)
+private val SummaryTitleLight = Color(0xFF181B25)
+private val SummaryPeriodLight = Color(0xFF424754)
+
+private val SummaryShape =
+    RoundedCornerShape(
+        topStart = 8.dp,
+        topEnd = 8.dp,
+        bottomStart = 0.dp,
+        bottomEnd = 0.dp,
+    )
+
+/**
+ * The Tilla-style payment summary pinned to the bottom of the home screen.
+ *
+ * Tapping the card cycles the average-expenses period week -> month -> year.
+ * The amount is the total monthly spend of all active subscriptions converted
+ * to the selected period (52 weeks / 12 months / 1 year).
+ */
+@Composable
+fun HomeSpendingSummary(
+    monthlyExpense: Float,
+    period: Int,
+    currencyCode: String,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val isDark = MaterialTheme.colorScheme.background.luminance() < 0.5f
+    val cardColor = if (isDark) SummaryCardDark else SummaryCardLight
+    val titleColor = if (isDark) SummaryTitleDark else SummaryTitleLight
+    val periodColor = if (isDark) SummaryPeriodDark else SummaryPeriodLight
+
+    // Tilla draws behind the transparent gesture bar, which keeps the card 80 dp tall.
+    // With a taller (three-button) navigation bar, lift the text above the buttons.
+    val navigationBarBottom =
+        WindowInsets.navigationBars.asPaddingValues().calculateBottomPadding()
+    val contentBottomPadding = if (navigationBarBottom > 32.dp) navigationBarBottom else 16.dp
+
+    val periodLabel =
+        stringResource(
+            when (period) {
+                0 -> Res.string.home_summary_per_week
+                2 -> Res.string.home_summary_per_year
+                else -> Res.string.home_summary_per_month
+            },
+        )
+    val switchPeriodLabel = stringResource(Res.string.home_summary_switch_period)
+    val amount =
+        "≈ " +
+            averageExpenseForPeriod(monthlyExpense, period).toCurrencyString(currencyCode)
+
+    Box(
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .clip(SummaryShape)
+                .background(cardColor)
+                .clickable(
+                    role = Role.Button,
+                    onClickLabel = switchPeriodLabel,
+                    onClick = onClick,
+                ),
+    ) {
+        Row(
+            modifier =
+                Modifier
+                    .fillMaxWidth()
+                    .padding(
+                        start = 16.dp,
+                        top = 16.dp,
+                        end = 16.dp,
+                        bottom = contentBottomPadding,
+                    ),
+            horizontalArrangement = Arrangement.spacedBy(12.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Column(modifier = Modifier.weight(1f)) {
+                Text(
+                    text = stringResource(Res.string.home_summary_average),
+                    color = titleColor,
+                    fontSize = 16.sp,
+                    lineHeight = 24.sp,
+                    fontWeight = FontWeight.SemiBold,
+                )
+                Text(
+                    text = periodLabel,
+                    color = periodColor,
+                    fontSize = 14.sp,
+                    lineHeight = 24.sp,
+                )
+            }
+            Text(
+                text = amount,
+                color = titleColor,
+                fontSize = 22.sp,
+                fontWeight = FontWeight.SemiBold,
+                maxLines = 1,
+                softWrap = false,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+}
+
+/**
+ * Converts the total monthly spend into the average for [period]:
+ * 0 = week (12 months / 52 weeks), 1 = month (unchanged), 2 = year.
+ */
+internal fun averageExpenseForPeriod(
+    monthlyExpense: Float,
+    period: Int,
+): Float =
+    when (period) {
+        0 -> monthlyExpense * 12f / 52f
+        2 -> monthlyExpense * 12f
+        else -> monthlyExpense
+    }
+
+/** Tilla cycles its summary month -> year -> week; the setting uses 0/1/2. */
+internal fun nextAverageExpensePeriod(period: Int): Int =
+    when (period) {
+        0 -> 1
+        1 -> 2
+        else -> 0
+    }
