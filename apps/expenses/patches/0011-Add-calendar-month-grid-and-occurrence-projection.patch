+package de.dbauer.expensetracker.shared.model.calendar
+
+import kotlinx.datetime.LocalDate
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class CalendarGridTest {
+    @Test
+    fun leadingBlanksFollowFirstDayOfWeek() {
+        val october = LocalDate(2026, 10, 1)
+        assertEquals(3, leadingBlanks(october, ISO_MONDAY))
+        assertEquals(4, leadingBlanks(october, ISO_SUNDAY))
+
+        val september = LocalDate(2026, 9, 1)
+        assertEquals(1, leadingBlanks(september, ISO_MONDAY))
+        assertEquals(2, leadingBlanks(september, ISO_SUNDAY))
+
+        val february = LocalDate(2026, 2, 1)
+        assertEquals(6, leadingBlanks(february, ISO_MONDAY))
+        assertEquals(0, leadingBlanks(february, ISO_SUNDAY))
+    }
+
+    @Test
+    fun daysInMonthHandlesEveryMonthLength() {
+        assertEquals(28, daysInMonth(LocalDate(2026, 2, 1)))
+        assertEquals(29, daysInMonth(LocalDate(2024, 2, 1)))
+        assertEquals(30, daysInMonth(LocalDate(2026, 9, 1)))
+        assertEquals(31, daysInMonth(LocalDate(2026, 10, 1)))
+        assertEquals(31, daysInMonth(LocalDate(2026, 12, 1)))
+    }
+
+    @Test
+    fun gridAlwaysFillsCompleteWeeks() {
+        val date = LocalDate(2026, 10, 24)
+        val cells = monthGrid(LocalDate(2026, 10, 1), ISO_MONDAY, date, date, emptyMap())
+
+        assertEquals(35, cells.size)
+        assertEquals(0, cells.size % 7)
+        assertEquals(LocalDate(2026, 9, 28), cells.first().date)
+        assertEquals(LocalDate(2026, 11, 1), cells.last().date)
+        assertEquals(31, cells.count { it.isCurrentMonth })
+        assertEquals(4, cells.count { !it.isCurrentMonth })
+    }
+
+    @Test
+    fun gridStartsOnSundayWhenSundayIsFirstDay() {
+        val date = LocalDate(2026, 2, 14)
+        val cells = monthGrid(LocalDate(2026, 2, 1), ISO_SUNDAY, date, date, emptyMap())
+
+        assertEquals(28, cells.size)
+        assertEquals(LocalDate(2026, 2, 1), cells.first().date)
+        assertEquals(LocalDate(2026, 2, 28), cells.last().date)
+        assertTrue(cells.all { it.isCurrentMonth })
+    }
+
+    @Test
+    fun gridHandlesLeapFebruary() {
+        val cells =
+            monthGrid(LocalDate(2024, 2, 1), ISO_MONDAY, LocalDate(2024, 2, 1), LocalDate(2024, 2, 1), emptyMap())
+
+        assertEquals(35, cells.size)
+        assertEquals(LocalDate(2024, 1, 29), cells.first().date)
+        assertEquals(LocalDate(2024, 3, 3), cells.last().date)
+        assertEquals(29, cells.count { it.isCurrentMonth })
+    }
+
+    @Test
+    fun gridCrossesTheYearBoundary() {
+        val cells =
+            monthGrid(
+                LocalDate(2026, 12, 1),
+                ISO_MONDAY,
+                LocalDate(2026, 12, 1),
+                LocalDate(2026, 12, 1),
+                emptyMap(),
+            )
+
+        assertEquals(LocalDate(2026, 11, 30), cells.first().date)
+        assertEquals(LocalDate(2027, 1, 3), cells.last().date)
+        assertEquals(31, cells.count { it.isCurrentMonth })
+        assertTrue(cells.any { it.date == LocalDate(2027, 1, 1) && !it.isCurrentMonth })
+    }
+
+    @Test
+    fun todayAndSelectedAreFlaggedOnce() {
+        val today = LocalDate(2026, 10, 24)
+        val selected = LocalDate(2026, 10, 10)
+        val cells = monthGrid(LocalDate(2026, 10, 1), ISO_MONDAY, today, selected, emptyMap())
+
+        assertEquals(1, cells.count { it.isToday })
+        assertEquals(1, cells.count { it.isSelected })
+        assertEquals(today, cells.first { it.isToday }.date)
+        assertEquals(selected, cells.first { it.isSelected }.date)
+        assertEquals(24, cells.first { it.isToday }.dayOfMonth)
+    }
+
+    @Test
+    fun adjacentMonthDaysCanCarrySelectionButNoItems() {
+        val selected = LocalDate(2026, 9, 29)
+        val adjacentOccurrence = buildOccurrence(LocalDate(2026, 9, 29))
+        val currentOccurrence = buildOccurrence(LocalDate(2026, 10, 5))
+        val cells =
+            monthGrid(
+                monthStart = LocalDate(2026, 10, 1),
+                firstDayOfWeekIso = ISO_MONDAY,
+                today = LocalDate(2026, 10, 24),
+                selectedDate = selected,
+                itemsByDay =
+                    mapOf(
+                        LocalDate(2026, 9, 29) to listOf(adjacentOccurrence),
+                        LocalDate(2026, 10, 5) to listOf(currentOccurrence),
+                    ),
+            )
+
+        val adjacentCell = cells.first { it.date == LocalDate(2026, 9, 29) }
+        assertTrue(adjacentCell.isSelected)
+        assertFalse(adjacentCell.isCurrentMonth)
+        assertTrue(adjacentCell.items.isEmpty())
+
+        val currentCell = cells.first { it.date == LocalDate(2026, 10, 5) }
+        assertEquals(1, currentCell.itemCount)
+        assertEquals(1, currentCell.firstItem?.expenseId)
+    }
+
+    @Test
+    fun cellsExposeItemCountAndFirstItem() {
+        val day = LocalDate(2026, 10, 5)
+        val cells =
+            monthGrid(
+                monthStart = LocalDate(2026, 10, 1),
+                firstDayOfWeekIso = ISO_MONDAY,
+                today = LocalDate(2026, 10, 1),
+                selectedDate = LocalDate(2026, 10, 1),
+                itemsByDay =
+                    mapOf(day to listOf(buildOccurrence(day, expenseId = 1), buildOccurrence(day, expenseId = 2))),
+            )
+
+        val cell = cells.first { it.date == day }
+        assertEquals(2, cell.itemCount)
+        assertEquals(1, cell.firstItem?.expenseId)
+        assertFalse(cell.allItemsPaid)
+    }
+
+    @Test
+    fun allItemsPaidOnlyWhenEveryItemIsPaid() {
+        val day = LocalDate(2026, 10, 5)
+        val paidCell =
+            monthGrid(
+                monthStart = LocalDate(2026, 10, 1),
+                firstDayOfWeekIso = ISO_MONDAY,
+                today = LocalDate(2026, 10, 1),
+                selectedDate = LocalDate(2026, 10, 1),
+                itemsByDay = mapOf(day to listOf(buildOccurrence(day, isPaid = true))),
+            ).first { it.date == day }
+        assertTrue(paidCell.allItemsPaid)
+
+        val mixedCell =
+            monthGrid(
+                monthStart = LocalDate(2026, 10, 1),
+                firstDayOfWeekIso = ISO_MONDAY,
+                today = LocalDate(2026, 10, 1),
+                selectedDate = LocalDate(2026, 10, 1),
+                itemsByDay =
+                    mapOf(
+                        day to
+                            listOf(
+                                buildOccurrence(day, expenseId = 1, isPaid = true),
+                                buildOccurrence(day, expenseId = 2, isPaid = false),
+                            ),
+                    ),
+            ).first { it.date == day }
+        assertFalse(mixedCell.allItemsPaid)
+    }
+}
