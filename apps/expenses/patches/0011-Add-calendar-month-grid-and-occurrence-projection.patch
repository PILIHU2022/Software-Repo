+package de.dbauer.expensetracker.shared.model.calendar
+
+/**
+ * Maps a BCP-47 locale tag to the ISO day number (Monday = 1 … Sunday = 7) of the first day of the
+ * week. There is no common Kotlin API for this and an `expect/actual` would only wrap
+ * `WeekFields`/`NSCalendar`, so a small table keeps the logic pure and unit-testable.
+ *
+ * The table follows the regions this app actually ships translations for; unknown locales fall
+ * back to ISO-8601 (Monday first), which is what most of Europe and Asia use.
+ */
+fun firstDayOfWeekIso(localeTag: String): Int {
+    val parts = localeTag.replace('_', '-').split('-').filter { it.isNotBlank() }
+    val language = parts.firstOrNull()?.lowercase().orEmpty()
+    val region =
+        parts
+            .drop(1)
+            .firstOrNull { part -> part.length == 2 && part.all { it.isLetter() } }
+            ?.uppercase()
+            .orEmpty()
+
+    if (language == "ar" || region in SATURDAY_FIRST_REGIONS) {
+        return ISO_SATURDAY
+    }
+    if (language in SUNDAY_FIRST_LANGUAGES || region in SUNDAY_FIRST_REGIONS) {
+        return ISO_SUNDAY
+    }
+    return ISO_MONDAY
+}
+
+/**
+ * Returns the weekday indices (0 = Monday … 6 = Sunday) in the order they are displayed for the
+ * given first day of week. The seven weekday label resources are always stored Monday-first.
+ */
+fun weekdayIndices(firstDayOfWeekIso: Int): List<Int> {
+    val offset = (firstDayOfWeekIso - 1).mod(DAYS_PER_WEEK)
+    return (0 until DAYS_PER_WEEK).map { index -> (index + offset) % DAYS_PER_WEEK }
+}
+
+const val ISO_MONDAY = 1
+const val ISO_SATURDAY = 6
+const val ISO_SUNDAY = 7
+
+internal const val DAYS_PER_WEEK = 7
+
+private val SUNDAY_FIRST_LANGUAGES = setOf("he", "ja", "ko")
+
+private val SUNDAY_FIRST_REGIONS =
+    setOf(
+        "CA",
+        "IL",
+        "JP",
+        "KR",
+        "PH",
+        "US",
+    )
+
+private val SATURDAY_FIRST_REGIONS =
+    setOf(
+        "AE",
+        "AF",
+        "BH",
+        "DZ",
+        "EG",
+        "IQ",
+        "IR",
+        "JO",
+        "KW",
+        "LY",
+        "MA",
+        "OM",
+        "QA",
+        "SA",
+        "SD",
+        "SY",
+        "TN",
+        "YE",
+    )
diff --git a/shared/src/commonTest/kotlin/de/dbauer/expensetracker/shared/model/calendar/CalendarGridTest.kt b/shared/src/commonTest/kotlin/de/dbauer/expensetracker/shared/model/calendar/CalendarGridTest.kt
