+package de.dbauer.expensetracker.shared.model.calendar
+
+import de.dbauer.expensetracker.shared.data.CurrencyValue
+import de.dbauer.expensetracker.shared.data.Recurrence
+import de.dbauer.expensetracker.shared.data.RecurringExpenseData
+import kotlinx.datetime.LocalDate
+import kotlinx.datetime.TimeZone
+import kotlinx.datetime.atStartOfDayIn
+import kotlin.time.Instant
+
+internal fun buildExpense(
+    id: Int = 1,
+    name: String = "Expense",
+    recurrence: Recurrence = Recurrence.Monthly,
+    everyXRecurrence: Int = 1,
+    firstPayment: LocalDate? = LocalDate(2026, 1, 1),
+    endDate: LocalDate? = null,
+    requireManualConfirmation: Boolean = false,
+    archived: Boolean = false,
+    serviceId: String? = null,
+): RecurringExpenseData {
+    return RecurringExpenseData(
+        id = id,
+        name = name,
+        description = "",
+        price = CurrencyValue(10f, "EUR"),
+        monthlyPrice = CurrencyValue(10f, "EUR"),
+        everyXRecurrence = everyXRecurrence,
+        recurrence = recurrence,
+        tags = emptyList(),
+        firstPayment = firstPayment?.atStartOfDayIn(TimeZone.UTC),
+        notifyForExpense = false,
+        requireManualConfirmation = requireManualConfirmation,
+        endDate = endDate?.atStartOfDayIn(TimeZone.UTC),
+        archivedDate = if (archived) Instant.fromEpochMilliseconds(0) else null,
+        serviceId = serviceId,
+    )
+}
+
+internal fun buildOccurrence(
+    date: LocalDate,
+    expenseId: Int = 1,
+    name: String = "Expense",
+    isPaid: Boolean = false,
+): CalendarOccurrence {
+    return CalendarOccurrence(
+        expenseId = expenseId,
+        date = date,
+        name = name,
+        price = CurrencyValue(10f, "EUR"),
+        serviceId = null,
+        recurrence = Recurrence.Monthly,
+        everyXRecurrence = 1,
+        requiresConfirmation = false,
+        isPaid = isPaid,
+    )
+}
