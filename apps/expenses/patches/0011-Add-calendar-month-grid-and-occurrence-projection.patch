+package de.dbauer.expensetracker.shared.model.calendar
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class FirstDayOfWeekTest {
+    @Test
+    fun chineseAndEuropeanLocalesStartOnMonday() {
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso("zh-CN"))
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso("zh-TW"))
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso("zh-Hant-TW"))
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso("de-DE"))
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso("fr-FR"))
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso("en-GB"))
+    }
+
+    @Test
+    fun usAndAsianLocalesStartOnSunday() {
+        assertEquals(ISO_SUNDAY, firstDayOfWeekIso("en-US"))
+        assertEquals(ISO_SUNDAY, firstDayOfWeekIso("en-ca"))
+        assertEquals(ISO_SUNDAY, firstDayOfWeekIso("ja-JP"))
+        assertEquals(ISO_SUNDAY, firstDayOfWeekIso("ja"))
+        assertEquals(ISO_SUNDAY, firstDayOfWeekIso("ko-KR"))
+        assertEquals(ISO_SUNDAY, firstDayOfWeekIso("he-IL"))
+    }
+
+    @Test
+    fun arabicAndMiddleEasternLocalesStartOnSaturday() {
+        assertEquals(ISO_SATURDAY, firstDayOfWeekIso("ar"))
+        assertEquals(ISO_SATURDAY, firstDayOfWeekIso("ar-SA"))
+        assertEquals(ISO_SATURDAY, firstDayOfWeekIso("ar-EG"))
+        assertEquals(ISO_SATURDAY, firstDayOfWeekIso("fa-IR"))
+    }
+
+    @Test
+    fun unknownLocalesFallBackToMonday() {
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso(""))
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso("en"))
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso("und"))
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso("pt-BR"))
+    }
+
+    @Test
+    fun tagsWithUnderscoresAreSupported() {
+        assertEquals(ISO_MONDAY, firstDayOfWeekIso("zh_CN"))
+        assertEquals(ISO_SUNDAY, firstDayOfWeekIso("en_US"))
+    }
+
+    @Test
+    fun weekdayIndicesRotateTheMondayFirstLabels() {
+        assertEquals(listOf(0, 1, 2, 3, 4, 5, 6), weekdayIndices(ISO_MONDAY))
+        assertEquals(listOf(6, 0, 1, 2, 3, 4, 5), weekdayIndices(ISO_SUNDAY))
+        assertEquals(listOf(5, 6, 0, 1, 2, 3, 4), weekdayIndices(ISO_SATURDAY))
+    }
+}
