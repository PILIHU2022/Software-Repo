@@ -0,0 +1,59 @@
+package de.dbauer.expensetracker.shared.model.calendar
+
+import de.dbauer.expensetracker.shared.data.RecurringExpenseData
+import kotlinx.datetime.DateTimeUnit
+import kotlinx.datetime.LocalDate
+import kotlinx.datetime.TimeZone
+import kotlinx.datetime.atStartOfDayIn
+import kotlinx.datetime.plus
+
+/**
+ * Projects every occurrence of [expenses] that falls into the month starting at [monthStart]
+ * (which must be the first day of the month), grouped and stably sorted by day.
+ *
+ * The dates are derived with [RecurringExpenseData.getNextPaymentDayAfter], exactly like the
+ * Upcoming screen, so monthly clamping (`31 Jan -> 28/29 Feb -> 28/29 Mar`) and the inclusive
+ * `endDate` upper bound stay consistent between both screens.
+ *
+ * Only expenses that require manual confirmation can be paid, so [paidDatesByExpense] is only
+ * consulted for those (values are UTC start-of-day epoch milliseconds, the format used by
+ * `payment_records`).
+ */
+fun occurrencesForMonth(
+    expenses: List<RecurringExpenseData>,
+    monthStart: LocalDate,
+    paidDatesByExpense: Map<Int, Set<Long>> = emptyMap(),
+): Map<LocalDate, List<CalendarOccurrence>> {
+    val monthEnd = monthStart.plus(1, DateTimeUnit.MONTH)
+    val occurrencesByDay = mutableMapOf<LocalDate, MutableList<CalendarOccurrence>>()
+
+    expenses.forEach { expense ->
+        if (expense.archivedDate != null) return@forEach
+
+        val paidDates = paidDatesByExpense[expense.id].orEmpty()
+        var date = expense.getNextPaymentDayAfter(monthStart) ?: return@forEach
+        while (date < monthEnd) {
+            val isPaid =
+                expense.requireManualConfirmation &&
+                    paidDates.contains(date.atStartOfDayIn(TimeZone.UTC).toEpochMilliseconds())
+            occurrencesByDay.getOrPut(date) { mutableListOf() }.add(
+                CalendarOccurrence(
+                    expenseId = expense.id,
+                    date = date,
+                    name = expense.name,
+                    price = expense.price,
+                    serviceId = expense.serviceId,
+                    recurrence = expense.recurrence,
+                    everyXRecurrence = expense.everyXRecurrence,
+                    requiresConfirmation = expense.requireManualConfirmation,
+                    isPaid = isPaid,
+                ),
+            )
+            date = expense.getNextPaymentDayAfter(date.plus(1, DateTimeUnit.DAY)) ?: break
+        }
+    }
+
+    return occurrencesByDay.mapValues { (_, dayOccurrences) ->
+        dayOccurrences.sortedWith(compareBy({ it.name.lowercase() }, { it.expenseId }))
+    }
+}
diff --git a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/calendar/FirstDayOfWeek.kt b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/calendar/FirstDayOfWeek.kt
