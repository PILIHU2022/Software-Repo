@@ -0,0 +1,283 @@
+package de.dbauer.expensetracker.shared.model.calendar
+
+import de.dbauer.expensetracker.shared.data.Recurrence
+import kotlinx.datetime.LocalDate
+import kotlinx.datetime.TimeZone
+import kotlinx.datetime.atStartOfDayIn
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class CalendarOccurrencesTest {
+    @Test
+    fun dailyExpenseFillsEveryDayOfTheMonth() {
+        val expense = buildExpense(recurrence = Recurrence.Daily, firstPayment = LocalDate(2026, 10, 1))
+
+        val occurrences = occurrencesForMonth(listOf(expense), LocalDate(2026, 10, 1))
+
+        assertEquals(31, occurrences.size)
+        assertEquals(31, occurrences.values.sumOf { it.size })
+        assertEquals(LocalDate(2026, 10, 31), occurrences.keys.max())
+    }
+
+    @Test
+    fun weeklyExpenseRespectsEveryXWeeks() {
+        val everyWeek = buildExpense(recurrence = Recurrence.Weekly, firstPayment = LocalDate(2026, 10, 1))
+        val everyTwoWeeks =
+            buildExpense(
+                recurrence = Recurrence.Weekly,
+                everyXRecurrence = 2,
+                firstPayment = LocalDate(2026, 10, 1),
+            )
+
+        val weeklyDates = occurrencesForMonth(listOf(everyWeek), LocalDate(2026, 10, 1)).keys.sorted()
+        assertEquals(
+            listOf(
+                LocalDate(2026, 10, 1),
+                LocalDate(2026, 10, 8),
+                LocalDate(2026, 10, 15),
+                LocalDate(2026, 10, 22),
+                LocalDate(2026, 10, 29),
+            ),
+            weeklyDates,
+        )
+
+        val biWeeklyDates = occurrencesForMonth(listOf(everyTwoWeeks), LocalDate(2026, 10, 1)).keys.sorted()
+        assertEquals(
+            listOf(
+                LocalDate(2026, 10, 1),
+                LocalDate(2026, 10, 15),
+                LocalDate(2026, 10, 29),
+            ),
+            biWeeklyDates,
+        )
+    }
+
+    @Test
+    fun weeklyExpenseThatStartsInThePreviousMonthShowsOnlyThisMonth() {
+        val expense = buildExpense(recurrence = Recurrence.Weekly, firstPayment = LocalDate(2026, 9, 28))
+
+        val occurrences = occurrencesForMonth(listOf(expense), LocalDate(2026, 10, 1))
+
+        assertEquals(
+            listOf(
+                LocalDate(2026, 10, 5),
+                LocalDate(2026, 10, 12),
+                LocalDate(2026, 10, 19),
+                LocalDate(2026, 10, 26),
+            ),
+            occurrences.keys.sorted(),
+        )
+    }
+
+    @Test
+    fun monthlyEveryXMonthsSkipsMonths() {
+        val expense =
+            buildExpense(
+                recurrence = Recurrence.Monthly,
+                everyXRecurrence = 3,
+                firstPayment = LocalDate(2026, 1, 15),
+            )
+
+        assertEquals(
+            listOf(LocalDate(2026, 10, 15)),
+            occurrencesForMonth(listOf(expense), LocalDate(2026, 10, 1)).keys.toList(),
+        )
+        assertTrue(occurrencesForMonth(listOf(expense), LocalDate(2026, 9, 1)).isEmpty())
+        assertTrue(occurrencesForMonth(listOf(expense), LocalDate(2026, 11, 1)).isEmpty())
+    }
+
+    @Test
+    fun monthlyClampDriftsLikeGetNextPaymentDayAfter() {
+        val expense = buildExpense(recurrence = Recurrence.Monthly, firstPayment = LocalDate(2026, 1, 31))
+
+        assertEquals(
+            listOf(LocalDate(2026, 1, 31)),
+            occurrencesForMonth(listOf(expense), LocalDate(2026, 1, 1)).keys.toList(),
+        )
+        assertEquals(
+            listOf(LocalDate(2026, 2, 28)),
+            occurrencesForMonth(listOf(expense), LocalDate(2026, 2, 1)).keys.toList(),
+        )
+        // The 31st drifts to the 28th after February instead of snapping back to the 31st.
+        assertEquals(
+            listOf(LocalDate(2026, 3, 28)),
+            occurrencesForMonth(listOf(expense), LocalDate(2026, 3, 1)).keys.toList(),
+        )
+        assertEquals(
+            listOf(LocalDate(2026, 10, 28)),
+            occurrencesForMonth(listOf(expense), LocalDate(2026, 10, 1)).keys.toList(),
+        )
+    }
+
+    @Test
+    fun leapDayMonthlyExpenseClampsInLeapYear() {
+        val expense = buildExpense(recurrence = Recurrence.Monthly, firstPayment = LocalDate(2024, 1, 31))
+
+        assertEquals(
+            listOf(LocalDate(2024, 2, 29)),
+            occurrencesForMonth(listOf(expense), LocalDate(2024, 2, 1)).keys.toList(),
+        )
+        assertEquals(
+            listOf(LocalDate(2024, 3, 29)),
+            occurrencesForMonth(listOf(expense), LocalDate(2024, 3, 1)).keys.toList(),
+        )
+    }
+
+    @Test
+    fun yearlyExpenseAppearsInEveryYearOnTheSameDay() {
+        val expense = buildExpense(recurrence = Recurrence.Yearly, firstPayment = LocalDate(2026, 10, 5))
+
+        assertEquals(
+            listOf(LocalDate(2026, 10, 5)),
+            occurrencesForMonth(listOf(expense), LocalDate(2026, 10, 1)).keys.toList(),
+        )
+        assertEquals(
+            listOf(LocalDate(2027, 10, 5)),
+            occurrencesForMonth(listOf(expense), LocalDate(2027, 10, 1)).keys.toList(),
+        )
+        assertTrue(occurrencesForMonth(listOf(expense), LocalDate(2026, 11, 1)).isEmpty())
+    }
+
+    @Test
+    fun leapDayYearlyExpenseUsesTheLastDayOfFebruary() {
+        val expense = buildExpense(recurrence = Recurrence.Yearly, firstPayment = LocalDate(2024, 2, 29))
+
+        assertEquals(
+            listOf(LocalDate(2024, 2, 29)),
+            occurrencesForMonth(listOf(expense), LocalDate(2024, 2, 1)).keys.toList(),
+        )
+        assertEquals(
+            listOf(LocalDate(2025, 2, 28)),
+            occurrencesForMonth(listOf(expense), LocalDate(2025, 2, 1)).keys.toList(),
+        )
+        assertEquals(
+            listOf(LocalDate(2026, 2, 28)),
+            occurrencesForMonth(listOf(expense), LocalDate(2026, 2, 1)).keys.toList(),
+        )
+    }
+
+    @Test
+    fun endDateStopsOccurrencesInclusively() {
+        val expense =
+            buildExpense(
+                recurrence = Recurrence.Monthly,
+                firstPayment = LocalDate(2026, 1, 1),
+                endDate = LocalDate(2026, 5, 1),
+            )
+
+        assertEquals(
+            listOf(LocalDate(2026, 5, 1)),
+            occurrencesForMonth(listOf(expense), LocalDate(2026, 5, 1)).keys.toList(),
+        )
+        assertTrue(occurrencesForMonth(listOf(expense), LocalDate(2026, 6, 1)).isEmpty())
+    }
+
+    @Test
+    fun endDateInTheMiddleOfAMonthKeepsOnlyEarlierOccurrences() {
+        val expense =
+            buildExpense(
+                recurrence = Recurrence.Daily,
+                firstPayment = LocalDate(2026, 10, 1),
+                endDate = LocalDate(2026, 10, 10),
+            )
+
+        val occurrences = occurrencesForMonth(listOf(expense), LocalDate(2026, 10, 1))
+
+        assertEquals(LocalDate(2026, 10, 10), occurrences.keys.max())
+        assertEquals(10, occurrences.size)
+    }
+
+    @Test
+    fun multipleItemsOnTheSameDayAreStableAndSorted() {
+        val zeta = buildExpense(id = 1, name = "Zeta", firstPayment = LocalDate(2026, 10, 10))
+        val alpha = buildExpense(id = 2, name = "Alpha", firstPayment = LocalDate(2026, 10, 10))
+
+        val occurrences = occurrencesForMonth(listOf(zeta, alpha), LocalDate(2026, 10, 1))
+
+        val day = occurrences.getValue(LocalDate(2026, 10, 10))
+        assertEquals(2, day.size)
+        assertEquals(listOf("Alpha", "Zeta"), day.map { it.name })
+    }
+
+    @Test
+    fun emptyMonthAndExpensesWithoutFirstPaymentProduceNothing() {
+        assertTrue(occurrencesForMonth(emptyList(), LocalDate(2026, 10, 1)).isEmpty())
+
+        val withoutFirstPayment = buildExpense(firstPayment = null)
+        assertTrue(occurrencesForMonth(listOf(withoutFirstPayment), LocalDate(2026, 10, 1)).isEmpty())
+
+        val farFuture = buildExpense(firstPayment = LocalDate(2030, 1, 1))
+        assertTrue(occurrencesForMonth(listOf(farFuture), LocalDate(2026, 10, 1)).isEmpty())
+    }
+
+    @Test
+    fun archivedExpensesAreNeverProjected() {
+        val archived = buildExpense(archived = true)
+
+        assertTrue(occurrencesForMonth(listOf(archived), LocalDate(2026, 10, 1)).isEmpty())
+    }
+
+    @Test
+    fun manualConfirmationExpensesCarryPaidState() {
+        val expense =
+            buildExpense(
+                recurrence = Recurrence.Daily,
+                firstPayment = LocalDate(2026, 10, 1),
+                requireManualConfirmation = true,
+            )
+        val paidEpoch = LocalDate(2026, 10, 1).atStartOfDayIn(TimeZone.UTC).toEpochMilliseconds()
+
+        val occurrences =
+            occurrencesForMonth(
+                expenses = listOf(expense),
+                monthStart = LocalDate(2026, 10, 1),
+                paidDatesByExpense = mapOf(expense.id to setOf(paidEpoch)),
+            )
+
+        assertTrue(occurrences.getValue(LocalDate(2026, 10, 1)).single().isPaid)
+        assertFalse(occurrences.getValue(LocalDate(2026, 10, 2)).single().isPaid)
+    }
+
+    @Test
+    fun automaticallyPaidExpensesIgnorePaymentRecords() {
+        val expense = buildExpense(firstPayment = LocalDate(2026, 10, 1))
+        val paidEpoch = LocalDate(2026, 10, 1).atStartOfDayIn(TimeZone.UTC).toEpochMilliseconds()
+
+        val occurrences =
+            occurrencesForMonth(
+                expenses = listOf(expense),
+                monthStart = LocalDate(2026, 10, 1),
+                paidDatesByExpense = mapOf(expense.id to setOf(paidEpoch)),
+            )
+
+        assertFalse(occurrences.getValue(LocalDate(2026, 10, 1)).single().isPaid)
+    }
+
+    @Test
+    fun occurrencesExposeTheExpensePresentationData() {
+        val expense =
+            buildExpense(
+                id = 42,
+                name = "Streaming",
+                recurrence = Recurrence.Yearly,
+                everyXRecurrence = 2,
+                firstPayment = LocalDate(2026, 10, 5),
+                serviceId = "netflix",
+            )
+
+        val occurrence =
+            occurrencesForMonth(
+                listOf(expense),
+                LocalDate(2026, 10, 1),
+            ).getValue(LocalDate(2026, 10, 5)).single()
+
+        assertEquals(42, occurrence.expenseId)
+        assertEquals("Streaming", occurrence.name)
+        assertEquals("netflix", occurrence.serviceId)
+        assertEquals(Recurrence.Yearly, occurrence.recurrence)
+        assertEquals(2, occurrence.everyXRecurrence)
+        assertEquals(LocalDate(2026, 10, 5), occurrence.date)
+    }
+}
