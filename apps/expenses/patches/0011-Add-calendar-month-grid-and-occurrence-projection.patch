+package de.dbauer.expensetracker.shared.model.calendar
+
+import kotlinx.datetime.DateTimeUnit
+import kotlinx.datetime.LocalDate
+import kotlinx.datetime.daysUntil
+import kotlinx.datetime.isoDayNumber
+import kotlinx.datetime.minus
+import kotlinx.datetime.plus
+
+/**
+ * Number of empty cells before the first day of [monthStart] when the week starts on
+ * [firstDayOfWeekIso]. [monthStart] must be the first day of a month.
+ */
+fun leadingBlanks(
+    monthStart: LocalDate,
+    firstDayOfWeekIso: Int,
+): Int {
+    val offset = monthStart.dayOfWeek.isoDayNumber - firstDayOfWeekIso
+    return offset.mod(DAYS_PER_WEEK)
+}
+
+/** Number of days in the month that starts at [monthStart]. */
+fun daysInMonth(monthStart: LocalDate): Int {
+    return monthStart.daysUntil(monthStart.plus(1, DateTimeUnit.MONTH))
+}
+
+/**
+ * Builds the whole 7-column month grid for [monthStart], including the trailing days of the
+ * previous month and the leading days of the next month so every row is full (like Tilla does).
+ *
+ * [itemsByDay] is the projection for [monthStart]'s month only; adjacent-month cells never show
+ * markers, they are just navigation targets. [today] and [selectedDate] may be outside the month.
+ */
+fun monthGrid(
+    monthStart: LocalDate,
+    firstDayOfWeekIso: Int,
+    today: LocalDate,
+    selectedDate: LocalDate,
+    itemsByDay: Map<LocalDate, List<CalendarOccurrence>>,
+): List<CalendarDayCell> {
+    val leading = leadingBlanks(monthStart, firstDayOfWeekIso)
+    val cellCount = ceilToWeek(leading + daysInMonth(monthStart))
+    val gridStart = monthStart.minus(leading, DateTimeUnit.DAY)
+
+    return (0 until cellCount).map { index ->
+        val date = gridStart.plus(index, DateTimeUnit.DAY)
+        val isCurrentMonth = date.year == monthStart.year && date.month == monthStart.month
+        CalendarDayCell(
+            date = date,
+            dayOfMonth = date.day,
+            isCurrentMonth = isCurrentMonth,
+            isToday = date == today,
+            isSelected = date == selectedDate,
+            items = if (isCurrentMonth) itemsByDay[date].orEmpty() else emptyList(),
+        )
+    }
+}
+
+private fun ceilToWeek(days: Int): Int {
+    return ((days + DAYS_PER_WEEK - 1) / DAYS_PER_WEEK) * DAYS_PER_WEEK
+}
