+package de.dbauer.expensetracker.shared.model.calendar
+
+import de.dbauer.expensetracker.shared.data.CurrencyValue
+import de.dbauer.expensetracker.shared.data.Recurrence
+import kotlinx.datetime.LocalDate
+
+/**
+ * One concrete payment of a recurring expense on a concrete day.
+ *
+ * Occurrences are never persisted: they are projected from [de.dbauer.expensetracker.shared.data.RecurringExpenseData]
+ * with the same `getNextPaymentDayAfter` rules the Upcoming screen uses.
+ */
+data class CalendarOccurrence(
+    val expenseId: Int,
+    val date: LocalDate,
+    val name: String,
+    val price: CurrencyValue,
+    val serviceId: String?,
+    val recurrence: Recurrence,
+    val everyXRecurrence: Int,
+    val requiresConfirmation: Boolean,
+    val isPaid: Boolean,
+)
+
+/** A single cell of the month grid, including the adjacent-month filler days. */
+data class CalendarDayCell(
+    val date: LocalDate,
+    val dayOfMonth: Int,
+    val isCurrentMonth: Boolean,
+    val isToday: Boolean,
+    val isSelected: Boolean,
+    val items: List<CalendarOccurrence> = emptyList(),
+) {
+    val itemCount: Int
+        get() = items.size
+
+    val firstItem: CalendarOccurrence?
+        get() = items.firstOrNull()
+
+    /**
+     * True when every occurrence on this day was explicitly marked as paid. Expenses that are paid
+     * automatically are never stored in `payment_records`, so a mixed day never counts as paid.
+     */
+    val allItemsPaid: Boolean
+        get() = items.isNotEmpty() && items.all { it.isPaid }
+}
diff --git a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/calendar/CalendarOccurrences.kt b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/calendar/CalendarOccurrences.kt
