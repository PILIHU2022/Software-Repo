+
+    private val byId: Map<String, ExpenseService> = services.associateBy { it.id }
+
+    fun find(id: String?): ExpenseService? = id?.let(byId::get)
+
+    fun forCategory(category: ExpenseServiceCategory): List<ExpenseService> = services.filter { it.category == category }
+
+    fun search(query: String): List<ExpenseService> {
+        val normalized = query.trim().lowercase()
+        if (normalized.isEmpty()) return services
+        return services.filter {
+            it.name.lowercase().contains(normalized) || it.id.contains(normalized)
+        }
+    }
+}
