 import androidx.compose.material.icons.rounded.ShoppingBag
@@ -830,7 +830,7 @@ object ExpenseServiceCatalog {
             name = "Tax",
             category = ExpenseServiceCategory.FINANCE,
             backgroundColor = Color(0xFF6B4A4A),
-            icon = ExpenseServiceIcon.Material(Icons.Rounded.ReceiptLong),
+            icon = ExpenseServiceIcon.Material(Icons.AutoMirrored.Rounded.ReceiptLong),
         ),
         ExpenseService(
             id = "generic_childcare",
diff --git a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/RecurringExpenseWithTagsMapper.kt b/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/RecurringExpenseWithTagsMapper.kt
index 4018f5a..4b2bd21 100644
--- a/shared/src/commonMain/kotlin/de/dbauer/expensetracker/shared/model/database/RecurringExpenseWithTagsMapper.kt
