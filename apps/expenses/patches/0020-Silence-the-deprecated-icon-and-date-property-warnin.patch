@@ -43,6 +43,7 @@ import de.dbauer.expensetracker.shared.ui.home.CardLayoutPrefs
 import de.dbauer.expensetracker.shared.ui.home.CardLineSource
 import de.dbauer.expensetracker.shared.ui.home.CardPriceMode
 import kotlinx.datetime.LocalDate
+import kotlinx.datetime.number
 import org.jetbrains.compose.resources.painterResource
 import org.jetbrains.compose.resources.pluralStringResource
 import org.jetbrains.compose.resources.stringResource
@@ -357,14 +358,14 @@ private fun ordinalDateLabel(daysUntilPayment: Int?): String? {
 }
 
 private fun LocalDate.formatActualDate(pattern: CardActualDatePattern): String {
-    val day = dayOfMonth.toString().padStart(2, '0')
-    val month = monthNumber.toString().padStart(2, '0')
+    val dayText = day.toString().padStart(2, '0')
+    val monthText = month.number.toString().padStart(2, '0')
     return when (pattern) {
-        CardActualDatePattern.MonthDayYear -> "$month/$day/$year"
-        CardActualDatePattern.DayMonthYearSlash -> "$day/$month/$year"
-        CardActualDatePattern.YearMonthDaySlash -> "$year/$month/$day"
-        CardActualDatePattern.DayMonthYearDash -> "$day-$month-$year"
-        CardActualDatePattern.DayMonthYearDot -> "$day.$month.$year"
+        CardActualDatePattern.MonthDayYear -> "$monthText/$dayText/$year"
+        CardActualDatePattern.DayMonthYearSlash -> "$dayText/$monthText/$year"
+        CardActualDatePattern.YearMonthDaySlash -> "$year/$monthText/$dayText"
+        CardActualDatePattern.DayMonthYearDash -> "$dayText-$monthText-$year"
+        CardActualDatePattern.DayMonthYearDot -> "$dayText.$monthText.$year"
     }
 }
 
