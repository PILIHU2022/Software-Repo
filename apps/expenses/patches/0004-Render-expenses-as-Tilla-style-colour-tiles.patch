+@Composable
+fun ExpenseServiceIconView(
+    service: ExpenseService?,
+    tint: Color,
+    modifier: Modifier = Modifier,
+) {
+    val iconTint = service?.iconTint ?: tint
+    val contentDescription = service?.name
+    when (val icon = service?.icon) {
+        is ExpenseServiceIcon.Brand ->
+            Icon(
+                painter = painterResource(icon.drawable),
+                contentDescription = contentDescription,
+                tint = iconTint,
+                modifier = modifier,
+            )
+
+        is ExpenseServiceIcon.Material ->
+            Icon(
+                imageVector = icon.imageVector,
+                contentDescription = contentDescription,
+                tint = iconTint,
+                modifier = modifier,
+            )
+
+        null ->
+            Icon(
+                imageVector = Icons.Rounded.Category,
+                contentDescription = null,
+                tint = tint,
+                modifier = modifier,
+            )
+    }
+}
