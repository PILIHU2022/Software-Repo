+/**
+ * A full-bleed, colour-coded expense tile inspired by Tilla.
+ */
+@Composable
+fun TillaExpenseCard(
+    expense: RecurringExpenseData,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    compact: Boolean = false,
+) {
+    val service = ExpenseServiceCatalog.find(expense.serviceId)
+    val background = service?.backgroundColor ?: remember(expense.name) { fallbackCardColor(expense.name) }
+    val foreground =
+        service?.foregroundColor ?: if (background.luminance() > 0.5f) Color(0xFF151719) else Color.White
+    val iconTint = service?.iconTint ?: foreground
+
+    Surface(
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .clip(TillaCardShape)
+                .clickable(onClick = onClick),
+        shape = TillaCardShape,
+        color = background,
+        contentColor = foreground,
+    ) {
+        Row(
+            modifier =
+                Modifier
+                    .fillMaxWidth()
+                    .padding(
+                        horizontal = if (compact) 14.dp else 18.dp,
+                        vertical = if (compact) 14.dp else 17.dp,
+                    ),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            ExpenseServiceIconView(
+                service = service,
+                tint = iconTint,
+                modifier = Modifier.size(if (compact) 28.dp else 32.dp),
+            )
+            Spacer(modifier = Modifier.size(if (compact) 10.dp else 14.dp))
+            Column(
+                modifier = Modifier.weight(1f),
+                verticalArrangement = Arrangement.Center,
+            ) {
+                Text(
+                    text = expense.name,
+                    fontSize = if (compact) 15.sp else 16.sp,
+                    fontWeight = FontWeight.SemiBold,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+                if (!compact && expense.description.isNotBlank()) {
+                    Text(
+                        text = expense.description,
+                        fontSize = 12.sp,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                        modifier = Modifier.padding(top = 2.dp),
+                        color = foreground.copy(alpha = 0.72f),
+                    )
+                }
+                if (expense.tags.isNotEmpty()) {
+                    Row(
+                        horizontalArrangement = Arrangement.spacedBy(3.dp),
+                        modifier = Modifier.padding(top = if (compact) 3.dp else 5.dp),
+                    ) {
+                        expense.tags.take(6).forEach { tag ->
+                            Box(
+                                modifier =
+                                    Modifier
+                                        .size(if (compact) 4.dp else 5.dp)
+                                        .background(Color(tag.color), CircleShape),
+                            )
+                        }
+                    }
+                }
+            }
+            Spacer(modifier = Modifier.size(8.dp))
+            Column(horizontalAlignment = Alignment.End) {
+                Text(
+                    text = expense.monthlyPrice.toCurrencyString(),
+                    fontSize = if (compact) 15.sp else 17.sp,
+                    fontWeight = FontWeight.Bold,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+                Text(
+                    text = remainingLabel(expense).uppercase(),
+                    fontSize = if (compact) 9.sp else 10.sp,
+                    fontWeight = FontWeight.Medium,
+                    letterSpacing = 0.4.sp,
+                    color = foreground.copy(alpha = 0.78f),
+                    maxLines = 1,
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun remainingLabel(expense: RecurringExpenseData): String {
+    val today = Clock.System.now().toLocalDateTime(TimeZone.currentSystemDefault()).date
+    val nextPayment = expense.getNextPaymentDay()
+    if (nextPayment == null) {
+        return stringResource(expense.recurrence.fullStringRes)
+    }
+
+    val days = (nextPayment.toEpochDays() - today.toEpochDays()).toInt()
+    return when {
+        days <= 0 -> stringResource(Res.string.home_card_today)
+        days == 1 -> stringResource(Res.string.home_card_tomorrow)
+        days < 30 -> pluralStringResource(Res.plurals.home_card_days, days, days)
+        days < 365 -> {
+            val months = (days / 30).coerceAtLeast(1)
+            pluralStringResource(Res.plurals.home_card_months, months, months)
+        }
+        else -> {
+            val years = (days / 365).coerceAtLeast(1)
+            pluralStringResource(Res.plurals.home_card_years, years, years)
+        }
+    }
+}
