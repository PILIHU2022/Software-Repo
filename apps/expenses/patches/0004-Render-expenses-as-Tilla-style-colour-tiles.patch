+private val TillaCardShape = RoundedCornerShape(26.dp)
+
+/** Muted mint / deep green page backgrounds used by Tilla. */
+val TillaBackgroundLight = Color(0xFFEFF6F2)
+val TillaBackgroundDark = Color(0xFF0E1513)
+
+private val fallbackCardColors =
+    listOf(
+        Color(0xFF2F5D57),
+        Color(0xFF4E5A78),
+        Color(0xFF6B4A5E),
+        Color(0xFF5A6040),
+        Color(0xFF3E6274),
+        Color(0xFF72513E),
+        Color(0xFF4A4E66),
+        Color(0xFF3F6552),
+    )
+
+internal fun fallbackCardColor(name: String): Color {
+    val index = (name.hashCode() and Int.MAX_VALUE) % fallbackCardColors.size
+    return fallbackCardColors[index]
+}
