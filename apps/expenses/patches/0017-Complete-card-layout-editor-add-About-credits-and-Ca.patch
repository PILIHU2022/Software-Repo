+@Composable
+private fun ordinalDateLabel(daysUntilPayment: Int?): String? {
+    if (daysUntilPayment == null) return null
+    val label =
+        if (daysUntilPayment <= 0) {
+            stringResource(Res.string.home_card_today)
+        } else {
+            pluralStringResource(
+                Res.plurals.home_card_days,
+                daysUntilPayment,
+                daysUntilPayment,
+            )
+        }
+    return label.uppercase()
+}
+
+private fun LocalDate.formatActualDate(pattern: CardActualDatePattern): String {
+    val day = dayOfMonth.toString().padStart(2, '0')
+    val month = monthNumber.toString().padStart(2, '0')
+    return when (pattern) {
+        CardActualDatePattern.MonthDayYear -> "$month/$day/$year"
+        CardActualDatePattern.DayMonthYearSlash -> "$day/$month/$year"
+        CardActualDatePattern.YearMonthDaySlash -> "$year/$month/$day"
+        CardActualDatePattern.DayMonthYearDash -> "$day-$month-$year"
+        CardActualDatePattern.DayMonthYearDot -> "$day.$month.$year"
+    }
+}
+
+private fun RecurringExpenseData.lineValue(
+    source: CardLineSource,
+    nextPaymentLine: String?,
+): String? =
+    when (source) {
+        CardLineSource.None -> null
+        CardLineSource.Description -> description.takeIf { it.isNotBlank() }
+        CardLineSource.Tags ->
+            tags.take(3).joinToString(" · ") { it.title }.takeIf { it.isNotBlank() }
+        CardLineSource.NextPayment -> nextPaymentLine
+    }
