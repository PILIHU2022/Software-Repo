+ * Converts a monthly amount into the amount for the analytics period:
+ * 0 = week (12 months / 52 weeks), 1 = month (unchanged), 2 = year.
+ */
+private fun monthlyToPeriodAmount(
+    monthlyPrice: Float,
+    period: Int,
