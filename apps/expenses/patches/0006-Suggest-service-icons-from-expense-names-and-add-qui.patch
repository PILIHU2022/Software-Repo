+import de.dbauer.expensetracker.shared.data.ExpenseServiceCatalog
+import de.dbauer.expensetracker.shared.data.ExpenseTemplate
+import de.dbauer.expensetracker.shared.data.ExpenseTemplates
+import org.jetbrains.compose.resources.stringResource
+import recurringexpensetracker.shared.generated.resources.Res
+import recurringexpensetracker.shared.generated.resources.edit_expense_quick_templates
+import recurringexpensetracker.shared.generated.resources.edit_expense_quick_templates_hint
+
+/**
+ * Horizontal row of one-tap presets shown at the top of the "new expense" screen.
+ *
+ * Tapping a template fills name, icon, price and recurrence at once (see
+ * [de.dbauer.expensetracker.shared.viewmodel.EditRecurringExpenseViewModel.onTemplateSelected]).
+ */
+@Composable
+fun QuickTemplatesRow(
+    onTemplateSelected: (ExpenseTemplate) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .padding(top = 8.dp),
+    ) {
+        Text(
+            text = stringResource(Res.string.edit_expense_quick_templates),
+            style = MaterialTheme.typography.titleSmall,
+        )
+        Text(
+            text = stringResource(Res.string.edit_expense_quick_templates_hint),
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(top = 2.dp),
+        )
+        Row(
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+            modifier =
+                Modifier
+                    .fillMaxWidth()
+                    .horizontalScroll(rememberScrollState())
+                    .padding(vertical = 8.dp),
+        ) {
+            ExpenseTemplates.quickTemplates.forEach { template ->
+                val service = remember(template.serviceId) { ExpenseServiceCatalog.find(template.serviceId) }
+                AssistChip(
+                    onClick = { onTemplateSelected(template) },
+                    label = { Text(text = template.name) },
+                    leadingIcon = {
+                        ServiceAvatar(
+                            service = service,
+                            size = 20.dp,
+                            iconSize = 12.dp,
+                        )
+                    },
+                )
+            }
+        }
+    }
+}
