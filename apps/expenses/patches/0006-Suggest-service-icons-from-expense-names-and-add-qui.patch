+
+    @Test
+    fun `normalization removes punctuation and casing`() {
+        assertEquals("youtube music", ExpenseServiceNameMatcher.normalize("  YouTube   Music!! "))
+        assertEquals("1password", ExpenseServiceNameMatcher.normalize("1Password"))
+        assertEquals("", ExpenseServiceNameMatcher.normalize("…"))
+    }
+}
