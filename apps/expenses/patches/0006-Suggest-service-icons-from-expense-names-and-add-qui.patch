+package de.dbauer.expensetracker.shared.data
+
+/**
+ * Maps a free-form expense name (for example "Netflix Premium") to one of the built-in
+ * [ExpenseService]s.
+ *
+ * Matching is intentionally conservative:
+ * - Names are lowercased, punctuation and emoji are treated as word separators.
+ * - An alias must match a whole word (or a whole sequence of words), never a partial word.
+ * - Ultra-short aliases ("x", "max", "hbo", ...) are only accepted at the beginning of a name
+ *   so that names like "Maximum" or "Rent" never pick a random icon.
+ * - The longest (most specific) alias wins, which makes "youtube music" beat "youtube".
+ *
+ * Brands that have no icon in the catalog (for example Disney+) intentionally resolve to null.
+ */
+object ExpenseServiceNameMatcher {
+    private const val SHORT_ALIAS_MAX_LENGTH = 4
+
+    private data class Alias(
+        val serviceId: String,
+        val words: List<String>,
+        val text: String,
+    )
+
+    private val aliases: List<Alias> =
+        buildAliases()
+            .filter { ExpenseServiceCatalog.find(it.serviceId) != null }
+            .sortedWith(compareByDescending<Alias> { it.words.size }.thenByDescending { it.text.length })
+
+    /**
+     * Returns the built-in service whose brand is mentioned in [name], or `null` when there is
+     * no confident match.
+     */
+    fun find(name: String): ExpenseService? {
+        val words = normalizedWords(name)
+        if (words.isEmpty()) return null
+
+        aliases.forEach { alias ->
+            val index = words.indexOfSequence(alias.words)
+            if (index < 0) return@forEach
+            // Short brand words like "x" or "max" are too ambiguous in the middle of a name.
+            if (index > 0 && alias.words.size == 1 && alias.text.length < SHORT_ALIAS_MAX_LENGTH) {
+                return@forEach
+            }
+            return ExpenseServiceCatalog.find(alias.serviceId)
+        }
+        return null
+    }
+
+    internal fun normalize(value: String): String = normalizedWords(value).joinToString(" ")
+
+    private fun normalizedWords(value: String): List<String> {
+        val words = mutableListOf<String>()
+        val current = StringBuilder()
+        value.forEach { character ->
+            if (character.isLetterOrDigit()) {
+                current.append(character.lowercaseChar())
+            } else if (current.isNotEmpty()) {
+                words.add(current.toString())
+                current.clear()
+            }
+        }
+        if (current.isNotEmpty()) {
+            words.add(current.toString())
+        }
+        return words
+    }
+
+    private fun List<String>.indexOfSequence(sequence: List<String>): Int {
+        if (sequence.isEmpty() || sequence.size > size) return -1
+        for (start in 0..(size - sequence.size)) {
+            var matches = true
+            for (offset in sequence.indices) {
+                if (this[start + offset] != sequence[offset]) {
+                    matches = false
+                    break
+                }
+            }
+            if (matches) return start
+        }
+        return -1
+    }
+
+    private fun buildAliases(): List<Alias> {
+        val aliases = mutableListOf<Alias>()
+
+        fun service(
+            serviceId: String,
+            vararg names: String,
+        ) {
+            names.forEach { name ->
+                val text = normalize(name)
+                if (text.isNotEmpty()) {
+                    aliases.add(Alias(serviceId, text.split(' '), text))
+                }
+            }
+        }
+
