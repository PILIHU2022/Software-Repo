+    /**
+     * Updates the name and, as long as the user did not pick an icon manually, keeps the
+     * selected icon in sync with the name (for example "Netflix" -> Netflix icon).
+     */
+    fun onNameChanged(name: String) {
+        nameState = name
+        if (isServiceManuallySelected) return
+
+        val matched = ExpenseServiceNameMatcher.find(name)
+        if (matched == null) {
+            // Forget an icon that was only inferred from a name the user just replaced.
+            if (selectedServiceId != null && selectedServiceId == autoSelectedServiceId) {
+                selectedServiceId = null
+                autoSelectedServiceId = null
+            }
+            return
+        }
+        // Never overwrite an icon that came from the database or the user.
+        if (selectedServiceId != null && selectedServiceId != autoSelectedServiceId) return
+
+        selectedServiceId = matched.id
+        autoSelectedServiceId = matched.id
+    }
