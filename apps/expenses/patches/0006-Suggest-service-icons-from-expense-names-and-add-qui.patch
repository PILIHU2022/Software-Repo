+package de.dbauer.expensetracker.shared.data
+
+/**
+ * A one-tap preset for a new recurring expense.
+ *
+ * [monthlyPrice] is a typical monthly price in the user's default currency, only used to
+ * pre-fill the price field; the user can always change it before saving.
+ */
+data class ExpenseTemplate(
+    val name: String,
+    val serviceId: String,
+    val monthlyPrice: Float,
+)
+
+/**
+ * Curated quick templates for the most common subscriptions.
+ *
+ * Keep this list short and well known: it is rendered as a horizontal chip row at the top of
+ * the "new expense" screen. Brand names stay untranslated.
+ */
+object ExpenseTemplates {
+    val quickTemplates: List<ExpenseTemplate> =
+        listOf(
+            ExpenseTemplate(name = "Netflix", serviceId = "netflix", monthlyPrice = 15.49f),
+            ExpenseTemplate(name = "Spotify", serviceId = "spotify", monthlyPrice = 11.99f),
+            ExpenseTemplate(name = "YouTube Premium", serviceId = "youtube", monthlyPrice = 13.99f),
+            ExpenseTemplate(name = "ChatGPT", serviceId = "openai", monthlyPrice = 20.00f),
+            ExpenseTemplate(name = "Claude", serviceId = "claude", monthlyPrice = 20.00f),
+            ExpenseTemplate(name = "Notion", serviceId = "notion", monthlyPrice = 10.00f),
+            ExpenseTemplate(name = "Adobe", serviceId = "adobe", monthlyPrice = 22.99f),
+            ExpenseTemplate(name = "Prime Video", serviceId = "primevideo", monthlyPrice = 8.99f),
+            ExpenseTemplate(name = "Apple One", serviceId = "apple", monthlyPrice = 19.95f),
+            ExpenseTemplate(name = "GitHub", serviceId = "github", monthlyPrice = 4.00f),
+        )
+}
