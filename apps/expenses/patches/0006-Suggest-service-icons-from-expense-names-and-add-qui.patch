+        assertNull(serviceId("Maximum"))
+        assertNull(serviceId("TV licence"))
+        assertNull(serviceId("Spotification"))
+        assertNull(serviceId("Renting a car"))
+    }
+
+    @Test
+    fun `short aliases are only matched at the beginning of a name`() {
