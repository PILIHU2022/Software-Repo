+import de.dbauer.expensetracker.shared.ui.DefaultTab
+import de.dbauer.expensetracker.shared.ui.elements.TimePickerDialog
+import de.dbauer.expensetracker.shared.viewmodel.SettingsViewModel
+import kotlinx.datetime.LocalTime
+import org.jetbrains.compose.resources.stringResource
+import org.koin.compose.viewmodel.koinViewModel
+import recurringexpensetracker.shared.generated.resources.Res
+import recurringexpensetracker.shared.generated.resources.bottom_nav_calendar
+import recurringexpensetracker.shared.generated.resources.bottom_nav_home
+import recurringexpensetracker.shared.generated.resources.dialog_ok
+import recurringexpensetracker.shared.generated.resources.settings_about
+import recurringexpensetracker.shared.generated.resources.settings_about_app
+import recurringexpensetracker.shared.generated.resources.settings_backup
+import recurringexpensetracker.shared.generated.resources.settings_backup_create
+import recurringexpensetracker.shared.generated.resources.settings_backup_restore
+import recurringexpensetracker.shared.generated.resources.settings_default_tab
+import recurringexpensetracker.shared.generated.resources.settings_general_interface
+import recurringexpensetracker.shared.generated.resources.settings_general_notifications
+import recurringexpensetracker.shared.generated.resources.settings_general_security
+import recurringexpensetracker.shared.generated.resources.settings_general_storage
+import recurringexpensetracker.shared.generated.resources.settings_general_system
