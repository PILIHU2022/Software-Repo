+@Composable
+fun SettingsAppearanceScreen(
+    modifier: Modifier = Modifier,
+    viewModel: SettingsViewModel = koinViewModel(),
+) {
+    val presetValue by viewModel.themePreset.collectAsState()
+    val currentPreset = ThemePreset.fromInt(presetValue)
+    val dynamicColor by viewModel.dynamicColor.collectAsState()
+    val themeMode by viewModel.selectedThemeMode.collectAsState(ThemeMode.FollowSystem)
+    val darkTheme =
+        when (themeMode) {
+            ThemeMode.FollowSystem -> isSystemInDarkTheme()
+            ThemeMode.Dark, ThemeMode.Amoled -> true
+            ThemeMode.Light -> false
+        }
+    var showThemePicker by remember { mutableStateOf(false) }
+    var showDarkModeDialog by remember { mutableStateOf(false) }
+
+    Column(
+        modifier =
+            modifier
+                .fillMaxSize()
+                .verticalScroll(rememberScrollState())
+                .padding(horizontal = 16.dp),
+    ) {
+        SettingsSectionTitle(stringResource(Res.string.settings_appearance_category_design))
+        SettingsGroup {
+            SettingsRow(
+                icon = Icons.Rounded.Palette,
+                title = stringResource(Res.string.settings_appearance_theme_title),
+                subtitle = currentPreset.label(),
+                onClick = { showThemePicker = true },
+                trailing = {
+                    Row(
+                        horizontalArrangement = Arrangement.spacedBy(4.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                    ) {
+                        currentPreset.previewColors(darkTheme).forEach { color ->
+                            Box(
+                                modifier =
+                                    Modifier
+                                        .size(16.dp)
+                                        .background(color, CircleShape),
+                            )
+                        }
+                    }
+                },
+            )
+            SettingsDivider()
+            SettingsSwitchRow(
+                icon = Icons.Rounded.ColorLens,
+                title = stringResource(Res.string.settings_appearance_dynamic_colors_title),
+                subtitle = stringResource(Res.string.settings_appearance_dynamic_colors_summary),
+                checked = dynamicColor,
+                onCheckedChange = viewModel::onDynamicColorChange,
+            )
+            SettingsDivider()
+            SettingsRow(
+                icon = Icons.Rounded.DarkMode,
+                title = stringResource(Res.string.settings_appearance_dark_mode_title),
+                subtitle = themeMode.label(),
+                onClick = { showDarkModeDialog = true },
+            )
+        }
+
+        SettingsSectionTitle(stringResource(Res.string.settings_appearance_preview))
+        AppearancePreview(currentPreset, dark = darkTheme)
+        Column(modifier = Modifier.padding(bottom = 24.dp)) {}
+    }
+
+    if (showThemePicker) {
+        AlertDialog(
+            onDismissRequest = { showThemePicker = false },
+            title = { Text(stringResource(Res.string.settings_appearance_theme_picker_title)) },
+            text = {
+                Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                    ThemePreset.entries.chunked(2).forEach { rowPresets ->
+                        Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                            rowPresets.forEach { preset ->
+                                ThemePresetCard(
+                                    preset = preset,
+                                    selected = preset == currentPreset,
+                                    dark = darkTheme,
+                                    onClick = {
+                                        viewModel.onThemePresetSelected(preset)
+                                        showThemePicker = false
+                                    },
+                                    modifier = Modifier.weight(1f),
+                                )
+                            }
+                            if (rowPresets.size == 1) {
+                                Spacer(modifier = Modifier.weight(1f))
+                            }
+                        }
+                    }
+                }
+            },
+            confirmButton = {
+                TextButton(onClick = { showThemePicker = false }) {
+                    Text(stringResource(Res.string.cancel))
+                }
+            },
+        )
+    }
+
+    if (showDarkModeDialog) {
+        SettingsChoiceDialog(
+            title = stringResource(Res.string.settings_appearance_dark_mode_title),
+            options = ThemeMode.entries,
+            selected = themeMode,
+            onSelect = {
