+package de.dbauer.expensetracker.shared.ui.theme
+
+import androidx.compose.material3.ColorScheme
+import androidx.compose.material3.darkColorScheme
+import androidx.compose.material3.lightColorScheme
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.luminance
+import kotlin.math.max
+import kotlin.math.min
+
+/**
+ * The bundled color themes offered in Settings → Appearance.
+ *
+ * Every preset is described by a single seed color plus a pair of backgrounds. A complete
+ * Material 3 [ColorScheme] is derived from those values, so adding a preset is a one-line change.
+ */
+enum class ThemePreset(
+    val value: Int,
+    val seed: Color,
+    val lightBackground: Color,
+    val darkBackground: Color,
+) {
+    Tilla(0, Color(0xFF00C9B7), Color(0xFFEFF6F2), Color(0xFF0E1513)),
+    Ocean(1, Color(0xFF2F80ED), Color(0xFFF3F7FF), Color(0xFF0B1220)),
+    Violet(2, Color(0xFF7C5CFF), Color(0xFFF7F3FF), Color(0xFF120F1C)),
+    Forest(3, Color(0xFF2E9E5B), Color(0xFFF1F8F2), Color(0xFF0C1510)),
+    Sunset(4, Color(0xFFF2994A), Color(0xFFFFF7EF), Color(0xFF1A120A)),
+    Rose(5, Color(0xFFE85D75), Color(0xFFFFF4F6), Color(0xFF1A0E12)),
+    Graphite(6, Color(0xFF7C8B99), Color(0xFFF4F6F8), Color(0xFF101416)),
+    ;
+
+    companion object {
+        fun fromInt(value: Int): ThemePreset = entries.firstOrNull { it.value == value } ?: Tilla
+    }
+}
+
+/** Light and dark scheme cache; building a scheme only does cheap color math. */
+private val schemeCache = mutableMapOf<Pair<Int, Boolean>, ColorScheme>()
+
+fun themeColorScheme(
+    preset: ThemePreset,
+    dark: Boolean,
+): ColorScheme =
+    schemeCache.getOrPut(preset.value to dark) {
+        if (dark) darkScheme(preset) else lightScheme(preset)
+    }
+
+private val lightInk = Color(0xFF141A18)
+private val darkInk = Color(0xFFE2E9E6)
+
+private fun lightScheme(preset: ThemePreset): ColorScheme {
+    val seed = preset.seed
+    val background = preset.lightBackground
+    val primary = seed.onLight()
+    val secondary = seed.mix(Color(0xFF5A6670), 0.55f).onLight()
+    val tertiary = seed.shiftHue(52f).mix(Color(0xFF6B5FA8), 0.35f).onLight()
+    val surfaceVariant = seed.mix(Color.White, 0.90f)
+    val outline = seed.mix(Color(0xFF6D7A75), 0.65f)
+    return lightColorScheme(
+        primary = primary,
+        onPrimary = primary.contrastForeground(),
+        primaryContainer = seed.mix(Color.White, 0.82f),
+        onPrimaryContainer = seed.mix(Color.Black, 0.62f),
+        inversePrimary = seed.mix(Color.White, 0.55f),
+        secondary = secondary,
+        onSecondary = secondary.contrastForeground(),
+        secondaryContainer = seed.mix(Color.White, 0.88f),
+        onSecondaryContainer = secondary.mix(Color.Black, 0.58f),
+        tertiary = tertiary,
+        onTertiary = tertiary.contrastForeground(),
+        tertiaryContainer = seed.shiftHue(52f).mix(Color.White, 0.82f),
+        onTertiaryContainer = tertiary.mix(Color.Black, 0.58f),
+        error = Color(0xFFBA1A1A),
+        onError = Color.White,
+        errorContainer = Color(0xFFFFDAD6),
+        onErrorContainer = Color(0xFF410002),
+        background = background,
+        onBackground = lightInk,
+        surface = background,
+        onSurface = lightInk,
+        surfaceTint = primary,
+        surfaceVariant = surfaceVariant,
+        onSurfaceVariant = Color(0xFF46534F),
+        surfaceBright = Color.White,
+        surfaceDim = background.mix(seed, 0.14f),
+        surfaceContainerLowest = Color.White,
+        surfaceContainerLow = background.mix(Color.White, 0.55f),
+        surfaceContainer = background.mix(seed, 0.06f),
+        surfaceContainerHigh = seed.mix(Color.White, 0.86f),
+        surfaceContainerHighest = seed.mix(Color.White, 0.80f),
+        outline = outline,
+        outlineVariant = seed.mix(Color.White, 0.78f),
+        inverseSurface = Color(0xFF2D3331),
+        inverseOnSurface = Color(0xFFF0F4F2),
+        scrim = Color.Black,
+    )
+}
+
+private fun darkScheme(preset: ThemePreset): ColorScheme {
+    val seed = preset.seed
+    val background = preset.darkBackground
+    val primary = seed.onDark()
+    val secondary = seed.mix(Color.White, 0.55f).onDarkSoft()
+    val tertiary = seed.shiftHue(52f).mix(Color(0xFFB7A8FF), 0.35f).onDarkSoft()
+    val surfaceVariant = background.mix(seed, 0.14f)
+    return darkColorScheme(
+        primary = primary,
+        onPrimary = primary.contrastForeground(dark = true),
+        primaryContainer = seed.mix(Color.Black, 0.52f),
+        onPrimaryContainer = seed.mix(Color.White, 0.72f),
+        inversePrimary = seed.onLight(),
+        secondary = secondary,
+        onSecondary = secondary.contrastForeground(dark = true),
+        secondaryContainer = background.mix(seed, 0.22f),
+        onSecondaryContainer = seed.mix(Color.White, 0.78f),
+        tertiary = tertiary,
+        onTertiary = tertiary.contrastForeground(dark = true),
+        tertiaryContainer = background.mix(seed.shiftHue(52f), 0.22f),
+        onTertiaryContainer = seed.shiftHue(52f).mix(Color.White, 0.72f),
+        error = Color(0xFFFFB4AB),
+        onError = Color(0xFF690005),
+        errorContainer = Color(0xFF93000A),
+        onErrorContainer = Color(0xFFFFDAD6),
+        background = background,
+        onBackground = darkInk,
+        surface = background,
+        onSurface = darkInk,
+        surfaceTint = primary,
+        surfaceVariant = surfaceVariant,
+        onSurfaceVariant = Color(0xFFB8C6C1),
+        surfaceBright = background.mix(Color.White, 0.22f),
+        surfaceDim = background.mix(Color.Black, 0.28f),
+        surfaceContainerLowest = background.mix(Color.Black, 0.32f),
+        surfaceContainerLow = background.mix(Color.White, 0.04f),
+        surfaceContainer = background.mix(Color.White, 0.07f),
+        surfaceContainerHigh = background.mix(Color.White, 0.11f),
+        surfaceContainerHighest = background.mix(Color.White, 0.16f),
+        outline = Color(0xFF899691),
+        outlineVariant = background.mix(Color.White, 0.20f),
+        inverseSurface = Color(0xFFE2E6E4),
+        inverseOnSurface = Color(0xFF2C3230),
+        scrim = Color.Black,
+    )
+}
+
+private fun Color.mix(
+    other: Color,
+    amount: Float,
+): Color {
+    val t = amount.coerceIn(0f, 1f)
+    return Color(
+        red = red + (other.red - red) * t,
+        green = green + (other.green - green) * t,
+        blue = blue + (other.blue - blue) * t,
+        alpha = alpha + (other.alpha - alpha) * t,
+    )
+}
+
+/** Darken a seed until it has enough contrast on a light surface. */
+private fun Color.onLight(): Color {
+    var color = this
+    var guard = 0
+    while (color.luminance() > 0.42f && guard < 12) {
+        color = color.mix(Color.Black, 0.12f)
+        guard++
+    }
+    return color
+}
+
+/** Brighten a seed until it is readable on a dark surface. */
+private fun Color.onDark(): Color {
+    var color = this
+    var guard = 0
+    while (color.luminance() < 0.45f && guard < 16) {
+        color = color.mix(Color.White, 0.12f)
+        guard++
+    }
+    return color
+}
+
+private fun Color.onDarkSoft(): Color = onDark().mix(Color.White, 0.16f)
+
+private fun Color.contrastForeground(dark: Boolean = false): Color {
+    return if (luminance() < 0.45f) Color.White else Color(0xFF06110D)
+}
+
+private fun Color.shiftHue(degrees: Float): Color {
+    val (h, s, v) = toHsv()
+    val shifted = (h + degrees).mod(360f)
+    val saturation = s.coerceIn(0.28f, 0.72f)
+    return Color.hsv(shifted, saturation, v.coerceIn(0.55f, 0.95f))
+}
+
+private fun Color.toHsv(): Triple<Float, Float, Float> {
+    val r = red
+    val g = green
+    val b = blue
+    val maxC = max(r, max(g, b))
+    val minC = min(r, min(g, b))
+    val delta = maxC - minC
+    val hue =
+        when {
+            delta < 1e-6f -> 0f
+            maxC == r -> 60f * (((g - b) / delta).mod(6f))
+            maxC == g -> 60f * (((b - r) / delta) + 2f)
+            else -> 60f * (((r - g) / delta) + 4f)
+        }
+    val saturation = if (maxC <= 0f) 0f else delta / maxC
+    return Triple(hue, saturation, maxC)
+}
+
+/** True when [color] is closer to black than to white; used for pickers and previews. */
+internal fun Color.isDark(): Boolean = luminance() < 0.5f
+
+private fun Float.mod(divisor: Float): Float {
+    val result = this % divisor
+    return if (result < 0f) result + divisor else result
+}
