+import recurringexpensetracker.shared.generated.resources.settings_notifications_subtitle
+import recurringexpensetracker.shared.generated.resources.settings_notifications_upcoming
+import recurringexpensetracker.shared.generated.resources.settings_security_biometric_lock
+import recurringexpensetracker.shared.generated.resources.settings_start_analytics
+import recurringexpensetracker.shared.generated.resources.settings_start_calendar
+import recurringexpensetracker.shared.generated.resources.settings_start_home
+import recurringexpensetracker.shared.generated.resources.tags_screen_title
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun SettingsGeneralScreen(
+    biometricsChecked: Boolean,
+    canUseBiometric: Boolean,
+    canUseNotifications: Boolean,
+    hasNotificationPermission: Boolean,
+    onClickTags: () -> Unit,
+    onClickBackup: () -> Unit,
+    onClickRestore: () -> Unit,
+    onBiometricCheckedChange: (Boolean) -> Unit,
+    requestNotificationPermission: () -> Unit,
+    navigateToPermissionsSettings: () -> Unit,
+    onClickAbout: () -> Unit,
+    modifier: Modifier = Modifier,
+    viewModel: SettingsViewModel = koinViewModel(),
+) {
+    val defaultTab by viewModel.selectedDefaultTab.collectAsState(DefaultTab.Home)
+    var showStartScreenDialog by rememberSaveable { mutableStateOf(false) }
+
+    Column(
+        modifier =
+            modifier
+                .fillMaxSize()
+                .verticalScroll(rememberScrollState())
+                .padding(horizontal = 16.dp),
+    ) {
+        SettingsSectionTitle(stringResource(Res.string.settings_general_interface))
+        SettingsGroup {
+            SettingsRow(
+                icon = Icons.Rounded.Home,
+                title = stringResource(Res.string.settings_default_tab),
+                subtitle = defaultTab.label(),
+                onClick = { showStartScreenDialog = true },
+            )
+            SettingsDivider()
+            SettingsRow(
+                icon = Icons.Rounded.Tag,
+                title = stringResource(Res.string.tags_screen_title),
+                onClick = onClickTags,
+            )
+        }
+
+        if (canUseBiometric) {
+            SettingsSectionTitle(stringResource(Res.string.settings_general_security))
+            SettingsGroup {
+                SettingsSwitchRow(
+                    icon = Icons.Rounded.Fingerprint,
+                    title = stringResource(Res.string.settings_security_biometric_lock),
+                    checked = biometricsChecked,
+                    onCheckedChange = onBiometricCheckedChange,
+                )
+            }
+        }
+
+        if (canUseNotifications) {
+            val notificationsEnabled by viewModel.upcomingPaymentNotification.collectAsState()
+            SettingsSectionTitle(stringResource(Res.string.settings_general_notifications))
+            SettingsGroup {
+                SettingsSwitchRow(
+                    icon = Icons.Rounded.Notifications,
+                    title = stringResource(Res.string.settings_notifications_upcoming),
+                    subtitle = stringResource(Res.string.settings_notifications_subtitle),
+                    checked = notificationsEnabled,
+                    onCheckedChange = {
+                        viewModel.onUpcomingPaymentNotification(it)
+                        if (it && !hasNotificationPermission) {
+                            requestNotificationPermission()
+                        }
+                    },
+                )
+                AnimatedVisibility(notificationsEnabled) {
+                    Column {
+                        SettingsDivider()
+                        if (!hasNotificationPermission) {
+                            SettingsMissingPermissionElement(
+                                title =
+                                    stringResource(
+                                        Res.string.settings_notifications_missing_permission_title,
+                                    ),
+                                subtitle =
+                                    stringResource(
+                                        Res.string.settings_notifications_missing_permission_subtitle,
+                                    ),
+                                onClick = navigateToPermissionsSettings,
+                            )
+                        }
+                        val notificationTime by viewModel.upcomingPaymentNotificationTime.collectAsState()
+                        SettingsRow(
+                            icon = Icons.Rounded.Schedule,
+                            title = stringResource(Res.string.settings_notifications_schedule_time),
+                            subtitle =
+                                LocalTime(
+                                    notificationTime / 60,
+                                    notificationTime % 60,
+                                ).toString(),
+                            onClick = viewModel::onUpcomingPaymentNotificationTimeSelection,
+                        )
+                        SettingsDivider()
+                        val daysAdvance by viewModel.upcomingPaymentNotificationDaysAdvance.collectAsState()
+                        SettingsRow(
+                            icon = Icons.Rounded.DateRange,
+                            title = stringResource(Res.string.settings_notifications_schedule_days),
+                            subtitle =
+                                stringResource(
+                                    Res.string.settings_notifications_schedule_days_subtitle,
+                                    daysAdvance,
+                                ),
+                            onClick = viewModel::onUpcomingPaymentNotificationDaysAdvanceSelection,
+                        )
+                    }
+                }
+            }
+        }
+
+        SettingsSectionTitle(stringResource(Res.string.settings_general_storage))
+        SettingsGroup {
+            SettingsRow(
+                icon = Icons.Rounded.Backup,
+                title = stringResource(Res.string.settings_backup_create),
+                onClick = onClickBackup,
+            )
+            SettingsDivider()
+            SettingsRow(
+                icon = Icons.Rounded.Restore,
+                title = stringResource(Res.string.settings_backup_restore),
+                onClick = onClickRestore,
+            )
+        }
+
+        SettingsSectionTitle(stringResource(Res.string.settings_general_system))
+        SettingsGroup {
+            SettingsRow(
+                icon = Icons.Rounded.Android,
+                title = stringResource(Res.string.settings_about_app),
+                onClick = onClickAbout,
+            )
+        }
+        Column(modifier = Modifier.padding(bottom = 24.dp)) {}
+    }
+
+    if (showStartScreenDialog) {
+        SettingsChoiceDialog(
+            title = stringResource(Res.string.settings_default_tab),
+            options = listOf(DefaultTab.Home, DefaultTab.Calendar, DefaultTab.Analytics),
+            selected = defaultTab,
+            onSelect = {
+                viewModel.onSelectDefaultTab(it)
+                showStartScreenDialog = false
+            },
+            onDismiss = { showStartScreenDialog = false },
+            label = { it.label() },
+        )
+    }
+
+    if (viewModel.upcomingPaymentNotificationTimePickerDialog) {
+        val timePickerState =
+            rememberTimePickerState(
+                initialHour = 8,
+                initialMinute = 0,
+            )
+        val upcomingPaymentNotificationTime by viewModel.upcomingPaymentNotificationTime.collectAsState()
+        upcomingPaymentNotificationTime.takeIf { it >= 0 }?.let { initialTime ->
+            timePickerState.hour = initialTime / 60
+            timePickerState.minute = initialTime % 60
+        }
+        TimePickerDialog(
+            onDismiss = viewModel::onDismissUpcomingPaymentNotificationTimePickerDialog,
+            onConfirm = viewModel::onConfirmUpcomingPaymentNotificationTimePickerDialog,
+            timePickerState = timePickerState,
+        )
+    }
+
+    if (viewModel.upcomingPaymentNotificationDaysAdvanceDialog) {
+        val daysAdvance by viewModel.upcomingPaymentNotificationDaysAdvance.collectAsState()
+        var days by rememberSaveable { mutableStateOf(daysAdvance.toString()) }
+        var inputError by rememberSaveable { mutableStateOf(false) }
+        AlertDialog(
+            onDismissRequest = viewModel::onDismissUpcomingPaymentNotificationDaysAdvanceDialog,
+            text = {
+                TextField(
+                    value = days,
+                    onValueChange = {
+                        if (it.matches(Regex("\\d{0,2}"))) {
+                            days = it
+                            inputError = false
+                        }
+                    },
+                    label = {
+                        Text(stringResource(Res.string.settings_notifications_schedule_days))
+                    },
+                    keyboardOptions =
+                        KeyboardOptions(
+                            keyboardType = KeyboardType.Decimal,
+                            imeAction = ImeAction.Next,
+                        ),
+                    singleLine = true,
+                    isError = inputError,
+                )
+            },
+            confirmButton = {
+                TextButton(
+                    onClick = {
+                        val daysOrNull = days.toIntOrNull()
+                        if (daysOrNull != null && daysOrNull >= 0) {
+                            viewModel.onConfirmUpcomingPaymentNotificationDaysAdvanceDialog(daysOrNull)
+                        } else {
+                            inputError = true
+                        }
+                    },
+                ) {
+                    Text(stringResource(Res.string.dialog_ok))
+                }
+            },
+        )
+    }
+}
+
+@Composable
+fun DefaultTab.label(): String =
+    when (this) {
+        DefaultTab.Home -> stringResource(Res.string.settings_start_home)
