+                    stringResource(
+                        if (CardStyle.fromInt(style) == CardStyle.Colored) {
+                            Res.string.settings_subscriptions_card_style_colored
+                        } else {
+                            Res.string.settings_subscriptions_card_style_surface
+                        },
+                    ),
+                onClick = { showStyleDialog = true },
+            )
+            SettingsDivider()
+            SettingsRow(
+                icon = Icons.Rounded.DashboardCustomize,
+                title = stringResource(Res.string.settings_subscriptions_card_details),
+                subtitle =
+                    stringResource(Res.string.settings_subscriptions_card_details_summary),
+            )
+        }
+
+        SettingsGroup {
+            SettingsSwitchRow(
+                icon = Icons.Rounded.Payments,
+                title = stringResource(Res.string.settings_subscriptions_show_price),
+                checked = showPrice,
+                onCheckedChange = viewModel::onCardShowPriceChange,
+            )
+            SettingsDivider()
+            SettingsSwitchRow(
+                icon = Icons.Rounded.Schedule,
+                title = stringResource(Res.string.settings_subscriptions_show_next_payment),
+                checked = showNextPayment,
+                onCheckedChange = viewModel::onCardShowNextPaymentChange,
+            )
+            SettingsDivider()
+            SettingsSwitchRow(
+                icon = Icons.Rounded.Description,
+                title = stringResource(Res.string.settings_subscriptions_show_description),
+                checked = showDescription,
+                onCheckedChange = viewModel::onCardShowDescriptionChange,
+            )
+            SettingsDivider()
+            SettingsSwitchRow(
+                icon = Icons.Rounded.Tag,
+                title = stringResource(Res.string.settings_subscriptions_show_tag_dots),
+                checked = showTagDots,
+                onCheckedChange = viewModel::onCardShowTagDotsChange,
+            )
+        }
+        Column(modifier = Modifier.padding(bottom = 24.dp)) {}
+    }
+
+    if (showSizeDialog) {
+        SettingsChoiceDialog(
+            title = stringResource(Res.string.settings_subscriptions_card_size),
+            options = listOf(true, false),
+            selected = compact,
+            onSelect = {
+                viewModel.onCardCompactChange(it)
+                showSizeDialog = false
+            },
+            onDismiss = { showSizeDialog = false },
+            label = {
+                stringResource(
+                    if (it) {
+                        Res.string.settings_subscriptions_card_size_compact
+                    } else {
+                        Res.string.settings_subscriptions_card_size_comfortable
+                    },
+                )
+            },
+        )
+    }
+
+    if (showStyleDialog) {
+        SettingsChoiceDialog(
+            title = stringResource(Res.string.settings_subscriptions_card_style),
+            options = CardStyle.entries,
+            selected = CardStyle.fromInt(style),
+            onSelect = {
+                viewModel.onCardStyleSelected(it.value)
+                showStyleDialog = false
+            },
+            onDismiss = { showStyleDialog = false },
+            label = {
+                stringResource(
+                    if (it == CardStyle.Colored) {
+                        Res.string.settings_subscriptions_card_style_colored
+                    } else {
+                        Res.string.settings_subscriptions_card_style_surface
+                    },
+                )
+            },
+        )
+    }
+}
