+@Composable
+private fun TopExpenses(
+    activeExpenses: List<RecurringExpenseData>,
+    total: Float,
+    currencyCode: String,
+) {
+    val top = remember(activeExpenses) { activeExpenses.sortedByDescending { it.monthlyPrice.value }.take(5) }
+    Surface(
+        shape = RoundedCornerShape(26.dp),
+        color = MaterialTheme.colorScheme.surfaceContainerHigh,
+        modifier = Modifier.fillMaxWidth(),
+    ) {
+        Column(modifier = Modifier.padding(20.dp)) {
+            Text(
+                text = stringResource(Res.string.analytics_top),
+                style = MaterialTheme.typography.titleMedium,
+                fontWeight = FontWeight.SemiBold,
+            )
+            Spacer(modifier = Modifier.height(8.dp))
+            top.forEach { expense ->
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(vertical = 7.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Text(
+                        text = expense.name,
+                        style = MaterialTheme.typography.bodyLarge,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                        modifier = Modifier.weight(1f),
+                    )
+                    val share = if (total <= 0f) 0f else expense.monthlyPrice.value / total
+                    Text(
+                        text = formatMoney(expense.monthlyPrice.value, currencyCode),
+                        style = MaterialTheme.typography.bodyMedium,
+                        fontWeight = FontWeight.Medium,
+                    )
+                    Text(
+                        text = "  ${(share * 100).toInt()}%",
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                }
+            }
+        }
+    }
+}
+
+private fun buildSlices(
+    activeExpenses: List<RecurringExpenseData>,
+    primary: Color,
+): List<TagSlice> {
+    val map = linkedMapOf<String, TagSlice>()
+    activeExpenses.forEach { expense ->
+        val amount = expense.monthlyPrice.value
+        if (amount <= 0f) return@forEach
+        if (expense.tags.isEmpty()) {
+            val existing = map["untagged"]
+            map["untagged"] =
+                existing?.copy(amount = existing.amount + amount)
+                    ?: TagSlice(null, amount, primary)
+        } else {
+            val split = amount / expense.tags.size
+            expense.tags.forEach { tag ->
+                val key = tag.id.toString()
+                val existing = map[key]
+                map[key] =
+                    existing?.copy(amount = existing.amount + split)
+                        ?: TagSlice(tag, split, Color(tag.color))
+            }
+        }
+    }
+    return map.values.toList()
+}
+
+private fun formatMoney(
+    value: Float,
+    currencyCode: String,
+): String = value.toCurrencyString(currencyCode)
