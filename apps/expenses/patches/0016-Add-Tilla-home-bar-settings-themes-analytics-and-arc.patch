+package de.dbauer.expensetracker.shared.ui.home
+
+/** Sort orders available in the Tilla-style sort sheet. */
+enum class HomeSortMode(val value: Int) {
+    Alphabetical(0),
+    NextPayment(1),
+    MostExpensive(2),
+    Cheapest(3),
+    RecentlyAdded(4),
+    ;
+
+    companion object {
+        fun fromInt(value: Int): HomeSortMode = entries.firstOrNull { it.value == value } ?: Alphabetical
+    }
+}
+
+/** Subscription filters shown in the middle of the home top bar. */
+enum class HomeFilter(val value: Int) {
+    All(0),
+    Active(1),
+    Suspended(2),
+    ;
+
+    companion object {
+        fun fromInt(value: Int): HomeFilter = entries.firstOrNull { it.value == value } ?: All
+    }
+}
