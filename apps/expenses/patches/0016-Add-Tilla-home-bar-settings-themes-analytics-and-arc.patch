+package de.dbauer.expensetracker.shared.ui.home
+
+/** Visual layout of a subscription card, as configured in Settings → Subscriptions. */
+data class CardLayoutPrefs(
+    val compact: Boolean = false,
+    val showDescription: Boolean = true,
+    val showNextPayment: Boolean = true,
+    val showTagDots: Boolean = true,
+    val showPrice: Boolean = true,
+    val colored: Boolean = true,
+)
+
+enum class CardStyle(val value: Int) {
+    Colored(0),
+    Surface(1),
+    ;
+
+    companion object {
+        fun fromInt(value: Int): CardStyle = entries.firstOrNull { it.value == value } ?: Colored
+    }
+}
