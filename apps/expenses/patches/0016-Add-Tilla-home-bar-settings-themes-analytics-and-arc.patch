+@Composable
+fun AnalyticsScreen(
+    modifier: Modifier = Modifier,
+    viewModel: AnalyticsViewModel = koinViewModel(),
+    userPreferencesRepository: IUserPreferencesRepository = koinInject(),
+) {
+    val expenses by viewModel.expenses.collectAsState()
+    val preferredCurrency by userPreferencesRepository.defaultCurrency.collectAsState()
+    val currencyCode = preferredCurrency.ifBlank { getSystemCurrencyCode() }
+    val preferredPeriod by userPreferencesRepository.averageExpensesPeriod.collectAsState()
+    var period by rememberSaveable { mutableIntStateOf(preferredPeriod) }
+
+    val activeExpenses = remember(expenses) { expenses.filterNot { it.suspended } }
+    val pausedCount = expenses.count { it.suspended }
+    val totalMonthly =
+        remember(activeExpenses) { activeExpenses.sumOf { it.monthlyPrice.value.toDouble() }.toFloat() }
+    val total =
+        when (period) {
+            0 -> totalMonthly * 12f / 52f
+            2 -> totalMonthly * 12f
+            else -> totalMonthly
+        }
+
+    if (expenses.isEmpty()) {
+        Box(modifier = modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+            Column(horizontalAlignment = Alignment.CenterHorizontally) {
+                Icon(
+                    imageVector = Icons.Rounded.Insights,
+                    contentDescription = null,
+                    tint = MaterialTheme.colorScheme.primary,
+                    modifier = Modifier.size(56.dp),
+                )
+                Spacer(modifier = Modifier.height(16.dp))
+                Text(
+                    text = stringResource(Res.string.analytics_empty),
+                    style = MaterialTheme.typography.titleMedium,
+                    textAlign = TextAlign.Center,
+                )
+            }
+        }
+        return
+    }
+
+    LazyColumn(
+        modifier = modifier.fillMaxSize(),
+        contentPadding = PaddingValues(16.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        item {
+            TotalCard(
+                total = total,
+                period = period,
+                activeCount = activeExpenses.size,
+                pausedCount = pausedCount,
+                average = if (activeExpenses.isEmpty()) 0f else totalMonthly / activeExpenses.size,
+                onPeriodChange = { period = it },
+                currencyCode = currencyCode,
+            )
+        }
+        item {
+            TagBreakdown(activeExpenses, totalMonthly, currencyCode)
+        }
+        item {
+            TopExpenses(activeExpenses, totalMonthly, currencyCode)
+        }
+    }
+}
