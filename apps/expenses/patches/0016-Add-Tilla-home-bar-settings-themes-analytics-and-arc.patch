+@Composable
+fun SettingsHubScreen(
+    onGeneralClick: () -> Unit,
+    onAppearanceClick: () -> Unit,
+    onSubscriptionsClick: () -> Unit,
+    onMoneyClick: () -> Unit,
+    appVersion: String,
+    modifier: Modifier = Modifier,
+) {
+    Column(
+        modifier =
+            modifier
+                .fillMaxSize()
+                .verticalScroll(rememberScrollState())
+                .padding(horizontal = 16.dp),
+        verticalArrangement = Arrangement.spacedBy(10.dp),
+    ) {
+        SettingsHubCard(
+            icon = Icons.Rounded.Settings,
+            title = stringResource(Res.string.settings_hub_general_title),
+            summary = stringResource(Res.string.settings_hub_general_summary),
+            onClick = onGeneralClick,
+        )
+        SettingsHubCard(
+            icon = Icons.Rounded.Palette,
+            title = stringResource(Res.string.settings_hub_appearance_title),
+            summary = stringResource(Res.string.settings_hub_appearance_summary),
+            onClick = onAppearanceClick,
+        )
+        SettingsHubCard(
+            icon = Icons.Rounded.Subscriptions,
+            title = stringResource(Res.string.settings_hub_subscriptions_title),
+            summary = stringResource(Res.string.settings_hub_subscriptions_summary),
+            onClick = onSubscriptionsClick,
+        )
+        SettingsHubCard(
+            icon = Icons.Rounded.AttachMoney,
+            title = stringResource(Res.string.settings_hub_money_title),
+            summary = stringResource(Res.string.settings_hub_money_summary),
+            onClick = onMoneyClick,
+        )
+        Text(
+            text = stringResource(Res.string.settings_hub_version, appVersion),
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(top = 16.dp, bottom = 24.dp),
+        )
+    }
+}
