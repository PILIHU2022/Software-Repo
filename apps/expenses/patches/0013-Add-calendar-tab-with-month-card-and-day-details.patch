+
+/** Tilla changes the month when the horizontal drag passes ~100 px; it does not follow the finger. */
+private const val SWIPE_THRESHOLD_PX = 100f
+
+private val narrowWeekdayLabels: List<StringResource> =
+    listOf(
+        Res.string.calendar_weekday_mon_narrow,
+        Res.string.calendar_weekday_tue_narrow,
+        Res.string.calendar_weekday_wed_narrow,
+        Res.string.calendar_weekday_thu_narrow,
+        Res.string.calendar_weekday_fri_narrow,
+        Res.string.calendar_weekday_sat_narrow,
+        Res.string.calendar_weekday_sun_narrow,
+    )
+
+private val fullWeekdayLabels: List<StringResource> =
+    listOf(
+        Res.string.calendar_weekday_mon_full,
+        Res.string.calendar_weekday_tue_full,
+        Res.string.calendar_weekday_wed_full,
+        Res.string.calendar_weekday_thu_full,
+        Res.string.calendar_weekday_fri_full,
+        Res.string.calendar_weekday_sat_full,
+        Res.string.calendar_weekday_sun_full,
+    )
+
+/**
+ * Tilla-style calendar tab: a month card, the selected day's long date and that day's expenses.
+ * The screen has no Scaffold of its own; [de.dbauer.expensetracker.shared.ui.MainContent] owns the
+ * Scaffold, top bar, bottom bar and content padding.
+ */
+@Composable
+fun CalendarScreen(
+    navController: NavController,
+    modifier: Modifier = Modifier,
+    calendarViewModel: CalendarViewModel = koinViewModel<CalendarViewModel>(),
+) {
+    val languageTag = Locale.current.toLanguageTag()
+    val localeFirstDayOfWeekIso = remember(languageTag) { firstDayOfWeekIso(languageTag) }
+    LaunchedEffect(localeFirstDayOfWeekIso) {
+        calendarViewModel.onFirstDayOfWeekChanged(localeFirstDayOfWeekIso)
+    }
+
+    val currentMonth = calendarViewModel.currentMonth
+    val selectedDate = calendarViewModel.selectedDate
+    val monthLabel = remember(currentMonth) { currentMonth.toMonthYearStringUTC() }
+    val selectedItems = calendarViewModel.itemsByDay[selectedDate].orEmpty()
+    val onExpenseClick: (Int) -> Unit =
+        remember(navController) {
+            { expenseId -> navController.navigate(EditExpensePane(expenseId)) }
+        }
+
+    Column(
+        modifier =
+            modifier
+                .fillMaxSize()
+                .verticalScroll(rememberScrollState())
+                .padding(horizontal = 16.dp, vertical = 8.dp),
+    ) {
+        MonthCard(
+            monthLabel = monthLabel,
+            days = calendarViewModel.days,
+            firstDayOfWeekIso = localeFirstDayOfWeekIso,
+            onPreviousMonth = calendarViewModel::onPreviousMonth,
+            onNextMonth = calendarViewModel::onNextMonth,
+            onDayClick = calendarViewModel::onDaySelected,
+        )
+        Spacer(modifier = Modifier.height(16.dp))
+        DayDetailHeader(selectedDate = selectedDate)
+        Spacer(modifier = Modifier.height(8.dp))
+        if (selectedItems.isEmpty()) {
+            EmptyDayState()
+        } else {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                selectedItems.forEach { occurrence ->
+                    CalendarExpenseCard(
+                        occurrence = occurrence,
+                        onClick = onExpenseClick,
+                    )
+                }
+            }
+        }
+        Spacer(modifier = Modifier.height(24.dp))
+    }
+}
+
+@Composable
+private fun MonthCard(
+    monthLabel: String,
+    days: List<CalendarDayCell>,
+    firstDayOfWeekIso: Int,
+    onPreviousMonth: () -> Unit,
+    onNextMonth: () -> Unit,
+    onDayClick: (LocalDate) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val currentOnPreviousMonth by rememberUpdatedState(onPreviousMonth)
+    val currentOnNextMonth by rememberUpdatedState(onNextMonth)
+    val previousMonthDescription = stringResource(Res.string.calendar_previous_month)
+    val nextMonthDescription = stringResource(Res.string.calendar_next_month)
+
+    Surface(
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .pointerInput(Unit) {
+                    var dragDistance = 0f
+                    detectHorizontalDragGestures(
+                        onDragStart = { dragDistance = 0f },
+                        onHorizontalDrag = { change, dragAmount ->
+                            change.consume()
+                            dragDistance += dragAmount
+                        },
+                        onDragEnd = {
+                            when {
+                                dragDistance > SWIPE_THRESHOLD_PX -> currentOnPreviousMonth()
+                                dragDistance < -SWIPE_THRESHOLD_PX -> currentOnNextMonth()
+                            }
+                            dragDistance = 0f
+                        },
+                        onDragCancel = { dragDistance = 0f },
+                    )
+                },
+        shape = TillaCardShape,
+        color = MaterialTheme.colorScheme.surfaceContainerHigh,
+    ) {
+        Column(modifier = Modifier.padding(16.dp)) {
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                Text(
+                    text = monthLabel,
+                    modifier = Modifier.weight(1f),
+                    fontSize = 18.sp,
+                    fontWeight = FontWeight.Medium,
+                )
+                MonthArrowButton(
+                    icon = Icons.AutoMirrored.Rounded.KeyboardArrowLeft,
+                    contentDescription = previousMonthDescription,
+                    onClick = onPreviousMonth,
+                )
+                Spacer(modifier = Modifier.size(16.dp))
+                MonthArrowButton(
+                    icon = Icons.AutoMirrored.Rounded.KeyboardArrowRight,
+                    contentDescription = nextMonthDescription,
+                    onClick = onNextMonth,
+                )
+            }
+            Spacer(modifier = Modifier.height(16.dp))
+            WeekdayHeader(firstDayOfWeekIso = firstDayOfWeekIso)
+            Spacer(modifier = Modifier.height(8.dp))
+            DayGrid(days = days, onDayClick = onDayClick)
+        }
+    }
+}
+
+@Composable
+private fun MonthArrowButton(
+    icon: ImageVector,
+    contentDescription: String,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Box(
+        modifier =
+            modifier
+                .size(32.dp)
+                .clip(CircleShape)
+                .background(MaterialTheme.colorScheme.primaryContainer)
+                .clickable(role = Role.Button, onClick = onClick),
+        contentAlignment = Alignment.Center,
+    ) {
+        Icon(
+            imageVector = icon,
+            contentDescription = contentDescription,
+            tint = MaterialTheme.colorScheme.onPrimaryContainer,
+            modifier = Modifier.size(20.dp),
+        )
+    }
+}
+
+@Composable
+private fun WeekdayHeader(
+    firstDayOfWeekIso: Int,
+    modifier: Modifier = Modifier,
+) {
+    val indices = remember(firstDayOfWeekIso) { weekdayIndices(firstDayOfWeekIso) }
+    Row(modifier = modifier.fillMaxWidth()) {
+        indices.forEach { weekdayIndex ->
+            val label = stringResource(narrowWeekdayLabels[weekdayIndex])
+            val fullLabel = stringResource(fullWeekdayLabels[weekdayIndex])
+            Text(
+                text = label,
+                modifier =
+                    Modifier
+                        .weight(1f)
+                        .semantics { contentDescription = fullLabel },
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                fontSize = 12.sp,
+                fontWeight = FontWeight.Medium,
+                textAlign = TextAlign.Center,
+            )
+        }
+    }
+}
+
+@Composable
+private fun DayGrid(
+    days: List<CalendarDayCell>,
+    onDayClick: (LocalDate) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier = modifier.fillMaxWidth()) {
+        days.chunked(7).forEach { week ->
+            Row(modifier = Modifier.fillMaxWidth()) {
+                week.forEach { day ->
+                    DayCell(
+                        day = day,
+                        onClick = onDayClick,
+                        modifier = Modifier.weight(1f),
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun DayCell(
+    day: CalendarDayCell,
+    onClick: (LocalDate) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val colorScheme = MaterialTheme.colorScheme
+    val background =
+        when {
+            day.isSelected -> colorScheme.primary
+            day.isToday -> colorScheme.primaryContainer
+            day.isCurrentMonth -> colorScheme.surfaceVariant.copy(alpha = 0.25f)
+            else -> Color.Transparent
+        }
+    val contentColor =
+        when {
+            day.isSelected -> colorScheme.onPrimary
+            day.isToday -> colorScheme.onPrimaryContainer
+            day.isCurrentMonth -> colorScheme.onSurface
+            else -> colorScheme.onSurface.copy(alpha = 0.4f)
+        }
+    val firstItem = day.firstItem
+    val cardStyle =
+        remember(firstItem?.serviceId, firstItem?.name) {
+            firstItem?.let { buildCardStyle(it.serviceId, it.name) }
+        }
+    val dateDescription = remember(day.date) { day.date.toLongDateString() }
+    val itemsDescription =
+        if (day.itemCount == 0) {
+            null
+        } else {
+            pluralStringResource(Res.plurals.calendar_day_items, day.itemCount, day.itemCount)
+        }
+    val contentDescription =
+        if (itemsDescription == null) dateDescription else "$dateDescription, $itemsDescription"
+    val badgeColor = if (day.isSelected) colorScheme.onPrimary else colorScheme.primary
+    val badgeContentColor = if (day.isSelected) colorScheme.primary else colorScheme.onPrimary
+    val handleClick = remember(day.date, onClick) { { onClick(day.date) } }
+
+    Box(
+        modifier =
+            modifier
+                .aspectRatio(1f)
+                .padding(4.dp)
+                .clip(RoundedCornerShape(12.dp))
+                .background(background)
+                .clickable(role = Role.Button, onClick = handleClick)
+                .semantics {
+                    this.contentDescription = contentDescription
+                    selected = day.isSelected
+                },
+        contentAlignment = Alignment.Center,
+    ) {
+        Column(horizontalAlignment = Alignment.CenterHorizontally) {
+            Text(
+                text = day.dayOfMonth.toString(),
+                color = contentColor,
+                fontSize = 10.sp,
+                lineHeight = 12.sp,
+                fontWeight = if (day.isToday || day.isSelected) FontWeight.Bold else FontWeight.Normal,
+            )
+            if (cardStyle != null) {
+                ExpenseServiceIconView(
+                    service = cardStyle.service,
+                    tint = if (day.isSelected) contentColor else cardStyle.background,
+                    modifier =
+                        Modifier
+                            .padding(top = 1.dp)
+                            .size(18.dp),
+                    overrideServiceTint = day.isSelected,
+                )
+            }
+        }
+        if (day.itemCount > 1) {
+            Box(
+                modifier =
+                    Modifier
+                        .align(Alignment.TopEnd)
+                        .size(12.dp)
+                        .clip(CircleShape)
+                        .background(badgeColor),
+                contentAlignment = Alignment.Center,
+            ) {
+                Text(
+                    text = "+${day.itemCount}",
+                    color = badgeContentColor,
+                    fontSize = 8.sp,
+                    lineHeight = 8.sp,
+                    fontWeight = FontWeight.Medium,
+                    maxLines = 1,
+                )
+            }
+        }
+        if (day.allItemsPaid) {
+            Icon(
+                imageVector = Icons.Rounded.CheckCircle,
+                contentDescription = null,
+                tint = contentColor,
+                modifier =
+                    Modifier
+                        .align(Alignment.BottomEnd)
+                        .size(10.dp),
+            )
+        }
+    }
+}
+
+@Composable
+private fun DayDetailHeader(
+    selectedDate: LocalDate,
+    modifier: Modifier = Modifier,
+) {
+    val longDate = remember(selectedDate) { selectedDate.toLongDateString() }
+    Text(
+        text = longDate,
+        modifier = modifier.fillMaxWidth(),
+        fontSize = 22.sp,
+        fontWeight = FontWeight.Bold,
+    )
+}
+
+@Composable
+private fun CalendarExpenseCard(
+    occurrence: CalendarOccurrence,
+    onClick: (Int) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val cardStyle =
+        remember(occurrence.serviceId, occurrence.name) {
+            buildCardStyle(occurrence.serviceId, occurrence.name)
+        }
+    val priceText = remember(occurrence.price) { occurrence.price.toCurrencyString() }
+    val recurrenceLabel = stringResource(occurrence.recurrence.fullStringRes)
+    val subtitle =
+        remember(recurrenceLabel, occurrence.everyXRecurrence) {
+            if (occurrence.everyXRecurrence > 1) {
+                "$recurrenceLabel ×${occurrence.everyXRecurrence}"
+            } else {
+                recurrenceLabel
+            }
+        }
+    val statusLabel =
+        if (occurrence.requiresConfirmation) {
+            stringResource(if (occurrence.isPaid) Res.string.calendar_paid else Res.string.calendar_unpaid)
+        } else {
+            null
+        }
+    val statusIcon =
+        if (occurrence.requiresConfirmation) {
+            if (occurrence.isPaid) Icons.Rounded.CheckCircle else Icons.Rounded.CheckCircleOutline
+        } else {
+            null
+        }
+    val handleClick = remember(occurrence.expenseId, onClick) { { onClick(occurrence.expenseId) } }
+
+    Surface(
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .clip(TillaCardShape)
+                .clickable(role = Role.Button, onClick = handleClick),
+        shape = TillaCardShape,
+        color = cardStyle.background,
+        contentColor = cardStyle.foreground,
+    ) {
+        Row(
+            modifier =
+                Modifier
+                    .fillMaxWidth()
+                    .padding(horizontal = 18.dp, vertical = 14.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            ExpenseServiceIconView(
+                service = cardStyle.service,
+                tint = cardStyle.iconTint,
+                modifier = Modifier.size(32.dp),
+            )
+            Spacer(modifier = Modifier.size(14.dp))
+            Column(modifier = Modifier.weight(1f)) {
+                Text(
+                    text = occurrence.name,
+                    fontSize = 16.sp,
+                    fontWeight = FontWeight.SemiBold,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+                Row(
+                    modifier = Modifier.padding(top = 2.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Text(
+                        text = subtitle.uppercase(),
+                        color = cardStyle.labelColor,
+                        fontSize = 10.sp,
+                        fontWeight = FontWeight.Medium,
+                        letterSpacing = 0.4.sp,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                    )
+                    if (statusLabel != null && statusIcon != null) {
+                        Text(
+                            text = " · ",
+                            color = cardStyle.labelColor,
+                            fontSize = 10.sp,
+                            fontWeight = FontWeight.Medium,
+                        )
+                        Icon(
+                            imageVector = statusIcon,
+                            contentDescription = null,
+                            tint = cardStyle.labelColor,
+                            modifier = Modifier.size(10.dp),
+                        )
+                        Spacer(modifier = Modifier.size(3.dp))
+                        Text(
+                            text = statusLabel.uppercase(),
+                            color = cardStyle.labelColor,
+                            fontSize = 10.sp,
+                            fontWeight = FontWeight.Medium,
+                            letterSpacing = 0.4.sp,
+                            maxLines = 1,
+                        )
+                    }
+                }
+            }
+            Spacer(modifier = Modifier.size(8.dp))
+            Text(
+                text = priceText,
+                fontSize = 17.sp,
+                fontWeight = FontWeight.Bold,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+}
+
+@Composable
+private fun EmptyDayState(modifier: Modifier = Modifier) {
+    Column(
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .padding(vertical = 32.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Icon(
+            imageVector = Icons.Rounded.EventBusy,
+            contentDescription = null,
+            tint = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.size(48.dp),
+        )
+        Spacer(modifier = Modifier.height(12.dp))
+        Text(
+            text = stringResource(Res.string.calendar_empty_title),
+            fontWeight = FontWeight.SemiBold,
+            style = MaterialTheme.typography.titleMedium,
+            textAlign = TextAlign.Center,
+        )
+        Spacer(modifier = Modifier.height(4.dp))
+        Text(
+            text = stringResource(Res.string.calendar_empty_description),
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            textAlign = TextAlign.Center,
+            modifier = Modifier.padding(horizontal = 16.dp),
+        )
+    }
+}
