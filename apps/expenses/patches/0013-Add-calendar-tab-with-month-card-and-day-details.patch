@@ -167,14 +168,17 @@ class MainActivity : AppCompatActivity() {
                 }
 
         // Never block the first frame on DataStore. Home is the start destination, and if the
-        // stored default tab is Upcoming we navigate there once the preference is known. An
+        // stored default tab is Upcoming or Calendar we navigate there once the preference is known. An
         // explicit intent route (notification, deep link) always wins and skips this lookup.
         val deferredStartRoute = mutableStateOf<MainNavRoute?>(null)
         if (startRouteFromIntent == null && savedInstanceState == null) {
             lifecycleScope.launch {
-                if (userPreferencesRepository.defaultTab.get().first() == DefaultTab.Upcoming.value) {
-                    deferredStartRoute.value = UpcomingPane
-                }
+                deferredStartRoute.value =
+                    when (userPreferencesRepository.defaultTab.get().first()) {
+                        DefaultTab.Upcoming.value -> UpcomingPane
+                        DefaultTab.Calendar.value -> CalendarPane
+                        else -> null
+                    }
             }
         }
 
