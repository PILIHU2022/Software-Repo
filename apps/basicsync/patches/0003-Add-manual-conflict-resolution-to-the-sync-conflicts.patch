+/** Result of a conflict resolution operation. */
+sealed interface ConflictResult {
+    /** The conflict was resolved. */
+    data object Success : ConflictResult
+
+    /**
+     * The conflict could not be resolved.
+     *
+     * @property message human-readable description suitable for showing in the UI
+     */
+    data class Failure(val message: String) : ConflictResult
+}
+
+/**
+ * Resolves sync conflicts by either discarding the conflict copy or by replacing the original file
+ * with the conflict version.
+ *
+ * These operations do blocking file and ContentResolver I/O, so they must be called from a
+ * background thread (e.g. inside `withContext(Dispatchers.IO)`). They never throw: all failures are
+ * reported as [ConflictResult.Failure] with a readable message.
+ */
+class ConflictResolver(private val context: Context) {
+    companion object {
+        private val TAG = ConflictResolver::class.java.simpleName
+
+        private const val COPY_BUFFER_SIZE = 64 * 1024
+
+        /**
+         * The conflict segment that Syncthing inserts before the file extension:
+         * `.sync-conflict-YYYYMMDD-HHMMSS-XXXXXXX`.
+         */
+        private val CONFLICT_SEGMENT = Regex("""\.sync-conflict-(\d{8})-(\d{6})-([A-Za-z0-9]+)""")
+
+        private val CONFLICT_TIMESTAMP_FORMAT = DateTimeFormatter.ofPattern("yyyyMMdd-HHmmss")
+
+        /** Returns whether [name] contains a sync conflict segment. */
+        fun isConflictFileName(name: String): Boolean = CONFLICT_SEGMENT.containsMatchIn(name)
+
+        /**
+         * Returns [name] with the conflict segment removed.
+         *
+         * @return the original file name, or null if [name] is not a conflict file name or if
+         * nothing would be left after removing the conflict segment
+         */
+        fun stripConflictSegment(name: String): String? {
+            val match = CONFLICT_SEGMENT.find(name) ?: return null
+            val originalName = name.removeRange(match.range)
+
+            return originalName.ifEmpty { null }
+        }
+
+        /**
+         * Parses the conflict creation time encoded in [name].
+         *
+         * Syncthing writes the timestamp in the local time of the device that detected the
+         * conflict, so it is interpreted in the current time zone.
+         *
+         * @return milliseconds since the epoch, or null if [name] is not a conflict file name or
+         * the timestamp is invalid
+         */
+        fun parseConflictTimestamp(name: String): Long? {
+            val match = CONFLICT_SEGMENT.find(name) ?: return null
+            val date = match.groupValues[1]
+            val time = match.groupValues[2]
+
+            return try {
+                LocalDateTime.parse("$date-$time", CONFLICT_TIMESTAMP_FORMAT)
+                    .atZone(ZoneId.systemDefault())
+                    .toInstant()
+                    .toEpochMilli()
+            } catch (_: DateTimeException) {
+                null
+            }
+        }
+
+        /**
+         * Best-effort conversion of a SAF document ID into a file name.
+         *
+         * DocumentsUI uses `<volume>:<relative path>` document IDs, but other providers are free to
+         * use opaque IDs. For those, the file name has to be queried from the provider and null is
+         * returned here.
+         */
+        fun nameFromDocumentId(documentId: String): String? {
+            val separator = documentId.indexOf(':')
+            if (separator < 0) {
+                return null
+            }
+
+            return documentId.substring(separator + 1)
+                .substringAfterLast('/')
+                .ifEmpty { null }
+        }
+    }
+
+    /**
+     * Deletes the conflict copy and leaves the original file untouched.
+     *
+     * If the conflict copy is already gone, this is treated as success.
+     */
+    @WorkerThread
+    fun discardConflict(item: SyncthingService.ConflictItem): ConflictResult =
+        try {
+            when {
+                item.conflictFile != null -> discardLocal(File(item.conflictFile))
+                item.conflictUri != null -> discardSaf(item)
+                else -> failure(R.string.conflict_error_unknown)
+            }
+        } catch (e: Exception) {
+            failure(e)
+        }
+
+    /**
+     * Replaces the original file with the conflict copy and then deletes the conflict copy.
+     *
+     * If the original file no longer exists, the conflict copy is restored under the original name
+     * instead.
+     */
+    @WorkerThread
+    fun overwriteOriginal(item: SyncthingService.ConflictItem): ConflictResult =
+        try {
+            when {
+                item.conflictFile != null -> overwriteLocal(item, File(item.conflictFile))
+                item.conflictUri != null -> overwriteSaf(item)
+                else -> failure(R.string.conflict_error_unknown)
+            }
+        } catch (e: Exception) {
+            failure(e)
+        }
+
+    private fun discardLocal(conflict: File): ConflictResult {
+        if (!isConflictFileName(conflict.name)) {
+            return failure(R.string.conflict_error_not_conflict, conflict.name)
+        }
+        if (conflict.isDirectory) {
+            return failure(R.string.conflict_error_directory, conflict.name)
+        }
+        if (!conflict.exists()) {
+            // The conflict was already resolved, e.g. by Syncthing itself or by another app.
+            return ConflictResult.Success
+        }
+        if (!conflict.delete()) {
+            return failure(R.string.conflict_error_delete_failed, conflict.name)
+        }
+
+        return ConflictResult.Success
+    }
+
+    private fun discardSaf(item: SyncthingService.ConflictItem): ConflictResult {
+        val parentUri = item.parentTreeUri ?: return failure(R.string.conflict_error_unknown)
+        val conflictUri = item.conflictUri ?: return failure(R.string.conflict_error_unknown)
+        val conflictDocumentId = SyncthingSafClient.getNarrowestDocumentId(conflictUri)
+
+        val children = queryChildren(parentUri)
+        val conflict = children.find { it.documentId == conflictDocumentId }
+            ?: return failure(R.string.conflict_error_not_found, item.fileName)
+
+        if (!isConflictFileName(conflict.displayName)) {
+            return failure(R.string.conflict_error_not_conflict, conflict.displayName)
+        }
+        if (conflict.isDirectory) {
+            return failure(R.string.conflict_error_directory, conflict.displayName)
+        }
+
+        val documentUri = DocumentsContract.buildDocumentUriUsingTree(
+            parentUri,
+            conflict.documentId,
+        )
+        if (!DocumentsContract.deleteDocument(context.contentResolver, documentUri)) {
+            return failure(R.string.conflict_error_delete_failed, conflict.displayName)
+        }
+
+        return ConflictResult.Success
+    }
+
+    private fun overwriteLocal(
+        item: SyncthingService.ConflictItem,
+        conflict: File,
+    ): ConflictResult {
+        if (conflict.isDirectory) {
+            return failure(R.string.conflict_error_directory, conflict.name)
+        }
+        if (!isConflictFileName(conflict.name)) {
+            return failure(R.string.conflict_error_not_conflict, conflict.name)
+        }
+        if (!conflict.exists()) {
+            return failure(R.string.conflict_error_missing, conflict.name)
+        }
+
+        val parentDir = conflict.parentFile
+        if (parentDir == null) {
+            return failure(R.string.conflict_error_invalid, conflict.name)
+        }
+
+        val originalName = stripConflictSegment(conflict.name)
+            ?: return failure(R.string.conflict_error_not_conflict, conflict.name)
+        if (originalName.contains('/')) {
+            return failure(R.string.conflict_error_invalid, conflict.name)
+        }
+
+        val original = item.originalFile?.let(::File) ?: File(parentDir, originalName)
+
+        if (!original.exists()) {
+            // The original is gone, so just restore the conflict copy under its original name.
+            return if (conflict.renameTo(original)) {
+                scanFile(original)
+                ConflictResult.Success
+            } else {
+                failure(R.string.conflict_error_restore_failed, conflict.name)
+            }
+        }
+        if (original.isDirectory) {
+            return failure(R.string.conflict_error_directory, original.name)
+        }
+
+        // Write to a temporary file next to the original first so that a failed copy does not
+        // destroy the original file.
+        val temp = try {
+            File.createTempFile(".basicsync-", ".tmp", parentDir)
+        } catch (e: IOException) {
+            return failure(e)
+        }
+
+        try {
+            FileInputStream(conflict).use { input ->
+                FileOutputStream(temp).use { output ->
+                    input.copyTo(output, COPY_BUFFER_SIZE)
+                    output.flush()
+                    output.fd.sync()
+                }
+            }
+
+            if (!temp.renameTo(original)) {
+                return failure(R.string.conflict_error_replace_failed, original.name)
+            }
+        } finally {
+            if (temp.exists()) {
+                temp.delete()
+            }
+        }
+
+        if (!conflict.delete()) {
+            return failure(R.string.conflict_error_remove_after_copy, original.name)
+        }
+
+        scanFile(original)
+        return ConflictResult.Success
+    }
+
+    private fun overwriteSaf(item: SyncthingService.ConflictItem): ConflictResult {
+        val parentUri = item.parentTreeUri ?: return failure(R.string.conflict_error_unknown)
+        val conflictUri = item.conflictUri ?: return failure(R.string.conflict_error_unknown)
+        val conflictDocumentId = SyncthingSafClient.getNarrowestDocumentId(conflictUri)
+
+        val children = queryChildren(parentUri)
+        val conflict = children.find { it.documentId == conflictDocumentId }
+            ?: return failure(R.string.conflict_error_not_found, item.fileName)
+
+        if (conflict.isDirectory) {
+            return failure(R.string.conflict_error_directory, conflict.displayName)
+        }
+
+        val originalName = stripConflictSegment(conflict.displayName)
+            ?: item.originalName
+            ?: return failure(R.string.conflict_error_not_conflict, conflict.displayName)
+        if (originalName.contains('/')) {
+            return failure(R.string.conflict_error_invalid, conflict.displayName)
+        }
+
+        val conflictDocumentUri = DocumentsContract.buildDocumentUriUsingTree(
+            parentUri,
+            conflict.documentId,
+        )
+        val original = children.find { it.displayName == originalName && !it.isDirectory }
+
+        if (original == null) {
+            // The original is gone, so just rename the conflict copy back to the original name.
+            if (DocumentsContract.renameDocument(
+                    context.contentResolver,
+                    conflictDocumentUri,
+                    originalName,
+                ) == null
+            ) {
+                return failure(R.string.conflict_error_restore_failed, conflict.displayName)
+            }
+
+            return ConflictResult.Success
+        }
+
+        val originalUri = DocumentsContract.buildDocumentUriUsingTree(
+            parentUri,
+            original.documentId,
+        )
+
+        copyDocument(conflictDocumentUri, originalUri)
+
+        if (!DocumentsContract.deleteDocument(context.contentResolver, conflictDocumentUri)) {
+            return failure(R.string.conflict_error_remove_after_copy, originalName)
+        }
+
+        return ConflictResult.Success
+    }
+
+    private fun copyDocument(source: Uri, destination: Uri) {
+        val input = context.contentResolver.openInputStream(source)
+            ?: throw IOException("Failed to open for reading: $source")
+
+        input.use {
+            val output = context.contentResolver.openOutputStream(destination, "wt")
+                ?: throw IOException("Failed to open for writing: $destination")
+
+            output.use {
+                input.copyTo(output, COPY_BUFFER_SIZE)
+            }
+        }
+    }
+
+    private fun queryChildren(parentTreeUri: Uri): List<SafChild> {
+        val childrenUri = DocumentsContract.buildChildDocumentsUriUsingTree(
+            parentTreeUri,
+            SyncthingSafClient.getNarrowestDocumentId(parentTreeUri),
+        )
+        val cursor = context.contentResolver.query(
+            childrenUri,
+            arrayOf(
+                DocumentsContract.Document.COLUMN_DOCUMENT_ID,
+                DocumentsContract.Document.COLUMN_DISPLAY_NAME,
+                DocumentsContract.Document.COLUMN_MIME_TYPE,
+            ),
+            null,
+            null,
+            null,
+        ) ?: throw IOException("Query returned null cursor: $childrenUri")
+
+        return cursor.use {
+            val indexDocumentId =
+                it.getColumnIndexOrThrow(DocumentsContract.Document.COLUMN_DOCUMENT_ID)
+            val indexDisplayName =
+                it.getColumnIndexOrThrow(DocumentsContract.Document.COLUMN_DISPLAY_NAME)
+            val indexMimeType =
+                it.getColumnIndexOrThrow(DocumentsContract.Document.COLUMN_MIME_TYPE)
+
+            val children = mutableListOf<SafChild>()
+
+            while (it.moveToNext()) {
+                children.add(SafChild(
+                    documentId = it.getString(indexDocumentId),
+                    displayName = it.getString(indexDisplayName),
+                    isDirectory = it.getString(indexMimeType) ==
+                            DocumentsContract.Document.MIME_TYPE_DIR,
+                ))
+            }
+
+            children
+        }
+    }
+
+    private fun scanFile(file: File) {
+        try {
+            MediaScannerConnection.scanFile(context, arrayOf(file.absolutePath), null, null)
+        } catch (e: Exception) {
+            // MediaStore is only updated for the benefit of other apps, so this is not fatal.
+            Log.w(TAG, "Failed to scan: ${file.absolutePath}", e)
+        }
+    }
+
+    private fun failure(@StringRes resId: Int, vararg args: Any): ConflictResult.Failure =
+        ConflictResult.Failure(context.getString(resId, *args))
+
+    private fun failure(e: Exception): ConflictResult.Failure {
+        Log.w(TAG, "Failed to resolve sync conflict", e)
+
+        val details = e.message ?: e.javaClass.simpleName
+        val message = when (e) {
+            is SecurityException -> context.getString(R.string.conflict_error_security)
+            is UnsupportedOperationException ->
+                context.getString(R.string.conflict_error_unsupported)
+            is IllegalArgumentException ->
+                context.getString(R.string.conflict_error_invalid, details)
+            else -> context.getString(R.string.conflict_error_io, details)
+        }
+
+        return ConflictResult.Failure(message)
+    }
+
+    private data class SafChild(
+        val documentId: String,
+        val displayName: String,
+        val isDirectory: Boolean,
+    )
+}
