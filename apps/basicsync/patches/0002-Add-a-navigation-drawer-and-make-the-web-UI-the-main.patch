diff --git a/app/src/main/res/values/strings_nav.xml b/app/src/main/res/values/strings_nav.xml
new file mode 100644
index 0000000..f44f54b
--- /dev/null
+++ b/app/src/main/res/values/strings_nav.xml
@@ -0,0 +1,49 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    SPDX-FileCopyrightText: 2026 BasicSync patchwork contributors
+    SPDX-License-Identifier: GPL-3.0-only
+-->
+<resources>
+    <!-- Title of the drawer destination that shows Syncthing's web UI. This is the app's main page. -->
+    <string name="main_destination_sync">Sync</string>
+    <!-- Title of the drawer destination that shows the general settings. -->
+    <string name="main_destination_settings">Settings</string>
+
+    <!-- Content description for the navigation icon that opens the navigation drawer. -->
+    <string name="nav_open_drawer">Open navigation menu</string>
+
+    <!-- Title of the drawer item that closes the app entirely. -->
+    <string name="drawer_exit_app">Exit app</string>
+    <!-- Version shown below the app name in the drawer header. %1$s is the version name. -->
+    <string name="drawer_version">Version %1$s</string>
+    <!-- Note at the bottom of the drawer showing the app's license. Keep as short as possible. -->
+    <string name="drawer_footer_note">Free and open source under GPL-3.0</string>
+    <!-- Shown instead of a conflict count of 100 or more. -->
+    <string name="drawer_badge_overflow" translatable="false">99+</string>
+
+    <!-- Syncthing status shown in the drawer header: it is running and ready to sync. -->
+    <string name="drawer_status_running">Running</string>
+    <!-- Syncthing status shown in the drawer header: it is not running at all (not just paused). -->
+    <string name="drawer_status_not_running">Stopped</string>
+    <!-- Syncthing status shown in the drawer header: it is running, but syncing is paused. -->
+    <string name="drawer_status_paused">Paused</string>
+    <!-- Syncthing status shown in the drawer header: it was previously stopped and is starting up. -->
+    <string name="drawer_status_starting">Starting</string>
+    <!-- Syncthing status shown in the drawer header: it was previously running and is shutting down entirely. -->
+    <string name="drawer_status_stopping">Stopping</string>
+    <!-- Syncthing status shown in the drawer header: the configuration is being imported. -->
+    <string name="drawer_status_importing">Importing configuration</string>
+    <!-- Syncthing status shown in the drawer header: the configuration is being exported. -->
+    <string name="drawer_status_exporting">Exporting configuration</string>
+    <!-- Syncthing status shown when the state is not known yet, like right after the app was opened. -->
+    <string name="drawer_status_connecting">Connecting…</string>
+
+    <!-- Title of the sync page. %1$s is the page title ("Sync") and %2$s is the Syncthing status, like "Running". -->
+    <string name="main_sync_title_with_status">%1$s · %2$s</string>
+    <!-- Title shown on the sync page while Syncthing is not running. -->
+    <string name="main_sync_not_running_title">Syncthing is not running</string>
+    <!-- Explanation shown on the sync page while Syncthing is not running. -->
+    <string name="main_sync_not_running_message">BasicSync starts Syncthing automatically when its run conditions are met. The web UI shows up here as soon as it is running.</string>
+    <!-- Button that starts Syncthing from the sync page. -->
+    <string name="main_sync_not_running_action">Start Syncthing</string>
+</resources>
