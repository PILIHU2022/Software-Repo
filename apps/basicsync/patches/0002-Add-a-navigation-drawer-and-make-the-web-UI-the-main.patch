+import com.chiller3.basicsync.ui.MainDrawer
+import com.chiller3.basicsync.ui.theme.AppTheme
+
+/**
+ * The app's main activity. It shows Syncthing's web UI as the main page and provides a navigation
+ * drawer for the other commonly used pages.
+ */
+class MainActivity : BaseActivity() {
+    // The WebView is owned by the activity (instead of by a composable) so that its DOM state
+    // survives switching between drawer destinations.
+    private lateinit var webView: WebView
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        webView = WebView(this)
+
+        setContent {
+            AppTheme {
+                MainScreen(
+                    webView = webView,
+                    onExit = ::finishAffinity,
+                )
+            }
+        }
+    }
+
+    override fun onDestroy() {
+        super.onDestroy()
+
+        // The WebView is not managed by a composable, so it has to be destroyed explicitly when
+        // the activity goes away.
+        if (::webView.isInitialized) {
+            webView.destroy()
+        }
+    }
+}
+
+@Composable
+private fun MainScreen(
+    webView: WebView,
+    onExit: () -> Unit,
+) {
+    var destination by rememberSaveable { mutableStateOf(MainDestination.SYNC) }
+    var runState by remember { mutableStateOf<SyncthingService.RunState?>(null) }
+    var conflictCount by remember { mutableIntStateOf(0) }
+
+    rememberServiceEventWatcher(
+        listener = object : SyncthingService.ServiceListener {
+            override fun onMissingStoragePermissions(local: Boolean, saf: List<Uri>) {}
+
+            override fun onExitRequested() = onExit()
+
+            override fun onRunStateChanged(
+                state: SyncthingService.ServiceState,
+                guiInfo: SyncthingService.GuiInfo?,
+            ) {
+                runState = state.runState
+            }
+
+            override fun onPreRunActionResult(
+                preRunAction: SyncthingService.PreRunAction,
+                exception: Exception?,
+            ) {}
+
+            override fun onConflictsUpdated(conflictsInfo: SyncthingService.ConflictsInfo) {
+                conflictCount = conflictsInfo.local.size + conflictsInfo.saf.size
+            }
+        },
+    )
+
+    // Back from any other destination returns to the main page (the sync page). The modal drawer
+    // handles back itself while it is open because it registers its callback later.
+    BackHandler(enabled = destination != MainDestination.SYNC) {
+        destination = MainDestination.SYNC
+    }
+
+    MainDrawer(
+        selectedDestination = destination,
+        onDestinationSelected = { destination = it },
+        runState = runState,
+        conflictCount = conflictCount,
+        onExit = onExit,
+    ) { openDrawer ->
+        when (destination) {
+            MainDestination.SYNC -> WebUiScreen(
+                onClose = { destination = MainDestination.SETTINGS },
+                onExit = onExit,
+                onOpenDrawer = openDrawer,
+                webView = webView,
+            )
+            MainDestination.CONFLICTS -> ConflictsScreen(
+                onBack = {},
+                onExit = onExit,
+                onOpenDrawer = openDrawer,
+            )
+            MainDestination.SETTINGS -> SettingsScreen(
+                onExit = onExit,
+                onOpenDrawer = openDrawer,
+                onNavigateToWebUi = { destination = MainDestination.SYNC },
+                onNavigateToConflicts = { destination = MainDestination.CONFLICTS },
+                onNavigateToNetworkConditions = {
+                    destination = MainDestination.NETWORK_CONDITIONS
+                },
+                onNavigateToSyncSchedule = { destination = MainDestination.SYNC_SCHEDULE },
+            )
+            MainDestination.NETWORK_CONDITIONS -> NetworkConditionsScreen(
+                onBack = {},
+                onOpenDrawer = openDrawer,
+            )
+            MainDestination.SYNC_SCHEDULE -> SyncScheduleScreen(
+                onBack = {},
+                onOpenDrawer = openDrawer,
+            )
+        }
+    }
+}
