From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DeepSeek Harness <noreply@deepseek.com>
Date: Thu, 26 Nov 2026 10:00:00 +0800
Subject: [PATCH] Add conflict preview and partial overwrite state

Conflicts could only be acted on by file name, so the user had to leave
BasicSync and inspect the copy elsewhere before choosing which version to
keep. This adds a read-only preview action for direct-storage and SAF conflict
copies. It also separates the case where the original was successfully
replaced but the conflict copy could not be deleted: that state is no longer
reported as a failed overwrite and the card remains visible for cleanup.
---
 CHANGELOG.md                                |  1 +
 app/src/main/AndroidManifest.xml            | 15 ++++++
 .../basicsync/settings/ConflictsScreen.kt   | 58 +++++++++++++++++++++
 .../basicsync/syncthing/ConflictResolver.kt | 14 ++++-
 .../res/values-zh-rCN/strings_conflicts.xml |  6 +++
 .../main/res/values/strings_conflicts.xml   |  6 +++
 .../main/res/xml/file_provider_paths.xml    | 12 +++++
 7 files changed, 110 insertions(+), 2 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index d9beacf..e56e7e0 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -13,3 +13,4 @@ ### Unreleased
 * Add a navigation sidebar and make Syncthing's web UI the main page
 * Add a conflict management page that can discard a conflict copy or replace the original file with it
+* Add a conflict preview action and report a replaced-but-not-deleted conflict separately
 
diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index 2c760c0..baf0798 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -114,5 +114,20 @@
         <activity
             android:name=".settings.ConflictsActivity"
             android:exported="false" />
+
+        <!--
+            Conflict copies are read from the same folders that BasicSync syncs, but external apps
+            cannot open the raw paths directly. The provider grants only one temporary read grant
+            at a time; it is never used for writing or for any other app data.
+        -->
+        <provider
+            android:name="androidx.core.content.FileProvider"
+            android:authorities="${applicationId}.conflict.fileprovider"
+            android:exported="false"
+            android:grantUriPermissions="true">
+            <meta-data
+                android:name="android.support.FILE_PROVIDER_PATHS"
+                android:resource="@xml/file_provider_paths" />
+        </provider>
 
         <activity
diff --git a/app/src/main/java/com/chiller3/basicsync/settings/ConflictsScreen.kt b/app/src/main/java/com/chiller3/basicsync/settings/ConflictsScreen.kt
index 26346dd..50c53c8 100644
--- a/app/src/main/java/com/chiller3/basicsync/settings/ConflictsScreen.kt
+++ b/app/src/main/java/com/chiller3/basicsync/settings/ConflictsScreen.kt
@@ -12,5 +12,6 @@ package com.chiller3.basicsync.settings
 import android.content.res.Configuration
 import android.net.Uri
+import android.webkit.MimeTypeMap
 import androidx.compose.foundation.layout.Arrangement
 import androidx.compose.foundation.layout.Column
 import androidx.compose.foundation.layout.PaddingValues
@@ -62,3 +63,5 @@ import androidx.compose.ui.unit.dp
 import androidx.compose.ui.tooling.preview.Preview
 import androidx.compose.ui.unit.dp
+import androidx.core.content.FileProvider
+import java.io.File
 import com.chiller3.basicsync.R
@@ -242,2 +244,10 @@ fun ConflictsScreen(
                 when (result) {
+                    is ConflictResult.PartialSuccess -> {
+                        // Do not hide the item. Syncthing still reports the copy, and the user can
+                        // retry cleanup with the "Keep original" action without overwriting again.
+                        message = UiMessage(
+                            text = result.message,
+                        )
+                    }
+
                     is ConflictResult.Success -> {
@@ -300,3 +310,38 @@ fun ConflictsScreen(
             },
+            onPreview = { item ->
+                val uri = when {
+                    item.conflictFile != null ->
+                        FileProvider.getUriForFile(
+                            context,
+                            "${context.packageName}.conflict.fileprovider",
+                            File(item.conflictFile),
+                        )
+                    item.conflictUri != null -> item.conflictUri
+                    else -> null
+                }
+
+                if (uri == null) {
+                    message = UiMessage(
+                        text = resources.getString(R.string.conflicts_error_preview),
+                    )
+                } else {
+                    val mimeType = MimeTypeMap.getSingleton()
+                        .getMimeTypeFromExtension(item.fileName.substringAfterLast('.', ""))
+                        ?: "application/octet-stream"
+
+                    try {
+                        val intent = Intent(Intent.ACTION_VIEW).apply {
+                            setDataAndType(uri, mimeType)
+                            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                        }
+
+                        context.startActivity(intent)
+                    } catch (_: ActivityNotFoundException) {
+                        message = UiMessage(
+                            text = resources.getString(R.string.conflicts_error_preview),
+                        )
+                    }
+                }
+            },
             contentPadding = params.contentPadding,
         )
@@ -371,2 +426,3 @@ fun ConflictsContent(
     onKeepOriginal: (SyncthingService.ConflictItem) -> Unit,
+    onPreview: (SyncthingService.ConflictItem) -> Unit,
     onOpenFolder: (Uri) -> Unit,
@@ -405,3 +460,4 @@ fun ConflictsContent(
                     onUseConflict = { onUseConflict(conflict) },
                     onKeepOriginal = { onKeepOriginal(conflict) },
+                    onPreview = { onPreview(conflict) },
                     onOpenFolder = openFolder,
@@ -446,2 +502,3 @@ private fun ConflictCard(
     onKeepOriginal: () -> Unit,
+    onPreview: (() -> Unit)?,
     onOpenFolder: (() -> Unit)?,
@@ -550,11 +607,19 @@ private fun ConflictCard(
             onOpenFolder?.let { onOpenFolder ->
                 TextButton(
                     onClick = onOpenFolder,
                     enabled = enabled,
                 ) {
                     Text(text = stringResource(R.string.conflicts_action_open_folder))
                 }
             }
+            onPreview?.let { onPreview ->
+                TextButton(
+                    onClick = onPreview,
+                    enabled = enabled,
+                ) {
+                    Text(text = stringResource(R.string.conflicts_action_preview))
+                }
+            }
         }
     }
 }
@@ -620,2 +687,3 @@ private fun PreviewConflictsScreen() {
                 onKeepOriginal = {},
+                onPreview = {},
                 onOpenFolder = {},
diff --git a/app/src/main/java/com/chiller3/basicsync/syncthing/ConflictResolver.kt b/app/src/main/java/com/chiller3/basicsync/syncthing/ConflictResolver.kt
index 12e11e7..fe5c317 100644
--- a/app/src/main/java/com/chiller3/basicsync/syncthing/ConflictResolver.kt
+++ b/app/src/main/java/com/chiller3/basicsync/syncthing/ConflictResolver.kt
@@ -25,5 +25,11 @@ sealed interface ConflictResult {
     /** The conflict was resolved. */
     data object Success : ConflictResult
 
+    /**
+     * The original was replaced or restored, but the conflict copy remains. The UI must keep the
+     * item visible so the remaining copy can be deleted without repeating the overwrite.
+     */
+    data class PartialSuccess(val message: String) : ConflictResult
+
     /**
      * The conflict could not be resolved.
@@ -315,7 +321,9 @@ class ConflictResolver(private val context: Context) {
         if (!conflict.delete()) {
-            return failure(R.string.conflict_error_remove_after_copy, original.name)
+            return ConflictResult.PartialSuccess(
+                context.getString(R.string.conflict_error_remove_after_copy, original.name),
+            )
         }
 
         scanFile(original)
         return ConflictResult.Success
     }
@@ -388,5 +398,7 @@ class ConflictResolver(private val context: Context) {
         if (!DocumentsContract.deleteDocument(context.contentResolver, conflictDocumentUri)) {
-            return failure(R.string.conflict_error_remove_after_copy, originalName)
+            return ConflictResult.PartialSuccess(
+                context.getString(R.string.conflict_error_remove_after_copy, originalName),
+            )
         }
 
         return ConflictResult.Success
