+package com.atharok.screentime.presentation.viewmodel
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.atharok.screentime.domain.entities.analysis.AnalysisRange
+import com.atharok.screentime.domain.entities.analysis.UsageAnalysis
+import com.atharok.screentime.domain.resources.Resource
+import com.atharok.screentime.domain.usecases.UsageHistoryUseCase
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.launch
+
+class AnalysisViewModel(
+    private val useCase: UsageHistoryUseCase
+) : ViewModel() {
+
+    var selectedRange by mutableStateOf(AnalysisRange.WEEK)
+        private set
+
+    private val _analysisFlow = MutableStateFlow<Resource<UsageAnalysis>>(Resource.loading())
+    val analysisFlow: StateFlow<Resource<UsageAnalysis>> = _analysisFlow
+
+    var isRefreshing by mutableStateOf(false)
+        private set
+
+    init {
+        loadAnalysis(showLoading = true)
+        viewModelScope.launch(Dispatchers.IO) {
+            runCatching { useCase.refresh(force = false) }
+            loadAnalysis(showLoading = false)
+        }
+    }
+
+    fun selectRange(range: AnalysisRange) {
+        if (range == selectedRange) return
+        selectedRange = range
+        loadAnalysis(showLoading = true)
+    }
+
+    fun refresh() {
+        viewModelScope.launch {
+            isRefreshing = true
+            try {
+                useCase.refresh(force = true)
+                loadAnalysis(showLoading = false)
+            } catch (e: Exception) {
+                _analysisFlow.value = Resource.failure(e)
+            } finally {
+                isRefreshing = false
+            }
+        }
+    }
+
+    private fun loadAnalysis(showLoading: Boolean) {
+        viewModelScope.launch(Dispatchers.Default) {
+            val previous = (_analysisFlow.value as? Resource.Success)?.data
+            if (showLoading) {
+                _analysisFlow.value = Resource.loading(previous)
+            }
+            try {
+                _analysisFlow.value = Resource.success(useCase.getAnalysis(selectedRange))
+            } catch (e: Exception) {
+                _analysisFlow.value = Resource.failure(e, previous)
+            }
+        }
+    }
+}
