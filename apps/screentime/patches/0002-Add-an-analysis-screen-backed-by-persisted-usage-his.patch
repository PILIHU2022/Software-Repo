+private fun AnalysisRange.labelRes(): Int {
+    return when (this) {
+        AnalysisRange.WEEK -> R.string.analysis_range_week
+        AnalysisRange.MONTH -> R.string.analysis_range_month
+        AnalysisRange.QUARTER -> R.string.analysis_range_quarter
+        AnalysisRange.ALL -> R.string.analysis_range_all
+    }
+}
