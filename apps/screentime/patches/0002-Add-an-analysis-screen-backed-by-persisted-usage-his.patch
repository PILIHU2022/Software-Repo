+}
+
+@Composable
+private fun AnalysisContent(
+    analysisResource: Resource<UsageAnalysis>,
+    selectedRange: AnalysisRange,
+    isRefreshing: Boolean,
+    onRangeSelected: (AnalysisRange) -> Unit,
+    onRefresh: () -> Unit,
+    openApplicationUsageScreen: (String) -> Unit,
+    innerPadding: PaddingValues
+) {
+    LazyColumn(
+        contentPadding = innerPadding,
+        verticalArrangement = Arrangement.spacedBy(dimensionResource(id = R.dimen.padding_medium)),
+        modifier = Modifier.fillMaxWidth()
+    ) {
+        item {
+            AnalysisRangeSelector(
+                selectedRange = selectedRange,
+                onRangeSelected = onRangeSelected,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(horizontal = dimensionResource(id = R.dimen.padding_medium))
+                    .padding(top = dimensionResource(id = R.dimen.padding_small))
+            )
+        }
+
+        if (isRefreshing) {
+            item {
+                LinearProgressIndicator(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = dimensionResource(id = R.dimen.padding_medium))
+                )
+            }
+        }
+
+        when (analysisResource) {
+            is Resource.Failure -> item {
+                FailureMessage(analysisResource.throwable)
+            }
+            is Resource.Progress -> item {
+                Box(
+                    contentAlignment = Alignment.Center,
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .height(240.dp)
+                ) {
+                    CircularProgressIndicator()
+                }
+            }
+            is Resource.Success -> {
+                val analysis = analysisResource.data
+                if (!analysis.hasData) {
+                    item {
+                        EmptyHistory(
+                            onRefresh = onRefresh,
+                            modifier = Modifier.padding(horizontal = dimensionResource(id = R.dimen.padding_medium))
+                        )
+                    }
+                } else {
+                    item {
+                        SummaryCard(
+                            analysis = analysis,
+                            modifier = Modifier.padding(horizontal = dimensionResource(id = R.dimen.padding_medium))
+                        )
+                    }
+                    item {
+                        DailyChartCard(
+                            analysis = analysis,
+                            modifier = Modifier.padding(horizontal = dimensionResource(id = R.dimen.padding_medium))
+                        )
+                    }
+                    item {
+                        WeekdayCard(
+                            analysis = analysis,
+                            modifier = Modifier.padding(horizontal = dimensionResource(id = R.dimen.padding_medium))
+                        )
+                    }
+                    item {
+                        HourlyCard(
+                            analysis = analysis,
+                            modifier = Modifier.padding(horizontal = dimensionResource(id = R.dimen.padding_medium))
+                        )
+                    }
+                    if (analysis.topApps.isNotEmpty()) {
+                        item {
+                            TopAppsCard(
+                                analysis = analysis,
+                                openApplicationUsageScreen = openApplicationUsageScreen,
+                                modifier = Modifier.padding(horizontal = dimensionResource(id = R.dimen.padding_medium))
+                            )
+                        }
+                    }
+                    analysis.lastUpdated?.let { updatedAt ->
