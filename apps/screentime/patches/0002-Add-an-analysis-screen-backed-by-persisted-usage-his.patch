+@Composable
+fun AnalysisScreen(
+    navigateUp: () -> Unit,
+    openSettingsScreen: () -> Unit,
+    openApplicationUsageScreen: (String) -> Unit,
+    modifier: Modifier = Modifier,
+    viewModel: AnalysisViewModel = koinViewModel()
+) {
+    val analysisResource: Resource<UsageAnalysis> by viewModel.analysisFlow.collectAsStateWithLifecycle()
+
+    AppScaffold(
+        title = stringResource(id = R.string.analysis),
+        navigateUp = { NavigateUpAction(navigateUp = navigateUp) },
+        topBarActions = {
+            RefreshAction(refresh = viewModel::refresh)
+            SettingsAction(openSettingsScreen = openSettingsScreen)
+        },
+        modifier = modifier
+    ) { innerPadding ->
+        AnalysisContent(
+            analysisResource = analysisResource,
+            selectedRange = viewModel.selectedRange,
+            isRefreshing = viewModel.isRefreshing,
