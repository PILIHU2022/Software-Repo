+@Composable
+private fun SimpleBarChart(
+    values: List<Long>,
+    average: Long?,
+    modifier: Modifier = Modifier
+) {
+    if (values.isEmpty()) return
+    val barColor = MaterialTheme.colorScheme.primary
+    val averageColor = MaterialTheme.colorScheme.tertiary
+    val gridColor = MaterialTheme.colorScheme.outlineVariant
+
+    Canvas(modifier = modifier) {
+        val maxValue = maxOf(values.maxOrNull() ?: 1L, average ?: 0L, 1L)
+        val chartHeight = size.height
+
+        for (line in 0..3) {
+            val y = chartHeight * line / 3f
+            drawLine(
+                color = gridColor,
+                start = Offset(0f, y),
+                end = Offset(size.width, y),
+                strokeWidth = 1f
+            )
+        }
+
+        average?.let { averageValue ->
+            if (averageValue > 0L) {
+                val y = chartHeight - (averageValue.toFloat() / maxValue) * chartHeight
+                drawLine(
+                    color = averageColor,
+                    start = Offset(0f, y),
+                    end = Offset(size.width, y),
+                    strokeWidth = 2f,
+                    pathEffect = PathEffect.dashPathEffect(floatArrayOf(10f, 8f))
+                )
+            }
+        }
+
+        val slot = size.width / values.size
+        val barWidth = (slot * 0.62f).coerceAtLeast(2f)
+        val radius = CornerRadius(3f, 3f)
+
+        values.forEachIndexed { index, value ->
+            val height = (value.toFloat() / maxValue) * chartHeight
+            val left = index * slot + (slot - barWidth) / 2f
+            val top = chartHeight - height
+            drawRoundRect(
+                color = barColor.copy(alpha = if (value > 0L) 0.9f else 0.2f),
+                topLeft = Offset(left, top),
+                size = Size(barWidth, height.coerceAtLeast(2f)),
+                cornerRadius = radius
+            )
+        }
+    }
+}
