@@ -24,10 +32,48 @@ class UsageHistoryUseCase(
             days = days,
             ignoreSystemApps = ignoreSystemApps,
             ignoredPackages = ignoredPackages,
-            force = force
+            force = force,
+            fullScan = fullScan
         )
     }
 
+    /**
+     * One-off import of the usage history that existed before the local database was introduced.
+     *
+     * The system usage event log is the only source: it is scanned over [BACKFILL_DAYS] days
+     * (or as far back as the system still keeps events), even if the database already contains
+     * today's data. The migration runs only when usage access is granted and the flag is not
+     * set yet. The flag is written only after a successful scan, so a failure is retried later.
+     */
+    suspend fun ensureHistoryMigrated(): Boolean = backfillMutex.withLock {
+        if (!repository.hasUsagePermission()) return@withLock false
+        if (repository.isHistoryBackfilled()) return@withLock false
+        performFullBackfill()
+    }
+
+    /** True when the one-off backfill is still waiting to run and can run. */
+    suspend fun isHistoryBackfillPending(): Boolean =
+        repository.hasUsagePermission() && !repository.isHistoryBackfilled()
+
+    /**
+     * Explicit full re-import of the system usage history. Existing historical rows are kept
+     * when they contain more usage than the current system event log does.
+     */
+    suspend fun rebuildHistory(): Boolean = backfillMutex.withLock {
+        if (!repository.hasUsagePermission()) return@withLock false
+        performFullBackfill()
+    }
+
+    private suspend fun performFullBackfill(): Boolean {
+        val success = runCatching {
+            refresh(force = true, days = BACKFILL_DAYS, fullScan = true)
+        }.getOrDefault(false)
+        if (success) {
+            runCatching { repository.markHistoryBackfilled() }
+        }
+        return success
+    }
+
