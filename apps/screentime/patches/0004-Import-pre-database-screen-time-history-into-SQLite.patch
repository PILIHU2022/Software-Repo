-    suspend fun refresh(force: Boolean = false, days: Int = DEFAULT_HISTORY_DAYS): Boolean {
+    private val backfillMutex = Mutex()
+
+    suspend fun refresh(
+        force: Boolean = false,
+        days: Int = DEFAULT_HISTORY_DAYS,
+        fullScan: Boolean = false
+    ): Boolean {
         val ignoreSystemApps = settingsUseCase.shouldIgnoreSystemApps().first()
