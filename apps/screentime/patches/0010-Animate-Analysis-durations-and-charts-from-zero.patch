+/**
+ * Animates a duration from 0 to [timestamp] and returns the current animated value.
+ *
+ * @param timestamp The final duration, in the same unit used by the caller (milliseconds).
+ * @param enabled When false, the final value is returned immediately (no flash of zero).
+ * @param durationMillis The duration of the count-up animation.
+ * @param delayMillis An optional delay before the animation starts.
+ * @param animationKey When this value changes, the animation restarts from zero.
+ */
+@Composable
+fun rememberAnimatedDuration(
+    timestamp: Long,
+    enabled: Boolean = true,
+    durationMillis: Int = 900,
+    delayMillis: Int = 0,
+    animationKey: Any? = timestamp
+): Long {
+    val progress = rememberAnimationProgress(
+        enabled = enabled,
+        durationMillis = durationMillis,
+        delayMillis = delayMillis,
+        animationKey = animationKey
+    )
+    return (timestamp.toDouble() * progress).toLong()
+}
+
+/**
+ * Animates a fraction from 0 to [target] and returns the current animated value.
+ *
+ * @param target The final fraction, usually in the 0..1 range.
+ * @param enabled When false, the final value is returned immediately (no flash of zero).
+ * @param durationMillis The duration of the animation.
+ * @param delayMillis An optional delay before the animation starts.
+ * @param animationKey When this value changes, the animation restarts from zero.
+ */
+@Composable
+fun rememberAnimatedFraction(
+    target: Float,
+    enabled: Boolean = true,
+    durationMillis: Int = 900,
+    delayMillis: Int = 0,
+    animationKey: Any? = target
+): Float {
+    val progress = rememberAnimationProgress(
+        enabled = enabled,
+        durationMillis = durationMillis,
+        delayMillis = delayMillis,
+        animationKey = animationKey
+    )
+    return target * progress
+}
+
+@Composable
+private fun rememberAnimationProgress(
+    enabled: Boolean,
+    durationMillis: Int,
+    delayMillis: Int,
+    animationKey: Any?
+): Float {
+    val progress = remember { Animatable(if (enabled) 0f else 1f) }
+    LaunchedEffect(animationKey, enabled) {
+        if (!enabled) {
+            progress.snapTo(1f)
+        } else {
+            progress.snapTo(0f)
+            if (delayMillis > 0) {
+                delay(delayMillis.toLong())
+            }
+            progress.animateTo(
+                targetValue = 1f,
+                animationSpec = tween(
+                    durationMillis = durationMillis,
+                    easing = FastOutSlowInEasing
+                )
+            )
+        }
+    }
+    return progress.value
+}
