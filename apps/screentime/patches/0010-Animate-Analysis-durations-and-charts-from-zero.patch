+@Composable
+private fun TopAppRow(
+    app: AppUsageTotal,
+    index: Int,
+    animate: Boolean,
+    openApplicationUsageScreen: (String) -> Unit
+) {
+    val context = LocalContext.current
+    val animatedDuration = rememberAnimatedDuration(
+        timestamp = app.duration,
+        enabled = animate,
+        delayMillis = index * 60,
+        animationKey = app.packageName to app.duration
+    )
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        modifier = Modifier
+            .fillMaxWidth()
+            .clickable { openApplicationUsageScreen(app.packageName) }
+            .padding(vertical = dimensionResource(id = R.dimen.padding_normal))
+    ) {
+        val icon = remember(app.packageName) {
+            context.packageManager.getApplicationIconSafety(app.packageName)
+        }
+        ApplicationIcon(
+            drawable = icon,
+            contentDescription = app.appName,
+            modifier = Modifier.size(dimensionResource(id = R.dimen.icon_medium_size)),
+            cacheKey = app.packageName
+        )
+        Column(
+            modifier = Modifier
+                .weight(1f)
+                .padding(horizontal = dimensionResource(id = R.dimen.padding_medium))
+        ) {
+            TextNormal(text = app.appName, maxLines = 1)
+            TextSmall(text = app.packageName, maxLines = 1)
+        }
+        Column(horizontalAlignment = Alignment.End) {
+            TextNormal(text = DateTimeUtils.formatToDuration(animatedDuration), maxLines = 1)
+            TextSmall(
+                text = pluralStringResource(
+                    id = R.plurals.analysis_days_used,
+                    count = app.daysUsed,
+                    app.daysUsed
+                ),
+                maxLines = 1
+            )
+        }
+    }
+}
