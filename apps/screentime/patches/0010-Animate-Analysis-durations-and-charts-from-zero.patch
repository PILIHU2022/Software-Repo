+@Composable
+private fun WeekdayRow(
+    index: Int,
+    duration: Long,
+    max: Long,
+    animate: Boolean
+) {
+    val targetFraction = if (max == 0L) 0f else duration.toFloat() / max
+    val fraction = rememberAnimatedFraction(
+        target = targetFraction,
+        enabled = animate,
+        delayMillis = index * 50,
+        animationKey = duration to max
+    )
+    val animatedDuration = if (targetFraction > 0f) {
+        (duration.toDouble() * fraction / targetFraction).toLong()
+    } else {
+        0L
+    }
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(top = dimensionResource(id = R.dimen.padding_normal))
+    ) {
+        TextSmall(
+            text = DateTimeUtils.formatWeekdayByIndex(index),
+            modifier = Modifier.width(52.dp)
+        )
+        LinearProgressIndicator(
+            progress = { fraction },
+            modifier = Modifier
+                .weight(1f)
+                .height(8.dp)
+                .clip(CircleShape),
+            drawStopIndicator = {}
+        )
+        TextSmall(
+            text = DateTimeUtils.formatToDuration(animatedDuration),
+            textAlign = TextAlign.End,
+            modifier = Modifier.width(80.dp)
+        )
+    }
+}
