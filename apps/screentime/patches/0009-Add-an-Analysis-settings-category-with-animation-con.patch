 .../viewmodel/SettingsViewModel.kt            |  5 ++
 .../screentime/ui/screens/SettingsScreen.kt   | 62 +++++++++++++++++++
 app/src/main/res/values-zh-rCN/strings.xml    |  6 ++
 app/src/main/res/values/strings.xml           |  6 ++
 8 files changed, 109 insertions(+)

diff --git a/app/src/main/java/com/atharok/screentime/data/dataStore/SettingsDataStore.kt b/app/src/main/java/com/atharok/screentime/data/dataStore/SettingsDataStore.kt
index 980232d..fe7f288 100644
--- a/app/src/main/java/com/atharok/screentime/data/dataStore/SettingsDataStore.kt
+++ b/app/src/main/java/com/atharok/screentime/data/dataStore/SettingsDataStore.kt
@@ -25,6 +25,7 @@ class SettingsDataStore(private val context: Context) {
         private const val DEFAULT_PERIOD_KEY = "default_period_key"
         private const val IGNORE_SYSTEM_APP_KEY = "ignore_system_app_key"
         private const val IGNORED_PACKAGES_KEY = "ignored_packages_key"
+        private const val ANIMATE_STATISTICS_KEY = "animate_statistics_key"
     }
 
     private val themeKey = stringPreferencesKey(THEME_KEY)
@@ -33,6 +34,7 @@ class SettingsDataStore(private val context: Context) {
     private val defaultPeriodKey = stringPreferencesKey(DEFAULT_PERIOD_KEY)
     private val ignoreSystemAppsKey = booleanPreferencesKey(IGNORE_SYSTEM_APP_KEY)
     private val ignoredPackagesKey = stringPreferencesKey(IGNORED_PACKAGES_KEY)
+    private val animateStatisticsKey = booleanPreferencesKey(ANIMATE_STATISTICS_KEY)
 
     private fun Flow<Preferences>.catchException(): Flow<Preferences> = this.catch {
         if (it is IOException) {
@@ -142,4 +144,18 @@ class SettingsDataStore(private val context: Context) {
             }
         }
     }
+
+    // ---- Analysis ----
+
+    val animateStatisticsFlow: Flow<Boolean> = context.dataStore.data
+        .catchException()
+        .map { preferences ->
+            preferences[animateStatisticsKey] ?: true
+        }
+
+    suspend fun saveAnimateStatistics(animateStatistics: Boolean) {
+        context.dataStore.edit {
+            it[animateStatisticsKey] = animateStatistics
+        }
+    }
 }
