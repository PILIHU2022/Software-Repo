+import kotlin.math.ceil
 
+private const val CHART_HEIGHT_DP = 192
+private const val MAX_INTERVALS = 6
+private const val DAY_LABEL_INTERVAL = 4
+
+private val STEP_CANDIDATES_MINUTES = intArrayOf(
+    1, 2, 3, 5, 10, 15, 20, 30, 45, 60, 90, 120, 180, 240, 360, 480, 720, 1440
+)
+
+private data class ChartAxis(
+    val maxMinutes: Int,
+    val ticks: List<Int>
+)
+
+private fun computeChartAxis(maxHours: Double): ChartAxis {
+    val maxMinutes = ceil(maxHours * 60.0).toInt().coerceAtLeast(1)
+    val step = STEP_CANDIDATES_MINUTES.firstOrNull { candidate ->
+        ceil(maxMinutes.toDouble() / candidate).toInt() <= MAX_INTERVALS
+    } ?: STEP_CANDIDATES_MINUTES.last()
+    val maxTick = ceil(maxMinutes.toDouble() / step).toInt() * step
+    return ChartAxis(
+        maxMinutes = maxTick,
+        ticks = (0..maxTick step step).toList()
+    )
+}
