+package com.atharok.screentime.domain.repositories
+
+import com.atharok.screentime.domain.entities.analysis.AppUsageTotal
+
+interface UsageHistoryRepository {
+
+    /**
+     * Scans the system usage events and persists per-day, per-hour and per-app totals.
+     * Historical rows are never downgraded, so data survives event retention limits.
+     */
+    suspend fun refreshHistory(
+        days: Int,
+        ignoreSystemApps: Boolean,
+        ignoredPackages: List<String>,
+        force: Boolean = false
+    ): Boolean
+
+    suspend fun getDayTotals(startDay: Long, endDay: Long): Map<Long, Long>
+
+    suspend fun getHourlyTotals(startDay: Long, endDay: Long): Map<Long, LongArray>
+
+    suspend fun getAppTotals(startDay: Long, endDay: Long, limit: Int): List<AppUsageTotal>
+
+    suspend fun getEarliestDay(): Long?
+
+    suspend fun getLastUpdated(): Long?
+}
diff --git a/app/src/main/java/com/atharok/screentime/domain/usecases/UsageHistoryUseCase.kt b/app/src/main/java/com/atharok/screentime/domain/usecases/UsageHistoryUseCase.kt
