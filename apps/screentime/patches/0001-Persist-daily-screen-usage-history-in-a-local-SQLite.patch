+package com.atharok.screentime.domain.entities.analysis
+
+enum class AnalysisRange(val days: Int?) {
+    WEEK(7),
+    MONTH(30),
+    QUARTER(90),
+    ALL(null)
+}
+
+data class DailyUsagePoint(
+    val dayStart: Long,
+    val duration: Long
+)
+
+data class AppUsageTotal(
+    val packageName: String,
+    val appName: String,
+    val duration: Long,
+    val daysUsed: Int
+)
+
+data class UsageAnalysis(
+    val range: AnalysisRange,
+    val startDay: Long,
+    val endDay: Long,
+    val daily: List<DailyUsagePoint>,
+    val hourlyAverage: LongArray,
+    val weekdayAverage: LongArray,
+    val topApps: List<AppUsageTotal>,
+    val totalDuration: Long,
+    val averageDaily: Long,
+    val previousAverageDaily: Long?,
+    val bestDay: DailyUsagePoint?,
+    val daysWithData: Int,
+    val lastUpdated: Long?
+) {
+    val hasData: Boolean get() = totalDuration > 0
+
+    override fun equals(other: Any?): Boolean {
+        if (this === other) return true
+        if (other !is UsageAnalysis) return false
+        return range == other.range &&
+            startDay == other.startDay &&
+            endDay == other.endDay &&
+            daily == other.daily &&
+            hourlyAverage.contentEquals(other.hourlyAverage) &&
+            weekdayAverage.contentEquals(other.weekdayAverage) &&
+            topApps == other.topApps &&
+            totalDuration == other.totalDuration &&
+            averageDaily == other.averageDaily &&
+            previousAverageDaily == other.previousAverageDaily &&
+            bestDay == other.bestDay &&
+            daysWithData == other.daysWithData &&
+            lastUpdated == other.lastUpdated
+    }
+
+    override fun hashCode(): Int {
+        var result = range.hashCode()
+        result = 31 * result + startDay.hashCode()
+        result = 31 * result + endDay.hashCode()
+        result = 31 * result + daily.hashCode()
+        result = 31 * result + hourlyAverage.contentHashCode()
+        result = 31 * result + weekdayAverage.contentHashCode()
+        result = 31 * result + topApps.hashCode()
+        result = 31 * result + totalDuration.hashCode()
+        result = 31 * result + averageDaily.hashCode()
+        result = 31 * result + (previousAverageDaily?.hashCode() ?: 0)
+        result = 31 * result + (bestDay?.hashCode() ?: 0)
+        result = 31 * result + daysWithData
+        result = 31 * result + (lastUpdated?.hashCode() ?: 0)
+        return result
+    }
+}
