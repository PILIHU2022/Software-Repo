+++ b/app/src/main/java/com/atharok/screentime/domain/usecases/UsageHistoryUseCase.kt
@@ -0,0 +1,149 @@
+package com.atharok.screentime.domain.usecases
+
+import com.atharok.screentime.common.utils.DateTimeUtils
+import com.atharok.screentime.domain.entities.analysis.AnalysisRange
+import com.atharok.screentime.domain.entities.analysis.DailyUsagePoint
+import com.atharok.screentime.domain.entities.analysis.UsageAnalysis
+import com.atharok.screentime.domain.repositories.UsageHistoryRepository
+import kotlinx.coroutines.flow.first
+import java.util.Calendar
+
+class UsageHistoryUseCase(
+    private val repository: UsageHistoryRepository,
+    private val settingsUseCase: SettingsUseCase
+) {
+
+    suspend fun refresh(force: Boolean = false, days: Int = DEFAULT_HISTORY_DAYS): Boolean {
+        val ignoreSystemApps = settingsUseCase.shouldIgnoreSystemApps().first()
+        val ignoredPackages = try {
+            settingsUseCase.getIgnoredPackages().first()
+        } catch (_: Exception) {
+            emptyList()
+        }
+        return repository.refreshHistory(
+            days = days,
+            ignoreSystemApps = ignoreSystemApps,
+            ignoredPackages = ignoredPackages,
+            force = force
+        )
+    }
+
+    suspend fun getLastUpdated(): Long? = repository.getLastUpdated()
+
+    suspend fun getAnalysis(range: AnalysisRange): UsageAnalysis {
+        val today = DateTimeUtils.truncateToDay(System.currentTimeMillis())
+        val earliest = repository.getEarliestDay()
+        val dayCount = when (val requested = range.days) {
+            null -> {
+                earliest?.let { calculateDayCount(it, today) } ?: 0
+            }
+            else -> requested
+        }
+
+        if (dayCount <= 0) {
+            return emptyAnalysis(range, today)
+        }
+
+        val start = DateTimeUtils.addDaysToTimestamp(today, -(dayCount - 1))
+        val totals = repository.getDayTotals(start, today)
+        val hourlyTotals = repository.getHourlyTotals(start, today)
+        val topApps = repository.getAppTotals(start, today, TOP_APPS_LIMIT)
+        val lastUpdated = repository.getLastUpdated()
+
+        val daily = ArrayList<DailyUsagePoint>(dayCount)
+        var cursor = start
+        while (cursor <= today) {
+            daily += DailyUsagePoint(cursor, totals[cursor] ?: 0L)
+            cursor = DateTimeUtils.addDaysToTimestamp(cursor, 1)
+        }
+
+        val totalDuration = daily.sumOf { it.duration }
+        val averageDaily = if (daily.isEmpty()) 0L else totalDuration / daily.size
+
+        val weekdaySums = LongArray(7)
+        val weekdayCounts = IntArray(7)
+        daily.forEach { point ->
+            val index = weekdayIndex(point.dayStart)
+            weekdaySums[index] += point.duration
+            weekdayCounts[index]++
+        }
+        val weekdayAverage = LongArray(7) { index ->
+            if (weekdayCounts[index] == 0) 0L else weekdaySums[index] / weekdayCounts[index]
+        }
+
+        val hourSums = LongArray(24)
+        hourlyTotals.values.forEach { hours ->
+            for (hour in 0..23) {
+                hourSums[hour] += hours[hour]
+            }
+        }
+        val hourlyAverage = LongArray(24) { hour ->
+            if (daily.isEmpty()) 0L else hourSums[hour] / daily.size
+        }
+
+        val previousAverage = if (range.days != null) {
+            val previousEnd = DateTimeUtils.addDaysToTimestamp(start, -1)
+            val previousStart = DateTimeUtils.addDaysToTimestamp(previousEnd, -(dayCount - 1))
+            val previousTotals = repository.getDayTotals(previousStart, previousEnd)
+            if (previousTotals.isEmpty()) null else previousTotals.values.sum() / dayCount
+        } else {
+            null
+        }
+
+        return UsageAnalysis(
+            range = range,
+            startDay = start,
+            endDay = today,
+            daily = daily,
+            hourlyAverage = hourlyAverage,
+            weekdayAverage = weekdayAverage,
+            topApps = topApps,
+            totalDuration = totalDuration,
+            averageDaily = averageDaily,
+            previousAverageDaily = previousAverage,
+            bestDay = daily.maxByOrNull { it.duration },
+            daysWithData = daily.count { it.duration > 0L },
+            lastUpdated = lastUpdated
+        )
+    }
+
+    private fun calculateDayCount(earliestDay: Long, today: Long): Int {
+        var count = 1
+        var cursor = earliestDay
+        while (cursor < today && count < MAX_HISTORY_DAYS) {
+            cursor = DateTimeUtils.addDaysToTimestamp(cursor, 1)
+            count++
+        }
+        return count
+    }
+
+    private fun weekdayIndex(dayStart: Long): Int {
+        val calendar = Calendar.getInstance().apply { timeInMillis = dayStart }
+        // Calendar.SUNDAY == 1 … Calendar.SATURDAY == 7. Monday-first index:
+        return (calendar.get(Calendar.DAY_OF_WEEK) + 5) % 7
+    }
+
+    private fun emptyAnalysis(range: AnalysisRange, today: Long): UsageAnalysis {
+        return UsageAnalysis(
+            range = range,
+            startDay = today,
+            endDay = today,
+            daily = emptyList(),
+            hourlyAverage = LongArray(24),
+            weekdayAverage = LongArray(7),
+            topApps = emptyList(),
+            totalDuration = 0L,
+            averageDaily = 0L,
+            previousAverageDaily = null,
+            bestDay = null,
+            daysWithData = 0,
+            lastUpdated = null
+        )
+    }
+
+    companion object {
+        const val DEFAULT_HISTORY_DAYS = 90
+        private const val MAX_HISTORY_DAYS = 3650
+        private const val TOP_APPS_LIMIT = 10
+    }
+}
