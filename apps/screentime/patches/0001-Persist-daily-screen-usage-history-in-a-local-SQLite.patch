+package com.atharok.screentime.data.workers
+
+import android.content.Context
+import androidx.work.CoroutineWorker
+import androidx.work.WorkerParameters
+import com.atharok.screentime.domain.usecases.UsageHistoryUseCase
+import org.koin.core.context.GlobalContext
+
+class UsageHistoryWorker(
+    appContext: Context,
+    params: WorkerParameters
+) : CoroutineWorker(appContext, params) {
+
+    override suspend fun doWork(): Result {
+        return try {
+            GlobalContext.get().get<UsageHistoryUseCase>().refresh(force = true)
+            Result.success()
+        } catch (e: Exception) {
+            Result.retry()
+        }
+    }
+}
diff --git a/app/src/main/java/com/atharok/screentime/domain/entities/analysis/UsageAnalysis.kt b/app/src/main/java/com/atharok/screentime/domain/entities/analysis/UsageAnalysis.kt
