+package com.atharok.screentime.data.database
+
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.database.sqlite.SQLiteOpenHelper
+
+/**
+ * Local, append-only history of screen usage.
+ *
+ * The system usage event log is limited (and uninstalling an app removes its events), so the
+ * values are copied here once per day and kept forever. The database is intentionally small and
+ * dependency free: it only stores aggregate durations.
+ */
+class ScreenTimeDatabase(context: Context) : SQLiteOpenHelper(
+    context.applicationContext,
+    DATABASE_NAME,
+    null,
+    DATABASE_VERSION
+) {
+
+    override fun onCreate(db: SQLiteDatabase) {
+        db.execSQL(
+            """
+            CREATE TABLE IF NOT EXISTS usage_day (
+                day_start INTEGER NOT NULL PRIMARY KEY,
+                total_duration INTEGER NOT NULL,
+                updated_at INTEGER NOT NULL
+            )
+            """.trimIndent()
+        )
+        db.execSQL(
+            """
+            CREATE TABLE IF NOT EXISTS usage_hour (
+                day_start INTEGER NOT NULL,
+                hour INTEGER NOT NULL,
+                duration INTEGER NOT NULL,
+                PRIMARY KEY (day_start, hour)
+            )
+            """.trimIndent()
+        )
+        db.execSQL(
+            """
+            CREATE TABLE IF NOT EXISTS usage_app_day (
+                day_start INTEGER NOT NULL,
+                package_name TEXT NOT NULL,
+                app_name TEXT NOT NULL,
+                duration INTEGER NOT NULL,
+                PRIMARY KEY (day_start, package_name)
+            )
+            """.trimIndent()
+        )
+        db.execSQL(
+            "CREATE INDEX IF NOT EXISTS index_usage_app_day_package ON usage_app_day(package_name)"
+        )
+    }
+
+    override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) {
+        // Version 1 is the initial schema. Future migrations go here.
+    }
+
+    companion object {
+        const val DATABASE_NAME = "screen_time_history.db"
+        const val DATABASE_VERSION = 1
+    }
+}
diff --git a/app/src/main/java/com/atharok/screentime/data/database/UsageHistoryDao.kt b/app/src/main/java/com/atharok/screentime/data/database/UsageHistoryDao.kt
