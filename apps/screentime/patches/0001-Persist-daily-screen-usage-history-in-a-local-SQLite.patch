@@ -0,0 +1,153 @@
+package com.atharok.screentime.data.database
+
+import android.content.ContentValues
+import android.database.sqlite.SQLiteDatabase
+import com.atharok.screentime.domain.entities.analysis.AppUsageTotal
+
+data class AppUsageEntry(
+    val packageName: String,
+    val appName: String,
+    val duration: Long
+)
+
+class UsageHistoryDao(private val database: ScreenTimeDatabase) {
+
+    fun getDayTotal(dayStart: Long): Long? {
+        database.readableDatabase.rawQuery(
+            "SELECT total_duration FROM usage_day WHERE day_start = ? LIMIT 1",
+            arrayOf(dayStart.toString())
+        ).use { cursor ->
+            return if (cursor.moveToFirst()) cursor.getLong(0) else null
+        }
+    }
+
+    fun replaceDay(
+        dayStart: Long,
+        totalDuration: Long,
+        hourlyDurations: LongArray,
+        apps: List<AppUsageEntry>,
+        updatedAt: Long
+    ) {
+        val db = database.writableDatabase
+        db.beginTransaction()
+        try {
+            db.insertWithOnConflict(
+                "usage_day",
+                null,
+                ContentValues().apply {
+                    put("day_start", dayStart)
+                    put("total_duration", totalDuration)
+                    put("updated_at", updatedAt)
+                },
+                SQLiteDatabase.CONFLICT_REPLACE
+            )
+            db.delete("usage_hour", "day_start = ?", arrayOf(dayStart.toString()))
+            db.delete("usage_app_day", "day_start = ?", arrayOf(dayStart.toString()))
+
+            for (hour in hourlyDurations.indices) {
+                val duration = hourlyDurations[hour]
+                if (duration <= 0L) continue
+                db.insertWithOnConflict(
+                    "usage_hour",
+                    null,
+                    ContentValues().apply {
+                        put("day_start", dayStart)
+                        put("hour", hour)
+                        put("duration", duration)
+                    },
+                    SQLiteDatabase.CONFLICT_REPLACE
+                )
+            }
+
+            apps.forEach { app ->
+                if (app.duration <= 0L) return@forEach
+                db.insertWithOnConflict(
+                    "usage_app_day",
+                    null,
+                    ContentValues().apply {
+                        put("day_start", dayStart)
+                        put("package_name", app.packageName)
+                        put("app_name", app.appName)
+                        put("duration", app.duration)
+                    },
+                    SQLiteDatabase.CONFLICT_REPLACE
+                )
+            }
+
+            db.setTransactionSuccessful()
+        } finally {
+            db.endTransaction()
+        }
+    }
+
+    fun getDayTotals(startDay: Long, endDay: Long): Map<Long, Long> {
+        val result = LinkedHashMap<Long, Long>()
+        database.readableDatabase.rawQuery(
+            "SELECT day_start, total_duration FROM usage_day " +
+                "WHERE day_start BETWEEN ? AND ? ORDER BY day_start",
+            arrayOf(startDay.toString(), endDay.toString())
+        ).use { cursor ->
+            while (cursor.moveToNext()) {
+                result[cursor.getLong(0)] = cursor.getLong(1)
+            }
+        }
+        return result
+    }
+
+    fun getHourlyTotals(startDay: Long, endDay: Long): Map<Long, LongArray> {
+        val result = LinkedHashMap<Long, LongArray>()
+        database.readableDatabase.rawQuery(
+            "SELECT day_start, hour, duration FROM usage_hour " +
+                "WHERE day_start BETWEEN ? AND ? ORDER BY day_start, hour",
+            arrayOf(startDay.toString(), endDay.toString())
+        ).use { cursor ->
+            while (cursor.moveToNext()) {
+                val day = cursor.getLong(0)
+                val hour = cursor.getInt(1)
+                val duration = cursor.getLong(2)
+                if (hour in 0..23) {
+                    result.getOrPut(day) { LongArray(24) }[hour] = duration
+                }
+            }
+        }
+        return result
+    }
+
+    fun getAppTotals(startDay: Long, endDay: Long, limit: Int): List<AppUsageTotal> {
+        val result = mutableListOf<AppUsageTotal>()
+        database.readableDatabase.rawQuery(
+            "SELECT package_name, MAX(app_name), SUM(duration), COUNT(DISTINCT day_start) " +
+                "FROM usage_app_day WHERE day_start BETWEEN ? AND ? " +
+                "GROUP BY package_name ORDER BY SUM(duration) DESC LIMIT ?",
+            arrayOf(startDay.toString(), endDay.toString(), limit.toString())
+        ).use { cursor ->
+            while (cursor.moveToNext()) {
+                result += AppUsageTotal(
+                    packageName = cursor.getString(0),
+                    appName = cursor.getString(1) ?: cursor.getString(0),
+                    duration = cursor.getLong(2),
+                    daysUsed = cursor.getInt(3)
+                )
+            }
+        }
+        return result
+    }
+
+    fun getEarliestDay(): Long? {
+        database.readableDatabase.rawQuery(
+            "SELECT MIN(day_start) FROM usage_day WHERE total_duration > 0",
+            null
+        ).use { cursor ->
+            return if (cursor.moveToFirst() && !cursor.isNull(0)) cursor.getLong(0) else null
+        }
+    }
+
+    fun getLastUpdated(): Long? {
+        database.readableDatabase.rawQuery(
+            "SELECT MAX(updated_at) FROM usage_day",
+            null
+        ).use { cursor ->
+            return if (cursor.moveToFirst() && !cursor.isNull(0)) cursor.getLong(0) else null
+        }
+    }
+}
diff --git a/app/src/main/java/com/atharok/screentime/data/repositories/UsageHistoryRepositoryImpl.kt b/app/src/main/java/com/atharok/screentime/data/repositories/UsageHistoryRepositoryImpl.kt
