@@ -0,0 +1,126 @@
+package com.atharok.screentime.data.repositories
+
+import android.content.Context
+import com.atharok.screentime.common.extensions.getApplicationName
+import com.atharok.screentime.common.utils.DateTimeUtils
+import com.atharok.screentime.data.database.AppUsageEntry
+import com.atharok.screentime.data.database.UsageHistoryDao
+import com.atharok.screentime.data.statsTracker.UsageStatsTracker
+import com.atharok.screentime.domain.entities.analysis.AppUsageTotal
+import com.atharok.screentime.domain.repositories.UsageHistoryRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.IO
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+
+class UsageHistoryRepositoryImpl(
+    private val context: Context,
+    private val tracker: UsageStatsTracker,
+    private val dao: UsageHistoryDao
+) : UsageHistoryRepository {
+
+    private val refreshMutex = Mutex()
+    private var lastRefreshAt: Long = 0L
+
+    override suspend fun refreshHistory(
+        days: Int,
+        ignoreSystemApps: Boolean,
+        ignoredPackages: List<String>,
+        force: Boolean
+    ): Boolean = withContext(Dispatchers.IO) {
+        refreshMutex.withLock {
+            val now = System.currentTimeMillis()
+            if (!force && now - lastRefreshAt < MIN_REFRESH_INTERVAL_MS) {
+                return@withLock false
+            }
+
+            val today = DateTimeUtils.truncateToDay(now)
+            val lastPersistedDay = dao.getLastUpdated()?.let { DateTimeUtils.truncateToDay(it) }
+            val scanDays = if (lastPersistedDay == null) {
+                days
+            } else {
+                val daysSinceLastUpdate = ((today - lastPersistedDay) / MILLIS_IN_A_DAY).toInt() + 2
+                daysSinceLastUpdate.coerceIn(MIN_SCAN_DAYS, days)
+            }
+            val start = DateTimeUtils.addDaysToTimestamp(today, -(scanDays - 1))
+
+            val usageIntervals = tracker.calculateUsageIntervalsByPackage(
+                startTimestamp = start,
+                endTimestamp = now,
+                ignoreSystemApps = ignoreSystemApps,
+                ignoredPackages = ignoredPackages
+            )
+            val durationsPerPackage = tracker.getDurationPerPackageByDayAndHour(
+                startTimestamp = start,
+                endTimestamp = now,
+                usageIntervalsByPackage = usageIntervals
+            )
+            val totalByDay = tracker.getTotalDurationByDayAndHour(
+                startTimestamp = start,
+                endTimestamp = now,
+                usageIntervalsByPackage = usageIntervals
+            )
+
+            val nameCache = HashMap<String, String>()
+            totalByDay.forEach { (dayStart, hourlyDurations) ->
+                val totalDuration = hourlyDurations.sum()
+                val existing = dao.getDayTotal(dayStart)
+                val isToday = dayStart == today
+
+                // Never replace an existing historical value with a lower one: the system
+                // event log is finite and uninstalling an app removes its events.
+                if (!isToday && existing != null && totalDuration <= existing) {
+                    return@forEach
+                }
+                if (!isToday && existing == null && totalDuration <= 0L) {
+                    return@forEach
+                }
+
+                val apps = durationsPerPackage.mapNotNull { (packageName, durationsByDay) ->
+                    val duration = durationsByDay[dayStart]?.sum() ?: 0L
+                    if (duration <= 0L) {
+                        null
+                    } else {
+                        val appName = nameCache.getOrPut(packageName) {
+                            context.packageManager.getApplicationName(packageName) ?: packageName
+                        }
+                        AppUsageEntry(packageName, appName, duration)
+                    }
+                }
+
+                dao.replaceDay(
+                    dayStart = dayStart,
+                    totalDuration = totalDuration,
+                    hourlyDurations = hourlyDurations,
+                    apps = apps,
+                    updatedAt = now
+                )
+            }
+
+            lastRefreshAt = now
+            true
+        }
+    }
+
+    override suspend fun getDayTotals(startDay: Long, endDay: Long): Map<Long, Long> =
+        withContext(Dispatchers.IO) { dao.getDayTotals(startDay, endDay) }
+
+    override suspend fun getHourlyTotals(startDay: Long, endDay: Long): Map<Long, LongArray> =
+        withContext(Dispatchers.IO) { dao.getHourlyTotals(startDay, endDay) }
+
+    override suspend fun getAppTotals(startDay: Long, endDay: Long, limit: Int): List<AppUsageTotal> =
+        withContext(Dispatchers.IO) { dao.getAppTotals(startDay, endDay, limit) }
+
+    override suspend fun getEarliestDay(): Long? =
+        withContext(Dispatchers.IO) { dao.getEarliestDay() }
+
+    override suspend fun getLastUpdated(): Long? =
+        withContext(Dispatchers.IO) { dao.getLastUpdated() }
+
+    companion object {
+        private const val MIN_REFRESH_INTERVAL_MS = 15L * 60L * 1000L
+        private const val MIN_SCAN_DAYS = 2
+        private const val MILLIS_IN_A_DAY = 24L * 60L * 60L * 1000L
+    }
+}
