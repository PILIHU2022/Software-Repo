diff --git a/app/src/test/java/nodomain/freeyourgadget/gadgetbridge/util/activity/ActivitySummaryCalculatorTest.kt b/app/src/test/java/nodomain/freeyourgadget/gadgetbridge/util/activity/ActivitySummaryCalculatorTest.kt
new file mode 100644
index 0000000..f9e48ab
--- /dev/null
+++ b/app/src/test/java/nodomain/freeyourgadget/gadgetbridge/util/activity/ActivitySummaryCalculatorTest.kt
@@ -0,0 +1,127 @@
+package nodomain.freeyourgadget.gadgetbridge.util.activity
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDate
+
+class ActivitySummaryCalculatorTest {
+
+    @Test
+    fun monthlySummaryUsesRecordedDaysForTheAverage() {
+        val steps = mapOf(
+            LocalDate.of(2026, 11, 1) to 1_000,
+            LocalDate.of(2026, 11, 2) to 0,
+            LocalDate.of(2026, 11, 3) to 3_000,
+            LocalDate.of(2026, 11, 30) to 0,
+        )
+
+        val summary = ActivitySummaryCalculator.calculate(
+            period = ActivitySummaryPeriod.MONTH,
+            anchor = LocalDate.of(2026, 11, 15),
+            today = LocalDate.of(2026, 11, 30),
+            goal = 2_000,
+            stepsByDate = steps,
+        )
+
+        assertEquals(30, summary.days.size)
+        assertEquals(2, summary.recordedDays)
+        assertEquals(4_000L, summary.totalSteps)
+        assertEquals(2_000, summary.averageSteps)
+        assertEquals(133, summary.averagePerElapsedDay)
+        assertEquals(1, summary.goalDays)
+        assertEquals(LocalDate.of(2026, 11, 3), summary.bestDay?.date)
+        assertEquals(
+            listOf(LocalDate.of(2026, 11, 3), LocalDate.of(2026, 11, 1)),
+            summary.leaderboard.map { it.date },
+        )
+    }
+
+    @Test
+    fun yearlySummaryGroupsEveryMonth() {
+        val steps = mapOf(
+            LocalDate.of(2026, 1, 1) to 500,
+            LocalDate.of(2026, 1, 2) to 1_500,
+            LocalDate.of(2026, 2, 1) to 1_000,
+            LocalDate.of(2026, 12, 31) to 2_000,
+        )
+
+        val summary = ActivitySummaryCalculator.calculate(
+            period = ActivitySummaryPeriod.YEAR,
+            anchor = LocalDate.of(2026, 6, 15),
+            today = LocalDate.of(2026, 12, 31),
+            goal = 1_500,
+            stepsByDate = steps,
+        )
+
+        assertEquals(365, summary.days.size)
+        assertEquals(12, summary.months.size)
+        assertEquals(4, summary.recordedDays)
+        assertEquals(5_000L, summary.totalSteps)
+        assertEquals(1_250, summary.averageSteps)
+
+        val january = summary.months.first { it.month.monthValue == 1 }
+        assertEquals(2_000L, january.totalSteps)
+        assertEquals(2, january.recordedDays)
+        assertEquals(1_000, january.averageSteps)
+        assertEquals(1, january.goalDays)
+
+        val december = summary.months.first { it.month.monthValue == 12 }
+        assertEquals(2_000L, december.totalSteps)
+        assertEquals(1, december.recordedDays)
+    }
+
+    @Test
+    fun daysAfterTodayAreNotCounted() {
+        val summary = ActivitySummaryCalculator.calculate(
+            period = ActivitySummaryPeriod.MONTH,
+            anchor = LocalDate.of(2026, 11, 1),
+            today = LocalDate.of(2026, 11, 10),
+            goal = 0,
+            stepsByDate = mapOf(LocalDate.of(2026, 11, 20) to 5_000),
+        )
+
+        assertEquals(10, summary.days.size)
+        assertEquals(0L, summary.totalSteps)
+        assertTrue(summary.isEmpty)
+        assertNull(summary.bestDay)
+        assertTrue(summary.leaderboard.isEmpty())
+    }
+
+    @Test
+    fun leaderboardBreaksTiesByEarliestDay() {
+        val summary = ActivitySummaryCalculator.calculate(
+            period = ActivitySummaryPeriod.MONTH,
+            anchor = LocalDate.of(2026, 11, 1),
+            today = LocalDate.of(2026, 11, 30),
+            goal = 0,
+            stepsByDate = mapOf(
+                LocalDate.of(2026, 11, 2) to 1_000,
+                LocalDate.of(2026, 11, 1) to 1_000,
+            ),
+        )
+
+        assertEquals(LocalDate.of(2026, 11, 1), summary.bestDay?.date)
+        assertEquals(LocalDate.of(2026, 11, 1), summary.leaderboard.first().date)
+    }
+
+    @Test
+    fun leaderboardIsCappedAtTenDays() {
+        val steps = (1..12).associate { day ->
+            LocalDate.of(2026, 11, day) to day * 100
+        }
+
+        val summary = ActivitySummaryCalculator.calculate(
+            period = ActivitySummaryPeriod.MONTH,
+            anchor = LocalDate.of(2026, 11, 1),
+            today = LocalDate.of(2026, 11, 30),
+            goal = 0,
+            stepsByDate = steps,
+        )
+
+        assertEquals(ActivitySummaryCalculator.LEADERBOARD_SIZE, summary.leaderboard.size)
+        assertEquals(1_200, summary.leaderboard.first().steps)
+        assertEquals(300, summary.leaderboard.last().steps)
+    }
+}
