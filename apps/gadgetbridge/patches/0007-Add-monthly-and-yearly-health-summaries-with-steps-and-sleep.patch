+private fun sleepBarsFor(summary: SleepSummary): List<SummaryBar> =
+    when (summary.period) {
+        ActivitySummaryPeriod.MONTH -> {
+            val byDate = summary.nights.associateBy { it.date }
+            val best = summary.nights.maxOfOrNull { it.asleepMinutes } ?: 0
+            (0 until summary.elapsedDays).map { offset ->
+                val date = summary.start.plusDays(offset.toLong())
+                val minutes = byDate[date]?.asleepMinutes ?: 0
+                SummaryBar(
+                    value = minutes.toLong(),
+                    label = if (date.dayOfMonth == 1 || date.dayOfMonth % 7 == 0) {
+                        date.dayOfMonth.toString()
+                    } else {
+                        ""
+                    },
+                    highlight = best > 0 && minutes == best,
+                )
+            }
+        }
+
+        ActivitySummaryPeriod.YEAR -> {
+            val best = summary.months.maxOfOrNull { it.averageAsleepMinutes } ?: 0
+            summary.months.map { month ->
+                SummaryBar(
+                    value = month.averageAsleepMinutes.toLong(),
+                    label = month.month.monthValue.toString(),
+                    highlight = best > 0 && month.averageAsleepMinutes == best,
+                )
+            }
+        }
+    }
+
+@Composable
+private fun bestDayText(summary: ActivitySummary, locale: Locale): String {
+    val best = summary.bestDay ?: return stringResource(R.string.activity_summary_no_best_day)
+    return stringResource(
+        R.string.activity_summary_best_day,
+        formatDay(best.date, locale),
+        formatSteps(best.steps.toLong()),
+    )
+}
+
+private fun periodLabel(
+    period: ActivitySummaryPeriod,
+    anchor: LocalDate,
+    locale: Locale,
+): String = when (period) {
+    ActivitySummaryPeriod.MONTH -> formatMonth(YearMonth.from(anchor), locale)
+    ActivitySummaryPeriod.YEAR -> anchor.year.toString()
+}
+
+private fun formatMonth(month: YearMonth, locale: Locale): String {
+    val pattern = DateFormat.getBestDateTimePattern(locale, "yMMMM")
+    return month.atDay(1).format(DateTimeFormatter.ofPattern(pattern, locale))
+}
+
+private fun formatDay(date: LocalDate, locale: Locale): String {
+    val pattern = DateFormat.getBestDateTimePattern(locale, "MMMd")
+    return date.format(DateTimeFormatter.ofPattern(pattern, locale))
+}
+
+private fun formatSteps(steps: Long): String =
+    NumberFormat.getIntegerInstance().format(steps)
