+private data class SummaryBar(
+    val value: Long,
+    val label: String,
+    val highlight: Boolean,
+)
+
+private fun barsFor(summary: ActivitySummary): List<SummaryBar> =
+    when (summary.period) {
+        ActivitySummaryPeriod.MONTH -> {
+            val best = summary.days.maxOfOrNull { it.steps } ?: 0
+            summary.days.map { day ->
+                SummaryBar(
+                    value = day.steps.toLong(),
+                    label = if (day.date.dayOfMonth == 1 || day.date.dayOfMonth % 7 == 0) {
+                        day.date.dayOfMonth.toString()
+                    } else {
+                        ""
+                    },
+                    highlight = best > 0 && day.steps == best,
+                )
+            }
+        }
+
+        ActivitySummaryPeriod.YEAR -> {
+            val best = summary.months.maxOfOrNull { it.totalSteps } ?: 0L
+            summary.months.map { month ->
+                SummaryBar(
+                    value = month.totalSteps,
+                    label = month.month.monthValue.toString(),
+                    highlight = best > 0 && month.totalSteps == best,
+                )
+            }
+        }
+    }
+
