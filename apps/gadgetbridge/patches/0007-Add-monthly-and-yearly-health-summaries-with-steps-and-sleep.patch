+        }
+    }
+}
+
+@Composable
+private fun SummaryGrid(
+    summary: ActivitySummary,
+    locale: Locale,
+) {
+    Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+        Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+            SummaryMetricCard(
+                value = formatSteps(summary.totalSteps),
+                label = stringResource(R.string.activity_summary_total_steps),
+                supporting = bestDayText(summary, locale),
+                modifier = Modifier.weight(1f),
+            )
+            SummaryMetricCard(
+                value = formatSteps(summary.averageSteps.toLong()),
+                label = stringResource(R.string.activity_summary_average_steps),
+                supporting = stringResource(
+                    R.string.activity_summary_average_hint,
+                    summary.recordedDays,
+                ),
+                modifier = Modifier.weight(1f),
+            )
+        }
+        Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+            SummaryMetricCard(
+                value = formatSteps(summary.recordedDays.toLong()),
+                label = stringResource(R.string.activity_summary_recorded_days),
+                supporting = stringResource(
+                    R.string.activity_summary_recorded_days_hint,
+                    summary.recordedDays,
+                    summary.days.size,
+                ),
+                modifier = Modifier.weight(1f),
+            )
+            SummaryMetricCard(
+                value = formatSteps(summary.goalDays.toLong()),
+                label = stringResource(R.string.activity_summary_goal_days),
+                supporting = if (summary.goal > 0) {
+                    stringResource(
+                        R.string.activity_summary_goal_days_hint,
+                        summary.goalDays,
+                        summary.days.size,
+                        formatSteps(summary.goal.toLong()),
+                    )
+                } else {
+                    stringResource(R.string.activity_summary_goal_days_no_goal)
+                },
+                modifier = Modifier.weight(1f),
+            )
+        }
+        Text(
+            text = stringResource(
+                R.string.activity_summary_calendar_average,
+                formatSteps(summary.averagePerElapsedDay.toLong()),
+                summary.days.size,
+            ),
+            modifier = Modifier.padding(horizontal = 4.dp),
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+    }
+}
