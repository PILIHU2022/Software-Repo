+/**
+ * The monthly and yearly activity and sleep summary.
+ *
+ * The period is loaded in the background. Changing the month/year, switching between month and
+ * year, or tapping refresh starts a new load, so the screen never reads the database on the main
+ * thread.
+ */
+@Composable
+fun ActivitySummaryScreen(
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val repository = remember { ActivitySummaryRepository() }
+    val sleepRepository = remember { SleepSummaryRepository() }
+    val locale = Locale.getDefault()
+
+    var period by remember { mutableStateOf(ActivitySummaryPeriod.MONTH) }
+    var anchor by remember { mutableStateOf(LocalDate.now()) }
+    var reloadKey by remember { mutableIntStateOf(0) }
+    var uiState by remember { mutableStateOf<SummaryUiState>(SummaryUiState.Loading) }
+    var sleepState by remember { mutableStateOf<SleepUiState>(SleepUiState.Loading) }
+
+    LaunchedEffect(period, anchor, reloadKey) {
+        uiState = SummaryUiState.Loading
+        uiState = try {
+            SummaryUiState.Ready(repository.load(period, anchor))
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            SummaryUiState.Failure(e.message ?: e.toString())
+        }
+    }
+
+    LaunchedEffect(period, anchor, reloadKey) {
+        sleepState = SleepUiState.Loading
+        sleepState = try {
+            SleepUiState.Ready(sleepRepository.load(period, anchor))
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            SleepUiState.Failure(e.message ?: e.toString())
+        }
+    }
+
+    val today = LocalDate.now()
+    val canGoNext = when (period) {
+        ActivitySummaryPeriod.MONTH -> YearMonth.from(anchor).isBefore(YearMonth.from(today))
+        ActivitySummaryPeriod.YEAR -> anchor.year < today.year
+    }
+
+    GbExpressiveScaffold(
+        title = stringResource(R.string.activity_summary_title),
+        subtitle = periodLabel(period, anchor, locale),
+        modifier = modifier,
+        navigationIcon = {
+            IconButton(onClick = onBack) {
+                Icon(
+                    imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                    contentDescription = stringResource(R.string.compose_settings_navigate_up),
+                )
+            }
+        },
+        actions = {
+            IconButton(onClick = { reloadKey++ }) {
+                Icon(
+                    imageVector = Icons.Filled.Refresh,
+                    contentDescription = stringResource(R.string.activity_summary_refresh),
+                )
+            }
+        },
+    ) { innerPadding ->
+        LazyColumn(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(innerPadding),
+            contentPadding = PaddingValues(start = 16.dp, end = 16.dp, top = 8.dp, bottom = 32.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            item {
+                PeriodTypeSelector(
+                    period = period,
+                    onPeriodChange = { period = it },
+                )
+            }
+            item {
+                PeriodNavigator(
+                    period = period,
+                    anchor = anchor,
+                    canGoNext = canGoNext,
+                    locale = locale,
+                    onPrevious = {
+                        anchor = when (period) {
+                            ActivitySummaryPeriod.MONTH -> anchor.minusMonths(1)
+                            ActivitySummaryPeriod.YEAR -> anchor.minusYears(1)
+                        }
+                    },
+                    onNext = {
+                        anchor = when (period) {
+                            ActivitySummaryPeriod.MONTH -> anchor.plusMonths(1)
+                            ActivitySummaryPeriod.YEAR -> anchor.plusYears(1)
+                        }
+                    },
+                )
+            }
+
+            when (val state = uiState) {
+                SummaryUiState.Loading -> item {
+                    Box(
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .padding(vertical = 48.dp),
+                        contentAlignment = Alignment.Center,
+                    ) {
+                        GbLoadingIndicator()
+                    }
+                }
+
+                is SummaryUiState.Failure -> item {
+                    FailureCard(
+                        message = state.message,
+                        onRetry = { reloadKey++ },
+                    )
+                }
+
+                is SummaryUiState.Ready -> {
+                    val summary = state.summary
+                    if (summary.isEmpty) {
+                        item { EmptyCard() }
+                    } else {
+                        item { SummaryGrid(summary = summary, locale = locale) }
+                        item {
+                            StepsChartCard(
+                                summary = summary,
+                                onOpenMonth = { month ->
+                                    anchor = month.atDay(1)
+                                    period = ActivitySummaryPeriod.MONTH
+                                },
+                            )
+                        }
+                    }
+                }
+            }
+
+            item {
+                GbSectionTitle(stringResource(R.string.sleep_summary_section))
+            }
+            item {
+                SleepSummarySection(
+                    state = sleepState,
+                    onRetry = { reloadKey++ },
+                    onOpenMonth = { month ->
+                        anchor = month.atDay(1)
+                        period = ActivitySummaryPeriod.MONTH
+                    },
+                )
+            }
+        }
+    }
+}
