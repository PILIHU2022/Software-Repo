+private sealed interface SummaryUiState {
+    data object Loading : SummaryUiState
+
+    data class Ready(val summary: ActivitySummary) : SummaryUiState
+
+    data class Failure(val message: String) : SummaryUiState
+}
+
+private sealed interface SleepUiState {
+    data object Loading : SleepUiState
+
+    data class Ready(val summary: SleepSummary) : SleepUiState
+
+    data class Failure(val message: String) : SleepUiState
+}
