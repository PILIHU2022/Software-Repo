+package nodomain.freeyourgadget.gadgetbridge.util.sleep
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import nodomain.freeyourgadget.gadgetbridge.GBApplication
+import nodomain.freeyourgadget.gadgetbridge.model.ActivityUser
+import nodomain.freeyourgadget.gadgetbridge.util.activity.ActivitySummaryCalculator
+import nodomain.freeyourgadget.gadgetbridge.util.activity.ActivitySummaryPeriod
+import org.slf4j.LoggerFactory
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+
+/**
+ * Reads the recorded sleep sessions and their scores, and hands per-night records to
+ * [SleepSummaryCalculator].
+ *
+ * A session belongs to the day it ends on. When several devices recorded the same night, the
+ * device with the longest sleep is used, so wearing two watches does not double the night. The
+ * score prefers the device's own score; when it has none and the user enabled the age-based
+ * estimate, the estimate is used instead.
+ */
+class SleepSummaryRepository {
+
+    suspend fun load(
+        period: ActivitySummaryPeriod,
+        anchor: LocalDate,
+    ): SleepSummary = withContext(Dispatchers.IO) {
+        val zone = ZoneId.systemDefault()
+        val today = LocalDate.now(zone)
+        val (start, endExclusive) = ActivitySummaryCalculator.bounds(period, anchor)
+        val lastIncluded = minOf(endExclusive, today.plusDays(1))
+        val nights = readNights(start, lastIncluded, zone)
+        val goal = runCatching { ActivityUser().sleepDurationGoal }.getOrDefault(0)
+
+        SleepSummaryCalculator.calculate(
+            period = period,
+            anchor = anchor,
+            today = today,
+            goalMinutes = goal,
+            nights = nights,
+        )
+    }
+
+    private fun readNights(
+        start: LocalDate,
+        endExclusive: LocalDate,
+        zone: ZoneId,
+    ): List<NightSleep> {
+        if (!start.isBefore(endExclusive)) {
+            return emptyList()
+        }
+
+        val devices = GBApplication.app().deviceManager.devices
+            .filter { it.deviceCoordinator.supportsSleepMeasurement(it) }
+        if (devices.isEmpty()) {
+            return emptyList()
+        }
+
+        val db = GBApplication.acquireDB()
+        try {
+            val age = AgeSleepScore.getAge()
+            val estimateEnabled = AgeSleepScore.isEnabled()
+            val fromSeconds = start.minusDays(1).atStartOfDay(zone).toEpochSecond().toInt() - 1
+            val toSeconds = endExclusive.atStartOfDay(zone).toEpochSecond().toInt() - 1
+            val scoreFromMillis = start.minusDays(2).atStartOfDay(zone).toInstant().toEpochMilli()
+            val scoreToMillis = endExclusive.plusDays(1).atStartOfDay(zone).toInstant().toEpochMilli()
+            val nights = HashMap<LocalDate, NightSleep>()
+
+            for (device in devices) {
+                val sessions = try {
+                    device.deviceCoordinator.getSleepSessionProvider(device, db.daoSession)
+                        .getSleepSessionsEndingIn(fromSeconds, toSeconds)
+                } catch (e: Exception) {
+                    LOG.warn("Could not read the sleep sessions of {}", device.name, e)
+                    continue
+                }
+                if (sessions.isEmpty()) {
+                    continue
+                }
+
+                val scoreSamples = try {
+                    device.deviceCoordinator.getSleepScoreProvider(device, db.daoSession)
+                        ?.getAllSamples(scoreFromMillis, scoreToMillis)
+                        .orEmpty()
+                        .filter { it.sleepScore > 0 }
+                } catch (e: Exception) {
+                    LOG.warn("Could not read the sleep scores of {}", device.name, e)
+                    emptyList()
+                }
+
+                val sessionsByDate = sessions.groupBy {
+                    Instant.ofEpochMilli(it.endTime).atZone(zone).toLocalDate()
+                }
+                for ((date, daySessions) in sessionsByDate) {
+                    if (date.isBefore(start) || !date.isBefore(endExclusive)) {
+                        continue
+                    }
+
+                    val asleepSeconds = daySessions.sumOf { it.totalSleepDuration.coerceAtLeast(0) }
+                    if (asleepSeconds <= 0) {
+                        continue
+                    }
+                    val inBedSeconds = daySessions.sumOf {
+                        (it.endTime - it.startTime).coerceAtLeast(0) / 1000
+                    }
+                    val deepSeconds = daySessions.sumOf { it.deepSleepDuration.coerceAtLeast(0) }
+                    val remSeconds = daySessions.sumOf { it.remSleepDuration.coerceAtLeast(0) }
+                    val awakeSeconds = daySessions.sumOf { it.awakeSleepDuration.coerceAtLeast(0) }
+
+                    val startMillis = daySessions.minOf { it.startTime }
+                    val endMillis = daySessions.maxOf { it.endTime }
+                    val nativeScore = scoreSamples
+                        .filter {
+                            it.timestamp >= startMillis - SCORE_MARGIN_MILLIS &&
+                                it.timestamp <= endMillis + SCORE_MARGIN_MILLIS
+                        }
+                        .maxByOrNull { it.timestamp }
+                        ?.sleepScore
+                        ?.takeIf { it > 0 }
+                    val estimatedScore = if (nativeScore == null && estimateEnabled) {
+                        runCatching {
+                            AgeSleepScoreCalculator.calculate(age, daySessions).score
+                        }.getOrDefault(0).takeIf { it > 0 }
+                    } else {
+                        null
+                    }
+
+                    val night = NightSleep(
+                        date = date,
+                        asleepMinutes = (asleepSeconds / 60).toInt(),
+                        timeInBedMinutes = (inBedSeconds / 60).toInt(),
+                        awakeMinutes = (awakeSeconds / 60).toInt(),
+                        deepMinutes = (deepSeconds / 60).toInt(),
+                        remMinutes = (remSeconds / 60).toInt(),
+                        score = nativeScore ?: estimatedScore,
+                    )
+                    val existing = nights[date]
+                    if (existing == null || night.asleepMinutes > existing.asleepMinutes) {
+                        nights[date] = night
+                    }
+                }
+            }
+
+            return nights.values.sortedBy { it.date }
+        } finally {
+            db.release()
+        }
+    }
+
+    companion object {
+        private val LOG = LoggerFactory.getLogger(SleepSummaryRepository::class.java)
+
+        /** A score may be stored slightly before bedtime or after wake-up. */
+        private const val SCORE_MARGIN_MILLIS = 60L * 60L * 1000L
+    }
+}
