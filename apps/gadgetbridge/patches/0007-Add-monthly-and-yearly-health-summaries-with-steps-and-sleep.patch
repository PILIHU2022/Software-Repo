+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .fillMaxHeight(bar.value.toFloat() / max)
+                            .clip(RoundedCornerShape(topStart = 3.dp, topEnd = 3.dp))
+                            .background(
+                                color = if (bar.highlight) {
+                                    MaterialTheme.colorScheme.tertiary
