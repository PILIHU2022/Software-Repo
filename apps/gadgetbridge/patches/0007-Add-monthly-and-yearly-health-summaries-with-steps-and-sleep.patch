+@Composable
+private fun formatSleepDuration(minutes: Int): String {
+    val hours = minutes / 60
+    val rest = minutes % 60
+    return if (hours > 0) {
+        stringResource(R.string.sleep_summary_duration_hours_minutes, hours, rest)
+    } else {
+        stringResource(R.string.sleep_summary_duration_minutes, rest)
+    }
