+        assertEquals(85, summary.averageScore)
+        assertEquals(89, summary.averageEfficiencyPercent)
+        assertEquals(20, summary.averageDeepSharePercent)
+        assertEquals(16, summary.averageRemSharePercent)
+        assertEquals(2, summary.goalNights)
+        assertEquals(LocalDate.of(2026, 11, 2), summary.bestNight?.date)
+        assertEquals(
+            listOf(
+                LocalDate.of(2026, 11, 2),
+                LocalDate.of(2026, 11, 1),
