+package nodomain.freeyourgadget.gadgetbridge.util.activity
+
+import java.time.LocalDate
+import java.time.YearMonth
+
+/**
+ * The aggregation window of an [ActivitySummary].
+ */
+enum class ActivitySummaryPeriod {
+    MONTH,
+    YEAR,
+}
+
+/**
+ * The steps recorded on one calendar day.
+ */
+data class DailySteps(
+    val date: LocalDate,
+    val steps: Int,
+) {
+    val hasSteps: Boolean
+        get() = steps > 0
+}
+
+/**
+ * The totals of one month, used by the yearly view.
+ */
+data class MonthSteps(
+    val month: YearMonth,
+    val days: List<DailySteps>,
+    val recordedDays: Int,
+    val totalSteps: Long,
+    val averageSteps: Int,
+    val goalDays: Int,
+)
+
+/**
+ * A fully calculated monthly or yearly activity summary.
+ *
+ * [averageSteps] averages only the days that recorded steps, so a missing sync does not pull the
+ * average down as if the user had walked nothing. [averagePerElapsedDay] is the calendar average,
+ * over every day of the period that has already passed, and is kept for the supporting text.
+ */
+data class ActivitySummary(
+    val period: ActivitySummaryPeriod,
+    val anchor: LocalDate,
+    val start: LocalDate,
+    val endExclusive: LocalDate,
+    val days: List<DailySteps>,
+    val recordedDays: Int,
+    val totalSteps: Long,
+    val averageSteps: Int,
+    val averagePerElapsedDay: Int,
+    val goal: Int,
+    val goalDays: Int,
+    val bestDay: DailySteps?,
+    val leaderboard: List<DailySteps>,
+    val months: List<MonthSteps>,
+) {
+    val isEmpty: Boolean
+        get() = totalSteps == 0L
+}
+
+/**
+ * Turns per-day step totals into the monthly and yearly summaries the screen shows.
+ *
+ * The calculator is deliberately free of Android and database dependencies, so the averages, the
+ * goal count and the leaderboard ordering can be tested without a device or a database.
+ */
+object ActivitySummaryCalculator {
+    /** How many days the daily leaderboard shows. */
+    const val LEADERBOARD_SIZE = 10
+
+    /**
+     * The half-open date range [start, endExclusive) of [period] that contains [anchor].
+     */
+    fun bounds(period: ActivitySummaryPeriod, anchor: LocalDate): Pair<LocalDate, LocalDate> =
+        when (period) {
+            ActivitySummaryPeriod.MONTH -> {
+                val month = YearMonth.from(anchor)
+                month.atDay(1) to month.plusMonths(1).atDay(1)
+            }
+
+            ActivitySummaryPeriod.YEAR ->
+                LocalDate.of(anchor.year, 1, 1) to LocalDate.of(anchor.year + 1, 1, 1)
+        }
+
+    /**
+     * Builds the summary of [period] around [anchor], using [today] to exclude days that have not
+     * happened yet. [stepsByDate] may contain days outside the period; they are ignored.
+     */
+    fun calculate(
+        period: ActivitySummaryPeriod,
+        anchor: LocalDate,
+        today: LocalDate,
+        goal: Int,
+        stepsByDate: Map<LocalDate, Int>,
+    ): ActivitySummary {
+        val (start, endExclusive) = bounds(period, anchor)
+        val lastIncluded = minOf(endExclusive, today.plusDays(1))
+
+        val days = buildList {
+            var date = start
+            while (date.isBefore(lastIncluded)) {
+                add(DailySteps(date, (stepsByDate[date] ?: 0).coerceAtLeast(0)))
+                date = date.plusDays(1)
+            }
+        }
+        val recorded = days.filter { it.hasSteps }
+        val totalSteps = days.sumOf { it.steps.toLong() }
+        val safeGoal = goal.coerceAtLeast(0)
+        val goalDays = if (safeGoal > 0) days.count { it.steps >= safeGoal } else 0
+
+        // Highest first, earliest day first when two days tie.
+        val leaderboard = recorded
+            .sortedWith(compareByDescending<DailySteps> { it.steps }.thenBy { it.date })
+            .take(LEADERBOARD_SIZE)
+
+        val byMonth = days.groupBy { YearMonth.from(it.date) }
+        val months = if (period == ActivitySummaryPeriod.YEAR) {
+            (1..12).map { monthNumber ->
+                val month = YearMonth.of(anchor.year, monthNumber)
+                monthSteps(month, byMonth[month].orEmpty(), safeGoal)
+            }
+        } else {
+            emptyList()
+        }
+
+        return ActivitySummary(
+            period = period,
+            anchor = anchor,
+            start = start,
+            endExclusive = endExclusive,
+            days = days,
+            recordedDays = recorded.size,
+            totalSteps = totalSteps,
+            averageSteps = if (recorded.isEmpty()) 0 else (totalSteps / recorded.size).toInt(),
+            averagePerElapsedDay = if (days.isEmpty()) 0 else (totalSteps / days.size).toInt(),
+            goal = safeGoal,
+            goalDays = goalDays,
+            bestDay = recorded.maxWithOrNull(
+                compareBy<DailySteps> { it.steps }.thenByDescending { it.date },
+            ),
+            leaderboard = leaderboard,
+            months = months,
+        )
+    }
+
+    private fun monthSteps(
+        month: YearMonth,
+        days: List<DailySteps>,
+        goal: Int,
+    ): MonthSteps {
+        val recorded = days.filter { it.hasSteps }
+        val total = days.sumOf { it.steps.toLong() }
+        return MonthSteps(
+            month = month,
+            days = days,
+            recordedDays = recorded.size,
+            totalSteps = total,
+            averageSteps = if (recorded.isEmpty()) 0 else (total / recorded.size).toInt(),
+            goalDays = if (goal > 0) days.count { it.steps >= goal } else 0,
+        )
+    }
+}
