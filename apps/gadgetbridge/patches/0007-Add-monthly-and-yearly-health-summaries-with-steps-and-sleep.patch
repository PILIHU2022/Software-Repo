+package nodomain.freeyourgadget.gadgetbridge.util.sleep
+
+import nodomain.freeyourgadget.gadgetbridge.util.activity.ActivitySummaryCalculator
+import nodomain.freeyourgadget.gadgetbridge.util.activity.ActivitySummaryPeriod
+import java.time.LocalDate
+import java.time.YearMonth
+import kotlin.math.roundToInt
+
+/**
+ * The quality band of a sleep score. The bands are only labels; the score itself is always kept.
+ */
+enum class SleepQuality {
+    EXCELLENT,
+    GOOD,
+    FAIR,
+    POOR,
+    UNKNOWN,
+}
+
+/**
+ * One night of sleep, attributed to the day it ended on.
+ */
+data class NightSleep(
+    val date: LocalDate,
+    val asleepMinutes: Int,
+    val timeInBedMinutes: Int,
+    val awakeMinutes: Int,
+    val deepMinutes: Int,
+    val remMinutes: Int,
+    val score: Int?,
+) {
+    val efficiencyPercent: Int
+        get() = percentage(asleepMinutes.toLong(), timeInBedMinutes.toLong())
+
+    val deepSharePercent: Int
+        get() = percentage(deepMinutes.toLong(), asleepMinutes.toLong())
+
+    val remSharePercent: Int
+        get() = percentage(remMinutes.toLong(), asleepMinutes.toLong())
+
+    val quality: SleepQuality
+        get() {
+            val value = score ?: return SleepQuality.UNKNOWN
+            return when {
+                value <= 0 -> SleepQuality.UNKNOWN
+                value >= 85 -> SleepQuality.EXCELLENT
+                value >= 70 -> SleepQuality.GOOD
+                value >= 50 -> SleepQuality.FAIR
+                else -> SleepQuality.POOR
+            }
+        }
+}
+
+/**
+ * The sleep totals of one month, used by the yearly view.
+ */
+data class MonthSleep(
+    val month: YearMonth,
+    val nights: List<NightSleep>,
+    val averageAsleepMinutes: Int,
+    val averageScore: Int?,
+    val goalNights: Int,
+)
+
+/**
+ * A fully calculated monthly or yearly sleep summary.
+ *
+ * Averages are aggregate ratios: the average efficiency is total asleep time divided by total
+ * time in bed, and the deep/REM shares divide the summed stage durations by the summed sleep
+ * duration. This is more stable than averaging per-night percentages when one night is very short.
+ */
+data class SleepSummary(
+    val period: ActivitySummaryPeriod,
+    val anchor: LocalDate,
+    val start: LocalDate,
+    val endExclusive: LocalDate,
+    val elapsedDays: Int,
+    val nights: List<NightSleep>,
+    val totalAsleepMinutes: Long,
+    val averageAsleepMinutes: Int,
+    val averageScore: Int?,
+    val averageEfficiencyPercent: Int,
+    val averageDeepSharePercent: Int,
+    val averageRemSharePercent: Int,
+    val goalMinutes: Int,
+    val goalNights: Int,
+    val bestNight: NightSleep?,
+    val leaderboard: List<NightSleep>,
+    val months: List<MonthSleep>,
+) {
+    val isEmpty: Boolean
+        get() = nights.isEmpty()
+}
+
+/**
+ * Turns per-night sleep records into the monthly and yearly summaries the screen shows.
+ *
+ * Like [ActivitySummaryCalculator], this object has no Android or database dependency, so the
+ * averages, the goal count and the ranking can be tested without a device.
+ */
+object SleepSummaryCalculator {
+    /** How many nights the quality leaderboard shows. */
+    const val LEADERBOARD_SIZE = 10
+
+    fun calculate(
+        period: ActivitySummaryPeriod,
+        anchor: LocalDate,
+        today: LocalDate,
+        goalMinutes: Int,
+        nights: List<NightSleep>,
+    ): SleepSummary {
+        val (start, endExclusive) = ActivitySummaryCalculator.bounds(period, anchor)
+        val lastIncluded = minOf(endExclusive, today.plusDays(1))
+        val inPeriod = nights
+            .filter { !it.date.isBefore(start) && it.date.isBefore(lastIncluded) }
+            .sortedBy { it.date }
+
+        val totalAsleep = inPeriod.sumOf { it.asleepMinutes.toLong() }
+        val totalInBed = inPeriod.sumOf { it.timeInBedMinutes.toLong() }
+        val totalDeep = inPeriod.sumOf { it.deepMinutes.toLong() }
+        val totalRem = inPeriod.sumOf { it.remMinutes.toLong() }
+        val safeGoal = goalMinutes.coerceAtLeast(0)
+        val goalNights = if (safeGoal > 0) {
+            inPeriod.count { it.asleepMinutes >= safeGoal }
+        } else {
+            0
+        }
+
+        // Score first; unscored nights follow by duration instead of being dropped.
+        val leaderboard = inPeriod
+            .sortedWith(
+                compareByDescending<NightSleep> { it.score ?: -1 }
+                    .thenByDescending { it.asleepMinutes }
+                    .thenBy { it.date },
+            )
+            .take(LEADERBOARD_SIZE)
+
+        val elapsedDays = java.time.temporal.ChronoUnit.DAYS
+            .between(start, minOf(endExclusive, today.plusDays(1)))
+            .toInt()
+            .coerceAtLeast(0)
+        val byMonth = inPeriod.groupBy { YearMonth.from(it.date) }
+        val months = if (period == ActivitySummaryPeriod.YEAR) {
+            (1..12).map { monthNumber ->
+                val month = YearMonth.of(anchor.year, monthNumber)
+                monthSleep(month, byMonth[month].orEmpty(), safeGoal)
+            }
+        } else {
+            emptyList()
+        }
+
+        return SleepSummary(
+            period = period,
+            anchor = anchor,
+            start = start,
+            endExclusive = endExclusive,
+            elapsedDays = elapsedDays,
+            nights = inPeriod,
+            totalAsleepMinutes = totalAsleep,
+            averageAsleepMinutes = if (inPeriod.isEmpty()) {
+                0
+            } else {
+                (totalAsleep / inPeriod.size).toInt()
+            },
+            averageScore = averageScore(inPeriod),
+            averageEfficiencyPercent = percentage(totalAsleep, totalInBed),
+            averageDeepSharePercent = percentage(totalDeep, totalAsleep),
+            averageRemSharePercent = percentage(totalRem, totalAsleep),
+            goalMinutes = safeGoal,
+            goalNights = goalNights,
+            bestNight = leaderboard.firstOrNull(),
+            leaderboard = leaderboard,
+            months = months,
+        )
+    }
+
+    private fun monthSleep(
+        month: YearMonth,
+        nights: List<NightSleep>,
+        goal: Int,
+    ): MonthSleep {
+        val total = nights.sumOf { it.asleepMinutes.toLong() }
+        return MonthSleep(
+            month = month,
+            nights = nights,
+            averageAsleepMinutes = if (nights.isEmpty()) 0 else (total / nights.size).toInt(),
+            averageScore = averageScore(nights),
+            goalNights = if (goal > 0) nights.count { it.asleepMinutes >= goal } else 0,
+        )
+    }
+
+    private fun averageScore(nights: List<NightSleep>): Int? {
+        val scored = nights.filter { (it.score ?: 0) > 0 }
+        if (scored.isEmpty()) {
+            return null
+        }
+        return (scored.sumOf { it.score ?: 0 }.toDouble() / scored.size).roundToInt()
+    }
+
+    private fun percentage(part: Long, total: Long): Int =
+        if (total <= 0) 0 else ((part * 100) / total).toInt().coerceIn(0, 100)
+}
