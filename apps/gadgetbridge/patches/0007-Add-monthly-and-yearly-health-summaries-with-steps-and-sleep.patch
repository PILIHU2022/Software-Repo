+@Composable
+private fun StepsBars(bars: List<SummaryBar>) {
+    val max = bars.maxOfOrNull { it.value }?.coerceAtLeast(1L) ?: 1L
+
+    Column {
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .height(140.dp),
