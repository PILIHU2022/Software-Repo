+@Composable
+private fun PeriodTypeSelector(
+    period: ActivitySummaryPeriod,
+    onPeriodChange: (ActivitySummaryPeriod) -> Unit,
+) {
+    SingleChoiceSegmentedButtonRow(modifier = Modifier.fillMaxWidth()) {
+        ActivitySummaryPeriod.entries.forEachIndexed { index, candidate ->
+            SegmentedButton(
+                selected = period == candidate,
+                onClick = { onPeriodChange(candidate) },
+                shape = SegmentedButtonDefaults.itemShape(
+                    index = index,
+                    count = ActivitySummaryPeriod.entries.size,
+                ),
+                modifier = Modifier.weight(1f),
+                label = {
+                    Text(
+                        text = stringResource(
+                            when (candidate) {
+                                ActivitySummaryPeriod.MONTH -> R.string.activity_summary_month
+                                ActivitySummaryPeriod.YEAR -> R.string.activity_summary_year
+                            },
+                        ),
+                        style = MaterialTheme.typography.labelLarge,
+                    )
+                },
+            )
+        }
+    }
+}
+
+@Composable
+private fun PeriodNavigator(
+    period: ActivitySummaryPeriod,
+    anchor: LocalDate,
+    canGoNext: Boolean,
