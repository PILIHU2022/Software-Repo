+package nodomain.freeyourgadget.gadgetbridge.util.activity
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import nodomain.freeyourgadget.gadgetbridge.GBApplication
+import nodomain.freeyourgadget.gadgetbridge.model.ActivityUser
+import nodomain.freeyourgadget.gadgetbridge.model.DailyTotals
+import org.slf4j.LoggerFactory
+import java.time.LocalDate
+import java.time.ZoneId
+import java.util.Calendar
+import java.util.TimeZone
+
+/**
+ * Reads the per-day step totals of the paired devices and hands them to
+ * [ActivitySummaryCalculator].
+ *
+ * Gadgetbridge already has the per-day aggregation in [DailyTotals], including the provider
+ * specific handling of counters that reset at midnight, so the repository asks it once per day
+ * instead of re-implementing the sample arithmetic. When several devices recorded the same day,
+ * the largest total is used: two watches on the same wrist must not double the step count.
+ */
+class ActivitySummaryRepository {
+
+    suspend fun load(
+        period: ActivitySummaryPeriod,
+        anchor: LocalDate,
+    ): ActivitySummary = withContext(Dispatchers.IO) {
+        val zone = ZoneId.systemDefault()
+        val today = LocalDate.now(zone)
+        val (start, endExclusive) = ActivitySummaryCalculator.bounds(period, anchor)
+        val lastIncluded = minOf(endExclusive, today.plusDays(1))
+        val stepsByDate = readDailySteps(start, lastIncluded, zone)
+        val goal = runCatching { ActivityUser().stepsGoal }.getOrDefault(0)
+
+        ActivitySummaryCalculator.calculate(
+            period = period,
+            anchor = anchor,
+            today = today,
+            goal = goal,
+            stepsByDate = stepsByDate,
+        )
+    }
+
+    private fun readDailySteps(
+        start: LocalDate,
+        endExclusive: LocalDate,
+        zone: ZoneId,
+    ): Map<LocalDate, Int> {
+        if (!start.isBefore(endExclusive)) {
+            return emptyMap()
+        }
+
+        val devices = GBApplication.app().deviceManager.devices
+        if (devices.isEmpty()) {
+            return emptyMap()
+        }
+
+        val db = GBApplication.acquireDB()
+        try {
+            val calendar = Calendar.getInstance(TimeZone.getTimeZone(zone.id))
+            // A device that cannot report activity is dropped after its first failure instead of
+            // throwing for every one of the 365 days of a yearly summary.
+            val readableDevices = devices.toMutableList()
+            val result = LinkedHashMap<LocalDate, Int>()
+            var date = start
+            while (date.isBefore(endExclusive)) {
+                val dayMillis = date.atStartOfDay(zone).toInstant().toEpochMilli()
+                var daySteps = 0
+                val iterator = readableDevices.iterator()
+                while (iterator.hasNext()) {
+                    calendar.timeInMillis = dayMillis
+                    val device = iterator.next()
+                    val deviceSteps = try {
+                        DailyTotals.getDailyTotalsForDevice(device, calendar, db).steps.toInt()
+                    } catch (e: Exception) {
+                        LOG.warn(
+                            "Device {} cannot provide daily activity totals; skipping it",
+                            device.name,
+                            e,
+                        )
+                        iterator.remove()
+                        0
+                    }
+                    if (deviceSteps > daySteps) {
+                        daySteps = deviceSteps
+                    }
+                }
+                result[date] = daySteps
+                date = date.plusDays(1)
+            }
+            return result
+        } finally {
+            db.release()
+        }
+    }
+
+    companion object {
+        private val LOG = LoggerFactory.getLogger(ActivitySummaryRepository::class.java)
+    }
+}
