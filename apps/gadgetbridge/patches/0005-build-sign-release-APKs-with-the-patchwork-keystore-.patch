From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DeepSeek Harness <noreply@deepseek.com>
Date: Sat, 21 Nov 2026 15:46:28 +0800
Subject: [PATCH] build: sign release APKs with the patchwork keystore from the
 environment

Upstream only signs the nightly builds; the release build is left unsigned for
F-Droid to sign. This overlay publishes its own release APK, so honour
PATCHWORK_SIGN_KEYSTORE and friends when they are set. Without them the build
behaves exactly like upstream.
---
 app/build.gradle | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/app/build.gradle b/app/build.gradle
index 55dfa13cf2..f243ce50c7 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -172,6 +172,20 @@ android {
         getByName("release") {
             minifyEnabled = true
             proguardFiles(getDefaultProguardFile("proguard-android-optimize.txt"), "proguard-rules.pro")
+
+            // Upstream leaves the release build unsigned and only signs the nightly
+            // builds, while this patchwork build publishes the release APK under its
+            // own key. The keystore comes from the environment so no secret is stored
+            // in the tree, and an upstream build without them stays unsigned.
+            final def patchworkKeystore = System.getenv("PATCHWORK_SIGN_KEYSTORE")
+            if (patchworkKeystore != null && !patchworkKeystore.isEmpty()) {
+                signingConfig = signingConfigs.create("patchwork") {
+                    storeFile = file(patchworkKeystore)
+                    storePassword = System.getenv("PATCHWORK_SIGN_STORE_PASSWORD")
+                    keyAlias = System.getenv("PATCHWORK_SIGN_KEY_ALIAS")
+                    keyPassword = System.getenv("PATCHWORK_SIGN_KEY_PASSWORD")
+                }
+            }
         }
 
         final def nightlySigning = nightlyStoreFile.isPresent()
