+package nodomain.freeyourgadget.gadgetbridge.ui.compose.components
+
+import androidx.compose.foundation.layout.BoxWithConstraints
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.asPaddingValues
+import androidx.compose.foundation.layout.heightIn
+import androidx.compose.foundation.layout.statusBars
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+
+/** Room kept between the top edge of a sheet and the bottom edge of the status bar. */
+private val SHEET_TOP_GAP = 16.dp
+
+/** Room reserved above the body for the drag handle, so it is never pushed out of the window. */
+private val SHEET_DRAG_HANDLE = 40.dp
+
+/** A sheet body never gets shorter than this, however small the window is. */
+private val SHEET_MIN_BODY = 160.dp
+
+/**
+ * Hands [content] a modifier that caps the height of a bottom sheet body so that the sheet stops
+ * below the status bar instead of reaching it.
+ *
+ * A Material 3 bottom sheet grows until its content fills the window, which on a phone with a
+ * punch-hole camera puts the drag handle and the rounded top edge right over the camera and reads
+ * as a broken layout. Capping the body instead keeps the sheet's top edge under the status bar, so
+ * the status bar and the camera stay visible above it, and the body scrolls when it is taller.
+ *
+ * The available height is the one the sheet itself was measured with, so this works for a sheet
+ * opened from any screen and on any window size, and the check happens again on rotation.
+ */
+@Composable
+fun GbSheetBody(
+    modifier: Modifier = Modifier,
+    content: @Composable (Modifier) -> Unit,
+) {
+    BoxWithConstraints {
+        val statusBar = WindowInsets.statusBars.asPaddingValues().calculateTopPadding()
+        val cap = (maxHeight - statusBar - SHEET_TOP_GAP - SHEET_DRAG_HANDLE)
+            .coerceAtLeast(SHEET_MIN_BODY)
+        content(modifier.heightIn(max = cap))
+    }
+}
