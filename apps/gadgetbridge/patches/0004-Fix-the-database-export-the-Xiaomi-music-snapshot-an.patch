+/**
+ * A process-wide revision counter for the Compose settings renderer.
+ *
+ * The renderer re-reads the preference tree when the [android.content.SharedPreferences] of the screen change, but
+ * some summaries are replaced at runtime without writing a preference: a worker finishes, a background export
+ * updates its status, a dialog changes a summary programmatically. AndroidX [androidx.preference.Preference] only
+ * notifies its own (package private) listeners, so such changes never reach Compose and the visible row keeps showing
+ * the old text until the screen is recreated.
+ *
+ * Code that updates a summary after the screen was composed calls [notifyChanged]; [PrefsSettingsScreen] observes
+ * [revision] and rebuilds its model. Call it on the main thread, where the preference itself was changed.
+ */
+object PrefsRefresh {
+    /** Bumped whenever a preference's rendered state may have changed outside of SharedPreferences. */
+    var revision by mutableIntStateOf(0)
+        private set
+
