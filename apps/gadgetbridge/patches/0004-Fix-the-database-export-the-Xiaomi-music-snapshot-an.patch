+    /**
+     * Fails when the exported database is empty, truncated or does not start with the SQLite file
+     * header ("SQLite format 3\0"). A silent, empty or half written database is worse than no
+     * export at all.
+     */
+    @Throws(IOException::class)
+    private fun validateExportedDatabase(file: File) {
+        if (!file.isFile) {
+            throw IOException("Exported database does not exist: ${file.absolutePath}")
+        }
+        if (file.length() <= 0L) {
+            throw IOException("Exported database is empty: ${file.absolutePath}")
+        }
+
+        val header = ByteArray(SQLITE_HEADER_SIZE)
+        FileInputStream(file).use { input ->
+            var read = 0
+            while (read < header.size) {
+                val count = input.read(header, read, header.size - read)
+                if (count < 0) {
+                    break
+                }
+                read += count
+            }
+            if (read != header.size) {
+                throw IOException("Exported database is too short, got $read header bytes")
+            }
+        }
+
+        if (!header.contentEquals(SQLITE_HEADER)) {
+            throw IOException("Exported database does not have a valid SQLite header")
+        }
+    }
+
+    /**
+     * Copies the validated temporary database into the configured target.
+     *
+     * A tree URI is a directory, so a new timestamped document is created inside it. Anything else
+     * is a single document that was picked with ACTION_CREATE_DOCUMENT and is overwritten in place
+     * (mode "wt" so that the previous content is truncated while writing).
+     */
+    @Throws(IOException::class)
+    private fun writeToDestination(dst: Uri, source: File) {
+        if (DocumentsContract.isTreeUri(dst)) {
+            val parentUri = DocumentsContract.buildDocumentUriUsingTree(
+                dst,
+                DocumentsContract.getTreeDocumentId(dst)
+            )
+            val fileName = "Gadgetbridge-${SimpleDateFormat("yyyyMMddHHmmss", Locale.US).format(Date())}.db"
+            val createdUri = DocumentsContract.createDocument(
+                mContext.contentResolver,
+                parentUri,
+                DB_MIME_TYPE,
+                fileName
+            ) ?: throw IOException("The document provider did not create a document for $fileName")
+
+            try {
+                copyFileToUri(createdUri, source)
+            } catch (e: Exception) {
+                // Do not leave a truncated/corrupt database file in the user's directory.
+                try {
+                    DocumentsContract.deleteDocument(mContext.contentResolver, createdUri)
+                } catch (cleanup: Exception) {
+                    LOG.warn("Unable to delete the incomplete export document {}", createdUri, cleanup)
+                }
+                throw e
+            }
+        } else {
+            copyFileToUri(dst, source)
+        }
+    }
+
+    @Throws(IOException::class)
+    private fun copyFileToUri(uri: Uri, source: File) {
+        val outputStream = mContext.contentResolver.openOutputStream(uri, "wt")
+            ?: throw IOException("Unable to open $uri for writing")
+
+        outputStream.use { out ->
+            FileInputStream(source).use { input ->
+                val buffer = ByteArray(COPY_BUFFER_SIZE)
+                while (true) {
+                    val read = input.read(buffer)
+                    if (read < 0) {
+                        break
+                    }
+                    out.write(buffer, 0, read)
+                }
+            }
+            out.flush()
+        }
+    }
