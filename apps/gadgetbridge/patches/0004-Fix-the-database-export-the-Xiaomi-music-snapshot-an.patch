+package nodomain.freeyourgadget.gadgetbridge.util.sheets
+
+import android.view.View
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import com.google.android.material.bottomsheet.BottomSheetBehavior
+import com.google.android.material.bottomsheet.BottomSheetDialog
+import com.google.android.material.bottomsheet.BottomSheetDialogFragment
+
+/**
+ * Keeps the top edge of a Material bottom sheet below the status bar.
+ *
+ * A sheet without a height limit grows until its content fills the window, and with edge-to-edge
+ * windows that puts the drag handle and the rounded top edge over the status bar, right on top of a
+ * punch-hole camera. Limiting the behaviour to the window height minus the status bar leaves the
+ * status bar and the camera visible above the sheet; the sheet keeps anchoring at the bottom, so a
+ * tall body simply gets scrolled by the content inside it.
+ */
+object BottomSheetCapping {
+    /** Room kept between the top edge of the sheet and the bottom edge of the status bar. */
+    private const val TOP_GAP_DP = 16
+
+    /** Applies the limit to [sheet]. Call it after the dialog was shown, from `onStart` or a show listener. */
+    @JvmStatic
+    fun capBelowStatusBar(sheet: BottomSheetDialog) {
+        val behavior = sheet.behavior
+        val decor = sheet.window?.decorView ?: return
+        val gap = (TOP_GAP_DP * decor.resources.displayMetrics.density).toInt()
+
+        fun apply(statusBarTop: Int, windowHeight: Int) {
+            if (windowHeight <= 0) {
+                return
+            }
+            // Never cap so hard that the sheet becomes a sliver on a very short window.
+            val cap = (windowHeight - statusBarTop - gap).coerceAtLeast(windowHeight / 3)
+            if (behavior.maxHeight != cap) {
+                behavior.maxHeight = cap
+            }
+        }
+
+        decor.post { apply(insetsTop(decor), decor.height) }
+        ViewCompat.setOnApplyWindowInsetsListener(decor) { view, insets ->
+            apply(insets.getInsets(WindowInsetsCompat.Type.statusBars()).top, view.height)
+            insets
+        }
+        decor.requestApplyInsets()
+    }
+
+    /** Applies the limit to the dialog of a [BottomSheetDialogFragment]. */
+    @JvmStatic
+    fun capBelowStatusBar(sheet: BottomSheetDialogFragment) {
+        (sheet.dialog as? BottomSheetDialog)?.let { capBelowStatusBar(it) }
+    }
+
+    private fun insetsTop(view: View): Int =
+        ViewCompat.getRootWindowInsets(view)?.getInsets(WindowInsetsCompat.Type.statusBars())?.top ?: 0
+}
