+/**
+ * A [SeekBarPreference] as an inline Expressive slider.
+ *
+ * The slider keeps its own value while the thumb is dragged, then writes the final value through the preference, so
+ * its change listener and persistence still run once instead of on every frame.
+ */
+@Composable
+private fun PrefSliderRow(
+    row: PrefRow,
+    highlighted: Boolean,
+    bringIntoView: BringIntoViewRequester,
+    onValueChange: (Int) -> Unit,
+) {
+    val preference = row.preference as? SeekBarPreference ?: return
+    val min = preference.min
+    val max = preference.max
+    val safeMax = max.coerceAtLeast(min + 1)
+    val increment = preference.seekBarIncrement.takeIf { it > 0 } ?: 1
+    val adjustable = preference.isAdjustable && max > min
+    val current = remember(preference) { mutableIntStateOf(preference.value.coerceIn(min, safeMax)) }
+    LaunchedEffect(preference.value, min, max) {
+        current.intValue = preference.value.coerceIn(min, safeMax)
+    }
+    val highlightColor by animateColorAsState(
+        targetValue = if (highlighted) {
+            MaterialTheme.colorScheme.primaryContainer
+        } else {
+            Color.Transparent
+        },
+        animationSpec = MaterialTheme.motionScheme.defaultEffectsSpec(),
+        label = "prefs-slider-highlight",
+    )
+
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .background(highlightColor)
+            .alpha(if (row.enabled) 1f else DISABLED_ALPHA)
+            .let { if (highlighted) it.bringIntoViewRequester(bringIntoView) else it }
+            .padding(vertical = 4.dp),
+    ) {
+        GbSettingRow(
+            title = row.title,
+            supporting = row.summary,
+            leading = when {
+                row.icon != null -> ({ PrefIcon(row.icon) })
+                row.iconSpaceReserved -> ({ Spacer(Modifier.size(LEADING_ICON_SIZE)) })
+                else -> null
+            },
+            trailing = {
+                if (preference.showSeekBarValue) {
+                    Text(
+                        text = current.intValue.toString(),
+                        style = MaterialTheme.typography.labelLarge,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                }
+            },
+        )
+        Slider(
+            value = current.intValue.toFloat(),
+            onValueChange = { value ->
+                current.intValue = snapSliderValue(value, min, safeMax, increment)
+            },
+            valueRange = min.toFloat()..safeMax.toFloat(),
+            steps = 0,
+            enabled = row.enabled && preference.isEnabled && adjustable,
+            onValueChangeFinished = {
+                onValueChange(current.intValue)
+                // A change listener may reject the value, so the preference remains authoritative.
+                current.intValue = preference.value.coerceIn(min, safeMax)
+            },
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(horizontal = 16.dp)
+                .semantics {
+                    contentDescription = row.title
+                    stateDescription = current.intValue.toString()
+                },
+        )
+    }
+}
+
+private fun snapSliderValue(value: Float, min: Int, max: Int, increment: Int): Int {
+    val steps = ((value - min) / increment).roundToInt()
+    return (min + steps * increment).coerceIn(min, max)
+}
