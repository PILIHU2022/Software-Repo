+++ b/app/src/main/res/values-zh-rCN/strings_compose_settings.xml
@@ -0,0 +1,42 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Compose 设置界面的字符串：每次打开应用时运行的备份，以及关于界面。
+
+    每个 key 都以 compose_settings_ 为前缀，以便与这些 Compose 界面所替代的 View 界面的字符串区分开。
+    已经存在且已翻译的字符串（备份首选项的标题和摘要、保留选项、关于文本）直接复用 strings.xml，
+    不再在此处重复。
+
+    注意：原文件中的 compose_settings_about_license_url、compose_settings_about_website_url、
+    compose_settings_about_source_url 和 compose_settings_about_fdroid_url 标记为 translatable="false"，
+    因此未包含在此翻译文件中。
+-->
+<resources>
+
+    <!-- 打开应用时备份（ui/compose/screens/settings/OnOpenBackupSettingsScreen.kt） -->
+    <string name="compose_settings_backup_subtitle">每次 Gadgetbridge 启动时都会生成全新的备份</string>
+    <string name="compose_settings_backup_section_actions">手动操作</string>
+    <string name="compose_settings_backup_section_status">上次运行</string>
+    <string name="compose_settings_backup_retention_description">早于此保留期限的备份会在每次运行结束时删除</string>
+    <string name="compose_settings_backup_last_file">上次备份文件</string>
+    <string name="compose_settings_backup_default_folder">默认备份文件夹</string>
+    <string name="compose_settings_backup_clean_short">删除过期项</string>
+    <string name="compose_settings_backup_running">正在写入备份…</string>
+    <string name="compose_settings_backup_cleaning">正在删除过期的备份…</string>
+
+    <!-- 关于（ui/compose/screens/settings/AboutScreen.kt） -->
+    <string name="compose_settings_about_version_code">版本 %1$s (%2$d)</string>
+    <string name="compose_settings_about_copy_hint">轻触可复制版本、提交和构建变体</string>
+    <string name="compose_settings_about_build_details">版本：%1$s\n提交：%2$s\n构建变体：%3$s</string>
+    <string name="compose_settings_about_license_title">许可证</string>
+    <string name="compose_settings_about_license_body">Gadgetbridge 是自由开源软件，基于 GNU Affero 通用公共许可证第 3 版或更新版本发布。你可以自由使用、研究、分享和改进它，而你分发的每一个修改版本都必须采用相同的许可证。</string>
+    <string name="compose_settings_about_license_link">阅读 GNU AGPL v3 许可证</string>
+    <string name="compose_settings_about_links_title">链接</string>
+    <string name="compose_settings_about_website">网站</string>
+    <string name="compose_settings_about_source">源代码</string>
+    <string name="compose_settings_about_fdroid">F-Droid</string>
+    <string name="compose_settings_about_licenses_summary">Gadgetbridge 内置的第三方库</string>
+
+    <!-- 两个界面共用 -->
+    <string name="compose_settings_navigate_up">返回</string>
+    <string name="compose_settings_open_link">打开 %1$s</string>
+</resources>
