+/**
+ * When the last backup ran, how it went and which file it wrote.
+ */
+@Composable
+private fun BackupStatusCard(state: BackupUiState) {
+    val context = LocalContext.current
+    val statusText = statusText(context, state.lastResult)
+    val statusColor = statusColor(state.lastResult)
+
+    GbTonalCard(
+        containerColor = MaterialTheme.colorScheme.surfaceContainerHigh,
+        shape = MaterialTheme.shapes.largeIncreased,
+    ) {
+        Column {
+            GbSettingRow(
+                title = stringResource(R.string.backup_on_open_status),
+                supporting = statusText,
+                leading = {
+                    Icon(
+                        imageVector = Icons.Filled.Info,
+                        contentDescription = null,
+                        tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                },
+                trailing = {
+                    Icon(
+                        imageVector = Icons.Filled.Circle,
+                        contentDescription = null,
+                        tint = statusColor,
+                        modifier = Modifier.size(12.dp),
+                    )
+                },
+            )
+
+            BackupCardDivider()
+
+            GbSettingRow(
+                title = stringResource(R.string.backup_on_open_last_backup),
+                supporting = lastRunText(context, state.lastRun),
+                leading = {
+                    Icon(
+                        imageVector = Icons.Filled.AccessTime,
+                        contentDescription = null,
+                        tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                },
+            )
+
+            BackupCardDivider()
+
+            GbSettingRow(
+                title = stringResource(R.string.compose_settings_backup_last_file),
+                supporting = state.lastFile ?: stringResource(R.string.unknown),
+                leading = {
+                    Icon(
+                        imageVector = Icons.Filled.InsertDriveFile,
+                        contentDescription = null,
+                        tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                },
+            )
+        }
+    }
+}
+
+/**
+ * Where the backups go while the user did not pick a folder.
+ */
+@Composable
+private fun DefaultFolderCard(path: String) {
+    GbTonalCard(
+        containerColor = MaterialTheme.colorScheme.surfaceContainerHigh,
+        shape = MaterialTheme.shapes.largeIncreased,
+    ) {
+        GbSettingRow(
+            title = stringResource(R.string.compose_settings_backup_default_folder),
+            supporting = path,
+            leading = {
+                Icon(
+                    imageVector = Icons.Filled.Folder,
+                    contentDescription = null,
+                    tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            },
+        )
+    }
+}
+
+@Composable
+private fun BackupCardDivider() {
+    HorizontalDivider(
+        modifier = Modifier.padding(horizontal = 16.dp),
+        color = MaterialTheme.colorScheme.outlineVariant,
+    )
+}
+
+@Composable
+private fun RowTitle(icon: ImageVector, title: String) {
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+        Icon(
+            imageVector = icon,
+            contentDescription = null,
+            tint = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+        Text(
+            text = title,
+            style = MaterialTheme.typography.titleMedium,
+            color = MaterialTheme.colorScheme.onSurface,
+        )
+    }
+}
+
+/** Opacity of the rows that the enable switch turns off, the same the Material components use. */
+private const val DISABLED_ALPHA = 0.38f
+
+@StringRes
+private fun retentionLabelRes(days: Int): Int = when (days) {
+    3 -> R.string.backup_on_open_retention_3_days
+    7 -> R.string.backup_on_open_retention_7_days
+    14 -> R.string.backup_on_open_retention_14_days
+    else -> R.string.backup_on_open_retention_30_days
+}
+
+/**
+ * Everything the screen shows, read from [OnOpenBackupPrefs] so that the values stay the ones the runner
+ * and the launcher read.
+ */
+private data class BackupUiState(
+    val enabled: Boolean,
+    val locationSummary: String,
+    val defaultLocationPath: String,
+    val retentionDays: Int,
+    val lastRun: Long,
+    val lastResult: String?,
+    val lastFile: String?,
+)
+
+private fun readBackupState(context: Context): BackupUiState {
+    val location = OnOpenBackupPrefs.location()
+    val locationSummary = if (location == null) {
+        context.getString(R.string.pref_summary_backup_on_open_location_default)
+    } else {
+        try {
+            UriUtils.resolveLocationSummary(context, location)
+        } catch (e: Exception) {
+            LOG.warn("Failed to resolve the summary of the backup location {}", location, e)
+            location
+        }
+    }
+
+    val defaultLocationPath = try {
+        BackupStorages.defaultBackupDir().absolutePath
+    } catch (e: Exception) {
+        LOG.warn("Failed to resolve the default backup directory", e)
+        ""
+    }
+
+    return BackupUiState(
+        enabled = OnOpenBackupPrefs.isEnabled(),
+        locationSummary = locationSummary,
+        defaultLocationPath = defaultLocationPath,
+        retentionDays = OnOpenBackupPrefs.retentionDays(),
+        lastRun = OnOpenBackupPrefs.lastRun(),
+        lastResult = OnOpenBackupPrefs.lastResult(),
+        lastFile = OnOpenBackupPrefs.lastFile(),
+    )
+}
+
+private fun statusText(context: Context, lastResult: String?): String = when {
+    lastResult.isNullOrBlank() -> context.getString(R.string.unknown)
+    lastResult.equals(RESULT_OK, ignoreCase = true) -> context.getString(R.string.backup_on_open_status_ok)
+    else -> context.getString(R.string.backup_on_open_status_failed, lastResult)
+}
+
+@Composable
+private fun statusColor(lastResult: String?): Color = when {
+    lastResult.isNullOrBlank() -> MaterialTheme.colorScheme.outline
+    lastResult.equals(RESULT_OK, ignoreCase = true) -> MaterialTheme.colorScheme.primary
+    else -> MaterialTheme.colorScheme.error
+}
+
+private fun lastRunText(context: Context, lastRun: Long): String =
+    if (lastRun > 0L) formatDateWithDiff(context, Date(lastRun)) else context.getString(R.string.unknown)
+
+/**
+ * Formats a date together with the difference to the current time.
+ */
+private fun formatDateWithDiff(context: Context, date: Date): String {
+    val diffMillis = System.currentTimeMillis() - date.time
+    return if (diffMillis > 0) {
+        context.getString(
+            R.string.datetime_in_the_past,
+            DateTimeUtils.formatDateTime(date),
+            DateTimeUtils.formatDurationHoursMinutes(diffMillis, TimeUnit.MILLISECONDS),
+        )
+    } else {
+        context.getString(
+            R.string.datetime_in_the_future,
+            DateTimeUtils.formatDateTime(date),
+            DateTimeUtils.formatDurationHoursMinutes(-diffMillis, TimeUnit.MILLISECONDS),
+        )
+    }
+}
