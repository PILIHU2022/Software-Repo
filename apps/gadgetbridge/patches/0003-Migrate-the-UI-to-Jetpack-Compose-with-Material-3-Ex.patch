+package nodomain.freeyourgadget.gadgetbridge.activities
+
+import android.content.Intent
+import android.os.Bundle
+import nodomain.freeyourgadget.gadgetbridge.activities.licenses.LicensesActivity
+import nodomain.freeyourgadget.gadgetbridge.ui.compose.screens.settings.AboutScreen
+import nodomain.freeyourgadget.gadgetbridge.ui.compose.screens.settings.setComposeHandlesSystemBarInsets
+import nodomain.freeyourgadget.gadgetbridge.ui.compose.setGbComposeContent
+
+/**
+ * The about screen: the app and its build, the license, the links and the contributors.
+ *
+ * The screen is rendered entirely with Compose, and keeps the class name that the manifest and the navigation
+ * of the main screen refer to. Tapping the build card still copies the version and the commit to the clipboard,
+ * and the licenses are still opened in {@link LicensesActivity}.
+ */
+class AboutActivity : AbstractGBActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        // The Compose screen draws its own large top app bar, so the action bar of the theme would be a second one
+        supportActionBar?.hide()
+
+        setGbComposeContent {
+            AboutScreen(
+                onBack = { onBackPressedDispatcher.onBackPressed() },
+                onOpenLicenses = {
+                    startActivity(Intent(this@AboutActivity, LicensesActivity::class.java))
+                },
+            )
+        }
+
+        setComposeHandlesSystemBarInsets()
+    }
+}
