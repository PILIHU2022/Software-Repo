+/**
+ * A small coloured status dot with a label, for "connected / disconnected" style rows.
+ */
+@Composable
+fun GbStatusDot(
+    color: Color,
+    label: String,
+    modifier: Modifier = Modifier,
+) {
+    Row(
+        modifier = modifier,
+        verticalAlignment = Alignment.CenterVertically,
