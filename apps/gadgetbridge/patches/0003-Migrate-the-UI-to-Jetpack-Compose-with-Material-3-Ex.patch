+    GNU Affero General Public License for more details.
+
+    You should have received a copy of the GNU Affero General Public License
+    along with this program.  If not, see <https://www.gnu.org/licenses/>. */
+package nodomain.freeyourgadget.gadgetbridge.ui.compose.theme
+
+import android.content.res.Configuration
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.ExperimentalMaterial3ExpressiveApi
+import androidx.compose.material3.MaterialExpressiveTheme
+import androidx.compose.material3.MotionScheme
+import androidx.compose.material3.Shapes
+import androidx.compose.material3.Typography
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.platform.LocalConfiguration
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.unit.dp
+
+/**
+ * Gadgetbridge's Material 3 Expressive theme for Compose screens.
+ *
+ * The color scheme is derived from the Android theme that the hosting activity already applied, so Compose
+ * follows the user's theme, accent color, AMOLED black, contrasting surfaces and dynamic color. The motion
+ * scheme is the Expressive one, which gives the springy, overshooting transitions of Material 3 Expressive.
+ *
+ * Shimmering, morphing shapes of M3 Expressive come from [MaterialShapes] and are used by the components
+ * themselves, not configured here.
+ */
+@OptIn(ExperimentalMaterial3ExpressiveApi::class)
+@Composable
+fun GbExpressiveTheme(
+    content: @Composable () -> Unit,
+) {
+    val context = LocalContext.current
+    val configuration = LocalConfiguration.current
+    val dark = remember(configuration.uiMode, context) {
+        (configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
+    }
+    val colorScheme = remember(context, dark) { colorSchemeFromTheme(context, dark) }
+
+    MaterialExpressiveTheme(
+        colorScheme = colorScheme,
+        motionScheme = MotionScheme.expressive(),
+        shapes = GbExpressiveShapes,
+        typography = GbExpressiveTypography,
+        content = content,
+    )
+}
+
+/**
+ * M3 Expressive shapes: larger, softer corners than the baseline M3 scale, which is what gives the
+ * Expressive look its friendly character.
+ */
+@OptIn(ExperimentalMaterial3ExpressiveApi::class)
+val GbExpressiveShapes: Shapes = Shapes().let { base ->
+    base.copy(
+        extraSmall = RoundedCornerShape(6.dp),
+        small = RoundedCornerShape(10.dp),
+        medium = RoundedCornerShape(16.dp),
+        large = RoundedCornerShape(22.dp),
+        extraLarge = RoundedCornerShape(32.dp),
+        largeIncreased = RoundedCornerShape(26.dp),
+        extraLargeIncreased = RoundedCornerShape(40.dp),
+        extraExtraLarge = RoundedCornerShape(48.dp),
+    )
+}
+
+/**
+ * The expressive type scale: same metrics as baseline M3, with the heavier weights of Expressive emphasis.
+ */
+@OptIn(ExperimentalMaterial3ExpressiveApi::class)
+val GbExpressiveTypography: Typography = Typography().let { base ->
+    base.copy(
+        displayLarge = base.displayLarge.copy(fontWeight = androidx.compose.ui.text.font.FontWeight.Bold),
+        displayMedium = base.displayMedium.copy(fontWeight = androidx.compose.ui.text.font.FontWeight.Bold),
+        displaySmall = base.displaySmall.copy(fontWeight = androidx.compose.ui.text.font.FontWeight.Bold),
+        headlineLarge = base.headlineLarge.copy(fontWeight = androidx.compose.ui.text.font.FontWeight.SemiBold),
+        headlineMedium = base.headlineMedium.copy(fontWeight = androidx.compose.ui.text.font.FontWeight.SemiBold),
+        headlineSmall = base.headlineSmall.copy(fontWeight = androidx.compose.ui.text.font.FontWeight.SemiBold),
+        titleLarge = base.titleLarge.copy(fontWeight = androidx.compose.ui.text.font.FontWeight.SemiBold),
+    )
+}
diff --git a/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/util/backup/OnOpenBackupPrefs.kt b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/util/backup/OnOpenBackupPrefs.kt
index c3d87be1e9..df7b2ecf9e 100644
--- a/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/util/backup/OnOpenBackupPrefs.kt
+++ b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/util/backup/OnOpenBackupPrefs.kt
@@ -75,12 +75,22 @@ object OnOpenBackupPrefs {
 
     fun isEnabled(): Boolean = prefs().getBoolean(ENABLED, DEFAULT_ENABLED)
 
+    /** Stores whether the on-open backup runs, the switch of the settings screen. */
+    fun setEnabled(enabled: Boolean) {
+        prefs().preferences.edit().putBoolean(ENABLED, enabled).apply()
+    }
+
     fun location(): String? = prefs().getString(LOCATION, null)?.takeIf { it.isNotBlank() }
 
     fun setLocation(uri: String?) {
         prefs().preferences.edit().putString(LOCATION, uri).apply()
     }
 
+    /** Stores the retention in days, clamped to the range [retentionDays] reads back. */
+    fun setRetentionDays(days: Int) {
+        prefs().preferences.edit().putInt(RETENTION_DAYS, days.coerceIn(1, MAX_RETENTION_DAYS)).apply()
+    }
+
     fun retentionDays(): Int {
         val days = prefs().getInt(RETENTION_DAYS, DEFAULT_RETENTION_DAYS)
         return if (days in 1..MAX_RETENTION_DAYS) days else DEFAULT_RETENTION_DAYS
