--- /dev/null
+++ b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/ui/compose/theme/GbTheme.kt
@@ -0,0 +1,95 @@
+/*  Copyright (C) 2026 Gadgetbridge contributors
