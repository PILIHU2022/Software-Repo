+package nodomain.freeyourgadget.gadgetbridge.activities.welcome
+
+import android.content.Intent
+import android.os.Bundle
+import dagger.hilt.android.AndroidEntryPoint
+import nodomain.freeyourgadget.gadgetbridge.GBApplication
+import nodomain.freeyourgadget.gadgetbridge.activities.AbstractGBActivity
+import nodomain.freeyourgadget.gadgetbridge.activities.DataManagementActivity
+import nodomain.freeyourgadget.gadgetbridge.activities.discovery.DiscoveryActivityV2
+import nodomain.freeyourgadget.gadgetbridge.ui.compose.screens.welcome.WelcomeScreen
+import nodomain.freeyourgadget.gadgetbridge.ui.compose.setGbComposeContent
+import nodomain.freeyourgadget.gadgetbridge.util.backup.OnOpenBackupRunner
+
+/**
+ * The first run flow, hosted as one Jetpack Compose screen.
+ *
+ * The flow itself lives in `nodomain.freeyourgadget.gadgetbridge.ui.compose.screens.welcome`: the pages, the pager,
+ * the page indicator and the navigation are all Compose, in the Material 3 Expressive theme of the app. This
+ * activity only keeps the behaviour that has to stay an activity: it is the launcher entry of the first run, it
+ * backs up the database once per app open, and it dismisses itself as soon as a device has been added.
+ */
+@AndroidEntryPoint
+class WelcomeActivity : AbstractGBActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        // The Compose screen draws its own header, so the action bar stays hidden for the whole flow.
+        supportActionBar?.hide()
+
+        setGbComposeContent {
+            WelcomeScreen(
+                onFinish = { closeWelcome() },
+                onAddDevice = {
+                    startActivity(Intent(this, DiscoveryActivityV2::class.java))
+                    closeWelcome()
+                },
+                onRestoreBackup = {
+                    startActivity(Intent(this, DataManagementActivity::class.java))
+                },
+            )
+        }
+
+        // Back up the database and preferences once per app open, in the background. The welcome flow is shown
+        // before the launcher activity on first run, which must still back up.
+        OnOpenBackupRunner.triggerOnAppOpen(this)
+    }
+
+    override fun onResume() {
+        super.onResume()
+        val firstRun = GBApplication.getPrefs().getBoolean("first_run", true)
+        if (firstRun && GBApplication.app().deviceManager.devices.isNotEmpty()) {
+            // A device was added - dismiss the welcome screen
+            GBApplication.getPrefs().preferences.edit().putBoolean("first_run", false).apply()
+            finish()
+        }
+    }
+
+    /** Marks the first run as done and leaves the flow. */
+    private fun closeWelcome() {
+        GBApplication.getPrefs().preferences.edit().putBoolean("first_run", false).apply()
+        finish()
+    }
+}
