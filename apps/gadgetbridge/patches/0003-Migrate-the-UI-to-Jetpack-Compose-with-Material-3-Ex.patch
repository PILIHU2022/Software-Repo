+package nodomain.freeyourgadget.gadgetbridge.ui.compose.theme
+
+import android.content.Context
+import androidx.annotation.AttrRes
+import androidx.compose.material3.ColorScheme
+import androidx.compose.material3.darkColorScheme
+import androidx.compose.material3.lightColorScheme
+import androidx.compose.ui.graphics.Color
+import com.google.android.material.color.MaterialColors
+import androidx.appcompat.R as AppCompatR
+import com.google.android.material.R as MaterialR
+
+/**
+ * Resolves a theme attribute of [context] to a Compose [Color], falling back to [fallback] when the
+ * attribute is not set by the applied theme.
+ */
+private fun attrColor(context: Context, @AttrRes res: Int, fallback: Color): Color {
+    val argb = runCatching { MaterialColors.getColor(context, res, 0) }.getOrDefault(0)
+    return if (argb != 0) Color(argb) else fallback
+}
+
+/**
+ * Builds a Compose [ColorScheme] from the Android theme that is already applied to [context].
+ *
+ * Gadgetbridge styles its activities from the user's theme settings (theme, AMOLED black, accent color,
+ * contrasting surfaces, dynamic color) in XML. Reading the same theme attributes back keeps Compose screens
+ * identical to the View screens around them, including dynamic color and every accent palette, without
+ * duplicating the palette logic here.
+ *
+ * @param dark whether the applied theme is dark, which decides the fallbacks for attributes a theme does not set
+ */
+fun colorSchemeFromTheme(context: Context, dark: Boolean): ColorScheme {
+    val light = Color(0xFFFFFFFF)
+    val black = Color(0xFF000000)
+    val base = if (dark) darkColorScheme() else lightColorScheme()
+    val surfaceFallback = if (dark) Color(0xFF141218) else Color(0xFFFFF8F6)
+    val onSurfaceFallback = if (dark) Color(0xFFE6E0E9) else Color(0xFF1D1B20)
+    val primaryFallback = if (dark) Color(0xFFD0BCFF) else Color(0xFF6750A4)
+    val onPrimaryFallback = if (dark) Color(0xFF381E72) else light
+    val primaryContainerFallback = if (dark) Color(0xFF4F378B) else Color(0xFFEADDFF)
+    val onPrimaryContainerFallback = if (dark) Color(0xFFEADDFF) else Color(0xFF21005D)
+    val errorFallback = if (dark) Color(0xFFF2B8B5) else Color(0xFFB3261E)
+    val onErrorFallback = if (dark) Color(0xFF601410) else light
+    val errorContainerFallback = if (dark) Color(0xFF8C1D18) else Color(0xFFF9DEDC)
+    val onErrorContainerFallback = if (dark) Color(0xFFF9DEDC) else Color(0xFF410E0B)
+    val surfaceVariantFallback = if (dark) Color(0xFF49454F) else Color(0xFFE7E0EC)
+    val onSurfaceVariantFallback = if (dark) Color(0xFFCAC4D0) else Color(0xFF49454F)
+    val outlineFallback = if (dark) Color(0xFF938F99) else Color(0xFF79747E)
+
+    val primary = attrColor(context, AppCompatR.attr.colorPrimary, primaryFallback)
+    val onPrimary = attrColor(context, MaterialR.attr.colorOnPrimary, onPrimaryFallback)
+    val primaryContainer = attrColor(context, MaterialR.attr.colorPrimaryContainer, primaryContainerFallback)
+    val onPrimaryContainer = attrColor(context, MaterialR.attr.colorOnPrimaryContainer, onPrimaryContainerFallback)
+    val inversePrimary = attrColor(context, MaterialR.attr.colorPrimaryInverse, primary)
+
+    val secondary = attrColor(context, MaterialR.attr.colorSecondary, primary)
+    val onSecondary = attrColor(context, MaterialR.attr.colorOnSecondary, onPrimary)
+    val secondaryContainer = attrColor(context, MaterialR.attr.colorSecondaryContainer, primaryContainer)
+    val onSecondaryContainer = attrColor(context, MaterialR.attr.colorOnSecondaryContainer, onPrimaryContainer)
+
+    val tertiary = attrColor(context, MaterialR.attr.colorTertiary, primary)
+    val onTertiary = attrColor(context, MaterialR.attr.colorOnTertiary, onPrimary)
+    val tertiaryContainer = attrColor(context, MaterialR.attr.colorTertiaryContainer, primaryContainer)
+    val onTertiaryContainer = attrColor(context, MaterialR.attr.colorOnTertiaryContainer, onPrimaryContainer)
+
+    val error = attrColor(context, AppCompatR.attr.colorError, errorFallback)
+    val onError = attrColor(context, MaterialR.attr.colorOnError, onErrorFallback)
+    val errorContainer = attrColor(context, MaterialR.attr.colorErrorContainer, errorContainerFallback)
+    val onErrorContainer = attrColor(context, MaterialR.attr.colorOnErrorContainer, onErrorContainerFallback)
+
+    val background = attrColor(context, android.R.attr.colorBackground, surfaceFallback)
+    val onBackground = attrColor(context, MaterialR.attr.colorOnBackground, onSurfaceFallback)
+    val surface = attrColor(context, MaterialR.attr.colorSurface, surfaceFallback)
+    val onSurface = attrColor(context, MaterialR.attr.colorOnSurface, onSurfaceFallback)
+    val surfaceVariant = attrColor(context, MaterialR.attr.colorSurfaceVariant, surfaceVariantFallback)
+    val onSurfaceVariant = attrColor(context, MaterialR.attr.colorOnSurfaceVariant, onSurfaceVariantFallback)
+    val outline = attrColor(context, MaterialR.attr.colorOutline, outlineFallback)
+    val outlineVariant = attrColor(context, MaterialR.attr.colorOutlineVariant, outline)
+    val inverseSurface = attrColor(context, MaterialR.attr.colorSurfaceInverse, onSurface)
+    val inverseOnSurface = attrColor(context, MaterialR.attr.colorOnSurfaceInverse, surface)
+    val surfaceTint = attrColor(context, MaterialR.attr.colorPrimarySurface, primary)
+
+    return base.copy(
+        primary = primary,
+        onPrimary = onPrimary,
+        primaryContainer = primaryContainer,
+        onPrimaryContainer = onPrimaryContainer,
+        inversePrimary = inversePrimary,
+        secondary = secondary,
+        onSecondary = onSecondary,
+        secondaryContainer = secondaryContainer,
+        onSecondaryContainer = onSecondaryContainer,
+        tertiary = tertiary,
+        onTertiary = onTertiary,
+        tertiaryContainer = tertiaryContainer,
+        onTertiaryContainer = onTertiaryContainer,
+        background = background,
+        onBackground = onBackground,
+        surface = surface,
+        onSurface = onSurface,
+        surfaceVariant = surfaceVariant,
+        onSurfaceVariant = onSurfaceVariant,
+        surfaceTint = surfaceTint,
+        inverseSurface = inverseSurface,
+        inverseOnSurface = inverseOnSurface,
+        error = error,
+        onError = onError,
+        errorContainer = errorContainer,
+        onErrorContainer = onErrorContainer,
+        outline = outline,
+        outlineVariant = outlineVariant,
+        surfaceBright = attrColor(context, MaterialR.attr.colorSurfaceBright, surface),
+        surfaceDim = attrColor(context, MaterialR.attr.colorSurfaceDim, surface),
+        surfaceContainer = attrColor(context, MaterialR.attr.colorSurfaceContainer, surfaceVariant),
+        surfaceContainerHigh = attrColor(context, MaterialR.attr.colorSurfaceContainerHigh, surfaceVariant),
+        surfaceContainerHighest = attrColor(context, MaterialR.attr.colorSurfaceContainerHighest, surfaceVariant),
+        surfaceContainerLow = attrColor(context, MaterialR.attr.colorSurfaceContainerLow, surface),
+        surfaceContainerLowest = attrColor(context, MaterialR.attr.colorSurfaceContainerLowest, if (dark) black else light),
+    )
+}
diff --git a/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/ui/compose/theme/GbTheme.kt b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/ui/compose/theme/GbTheme.kt
