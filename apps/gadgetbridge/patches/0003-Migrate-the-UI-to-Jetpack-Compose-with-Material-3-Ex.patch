+private val LOG = LoggerFactory.getLogger("OnOpenBackupSettingsScreen")
+
+/** The retention the settings screen offers, matching {@code pref_backup_retention_values}. */
+private val RETENTION_OPTIONS = listOf(3, 7, 14, 30)
+
+/** The result [OnOpenBackupPrefs] stores after a successful backup. */
+private const val RESULT_OK = "ok"
+
+/**
+ * The settings of the backup that runs every time the app is opened, as a Material 3 Expressive screen.
+ *
+ * Every value is read from and written to [OnOpenBackupPrefs], and the manual actions go through
+ * [OnOpenBackupRunner], exactly like the preference screen this replaces did, so the feature behaves the same.
+ */
+@Composable
+fun OnOpenBackupSettingsScreen(
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val lifecycleOwner = LocalLifecycleOwner.current
+
+    var state by remember { mutableStateOf(readBackupState(context)) }
+    var running by remember { mutableStateOf(false) }
+    var cleaning by remember { mutableStateOf(false) }
+
+    fun refresh() {
+        state = readBackupState(context)
+    }
+
+    // The user may be coming back from the folder picker of another app, or from another screen
+    DisposableEffect(lifecycleOwner) {
+        val observer = LifecycleEventObserver { _, event ->
+            if (event == Lifecycle.Event.ON_RESUME) {
+                refresh()
+            }
+        }
+        lifecycleOwner.lifecycle.addObserver(observer)
+        onDispose { lifecycleOwner.lifecycle.removeObserver(observer) }
+    }
+
+    val folderPicker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocumentTree()) { uri ->
+        if (uri == null) {
+            LOG.error("Got no uri")
+            return@rememberLauncherForActivityResult
+        }
+
+        // Persist the read and write grant, so the backup can still write there after a restart. Some
+        // providers do not support persistable grants, the location is stored anyway so that the user
+        // does not lose the selection.
+        try {
+            context.contentResolver.takePersistableUriPermission(
+                uri,
+                Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_WRITE_URI_PERMISSION,
+            )
+        } catch (e: SecurityException) {
+            // Some tree providers grant write access without read access. Taking both flags then
+            // fails as a whole, so persist the write grant that the backup actually needs.
+            try {
+                context.contentResolver.takePersistableUriPermission(
+                    uri,
+                    Intent.FLAG_GRANT_WRITE_URI_PERMISSION,
+                )
+            } catch (writeError: SecurityException) {
+                LOG.warn("Failed to take the persistable uri permission for {}", uri, writeError)
+            }
+        }
+
+        OnOpenBackupPrefs.setLocation(uri.toString())
+        refresh()
+    }
+
+    fun runBackupNow() {
+        if (running) {
+            return
+        }
+        running = true
+
+        scope.launch {
+            // Writing a backup takes a while and must never block the main thread
+            val (success, message) = withContext(Dispatchers.IO) {
+                try {
+                    val result = OnOpenBackupRunner.runNow(context.applicationContext)
+                    if (result.success) {
+                        true to context.getString(R.string.backup_on_open_status_ok)
+                    } else {
+                        false to context.getString(R.string.backup_on_open_status_failed, result.message)
+                    }
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Exception) {
+                    LOG.error("Failed to run the on-open backup", e)
+                    false to context.getString(
+                        R.string.backup_on_open_status_failed,
+                        e.message ?: e.toString(),
+                    )
+                }
+            }
+
+            running = false
+            refresh()
+            GB.toast(context, message, Toast.LENGTH_LONG, if (success) GB.INFO else GB.ERROR)
+        }
+    }
+
+    fun deleteExpiredNow() {
+        if (cleaning) {
+            return
+        }
+        cleaning = true
+
+        scope.launch {
+            val outcome: Pair<Int, String?> = withContext(Dispatchers.IO) {
+                try {
+                    OnOpenBackupRunner.pruneNow(context.applicationContext) to null
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (e: Exception) {
+                    LOG.error("Failed to delete the expired on-open backups", e)
+                    -1 to (e.message ?: e.toString())
+                }
+            }
+
+            val deleted = outcome.first
+            val errorMessage = outcome.second
+
+            cleaning = false
+            refresh()
+
+            val message = if (deleted >= 0) {
+                context.getString(R.string.backup_on_open_deleted_count, deleted)
+            } else {
+                context.getString(
+                    R.string.backup_on_open_status_failed,
+                    errorMessage ?: context.getString(R.string.unknown),
+                )
+            }
+            GB.toast(context, message, Toast.LENGTH_LONG, if (deleted >= 0) GB.INFO else GB.ERROR)
+        }
+    }
+
+    GbExpressiveScaffold(
+        title = stringResource(R.string.pref_header_backup_on_open),
+        subtitle = stringResource(R.string.compose_settings_backup_subtitle),
+        modifier = modifier,
+        navigationIcon = {
+            IconButton(onClick = onBack) {
+                Icon(
+                    imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                    contentDescription = stringResource(R.string.compose_settings_navigate_up),
+                )
+            }
+        },
+    ) { innerPadding ->
+        LazyColumn(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(innerPadding),
+            contentPadding = PaddingValues(start = 16.dp, end = 16.dp, top = 8.dp, bottom = 32.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            item {
+                BackupPreferencesCard(
+                    state = state,
+                    onEnabledChange = {
+                        OnOpenBackupPrefs.setEnabled(it)
+                        refresh()
+                    },
+                    onPickFolder = { folderPicker.launch(null) },
+                    onRetentionChange = {
+                        OnOpenBackupPrefs.setRetentionDays(it)
+                        refresh()
+                    },
+                )
+            }
+
+            item { GbSectionTitle(stringResource(R.string.compose_settings_backup_section_actions)) }
+
+            item {
+                BackupActionsCard(
+                    running = running,
+                    cleaning = cleaning,
+                    onRunNow = { runBackupNow() },
+                    onCleanNow = { deleteExpiredNow() },
+                )
+            }
+
+            item { GbSectionTitle(stringResource(R.string.compose_settings_backup_section_status)) }
+
+            item { BackupStatusCard(state = state) }
+
+            item { DefaultFolderCard(path = state.defaultLocationPath) }
+        }
+    }
+}
