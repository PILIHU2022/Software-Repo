+
+/**
+ * One entry of the left navigation drawer.
+ *
+ * The entries are not declared here: they are read from `R.menu.activity_main_drawer`, which stays the single
+ * source of truth for the item ids, the titles and the icons. This class only carries what the Compose drawer
+ * needs to draw an entry and to hand it back to the activity.
+ */
+data class GbDrawerNavItem(
+    val itemId: Int,
+    val title: String,
+    val icon: Drawable,
+    val group: Int,
+)
+
+/**
+ * Called when a drawer entry is tapped, with the entry that was tapped.
+ */
+fun interface GbDrawerNavItemListener {
+    fun onItemSelected(item: GbDrawerNavItem)
+}
+
+/**
+ * Shows the Compose navigation drawer in this [ComposeView], hosted in an XML layout.
+ *
+ * The activity stays in charge of the [androidx.drawerlayout.widget.DrawerLayout]: it opens and closes this
+ * view, and it receives every tap as a [GbDrawerNavItem] so that it can dispatch it the way it always did.
+ */
+fun ComposeView.setGbNavigationDrawer(
+    items: List<GbDrawerNavItem>,
+    onItemSelected: GbDrawerNavItemListener,
+) {
+    setGbComposeContent {
+        GbNavigationDrawerScreen(items = items, onItemSelected = onItemSelected::onItemSelected)
+    }
+}
+
+/**
+ * The left navigation drawer, in the Material 3 Expressive style: a large, rounded tonal sheet that floats
+ * above the content, with a rounded icon container as its header and pill shaped entries.
+ *
+ * The sheet keeps the drawer semantics of a `ModalDrawerSheet`: it is flush with the start, top and bottom of
+ * the drawer, and only its end corners are rounded.
+ *
+ * The system bar insets are deliberately not applied here. The activity pads its content view with them, which
+ * already puts this drawer below the status bar and above the navigation bar, exactly like the app bar next to
+ * it. Applying them again in Compose would inset the drawer twice.
+ */
+@Composable
+fun GbNavigationDrawerScreen(
+    items: List<GbDrawerNavItem>,
+    onItemSelected: (GbDrawerNavItem) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    // The drawer is flush with the start edge, so only its end corners are rounded: that is what makes it
+    // read as a floating sheet instead of as a panel glued to the side of the screen.
+    val sheetShape = MaterialTheme.shapes.extraLarge.copy(
+        topStart = CornerSize(0.dp),
+        bottomStart = CornerSize(0.dp),
+    )
+
+    Surface(
+        modifier = modifier.fillMaxSize(),
+        shape = sheetShape,
+        color = MaterialTheme.colorScheme.surfaceContainerLow,
+        contentColor = MaterialTheme.colorScheme.onSurface,
+    ) {
+        Column(Modifier.fillMaxSize()) {
+            DrawerHeader()
+
+            HorizontalDivider(
+                modifier = Modifier.padding(horizontal = 20.dp),
+                color = MaterialTheme.colorScheme.outlineVariant,
+            )
+
+            Column(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1f)
+                    .verticalScroll(rememberScrollState())
+                    .padding(horizontal = 12.dp, vertical = 12.dp),
+            ) {
+                items.forEachIndexed { index, item ->
+                    if (index > 0 && items[index - 1].group != item.group) {
+                        HorizontalDivider(
+                            modifier = Modifier.padding(horizontal = 8.dp, vertical = 8.dp),
+                            color = MaterialTheme.colorScheme.outlineVariant,
+                        )
+                    }
+                    DrawerEntry(item = item, onItemSelected = onItemSelected)
+                }
+            }
+        }
+    }
+}
+
+/**
+ * The header of the drawer: the launcher icon in a round tonal container, and the application name.
+ *
+ * This is the Compose replacement of `main_drawer_header.xml`, so it keeps the same content, but it uses the
+ * theme colors instead of the drawer specific XML attributes, which only serve the old View drawer.
+ */
+@Composable
+private fun DrawerHeader() {
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(start = 24.dp, end = 24.dp, top = 20.dp, bottom = 20.dp),
+    ) {
+        Box(
+            modifier = Modifier
+                .size(64.dp)
+                .clip(CircleShape)
+                .background(MaterialTheme.colorScheme.primaryContainer),
+            contentAlignment = Alignment.Center,
+        ) {
+            Image(
+                painter = painterResource(R.drawable.ic_launcher),
+                contentDescription = null,
+                modifier = Modifier.size(56.dp),
+            )
+        }
+        Spacer(Modifier.height(16.dp))
+        Text(
+            text = stringResource(R.string.app_name),
+            style = MaterialTheme.typography.headlineSmall,
+            color = MaterialTheme.colorScheme.onSurface,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+        )
+    }
+}
+
+/**
+ * One drawer entry, drawn as a pill shaped [NavigationDrawerItem] that springs down slightly while pressed.
+ *
+ * Entries are never marked as selected: the drawer only navigates away, exactly like the XML menu did, and the
+ * activity keeps returning `false` from its navigation callback.
+ */
+@Composable
+private fun DrawerEntry(
+    item: GbDrawerNavItem,
+    onItemSelected: (GbDrawerNavItem) -> Unit,
+) {
+    val interactionSource = remember { MutableInteractionSource() }
+    val pressed by interactionSource.collectIsPressedAsState()
+    val pressScale by animateFloatAsState(
+        targetValue = if (pressed) 0.97f else 1f,
+        animationSpec = MaterialTheme.motionScheme.fastSpatialSpec<Float>(),
+        label = "drawerEntryPress",
+    )
+    val icon = remember(item.icon) { item.icon.toImageBitmap() }
+
+    NavigationDrawerItem(
+        label = {
+            Text(
+                text = item.title,
+                style = MaterialTheme.typography.titleMedium,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        },
+        selected = false,
+        onClick = { onItemSelected(item) },
+        modifier = Modifier
+            .fillMaxWidth()
+            .scale(pressScale)
+            .padding(vertical = 2.dp),
+        icon = {
+            Image(
+                bitmap = icon,
+                contentDescription = null,
+                modifier = Modifier.size(24.dp),
+                colorFilter = ColorFilter.tint(MaterialTheme.colorScheme.onSurfaceVariant),
+            )
+        },
+        colors = NavigationDrawerItemDefaults.colors(
+            unselectedContainerColor = Color.Transparent,
+            unselectedIconColor = MaterialTheme.colorScheme.onSurfaceVariant,
+            unselectedTextColor = MaterialTheme.colorScheme.onSurface,
+        ),
+        interactionSource = interactionSource,
+    )
+}
+
+/**
+ * Renders this [Drawable] into an [ImageBitmap] that the Compose drawer can tint like any other icon.
+ *
+ * A menu inflated from `R.menu.activity_main_drawer` only exposes its icons as [Drawable]s, without the id of
+ * the drawable resource, so the drawer keeps the menu as the only source of the icons and rasterizes them.
+ * The drawable is drawn at its intrinsic size, which is the size of the icon in dp, so it stays sharp.
+ */
+private fun Drawable.toImageBitmap(): ImageBitmap {
+    val width = intrinsicWidth.takeIf { it > 0 } ?: DEFAULT_ICON_PIXELS
+    val height = intrinsicHeight.takeIf { it > 0 } ?: DEFAULT_ICON_PIXELS
+    val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+    val bounds = bounds
+    setBounds(0, 0, width, height)
+    draw(Canvas(bitmap))
+    setBounds(bounds)
+    return bitmap.asImageBitmap()
+}
+
+/** Fallback size of a drawer icon whose drawable has no intrinsic size. */
+private const val DEFAULT_ICON_PIXELS = 72
