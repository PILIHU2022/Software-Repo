+/**
+ * The permissions step of the welcome flow. It behaves like the old
+ * [nodomain.freeyourgadget.gadgetbridge.activities.welcome.WelcomeFragmentPermissions]: it lists every permission
+ * that is available on this phone, ungranted ones first, and can request them one by one or all at once.
+ *
+ * The regular Android runtime permissions are requested with [rememberLauncherForActivityResult] in a single
+ * request. The special accesses (battery optimization, autostart, notification listener, ...) open their own
+ * system screen, so they are chained through [PermissionRequestQueue] and resumed when the activity comes back.
+ * Granting is never mandatory: every page can be left with the "skip"/"continue" controls.
+ */
+@Composable
+internal fun WelcomePermissionsPage(modifier: Modifier = Modifier) {
+    val context = LocalContext.current
+    val activity = remember(context) { context.findActivity() }
+    // Bumped whenever the grants may have changed, to re-read the permission state from the system.
+    var refreshKey by remember { mutableIntStateOf(0) }
+    // The special accesses that still have to be requested after the runtime request returns.
+    var pendingSpecialPermissions by remember { mutableStateOf(emptyList<GBPermission>()) }
+    // True from the first tap until the runtime, battery and special-access steps have been consumed.
+    var allPermissionsRequestPending by remember { mutableStateOf(false) }
+    // Set while the battery exemption screen is in front, so returning does not open it again.
+    var batteryRequestAttempted by remember { mutableStateOf(false) }
+    val requestQueue = remember { PermissionRequestQueue() }
+
+    val batteryOptimizationLauncher = rememberLauncherForActivityResult(
+        contract = ActivityResultContracts.StartActivityForResult(),
+    ) {
+        refreshKey++
+    }
+
+    fun requestBatteryOptimization(target: Activity): Boolean {
+        if (isBatteryOptimizationIgnored(context)) {
+            return false
+        }
+        val request = Intent(
+            Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS,
+            Uri.parse("package:${target.packageName}"),
+        )
+        if (runCatching { batteryOptimizationLauncher.launch(request) }.isSuccess) {
+            return true
+        }
+        val fallback = Intent(Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS)
+        return runCatching { batteryOptimizationLauncher.launch(fallback) }.isSuccess
+    }
+
+    fun startSpecialRequests(target: Activity, special: List<GBPermission>) {
+        val pending = special
+            .filterNot { it.isGranted(context) }
+            .filterNot { it.isBatteryOptimizationPermission() }
+        if (!batteryRequestAttempted && !isBatteryOptimizationIgnored(context)) {
+            pendingSpecialPermissions = pending
+            if (requestBatteryOptimization(target)) {
+                batteryRequestAttempted = true
+                return
+            }
+        }
+        batteryRequestAttempted = false
+        pendingSpecialPermissions = emptyList()
+        allPermissionsRequestPending = false
+        if (pending.isNotEmpty()) {
+            requestQueue.start(target, pending)
+        }
+    }
+
+    val runtimePermissionLauncher = rememberLauncherForActivityResult(
+        contract = ActivityResultContracts.RequestMultiplePermissions(),
+    ) {
+        refreshKey++
+    }
+
+    // The special accesses return to the activity, so the chain and the shown state are refreshed here.
+    LifecycleEventEffect(Lifecycle.Event.ON_RESUME) {
+        refreshKey++
+        activity?.let { target ->
+            if (allPermissionsRequestPending) {
+                startSpecialRequests(target, pendingSpecialPermissions)
+            } else {
+                batteryRequestAttempted = false
+                requestQueue.resume(target)
+            }
+        }
+    }
+
+    val available = remember(context) { GBPermission.entries.filter { it.isAvailable(context) } }
+    val sortedPermissions = remember(available, refreshKey) {
+        available.sortedWith(
+            compareBy<GBPermission> { it.isGranted(context) }
+                .thenBy { context.getString(it.title).lowercase() },
+        )
+    }
+    val batteryOptimizationGranted = remember(context, refreshKey) {
+        isBatteryOptimizationIgnored(context)
+    }
+    val allGranted = remember(sortedPermissions, refreshKey, batteryOptimizationGranted) {
+        batteryOptimizationGranted && sortedPermissions.all { it.isGranted(context) }
+    }
+
+    /** The runtime permissions to hand to the launcher; already granted ones are skipped by the system. */
+    fun runtimePermissionsOf(permissions: Collection<GBPermission>): List<String> = permissions
+        .filterNot { it.isRequestedAlone }
+        .flatMap { it.androidPermissions }
+        .filterNot { it == Manifest.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS }
+        .filterNot { it in PermissionsUtils.specialPermissions }
+        .distinct()
+
+    fun specialPermissionsOf(permissions: Collection<GBPermission>): List<GBPermission> = permissions
+        .filterNot { it.isGranted(context) }
+        .filterNot { it.isBatteryOptimizationPermission() }
+        .filter { it.isRequestedAlone }
+
+    WelcomePageContent(modifier) {
+        WelcomeHero(icon = Icons.Filled.Lock)
+        Text(
+            text = stringResource(R.string.first_start_permissions_title),
+            style = MaterialTheme.typography.headlineMedium,
+            color = MaterialTheme.colorScheme.onSurface,
+            textAlign = TextAlign.Center,
+        )
+        Text(
+            text = stringResource(R.string.first_start_permissions_desc),
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            textAlign = TextAlign.Center,
+        )
+        Text(
+            text = stringResource(R.string.compose_welcome_permissions_hint),
+            style = MaterialTheme.typography.labelMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            textAlign = TextAlign.Center,
+        )
+
+        if (allGranted) {
+            GbTonalCard(
+                containerColor = MaterialTheme.colorScheme.secondaryContainer,
+                contentColor = MaterialTheme.colorScheme.onSecondaryContainer,
+            ) {
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(16.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(12.dp),
+                ) {
+                    Icon(Icons.Filled.CheckCircle, contentDescription = null, modifier = Modifier.size(24.dp))
+                    Text(
+                        text = stringResource(R.string.compose_welcome_permissions_all_granted),
+                        style = MaterialTheme.typography.titleSmall,
+                    )
+                }
+            }
+        } else {
+            Button(
+                onClick = {
+                    val target = activity
+                    if (target != null) {
+                        val special = specialPermissionsOf(available)
+                        val runtime = runtimePermissionsOf(available)
+                        allPermissionsRequestPending = true
+                        batteryRequestAttempted = false
+                        pendingSpecialPermissions = special
+                        if (runtime.isNotEmpty()) {
+                            runtimePermissionLauncher.launch(runtime.toTypedArray())
+                        } else {
+                            startSpecialRequests(target, special)
+                        }
+                    }
+                },
+                modifier = Modifier.fillMaxWidth(),
+                enabled = activity != null,
+            ) {
+                Text(stringResource(R.string.first_start_permissions_request_all_button))
+            }
+        }
+
+        sortedPermissions.forEach { permission ->
+            val granted = permission.isGranted(context)
+            PermissionRow(
+                permission = permission,
+                granted = granted,
+                enabled = activity != null,
+                onRequest = {
+                    val target = activity
+                    if (target != null) {
+                        if (permission.isBatteryOptimizationPermission()) {
+                            requestBatteryOptimization(target)
+                        } else if (permission.isRequestedAlone) {
+                            permission.request(target)
+                        } else {
+                            val runtime = runtimePermissionsOf(listOf(permission))
+                            if (runtime.isNotEmpty()) {
+                                runtimePermissionLauncher.launch(runtime.toTypedArray())
+                            }
+                        }
+                    }
+                },
+            )
+        }
+    }
+}
+
+@Composable
+private fun PermissionRow(
+    permission: GBPermission,
+    granted: Boolean,
+    enabled: Boolean,
+    onRequest: () -> Unit,
+) {
+    GbTonalCard(
+        containerColor = if (granted) {
+            MaterialTheme.colorScheme.surfaceContainerLow
+        } else {
+            MaterialTheme.colorScheme.surfaceContainerHigh
+        },
+    ) {
+        Row(
+            modifier = Modifier.fillMaxWidth().padding(16.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Column(modifier = Modifier.weight(1f)) {
+                Text(
+                    text = stringResource(permission.title),
+                    style = MaterialTheme.typography.titleMedium,
+                    color = MaterialTheme.colorScheme.onSurface,
+                )
+                Spacer(Modifier.size(2.dp))
+                Text(
+                    text = stringResource(permission.rationale),
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+            Spacer(Modifier.width(12.dp))
+            if (granted) {
+                Icon(
+                    imageVector = Icons.Filled.CheckCircle,
+                    contentDescription = stringResource(R.string.compose_welcome_permissions_granted),
+                    tint = MaterialTheme.colorScheme.primary,
+                    modifier = Modifier.size(24.dp),
+                )
+            } else {
+                FilledTonalButton(onClick = onRequest, enabled = enabled) {
+                    Text(stringResource(R.string.first_start_permissions_request_button))
+                }
+            }
+        }
+    }
+}
+
+/**
+ * The [Activity] behind a Compose [Context], which is needed to request permissions.
+ */
+internal fun Context.findActivity(): Activity? {
+    var context: Context = this
+    while (context is ContextWrapper) {
+        if (context is Activity) {
+            return context
+        }
+        context = context.baseContext
+    }
+    return null
+}
+
+private fun GBPermission.isBatteryOptimizationPermission(): Boolean =
+    androidPermissions.any { it == Manifest.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS }
+
+private fun isBatteryOptimizationIgnored(context: Context): Boolean {
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.M) {
+        return true
+    }
+    val powerManager = context.getSystemService(Context.POWER_SERVICE) as? PowerManager ?: return true
+    return powerManager.isIgnoringBatteryOptimizations(context.packageName)
+}
