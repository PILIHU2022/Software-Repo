+    @NonNull
+    @Override
+    public View onCreateView(@NonNull final LayoutInflater inflater,
+                             @Nullable final ViewGroup container,
+                             @Nullable final Bundle savedInstanceState) {
+        if (!useComposePreferences()) {
+            return super.onCreateView(inflater, container, savedInstanceState);
+        }
+
+        final FrameLayout root = new FrameLayout(inflater.getContext());
+
+        final View preferenceListView = super.onCreateView(inflater, root, savedInstanceState);
+        if (preferenceListView != null) {
+            preferenceListView.setVisibility(View.GONE);
+            root.addView(preferenceListView, new FrameLayout.LayoutParams(0, 0));
+        }
+
+        composeView = new ComposeView(inflater.getContext());
+        root.addView(composeView, new FrameLayout.LayoutParams(
