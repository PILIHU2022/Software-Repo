+package nodomain.freeyourgadget.gadgetbridge.ui.compose.screens.settings
+
+import android.view.View
+import android.view.ViewGroup
+import androidx.core.view.ViewCompat
+import nodomain.freeyourgadget.gadgetbridge.R
+import nodomain.freeyourgadget.gadgetbridge.activities.AbstractGBActivity
+
+/**
+ * Hands the system bar insets of this activity to the Compose content.
+ *
+ * [AbstractGBActivity] pads its content view for the status bar and the navigation bar, which is what the View
+ * screens need. A Compose screen applies those insets itself, in its top app bar and in the content padding of
+ * its scaffold, so keeping the padding of the activity would inset the screen twice. Call this after
+ * `setGbComposeContent`.
+ */
+fun AbstractGBActivity.setComposeHandlesSystemBarInsets() {
+    val content = findViewById<View>(android.R.id.content) ?: return
+    content.setPadding(0, 0, 0, 0)
+    // Replace the listener of the base activity instead of consuming the insets, so that the Compose content
+    // still receives them
+    ViewCompat.setOnApplyWindowInsetsListener(content) { _, insets -> insets }
+
+    // The View settings layouts keep a small margin around the preference list, which the Compose screen fills
+    // edge to edge instead
+    val container = findViewById<View>(R.id.settings_container)
+    val host = container?.parent
+    if (host is View && host.layoutParams is ViewGroup.MarginLayoutParams) {
+        (host.layoutParams as ViewGroup.MarginLayoutParams).setMargins(0, 0, 0, 0)
+        host.requestLayout()
+    }
+}
