+import androidx.compose.ui.graphics.graphicsLayer
+import androidx.compose.ui.graphics.vector.ImageVector
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import androidx.graphics.shapes.RoundedPolygon
+
+/**
+ * The Material 3 Expressive hero of a welcome page: two Material Shapes, slowly counter-rotating in an infinite
+ * "morphing" motion, filled with the theme container colors and carrying the page icon. Nothing here is hard
+ * coded: the gradient is built from [MaterialTheme.colorScheme], so it follows the user's theme and dynamic color.
+ */
+@Composable
+internal fun WelcomeHero(
+    icon: ImageVector,
+    modifier: Modifier = Modifier,
+    size: Dp = 180.dp,
+    outer: RoundedPolygon = MaterialShapes.Cookie9Sided,
+    inner: RoundedPolygon = MaterialShapes.Gem,
+) {
+    val colorScheme = MaterialTheme.colorScheme
+    val transition = rememberInfiniteTransition(label = "welcomeHero")
+
+    // A very slow full rotation of the outer shape, and a faster counter-rotation of the inner one, which makes
+    // the pair look like a single shape that keeps morphing.
+    val rotation by transition.animateFloat(
+        initialValue = 0f,
+        targetValue = 360f,
+        animationSpec = infiniteRepeatable(tween(durationMillis = 42000, easing = LinearEasing)),
+        label = "heroRotation",
+    )
+    val counterRotation by transition.animateFloat(
+        initialValue = 0f,
+        targetValue = -360f,
+        animationSpec = infiniteRepeatable(tween(durationMillis = 26000, easing = LinearEasing)),
+        label = "heroCounterRotation",
+    )
+    // Breathing scale, so the hero never looks frozen.
+    val breathe by transition.animateFloat(
+        initialValue = 0.94f,
+        targetValue = 1.04f,
+        animationSpec = infiniteRepeatable(
+            animation = tween(durationMillis = 3800, easing = FastOutSlowInEasing),
+            repeatMode = RepeatMode.Reverse,
+        ),
+        label = "heroBreathe",
+    )
+
+    Box(modifier = modifier.size(size), contentAlignment = Alignment.Center) {
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .graphicsLayer {
+                    rotationZ = rotation
+                    scaleX = breathe
+                    scaleY = breathe
+                }
+                .clip(outer.toShape())
+                .background(
+                    Brush.sweepGradient(
+                        listOf(
+                            colorScheme.primaryContainer,
+                            colorScheme.tertiaryContainer,
+                            colorScheme.secondaryContainer,
+                            colorScheme.primaryContainer,
+                        ),
+                    ),
+                ),
+        )
+        Box(
+            modifier = Modifier
+                .fillMaxSize(0.62f)
+                .graphicsLayer { rotationZ = counterRotation }
+                .clip(inner.toShape())
+                .background(colorScheme.surface.copy(alpha = 0.78f)),
+        )
+        Icon(
+            imageVector = icon,
+            contentDescription = null,
+            tint = colorScheme.primary,
+            modifier = Modifier.size(size * 0.3f),
+        )
+    }
+}
+
+/**
+ * A small, decorative Expressive wavy line, used as an accent under a page title.
+ */
+@Composable
+internal fun WelcomeWavyAccent(modifier: Modifier = Modifier) {
+    androidx.compose.material3.LinearWavyProgressIndicator(
+        progress = { 1f },
+        modifier = modifier,
+        color = MaterialTheme.colorScheme.primary,
+        trackColor = MaterialTheme.colorScheme.primaryContainer,
+    )
+}
