+import java.util.concurrent.TimeUnit
+import kotlin.math.roundToInt
+
+/**
+ * The kinds of sleep score components, in the order they are shown.
+ *
+ * A component whose [SleepScoreComponent.weight] is 0 was not recorded by the device: the
+ * calculator leaves it out and renormalizes the remaining components, so the UI must not present
+ * it as "0 points".
+ */
+enum class SleepScoreComponentKind {
+    DURATION,
+    DEEP,
+    REM,
+    CONTINUITY,
+}
+
+/**
+ * One scored component of the sleep score.
+ *
+ * @param seconds the recorded duration this component was scored from, in seconds. Only meaningful
+ * for [SleepScoreComponentKind.DURATION], [SleepScoreComponentKind.DEEP] and [SleepScoreComponentKind.REM].
+ * @param sharePercent for the stage components, the share of the total sleep this stage made up.
+ * @param efficiencyPercent for the continuity component, asleep time divided by time in bed.
+ */
+data class SleepScoreComponent(
+    val kind: SleepScoreComponentKind,
+    val score: Int,
+    val weight: Int,
+    val seconds: Long = 0L,
+    val sharePercent: Int = 0,
+    val efficiencyPercent: Int = 0,
+) {
+    val isRecorded: Boolean get() = weight > 0
+
+    val progress: Float
+        get() = if (weight > 0) (score.toFloat() / weight.toFloat()).coerceIn(0f, 1f) else 0f
+}
+
+/**
+ * The data shown by [SleepScoreDetailsSheetContent], decoupled from
+ * [AgeSleepScoreCalculator.Result] so that the sheet survives a configuration change without
+ * carrying the (non-parcelable) Java result around.
+ */
+data class SleepScoreUiModel(
+    val score: Int,
+    val age: Int,
+    val recommendedMinMinutes: Int,
+    val recommendedMaxMinutes: Int,
+    val durationScore: Int,
+    val durationWeight: Int,
+    val deepSleepScore: Int,
+    val deepSleepWeight: Int,
+    val remSleepScore: Int,
+    val remSleepWeight: Int,
+    val continuityScore: Int,
+    val continuityWeight: Int,
+    val totalSleepSeconds: Long,
+    val deepSleepSeconds: Long,
+    val remSleepSeconds: Long,
+    val awakeSleepSeconds: Long,
+) {
+    val totalWeight: Int
+        get() = durationWeight + deepSleepWeight + remSleepWeight + continuityWeight
+
+    /** True when a missing component was left out and the others were renormalized. */
+    val isRenormalized: Boolean
+        get() = totalWeight in 1..99
+
+    /** The targets the score was measured against, derived from the user's age. */
+    val deepTargetPercent: Int
+        get() = (AgeSleepScoreCalculator.deepSleepTargetRatio(age) * 100.0).roundToInt()
+
+    val remTargetPercent: Int
+        get() = (AgeSleepScoreCalculator.remSleepTargetRatio(age) * 100.0).roundToInt()
+
+    val efficiencyTargetPercent: Int
+        get() = (AgeSleepScoreCalculator.sleepEfficiencyTarget(age) * 100.0).roundToInt()
+
+    private fun share(seconds: Long): Int =
+        if (totalSleepSeconds > 0L) (100.0 * seconds / totalSleepSeconds).roundToInt() else 0
+
+    private val efficiencyPercent: Int
+        get() {
+            val timeInBed = totalSleepSeconds + awakeSleepSeconds
+            return if (timeInBed > 0L) (100.0 * totalSleepSeconds / timeInBed).roundToInt() else 0
+        }
+
+    val components: List<SleepScoreComponent>
+        get() = listOf(
+            SleepScoreComponent(
+                kind = SleepScoreComponentKind.DURATION,
+                score = durationScore,
+                weight = durationWeight,
+                seconds = totalSleepSeconds,
+            ),
+            SleepScoreComponent(
+                kind = SleepScoreComponentKind.DEEP,
+                score = deepSleepScore,
+                weight = deepSleepWeight,
+                seconds = deepSleepSeconds,
+                sharePercent = share(deepSleepSeconds),
+            ),
+            SleepScoreComponent(
+                kind = SleepScoreComponentKind.REM,
+                score = remSleepScore,
+                weight = remSleepWeight,
+                seconds = remSleepSeconds,
+                sharePercent = share(remSleepSeconds),
+            ),
+            SleepScoreComponent(
+                kind = SleepScoreComponentKind.CONTINUITY,
+                score = continuityScore,
+                weight = continuityWeight,
+                efficiencyPercent = efficiencyPercent,
+            ),
+        )
+}
+
+/**
+ * The Material 3 Expressive bottom sheet with the breakdown of an age-adjusted sleep score.
+ *
+ * It has to be hosted by a Compose-capable window; [nodomain.freeyourgadget.gadgetbridge.activities.charts.SleepScoreDetailsSheet]
+ * provides that window as a legacy fragment so the charts can keep opening it through the fragment
+ * manager.
+ */
+@Composable
+fun SleepScoreDetailsSheetContent(
+    model: SleepScoreUiModel,
+    onDismiss: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)
+    val scope = rememberCoroutineScope()
+    // Closing from the button plays the same hide animation a swipe would, then releases the host.
+    val animateOutAndDismiss: () -> Unit = {
+        scope.launch { sheetState.hide() }.invokeOnCompletion {
+            if (!sheetState.isVisible) {
+                onDismiss()
+            }
+        }
+    }
+
+    ModalBottomSheet(
+        onDismissRequest = onDismiss,
+        modifier = modifier,
+        sheetState = sheetState,
+        shape = MaterialTheme.shapes.extraLarge,
+        containerColor = MaterialTheme.colorScheme.surfaceContainerLow,
+        contentColor = MaterialTheme.colorScheme.onSurface,
+        dragHandle = { BottomSheetDefaults.DragHandle() },
+        // The body applies the navigation bar inset itself, so the sheet must not apply it twice.
+        contentWindowInsets = { WindowInsets(0) },
+    ) {
+        SleepScoreSheetBody(model = model, onClose = animateOutAndDismiss)
+    }
+}
+
+@Composable
+private fun SleepScoreSheetBody(
+    model: SleepScoreUiModel,
+    onClose: () -> Unit,
+) {
+    val colorScheme = MaterialTheme.colorScheme
+    // The score counts up from zero with the Expressive spring motion, and the wavy ring follows the
+    // very same animated value, so the number and the ring never disagree.
+    var revealed by remember { mutableStateOf(false) }
+    LaunchedEffect(Unit) { revealed = true }
+    val animatedScore by animateFloatAsState(
+        targetValue = if (revealed) model.score.toFloat() else 0f,
+        animationSpec = MaterialTheme.motionScheme.slowSpatialSpec(),
+        label = "sleepScore",
+    )
+
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .navigationBarsPadding()
+            .verticalScroll(rememberScrollState())
+            .padding(start = 24.dp, end = 24.dp, bottom = 16.dp),
+    ) {
+        Text(
+            text = stringResource(R.string.compose_sleep_details_title),
+            style = MaterialTheme.typography.titleLarge,
+            color = colorScheme.onSurface,
+        )
+        Spacer(Modifier.height(8.dp))
+
+        ScoreRing(
+            score = animatedScore,
+            band = stringResource(bandResource(model.score)),
+            modifier = Modifier.align(Alignment.CenterHorizontally),
+        )
+
+        Text(
+            text = stringResource(R.string.compose_sleep_estimated_for_age, model.age),
+            style = MaterialTheme.typography.bodyMedium,
+            color = colorScheme.onSurfaceVariant,
+            textAlign = TextAlign.Center,
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(top = 12.dp),
+        )
+        if (model.isRenormalized) {
+            Text(
+                text = stringResource(R.string.compose_sleep_renormalized),
+                style = MaterialTheme.typography.bodySmall,
+                color = colorScheme.onSurfaceVariant,
+                textAlign = TextAlign.Center,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(top = 4.dp),
+            )
+        }
+
+        HorizontalDivider(
+            modifier = Modifier.padding(vertical = 16.dp),
+            color = colorScheme.outlineVariant,
+        )
+
+        GbSectionTitle(text = stringResource(R.string.compose_sleep_breakdown_title))
+        Text(
+            text = stringResource(R.string.compose_sleep_breakdown_hint),
+            style = MaterialTheme.typography.bodySmall,
+            color = colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(bottom = 4.dp),
+        )
+        model.components.forEach { component ->
+            SleepScoreComponentRow(
+                component = component,
+                accent = accentColor(component.kind, colorScheme),
+            )
+        }
+
+        GbSectionTitle(
+            text = stringResource(R.string.compose_sleep_targets_title, model.age),
+            modifier = Modifier.padding(top = 16.dp),
+        )
+        RecommendationCard(model = model)
+
+        Text(
+            text = stringResource(R.string.compose_sleep_estimated_note),
+            style = MaterialTheme.typography.bodySmall,
+            color = colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(top = 20.dp),
+        )
+        TextButton(
+            onClick = onClose,
+            modifier = Modifier
+                .align(Alignment.End)
+                .padding(top = 8.dp),
+        ) {
+            Text(stringResource(R.string.compose_sleep_close))
+        }
+    }
+}
+
+/**
+ * The big Expressive score gauge: a wavy circular indicator with the animated score in its middle.
+ */
+@Composable
+private fun ScoreRing(
+    score: Float,
+    band: String,
+    modifier: Modifier = Modifier,
+) {
+    val colorScheme = MaterialTheme.colorScheme
+    Box(
+        modifier = modifier.size(200.dp),
+        contentAlignment = Alignment.Center,
+    ) {
+        CircularWavyProgressIndicator(
+            progress = { (score / 100f).coerceIn(0f, 1f) },
+            modifier = Modifier.fillMaxSize(),
+            color = colorScheme.primary,
+            trackColor = colorScheme.surfaceContainerHighest,
+        )
+        Column(
+            horizontalAlignment = Alignment.CenterHorizontally,
+            verticalArrangement = Arrangement.Center,
+        ) {
+            Text(
+                text = score.roundToInt().toString(),
+                style = MaterialTheme.typography.displayMedium,
+                color = colorScheme.onSurface,
+            )
+            Text(
+                text = band,
+                style = MaterialTheme.typography.titleSmall,
+                color = colorScheme.primary,
+            )
+            Text(
+                text = stringResource(R.string.compose_sleep_score_unit),
+                style = MaterialTheme.typography.labelSmall,
+                color = colorScheme.onSurfaceVariant,
+            )
+        }
+    }
+}
+
+/**
+ * One component of the breakdown: its label, the points it scored out of its weight, a wavy bar and
+ * the recorded value it was derived from. Components the device did not record are shown as such
+ * instead of pretending they scored zero.
+ */
+@Composable
+private fun SleepScoreComponentRow(
+    component: SleepScoreComponent,
+    accent: Color,
+) {
+    val colorScheme = MaterialTheme.colorScheme
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(top = 12.dp),
+    ) {
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.SpaceBetween,
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Text(
+                text = stringResource(componentTitle(component.kind)),
+                style = MaterialTheme.typography.bodyLarge,
+                color = colorScheme.onSurface,
+            )
+            Text(
+                text = if (component.isRecorded) {
+                    stringResource(R.string.compose_sleep_points, component.score, component.weight)
+                } else {
+                    stringResource(R.string.compose_sleep_not_recorded)
+                },
+                style = MaterialTheme.typography.labelLarge,
+                color = colorScheme.onSurfaceVariant,
+            )
+        }
+        if (component.isRecorded) {
+            GbWavyBar(
+                progress = component.progress,
+                modifier = Modifier.padding(top = 6.dp),
+                color = accent,
+            )
+            Text(
+                text = componentDetail(component),
+                style = MaterialTheme.typography.bodySmall,
+                color = colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(top = 4.dp),
+            )
+        }
+    }
+}
+
+/**
+ * The age-appropriate targets the score was measured against, grouped in a tonal card.
+ */
+@Composable
+private fun RecommendationCard(model: SleepScoreUiModel) {
+    val colorScheme = MaterialTheme.colorScheme
+    GbTonalCard(
+        modifier = Modifier.fillMaxWidth(),
+        containerColor = colorScheme.surfaceContainerHigh,
+        contentColor = colorScheme.onSurface,
+        shape = MaterialTheme.shapes.extraLarge,
+    ) {
+        Column(modifier = Modifier.padding(vertical = 8.dp)) {
+            GbSettingRow(
+                title = stringResource(R.string.compose_sleep_duration_title),
+                supporting = stringResource(
+                    R.string.compose_sleep_target_range,
+                    formatDuration(model.recommendedMinMinutes * 60L),
+                    formatDuration(model.recommendedMaxMinutes * 60L),
+                ),
+            )
+            GbSettingRow(
+                title = stringResource(R.string.compose_sleep_deep_title),
+                supporting = stringResource(R.string.compose_sleep_target_share, model.deepTargetPercent),
+            )
+            GbSettingRow(
+                title = stringResource(R.string.compose_sleep_rem_title),
+                supporting = stringResource(R.string.compose_sleep_target_share, model.remTargetPercent),
+            )
+            GbSettingRow(
+                title = stringResource(R.string.compose_sleep_efficiency_title),
+                supporting = stringResource(R.string.compose_sleep_target_at_least, model.efficiencyTargetPercent),
+            )
+        }
+    }
+}
+
+@Composable
+private fun componentDetail(component: SleepScoreComponent): String = when (component.kind) {
+    SleepScoreComponentKind.DURATION -> stringResource(
+        R.string.compose_sleep_duration_detail,
+        formatDuration(component.seconds),
+    )
+
+    SleepScoreComponentKind.DEEP, SleepScoreComponentKind.REM -> stringResource(
+        R.string.compose_sleep_stage_detail,
+        formatDuration(component.seconds),
+        component.sharePercent,
+    )
+
+    SleepScoreComponentKind.CONTINUITY -> stringResource(
+        R.string.compose_sleep_efficiency_detail,
+        component.efficiencyPercent,
+    )
+}
+
+private fun componentTitle(kind: SleepScoreComponentKind): Int = when (kind) {
+    SleepScoreComponentKind.DURATION -> R.string.compose_sleep_duration_title
+    SleepScoreComponentKind.DEEP -> R.string.compose_sleep_deep_title
+    SleepScoreComponentKind.REM -> R.string.compose_sleep_rem_title
+    SleepScoreComponentKind.CONTINUITY -> R.string.compose_sleep_continuity_title
+}
+
+private fun accentColor(kind: SleepScoreComponentKind, colorScheme: ColorScheme): Color = when (kind) {
+    SleepScoreComponentKind.DURATION -> colorScheme.primary
+    SleepScoreComponentKind.DEEP -> colorScheme.tertiary
+    SleepScoreComponentKind.REM -> colorScheme.secondary
+    SleepScoreComponentKind.CONTINUITY -> colorScheme.primary
+}
+
+// The band names are the same strings the training readiness screen and the widgets already use,
+// so a translated band name is not duplicated as an untranslated copy.
+private fun bandResource(score: Int): Int = when {
+    score >= 90 -> R.string.sleep_score_excellent
+    score >= 80 -> R.string.sleep_score_good
+    score >= 60 -> R.string.sleep_score_fair
+    else -> R.string.sleep_score_poor
+}
+
+private fun formatDuration(seconds: Long): String =
+    DateTimeUtils.formatDurationHoursMinutes(seconds, TimeUnit.SECONDS)
