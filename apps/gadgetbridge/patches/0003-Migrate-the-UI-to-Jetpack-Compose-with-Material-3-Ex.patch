+/**
+ * The settings home screen, rendered with Compose from the AndroidX preference tree the fragment inflated from
+ * `R.xml.preferences`.
+ *
+ * Sub-screens are opened in place, so the whole settings tree is one Material 3 Expressive screen: a large flexible
+ * top app bar, one large-cornered card per category, Expressive switches and picker sheets. Every value is still read
+ * and written through the very same [androidx.preference.Preference] objects, which is what keeps the existing
+ * listeners, dependencies and default values working.
+ *
+ * @param initialScreen the screen the fragment inflated, used as the root of the navigation.
+ * @param initialScreenKey the nested screen the fragment was asked to show, if any.
+ * @param initialHighlightKey a preference to flash and scroll to, e.g. a settings search result.
+ * @param onNavigateUp called when the user goes back on the root screen.
+ * @param onOpenFullSearch opens the XML-based settings search, which also covers the other settings activities.
+ */
+@Composable
+fun PrefsSettingsScreen(
+    initialScreen: PreferenceScreen,
+    initialScreenKey: String?,
+    initialHighlightKey: String?,
+    fallbackTitle: String? = null,
+    onNavigateUp: () -> Unit,
+    onOpenFullSearch: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val tree = remember(initialScreen) { PrefsTree(initialScreen) }
+    val sharedPreferences = remember(tree) { tree.sharedPreferences }
+
+    // Bumped whenever something the rows show may have changed, so that the rows read the preferences again
+    var revision by remember(tree) { mutableIntStateOf(0) }
+
+    DisposableEffect(sharedPreferences, tree) {
+        val preferences = sharedPreferences
+        if (preferences == null) {
+            return@DisposableEffect onDispose { }
+        }
+        // Values can change behind our back: the notifications, the device service, a dialog or another screen
+        val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, _ -> revision++ }
+        preferences.registerOnSharedPreferenceChangeListener(listener)
+        onDispose { preferences.unregisterOnSharedPreferenceChangeListener(listener) }
+    }
+
+    val navStack = remember(tree) {
+        mutableStateListOf<String>().apply { addAll(tree.pathTo(initialScreenKey)) }
+    }
+    val currentKey = navStack.lastOrNull() ?: tree.rootKey
+
+    var searchOpen by rememberSaveable(tree) { mutableStateOf(false) }
+    var query by rememberSaveable(tree) { mutableStateOf("") }
+    var highlightKey by remember(tree) { mutableStateOf(initialHighlightKey) }
+    var pickerRow by remember(tree) { mutableStateOf<PrefRow?>(null) }
+    val bringIntoView = remember(tree) { BringIntoViewRequester() }
+
+    // Reading `revision` here is what makes the model follow the preferences
+    val model = remember(tree, currentKey, revision) { tree.screenModel(currentKey) }
+
+    fun bump() {
+        revision++
+    }
+
+    fun goUp() {
+        if (navStack.size > 1) {
+            navStack.removeAt(navStack.lastIndex)
+        } else {
+            onNavigateUp()
+        }
+    }
+
+    fun openScreen(row: PrefRow) {
+        val key = row.preference.key
+        if (!key.isNullOrEmpty()) {
+            navStack.add(key)
+        }
+    }
+
+    fun toggle(row: PrefRow) {
+        // A dependency may have disabled the preference; never route a tap to it in that case
+        if (!row.enabled) return
+        // Goes through the preference, so its change listeners (permissions, logging, theme...) still decide
+        row.preference.performClick()
+        bump()
+    }
+
+    fun activate(row: PrefRow) {
+        // A dependency may have disabled the preference; never route a tap to it in that case
+        if (!row.enabled) return
+        when (row.kind) {
+            PrefRowKind.SCREEN -> openScreen(row)
+            PrefRowKind.LIST -> pickerRow = row
+            // Everything else is rendered as a row, but still handled by the preference itself: its dialog, its
+            // activity or its intent
+            else -> {
+                row.preference.performClick()
+                bump()
+            }
+        }
+    }
+
+    fun pick(value: String) {
+        val row = pickerRow ?: return
+        val preference = row.preference
+        if (preference is ListPreference) {
+            // The same contract as the list preference dialog: a listener returning false cancels the change
+            if (preference.callChangeListener(value)) {
+                preference.value = value
+            }
+        }
+        pickerRow = null
+        bump()
+    }
+
+    BackHandler(enabled = searchOpen || navStack.size > 1) {
+        if (searchOpen) {
+            searchOpen = false
+            query = ""
+        } else {
+            goUp()
+        }
+    }
+
+    LaunchedEffect(highlightKey) {
+        val key = highlightKey ?: return@LaunchedEffect
+        runCatching { bringIntoView.bringIntoView() }
+        delay(HIGHLIGHT_DURATION_MILLIS)
+        if (highlightKey == key) {
+            highlightKey = null
+        }
+    }
+
+    GbExpressiveScaffold(
+        title = model.title.ifBlank { fallbackTitle ?: stringResource(R.string.title_activity_settings) },
+        subtitle = model.subtitle,
+        modifier = modifier,
+        navigationIcon = {
+            IconButton(onClick = { goUp() }) {
+                Icon(
+                    imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                    contentDescription = stringResource(R.string.compose_prefs_navigate_up),
+                )
+            }
+        },
+        actions = {
+            IconButton(onClick = { searchOpen = true }) {
+                Icon(
+                    imageVector = Icons.Filled.Search,
+                    contentDescription = stringResource(R.string.compose_prefs_search_hint),
+                )
+            }
+        },
+    ) { innerPadding ->
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(innerPadding),
+        ) {
+            if (searchOpen) {
+                PrefsSearch(
+                    tree = tree,
+                    query = query,
+                    onQueryChange = { query = it },
+                    onClose = {
+                        searchOpen = false
+                        query = ""
+                    },
+                    onOpenFullSearch = {
+                        searchOpen = false
+                        query = ""
+                        onOpenFullSearch()
+                    },
+                    onResultClick = { result ->
+                        navStack.clear()
+                        navStack.addAll(result.screenPath)
+                        highlightKey = result.row.key
+                        searchOpen = false
+                        query = ""
+                    },
+                )
+            } else {
+                PrefsSections(
+                    model = model,
+                    highlightKey = highlightKey,
+                    bringIntoView = bringIntoView,
+                    onActivate = { activate(it) },
+                    onToggle = { toggle(it) },
+                )
+            }
+        }
+    }
+
+    val sheetRow = pickerRow
+    if (sheetRow != null) {
+        PrefsPickerSheet(
+            row = sheetRow,
+            onDismiss = { pickerRow = null },
+            onPick = { pick(it) },
+        )
+    }
+}
+
+/** The cards of one screen, one per [PrefSection]. */
+@Composable
+private fun PrefsSections(
+    model: PrefScreenModel,
+    highlightKey: String?,
+    bringIntoView: BringIntoViewRequester,
+    onActivate: (PrefRow) -> Unit,
+    onToggle: (PrefRow) -> Unit,
+) {
+    Column(
+        modifier = Modifier
+            .fillMaxSize()
+            .verticalScroll(rememberScrollState())
+            .padding(horizontal = 16.dp),
+    ) {
+        Spacer(Modifier.size(8.dp))
+
+        model.sections.forEach { section ->
+            val title = section.title
+            if (title != null) {
+                GbSectionTitle(title)
+            }
+            if (section.rows.isNotEmpty()) {
+                PrefsCard(
+                    rows = section.rows,
+                    highlightKey = highlightKey,
+                    bringIntoView = bringIntoView,
+                    onActivate = onActivate,
+                    onToggle = onToggle,
+                )
+                GbCardSpacer()
+            }
+        }
+
+        Spacer(Modifier.size(24.dp))
+    }
+}
+
+/** One large-cornered card holding the rows of a section. */
+@Composable
+private fun PrefsCard(
+    rows: List<PrefRow>,
+    highlightKey: String?,
+    bringIntoView: BringIntoViewRequester,
+    onActivate: (PrefRow) -> Unit,
+    onToggle: (PrefRow) -> Unit,
+) {
+    GbTonalCard(
+        modifier = Modifier.fillMaxWidth(),
+        containerColor = MaterialTheme.colorScheme.surfaceContainerHigh,
+        shape = MaterialTheme.shapes.largeIncreased,
+    ) {
+        Column {
+            rows.forEachIndexed { index, row ->
+                PrefsRowItem(
+                    row = row,
+                    highlighted = row.key.isNotEmpty() && row.key == highlightKey,
+                    bringIntoView = bringIntoView,
+                    onActivate = { onActivate(row) },
+                    onToggle = { onToggle(row) },
+                )
+                if (index != rows.lastIndex) {
+                    HorizontalDivider(
+                        modifier = Modifier.padding(start = 56.dp, end = 12.dp),
+                        color = MaterialTheme.colorScheme.outlineVariant.copy(alpha = 0.6f),
+                    )
+                }
+            }
+        }
+    }
+}
+
+/** A single preference, as an Expressive settings row. */
+@Composable
+private fun PrefsRowItem(
+    row: PrefRow,
+    highlighted: Boolean,
+    bringIntoView: BringIntoViewRequester,
+    onActivate: () -> Unit,
+    onToggle: () -> Unit,
+) {
+    val highlightColor by animateColorAsState(
+        targetValue = if (highlighted) {
+            MaterialTheme.colorScheme.primaryContainer
+        } else {
+            Color.Transparent
+        },
+        animationSpec = MaterialTheme.motionScheme.defaultEffectsSpec(),
+        label = "prefs-highlight",
+    )
+
+    val leading: (@Composable () -> Unit)? = when {
+        row.icon != null -> ({ PrefIcon(row.icon) })
+        row.iconSpaceReserved -> ({ Spacer(Modifier.size(LEADING_ICON_SIZE)) })
+        else -> null
+    }
+
+    val rowModifier = Modifier
+        .fillMaxWidth()
+        .background(highlightColor)
+        .alpha(if (row.enabled) 1f else DISABLED_ALPHA)
+        .clickable(enabled = row.enabled) {
+            if (row.kind == PrefRowKind.SWITCH) {
+                onToggle()
+            } else {
+                onActivate()
+            }
+        }
+        // The requester can only be attached to one modifier at a time, so only the highlighted row takes it
+        .let { if (highlighted) it.bringIntoViewRequester(bringIntoView) else it }
+
+    GbSettingRow(
+        title = row.title,
+        supporting = row.summary,
+        modifier = rowModifier,
+        leading = leading,
+        trailing = {
+            if (row.kind == PrefRowKind.SWITCH) {
+                GbSwitch(
+                    checked = row.checked,
+                    onCheckedChange = { onToggle() },
+                    enabled = row.enabled,
+                )
+            } else {
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    // The preference's current value, unless the row's summary already says the same thing (a list
+                    // whose summary is its entry, a time preference whose summary is the formatted time)
+                    val valueText = row.valueText?.takeIf { it.isNotBlank() && it != row.summary }
+                    if (valueText != null) {
+                        Text(
+                            text = valueText,
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis,
+                            modifier = Modifier.widthIn(max = 140.dp),
+                        )
+                    }
+                    Icon(
+                        imageVector = Icons.AutoMirrored.Filled.KeyboardArrowRight,
+                        contentDescription = null,
+                        tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                }
+            }
+        },
+    )
+}
+
+/** The preference icon, tinted like the Material 3 symbols around it. */
+@Composable
+private fun PrefIcon(icon: Drawable?) {
+    val bitmap = rememberPrefIcon(icon)
+    Box(
+        modifier = Modifier
+            .size(LEADING_ICON_SIZE)
+            .clip(CircleShape)
+            .background(MaterialTheme.colorScheme.surfaceContainerHighest),
+        contentAlignment = Alignment.Center,
+    ) {
+        if (bitmap != null) {
+            Icon(
+                painter = remember(bitmap) { BitmapPainter(bitmap) },
+                contentDescription = null,
+                tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.size(20.dp),
+            )
+        }
+    }
+}
+
+/** The settings search: the query field, and the matching preferences of the whole tree. */
+@Composable
+private fun PrefsSearch(
+    tree: PrefsTree,
+    query: String,
+    onQueryChange: (String) -> Unit,
+    onClose: () -> Unit,
+    onOpenFullSearch: () -> Unit,
+    onResultClick: (PrefSearchResult) -> Unit,
+) {
+    val results = remember(query, tree) { tree.search(query) }
+    val focusRequester = remember { FocusRequester() }
+    LaunchedEffect(Unit) { focusRequester.requestFocus() }
+
+    Surface(
+        modifier = Modifier.fillMaxSize(),
+        color = MaterialTheme.colorScheme.surfaceContainerLowest,
+    ) {
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .statusBarsPadding(),
+        ) {
+            TextField(
+                query = query,
+                onQueryChange = onQueryChange,
+                onClose = onClose,
+                focusRequester = focusRequester,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(horizontal = 16.dp, vertical = 8.dp),
+            )
+
+            LazyColumn(
+                modifier = Modifier.fillMaxSize(),
+                contentPadding = PaddingValues(bottom = 16.dp),
+            ) {
+                if (results.isEmpty()) {
+                    item {
+                        Text(
+                            text = if (query.isBlank()) {
+                                stringResource(R.string.compose_prefs_search_start)
+                            } else {
+                                stringResource(R.string.compose_prefs_search_no_results, query)
+                            },
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            modifier = Modifier.padding(horizontal = 16.dp, vertical = 12.dp),
+                        )
+                    }
+                } else {
+                    items(items = results, key = { it.row.key }) { result ->
+                        PrefsSearchResultItem(result = result, onClick = { onResultClick(result) })
+                    }
+                }
+
+                item {
+                    // The XML-based search of the whole app, which also covers the other settings activities
+                    TextButton(
+                        onClick = onOpenFullSearch,
+                        modifier = Modifier.padding(horizontal = 8.dp, vertical = 4.dp),
+                    ) {
+                        Text(stringResource(R.string.compose_prefs_search_all_pages))
+                    }
+                }
+            }
+        }
+    }
+}
+
+/** The rounded Expressive input row of the settings search. */
+@Composable
+private fun TextField(
+    query: String,
+    onQueryChange: (String) -> Unit,
+    onClose: () -> Unit,
+    focusRequester: FocusRequester,
+    modifier: Modifier = Modifier,
+) {
+    val focusManager = LocalFocusManager.current
+    BasicTextField(
+        value = query,
+        onValueChange = onQueryChange,
+        modifier = modifier
+            .focusRequester(focusRequester)
+            .focusProperties { onEnter = { focusManager.clearFocus() } },
+        singleLine = true,
+        textStyle = TextStyle(
+            color = MaterialTheme.colorScheme.onSurface,
+            fontSize = 18.sp,
+        ),
+        keyboardOptions = KeyboardOptions(imeAction = ImeAction.Search),
+        keyboardActions = KeyboardActions(onSearch = { focusManager.clearFocus() }),
+        decorationBox = { inner ->
+            Surface(
+                shape = MaterialTheme.shapes.extraLarge,
+                color = MaterialTheme.colorScheme.surfaceContainerHigh,
+            ) {
+                Row(
+                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 14.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Icon(imageVector = Icons.Filled.Search, contentDescription = null)
+                    Spacer(Modifier.width(12.dp))
+                    Box(modifier = Modifier.weight(1f)) {
+                        if (query.isEmpty()) {
+                            Text(
+                                text = stringResource(R.string.compose_prefs_search_hint),
+                                style = MaterialTheme.typography.bodyLarge,
+                                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            )
+                        }
+                        inner()
+                    }
+                    IconButton(onClick = onClose) {
+                        Icon(
+                            imageVector = Icons.Filled.Close,
+                            contentDescription = stringResource(R.string.compose_prefs_search_close),
+                        )
+                    }
+                }
+            }
+        },
+    )
+}
+
+/** One search result: the preference, and where in the tree it lives. */
+@Composable
+private fun PrefsSearchResultItem(
+    result: PrefSearchResult,
+    onClick: () -> Unit,
+) {
+    val supporting = listOfNotNull(
+        result.breadcrumb.takeIf { it.isNotBlank() },
+        result.row.summary,
+    ).joinToString(" · ")
+
+    Surface(
+        onClick = onClick,
+        modifier = Modifier.fillMaxWidth(),
+        color = Color.Transparent,
+    ) {
+        Row(
+            modifier = Modifier.padding(horizontal = 16.dp, vertical = 12.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            if (result.row.icon != null) {
+                PrefIcon(result.row.icon)
+                Spacer(Modifier.width(16.dp))
+            }
+            Column(modifier = Modifier.weight(1f)) {
+                Text(
+                    text = result.row.title,
+                    style = MaterialTheme.typography.titleMedium,
+                    fontWeight = FontWeight.Medium,
+                )
+                if (supporting.isNotBlank()) {
+                    Text(
+                        text = supporting,
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        maxLines = 2,
+                        overflow = TextOverflow.Ellipsis,
+                    )
+                }
+            }
+        }
+    }
+}
+
+/** The Material 3 sheet that picks one entry of a list preference. */
+@Composable
+private fun PrefsPickerSheet(
+    row: PrefRow,
+    onDismiss: () -> Unit,
+    onPick: (String) -> Unit,
+) {
+    val sheetState = rememberModalBottomSheetState()
+
+    ModalBottomSheet(
+        onDismissRequest = onDismiss,
+        sheetState = sheetState,
+    ) {
+        Column(modifier = Modifier.padding(bottom = 24.dp)) {
+            Text(
+                text = row.title,
+                style = MaterialTheme.typography.titleLarge,
+                modifier = Modifier.padding(horizontal = 24.dp, vertical = 8.dp),
+            )
+            Column(
+                modifier = Modifier
+                    .heightIn(max = 420.dp)
+                    .verticalScroll(rememberScrollState()),
+            ) {
+                row.choices.forEach { choice ->
+                    val selected = choice.value == row.value
+                    Row(
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .clickable(enabled = row.enabled) { onPick(choice.value) }
+                            .padding(horizontal = 24.dp, vertical = 12.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                    ) {
+                        RadioButton(selected = selected, onClick = { onPick(choice.value) })
+                        Spacer(Modifier.width(8.dp))
+                        Column(modifier = Modifier.weight(1f)) {
+                            Text(
+                                text = choice.title,
+                                style = MaterialTheme.typography.bodyLarge,
+                                color = MaterialTheme.colorScheme.onSurface,
+                            )
+                            val subtitle = choice.subtitle
+                            if (subtitle != null) {
+                                Text(
+                                    text = subtitle,
+                                    style = MaterialTheme.typography.bodyMedium,
+                                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun rememberPrefIcon(drawable: Drawable?): ImageBitmap? =
+    remember(drawable) { drawable?.toImageBitmap() }
+
+private fun Drawable.toImageBitmap(): ImageBitmap? = runCatching {
+    val width = intrinsicWidth.takeIf { it > 0 } ?: FALLBACK_ICON_PIXELS
+    val height = intrinsicHeight.takeIf { it > 0 } ?: FALLBACK_ICON_PIXELS
+    toBitmap(width, height).asImageBitmap()
+}.getOrNull()
+
+private val LEADING_ICON_SIZE = 36.dp
+private const val DISABLED_ALPHA = 0.38f
+private const val HIGHLIGHT_DURATION_MILLIS = 1600L
+private const val FALLBACK_ICON_PIXELS = 48
