+import kotlin.math.absoluteValue
+
+/**
+ * The Expressive page indicator: the selected page is a stretched pill instead of the old dot, and the pill grows
+ * and shrinks continuously with the pager position, so it follows the finger while dragging. Unlike the old
+ * [nodomain.freeyourgadget.gadgetbridge.activities.welcome.WelcomePageIndicator] view it draws no bitmap and takes
+ * its colors from the theme.
+ *
+ * @param position the current page as a float, that is `currentPage + currentPageOffsetFraction`.
+ */
+@Composable
+internal fun WelcomePageIndicator(
+    pageCount: Int,
+    position: Float,
+    modifier: Modifier = Modifier,
+) {
+    val colorScheme = MaterialTheme.colorScheme
+    Row(
+        modifier = modifier,
+        horizontalArrangement = Arrangement.spacedBy(6.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        repeat(pageCount) { index ->
+            val distance = (position - index).absoluteValue.coerceIn(0f, 1f)
+            val width = lerp(28.dp, 8.dp, distance)
+            val color = lerp(colorScheme.primary, colorScheme.surfaceContainerHighest, distance)
+            Box(
+                modifier = Modifier
+                    .width(width)
+                    .height(8.dp)
+                    .clip(CircleShape)
+                    .background(color),
+            )
+        }
+    }
+}
