+package nodomain.freeyourgadget.gadgetbridge.ui.compose.screens.settings.prefs
+
+import android.content.SharedPreferences
+import android.graphics.drawable.Drawable
+import androidx.preference.EditTextPreference
+import androidx.preference.ListPreference
+import androidx.preference.MultiSelectListPreference
+import androidx.preference.Preference
+import androidx.preference.PreferenceCategory
+import androidx.preference.PreferenceGroup
+import androidx.preference.PreferenceScreen
+import androidx.preference.SeekBarPreference
+import androidx.preference.TwoStatePreference
+import com.mobeta.android.dslv.DragSortListPreference
+import nodomain.freeyourgadget.gadgetbridge.R
+import nodomain.freeyourgadget.gadgetbridge.util.XDatePreference
+import nodomain.freeyourgadget.gadgetbridge.util.XTimePreference
+import nodomain.freeyourgadget.gadgetbridge.util.preferences.SubtitleListPreference
+
+/**
+ * How a preference of the inflated `R.xml.preferences` tree is rendered. The kind only decides the trailing
+ * control and what a tap does: every kind keeps working on the very same [Preference] instance that the app
+ * already uses, so keys, defaults, dependencies and listeners are untouched.
+ */
+enum class PrefRowKind {
+    /** A nested [PreferenceScreen]: tapping it opens that screen in place. */
+    SCREEN,
+
+    /** A [TwoStatePreference]: rendered with the Expressive switch and toggled through [Preference.performClick]. */
+    SWITCH,
+
+    /** A [ListPreference]: rendered with its current entry, tapping it opens a Material 3 picker sheet. */
+    LIST,
+
+    /** Anything else: tapping it calls [Preference.performClick], which reuses the existing dialog or activity. */
+    ACTION,
+}
+
+/** One entry of a [PrefRowKind.LIST] picker. */
+class PrefChoice(
+    val title: String,
+    val subtitle: String?,
+    val value: String,
+)
+
+/** A single row of a settings screen, derived from the live state of [preference]. */
+class PrefRow(
+    val preference: Preference,
+    val kind: PrefRowKind,
+    val title: String,
+    val summary: String?,
+    val icon: Drawable?,
+    val iconSpaceReserved: Boolean,
+    val enabled: Boolean,
+    val checked: Boolean,
+    val choices: List<PrefChoice>,
+    val value: String?,
+    /**
+     * The preference's current value as the text shown at the trailing end of the row, e.g. the selected entry of a
+     * list, the text of an edit field, the "N selected" count of a multi-select, a seek bar's number or a formatted
+     * time/date. Null when the preference has no value worth repeating (its [summary] already says everything).
+     */
+    val valueText: String?,
+) {
+    val key: String get() = preference.key ?: ""
+}
+
+/** A group of rows, optionally under a [PreferenceCategory] title. */
+class PrefSection(
+    val title: String?,
+    val rows: List<PrefRow>,
+)
+
+/** One screen of the tree: the root screen, or one of the nested [PreferenceScreen]s. */
+class PrefScreenModel(
+    val key: String,
+    val title: String,
+    val subtitle: String?,
+    val sections: List<PrefSection>,
+) {
+    val rows: List<PrefRow> get() = sections.flatMap { it.rows }
+}
+
+/** A preference that matches a search query, with the screen it lives on. */
+class PrefSearchResult(
+    val row: PrefRow,
+    /** The keys of the screens to open, from the root down to the screen holding [row]. */
+    val screenPath: List<String>,
+    /** The titles of the parent screens, for the search result's supporting text. */
+    val breadcrumb: String,
+)
+
+/**
+ * The Compose view of the real AndroidX preference tree of `R.xml.preferences`.
+ *
+ * Nothing is copied out of the XML: the tree is inflated by the fragment's own [androidx.preference.PreferenceManager],
+ * and every screen, section and row is derived from it on demand. Reading the state again (via [screenModel]) always
+ * reflects what the preferences currently hold, so all the existing listeners, dependencies and default values keep
+ * working, and the app keeps writing to the very same [SharedPreferences].
+ */
+class PrefsTree(
+    screen: PreferenceScreen,
+) {
+    /** The topmost screen of the tree, even when the fragment was rooted at a nested screen. */
+    val root: PreferenceScreen = screen.absoluteRoot()
+
+    /** The key that identifies [root] in [screens]. */
+    val rootKey: String = root.key ?: ROOT_KEY
+
+    private class ScreenInfo(
+        val screen: PreferenceScreen,
+        /** The keys of every screen from the root down to this one, including the root itself. */
+        val path: List<String>,
+        /** The titles of the screens in [path]. */
+        val titles: List<String>,
+    )
+
+    private val screens: Map<String, ScreenInfo> = buildScreens()
+
+    /** The default shared preferences of the tree, if it stores its values in shared preferences at all. */
+    val sharedPreferences: SharedPreferences? by lazy {
+        try {
+            root.sharedPreferences
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    private fun buildScreens(): Map<String, ScreenInfo> {
+        val out = LinkedHashMap<String, ScreenInfo>()
+
+        fun visit(screen: PreferenceScreen, path: List<String>, titles: List<String>) {
+            val key = screen.key ?: ROOT_KEY
+            if (out.containsKey(key)) {
+                return
+            }
+            val title = screen.title?.toString().orEmpty()
+            val newPath = path + key
+            val newTitles = titles + title
+            out[key] = ScreenInfo(screen, newPath, newTitles)
+            for (i in 0 until screen.preferenceCount) {
+                val child = screen.getPreference(i)
+                if (child is PreferenceScreen) {
+                    visit(child, newPath, newTitles)
+                }
+            }
+        }
+
+        visit(root, emptyList(), emptyList())
+        return out
+    }
+
+    /** The screens to open so that [screenKey] is shown, starting at the root. */
+    fun pathTo(screenKey: String?): List<String> {
+        if (screenKey == null) {
+            return listOf(rootKey)
+        }
+        return screens[screenKey]?.path ?: listOf(rootKey)
+    }
+
+    /** The model of the screen with [screenKey], or of the root screen if it does not exist. */
+    fun screenModel(screenKey: String?): PrefScreenModel {
+        val info = screens[screenKey] ?: screens.getValue(rootKey)
+        val screen = info.screen
+        return PrefScreenModel(
+            key = screen.key ?: ROOT_KEY,
+            title = screen.title?.toString().orEmpty(),
+            subtitle = screen.summary?.toString()?.takeIf { it.isNotBlank() },
+            sections = sectionsOf(screen),
+        )
+    }
+
+    /**
+     * All the preferences of the whole tree whose title, summary or key match [query], the best matches first.
+     * Rows of the root screen come before rows of nested screens.
+     */
+    fun search(query: String): List<PrefSearchResult> {
+        val needle = query.trim().lowercase()
+        if (needle.isEmpty()) {
+            return emptyList()
+        }
+
+        val matches = ArrayList<Pair<Int, PrefSearchResult>>()
+        for (info in screens.values) {
+            val breadcrumb = info.titles.drop(1).filter { it.isNotBlank() }.joinToString(" › ")
+            for (row in screenModel(info.screen.key ?: ROOT_KEY).rows) {
+                if (row.key.isEmpty()) {
+                    continue
+                }
+                val score = scoreOf(row, needle)
+                if (score >= 0) {
+                    matches.add(score to PrefSearchResult(row, info.path, breadcrumb))
+                }
+            }
+        }
+
+        return matches
+            .sortedBy { it.first }
+            .distinctBy { it.second.row.key }
+            .map { it.second }
+    }
+
+    /** How well [row] matches [needle], a lower value being a better match, or -1 if it does not match at all. */
+    private fun scoreOf(row: PrefRow, needle: String): Int {
+        val title = row.title.lowercase()
+        return when {
+            title.startsWith(needle) -> 0
+            title.contains(needle) -> 1
+            row.summary?.lowercase()?.contains(needle) == true -> 2
+            row.key.lowercase().contains(needle) -> 3
+            else -> -1
+        }
+    }
+
+    private fun sectionsOf(screen: PreferenceScreen): List<PrefSection> {
+        val sections = ArrayList<PrefSection>()
+        var loose: MutableList<PrefRow>? = null
+
+        fun flushLoose() {
+            val pending = loose
+            if (pending != null && pending.isNotEmpty()) {
+                sections.add(PrefSection(null, pending))
+            }
+            loose = null
+        }
+
+        for (i in 0 until screen.preferenceCount) {
+            val preference = screen.getPreference(i)
+            if (!isRendered(preference)) {
+                continue
+            }
+            if (preference is PreferenceCategory) {
+                // A category starts a new, titled card, even when it only holds an explanation
+                flushLoose()
+                val rows = ArrayList<PrefRow>()
+                collectRows(preference, rows)
+                sections.add(
+                    PrefSection(
+                        title = preference.title?.toString()?.takeIf { it.isNotBlank() },
+                        rows = rows,
+                    )
+                )
+            } else {
+                // A nested screen is a row that opens it, the loose rows are grouped in an untitled card
+                val rows = loose ?: ArrayList<PrefRow>().also { loose = it }
+                rows.add(rowFor(preference))
+            }
+        }
+        flushLoose()
+        return sections
+    }
+
+    private fun collectRows(group: PreferenceGroup, into: MutableList<PrefRow>) {
+        for (i in 0 until group.preferenceCount) {
+            val preference = group.getPreference(i)
+            if (!isRendered(preference)) {
+                continue
+            }
+            if (preference is PreferenceCategory) {
+                // Categories nested in a category are flattened into the same card
+                collectRows(preference, into)
+            } else {
+                into.add(rowFor(preference))
+            }
+        }
+    }
+
+    /** Whether [preference] is a setting the user can see, and not something internal. */
+    private fun isRendered(preference: Preference): Boolean {
+        if (!preference.isVisible) {
+            return false
+        }
+        // The library's invisible search entry point is not a setting
+        return preference.key != SEARCH_PREFERENCE_KEY
+    }
+
+    private fun kindOf(preference: Preference): PrefRowKind = when {
+        preference is PreferenceScreen -> PrefRowKind.SCREEN
+        preference is TwoStatePreference -> PrefRowKind.SWITCH
+        // Must be checked before ListPreference, its drag-to-sort dialog cannot be reproduced here
+        preference is DragSortListPreference -> PrefRowKind.ACTION
+        // The subtitle picker can offer a free-text entry, so keep its own dialog for that
+        preference is SubtitleListPreference && preference.isAllowCustomValue -> PrefRowKind.ACTION
+        preference is ListPreference && hasChoices(preference) -> PrefRowKind.LIST
+        else -> PrefRowKind.ACTION
+    }
+
+    private fun hasChoices(preference: ListPreference): Boolean {
+        val entries = preference.entries
+        val values = preference.entryValues
+        return entries != null && values != null && entries.isNotEmpty() && values.isNotEmpty()
+    }
+
+    private fun rowFor(preference: Preference): PrefRow {
+        val kind = kindOf(preference)
+        val twoState = preference as? TwoStatePreference
+
+        val choices: List<PrefChoice>
+        val value: String?
+        if (kind == PrefRowKind.LIST && preference is ListPreference) {
+            val entries = preference.entries
+            val values = preference.entryValues
+            choices = values?.mapIndexed { index, entryValue ->
+                val entryValueString = entryValue?.toString().orEmpty()
+                PrefChoice(
+                    title = entries?.getOrNull(index)?.toString() ?: entryValueString,
+                    subtitle = (preference as? SubtitleListPreference)
+                        ?.getSubtitleFor(entryValueString)
+                        ?.toString()
+                        ?.takeIf { it.isNotBlank() },
+                    value = entryValueString,
+                )
+            }.orEmpty()
+            value = preference.value
+        } else {
+            choices = emptyList()
+            value = null
+        }
+
+        return PrefRow(
+            preference = preference,
+            kind = kind,
+            title = preference.title?.toString().orEmpty(),
+            summary = summaryOf(preference, twoState),
+            icon = preference.icon,
+            iconSpaceReserved = preference.isIconSpaceReserved,
+            enabled = preference.isEnabled,
+            checked = twoState?.isChecked == true,
+            choices = choices,
+            value = value,
+            valueText = valueTextOf(preference, kind),
+        )
+    }
+
+    /**
+     * The preference's current value, formatted for the trailing end of the row.
+     *
+     * Every kind is read straight from the live [Preference] instance, never from the persisted store: lists show the
+     * title of the selected entry, edit fields their current text, multi-selects an "N selected" count, seek bars their
+     * number, and the time/date preferences the value the class itself formats (respecting 12/24h, falling back to
+     * [XTimePreference.getPrefValue] / [XDatePreference.getPrefValue] if no summary was computed yet). Anything else
+     * (a plain [Preference], a [DragSortListPreference], a custom-value list) repeats nothing here and relies on its
+     * summary, which the row already shows.
+     */
+    private fun valueTextOf(preference: Preference, kind: PrefRowKind): String? = when {
+        preference is SeekBarPreference -> preference.value.toString()
+        preference is EditTextPreference -> preference.text?.takeIf { it.isNotBlank() }
+        preference is MultiSelectListPreference -> {
+            val count = preference.values.size
+            if (count == 0) null else root.context.getString(R.string.compose_prefs_selected_count, count)
+        }
+        preference is XTimePreference -> preference.summary?.toString()?.takeIf { it.isNotBlank() }
+            ?: preference.prefValue
+        preference is XDatePreference -> preference.summary?.toString()?.takeIf { it.isNotBlank() }
+            ?: preference.prefValue
+        // Only a plain list we render ourselves: its current entry, i.e. `preference.entry`
+        kind == PrefRowKind.LIST && preference is ListPreference ->
+            preference.entry?.toString()?.takeIf { it.isNotBlank() }
+        else -> null
+    }
+
+    /**
+     * The text below the title: for switches the "on"/"off" variant the XML declares, otherwise the summary the
+     * preference currently computes (for lists, this is the selected entry through its summary provider). A list
+     * preference without any summary falls back to the title of its selected entry, so the row never goes blank.
+     */
+    private fun summaryOf(preference: Preference, twoState: TwoStatePreference?): String? {
+        if (twoState != null) {
+            val summaryOn = twoState.summaryOn
+            val summaryOff = twoState.summaryOff
+            if (twoState.isChecked && summaryOn != null) {
+                return summaryOn.toString().takeIf { it.isNotBlank() }
+            }
+            if (!twoState.isChecked && summaryOff != null) {
+                return summaryOff.toString().takeIf { it.isNotBlank() }
+            }
+        }
+        val summary = preference.summary?.toString()?.takeIf { it.isNotBlank() }
+        if (summary != null) {
+            return summary
+        }
+        if (preference is ListPreference) {
+            val index = preference.findIndexOfValue(preference.value)
+            if (index >= 0) {
+                return preference.entries?.getOrNull(index)?.toString()?.takeIf { it.isNotBlank() }
+            }
+        }
+        return null
+    }
+
+    companion object {
+        /** The key that stands for the root screen, which declares none in the XML. */
+        const val ROOT_KEY = ""
+
+        private const val SEARCH_PREFERENCE_KEY = "searchPreference"
+    }
+}
+
+/** The topmost screen of this tree, following the parents up even from a nested screen. */
+private fun PreferenceScreen.absoluteRoot(): PreferenceScreen {
+    var screen = this
+    var parent = screen.parent
+    while (parent is PreferenceScreen) {
+        screen = parent
+        parent = screen.parent
+    }
+    return screen
+}
