+/** The number of pages of the welcome flow, in the same order the old pager adapter had them. */
+internal const val WELCOME_PAGE_COUNT = 5
+
+private const val PAGE_INTRO = 0
+private const val PAGE_OVERVIEW = 1
+private const val PAGE_PERMISSIONS = 2
+private const val PAGE_DOCS_SOURCE = 3
+private const val PAGE_GET_STARTED = 4
+
+/**
+ * The whole first run flow, as one Compose screen: an immersive, top bar-less layout with a [HorizontalPager] of
+ * Expressive pages, a morphing page indicator and the Expressive navigation buttons.
+ */
+@Composable
+fun WelcomeScreen(
+    onFinish: () -> Unit,
+    onAddDevice: () -> Unit,
+    onRestoreBackup: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val pagerState = rememberPagerState(pageCount = { WELCOME_PAGE_COUNT })
+    val scope = rememberCoroutineScope()
+    val lastPage = WELCOME_PAGE_COUNT - 1
+    // Only the settled page is read while composing; the drag offset is read while drawing, so dragging a page
+    // does not recompose the whole flow on every frame.
+    val currentPage = pagerState.currentPage
+
+    Column(
+        modifier = modifier
+            .fillMaxSize()
+            .background(MaterialTheme.colorScheme.surface),
+    ) {
+        WelcomeHeader(
+            showSkip = currentPage < lastPage,
+            onSkip = { scope.launch { pagerState.animateScrollToPage(lastPage) } },
+        )
+        HorizontalPager(
+            state = pagerState,
+            modifier = Modifier
+                .weight(1f)
+                .fillMaxWidth(),
+            pageSpacing = 8.dp,
+        ) { page ->
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .graphicsLayer {
+                        // The Expressive page transition: pages slide with a parallax, shrink and fade as they
+                        // leave. These reads happen while drawing, which keeps the composition stable.
+                        val offset = ((pagerState.currentPage - page) + pagerState.currentPageOffsetFraction)
+                        val distance = offset.absoluteValue.coerceIn(0f, 1f)
+                        alpha = lerp(0.4f, 1f, 1f - distance)
+                        scaleX = lerp(0.94f, 1f, 1f - distance)
+                        scaleY = lerp(0.94f, 1f, 1f - distance)
+                        translationX = offset * size.width * 0.2f
+                    },
+            ) {
+                when (page) {
+                    PAGE_INTRO -> WelcomeIntroPage()
+                    PAGE_OVERVIEW -> WelcomeOverviewPage()
+                    PAGE_PERMISSIONS -> WelcomePermissionsPage()
+                    PAGE_DOCS_SOURCE -> WelcomeDocsSourcePage()
+                    else -> WelcomeGetStartedPage(
+                        onAddDevice = onAddDevice,
+                        onRestoreBackup = onRestoreBackup,
+                        onFinish = onFinish,
+                    )
+                }
+            }
+        }
+        WelcomeFooter(
+            pagerState = pagerState,
+            pageCount = WELCOME_PAGE_COUNT,
+            onBack = {
+                scope.launch {
+                    pagerState.animateScrollToPage((pagerState.currentPage - 1).coerceAtLeast(0))
+                }
+            },
+            onNext = {
+                scope.launch {
+                    pagerState.animateScrollToPage((pagerState.currentPage + 1).coerceAtMost(lastPage))
+                }
+            },
+        )
+    }
+}
+
+/**
+ * The minimal header of the immersive layout: the app mark, the app name and the skip button.
+ */
+@Composable
+private fun WelcomeHeader(
+    showSkip: Boolean,
+    onSkip: () -> Unit,
+) {
+    val effects = MaterialTheme.motionScheme.defaultEffectsSpec<Float>()
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(horizontal = 20.dp, vertical = 10.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Icon(
+            painter = painterResource(R.drawable.splash_icon),
+            contentDescription = null,
+            tint = MaterialTheme.colorScheme.primary,
+            modifier = Modifier.size(28.dp),
+        )
+        Spacer(Modifier.width(10.dp))
+        Text(
+            text = stringResource(R.string.app_name),
+            style = MaterialTheme.typography.titleMedium,
+            color = MaterialTheme.colorScheme.onSurface,
+        )
+        Spacer(Modifier.weight(1f))
+        AnimatedVisibility(
+            visible = showSkip,
+            enter = fadeIn(effects),
+            exit = fadeOut(effects),
+        ) {
+            TextButton(onClick = onSkip) {
+                Text(stringResource(R.string.compose_welcome_skip))
+            }
+        }
+    }
+}
+
+/**
+ * The bottom navigation of the flow: the morphing page indicator above the back and continue buttons.
+ */
+@Composable
+private fun WelcomeFooter(
+    pagerState: PagerState,
+    pageCount: Int,
+    onBack: () -> Unit,
+    onNext: () -> Unit,
+) {
+    // The float position is read here, in the footer's own composition scope, so the indicator follows the drag
+    // without recomposing the pages above it.
+    val position = pagerState.currentPage + pagerState.currentPageOffsetFraction
+    val showBack = pagerState.currentPage > 0
+    val showNext = pagerState.currentPage < pageCount - 1
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(horizontal = 24.dp, vertical = 16.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        WelcomePageIndicator(pageCount = pageCount, position = position)
+        Spacer(Modifier.height(16.dp))
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            // The two slots take the same width, so the buttons stay on opposite sides on every page.
+            Box(modifier = Modifier.weight(1f), contentAlignment = Alignment.CenterStart) {
+                WelcomeBackButton(visible = showBack, onBack = onBack)
+            }
+            Box(modifier = Modifier.weight(1f), contentAlignment = Alignment.CenterEnd) {
+                WelcomeNextButton(visible = showNext, onNext = onNext)
+            }
+        }
+    }
+}
+
+@Composable
+private fun WelcomeBackButton(
+    visible: Boolean,
+    onBack: () -> Unit,
+) {
+    val effects = MaterialTheme.motionScheme.defaultEffectsSpec<Float>()
+    val offsets = MaterialTheme.motionScheme.defaultSpatialSpec<IntOffset>()
+    AnimatedVisibility(
+        visible = visible,
+        enter = fadeIn(effects) + slideInHorizontally(animationSpec = offsets) { -it / 2 },
+        exit = fadeOut(effects) + slideOutHorizontally(animationSpec = offsets) { -it / 2 },
+    ) {
+        FilledTonalIconButton(onClick = onBack) {
+            Icon(
+                imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                contentDescription = stringResource(R.string.compose_welcome_back),
+            )
+        }
+    }
+}
+
+@Composable
+private fun WelcomeNextButton(
+    visible: Boolean,
+    onNext: () -> Unit,
+) {
+    val effects = MaterialTheme.motionScheme.defaultEffectsSpec<Float>()
+    val offsets = MaterialTheme.motionScheme.defaultSpatialSpec<IntOffset>()
+    AnimatedVisibility(
+        visible = visible,
+        enter = fadeIn(effects) + slideInHorizontally(animationSpec = offsets) { it / 2 },
+        exit = fadeOut(effects) + slideOutHorizontally(animationSpec = offsets) { it / 2 },
+    ) {
+        Button(onClick = onNext) {
+            Text(stringResource(R.string.compose_welcome_continue))
+            Spacer(Modifier.width(8.dp))
+            Icon(
+                imageVector = Icons.AutoMirrored.Filled.ArrowForward,
+                contentDescription = null,
+                modifier = Modifier.size(18.dp),
+            )
+        }
+    }
+}
