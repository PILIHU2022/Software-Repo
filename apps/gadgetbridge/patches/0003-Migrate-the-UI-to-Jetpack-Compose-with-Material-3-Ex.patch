@@ -0,0 +1,21 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Material 3 Expressive corner radii, applied on top of every Gadgetbridge theme.
+
+    The Material Components library resolves the corner size of every shape from these theme attributes, so
+    overriding them here makes buttons, cards, chips, text fields, dialogs and bottom sheets rounder across the
+    whole View-based UI, which is the most visible part of the Material 3 Expressive look. Compose screens get the
+    same values from GbExpressiveShapes.
+-->
+<resources>
+    <style name="ThemeOverlay.App.ExpressiveShapes" parent="">
+        <item name="shapeCornerSizeExtraSmall">8dp</item>
+        <item name="shapeCornerSizeSmall">12dp</item>
+        <item name="shapeCornerSizeMedium">16dp</item>
+        <item name="shapeCornerSizeLarge">24dp</item>
+        <item name="shapeCornerSizeLargeIncreased">28dp</item>
+        <item name="shapeCornerSizeExtraLarge">36dp</item>
+        <item name="shapeCornerSizeExtraLargeIncreased">44dp</item>
+        <item name="shapeCornerSizeExtraExtraLarge">52dp</item>
+    </style>
+</resources>
