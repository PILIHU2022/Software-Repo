+/**
+ * The theme picker of the intro page, as an Expressive [ButtonGroup] of connected toggle buttons. Selecting a theme
+ * stores it through the view model, which recreates the activity so the whole flow, Compose included, picks up the
+ * new colors.
+ */
+@Composable
+internal fun WelcomeThemeSection(
+    themes: List<ThemeOption>,
+    selected: ThemeOption,
+    onSelect: (ThemeOption) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    // The button group content is a plain scope, not a composable one, so the strings are resolved up front.
+    val labels = themes.map { stringResource(it.labelRes) }
+
+    Column(
+        modifier = modifier.fillMaxWidth(),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Text(
+            text = stringResource(R.string.compose_welcome_theme_section),
+            style = MaterialTheme.typography.labelLarge,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+        Spacer(Modifier.height(8.dp))
+        ButtonGroup(
+            // The themes are few and short, so the group never needs an overflow menu.
+            overflowIndicator = { _ -> },
+            modifier = Modifier.fillMaxWidth(),
+            expandedRatio = ButtonGroupDefaults.ExpandedRatio,
+            horizontalArrangement = Arrangement.spacedBy(ButtonGroupDefaults.ConnectedSpaceBetween),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            themes.forEachIndexed { index, option ->
+                toggleableItem(
+                    checked = option == selected,
+                    // The label is both the accessibility text and what ButtonGroup renders for this item, so no
+                    // icon is passed: passing one as well would print the theme name twice.
+                    label = labels[index],
+                    onCheckedChange = { onSelect(option) },
+                    icon = null,
+                    weight = 1f,
+                )
+            }
+        }
+    }
+}
