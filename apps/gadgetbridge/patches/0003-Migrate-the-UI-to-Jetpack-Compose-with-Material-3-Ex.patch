+private val LOG = LoggerFactory.getLogger("AboutScreen")
+
+/**
+ * The about screen, as Material 3 Expressive cards: the app and its build, the license, the links and the
+ * contributors.
+ *
+ * Tapping the app card copies the build details to the clipboard, like tapping the version and the commit on
+ * the View screen did, and the licenses are still opened through [onOpenLicenses].
+ */
+@Composable
+fun AboutScreen(
+    onBack: () -> Unit,
+    onOpenLicenses: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val context = LocalContext.current
+    val uriHandler = LocalUriHandler.current
+
+    val gitHash = BuildConfig.GIT_HASH_SHORT + BuildConfig.GIT_DIRTY_STATUS
+    val buildDetails = stringResource(
+        R.string.compose_settings_about_build_details,
+        BuildConfig.VERSION_NAME,
+        gitHash,
+        BuildConfig.FLAVOR,
+    )
+
+    fun copyBuildDetails() {
+        val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as? ClipboardManager
+        if (clipboard == null) {
+            LOG.warn("No clipboard service, unable to copy the build details")
+            return
+        }
+        clipboard.setPrimaryClip(ClipData.newPlainText("Build data", buildDetails))
+        GB.toast(
+            context,
+            context.getString(R.string.about_build_details_copied_to_clipboard),
+            Toast.LENGTH_LONG,
+            GB.INFO,
+        )
+    }
+
+    GbExpressiveScaffold(
+        title = stringResource(R.string.about_title),
+        subtitle = stringResource(R.string.app_name),
+        modifier = modifier,
+        navigationIcon = {
+            IconButton(onClick = onBack) {
+                Icon(
+                    imageVector = Icons.AutoMirrored.Filled.ArrowBack,
+                    contentDescription = stringResource(R.string.compose_settings_navigate_up),
+                )
+            }
+        },
+    ) { innerPadding ->
+        LazyColumn(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(innerPadding),
+            contentPadding = PaddingValues(start = 16.dp, end = 16.dp, top = 8.dp, bottom = 32.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            item {
+                AppCard(
+                    versionText = stringResource(
+                        R.string.compose_settings_about_version_code,
+                        BuildConfig.VERSION_NAME,
+                        BuildConfig.VERSION_CODE,
+                    ),
+                    hashText = stringResource(R.string.about_hash, gitHash),
+                    onClick = { copyBuildDetails() },
+                )
+            }
+
+            item { GbSectionTitle(stringResource(R.string.compose_settings_about_license_title)) }
+
+            item {
+                GbTonalCard(
+                    containerColor = MaterialTheme.colorScheme.surfaceContainerHigh,
+                    shape = MaterialTheme.shapes.largeIncreased,
+                ) {
+                    Column(modifier = Modifier.padding(16.dp)) {
+                        Text(
+                            text = stringResource(R.string.compose_settings_about_license_body),
+                            style = MaterialTheme.typography.bodyMedium,
+                        )
+                        Spacer(Modifier.height(4.dp))
+                        LinkRow(
+                            title = stringResource(R.string.compose_settings_about_license_link),
+                            icon = Icons.Filled.Description,
+                            onClick = {
+                                openUri(
+                                    context = context,
+                                    uriHandler = uriHandler,
+                                    url = context.getString(R.string.compose_settings_about_license_url),
+                                )
+                            },
+                        )
+                    }
+                }
+            }
+
+            item { GbSectionTitle(stringResource(R.string.compose_settings_about_links_title)) }
+
+            item {
+                LinksCard(
+                    onOpenLink = { urlRes ->
+                        openUri(context = context, uriHandler = uriHandler, url = context.getString(urlRes))
+                    },
+                )
+            }
+
+            item {
+                GbTonalCard(
+                    containerColor = MaterialTheme.colorScheme.surfaceContainerHigh,
+                    shape = MaterialTheme.shapes.largeIncreased,
+                ) {
+                    Column(modifier = Modifier.padding(16.dp)) {
+                        Text(
+                            text = stringResource(R.string.compose_settings_about_licenses_summary),
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                        Spacer(Modifier.height(12.dp))
+                        FilledTonalButton(onClick = onOpenLicenses) {
+                            Icon(
+                                imageVector = Icons.Filled.Description,
+                                contentDescription = null,
+                                modifier = Modifier.size(ButtonDefaults.IconSize),
+                            )
+                            Spacer(Modifier.size(ButtonDefaults.IconSpacing))
+                            Text(stringResource(R.string.open_source_licenses))
+                        }
