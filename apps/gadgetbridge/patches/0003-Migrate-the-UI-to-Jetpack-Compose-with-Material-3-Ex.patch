+package nodomain.freeyourgadget.gadgetbridge.ui.compose.screens.settings.prefs
+
+import androidx.compose.ui.platform.ComposeView
+import androidx.preference.PreferenceScreen
+import nodomain.freeyourgadget.gadgetbridge.activities.AbstractGBActivity
+import nodomain.freeyourgadget.gadgetbridge.ui.compose.screens.settings.setComposeHandlesSystemBarInsets
+import nodomain.freeyourgadget.gadgetbridge.ui.compose.setGbComposeContent
+
+/**
+ * Bridges the Java settings fragment to the Compose settings screen.
+ *
+ * The fragment keeps owning the inflated preference tree, its dialogs and its listeners, and hands it over here so
+ * that the screen itself can be drawn with Compose.
+ */
+object PrefsScreenHost {
+    /**
+     * Prepares [activity] to host the Compose settings screen, which applies its own system bar insets.
+     *
+     * Call it in `onCreate`, after `super.onCreate`.
+     */
+    @JvmStatic
+    fun prepareActivity(activity: AbstractGBActivity) {
+        activity.setComposeHandlesSystemBarInsets()
+    }
+
+    /**
+     * Shows the settings tree of [screen] in [composeView].
+     *
+     * @param initialScreenKey the nested screen the fragment was created for, if any.
+     * @param highlightKey a preference to scroll to and flash, e.g. a settings search result.
+     * @param fallbackTitle the title to show when the screen itself declares none, usually the activity label.
+     * @param onNavigateUp called when the user goes back on the first screen of the tree.
+     * @param onOpenFullSearch opens the XML-based settings search of the whole app.
+     */
+    @JvmStatic
+    fun setContent(
+        composeView: ComposeView,
+        screen: PreferenceScreen,
+        initialScreenKey: String?,
+        highlightKey: String?,
+        fallbackTitle: String?,
+        onNavigateUp: Runnable,
+        onOpenFullSearch: Runnable,
+    ) {
+        composeView.setGbComposeContent {
+            PrefsSettingsScreen(
+                initialScreen = screen,
+                initialScreenKey = initialScreenKey,
+                initialHighlightKey = highlightKey,
+                fallbackTitle = fallbackTitle,
+                onNavigateUp = { onNavigateUp.run() },
+                onOpenFullSearch = { onOpenFullSearch.run() },
+            )
+        }
+    }
+}
