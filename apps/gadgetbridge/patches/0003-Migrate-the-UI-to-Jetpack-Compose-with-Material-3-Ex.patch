+    @Nullable
+    private ComposeView composeView;
+
+    /**
+     * Whether this screen is drawn with Compose instead of the View preference list.
+     *
+     * Screens that use preference widgets Compose cannot reproduce faithfully (the device specific settings,
+     * which build their entries at runtime, and the drag-sortable loyalty cards) keep the View implementation
