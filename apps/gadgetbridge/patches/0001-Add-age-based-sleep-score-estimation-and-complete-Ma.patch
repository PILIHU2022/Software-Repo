+    /**
+     * The half-open epoch-second window [start, endExclusive) of one sleep day, clamped to the
+     * queried range and to now.
+     *
+     * A session belongs to the day it ends on, so the window is the whole calendar day: a night
+     * from 23:00 to 07:00 ends on the following day and is therefore scored for that day. The
+     * window is based on the calendar day rather than the chart's "sleep range" preference, so the
+     * previous evening (or the previous night) is not pulled into the day.
+     * The window also stops at the current second: on the selected day, sessions that end later
+     * have not happened yet and must not be scored as if the night were complete.
+     * [allowFuture], when set, is used for the history chart: the night that ended this morning
+     * still has to be read from the database even though the selected day itself is only partly
+     * over. It does not change the day the score is plotted on.
+     */
+    private fun sleepDayWindow(
+        scope: WidgetDataScope,
+        day: LocalDate,
+        allowFuture: Boolean = false,
+    ): Pair<Int, Int>? {
+        val start = day.atStartOfDay(scope.zone).toEpochSecond().toInt()
+        val endExclusive = minOf(
+            day.plusDays(1).atStartOfDay(scope.zone).toEpochSecond(),
+            scope.query.timeTo.toLong() + 1L,
+            if (allowFuture) Long.MAX_VALUE else Instant.now().epochSecond + 1L,
+        ).toInt()
+        return if (endExclusive > start) start to endExclusive else null
+    }
+
