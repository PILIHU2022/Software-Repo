+    along with this program.  If not, see <https://www.gnu.org/licenses/>. */
+package nodomain.freeyourgadget.gadgetbridge.util.sleep;
+
+import androidx.annotation.NonNull;
+
+import java.util.List;
+import java.util.Locale;
+
+import nodomain.freeyourgadget.gadgetbridge.model.SleepSession;
+
+/**
+ * Computes a 0-100 sleep score from the recorded sleep stages, adjusted for the sleep needs of
+ * the user's age.
+ *
+ * <p>Devices usually compute their score with a proprietary algorithm, which makes scores from
+ * different devices incomparable and leaves devices without a native score with no score at all.
+ * This calculator provides a transparent, age-aware estimate instead:
+ *
+ * <ul>
+ *     <li><b>Sleep duration (50 points)</b> - scored against the age-appropriate sleep duration
+ *     range recommended by the AASM / National Sleep Foundation. Sleeping inside the range scores
+ *     full points, sleeping less decays faster than sleeping more.</li>
+ *     <li><b>Deep sleep (20 points)</b> - deep sleep naturally declines with age, so the target
+ *     ratio follows the age bracket instead of using a single target for everyone.</li>
+ *     <li><b>REM sleep (15 points)</b> - scored against a 22% REM share, which is comparatively
+ *     stable across adult ages.</li>
+ *     <li><b>Sleep continuity (15 points)</b> - time asleep divided by time in bed, compared to an
+ *     age-appropriate efficiency target.</li>
+ * </ul>
+ *
+ * <p>Components that the device did not record (for example a session without awake stages) are
+ * left out and the remaining components are renormalized to 0-100, so a missing stage breakdown
+ * does not silently produce a bad score.
+ */
+public final class AgeSleepScoreCalculator {
+    public static final int WEIGHT_DURATION = 50;
+    public static final int WEIGHT_DEEP_SLEEP = 20;
+    public static final int WEIGHT_REM_SLEEP = 15;
+    public static final int WEIGHT_CONTINUITY = 15;
+
+    /**
+     * Used when the user's date of birth is unset, invalid or implausible.
+     */
+    public static final int DEFAULT_AGE = 30;
+
+    public static final double REM_SLEEP_TARGET_RATIO = 0.22;
+
+    private AgeSleepScoreCalculator() {
+    }
+
+    /**
+     * The sleep duration range recommended for {@code age}, in minutes.
+     */
+    @NonNull
+    public static Recommendation recommendationForAge(final int age) {
+        if (age >= 1 && age <= 2) {
+            return new Recommendation(11 * 60, 14 * 60);
+        } else if (age >= 3 && age <= 5) {
+            return new Recommendation(10 * 60, 13 * 60);
+        } else if (age >= 6 && age <= 12) {
+            return new Recommendation(9 * 60, 12 * 60);
+        } else if (age >= 13 && age <= 17) {
+            return new Recommendation(8 * 60, 10 * 60);
+        } else if (age >= 18 && age <= 25) {
+            return new Recommendation(7 * 60, 9 * 60);
+        } else if (age >= 26 && age <= 64) {
+            return new Recommendation(7 * 60, 9 * 60);
+        } else if (age >= 65) {
+            return new Recommendation(7 * 60, 8 * 60);
+        }
+        // Infants, or an unknown age: use the adult recommendation rather than failing.
+        return new Recommendation(7 * 60, 9 * 60);
+    }
+
+    /**
+     * The share of total sleep that deep sleep should ideally make up at {@code age}.
+     */
+    public static double deepSleepTargetRatio(final int age) {
+        if (age < 30) {
+            return 0.20;
+        } else if (age < 40) {
+            return 0.18;
+        } else if (age < 50) {
+            return 0.16;
+        } else if (age < 60) {
+            return 0.14;
+        } else {
+            return 0.12;
+        }
+    }
+
+    /**
+     * The share of total sleep that REM sleep should ideally make up at {@code age}.
+     */
+    public static double remSleepTargetRatio(final int age) {
+        return REM_SLEEP_TARGET_RATIO;
+    }
+
+    /**
+     * The sleep efficiency (asleep / time in bed) that is typical for {@code age}.
+     */
+    public static double sleepEfficiencyTarget(final int age) {
+        if (age < 40) {
+            return 0.90;
+        } else if (age < 60) {
+            return 0.85;
+        } else {
+            return 0.80;
+        }
+    }
+
+    /**
+     * Calculates the score from aggregated stage durations, all in seconds.
+     */
+    @NonNull
+    public static Result calculate(final int age,
+                                   final long totalSleepSeconds,
+                                   final long deepSleepSeconds,
+                                   final long remSleepSeconds,
+                                   final long awakeSleepSeconds) {
+        final int safeAge = normalizeAge(age);
+        final Recommendation recommendation = recommendationForAge(safeAge);
+        final long asleep = Math.max(0L, totalSleepSeconds);
+        final long deep = Math.max(0L, deepSleepSeconds);
+        final long rem = Math.max(0L, remSleepSeconds);
+        final long awake = Math.max(0L, awakeSleepSeconds);
+
+        if (asleep <= 0L) {
+            return new Result(0, 0, 0, 0, 0,
+                    WEIGHT_DURATION, 0, 0, 0,
+                    safeAge, recommendation, 0, deep, rem, awake);
+        }
+
+        final int durationScore = durationScore(asleep, recommendation);
+
+        int deepWeight = 0;
+        int deepScore = 0;
+        int remWeight = 0;
+        int remScore = 0;
+        // Score each stage only when the device recorded it. Cheaper trackers sometimes only
+        // record deep sleep, and a missing stage must not be mistaken for zero of that stage.
+        if (deep > 0L) {
+            deepWeight = WEIGHT_DEEP_SLEEP;
+            deepScore = ratioScore(deep, asleep, deepSleepTargetRatio(safeAge), WEIGHT_DEEP_SLEEP);
+        }
+        if (rem > 0L) {
+            remWeight = WEIGHT_REM_SLEEP;
+            remScore = ratioScore(rem, asleep, remSleepTargetRatio(safeAge), WEIGHT_REM_SLEEP);
+        }
+
+        int continuityWeight = 0;
+        int continuityScore = 0;
+        if (awake > 0L) {
+            continuityWeight = WEIGHT_CONTINUITY;
+            final double efficiency = (double) asleep / (double) (asleep + awake);
+            continuityScore = clampScore(efficiency / sleepEfficiencyTarget(safeAge), WEIGHT_CONTINUITY);
+        }
+
+        final int totalWeight = WEIGHT_DURATION + deepWeight + remWeight + continuityWeight;
+        final int totalPoints = durationScore + deepScore + remScore + continuityScore;
+        final int score = (int) Math.round(100.0 * totalPoints / totalWeight);
+
+        return new Result(
+                Math.max(0, Math.min(100, score)),
+                durationScore,
+                deepScore,
+                remScore,
+                continuityScore,
+                WEIGHT_DURATION,
+                deepWeight,
+                remWeight,
+                continuityWeight,
+                safeAge,
+                recommendation,
+                asleep,
+                deep,
+                rem,
+                awake
+        );
+    }
+
+    /**
+     * Calculates the score for a night made up of one or more sleep sessions.
+     */
+    @NonNull
+    public static Result calculate(final int age, @NonNull final List<SleepSession> sessions) {
+        long asleep = 0L;
+        long deep = 0L;
+        long rem = 0L;
+        long awake = 0L;
+        for (final SleepSession session : sessions) {
+            asleep += session.getTotalSleepDuration();
+            deep += session.getDeepSleepDuration();
+            rem += session.getRemSleepDuration();
+            awake += session.getAwakeSleepDuration();
+        }
+        return calculate(age, asleep, deep, rem, awake);
+    }
+
+    /**
+     * Drops implausible ages (unset date of birth, future dates) down to {@link #DEFAULT_AGE}.
+     */
+    public static int normalizeAge(final int age) {
+        return age >= 1 && age <= 120 ? age : DEFAULT_AGE;
+    }
+
+    private static int durationScore(final long asleepSeconds, @NonNull final Recommendation recommendation) {
+        final double hours = asleepSeconds / 3600.0;
+        final double minHours = recommendation.minMinutes / 60.0;
+        final double maxHours = recommendation.maxMinutes / 60.0;
+
+        if (hours < minHours) {
+            // Sleeping less than the recommended range decays faster than oversleeping: at half
+            // the minimum the score is roughly 40% of the duration weight.
+            return (int) Math.round(WEIGHT_DURATION * Math.pow(hours / minHours, 1.2));
+        }
+        if (hours > maxHours) {
+            // Oversleeping is penalized more gently, reaching 0 at twice the upper bound.
+            return (int) Math.round(WEIGHT_DURATION * Math.max(0.0, 1.0 - (hours - maxHours) / (2.0 * maxHours)));
+        }
+        return WEIGHT_DURATION;
+    }
+
+    private static int ratioScore(final long part, final long total, final double targetRatio, final int weight) {
+        if (total <= 0L || targetRatio <= 0.0) {
+            return 0;
+        }
+        return clampScore((part / (double) total) / targetRatio, weight);
+    }
+
+    private static int clampScore(final double ratio, final int weight) {
+        return (int) Math.round(weight * Math.max(0.0, Math.min(1.0, ratio)));
+    }
+
+    /**
+     * The age-appropriate sleep duration range, in minutes.
+     */
+    public static final class Recommendation {
+        private final int minMinutes;
+        private final int maxMinutes;
+
+        public Recommendation(final int minMinutes, final int maxMinutes) {
+            this.minMinutes = minMinutes;
+            this.maxMinutes = maxMinutes;
+        }
+
+        public int getMinMinutes() {
+            return minMinutes;
+        }
+
+        public int getMaxMinutes() {
+            return maxMinutes;
+        }
+
+        public int getTargetMinutes() {
+            return (minMinutes + maxMinutes) / 2;
+        }
+
+        @NonNull
+        @Override
+        public String toString() {
+            return String.format(Locale.ROOT, "%d-%d min", minMinutes, maxMinutes);
+        }
+    }
+
+    /**
+     * The score and its components. Weights are 0 for components that were not available.
+     */
+    public static final class Result {
+        private final int score;
+        private final int durationScore;
+        private final int deepSleepScore;
+        private final int remSleepScore;
+        private final int continuityScore;
+        private final int durationWeight;
+        private final int deepSleepWeight;
+        private final int remSleepWeight;
+        private final int continuityWeight;
+        private final int age;
+        private final Recommendation recommendation;
+        private final long totalSleepSeconds;
+        private final long deepSleepSeconds;
+        private final long remSleepSeconds;
+        private final long awakeSleepSeconds;
+
+        Result(final int score,
+               final int durationScore,
+               final int deepSleepScore,
+               final int remSleepScore,
+               final int continuityScore,
+               final int durationWeight,
+               final int deepSleepWeight,
+               final int remSleepWeight,
+               final int continuityWeight,
+               final int age,
+               @NonNull final Recommendation recommendation,
+               final long totalSleepSeconds,
+               final long deepSleepSeconds,
+               final long remSleepSeconds,
+               final long awakeSleepSeconds) {
+            this.score = score;
+            this.durationScore = durationScore;
+            this.deepSleepScore = deepSleepScore;
+            this.remSleepScore = remSleepScore;
+            this.continuityScore = continuityScore;
+            this.durationWeight = durationWeight;
+            this.deepSleepWeight = deepSleepWeight;
+            this.remSleepWeight = remSleepWeight;
+            this.continuityWeight = continuityWeight;
+            this.age = age;
+            this.recommendation = recommendation;
+            this.totalSleepSeconds = totalSleepSeconds;
+            this.deepSleepSeconds = deepSleepSeconds;
+            this.remSleepSeconds = remSleepSeconds;
+            this.awakeSleepSeconds = awakeSleepSeconds;
+        }
+
+        public int getScore() {
+            return score;
+        }
+
+        public int getDurationScore() {
+            return durationScore;
+        }
+
+        public int getDeepSleepScore() {
+            return deepSleepScore;
+        }
+
+        public int getRemSleepScore() {
+            return remSleepScore;
+        }
+
+        public int getContinuityScore() {
+            return continuityScore;
+        }
+
+        public int getDurationWeight() {
+            return durationWeight;
+        }
+
+        public int getDeepSleepWeight() {
+            return deepSleepWeight;
+        }
+
+        public int getRemSleepWeight() {
+            return remSleepWeight;
+        }
+
+        public int getContinuityWeight() {
+            return continuityWeight;
+        }
+
+        public int getAge() {
+            return age;
+        }
+
+        @NonNull
+        public Recommendation getRecommendation() {
+            return recommendation;
+        }
+
+        public long getTotalSleepSeconds() {
+            return totalSleepSeconds;
+        }
+
+        public long getDeepSleepSeconds() {
+            return deepSleepSeconds;
+        }
+
+        public long getRemSleepSeconds() {
+            return remSleepSeconds;
+        }
+
+        public long getAwakeSleepSeconds() {
+            return awakeSleepSeconds;
+        }
+
+        public boolean hasStageBreakdown() {
+            return deepSleepWeight > 0 || remSleepWeight > 0;
+        }
+
+        public int getTotalWeight() {
+            return durationWeight + deepSleepWeight + remSleepWeight + continuityWeight;
+        }
+
+        @NonNull
+        @Override
+        public String toString() {
+            return String.format(Locale.ROOT,
+                    "SleepScore{score=%d, age=%d, duration=%d/%d, deep=%d/%d, rem=%d/%d, continuity=%d/%d}",
+                    score, age,
+                    durationScore, durationWeight,
+                    deepSleepScore, deepSleepWeight,
+                    remSleepScore, remSleepWeight,
+                    continuityScore, continuityWeight);
+        }
+    }
+}
