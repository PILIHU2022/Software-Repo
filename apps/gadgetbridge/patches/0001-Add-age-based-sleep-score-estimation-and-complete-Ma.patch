+
+import nodomain.freeyourgadget.gadgetbridge.GBApplication;
+import nodomain.freeyourgadget.gadgetbridge.model.ActivityUser;
+import nodomain.freeyourgadget.gadgetbridge.model.SleepSession;
+
+/**
+ * Glue between the age-based sleep score calculator, the user's profile and the stored preference.
+ */
+public final class AgeSleepScore {
+    /**
+     * Whether a score should be estimated from the recorded sleep sessions when the device does
+     * not report one. Defaults to on; the calculation only uses data that is already stored.
+     */
+    public static final String PREF_AGE_BASED_SLEEP_SCORE = "charts_age_based_sleep_score";
+
+    private AgeSleepScore() {
+    }
+
+    public static boolean isEnabled() {
+        return GBApplication.getPrefs().getBoolean(PREF_AGE_BASED_SLEEP_SCORE, true);
+    }
+
+    /**
+     * The user's current age, normalized to a plausible value if their date of birth is unset.
+     */
+    public static int getAge() {
+        return AgeSleepScoreCalculator.normalizeAge(new ActivityUser().getAge());
+    }
+
+    @NonNull
+    public static AgeSleepScoreCalculator.Result calculate(@NonNull final List<SleepSession> sessions) {
+        return AgeSleepScoreCalculator.calculate(getAge(), sessions);
+    }
+
+    /**
+     * The summed asleep time of {@code sessions}, rounded down to whole minutes.
+     */
+    public static long totalSleepMinutes(@NonNull final List<SleepSession> sessions) {
+        long seconds = 0;
+        for (final SleepSession session : sessions) {
+            seconds += session.getTotalSleepDuration();
+        }
+        return seconds / 60L;
+    }
+}
