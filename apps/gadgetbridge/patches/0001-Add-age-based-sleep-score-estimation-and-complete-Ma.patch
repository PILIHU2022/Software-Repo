diff --git a/app/src/test/java/nodomain/freeyourgadget/gadgetbridge/util/sleep/AgeSleepScoreCalculatorTest.java b/app/src/test/java/nodomain/freeyourgadget/gadgetbridge/util/sleep/AgeSleepScoreCalculatorTest.java
new file mode 100644
index 0000000000..c6b15b5943
--- /dev/null
+++ b/app/src/test/java/nodomain/freeyourgadget/gadgetbridge/util/sleep/AgeSleepScoreCalculatorTest.java
@@ -0,0 +1,203 @@
+/*  Copyright (C) 2026 Gadgetbridge contributors
