+
+        binding.sleepScoreNote.setText(R.string.sleep_score_estimated_note)
+        binding.sleepScoreClose.setOnClickListener { dismiss() }
+    }
+
+    override fun onDestroyView() {
+        _binding = null
+        super.onDestroyView()
+    }
+
+    private fun bindRow(
+        row: View,
+        bar: LinearProgressIndicator,
+        points: TextView,
+        score: Int,
+        weight: Int,
+    ) {
+        if (weight <= 0) {
+            row.visibility = View.GONE
+            bar.visibility = View.GONE
+            return
+        }
+        row.visibility = View.VISIBLE
+        bar.visibility = View.VISIBLE
+        points.text = getString(R.string.sleep_score_points, score, weight)
+        bar.max = weight
+        bar.setProgressCompat(score, false)
+    }
+
+    private fun formatMinutes(minutes: Int): String =
+        DateTimeUtils.formatDurationHoursMinutes(minutes.toLong(), TimeUnit.MINUTES)
+
+    private fun bandOf(score: Int): Int = when {
+        score >= 90 -> R.string.sleep_score_excellent
+        score >= 80 -> R.string.sleep_score_good
+        score >= 60 -> R.string.sleep_score_fair
+        else -> R.string.sleep_score_poor
+    }
+
+    companion object {
+        private const val ARG_SCORE = "score"
+        private const val ARG_AGE = "age"
+        private const val ARG_MIN_MINUTES = "min_minutes"
+        private const val ARG_MAX_MINUTES = "max_minutes"
+        private const val ARG_DURATION_SCORE = "duration_score"
+        private const val ARG_DURATION_WEIGHT = "duration_weight"
+        private const val ARG_DEEP_SCORE = "deep_score"
+        private const val ARG_DEEP_WEIGHT = "deep_weight"
+        private const val ARG_REM_SCORE = "rem_score"
+        private const val ARG_REM_WEIGHT = "rem_weight"
+        private const val ARG_CONTINUITY_SCORE = "continuity_score"
+        private const val ARG_CONTINUITY_WEIGHT = "continuity_weight"
+
+        @JvmStatic
+        fun newInstance(result: AgeSleepScoreCalculator.Result): SleepScoreDetailsSheet {
+            val recommendation = result.recommendation
+            return SleepScoreDetailsSheet().apply {
+                arguments = Bundle().apply {
+                    putInt(ARG_SCORE, result.score)
+                    putInt(ARG_AGE, result.age)
+                    putInt(ARG_MIN_MINUTES, recommendation.minMinutes)
+                    putInt(ARG_MAX_MINUTES, recommendation.maxMinutes)
+                    putInt(ARG_DURATION_SCORE, result.durationScore)
+                    putInt(ARG_DURATION_WEIGHT, result.durationWeight)
+                    putInt(ARG_DEEP_SCORE, result.deepSleepScore)
+                    putInt(ARG_DEEP_WEIGHT, result.deepSleepWeight)
+                    putInt(ARG_REM_SCORE, result.remSleepScore)
+                    putInt(ARG_REM_WEIGHT, result.remSleepWeight)
+                    putInt(ARG_CONTINUITY_SCORE, result.continuityScore)
+                    putInt(ARG_CONTINUITY_WEIGHT, result.continuityWeight)
+                }
+            }
+        }
+    }
+}
