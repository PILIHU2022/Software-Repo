+    /**
+     * The sessions that ended on the selected day, in full. The sleep-range preference shifts the
+     * charts' evening window, but a night belongs to the day it ends on, so the widgets always use
+     * the calendar day here.
+     */
+    private fun sleepSessionsEndingOnDay(db: DBHandler, device: GBDevice): List<SleepSession> {
+        val from = dayStart.toInt() - 1
+        val to = day.plusDays(1).atStartOfDay(zone).toEpochSecond().toInt() - 1
+        return device.deviceCoordinator.getSleepSessionProvider(device, db.daoSession)
+            .getSleepSessionsEndingIn(from, to)
+    }
+
+    /**
+     * Asleep minutes of the sessions that ended on the selected day, awake excluded, averaged over
+     * the devices that recorded any, like [sleepMinutesTotal].
+     */
+    suspend fun sleepMinutesEndingOnDay(): Long = db { db ->
+        val sleepValues = devices.filter { it.deviceCoordinator.supportsSleepMeasurement(it) }
+            .map { dev ->
+                // Includes SLEEP_ANY, so a device that records whole sessions without a stage
+                // breakdown still reports its sleep instead of zero.
+                val minutes = sleepSessionsEndingOnDay(db, dev).sumOf {
+                    it.totalSleepDuration
+                } / 60
+                // Fall back to the upstream totals when the provider returns no session, so a
+                // device whose session query is empty does not turn the dashboard into zero.
+                if (minutes > 0) minutes else dailyTotals(db, dev).sleep
+            }
+            .filter { it > 0 }
+        if (sleepValues.isEmpty()) 0L else sleepValues.average().roundToInt().toLong()
+    }
+
+    /**
+     * Light, deep, REM and awake minutes of the sessions that ended on the selected day, averaged
+     * over the devices that recorded sleep.
+     */
+    suspend fun sleepStageMinutesEndingOnDay(): LongArray = db { db ->
+        val stages = devices.filter { it.deviceCoordinator.supportsSleepMeasurement(it) }
+            .mapNotNull { dev ->
+                val sessions = sleepSessionsEndingOnDay(db, dev)
+                if (sessions.any { it.totalSleepDuration > 0 }) {
+                    longArrayOf(
+                        sessions.sumOf { it.lightSleepDuration },
+                        sessions.sumOf { it.deepSleepDuration },
+                        sessions.sumOf { it.remSleepDuration },
+                        sessions.sumOf { it.awakeSleepDuration },
+                    ).map { it / 60L }.toLongArray()
+                } else {
+                    // Same fallback as sleepMinutesEndingOnDay().
+                    dailyTotals(db, dev).sleepStages.takeIf { totals -> totals.any { it > 0 } }
+                }
+            }
+        LongArray(4) { stage -> if (stages.isEmpty()) 0L else stages.map { it[stage] }.average().roundToInt().toLong() }
+    }
+
