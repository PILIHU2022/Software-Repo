+    along with this program.  If not, see <https://www.gnu.org/licenses/>. */
+package nodomain.freeyourgadget.gadgetbridge.util.sleep;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+
+import nodomain.freeyourgadget.gadgetbridge.model.ActivityKind;
+import nodomain.freeyourgadget.gadgetbridge.model.SleepSession;
+import nodomain.freeyourgadget.gadgetbridge.model.SleepStage;
+
+public class AgeSleepScoreCalculatorTest {
+    private static final long HOUR = 60 * 60;
+    private static final long MINUTE = 60;
+
+    @Test
+    public void recommendedDurationFollowsAge() {
+        assertEquals(8 * 60, AgeSleepScoreCalculator.recommendationForAge(16).getMinMinutes());
+        assertEquals(10 * 60, AgeSleepScoreCalculator.recommendationForAge(16).getMaxMinutes());
+        assertEquals(7 * 60, AgeSleepScoreCalculator.recommendationForAge(30).getMinMinutes());
+        assertEquals(9 * 60, AgeSleepScoreCalculator.recommendationForAge(30).getMaxMinutes());
+        assertEquals(7 * 60, AgeSleepScoreCalculator.recommendationForAge(70).getMinMinutes());
+        assertEquals(8 * 60, AgeSleepScoreCalculator.recommendationForAge(70).getMaxMinutes());
+        // An unknown age must not produce an empty or invalid range.
+        assertEquals(7 * 60, AgeSleepScoreCalculator.recommendationForAge(0).getMinMinutes());
+        assertEquals(9 * 60, AgeSleepScoreCalculator.recommendationForAge(0).getMaxMinutes());
+    }
+
+    @Test
+    public void deepSleepTargetDeclinesWithAge() {
+        assertTrue(AgeSleepScoreCalculator.deepSleepTargetRatio(20)
+                > AgeSleepScoreCalculator.deepSleepTargetRatio(45));
+        assertTrue(AgeSleepScoreCalculator.deepSleepTargetRatio(45)
+                > AgeSleepScoreCalculator.deepSleepTargetRatio(70));
+    }
+
+    @Test
+    public void adequateSleepScoresHigh() {
+        final AgeSleepScoreCalculator.Result result = AgeSleepScoreCalculator.calculate(
+                30, 8 * HOUR, (long) (8 * HOUR * 0.20), (long) (8 * HOUR * 0.22), 20 * MINUTE);
+        assertTrue(result.getScore() >= 90);
+        assertEquals(50, result.getDurationScore());
+    }
+
+    @Test
+    public void shortSleepScoresLowerThanAdequateSleep() {
+        final AgeSleepScoreCalculator.Result eightHours = AgeSleepScoreCalculator.calculate(30, 8 * HOUR, 0, 0, 0);
+        final AgeSleepScoreCalculator.Result fiveHours = AgeSleepScoreCalculator.calculate(30, 5 * HOUR, 0, 0, 0);
+
+        assertTrue(fiveHours.getScore() < eightHours.getScore());
+    }
+
+    @Test
+    public void oversleepingIsPenalizedButLessThanUndersleeping() {
+        final AgeSleepScoreCalculator.Result adequate = AgeSleepScoreCalculator.calculate(30, 8 * HOUR, 0, 0, 0);
+        final AgeSleepScoreCalculator.Result oversleeping = AgeSleepScoreCalculator.calculate(30, 12 * HOUR, 0, 0, 0);
+        final AgeSleepScoreCalculator.Result undersleeping = AgeSleepScoreCalculator.calculate(30, 4 * HOUR, 0, 0, 0);
+
+        assertTrue(oversleeping.getScore() < adequate.getScore());
+        assertTrue(oversleeping.getScore() > undersleeping.getScore());
+    }
+
+    @Test
+    public void sameSleepStagesScoreDifferentlyForDifferentAges() {
+        // 13% deep sleep is normal for an older adult, but low for a young adult.
+        final long asleep = 8 * HOUR;
+        final long deep = (long) (asleep * 0.13);
+        final long rem = (long) (asleep * 0.22);
+        final AgeSleepScoreCalculator.Result younger = AgeSleepScoreCalculator.calculate(25, asleep, deep, rem, 0);
+        final AgeSleepScoreCalculator.Result older = AgeSleepScoreCalculator.calculate(70, asleep, deep, rem, 0);
+
+        assertTrue(older.getDeepSleepScore() > younger.getDeepSleepScore());
+        assertTrue(older.getScore() > younger.getScore());
+    }
+
+    @Test
+    public void missingStageBreakdownFallsBackToDuration() {
+        final AgeSleepScoreCalculator.Result result = AgeSleepScoreCalculator.calculate(30, 8 * HOUR, 0, 0, 0);
+
+        assertEquals(0, result.getDeepSleepWeight());
+        assertEquals(0, result.getRemSleepWeight());
+        assertEquals(0, result.getContinuityWeight());
+        assertEquals(100, result.getScore());
+    }
+
+    @Test
+    public void missingSingleStageIsNotScoredAsZero() {
+        // A tracker that records deep sleep but no REM must not be penalized for the missing stage.
+        final AgeSleepScoreCalculator.Result deepOnly = AgeSleepScoreCalculator.calculate(
+                30, 8 * HOUR, (long) (8 * HOUR * 0.20), 0, 0);
+        assertEquals(20, deepOnly.getDeepSleepWeight());
+        assertEquals(0, deepOnly.getRemSleepWeight());
+        assertEquals(100, deepOnly.getScore());
+
+        final AgeSleepScoreCalculator.Result remOnly = AgeSleepScoreCalculator.calculate(
+                30, 8 * HOUR, 0, (long) (8 * HOUR * 0.22), 0);
+        assertEquals(0, remOnly.getDeepSleepWeight());
+        assertEquals(15, remOnly.getRemSleepWeight());
+        assertEquals(100, remOnly.getScore());
+    }
+
+    @Test
+    public void missingAwakeStageDoesNotAwardContinuityPoints() {
+        final AgeSleepScoreCalculator.Result result = AgeSleepScoreCalculator.calculate(
+                30, 8 * HOUR, (long) (8 * HOUR * 0.20), (long) (8 * HOUR * 0.22), 0);
+
+        assertEquals(0, result.getContinuityWeight());
+        assertEquals(0, result.getContinuityScore());
+    }
+
+    @Test
+    public void continuityScoreUsesSleepEfficiency() {
+        final AgeSleepScoreCalculator.Result result = AgeSleepScoreCalculator.calculate(
+                30, 8 * HOUR, (long) (8 * HOUR * 0.20), (long) (8 * HOUR * 0.22), 2 * HOUR);
+
+        assertEquals(15, result.getContinuityWeight());
+        // 8h asleep / 10h in bed = 80%, against a 90% target.
+        assertEquals(13, result.getContinuityScore());
+    }
+
+    @Test
+    public void emptyNightScoresZero() {
+        assertEquals(0, AgeSleepScoreCalculator.calculate(30, 0, 0, 0, 0).getScore());
+        assertEquals(0, AgeSleepScoreCalculator.calculate(30, Collections.emptyList()).getScore());
+    }
+
+    @Test
+    public void scoreIsAlwaysWithinBounds() {
+        final long[][] nights = {
+                {0, 0, 0, 0},
+                {1 * HOUR, 0, 0, 0},
+                {20 * HOUR, 20 * HOUR, 20 * HOUR, 20 * HOUR},
+                {8 * HOUR, 8 * HOUR, 8 * HOUR, 8 * HOUR},
+        };
+        for (final long[] night : nights) {
+            final AgeSleepScoreCalculator.Result result = AgeSleepScoreCalculator.calculate(
+                    30, night[0], night[1], night[2], night[3]);
+            assertTrue(result.getScore() >= 0);
+            assertTrue(result.getScore() <= 100);
+        }
+    }
+
+    @Test
+    public void sessionsAreAggregatedIntoOneNight() {
+        final SleepSession first = session(4 * HOUR, 0.20, 0.22, 0);
+        final SleepSession second = session(4 * HOUR, 0.20, 0.22, 0);
+        final AgeSleepScoreCalculator.Result result = AgeSleepScoreCalculator.calculate(30, Arrays.asList(first, second));
+
+        assertEquals(8 * HOUR, result.getTotalSleepSeconds());
+        assertEquals((long) (8 * HOUR * 0.20), result.getDeepSleepSeconds());
+        assertTrue(result.getScore() >= 90);
+    }
+
+    @Test
+    public void defaultAgeIsUsedForImplausibleAges() {
+        assertEquals(AgeSleepScoreCalculator.DEFAULT_AGE, AgeSleepScoreCalculator.normalizeAge(-5));
+        assertEquals(AgeSleepScoreCalculator.DEFAULT_AGE, AgeSleepScoreCalculator.normalizeAge(0));
+        assertEquals(AgeSleepScoreCalculator.DEFAULT_AGE, AgeSleepScoreCalculator.normalizeAge(200));
+        assertEquals(42, AgeSleepScoreCalculator.normalizeAge(42));
+    }
+
+    private static SleepSession session(final long totalSeconds,
+                                        final double deepRatio,
+                                        final double remRatio,
+                                        final long awakeSeconds) {
+        final long deepSeconds = (long) (totalSeconds * deepRatio);
+        final long remSeconds = (long) (totalSeconds * remRatio);
+        final long lightSeconds = totalSeconds - deepSeconds - remSeconds;
+
+        final long start = 1_700_000_000_000L;
+        long cursor = start;
+        final java.util.List<SleepStage> stages = new java.util.ArrayList<>();
+        stages.add(new SleepStage(ActivityKind.LIGHT_SLEEP, cursor, cursor + lightSeconds * 1000L));
+        cursor += lightSeconds * 1000L;
+        stages.add(new SleepStage(ActivityKind.DEEP_SLEEP, cursor, cursor + deepSeconds * 1000L));
+        cursor += deepSeconds * 1000L;
+        stages.add(new SleepStage(ActivityKind.REM_SLEEP, cursor, cursor + remSeconds * 1000L));
+        cursor += remSeconds * 1000L;
+        if (awakeSeconds > 0) {
+            stages.add(new SleepStage(ActivityKind.AWAKE_SLEEP, cursor, cursor + awakeSeconds * 1000L));
+        }
+        return new SleepSession(stages);
+    }
+}
