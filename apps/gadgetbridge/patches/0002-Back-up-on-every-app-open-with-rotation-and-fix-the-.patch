+/**
+ * The backup that runs when the user opens the app.
+ *
+ * This intentionally uses no background scheduling at all: the only moment a backup is guaranteed
+ * to happen is when the user launches the app, because aggressive vendor ROMs and Doze routinely
+ * never run WorkManager jobs, which is how backups can silently stop for weeks.
+ *
+ * Every run writes a new {@code gadgetbridge_yyyyMMddHHmmss.zip} through a temporary file, so a
+ * failing run can never destroy an existing backup, and then deletes the backups that are older
+ * than the retention period.
+ */
+object OnOpenBackupRunner {
+    private val LOG = LoggerFactory.getLogger(OnOpenBackupRunner::class.java)
+
+    /** A backup that succeeded this recently makes a new on-open backup pointless. */
+    const val MIN_INTERVAL_MILLIS: Long = 60_000L
+
+    /** The database this backup contains, used to tell whether it changed since the last run. */
+    private const val DATABASE_NAME = "Gadgetbridge"
+
+    /** SQLite sidecar files, which change even when the database file itself does not. */
+    private val DATABASE_SIDECAR_SUFFIXES = arrayOf("-journal", "-wal", "-shm")
+
+    /** Stale temporary files of crashed runs are removed after this many hours. */
+    private const val STALE_TEMP_FILE_AGE_HOURS = 24L
+
+    /** Guards against two backups writing at the same time, e.g. an app open during a manual run. */
+    private val running = AtomicBoolean(false)
+
+    /** The outcome of a backup, for the settings screen and for the callers of [runNow]. */
+    data class Result(
+        val success: Boolean,
+        val message: String,
+        val fileName: String?,
+    )
+
+    /**
+     * Runs a backup right now. This is the manual trigger of the settings screen, so it ignores the
+     * enable switch and the [MIN_INTERVAL_MILLIS] throttle; it does not ignore a backup that is
+     * already running and returns a "busy" [Result] for it.
+     *
+     * This method blocks until the backup has been written, call it from a background thread.
+     */
+    @JvmStatic
+    @WorkerThread
+    fun runNow(context: Context): Result {
+        val appContext = context.applicationContext ?: context
+
+        return try {
+            val storage = BackupStorages.forOnOpenBackup(appContext)
+            if (storage == null) {
+                val message = "no writable backup directory"
+                LOG.error("Unable to run the on-open backup: {}", message)
+                OnOpenBackupPrefs.recordFailure(message)
+                Result(false, message, null)
+            } else {
+                export(appContext, storage, null, recordResult = true)
+            }
+        } catch (t: Throwable) {
+            LOG.error("Failed to run the on-open backup", t)
+            val message = t.message ?: t.javaClass.simpleName
+            recordFailureQuietly(message)
+            Result(false, message, null)
+        }
+    }
+
+    /**
+     * Triggers the on-open backup in the background, called from the launcher activity.
+     *
+     * Does nothing when the feature is disabled, when a backup is already running, or when the last
+     * successful backup is less than [MIN_INTERVAL_MILLIS] ago. It never blocks the caller and never
+     * throws.
+     */
+    @JvmStatic
+    fun triggerOnAppOpen(context: Context) {
+        try {
+            // Robolectric tests start the launcher activity too, and must not write backups
+            if (GBEnvironment.env()?.isTest == true) {
+                LOG.debug("Not running the on-open backup in a test environment")
+                return
+            }
+
+            if (!OnOpenBackupPrefs.isEnabled()) {
+                LOG.debug("Not running the on-open backup, it is disabled")
+                return
+            }
+
+            if (running.get()) {
+                LOG.info("Not running the on-open backup, another backup is already running")
+                return
+            }
+
+            val lastRun = OnOpenBackupPrefs.lastRun()
+            if (lastRun > 0L && System.currentTimeMillis() - lastRun < MIN_INTERVAL_MILLIS) {
+                LOG.debug("Not running the on-open backup, the last one is too recent")
+                return
+            }
+
+            val appContext = context.applicationContext ?: context
+
+            // Nothing to back up when neither the database nor the preferences changed since the
+            // last backup: writing another 20MB copy of the same data on every app open would fill
+            // the storage without giving the user anything to restore. A changed database (a sync)
+            // or changed preferences always produce a new backup.
+            if (lastRun > 0L && !hasDataChangedSince(appContext, lastRun)) {
+                LOG.debug("Not running the on-open backup, nothing changed since the last one")
+                return
+            }
+
+            val thread = Thread({
+                try {
+                    val result = runNow(appContext)
+                    if (result.success) {
+                        LOG.info("On-open backup finished: {}", result.message)
+                    } else {
+                        LOG.warn("On-open backup failed: {}", result.message)
+                    }
+                } catch (t: Throwable) {
+                    // runNow does not throw, but a backup must never take the app down
+                    LOG.error("On-open backup crashed", t)
+                }
+            }, "on-open-backup")
+            thread.isDaemon = true
+            thread.start()
+        } catch (t: Throwable) {
+            LOG.error("Failed to trigger the on-open backup", t)
+        }
+    }
+
+    /**
+     * Whether the database or the preferences were modified after [whenMillis].
+     *
+     * A backup only contains the database, the preferences and the external files, so if none of
+     * those changed there is nothing new to write. The external files are left out of the check
+     * because they are rewritten by every sync that reports a raw fetch operation, and a missed
+     * backup is worse than a redundant one.
+     */
+    private fun hasDataChangedSince(context: Context, whenMillis: Long): Boolean {
+        return try {
+            if (lastModifiedOfDatabase(context) > whenMillis) {
+                return true
+            }
+            if (lastModifiedOfPreferences(context) > whenMillis) {
+                return true
+            }
+            false
+        } catch (t: Throwable) {
+            // When in doubt, write the backup
+            LOG.warn("Failed to determine whether the data changed, backing up anyway", t)
+            true
+        }
+    }
+
+    private fun lastModifiedOfDatabase(context: Context): Long {
+        val databaseFile = context.getDatabasePath(DATABASE_NAME)
+        var newest = databaseFile.lastModified()
+        for (suffix in DATABASE_SIDECAR_SUFFIXES) {
+            val sidecar = File(databaseFile.parentFile, databaseFile.name + suffix)
+            if (sidecar.exists()) {
+                newest = maxOf(newest, sidecar.lastModified())
+            }
+        }
+        return newest
+    }
+
+    private fun lastModifiedOfPreferences(context: Context): Long {
+        val prefsDir = File(context.applicationInfo.dataDir, "shared_prefs")
+        val files = prefsDir.listFiles() ?: return 0L
+        var newest = 0L
+        for (file in files) {
+            if (file.isFile) {
+                newest = maxOf(newest, file.lastModified())
+            }
+        }
+        return newest
+    }
+
+    /**
+     * Deletes the backups that are older than the retention period.
+     *
+     * @return the number of deleted files, or -1 when the directory could not be read or pruned.
+     * This method blocks, call it from a background thread.
+     */
+    @JvmStatic
+    @WorkerThread
+    fun pruneNow(context: Context): Int {
+        val appContext = context.applicationContext ?: context
+
+        return try {
+            val storage = BackupStorages.forOnOpenBackup(appContext)
+            if (storage == null) {
+                LOG.error("Unable to prune the backups, there is no backup directory")
+                -1
+            } else {
+                prune(storage)
+            }
+        } catch (t: Throwable) {
+            LOG.error("Failed to prune the backups", t)
+            -1
+        }
+    }
+
+    /**
+     * Writes a timestamped backup into [storage] and prunes the expired ones.
+     *
+     * Used by the periodic zip exporter too, which is why the result is not recorded in the
+     * on-open backup preferences unless [recordResult] is set. The optional [callback] receives the
+     * progress of the export (e.g. to update a notification) and is notified when the export
+     * finished but the file could not be written.
+     */
+    @WorkerThread
+    internal fun export(
+        context: Context,
+        storage: BackupStorage,
+        callback: ZipBackupCallback?,
+        recordResult: Boolean,
+    ): Result {
+        if (!running.compareAndSet(false, true)) {
+            val message = "a backup is already running"
+            LOG.warn("Not writing a backup into {}: {}", storage.describe(), message)
+            return Result(false, message, null)
+        }
+
+        var cleanupFile: File? = null
+
+        try {
+            deleteStaleTempFiles(context)
+
+            val tempFile = ZipBackupExportJob.createTempFile(context)
+            cleanupFile = tempFile
+
+            val listener = CapturingCallback(callback)
+            ZipBackupExportJob(context, listener, tempFile).run()
+
+            val exportError = listener.failureMessage
+                ?: if (!listener.succeeded) "the export did not complete" else null
+            if (exportError != null) {
+                LOG.error("Failed to export the backup: {}", exportError)
+                if (recordResult) {
+                    recordFailureQuietly(exportError)
+                }
+                return Result(false, exportError, null)
+            }
+
+            val fileName = OnOpenBackupPrefs.fileNameFor(LocalDateTime.now())
+            val writtenName = storage.writeBackup(fileName, tempFile)
+            if (writtenName == null) {
+                val message = "failed to write $fileName to ${storage.describe()}"
+                LOG.error("Failed to write the backup: {}", message)
+                // The export itself worked, so the user (e.g. of the periodic export) still needs
+                // to know that no backup was produced
+                callback?.onFailure(message)
+                if (recordResult) {
+                    recordFailureQuietly(message)
+                }
+                return Result(false, message, null)
+            }
+
+            if (recordResult) {
+                OnOpenBackupPrefs.recordSuccess(writtenName, System.currentTimeMillis())
+            }
+
+            val deleted = pruneQuietly(storage)
+
+            val sizeBytes = tempFile.length()
+            val message = buildString {
+                append("wrote ").append(writtenName).append(" to ").append(storage.describe())
+                if (deleted > 0) {
+                    append(", deleted ").append(deleted).append(" expired backup(s)")
+                }
+            }
+            // The size makes a successful backup verifiable on-device with adb logcat
+            LOG.info("Backup finished: {} ({} bytes)", message, sizeBytes)
+
+            return Result(true, message, writtenName)
+        } catch (t: Throwable) {
+            LOG.error("Failed to write the backup", t)
+            val message = t.message ?: t.javaClass.simpleName
+            callback?.onFailure(message)
+            if (recordResult) {
+                recordFailureQuietly(message)
+            }
+            return Result(false, message, null)
+        } finally {
+            running.set(false)
+            cleanupFile?.let { file ->
+                if (file.exists() && !file.delete()) {
+                    LOG.warn("Unable to delete the temporary file {}", file)
+                }
+            }
+        }
+    }
+
+    /**
+     * Writes a timestamped backup into [storage] for the periodic zip export. The run is not
+     * recorded in the on-open backup preferences, since it was not an app open, but the retention
+     * of the target directory is applied.
+     */
+    @WorkerThread
+    internal fun exportToStorage(
+        context: Context,
+        storage: BackupStorage,
+        callback: ZipBackupCallback?,
+    ): Result = export(context, storage, callback, recordResult = false)
+
+    private fun prune(storage: BackupStorage): Int {
+        val retentionDays = OnOpenBackupPrefs.retentionDays()
+        val fileNames = storage.listBackupFiles()
+        val deletable = BackupRetention.filesToDelete(fileNames, LocalDate.now(), retentionDays)
+
+        var deleted = 0
+        for (fileName in deletable) {
+            if (storage.deleteBackup(fileName)) {
+                deleted++
+            } else {
+                LOG.warn("Unable to delete the expired backup {}", fileName)
+            }
+        }
+
+        LOG.info(
+            "Deleted {} of {} expired backups in {} (retention: {} days)",
+            deleted,
+            deletable.size,
+            storage.describe(),
+            retentionDays,
+        )
+        return deleted
+    }
+
+    private fun pruneQuietly(storage: BackupStorage): Int {
+        return try {
+            prune(storage)
+        } catch (t: Throwable) {
+            // An expired backup that stays behind is not a reason to report a failed backup
+            LOG.warn("Failed to delete the expired backups in {}", storage.describe(), t)
+            0
+        }
+    }
+
+    private fun recordFailureQuietly(message: String) {
+        try {
+            OnOpenBackupPrefs.recordFailure(message)
+        } catch (t: Throwable) {
+            LOG.warn("Failed to record the backup failure", t)
+        }
+    }
+
+    /** Removes the temporary files a crashed earlier run may have left in the cache dir. */
+    private fun deleteStaleTempFiles(context: Context) {
+        try {
+            val cacheDir = context.cacheDir ?: return
+            val cutoff = System.currentTimeMillis() - TimeUnit.HOURS.toMillis(STALE_TEMP_FILE_AGE_HOURS)
+            cacheDir.listFiles()?.forEach { file ->
+                if (file.isFile && file.name.startsWith(ZipBackupExportJob.TEMP_FILE_PREFIX) && file.lastModified() < cutoff) {
+                    if (!file.delete()) {
+                        LOG.warn("Unable to delete the stale temporary file {}", file)
+                    }
+                }
+            }
+        } catch (t: Throwable) {
+            LOG.debug("Failed to delete the stale temporary files", t)
+        }
+    }
+
+    /**
+     * Forwards the progress of the export to the real callback and remembers whether the export
+     * succeeded, so that a failure before anything was written can be reported.
+     */
+    private class CapturingCallback(private val delegate: ZipBackupCallback?) : ZipBackupCallback {
+        var succeeded: Boolean = false
+            private set
+
+        var failureMessage: String? = null
+            private set
+
+        override fun onProgress(progress: Int, message: String?) {
+            delegate?.onProgress(progress, message)
+        }
+
+        override fun onSuccess(warnings: String?) {
+            succeeded = true
+            delegate?.onSuccess(warnings)
+        }
+
+        override fun onFailure(errorMessage: String?) {
+            failureMessage = errorMessage ?: "unknown error"
+            delegate?.onFailure(errorMessage)
+        }
+
+        override fun onConfirmationRequired(message: String) {
+            delegate?.onConfirmationRequired(message)
+        }
+    }
+}
