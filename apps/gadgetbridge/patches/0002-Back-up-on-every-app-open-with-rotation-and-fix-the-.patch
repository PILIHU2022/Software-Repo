+++ b/app/src/test/java/nodomain/freeyourgadget/gadgetbridge/util/backup/OnOpenBackupRetentionTest.kt
@@ -0,0 +1,154 @@
+/*  Copyright (C) 2026 Gadgetbridge contributors
