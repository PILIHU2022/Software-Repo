+package nodomain.freeyourgadget.gadgetbridge.util.backup
+
+import java.time.LocalDate
+
+/**
+ * Decides which backup files the retention deletes.
+ *
+ * This deliberately contains no Android code at all, so the decision can be unit tested on a
+ * plain JVM: the only thing that can go wrong here is deleting a file the user still needs.
+ */
+object BackupRetention {
+    /**
+     * The oldest date that is still kept: the last [retentionDays] days, today inclusive. A
+     * retention of 1 only keeps today's backups, a retention of 7 keeps today and the previous
+     * six days.
+     */
+    fun cutoff(today: LocalDate, retentionDays: Int): LocalDate {
+        // A retention of 0 or less would delete everything, which must never happen
+        val days = retentionDays.coerceAtLeast(1).toLong()
+        return today.minusDays(days - 1L)
+    }
+
+    /**
+     * Whether the backup file [fileName] is older than the retention period and can be deleted.
+     * Anything that is not a backup file this feature wrote is never deleted.
+     */
+    fun shouldDelete(fileName: String, today: LocalDate, retentionDays: Int): Boolean {
+        val date = OnOpenBackupPrefs.dateOf(fileName) ?: return false
+        return date.isBefore(cutoff(today, retentionDays))
+    }
+
+    /**
+     * The backup files to delete from [fileNames], which may contain any files of the directory.
+     *
+     * The newest backup we have is always kept, even when it is older than the retention period: if
+     * the backups have been failing for a while, pruning must not leave the user without any backup.
+     */
+    fun filesToDelete(
+        fileNames: Collection<String>,
+        today: LocalDate,
+        retentionDays: Int,
+    ): List<String> {
+        val ourFiles = fileNames.filter { OnOpenBackupPrefs.isBackupFileName(it) }
+        // The file name is gadgetbridge_yyyyMMddHHmmss.zip, so the plain string order is the age order
+        val newest = ourFiles.maxOrNull()
+        return ourFiles.filter { it != newest && shouldDelete(it, today, retentionDays) }
+    }
+}
