+package nodomain.freeyourgadget.gadgetbridge.util.backup
+
+import android.content.ContentResolver
+import android.content.Context
+import android.net.Uri
+import android.provider.DocumentsContract
+import androidx.core.net.toUri
+import nodomain.freeyourgadget.gadgetbridge.util.FileUtils
+import org.slf4j.LoggerFactory
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+
+private val LOG = LoggerFactory.getLogger(BackupStorage::class.java)
+
+private const val COPY_BUFFER_SIZE = 64 * 1024
+private const val MIME_TYPE_ZIP = "application/zip"
+
+/**
+ * A directory that backups are written into, either a SAF tree the user picked or a plain
+ * directory of the app.
+ *
+ * Every backup is written as a new file with a timestamped name, so an existing backup is
+ * never touched by a failing run. Implementations do not throw on [writeBackup] and
+ * [deleteBackup]: they report failure with the return value and remove any partial file they
+ * created themselves.
+ */
+interface BackupStorage {
+    /** Human readable description of the target, only used for logging and for user messages. */
+    fun describe(): String
+
+    /** Names of all files in the target directory, so that retention can inspect them. */
+    fun listBackupFiles(): List<String>
+
+    /**
+     * Writes [source] into the target directory as [fileName].
+     *
+     * @return the name of the created file, which can differ from [fileName] when the document
+     * provider renames it, or null if the backup could not be written, in which case no partial
+     * file is left behind.
+     */
+    fun writeBackup(fileName: String, source: File): String?
+
+    /** Deletes the backup file [fileName], returning whether it was deleted. */
+    fun deleteBackup(fileName: String): Boolean
+}
+
+/**
+ * Backups in a plain directory, used when the user did not pick a folder (or picked one the app
+ * cannot write to).
+ */
+internal class FileBackupStorage(private val dir: File) : BackupStorage {
+    override fun describe(): String = dir.absolutePath
+
+    override fun listBackupFiles(): List<String> = dir.list()?.toList() ?: emptyList()
+
+    override fun writeBackup(fileName: String, source: File): String? {
+        val target = File(dir, fileName)
+        // Write next to the target first, so that a half copied file never gets a valid backup name
+        val partial = File(dir, "$fileName.part")
+        return try {
+            if (!dir.isDirectory && !dir.mkdirs()) {
+                throw IOException("Unable to create the directory $dir")
+            }
+
+            source.inputStream().use { input ->
+                FileOutputStream(partial).use { output ->
+                    input.copyTo(output, COPY_BUFFER_SIZE)
+                    output.flush()
+                    output.fd.sync()
+                }
+            }
+
+            if (partial.length() != source.length()) {
+                throw IOException("Copied ${partial.length()} of ${source.length()} bytes to $partial")
+            }
+
+            if (!partial.renameTo(target)) {
+                throw IOException("Unable to rename $partial to $target")
+            }
+
+            LOG.info("Wrote backup {} to {}", target.name, dir)
+            target.name
+        } catch (e: Exception) {
+            LOG.error("Failed to write the backup {} into {}", fileName, dir, e)
+            partial.delete()
+            null
+        }
+    }
+
+    override fun deleteBackup(fileName: String): Boolean {
+        return try {
+            File(dir, fileName).delete()
+        } catch (e: Exception) {
+            LOG.warn("Failed to delete the backup {}", fileName, e)
+            false
+        }
+    }
+}
+
+/**
+ * Backups in a SAF tree the user picked with {@code ACTION_OPEN_DOCUMENT_TREE}.
+ *
+ * A new document is created for every backup: a persisted document uri points at a single file,
+ * which cannot be written without truncating it first.
+ */
+internal class SafBackupStorage(
+    private val context: Context,
+    private val treeUri: Uri,
+) : BackupStorage {
+    private val resolver: ContentResolver
+        get() = context.contentResolver
+
+    /** The document uri of the tree itself, the parent of all the backups. */
+    private val parentUri: Uri
+        get() = DocumentsContract.buildDocumentUriUsingTree(treeUri, DocumentsContract.getTreeDocumentId(treeUri))
+
+    private val childrenUri: Uri
+        get() = DocumentsContract.buildChildDocumentsUriUsingTree(treeUri, DocumentsContract.getTreeDocumentId(treeUri))
+
+    /** Last known children of the tree, so a deletion does not need to query the provider again. */
+    private var knownChildren: Map<String, Uri>? = null
+
+    override fun describe(): String = treeUri.toString()
+
+    override fun listBackupFiles(): List<String> {
+        val children = queryChildren()
+        knownChildren = children
+        return children.keys.toList()
+    }
+
+    override fun writeBackup(fileName: String, source: File): String? {
+        var documentUri: Uri? = null
+        try {
+            val createdUri = DocumentsContract.createDocument(resolver, parentUri, MIME_TYPE_ZIP, fileName)
+                ?: throw IOException("The document provider did not create a document for $fileName")
+            documentUri = createdUri
+
+            val actualName = displayNameOf(createdUri) ?: fileName
+
+            val outputStream = resolver.openOutputStream(createdUri, "wt")
+                ?: throw IOException("Unable to open an output stream for $createdUri")
+            outputStream.use { output ->
+                source.inputStream().use { input ->
+                    input.copyTo(output, COPY_BUFFER_SIZE)
+                }
+                output.flush()
+            }
+
+            knownChildren = null
+
+            // A provider that reports a stale or unknown size is not a reason to fail the backup
+            val writtenSize = sizeOf(createdUri)
+            if (writtenSize >= 0 && writtenSize != source.length()) {
+                LOG.warn(
+                    "The provider reports {} bytes for {}, expected {} bytes",
+                    writtenSize,
+                    actualName,
+                    source.length(),
+                )
+            }
+
+            LOG.info("Wrote backup {} to {}", actualName, treeUri)
+            return actualName
+        } catch (e: Exception) {
+            LOG.error("Failed to write the backup {} into {}", fileName, treeUri, e)
+            documentUri?.let { deleteDocumentQuietly(it) }
+            knownChildren = null
+            return null
+        }
+    }
+
+    override fun deleteBackup(fileName: String): Boolean {
+        val documentUri = knownChildren?.get(fileName) ?: findChild(fileName)
+        if (documentUri == null) {
+            return false
+        }
+
+        return deleteDocumentQuietly(documentUri)
+    }
+
+    private fun findChild(fileName: String): Uri? {
+        return try {
+            queryChildren()[fileName]
+        } catch (e: Exception) {
+            LOG.warn("Failed to list the children of {}", treeUri, e)
+            null
+        }
+    }
+
+    private fun queryChildren(): Map<String, Uri> {
+        val result = LinkedHashMap<String, Uri>()
+
+        resolver.query(
+            childrenUri,
+            arrayOf(
+                DocumentsContract.Document.COLUMN_DOCUMENT_ID,
+                DocumentsContract.Document.COLUMN_DISPLAY_NAME,
+            ),
+            null,
+            null,
+            null,
+        )?.use { cursor ->
+            while (cursor.moveToNext()) {
+                val documentId = cursor.getString(0) ?: continue
+                val displayName = cursor.getString(1) ?: continue
+                result[displayName] = DocumentsContract.buildDocumentUriUsingTree(treeUri, documentId)
+            }
+        }
+
+        return result
+    }
+
+    private fun displayNameOf(documentUri: Uri): String? {
+        return try {
+            resolver.query(
+                documentUri,
+                arrayOf(DocumentsContract.Document.COLUMN_DISPLAY_NAME),
+                null,
+                null,
+                null,
+            )?.use { cursor ->
+                if (cursor.moveToFirst() && !cursor.isNull(0)) cursor.getString(0) else null
+            }
+        } catch (e: Exception) {
+            LOG.warn("Failed to read the name of {}", documentUri, e)
+            null
+        }
+    }
+
+    /** @return the size of the document, or -1 when the provider does not report it. */
+    private fun sizeOf(documentUri: Uri): Long {
+        return try {
+            resolver.query(
+                documentUri,
+                arrayOf(DocumentsContract.Document.COLUMN_SIZE),
+                null,
+                null,
+                null,
+            )?.use { cursor ->
+                if (cursor.moveToFirst() && !cursor.isNull(0)) cursor.getLong(0) else -1L
+            } ?: -1L
+        } catch (e: Exception) {
+            LOG.debug("Failed to read the size of {}", documentUri, e)
+            -1L
+        }
+    }
+
+    private fun deleteDocumentQuietly(documentUri: Uri): Boolean {
+        return try {
+            knownChildren = null
+            DocumentsContract.deleteDocument(resolver, documentUri)
+        } catch (e: Exception) {
+            LOG.warn("Failed to delete {}", documentUri, e)
+            false
+        }
+    }
+}
+
+/**
+ * Resolves the directory the backups are written into.
+ */
+internal object BackupStorages {
+    /** The folder under the app's external files dir that is used when no location is set. */
+    fun defaultBackupDir(): File = File(FileUtils.getExternalFilesDir(), AbstractZipBackupJob.BACKUP_DIR)
+
+    /**
+     * The directory for the backup that runs when the app is opened: the SAF tree the user picked,
+     * or the app's own backup folder when there is none. A stored value that is not a tree is
+     * ignored, since a persisted single document cannot be used to create new files next to it.
+     */
+    fun forOnOpenBackup(context: Context): BackupStorage? {
+        val location = OnOpenBackupPrefs.location()
+        if (location != null) {
+            val uri = location.toUri()
+            if (DocumentsContract.isTreeUri(uri)) {
+                return SafBackupStorage(context, uri)
+            }
+            LOG.warn(
+                "Ignoring the backup location {}, it is not a directory; using the default directory",
+                location,
+            )
+        }
+
+        return try {
+            val dir = defaultBackupDir()
+            if (!dir.isDirectory && !dir.mkdirs()) {
+                LOG.error("Unable to create the default backup directory {}", dir)
+                null
+            } else {
+                FileBackupStorage(dir)
+            }
+        } catch (e: Exception) {
+            LOG.error("Unable to resolve the default backup directory", e)
+            null
+        }
+    }
+
+    /**
+     * The directory for the periodic zip export, which stores its location in a different
+     * preference.
+     *
+     * That preference has historically been a single document picked with
+     * {@code ACTION_CREATE_DOCUMENT}, so when there is no tree permission for its parent directory
+     * there is no way to create timestamped files next to it; the caller falls back to overwriting
+     * that single document then, which is safe now that the export goes through a temporary file.
+     */
+    fun forAutoExport(context: Context, location: String?): BackupStorage? {
+        if (location.isNullOrBlank()) {
+            return null
+        }
+
+        val uri = location.toUri()
+
+        if (DocumentsContract.isTreeUri(uri)) {
+            return SafBackupStorage(context, uri)
+        }
+
+        val parentTreeUri = parentTreeUriOf(uri) ?: return null
+        val hasGrant = context.contentResolver.persistedUriPermissions.any { permission ->
+            permission.uri == parentTreeUri && permission.isWritePermission
+        }
+        if (!hasGrant) {
+            LOG.info("No persisted tree permission for {}, keeping the single file auto export", parentTreeUri)
+            return null
+        }
+
+        return SafBackupStorage(context, parentTreeUri)
+    }
+
+    /**
+     * The tree uri of the directory a document uri lives in, or null when that cannot be derived.
+     */
+    private fun parentTreeUriOf(documentUri: Uri): Uri? {
+        return try {
+            val authority = documentUri.authority ?: return null
+            val documentId = DocumentsContract.getDocumentId(documentUri) ?: return null
+            val parentDocumentId = when {
+                documentId.contains('/') -> documentId.substringBeforeLast('/')
+                documentId.endsWith(':') -> return null
+                documentId.contains(':') -> documentId.substringBefore(':') + ":"
+                else -> return null
+            }
+            DocumentsContract.buildTreeDocumentUri(authority, parentDocumentId)
+        } catch (e: Exception) {
+            LOG.warn("Failed to derive the parent tree of {}", documentUri, e)
+            null
+        }
+    }
+}
