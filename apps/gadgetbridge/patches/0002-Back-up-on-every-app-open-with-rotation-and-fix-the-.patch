+package nodomain.freeyourgadget.gadgetbridge.util.backup
+
+import nodomain.freeyourgadget.gadgetbridge.GBApplication
+import nodomain.freeyourgadget.gadgetbridge.util.GBPrefs
+import nodomain.freeyourgadget.gadgetbridge.util.Prefs
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.time.format.DateTimeFormatter
+
+/**
+ * Preferences of the backup that runs every time the app is opened.
+ *
+ * The periodic exporter depends on WorkManager, which aggressive vendor ROMs (and Doze) routinely
+ * never run, so a background-only schedule can silently stop producing backups for weeks. The
+ * on-open backup instead runs whenever the user actually launches the app, which is the one
+ * moment the process is guaranteed to be alive and allowed to write.
+ */
+object OnOpenBackupPrefs {
+    /** Whether the on-open backup runs at all. */
+    const val ENABLED = "on_open_backup_enabled"
+
+    /**
+     * The target directory as a persisted SAF tree uri, or {@code null} to back up into the app's
+     * external files dir.
+     */
+    const val LOCATION = "on_open_backup_location"
+
+    /** How many days of backups to keep. Stored by an EditTextPreference, so it is a String. */
+    const val RETENTION_DAYS = "on_open_backup_retention_days"
+
+    /** Epoch millis of the last successful on-open backup. */
+    const val LAST_RUN = "on_open_backup_last_run"
+
+    /** File name of the last successful on-open backup. */
+    const val LAST_FILE = "on_open_backup_last_file"
+
+    /** User readable outcome of the last on-open backup, shown on the settings screen. */
+    const val LAST_RESULT = "on_open_backup_last_result"
+
+    /** Manual trigger from the settings screen. */
+    const val RUN_NOW = "on_open_backup_run_now"
+
+    /** Manual cleanup trigger from the settings screen. */
+    const val CLEAN_NOW = "on_open_backup_clean_now"
+
+    const val DEFAULT_ENABLED = true
+    const val DEFAULT_RETENTION_DAYS = 7
+
+    /** Upper bound for the retention setting, so a typo cannot keep years of 27MB backups. */
+    const val MAX_RETENTION_DAYS = 365
+
+    /** Prefix and suffix of the files this feature writes, in the same style as manual exports. */
+    const val FILE_PREFIX = "gadgetbridge_"
+    const val FILE_SUFFIX = ".zip"
+
+    private val FILE_NAME_FORMAT: DateTimeFormatter = DateTimeFormatter.ofPattern("yyyyMMddHHmmss")
+
+    fun prefs(): Prefs = GBApplication.getPrefs()
+
+    fun isEnabled(): Boolean = prefs().getBoolean(ENABLED, DEFAULT_ENABLED)
+
+    fun location(): String? = prefs().getString(LOCATION, null)?.takeIf { it.isNotBlank() }
+
+    fun setLocation(uri: String?) {
+        prefs().preferences.edit().putString(LOCATION, uri).apply()
+    }
+
+    fun retentionDays(): Int {
+        val days = prefs().getInt(RETENTION_DAYS, DEFAULT_RETENTION_DAYS)
+        return if (days in 1..MAX_RETENTION_DAYS) days else DEFAULT_RETENTION_DAYS
+    }
+
+    fun lastRun(): Long = prefs().getLong(LAST_RUN, 0L)
+
+    fun lastFile(): String? = prefs().getString(LAST_FILE, null)
+
+    fun lastResult(): String? = prefs().getString(LAST_RESULT, null)
+
+    fun recordSuccess(fileName: String, whenMillis: Long) {
+        prefs().preferences.edit()
+            .putLong(LAST_RUN, whenMillis)
+            .putString(LAST_FILE, fileName)
+            .putString(LAST_RESULT, "ok")
+            .apply()
+    }
+
+    fun recordFailure(message: String) {
+        prefs().preferences.edit()
+            .putString(LAST_RESULT, message)
+            .apply()
+    }
+
+    /**
+     * The file name for a backup taken at [time], e.g. {@code gadgetbridge_20261115_083000.zip}.
+     */
+    fun fileNameFor(time: LocalDateTime): String =
+        FILE_PREFIX + time.format(FILE_NAME_FORMAT) + FILE_SUFFIX
+
+    /**
+     * Whether [fileName] is a backup written by this feature, so pruning never deletes files the
+     * user put there.
+     */
+    fun isBackupFileName(fileName: String): Boolean {
+        if (!fileName.startsWith(FILE_PREFIX) || !fileName.endsWith(FILE_SUFFIX)) {
+            return false
+        }
+        val stamp = fileName.removePrefix(FILE_PREFIX).removeSuffix(FILE_SUFFIX)
+        return stamp.length == 14 && stamp.all { it.isDigit() }
+    }
+
+    /**
+     * The date encoded in a backup file name, or {@code null} when it is not one of ours.
+     */
+    fun dateOf(fileName: String): LocalDate? {
+        if (!isBackupFileName(fileName)) {
+            return null
+        }
+        val stamp = fileName.removePrefix(FILE_PREFIX).removeSuffix(FILE_SUFFIX)
+        return try {
+            LocalDate.parse(stamp.substring(0, 8), DateTimeFormatter.ofPattern("yyyyMMdd"))
+        } catch (e: Exception) {
+            null
+        }
+    }
+}
