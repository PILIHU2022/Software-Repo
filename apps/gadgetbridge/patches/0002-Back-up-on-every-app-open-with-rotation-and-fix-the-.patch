+package nodomain.freeyourgadget.gadgetbridge.util.backup
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.time.LocalTime
+
+/**
+ * The retention is the only part of the backup that deletes files, so these tests pin down that it
+ * only ever deletes the backups it wrote itself, and that it never deletes the last one.
+ *
+ * Plain JVM test: neither the file name helpers nor the retention decision touch Android.
+ */
+class OnOpenBackupRetentionTest {
+    private val today: LocalDate = LocalDate.of(2026, 10, 2)
+
+    private val retention: Int = OnOpenBackupPrefs.DEFAULT_RETENTION_DAYS
+
+    private fun backupOf(date: LocalDate, hour: Int = 12): String =
+        OnOpenBackupPrefs.fileNameFor(LocalDateTime.of(date, LocalTime.of(hour, 0)))
+
+    @Test
+    fun fileNameFor_usesATimestampedName() {
+        val fileName = OnOpenBackupPrefs.fileNameFor(LocalDateTime.of(2026, 10, 2, 8, 30, 5))
+
+        assertEquals("gadgetbridge_20261002083005.zip", fileName)
+        assertTrue(OnOpenBackupPrefs.isBackupFileName(fileName))
+    }
+
+    @Test
+    fun isBackupFileName_onlyMatchesOurOwnFiles() {
+        assertTrue(OnOpenBackupPrefs.isBackupFileName("gadgetbridge_20261002083005.zip"))
+
+        // Never match files that the user or older versions of the app may have put there
+        assertFalse(OnOpenBackupPrefs.isBackupFileName("Gadgetbridge.zip"))
+        assertFalse(OnOpenBackupPrefs.isBackupFileName("notes.txt"))
+        assertFalse(OnOpenBackupPrefs.isBackupFileName("gadgetbridge.zip"))
+        assertFalse(OnOpenBackupPrefs.isBackupFileName("gadgetbridge_2026100208300.zip"))
+        assertFalse(OnOpenBackupPrefs.isBackupFileName("gadgetbridge_20261002083005.zip.part"))
+        assertFalse(OnOpenBackupPrefs.isBackupFileName("gadgetbridge_2026100208300a.zip"))
+        assertFalse(OnOpenBackupPrefs.isBackupFileName(""))
+    }
+
+    @Test
+    fun dateOf_readsTheDateFromTheName() {
+        assertEquals(
+            LocalDate.of(2026, 10, 2),
+            OnOpenBackupPrefs.dateOf("gadgetbridge_20261002083005.zip"),
+        )
+
+        assertNull(OnOpenBackupPrefs.dateOf("Gadgetbridge.zip"))
+        assertNull(OnOpenBackupPrefs.dateOf("notes.txt"))
+    }
+
+    @Test
+    fun dateOf_rejectsImpossibleDates() {
+        // Matches the name pattern, but month 13 is not a date, so it must never be pruned
+        assertNull(OnOpenBackupPrefs.dateOf("gadgetbridge_20261302143005.zip"))
+    }
+
+    @Test
+    fun cutoff_isTheFirstKeptDay() {
+        assertEquals(today.minusDays(6), BackupRetention.cutoff(today, retention))
+        assertEquals(today, BackupRetention.cutoff(today, 1))
+        // A broken setting must not be able to delete everything
+        assertEquals(today, BackupRetention.cutoff(today, 0))
+        assertEquals(today, BackupRetention.cutoff(today, -3))
+    }
+
+    @Test
+    fun retention_keepsTodayAndThePreviousSixDays() {
+        assertFalse(BackupRetention.shouldDelete(backupOf(today), today, retention))
+        assertFalse(BackupRetention.shouldDelete(backupOf(today.minusDays(6)), today, retention))
+        assertTrue(BackupRetention.shouldDelete(backupOf(today.minusDays(7)), today, retention))
+        assertTrue(BackupRetention.shouldDelete(backupOf(today.minusDays(8)), today, retention))
+    }
+
+    @Test
+    fun retention_otherPeriods() {
+        assertFalse(BackupRetention.shouldDelete(backupOf(today), today, 1))
+        assertTrue(BackupRetention.shouldDelete(backupOf(today.minusDays(1)), today, 1))
+
+        assertFalse(BackupRetention.shouldDelete(backupOf(today.minusDays(29)), today, 30))
+        assertTrue(BackupRetention.shouldDelete(backupOf(today.minusDays(30)), today, 30))
+    }
+
+    @Test
+    fun shouldDelete_neverMatchesForeignOrMalformedFiles() {
+        assertFalse(BackupRetention.shouldDelete("Gadgetbridge.zip", today, retention))
+        assertFalse(BackupRetention.shouldDelete("notes.txt", today, retention))
+        assertFalse(BackupRetention.shouldDelete("gadgetbridge_20260101120000.zip.part", today, retention))
+        assertFalse(BackupRetention.shouldDelete("gadgetbridge_20261301120000.zip", today, retention))
+        assertFalse(BackupRetention.shouldDelete("", today, retention))
+    }
+
+    @Test
+    fun filesToDelete_deletesOnlyExpiredBackups() {
+        val expired = backupOf(today.minusDays(8))
+        val kept = backupOf(today.minusDays(2))
+        val newest = backupOf(today)
+
+        val deletable = BackupRetention.filesToDelete(
+            listOf(expired, kept, newest, "notes.txt", "Gadgetbridge.zip"),
+            today,
+            retention,
+        )
+
+        assertEquals(listOf(expired), deletable)
+    }
+
+    @Test
+    fun filesToDelete_keepsTheNewestBackupEvenWhenItIsOlderThanTheRetention() {
+        val newest = backupOf(today.minusDays(30))
+        val older = backupOf(today.minusDays(31))
+
+        // A month without a successful backup: pruning must not leave the user without any backup
+        assertTrue(BackupRetention.filesToDelete(listOf(newest), today, retention).isEmpty())
+        assertEquals(listOf(older), BackupRetention.filesToDelete(listOf(newest, older), today, retention))
+    }
+
+    @Test
+    fun filesToDelete_keepsTheNewestBackupOfALargeExpiredSet() {
+        val names = listOf(
+            backupOf(today.minusDays(9)),
+            backupOf(today.minusDays(8)),
+            backupOf(today.minusDays(20)),
+        )
+
+        val deletable = BackupRetention.filesToDelete(names, today, retention)
+
+        assertEquals(listOf(names[0], names[2]), deletable)
+        assertFalse(names[1] in deletable)
+    }
+}
