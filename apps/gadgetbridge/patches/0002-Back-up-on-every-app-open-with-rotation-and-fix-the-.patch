+import nodomain.freeyourgadget.gadgetbridge.activities.AbstractSettingsActivityV2
+import nodomain.freeyourgadget.gadgetbridge.util.DateTimeUtils
+import nodomain.freeyourgadget.gadgetbridge.util.GB
+import nodomain.freeyourgadget.gadgetbridge.util.UriUtils
+import nodomain.freeyourgadget.gadgetbridge.util.backup.OnOpenBackupPrefs
+import nodomain.freeyourgadget.gadgetbridge.util.backup.OnOpenBackupRunner
+import org.slf4j.Logger
+import org.slf4j.LoggerFactory
+import java.util.Date
+import java.util.concurrent.TimeUnit
+
+class OnOpenBackupSettingsActivity : AbstractSettingsActivityV2() {
+    override fun newFragment(): PreferenceFragmentCompat {
+        return OnOpenBackupSettingsFragment()
+    }
+
+    companion object {
+        class OnOpenBackupSettingsFragment : AbstractPreferenceFragment() {
+
+            private lateinit var backupFolderPicker: ActivityResultLauncher<Uri?>
+
+            override fun onCreatePreferences(savedInstanceState: Bundle?, rootKey: String?) {
+                setPreferencesFromResource(R.xml.on_open_backup_settings, rootKey)
+
+                backupFolderPicker = registerForActivityResult(
+                    ActivityResultContracts.OpenDocumentTree()
+                ) { uri: Uri? ->
+                    onBackupFolderPicked(uri)
+                }
+
+                findPreference<Preference>(OnOpenBackupPrefs.LOCATION)?.setOnPreferenceClickListener {
+                    backupFolderPicker.launch(null)
+                    true
+                }
+
+                findPreference<Preference>(OnOpenBackupPrefs.RUN_NOW)?.setOnPreferenceClickListener {
+                    runBackupNow()
+                    true
+                }
+
+                findPreference<Preference>(OnOpenBackupPrefs.CLEAN_NOW)?.setOnPreferenceClickListener {
+                    deleteExpiredBackupsNow()
+                    true
+                }
+
+                updateSummaries()
+            }
+
+            override fun onResume() {
+                super.onResume()
+
+                // The user may be coming back from the folder picker or from another screen
+                updateSummaries()
+            }
+
+            /**
+             * The user picked a backup folder. Persist the read/write grant so that the backup can
+             * still write there after the app is restarted.
+             */
+            private fun onBackupFolderPicked(uri: Uri?) {
+                if (uri == null) {
+                    LOG.error("Got no uri")
+                    return
+                }
+
+                try {
+                    requireContext().contentResolver.takePersistableUriPermission(
+                        uri,
+                        Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_WRITE_URI_PERMISSION
+                    )
+                } catch (e: SecurityException) {
+                    // Some document providers do not support persistable grants, the location is
+                    // still stored so that the user does not lose the selection
+                    LOG.warn("Failed to take persistable uri permission for {}", uri, e)
+                }
+
+                OnOpenBackupPrefs.setLocation(uri.toString())
+                updateSummaries()
+            }
+
+            /**
+             * Run the on-open backup right away. Runs on the IO dispatcher, as writing the backup
+             * takes a while and must never block the main thread.
+             */
+            private fun runBackupNow() {
+                val context = requireContext().applicationContext
+                val prefRunNow = findPreference<Preference>(OnOpenBackupPrefs.RUN_NOW) ?: return
+                prefRunNow.isEnabled = false
+
+                lifecycleScope.launch {
+                    val (success, message) = withContext(Dispatchers.IO) {
+                        try {
+                            val result = OnOpenBackupRunner.runNow(context)
+                            if (result.success) {
+                                true to context.getString(R.string.backup_on_open_status_ok)
+                            } else {
+                                false to context.getString(
+                                    R.string.backup_on_open_status_failed,
+                                    result.message
+                                )
+                            }
+                        } catch (e: CancellationException) {
+                            throw e
+                        } catch (e: Exception) {
+                            LOG.error("Failed to run the on-open backup", e)
+                            false to context.getString(
+                                R.string.backup_on_open_status_failed,
+                                e.message ?: e.toString()
+                            )
+                        }
+                    }
+
+                    prefRunNow.isEnabled = true
+
+                    if (!isAdded) {
+                        return@launch
+                    }
+
+                    updateSummaries()
+                    GB.toast(
+                        requireContext(),
+                        message,
+                        Toast.LENGTH_LONG,
+                        if (success) GB.INFO else GB.ERROR
+                    )
+                }
+            }
+
+            /**
+             * Delete the backups that are older than the retention period, on a background
+             * dispatcher, and report how many files were removed.
+             */
+            private fun deleteExpiredBackupsNow() {
+                val context = requireContext().applicationContext
+                val prefCleanNow = findPreference<Preference>(OnOpenBackupPrefs.CLEAN_NOW) ?: return
+                prefCleanNow.isEnabled = false
+
+                lifecycleScope.launch {
+                    val outcome: Pair<Int, String?> = withContext(Dispatchers.IO) {
+                        try {
+                            OnOpenBackupRunner.pruneNow(context) to null
+                        } catch (e: CancellationException) {
+                            throw e
+                        } catch (e: Exception) {
+                            LOG.error("Failed to delete the expired on-open backups", e)
+                            -1 to (e.message ?: e.toString())
+                        }
+                    }
+
+                    val deleted = outcome.first
+                    val errorMessage = outcome.second
+
+                    prefCleanNow.isEnabled = true
+
+                    if (!isAdded) {
+                        return@launch
+                    }
+
+                    updateSummaries()
+
+                    val message = if (deleted >= 0) {
+                        getString(R.string.backup_on_open_deleted_count, deleted)
+                    } else {
+                        getString(
+                            R.string.backup_on_open_status_failed,
+                            errorMessage ?: getString(R.string.unknown)
+                        )
+                    }
+                    GB.toast(
+                        requireContext(),
+                        message,
+                        Toast.LENGTH_LONG,
+                        if (deleted >= 0) GB.INFO else GB.ERROR
+                    )
+                }
+            }
+
+            private fun updateSummaries() {
+                updateLocationSummary()
+                updateStatusSummary()
+                updateLastBackupSummary()
+            }
+
+            private fun updateLocationSummary() {
+                val location = OnOpenBackupPrefs.location()
+                val summary = if (location == null) {
+                    getString(R.string.pref_summary_backup_on_open_location_default)
+                } else {
+                    try {
+                        UriUtils.resolveLocationSummary(requireContext(), location)
+                    } catch (e: Exception) {
+                        LOG.warn("Failed to resolve the summary of the backup location {}", location, e)
+                        location
+                    }
+                }
+                findPreference<Preference>(OnOpenBackupPrefs.LOCATION)?.summary = summary
+            }
+
+            private fun updateStatusSummary() {
+                val lastResult = OnOpenBackupPrefs.lastResult()
+                val summary = when {
+                    lastResult.isNullOrBlank() -> getString(R.string.unknown)
+                    lastResult.equals(RESULT_OK, ignoreCase = true) -> getString(R.string.backup_on_open_status_ok)
+                    else -> getString(R.string.backup_on_open_status_failed, lastResult)
+                }
+                findPreference<Preference>(STATUS_KEY)?.summary = summary
+            }
+
+            private fun updateLastBackupSummary() {
+                val lastRun = OnOpenBackupPrefs.lastRun()
+                val summary = if (lastRun > 0L) {
+                    formatDateWithDiff(Date(lastRun))
+                } else {
+                    getString(R.string.unknown)
+                }
+                findPreference<Preference>(LAST_BACKUP_KEY)?.summary = summary
+            }
+
+            /**
+             * Format a date, including the difference to the current time.
+             */
+            private fun formatDateWithDiff(date: Date): String {
+                val diffMillis = System.currentTimeMillis() - date.time
+                return if (diffMillis > 0) {
+                    requireContext().getString(
+                        R.string.datetime_in_the_past,
+                        DateTimeUtils.formatDateTime(date),
+                        DateTimeUtils.formatDurationHoursMinutes(diffMillis, TimeUnit.MILLISECONDS)
+                    )
+                } else {
+                    requireContext().getString(
+                        R.string.datetime_in_the_future,
+                        DateTimeUtils.formatDateTime(date),
+                        DateTimeUtils.formatDurationHoursMinutes(-diffMillis, TimeUnit.MILLISECONDS)
+                    )
+                }
+            }
+
+            companion object {
+                val LOG: Logger = LoggerFactory.getLogger(OnOpenBackupSettingsFragment::class.java)
+
+                /** Key of the read-only preference that shows the outcome of the last backup. */
+                private const val STATUS_KEY = "on_open_backup_status"
+
+                /** Key of the read-only preference that shows when the last backup was written. */
+                private const val LAST_BACKUP_KEY = "on_open_backup_last_backup"
+
+                /** The result [OnOpenBackupPrefs] stores after a successful backup. */
+                private const val RESULT_OK = "ok"
+            }
+        }
+    }
+}
